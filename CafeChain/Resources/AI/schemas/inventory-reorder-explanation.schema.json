{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Summary",
    "Explanation",
    "Risk",
    "RecommendedActionText"
  ],
  "properties": {
    "Summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "Explanation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "Risk": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "RecommendedActionText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    }
  }
}
