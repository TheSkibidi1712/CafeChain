{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ingredientId",
    "recommendationLevel",
    "usableStock",
    "minimumStock",
    "pendingIncoming",
    "suggestedQuantity",
    "explanation"
  ],
  "properties": {
    "ingredientId": { "type": "integer", "minimum": 1 },
    "recommendationLevel": {
      "type": "string",
      "enum": ["URGENT", "NEAR_REORDER", "NORMAL", "PROCUREMENT_IN_PROGRESS", "INCOMING_COVERS_DEMAND", "DATA_INCOMPLETE"]
    },
    "usableStock": { "type": "number" },
    "minimumStock": { "type": "number" },
    "pendingIncoming": { "type": "number", "minimum": 0 },
    "suggestedQuantity": { "type": "number", "minimum": 0 },
    "explanation": { "type": "string", "minLength": 1, "maxLength": 600 }
  }
}
