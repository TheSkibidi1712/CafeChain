@model CafeChain.Application.DTOs.Admin.Procurement.SupplierQualityDashboardDto
@using CafeChain.Models.Inventories.Suppliers
@using CafeChain.Application.DTOs.Admin.StoreScope
@using CafeChain.ViewModels.Admin.Shared
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ProcurementResource> L
@{
    ViewData["Title"] = L["SupplierQuality.Title"];
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var stores = ViewBag.Stores as IReadOnlyList<AdminStoreOptionDto> ?? Array.Empty<AdminStoreOptionDto>();
    var suppliers = ViewBag.Suppliers as IReadOnlyList<Supplier> ?? Array.Empty<Supplier>();
    var days = ViewBag.Days as int? ?? 90;
    var customFrom = ViewBag.CustomFrom as DateTime?;
    var customTo = ViewBag.CustomTo as DateTime?;
    string PerformanceLabel(string value) => value switch
    {
        "GOOD" => L["SupplierQuality.Perf.GOOD"].Value,
        "WATCH" => L["SupplierQuality.Perf.WATCH"].Value,
        "RISK" => L["SupplierQuality.Perf.RISK"].Value,
        _ => L["SupplierQuality.Perf.Unknown"].Value
    };
}
<link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />

<main class="ops-shell supplier-quality-page supplier-quality-index-page cc-warehouse-page">
    <header class="ops-header cc-warehouse-header">
        <div>
            <div class="ops-eyebrow">@L["SupplierQuality.Eyebrow"]</div>
            <h1 class="ops-title"><i class="fa-solid fa-star me-2 text-warning" aria-hidden="true"></i>@L["SupplierQuality.Title"]</h1>
            <p class="ops-subtitle">@L["SupplierQuality.Subtitle"]</p>
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null) { <div class="ops-notice ops-notice-success" role="status">@TempData["SuccessMessage"]</div> }
    @if (TempData["ErrorMessage"] != null) { <div class="ops-notice ops-notice-error" role="alert">@TempData["ErrorMessage"]</div> }

    <form method="get" class="ops-panel cc-warehouse-filter" aria-label="@L["SupplierQuality.FilterAria"]">
        <div class="ops-panel-header">
            <div><h2 class="ops-panel-title">@L["SupplierQuality.ScopeTitle"]</h2><div class="ops-secondary">@L["SupplierQuality.ScopeHelp"]</div></div>
        </div>
        <div class="ops-panel-body">
            <div class="ops-form-grid">
                <div class="ops-form-field">
                    <label class="ops-form-label" for="qualityStoreId">@L["Common.Branch"] <span class="ops-required">*</span></label>
                    <select id="qualityStoreId" class="ops-select w-100" name="storeId" required>@foreach(var store in stores){<option value="@store.StoreId" selected="@(store.StoreId == Model.StoreId)">@store.StoreName</option>}</select>
                </div>
                <div class="ops-form-field">
                    <label class="ops-form-label" for="qualitySupplierId">@L["Common.Supplier"]</label>
                    <select id="qualitySupplierId" class="ops-select w-100" name="supplierId"><option value="">@L["SupplierQuality.AllSuppliers"]</option>@foreach(var supplier in suppliers){<option value="@supplier.SupplierId" selected="@(supplier.SupplierId == Model.SupplierId)">@supplier.Code · @supplier.Name</option>}</select>
                </div>
                <div class="ops-form-field">
                    <label class="ops-form-label" for="qualityDays">@L["SupplierQuality.DefaultRange"]</label>
                    <select id="qualityDays" class="ops-select w-100" name="days"><option value="30" selected="@(days == 30)">@L["SupplierQuality.Days", 30]</option><option value="90" selected="@(days == 90)">@L["SupplierQuality.Days", 90]</option><option value="180" selected="@(days == 180)">@L["SupplierQuality.Days", 180]</option></select>
                </div>
                <div class="ops-form-field">
                    <label class="ops-form-label" for="qualityFrom">@L["SupplierQuality.FromOptional"]</label>
                    <input id="qualityFrom" class="ops-input w-100" name="from" type="date" lang="vi" value="@(customFrom?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="ops-form-field">
                    <label class="ops-form-label" for="qualityTo">@L["SupplierQuality.ToOptional"]</label>
                    <input id="qualityTo" class="ops-input w-100" name="to" type="date" lang="vi" value="@(customTo?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="ops-form-field">
                    <label class="ops-form-label ops-field-spacer">&nbsp;</label>
                    <button class="ops-btn ops-btn-primary w-100" type="submit"><i class="fa-solid fa-filter" aria-hidden="true"></i> @L["SupplierQuality.ApplyFilter"]</button>
                </div>
            </div>
        </div>
    </form>

    @if (Model.Performance != null)
    {
        var p = Model.Performance;
        <section class="ops-metrics" aria-label="@L["SupplierQuality.MetricsAria"]">
            <div class="ops-metric"><span class="ops-metric-label">@L["SupplierQuality.Rating"]</span><strong class="ops-metric-value">@PerformanceLabel(p.Status)</strong><div class="ops-secondary">@L["SupplierQuality.CompletedDeliveries", p.CompletedDeliveryCount]</div></div>
            <div class="ops-metric"><span class="ops-metric-label">@L["SupplierQuality.OnTime"]</span><strong class="ops-metric-value">@p.OnTimeRate.ToString("N2")%</strong><div class="ops-secondary">@L["SupplierQuality.ExpectedSamples", p.ExpectedDateSampleCount]</div></div>
            <div class="ops-metric"><span class="ops-metric-label">@L["SupplierQuality.FillRate"]</span><strong class="ops-metric-value">@p.FillRate.ToString("N2")%</strong></div>
            <div class="ops-metric"><span class="ops-metric-label">@L["SupplierQuality.RejectRate"]</span><strong class="ops-metric-value @(p.RejectionRate > 5 ? "warning" : "success")">@p.RejectionRate.ToString("N2")%</strong></div>
            <div class="ops-metric"><span class="ops-metric-label">@L["SupplierQuality.IssueReceipts"]</span><strong class="ops-metric-value">@p.IssueRate.ToString("N2")%</strong><div class="ops-secondary">@L["SupplierQuality.ConfirmedReceipts", p.ConfirmedReceiptCount]</div></div>
            <div class="ops-metric"><span class="ops-metric-label">@L["SupplierQuality.AvgDelay"]</span><strong class="ops-metric-value">@L["SupplierQuality.AvgDelayValue", p.AverageDelayDays.ToString("N2")]</strong></div>
        </section>
    }
    else
    {
        <div class="ops-notice ops-notice-info"><strong>@L["SupplierQuality.NoSupplierTitle"]</strong> @L["SupplierQuality.NoSupplierCopy"]</div>
    }

    <section class="ops-panel">
        <div class="ops-panel-header"><div><h2 class="ops-panel-title">@L["SupplierQuality.IssuesTitle"]</h2><div class="ops-secondary">@L["SupplierQuality.IssuesHelp"]</div></div></div>
        <div class="ops-panel-body p-0">
        @if (Model.Issues.Count == 0)
        {
            <div class="ops-empty cc-warehouse-empty" aria-labelledby="supplierIssueEmptyTitle" role="status">
                <span class="ops-empty-icon"><i class="fa-regular fa-circle-check" aria-hidden="true"></i></span>
                <h3 id="supplierIssueEmptyTitle" class="ops-empty-title">@L["SupplierQuality.EmptyTitle"]</h3>
                <p class="ops-empty-copy">@L["SupplierQuality.EmptyCopy"]</p>
            </div>
        }
        else
        {
            <div class="ops-table-scroll cc-warehouse-table-shell"><table class="ops-table ops-table-min-1100 ops-table-wide"><thead><tr><th>@L["SupplierQuality.ColIssue"]</th><th>@L["Common.Supplier"]</th><th>@L["SupplierQuality.ColDoc"]</th><th>@L["SupplierQuality.ColItem"]</th><th class="number">@L["SupplierQuality.ColImpact"]</th><th>@L["SupplierQuality.ColStatus"]</th></tr></thead><tbody>
            @foreach (var issue in Model.Issues)
            {
                var reasonId = $"issueReason{issue.SupplierReceiptIssueId}";
                var statusId = $"issueStatus{issue.SupplierReceiptIssueId}";
                <tr>
                    <td><strong>@AdminStatusDisplay.SupplierReceiptIssueType(issue.IssueType)</strong><div>@issue.Description</div><div class="ops-secondary">@AdminStatusDisplay.DateTime(issue.ReportedAtUtc.ToLocalTime()) · @issue.ReportedByName</div></td>
                    <td>@issue.SupplierName</td>
                    <td><a asp-area="Admin" asp-controller="AdminPurchaseOrders" asp-action="Details" asp-route-id="@issue.PurchaseOrderId">@issue.PurchaseOrderCode</a><div><a asp-area="Admin" asp-controller="AdminBranchReceipts" asp-action="Details" asp-route-id="@issue.BranchReceiptId">@issue.BranchReceiptCode</a></div></td>
                    <td>@issue.IngredientName</td>
                    <td class="number">@AdminStatusDisplay.Quantity(issue.AffectedBaseQuantity)</td>
                    <td><span class="ops-badge @AdminStatusDisplay.SupplierReceiptIssue(issue.Status).CssClass">@AdminStatusDisplay.SupplierReceiptIssue(issue.Status).Label</span>
                        @if (issue.Status is "OPEN" or "UNDER_REVIEW")
                        {
                            <form method="post" asp-action="Transition" asp-route-id="@issue.SupplierReceiptIssueId" class="mt-2">@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@issue.RowVersion" /><div class="ops-table-actions"><div><label class="visually-hidden" for="@reasonId">@L["SupplierQuality.ReasonAria"]</label><input id="@reasonId" class="ops-input w-100" name="Reason" maxlength="1000" required placeholder="@L["SupplierQuality.ReasonPlaceholder"]" /></div><div><label class="visually-hidden" for="@statusId">@L["SupplierQuality.NextStatusAria"]</label><select id="@statusId" class="ops-select w-100" name="TargetStatus">@if(issue.Status == "OPEN"){<option value="UNDER_REVIEW">@L["SupplierQuality.Review"]</option>}<option value="RESOLVED">@L["SupplierQuality.Resolved"]</option><option value="DISMISSED">@L["SupplierQuality.Dismissed"]</option></select></div><button class="ops-btn" type="submit">@L["SupplierQuality.Update"]</button></div></form>
                        }
                        else if (issue.Status is "RESOLVED" or "DISMISSED")
                        {
                            <form method="post" asp-action="Transition" asp-route-id="@issue.SupplierReceiptIssueId" class="mt-2">@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@issue.RowVersion" /><input type="hidden" name="TargetStatus" value="CLOSED" /><div class="ops-table-actions"><div><label class="visually-hidden" for="@reasonId">@L["SupplierQuality.CloseReasonAria"]</label><input id="@reasonId" class="ops-input w-100" name="Reason" maxlength="1000" required placeholder="@L["SupplierQuality.CloseReasonPlaceholder"]" /></div><span></span><button class="ops-btn" type="submit">@L["SupplierQuality.CloseIssue"]</button></div></form>
                        }
                    </td>
                </tr>
            }
            </tbody></table></div>
        }
        </div>
    </section>
</main>
