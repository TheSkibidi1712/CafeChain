@model CafeChain.Application.DTOs.Admin.Procurement.CreateSupplierReceiptIssuePageDto
@using CafeChain.Application.Constants
@{
    ViewData["Title"] = "Ghi nhận sự cố nhà cung cấp";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var types = new[]
    {
        (SupplierReceiptIssueTypes.LateDelivery, "Giao trễ"), (SupplierReceiptIssueTypes.ShortDelivery, "Giao thiếu"),
        (SupplierReceiptIssueTypes.WrongItem, "Sai mặt hàng"), (SupplierReceiptIssueTypes.Damaged, "Hư hỏng"),
        (SupplierReceiptIssueTypes.Expired, "Hết hạn"), (SupplierReceiptIssueTypes.QualityFailure, "Không đạt chất lượng"),
        (SupplierReceiptIssueTypes.PackagingFailure, "Lỗi bao bì"), (SupplierReceiptIssueTypes.DocumentMismatch, "Sai chứng từ"),
        (SupplierReceiptIssueTypes.Other, "Khác")
    };
}
<link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />
<main class="ops-shell" style="max-width:1000px">
    <header class="ops-header"><div><div class="ops-eyebrow">@Model.Context.BranchReceiptCode · @Model.Context.PurchaseOrderCode</div><h1 class="ops-title">Ghi nhận sự cố nhà cung cấp</h1><p class="ops-subtitle">@Model.Context.SupplierName · @Model.Context.StoreName</p></div><a class="ops-btn" asp-action="Index" asp-route-storeId="@Model.Context.StoreId" asp-route-supplierId="@Model.Context.SupplierId"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Quay lại</a></header>
    @if (TempData["ErrorMessage"] != null) { <div class="ops-notice ops-notice-error">@TempData["ErrorMessage"]</div> }
    @if (!string.IsNullOrWhiteSpace(Model.Context.SuggestedIssueType)) { <div class="ops-notice ops-notice-warning"><strong>Gợi ý cần kiểm tra:</strong> hệ thống phát hiện giao trễ hoặc có lượng bị loại bỏ. Người dùng phải xác nhận trước khi lưu; đây không phải kết luận tự động.</div> }
    <section class="ops-metrics"><div class="ops-metric"><span class="ops-metric-label">Mặt hàng</span><strong class="ops-metric-value fs-5">@Model.Context.IngredientName</strong></div><div class="ops-metric"><span class="ops-metric-label">Chấp nhận</span><strong class="ops-metric-value success">@Model.Context.AcceptedBaseQuantity.ToString("N3")</strong></div><div class="ops-metric"><span class="ops-metric-label">Loại bỏ</span><strong class="ops-metric-value warning">@Model.Context.RejectedBaseQuantity.ToString("N3")</strong></div></section>
    <form method="post"><section class="ops-panel"><div class="ops-panel-body"><input name="BranchReceiptLineId" value="@Model.Input.BranchReceiptLineId" type="hidden" /><div class="row g-3"><div class="col-md-6"><label class="ops-form-label">Loại sự cố</label><select name="IssueType" class="ops-select w-100" required>@foreach(var type in types){<option value="@type.Item1" selected="@(type.Item1 == Model.Input.IssueType)">@type.Item2</option>}</select></div><div class="col-md-6"><label class="ops-form-label">Số lượng ảnh hưởng (base)</label><input name="AffectedBaseQuantity" value="@Model.Input.AffectedBaseQuantity" class="ops-input w-100" type="number" min="0" step="0.001" /></div><div class="col-12"><label class="ops-form-label">Mô tả / bằng chứng</label><textarea name="Description" class="ops-textarea" maxlength="1000" required placeholder="Mô tả tình trạng hàng, chứng từ hoặc thời điểm giao...">@Model.Input.Description</textarea></div></div></div></section><div class="ops-actions justify-content-end"><button class="ops-btn ops-btn-primary" type="submit"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Ghi nhận sự cố</button></div></form>
</main>
