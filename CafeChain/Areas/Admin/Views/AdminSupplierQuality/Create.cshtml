@model CafeChain.Application.DTOs.Admin.Procurement.CreateSupplierReceiptIssuePageDto
@using CafeChain.Application.Constants
@using CafeChain.ViewModels.Admin.Shared
@{
    ViewData["Title"] = "Ghi nhận sự cố nhà cung cấp";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var types = new[]
    {
        (SupplierReceiptIssueTypes.LateDelivery, "Giao trễ"), (SupplierReceiptIssueTypes.ShortDelivery, "Giao thiếu"),
        (SupplierReceiptIssueTypes.WrongItem, "Sai mặt hàng"), (SupplierReceiptIssueTypes.Damaged, "Hư hỏng"),
        (SupplierReceiptIssueTypes.Expired, "Hết hạn"), (SupplierReceiptIssueTypes.QualityFailure, "Không đạt chất lượng"),
        (SupplierReceiptIssueTypes.PackagingFailure, "Lỗi bao bì"), (SupplierReceiptIssueTypes.DocumentMismatch, "Sai chứng từ"),
        (SupplierReceiptIssueTypes.Other, "Khác")
    };
}
<link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />
<main class="ops-shell ops-shell-compact cc-warehouse-page">
<header class="ops-header cc-warehouse-header cc-warehouse-header--compact">
        <div>
            <div class="ops-eyebrow">@Model.Context.BranchReceiptCode · @Model.Context.PurchaseOrderCode</div>
            <h1 class="ops-title">Ghi nhận sự cố nhà cung cấp</h1>
            <p class="ops-subtitle">@Model.Context.SupplierName · @Model.Context.StoreName. Ghi nhận đúng bằng chứng tại thời điểm nhận hàng để phục vụ đánh giá sau này.</p>
        </div>
        <a class="ops-btn" asp-action="Index" asp-route-storeId="@Model.Context.StoreId" asp-route-supplierId="@Model.Context.SupplierId"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Quay lại</a>
    </header>

    @if (TempData["ErrorMessage"] != null) { <div class="ops-notice ops-notice-error" role="alert">@TempData["ErrorMessage"]</div> }
    @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="ops-notice ops-notice-error cc-warehouse-alert cc-warehouse-alert-danger" role="alert"></div> }
    @if (!string.IsNullOrWhiteSpace(Model.Context.SuggestedIssueType))
    {
        <div class="ops-notice ops-notice-warning" role="status"><strong>Gợi ý cần kiểm tra:</strong> hệ thống phát hiện giao trễ hoặc có lượng bị loại bỏ. Người dùng phải xác nhận trước khi lưu; đây không phải kết luận tự động.</div>
    }

    <section class="ops-metrics" aria-label="Tóm tắt dòng nhận hàng">
        <div class="ops-metric"><span class="ops-metric-label">Mặt hàng</span><strong class="ops-metric-value fs-5">@Model.Context.IngredientName</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Chấp nhận</span><strong class="ops-metric-value success">@AdminStatusDisplay.Quantity(Model.Context.AcceptedBaseQuantity)</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Loại bỏ</span><strong class="ops-metric-value warning">@AdminStatusDisplay.Quantity(Model.Context.RejectedBaseQuantity)</strong></div>
    </section>

    <form method="post">
        <section class="ops-panel">
            <div class="ops-panel-header">
                <div><h2 class="ops-panel-title">Thông tin sự cố</h2><div class="ops-secondary">Mô tả sự việc theo bằng chứng thực tế, không suy diễn nguyên nhân.</div></div>
            </div>
            <div class="ops-panel-body">
                <input name="BranchReceiptLineId" value="@Model.Input.BranchReceiptLineId" type="hidden" />
                <div class="ops-form-grid">
                    <div class="ops-form-field">
                        <label class="ops-form-label" for="supplierIssueType">Loại sự cố <span class="ops-required">*</span></label>
                        <select id="supplierIssueType" name="IssueType" class="ops-select w-100" required>@foreach(var type in types){<option value="@type.Item1" selected="@(type.Item1 == Model.Input.IssueType)">@type.Item2</option>}</select>
                    </div>
                    <div class="ops-form-field">
                        <label class="ops-form-label" for="affectedBaseQuantity">Số lượng ảnh hưởng (đơn vị cơ sở)</label>
                        <input id="affectedBaseQuantity" name="AffectedBaseQuantity" value="@Model.Input.AffectedBaseQuantity" class="ops-input w-100" type="number" min="0" step="0.001" />
                        <div class="ops-help">Nhập phần số lượng bị ảnh hưởng trong dòng nhận hàng này.</div>
                    </div>
                    <div class="ops-form-field ops-form-field-wide">
                        <label class="ops-form-label" for="supplierIssueDescription">Mô tả / bằng chứng <span class="ops-required">*</span></label>
                        <textarea id="supplierIssueDescription" name="Description" class="ops-textarea" maxlength="1000" required placeholder="Mô tả tình trạng hàng, chứng từ hoặc thời điểm giao...">@Model.Input.Description</textarea>
                    </div>
                </div>
            </div>
        </section>
        <div class="ops-form-actions">
            <a class="ops-btn" asp-action="Index" asp-route-storeId="@Model.Context.StoreId" asp-route-supplierId="@Model.Context.SupplierId">Hủy</a>
            <button class="ops-btn ops-btn-primary" type="submit"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Ghi nhận sự cố</button>
        </div>
    </form>
</main>
