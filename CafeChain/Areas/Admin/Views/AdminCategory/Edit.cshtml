@model CafeChain.Application.DTOs.Admin.Categories.AdminUpdateCategoryDto

@{
    ViewData["Title"] = "Chỉnh sửa danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="~/css/Admin/Category/Category.css" asp-append-version="true" />

<main class="category-page category-form-page">
<header class="category-page-header category-form-header">
    <div>
        <p class="category-eyebrow">Cấu trúc thực đơn</p>
        <h1 class="category-page-title">Chỉnh sửa danh mục</h1>
        <p class="category-page-subtitle">Cập nhật thông tin danh mục đồ uống.</p>
    </div>
    <a asp-action="Index" class="btn btn-light border">
        <i class="fas fa-arrow-left"></i> Quay lại danh sách
    </a>
</header>

<div class="card border-0 shadow-sm category-form-card">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="CategoryId" />
            
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold">Tên danh mục <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="Nhập tên danh mục..." />
                <span asp-validation-for="Name" class="text-danger category-validation"></span>
            </div>

            <div class="mb-4 form-check form-switch">
                <input asp-for="Active" class="form-check-input" type="checkbox" id="flexSwitchCheckChecked">
                <label class="form-check-label" for="flexSwitchCheckChecked">Hoạt động</label>
            </div>

            <button type="submit" class="btn category-primary-btn px-4 py-2">
                <i class="fas fa-save"></i> Cập nhật thay đổi
            </button>
        </form>
    </div>
</div>

</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
