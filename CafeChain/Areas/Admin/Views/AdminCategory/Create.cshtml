@model CafeChain.Application.DTOs.Admin.Categories.AdminCreateCategoryDto

@{
    ViewData["Title"] = "Thêm danh mục mới";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="~/css/Admin/Category/Category.css" asp-append-version="true" />

<main class="category-page category-form-page">
<header class="category-page-header category-form-header">
    <div>
        <p class="category-eyebrow">Cấu trúc thực đơn</p>
        <h1 class="category-page-title">Thêm danh mục mới</h1>
        <p class="category-page-subtitle">Tạo danh mục đồ uống mới cho hệ thống CafeChain.</p>
    </div>
    <a asp-action="Index" class="btn btn-light border">
        <i class="fas fa-arrow-left"></i> Quay lại danh sách
    </a>
</header>

<div class="card border-0 shadow-sm category-form-card">
    <div class="card-body p-4">
        <form id="createCategoryForm" asp-action="Create" method="post">
            <div class="mb-3">
                <button type="button" id="btnSuggestCategories" class="btn btn-outline-primary">
                    <i class="fas fa-wand-magic-sparkles"></i> AI Gợi Ý
                </button>
            </div>
            <div id="categoryAiSuggestions" class="category-ai-suggestions d-none mb-3">
                <div id="categoryAiSuggestionMessage" class="small text-muted mb-2">Chọn một gợi ý để điền vào form:</div>
                <div id="categoryAiSuggestionList" class="category-ai-suggestion-list"></div>
            </div>
            <div class="mb-3">
                <label asp-for="CategoryCode" class="form-label fw-semibold">Mã danh mục</label>
                <input asp-for="CategoryCode" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold">Tên danh mục <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="Nhập tên danh mục..." />
                <span asp-validation-for="Name" class="text-danger category-validation"></span>
            </div>

            <div class="mb-4 form-check form-switch">
                <input asp-for="Active" class="form-check-input" type="checkbox" id="flexSwitchCheckChecked" checked>
                <label class="form-check-label" for="flexSwitchCheckChecked">Hoạt động</label>
            </div>
            <div class="mb-3">
                <label asp-for="Icon" class="form-label fw-semibold">Biểu tượng</label>
                <input asp-for="Icon" class="form-control" placeholder="Ví dụ: ☕ 🍹 🥤" />
            </div>

            <button type="submit" class="btn category-primary-btn px-4 py-2">
                <i class="fas fa-save"></i> Lưu danh mục
            </button>
        </form>
    </div>
</div>

</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/Toast/toast.js"></script>
    <script src="~/js/Admin/Category/Category.js" asp-append-version="true"></script>
}
