@model CafeChain.ViewModels.Admin.Categories.AdminCategoryIndexViewModel
@using System.Security.Claims
@using CafeChain.Application.Constants
@using CafeChain.Application.Interfaces.Admin.Permissions
@inject IAdminPermissionService PermissionService

@{
    ViewData["Title"] = "Quản lý danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var canCreateCategory = false;
    var canUpdateCategory = false;
    var canToggleCategoryStatus = false;

    var currentAccountIdValue =
        User.FindFirstValue(ClaimTypes.NameIdentifier);

    if (User.Identity?.IsAuthenticated == true &&
        int.TryParse(currentAccountIdValue, out var currentAccountId))
    {
        var createDecision =
            await PermissionService.HasPermissionAsync(
                currentAccountId,
                PermissionConstants.CategoryCreate);

        var updateDecision =
            await PermissionService.HasPermissionAsync(
                currentAccountId,
                PermissionConstants.CategoryUpdate);

        var toggleStatusDecision =
            await PermissionService.HasPermissionAsync(
                currentAccountId,
                PermissionConstants.CategoryToggleStatus);

        canCreateCategory =
            createDecision.IsSuccess &&
            createDecision.Data?.Allowed == true;

        canUpdateCategory =
            updateDecision.IsSuccess &&
            updateDecision.Data?.Allowed == true;

        canToggleCategoryStatus =
            toggleStatusDecision.IsSuccess &&
            toggleStatusDecision.Data?.Allowed == true;
    }
}

<link rel="stylesheet" href="~/css/Admin/Category/Category.css" />

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-3">

    <div>

        <h2 class="category-page-title">
            Quản lý danh mục
        </h2>

        <p class="text-muted category-page-description">
            Quản lý và tổ chức các nhóm sản phẩm đồ uống của CafeChain
        </p>

    </div>

    <button type="button"
            class="btn category-primary-btn"
            data-bs-toggle="@(canCreateCategory ? "modal" : null)"
            data-bs-target="@(canCreateCategory ? "#createCategoryModal" : null)"
            disabled="@(!canCreateCategory)"
            title="@(canCreateCategory ? "Thêm danh mục mới" : "Bạn không có quyền thêm danh mục")">

        <i class="fas fa-plus me-2"></i>
        Thêm danh mục mới

    </button>

</div>

<!-- ========================================= -->
<!-- SEARCH -->
<!-- ========================================= -->

<div class="card border-0 shadow-sm category-card mb-3">

    <div class="card-body">

        <form asp-action="Index"
              method="get">

            <div class="row g-3 align-items-center">

                <div class="col-md-10">

                    <input asp-for="Filter.Keyword"
                           class="form-control category-input"
                           placeholder="Tìm theo mã danh mục hoặc tên danh mục..." />

                </div>

                <div class="col-md-2 d-grid">

                    <button type="submit"
                            class="btn category-primary-btn">

                        <i class="fas fa-search me-2"></i>
                        Tìm kiếm

                    </button>

                </div>

            </div>

        </form>

    </div>

</div>

<div class="card border-0 shadow-sm category-card">

    <div class="card-body p-0">

        <table class="table table-hover mb-0 category-table">

            <thead class="bg-light text-muted">

                <tr>

                    <th class="border-0 py-3">
                        Mã danh mục
                    </th>

                    <th class="border-0 py-3 text-center">
                        Icon
                    </th>

                    <th class="border-0 py-3">
                        Tên danh mục
                    </th>

                    <th class="border-0 py-3">
                        Trạng thái
                    </th>

                    <th class="border-0 text-end px-4 py-3">
                        Hành động
                    </th>

                </tr>

            </thead>

            <tbody>

                @if (!Model.Categories.Items.Any())
                {
                    <tr>

                        <td colspan="5"
                            class="text-center py-4 text-muted">

                            Chưa có danh mục nào.

                        </td>

                    </tr>
                }

                @foreach (var item in Model.Categories.Items)
                {
                    <tr>

                        <td class="py-3">

                            @item.CategoryCode

                        </td>

                        <td class="py-3 text-center category-icon-cell">

                            @if (!string.IsNullOrWhiteSpace(item.Icon))
                            {
                                <span class="category-icon-badge">
                                    @item.Icon
                                </span>
                            }
                            else
                            {
                                <span class="category-icon-badge category-icon-empty"
                                      title="No icon configured">
                                    -
                                </span>
                            }

                        </td>

                        <td class="py-3 category-name">

                            @item.Name

                        </td>

                        <td class="py-3">

                            @if (item.Active)
                            {
                                <span class="badge badge-active">
                                    Hiển thị
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted badge-inactive">
                                    Ẩn
                                </span>
                            }

                        </td>

                        <td class="text-end px-4 py-3 category-actions-cell">

                            <button type="button"
                                    class="btn btn-sm category-action-btn category-action-edit btn-edit-category"
                                    data-id="@item.CategoryId"
                                    data-bs-toggle="@(canUpdateCategory ? "modal" : null)"
                                    data-bs-target="@(canUpdateCategory ? "#editCategoryModal" : null)"
                                    disabled="@(!canUpdateCategory)"
                                    title="@(canUpdateCategory ? "Sửa" : "Bạn không có quyền cập nhật danh mục")">

                                <i class="fas fa-pen"></i>

                            </button>

                            <button type="button"
                                    class="btn btn-sm category-action-btn @(item.Active ? "category-action-lock" : "category-action-unlock")"
                                    onclick="@(canToggleCategoryStatus ? $"toggleCategory({item.CategoryId})" : null)"
                                    disabled="@(!canToggleCategoryStatus)"
                                    title="@(canToggleCategoryStatus ? (item.Active ? "Ẩn" : "Hiển thị") : "Bạn không có quyền ẩn / hiện danh mục")">

                                <i class="fas @(item.Active ? "fa-lock" : "fa-unlock")"></i>

                            </button>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
        <div class="card-footer bg-white border-top-0 py-3 px-4 d-flex justify-content-between align-items-center">

        <span class="text-muted">

            Hiển thị @Model.Categories.TotalCount danh mục

        </span>

        <div class="pagination mb-0 d-flex gap-1">

            <a asp-action="Index"
               asp-route-keyword="@Model.Filter.Keyword"
               asp-route-page="@(Model.Categories.PageIndex - 1)"
               class="btn btn-sm btn-light border @(Model.Categories.HasPreviousPage ? "" : "disabled")">

                <i class="fas fa-chevron-left text-muted"></i>

            </a>

            @for (int i = 1; i <= Model.Categories.TotalPages; i++)
            {
                <a asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-page="@i"
                   class="btn btn-sm @(i == Model.Categories.PageIndex ? "text-white" : "btn-light border")"
                   style="@(i == Model.Categories.PageIndex ? "background-color:#d93d20;" : "")">

                    @i

                </a>
            }

            <a asp-action="Index"
               asp-route-keyword="@Model.Filter.Keyword"
               asp-route-page="@(Model.Categories.PageIndex + 1)"
               class="btn btn-sm btn-light border @(Model.Categories.HasNextPage ? "" : "disabled")">

                <i class="fas fa-chevron-right text-muted"></i>

            </a>

        </div>

    </div>

</div>

<!-- ========================================= -->
<!-- CREATE MODAL -->
<!-- ========================================= -->

<div class="modal fade"
     id="createCategoryModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content category-modal-content">

            <div class="modal-header border-0">

                <h5 class="modal-title">

                    Thêm danh mục mới

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <form id="createCategoryForm"
                      asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">

                        <label class="form-label fw-semibold">

                            Mã danh mục

                        </label>

                        <input asp-for="Filter.Keyword"
                               type="hidden" />

                        <input type="text"
                               name="CategoryCode"
                               class="form-control category-input"
                               placeholder="Nhập mã danh mục..." />

                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-semibold">

                            Tên danh mục

                        </label>

                        <input type="text"
                               name="Name"
                               class="form-control category-input"
                               placeholder="Nhập tên danh mục..." />

                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-semibold">

                            Icon

                        </label>

                        <input type="text"
                               name="Icon"
                               class="form-control category-input"
                               placeholder="Ví dụ: ☕ 🍹 🥤 🍰" />

                    </div>

                    <div class="form-check form-switch mb-4">

                        <input type="hidden"
                               name="Active"
                               value="false" />

                        <input type="checkbox"
                               name="Active"
                               value="true"
                               checked
                               class="form-check-input" />

                        <label class="form-check-label">

                            Hoạt động

                        </label>

                    </div>

                    <div class="text-end">

                        <button type="button"
                                class="btn btn-light"
                                data-bs-dismiss="modal">

                            Hủy

                        </button>

                        <button type="submit"
                                id="btnCreateCategory"
                                class="btn category-primary-btn"
                                disabled="@(!canCreateCategory)"
                                title="@(canCreateCategory ? "Lưu danh mục" : "Bạn không có quyền thêm danh mục")">

                            <i class="fas fa-save me-2"></i>

                            Lưu danh mục

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>
<!-- ========================================= -->
<!-- EDIT MODAL -->
<!-- ========================================= -->

<div class="modal fade"
     id="editCategoryModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content category-modal-content">

            <div class="modal-header border-0">

                <h5 class="modal-title">

                    Chỉnh sửa danh mục

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <form id="editCategoryForm"
                      asp-action="Edit"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           id="editCategoryId"
                           name="CategoryId" />

                    <div class="mb-3">

                        <label class="form-label fw-semibold">

                            Mã danh mục

                        </label>

                        <input type="text"
                               id="editCategoryCode"
                               name="CategoryCode"
                               class="form-control category-input"
                               placeholder="Nhập mã danh mục..." />

                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-semibold">

                            Tên danh mục

                        </label>

                        <input type="text"
                               id="editCategoryName"
                               name="Name"
                               class="form-control category-input"
                               placeholder="Nhập tên danh mục..." />

                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-semibold">

                            Icon

                        </label>

                        <input type="text"
                               id="editCategoryIcon"
                               name="Icon"
                               class="form-control category-input"
                               placeholder="Ví dụ: ☕ 🍵 🥤 🍰" />

                    </div>

                    <div class="form-check form-switch mb-4">

                        <input type="hidden"
                               name="Active"
                               value="false" />

                        <input type="checkbox"
                               id="editCategoryActive"
                               name="Active"
                               value="true"
                               class="form-check-input" />

                        <label class="form-check-label">

                            Hoạt động

                        </label>

                    </div>

                    <div class="text-end">

                        <button type="button"
                                class="btn btn-light"
                                data-bs-dismiss="modal">

                            Hủy

                        </button>

                        <button type="submit"
                                id="btnEditCategory"
                                class="btn category-primary-btn"
                                disabled="@(!canUpdateCategory)"
                                title="@(canUpdateCategory ? "Cập nhật" : "Bạn không có quyền cập nhật danh mục")">

                            <i class="fas fa-save me-2"></i>

                            Cập nhật

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script src="~/js/Toast/toast.js"></script>
    <script src="~/js/Admin/Category/Category.js"></script>
}
