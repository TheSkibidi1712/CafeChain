@model CafeChain.ViewModels.Admin.Categories.AdminCategoryIndexViewModel
@using System.Security.Claims
@using CafeChain.Application.Constants
@using CafeChain.Application.Interfaces.Admin.Permissions
@inject IAdminPermissionService PermissionService

@{
    ViewData["Title"] = "Quản lý danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var canCreateCategory = false;
    var canUpdateCategory = false;
    var canToggleCategoryStatus = false;

    var currentAccountIdValue =
        User.FindFirstValue(ClaimTypes.NameIdentifier);

    if (User.Identity?.IsAuthenticated == true &&
        int.TryParse(currentAccountIdValue, out var currentAccountId))
    {
        var createDecision =
            await PermissionService.HasPermissionAsync(
                currentAccountId,
                PermissionConstants.CategoryCreate);

        var updateDecision =
            await PermissionService.HasPermissionAsync(
                currentAccountId,
                PermissionConstants.CategoryUpdate);

        var toggleStatusDecision =
            await PermissionService.HasPermissionAsync(
                currentAccountId,
                PermissionConstants.CategoryToggleStatus);

        canCreateCategory =
            createDecision.IsSuccess &&
            createDecision.Data?.Allowed == true;

        canUpdateCategory =
            updateDecision.IsSuccess &&
            updateDecision.Data?.Allowed == true;

        canToggleCategoryStatus =
            toggleStatusDecision.IsSuccess &&
            toggleStatusDecision.Data?.Allowed == true;
    }

    var categories = Model.Categories.Items.ToList();
    var activeCategoryCount = categories.Count(item => item.Active);
    var inactiveCategoryCount = categories.Count - activeCategoryCount;
    var hasKeyword = !string.IsNullOrWhiteSpace(Model.Filter.Keyword);
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/Category/Category.css" asp-append-version="true" />
}

@Html.AntiForgeryToken()

<div class="category-page">
<div class="category-page-header">

    <div class="category-heading">
        <span class="category-eyebrow">
            <i class="fas fa-layer-group"></i>
            Cấu trúc thực đơn
        </span>

        <h2 class="category-page-title">
            Quản lý danh mục
        </h2>

        <p class="text-muted category-page-description">
            Quản lý và tổ chức các nhóm sản phẩm đồ uống của CafeChain
        </p>

    </div>

    @if (canCreateCategory)
    {
    <button type="button"
            class="btn category-primary-btn category-add-btn"
            data-bs-toggle="modal"
            data-bs-target="#createCategoryModal"
            title="Thêm danh mục mới">

        <i class="fas fa-plus me-2"></i>
        Thêm danh mục mới

    </button>
    }

</div>

<div class="category-summary-grid">
    <div class="category-summary-card category-summary-total">
        <span class="category-summary-icon"><i class="fas fa-layer-group"></i></span>
        <span><strong>@Model.Categories.TotalCount</strong><small>Tổng danh mục</small></span>
    </div>
    <div class="category-summary-card category-summary-active">
        <span class="category-summary-icon"><i class="fas fa-eye"></i></span>
        <span><strong>@activeCategoryCount</strong><small>Đang hiển thị trang này</small></span>
    </div>
    <div class="category-summary-card category-summary-hidden">
        <span class="category-summary-icon"><i class="fas fa-eye-slash"></i></span>
        <span><strong>@inactiveCategoryCount</strong><small>Đang ẩn trang này</small></span>
    </div>
</div>

<!-- ========================================= -->
<!-- SEARCH -->
<!-- ========================================= -->

<div class="card category-card category-filter-card mb-3">

    <div class="card-body">

        <form asp-action="Index"
              method="get">

            <div class="category-search-row">

                <label class="category-search-field">
                    <i class="fas fa-search"></i>

                    <input asp-for="Filter.Keyword"
                           class="form-control category-input"
                           placeholder="Tìm theo mã danh mục hoặc tên danh mục..." />

                </label>

                <div class="category-search-actions">
                    @if (hasKeyword)
                    {
                        <a asp-action="Index" class="btn category-clear-btn">
                            <i class="fas fa-rotate-left"></i>
                            Xóa lọc
                        </a>
                    }

                    <button type="submit"
                            class="btn category-primary-btn">

                        <i class="fas fa-search me-2"></i>
                        Tìm kiếm

                    </button>

                </div>

            </div>

        </form>

    </div>

</div>

<div class="card category-card category-list-card">

    <div class="card-body p-0">
        <div class="category-list-heading">
            <div>
                <h3>Danh sách danh mục</h3>
                <p>Sắp xếp sản phẩm theo từng nhóm để khách hàng tìm món nhanh hơn.</p>
            </div>
            <span class="category-result-pill">@Model.Categories.TotalCount kết quả</span>
        </div>

        <div class="table-responsive">
        <table class="table table-hover mb-0 category-table">

            <thead class="bg-light text-muted">
                <tr>
                    <th class="border-0 py-3 text-center" style="width: 25%;">
                        Mã danh mục
                    </th>
                    <th class="border-0 py-3 text-center" style="width: 10%;">
                        Icon
                    </th>
                    <th class="border-0 py-3" style="width: 35%;">
                        Tên danh mục
                    </th>
                    <th class="border-0 py-3 text-center" style="width: 15%;">
                        Trạng thái
                    </th>
                    <th class="border-0 text-center py-3" style="width: 15%;">
                        Hành động
                    </th>
                </tr>
            </thead>

            <tbody>
                @if (!categories.Any())
                {
                    <tr>
                        <td colspan="5"
                            class="category-empty-state">
                            <span class="category-empty-icon"><i class="fas fa-mug-hot"></i></span>
                            <strong>@(hasKeyword ? "Không tìm thấy danh mục phù hợp" : "Chưa có danh mục nào")</strong>
                            <small>@(hasKeyword ? "Thử một từ khóa khác hoặc xóa bộ lọc hiện tại." : "Tạo danh mục đầu tiên để bắt đầu tổ chức thực đơn.")</small>
                        </td>
                    </tr>
                }

                @foreach (var item in categories)
                {
                    <tr>
                        <td class="py-3 text-center">
                            @item.CategoryCode
                        </td>

                        <td class="py-3 text-center category-icon-cell">
                            @if (!string.IsNullOrWhiteSpace(item.Icon))
                            {
                                <span class="category-icon-badge">
                                    @item.Icon
                                </span>
                            }
                            else
                            {
                                <span class="category-icon-badge category-icon-empty"
                                      title="No icon configured">
                                    -
                                </span>
                            }
                        </td>

                        <td class="py-3 category-name">
                            @item.Name
                        </td>

                        <td class="py-3 text-center">
                            @if (item.Active)
                            {
                                <span class="badge badge-active">
                                    Hiển thị
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted badge-inactive">
                                    Ẩn
                                </span>
                            }
                        </td>

                        <td class="text-center py-3 category-actions-cell">
                            <div class="d-inline-flex align-items-center justify-content-center gap-1">
                                @if (canUpdateCategory)
                                {
                                <button type="button"
                                        class="btn btn-sm category-action-btn category-action-edit btn-edit-category"
                                        data-id="@item.CategoryId"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editCategoryModal"
                                        title="Sửa">
                                    <i class="fas fa-pen"></i>
                                </button>
                                }

                                @if (canToggleCategoryStatus)
                                {
                                <button type="button"
                                        class="btn btn-sm category-action-btn @(item.Active ? "category-action-lock" : "category-action-unlock")"
                                        onclick="toggleCategory(@item.CategoryId)"
                                        title="@(item.Active ? "Ẩn" : "Hiển thị")">
                                    <i class="fas @(item.Active ? "fa-lock" : "fa-unlock")"></i>
                                </button>
                                }
                            </div>
                        </td>
                    </tr>
                }

            </tbody>

        </table>
        </div>

    </div>
        <div class="card-footer category-table-footer">

        <span class="text-muted">

            Hiển thị @Model.Categories.TotalCount danh mục

        </span>

        <div class="pagination mb-0 d-flex gap-1">

            <a asp-action="Index"
               asp-route-keyword="@Model.Filter.Keyword"
               asp-route-page="@(Model.Categories.PageIndex - 1)"
               class="btn btn-sm btn-light border @(Model.Categories.HasPreviousPage ? "" : "disabled")">

                <i class="fas fa-chevron-left text-muted"></i>

            </a>

            @for (int i = 1; i <= Model.Categories.TotalPages; i++)
            {
                <a asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-page="@i"
                   class="btn btn-sm category-page-link @(i == Model.Categories.PageIndex ? "active" : "")">

                    @i

                </a>
            }

            <a asp-action="Index"
               asp-route-keyword="@Model.Filter.Keyword"
               asp-route-page="@(Model.Categories.PageIndex + 1)"
               class="btn btn-sm btn-light border @(Model.Categories.HasNextPage ? "" : "disabled")">

                <i class="fas fa-chevron-right text-muted"></i>

            </a>

        </div>

    </div>

</div>
</div>

<!-- ========================================= -->
<!-- CREATE MODAL -->
<!-- ========================================= -->

<div class="modal fade"
     id="createCategoryModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content category-modal-content">

            <div class="modal-header border-0">

                <h5 class="modal-title">

                    Thêm danh mục mới

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <form id="createCategoryForm"
                      asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <button type="button"
                                id="btnSuggestCategories"
                                class="btn btn-outline-primary d-none"
                                aria-hidden="true"
                                tabindex="-1"
                                disabled>
                            <i class="fas fa-wand-magic-sparkles me-2"></i>AI Gợi Ý
                        </button>
                    </div>

                    <div id="categoryAiSuggestions" class="category-ai-suggestions d-none mb-3" aria-live="polite">
                        <div id="categoryAiSuggestionMessage" class="small text-muted mb-2">Chọn một gợi ý để điền vào form:</div>
                        <div id="categoryAiSuggestionList" class="category-ai-suggestion-list"></div>
                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-semibold">

                            Mã danh mục

                        </label>

                        <input asp-for="Filter.Keyword"
                               type="hidden" />

                        <input type="text"
                               name="CategoryCode"
                               class="form-control category-input"
                               placeholder="Nhập mã danh mục..." />

                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-semibold">

                            Tên danh mục

                        </label>

                        <input type="text"
                               name="Name"
                               class="form-control category-input"
                               placeholder="Nhập tên danh mục..." />

                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-semibold">

                            Icon

                        </label>

                        <div class="category-icon-picker" data-category-icon-picker>
                            <div class="input-group category-icon-toolbar">
                                <span class="input-group-text category-icon-preview" data-icon-preview aria-label="Xem trước icon">—</span>
                                <input type="text"
                                       id="createCategoryIcon"
                                       name="Icon"
                                       maxlength="10"
                                       autocomplete="off"
                                       class="form-control category-input"
                                       data-icon-input
                                       aria-describedby="createCategoryIconHelp"
                                       placeholder="Ví dụ: ☕" />
                                <button type="button" class="btn btn-outline-secondary" data-icon-toggle aria-expanded="false">
                                    <i class="fas fa-icons me-1"></i>Chọn biểu tượng
                                </button>
                                <button type="button" class="btn btn-outline-danger" data-icon-clear title="Xóa icon" aria-label="Xóa icon">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                            <small id="createCategoryIconHelp" class="text-muted">Chọn hoặc nhập một biểu tượng Unicode.</small>
                            <div class="category-icon-picker-panel d-none" data-icon-panel>
                                <input type="search"
                                       class="form-control form-control-sm mb-2"
                                       data-icon-search
                                       placeholder="Tìm cà phê, trà, trái cây..."
                                       aria-label="Tìm biểu tượng" />
                                <div class="category-icon-groups" data-icon-groups></div>
                            </div>
                        </div>

                    </div>

                    <div class="form-check form-switch mb-4">

                        <input type="checkbox"
                               name="Active"
                               value="true"
                               checked
                               class="form-check-input" />

                        <label class="form-check-label">

                            Hoạt động

                        </label>

                    </div>

                    <div class="text-end">

                        <button type="button"
                                class="btn btn-light"
                                data-bs-dismiss="modal">

                            Hủy

                        </button>

                        <button type="submit"
                                id="btnCreateCategory"
                                class="btn category-primary-btn"
                                disabled="@(!canCreateCategory)"
                                title="@(canCreateCategory ? "Lưu danh mục" : "Bạn không có quyền thêm danh mục")">

                            <i class="fas fa-save me-2"></i>

                            Lưu danh mục

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>
<!-- ========================================= -->
<!-- EDIT MODAL -->
<!-- ========================================= -->

<div class="modal fade"
     id="editCategoryModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content category-modal-content">

            <div class="modal-header border-0">

                <h5 class="modal-title">

                    Chỉnh sửa danh mục

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <form id="editCategoryForm"
                      asp-action="Edit"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           id="editCategoryId"
                           name="CategoryId" />

                    <div class="mb-3">

                        <label class="form-label fw-semibold">

                            Mã danh mục

                        </label>

                        <input type="text"
                               id="editCategoryCode"
                               name="CategoryCode"
                               class="form-control category-input"
                               placeholder="Nhập mã danh mục..." />

                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-semibold">

                            Tên danh mục

                        </label>

                        <input type="text"
                               id="editCategoryName"
                               name="Name"
                               class="form-control category-input"
                               placeholder="Nhập tên danh mục..." />

                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-semibold">

                            Icon

                        </label>

                        <div class="category-icon-picker" data-category-icon-picker>
                            <div class="input-group category-icon-toolbar">
                                <span class="input-group-text category-icon-preview" data-icon-preview aria-label="Xem trước icon">—</span>
                                <input type="text"
                                       id="editCategoryIcon"
                                       name="Icon"
                                       maxlength="10"
                                       autocomplete="off"
                                       class="form-control category-input"
                                       data-icon-input
                                       aria-describedby="editCategoryIconHelp"
                                       placeholder="Ví dụ: ☕" />
                                <button type="button" class="btn btn-outline-secondary" data-icon-toggle aria-expanded="false">
                                    <i class="fas fa-icons me-1"></i>Chọn biểu tượng
                                </button>
                                <button type="button" class="btn btn-outline-danger" data-icon-clear title="Xóa icon" aria-label="Xóa icon">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                            <small id="editCategoryIconHelp" class="text-muted">Chọn hoặc nhập một biểu tượng Unicode.</small>
                            <div class="category-icon-picker-panel d-none" data-icon-panel>
                                <input type="search"
                                       class="form-control form-control-sm mb-2"
                                       data-icon-search
                                       placeholder="Tìm cà phê, trà, trái cây..."
                                       aria-label="Tìm biểu tượng" />
                                <div class="category-icon-groups" data-icon-groups></div>
                            </div>
                        </div>

                    </div>

                    <div class="form-check form-switch mb-4">

                        <input type="checkbox"
                               id="editCategoryActive"
                               name="Active"
                               value="true"
                               class="form-check-input" />

                        <label class="form-check-label">

                            Hoạt động

                        </label>

                    </div>

                    <div class="text-end">

                        <button type="button"
                                class="btn btn-light"
                                data-bs-dismiss="modal">

                            Hủy

                        </button>

                        <button type="submit"
                                id="btnEditCategory"
                                class="btn category-primary-btn"
                                disabled="@(!canUpdateCategory)"
                                title="@(canUpdateCategory ? "Cập nhật" : "Bạn không có quyền cập nhật danh mục")">

                            <i class="fas fa-save me-2"></i>

                            Cập nhật

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script src="~/js/Admin/Category/Category.js"></script>
}
