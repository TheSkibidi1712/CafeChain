@model CafeChain.ViewModels.Admin.Categories.AdminCategoryIndexViewModel
@using System.Security.Claims
@using CafeChain.Application.Constants
@using CafeChain.Application.Interfaces.Admin.Permissions
@using Microsoft.Extensions.Localization
@inject IAdminPermissionService PermissionService
@inject IStringLocalizer<CafeChain.SharedResource> SharedText

@{
    ViewData["Title"] = SharedText["Category.Title"];
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var canCreateCategory = false;
    var canUpdateCategory = false;
    var canToggleCategoryStatus = false;

    var currentAccountIdValue =
        User.FindFirstValue(ClaimTypes.NameIdentifier);

    if (User.Identity?.IsAuthenticated == true &&
        int.TryParse(currentAccountIdValue, out var currentAccountId))
    {
        var createDecision =
            await PermissionService.HasPermissionAsync(
                currentAccountId,
                PermissionConstants.CategoryCreate);

        var updateDecision =
            await PermissionService.HasPermissionAsync(
                currentAccountId,
                PermissionConstants.CategoryUpdate);

        var toggleStatusDecision =
            await PermissionService.HasPermissionAsync(
                currentAccountId,
                PermissionConstants.CategoryToggleStatus);

        canCreateCategory =
            createDecision.IsSuccess &&
            createDecision.Data?.Allowed == true;

        canUpdateCategory =
            updateDecision.IsSuccess &&
            updateDecision.Data?.Allowed == true;

        canToggleCategoryStatus =
            toggleStatusDecision.IsSuccess &&
            toggleStatusDecision.Data?.Allowed == true;
    }

    var categories = Model.Categories.Items.ToList();
    var activeCategoryCount = categories.Count(item => item.Active);
    var inactiveCategoryCount = categories.Count - activeCategoryCount;
    var hasKeyword = !string.IsNullOrWhiteSpace(Model.Filter.Keyword);
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/Category/Category.css" asp-append-version="true" />
    <style>
        input.custom-val:invalid:not(:placeholder-shown) {
            border-color: #dc3545 !important;
            color: #dc3545 !important;
        }
        input.custom-val:invalid:not(:placeholder-shown) ~ .error-msg {
            display: block !important;
        }
        input.custom-val:invalid:not(:placeholder-shown) ~ .text-muted {
            display: none !important;
        }
    </style>
}

@Html.AntiForgeryToken()

<main class="category-page ops-shell cc-warehouse-page">
    <header class="category-page-header ops-header cc-warehouse-header">
        <div>
            <div class="category-eyebrow ops-eyebrow">@SharedText["Category.Eyebrow"]</div>

            <h1 class="category-page-title ops-title">
                <i class="fa-solid fa-folder-tree me-2 text-warning" aria-hidden="true"></i>@SharedText["Category.Title"]
            </h1>

            <p class="category-page-description ops-subtitle">
                @SharedText["Category.Description"]
            </p>
        </div>

        <div class="category-header-actions ops-actions">
            @if (canCreateCategory)
            {
                <button type="button"
                        class="btn category-primary-btn category-add-btn"
                        data-bs-toggle="modal"
                        data-bs-target="#createCategoryModal"
                        title="@SharedText["Category.Add"]">
                    <i class="fas fa-plus me-2"></i>
                    @SharedText["Category.Add"]
                </button>
            }
        </div>
    </header>

<div class="category-summary-grid">
    <div class="category-summary-card category-summary-total">
        <span class="category-summary-icon"><i class="fas fa-layer-group"></i></span>
        <span><strong>@Model.Categories.TotalCount</strong><small>@SharedText["Category.Total"]</small></span>
    </div>
    <div class="category-summary-card category-summary-active">
        <span class="category-summary-icon"><i class="fas fa-eye"></i></span>
        <span><strong>@activeCategoryCount</strong><small>@SharedText["Category.VisiblePage"]</small></span>
    </div>
    <div class="category-summary-card category-summary-hidden">
        <span class="category-summary-icon"><i class="fas fa-eye-slash"></i></span>
        <span><strong>@inactiveCategoryCount</strong><small>@SharedText["Category.HiddenPage"]</small></span>
    </div>
</div>

<!-- ========================================= -->
<!-- SEARCH -->
<!-- ========================================= -->

<form asp-action="Index"
      method="get"
      class="category-search-row pa-band pa-filter-grid cc-warehouse-filter">

    <div class="category-search-field">
        <button type="submit" class="category-search-btn" title="@SharedText["Category.Search"]" aria-label="@SharedText["Category.SearchAria"]">
            <i class="fas fa-search" aria-hidden="true"></i>
        </button>
        <input asp-for="Filter.Keyword"
               class="form-control category-input"
               placeholder="@SharedText["Category.SearchPlaceholder"]" />
    </div>

    <div class="category-search-actions">
        @if (hasKeyword)
        {
            <a asp-action="Index" class="btn category-clear-btn">
                <i class="fas fa-rotate-left"></i>
                @SharedText["Category.Clear"]
            </a>
        }

        <button type="submit"
                class="btn category-primary-btn">
            <i class="fas fa-search me-2"></i>
            @SharedText["Category.Search"]
        </button>
    </div>

</form>

<div class="card category-card category-list-card">

    <div class="card-body p-0">
        <div class="category-list-heading">
            <div>
                <h3>@SharedText["Category.List"]</h3>
                <p>@SharedText["Category.ListDescription"]</p>
            </div>
            <span class="category-result-pill">@SharedText["Category.Results", Model.Categories.TotalCount]</span>
        </div>

        <div class="table-responsive">
        <table class="table table-hover mb-0 category-table">

            <thead class="bg-light text-muted">
                <tr>
                    <th class="border-0 py-3 text-center" style="width: 25%;">
                        @SharedText["Category.Code"]
                    </th>
                    <th class="border-0 py-3 text-center" style="width: 10%;">
                        Icon
                    </th>
                    <th class="border-0 py-3" style="width: 35%;">
                        @SharedText["Category.Name"]
                    </th>
                    <th class="border-0 py-3 text-center" style="width: 15%;">
                        @SharedText["Common.Status"]
                    </th>
                    <th class="border-0 text-center py-3" style="width: 15%;">
                        @SharedText["Common.Actions"]
                    </th>
                </tr>
            </thead>

            <tbody>
                @if (!categories.Any())
                {
                    <tr>
                        <td colspan="5"
                            class="category-empty-state">
                            <span class="category-empty-icon"><i class="fas fa-mug-hot"></i></span>
                            <strong>@(hasKeyword ? SharedText["Category.Empty.FilteredTitle"] : SharedText["Category.Empty.DefaultTitle"])</strong>
                            <small>@(hasKeyword ? SharedText["Category.Empty.FilteredDetail"] : SharedText["Category.Empty.DefaultDetail"])</small>
                        </td>
                    </tr>
                }

                @foreach (var item in categories)
                {
                    <tr>
                        <td class="py-3 text-center">
                            @item.CategoryCode
                        </td>

                        <td class="py-3 text-center category-icon-cell">
                            @if (!string.IsNullOrWhiteSpace(item.Icon))
                            {
                                <span class="category-icon-badge">
                                    @item.Icon
                                </span>
                            }
                            else
                            {
                                <span class="category-icon-badge category-icon-empty"
                                      title="No icon configured">
                                    -
                                </span>
                            }
                        </td>

                        <td class="py-3 category-name">
                            @item.Name
                        </td>

                        <td class="py-3 text-center">
                            @if (item.Active)
                            {
                                <span class="badge badge-active">
                                    @SharedText["Common.Visible"]
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted badge-inactive">
                                    @SharedText["Common.Hidden"]
                                </span>
                            }
                        </td>

                        <td class="text-center py-3 category-actions-cell">
                            <div class="d-inline-flex align-items-center justify-content-center gap-1">
                                @if (canUpdateCategory)
                                {
                                <button type="button"
                                        class="btn btn-sm category-action-btn category-action-edit btn-edit-category"
                                        data-id="@item.CategoryId"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editCategoryModal"
                                        title="@SharedText["Common.Edit"]">
                                    <i class="fas fa-pen"></i>
                                </button>
                                }

                                @if (canToggleCategoryStatus)
                                {
                                <button type="button"
                                        class="btn btn-sm category-action-btn @(item.Active ? "category-action-lock" : "category-action-unlock")"
                                        onclick="toggleCategory(@item.CategoryId)"
                                        title="@(item.Active ? SharedText["Common.Hidden"] : SharedText["Common.Visible"])">
                                    <i class="fas @(item.Active ? "fa-lock" : "fa-unlock")"></i>
                                </button>
                                }
                            </div>
                        </td>
                    </tr>
                }

            </tbody>

        </table>
        </div>

    </div>
        <div class="card-footer category-table-footer">

        <span class="text-muted">

            @SharedText["Category.Footer.Count", Model.Categories.TotalCount]

        </span>

        <div class="pagination mb-0 d-flex gap-1">

            <a asp-action="Index"
               asp-route-keyword="@Model.Filter.Keyword"
               asp-route-page="@(Model.Categories.PageIndex - 1)"
               class="btn btn-sm btn-light border @(Model.Categories.HasPreviousPage ? "" : "disabled")">

                <i class="fas fa-chevron-left text-muted"></i>

            </a>

            @for (int i = 1; i <= Model.Categories.TotalPages; i++)
            {
                <a asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-page="@i"
                   class="btn btn-sm category-page-link @(i == Model.Categories.PageIndex ? "active" : "")">

                    @i

                </a>
            }

            <a asp-action="Index"
               asp-route-keyword="@Model.Filter.Keyword"
               asp-route-page="@(Model.Categories.PageIndex + 1)"
               class="btn btn-sm btn-light border @(Model.Categories.HasNextPage ? "" : "disabled")">

                <i class="fas fa-chevron-right text-muted"></i>

            </a>

        </div>

    </div>

</div>
</main>

<!-- ========================================= -->
<!-- CREATE MODAL -->
<!-- ========================================= -->

<div class="modal fade"
     id="createCategoryModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content category-modal-content">

            <div class="modal-header border-0">

                <h5 class="modal-title">

                    @SharedText["Category.Add"]

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <form id="createCategoryForm"
                      asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <button type="button"
                                id="btnSuggestCategories"
                                class="btn btn-outline-primary d-none"
                                aria-hidden="true"
                                tabindex="-1"
                                disabled>
                            <i class="fas fa-wand-magic-sparkles me-2"></i>@SharedText["Category.Form.AiSuggest"]
                        </button>
                    </div>

                    <div id="categoryAiSuggestions" class="category-ai-suggestions d-none mb-3" aria-live="polite">
                        <div id="categoryAiSuggestionMessage" class="small text-muted mb-2">@SharedText["Category.Form.AiChoose"]</div>
                        <div id="categoryAiSuggestionList" class="category-ai-suggestion-list"></div>
                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-semibold">

                            @SharedText["Category.Form.Code.Label"] <span class="text-danger">*</span>

                        </label>

                        <input asp-for="Filter.Keyword"
                               type="hidden" />

                        <input type="text"
                               name="CategoryCode"
                               class="form-control category-input custom-val"
                               placeholder="@SharedText["Category.Form.Code.Placeholder"]"
                               required
                               pattern="^.{1,50}$"
                               title="@SharedText["Category.Form.Code.Help"]" />
                        <small class="text-danger d-none error-msg mt-1"><i class="fas fa-exclamation-circle me-1"></i> @SharedText["Category.Form.Code.Invalid"]</small>
                        <small class="text-muted d-block mt-1">@SharedText["Category.Form.Code.Help"]</small>

                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-semibold">

                            @SharedText["Category.Form.Name.Label"] <span class="text-danger">*</span>

                        </label>

                        <input type="text"
                               name="Name"
                               class="form-control category-input custom-val"
                               placeholder="@SharedText["Category.Form.Name.Placeholder"]"
                               required
                               pattern="^.{1,100}$"
                               title="@SharedText["Category.Form.Name.Help"]" />
                        <small class="text-danger d-none error-msg mt-1"><i class="fas fa-exclamation-circle me-1"></i> @SharedText["Category.Form.Name.Invalid"]</small>
                        <small class="text-muted d-block mt-1">@SharedText["Category.Form.Name.Help"]</small>

                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-semibold">

                            Icon

                        </label>

                        <div class="category-icon-picker" data-category-icon-picker>
                            <div class="input-group category-icon-toolbar">
                                <span class="input-group-text category-icon-preview" data-icon-preview aria-label="@SharedText["Category.Form.Icon.Preview"]">—</span>
                                <input type="text"
                                       id="createCategoryIcon"
                                       name="Icon"
                                       maxlength="10"
                                       autocomplete="off"
                                       class="form-control category-input"
                                       data-icon-input
                                       aria-describedby="createCategoryIconHelp"
                                       placeholder="@SharedText["Category.Form.Icon.Example"]" />
                                <button type="button" class="btn btn-outline-secondary" data-icon-toggle aria-expanded="false">
                                    <i class="fas fa-icons me-1"></i>@SharedText["Category.Form.Icon.Select"]
                                </button>
                                <button type="button" class="btn btn-outline-danger" data-icon-clear title="@SharedText["Category.Form.Icon.Clear"]" aria-label="@SharedText["Category.Form.Icon.Clear"]">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                            <small id="createCategoryIconHelp" class="text-muted">@SharedText["Category.Form.Icon.Help"]</small>
                            <div class="category-icon-picker-panel d-none" data-icon-panel>
                                <input type="search"
                                       class="form-control form-control-sm mb-2"
                                       data-icon-search
                                       placeholder="@SharedText["Category.Form.Icon.Search"]"
                                       aria-label="@SharedText["Category.Form.Icon.Select"]" />
                                <div class="category-icon-groups" data-icon-groups></div>
                            </div>
                        </div>

                    </div>

                    <div class="form-check form-switch mb-4">

                        <input type="checkbox"
                               name="Active"
                               value="true"
                               checked
                               class="form-check-input" />

                        <label class="form-check-label">

                            @SharedText["Category.Form.Active"]

                        </label>

                    </div>

                    <div class="text-end">

                        <button type="button"
                                class="btn btn-light"
                                data-bs-dismiss="modal">

                            @SharedText["Common.Cancel"]

                        </button>

                        <button type="submit"
                                id="btnCreateCategory"
                                class="btn category-primary-btn"
                                data-can-submit="@canCreateCategory.ToString().ToLowerInvariant()"
                                disabled="@(!canCreateCategory)"
                                title="@(canCreateCategory ? SharedText["Category.Form.Save"] : SharedText["Category.Form.NoCreatePermission"])">

                            <i class="fas fa-save me-2"></i>

                            @SharedText["Category.Form.Save"]

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>
<!-- ========================================= -->
<!-- EDIT MODAL -->
<!-- ========================================= -->

<div class="modal fade"
     id="editCategoryModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content category-modal-content">

            <div class="modal-header border-0">

                <h5 class="modal-title">

                    @SharedText["Category.Form.Edit.Title"]

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <form id="editCategoryForm"
                      asp-action="Edit"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           id="editCategoryId"
                           name="CategoryId" />

                    <div class="mb-3">

                        <label class="form-label fw-semibold">

                            @SharedText["Category.Form.Code.Label"] <span class="text-danger">*</span>

                        </label>

                        <input type="text"
                               id="editCategoryCode"
                               name="CategoryCode"
                               class="form-control category-input custom-val"
                               placeholder="@SharedText["Category.Form.Code.Placeholder"]"
                               required
                               pattern="^.{1,50}$"
                               title="@SharedText["Category.Form.Code.Help"]" />
                        <small class="text-danger d-none error-msg mt-1"><i class="fas fa-exclamation-circle me-1"></i> @SharedText["Category.Form.Code.Invalid"]</small>
                        <small class="text-muted d-block mt-1">@SharedText["Category.Form.Code.Help"]</small>

                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-semibold">

                            @SharedText["Category.Form.Name.Label"] <span class="text-danger">*</span>

                        </label>

                        <input type="text"
                               id="editCategoryName"
                               name="Name"
                               class="form-control category-input custom-val"
                               placeholder="@SharedText["Category.Form.Name.Placeholder"]"
                               required
                               pattern="^.{1,100}$"
                               title="@SharedText["Category.Form.Name.Help"]" />
                        <small class="text-danger d-none error-msg mt-1"><i class="fas fa-exclamation-circle me-1"></i> @SharedText["Category.Form.Name.Invalid"]</small>
                        <small class="text-muted d-block mt-1">@SharedText["Category.Form.Name.Help"]</small>

                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-semibold">

                            Icon

                        </label>

                        <div class="category-icon-picker" data-category-icon-picker>
                            <div class="input-group category-icon-toolbar">
                                <span class="input-group-text category-icon-preview" data-icon-preview aria-label="@SharedText["Category.Form.Icon.Preview"]">—</span>
                                <input type="text"
                                       id="editCategoryIcon"
                                       name="Icon"
                                       maxlength="10"
                                       autocomplete="off"
                                       class="form-control category-input"
                                       data-icon-input
                                       aria-describedby="editCategoryIconHelp"
                                       placeholder="@SharedText["Category.Form.Icon.Example"]" />
                                <button type="button" class="btn btn-outline-secondary" data-icon-toggle aria-expanded="false">
                                    <i class="fas fa-icons me-1"></i>@SharedText["Category.Form.Icon.Select"]
                                </button>
                                <button type="button" class="btn btn-outline-danger" data-icon-clear title="@SharedText["Category.Form.Icon.Clear"]" aria-label="@SharedText["Category.Form.Icon.Clear"]">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                            <small id="editCategoryIconHelp" class="text-muted">@SharedText["Category.Form.Icon.Help"]</small>
                            <div class="category-icon-picker-panel d-none" data-icon-panel>
                                <input type="search"
                                       class="form-control form-control-sm mb-2"
                                       data-icon-search
                                       placeholder="@SharedText["Category.Form.Icon.Search"]"
                                       aria-label="@SharedText["Category.Form.Icon.Select"]" />
                                <div class="category-icon-groups" data-icon-groups></div>
                            </div>
                        </div>

                    </div>

                    <div class="form-check form-switch mb-4">

                        <input type="checkbox"
                               id="editCategoryActive"
                               name="Active"
                               value="true"
                               class="form-check-input" />

                        <label class="form-check-label">

                            @SharedText["Category.Form.Active"]

                        </label>

                    </div>

                    <div class="text-end">

                        <button type="button"
                                class="btn btn-light"
                                data-bs-dismiss="modal">

                            @SharedText["Common.Cancel"]

                        </button>

                        <button type="submit"
                                id="btnEditCategory"
                                class="btn category-primary-btn"
                                data-can-submit="@canUpdateCategory.ToString().ToLowerInvariant()"
                                disabled="@(!canUpdateCategory)"
                                title="@(canUpdateCategory ? SharedText["Category.Form.Update"] : SharedText["Category.Form.NoUpdatePermission"])">

                            <i class="fas fa-save me-2"></i>

                            @SharedText["Category.Form.Update"]

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_CategoryUiCatalog" />
    <script src="~/js/Admin/Category/Category.js" asp-append-version="true"></script>
}
