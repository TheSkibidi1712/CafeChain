@model CafeChain.ViewModels.Admin.Profitability.DrinkProfitabilityPageVM
@using CafeChain.ViewModels.Admin.Shared
@{
    ViewData["Title"] = "Vốn và lợi nhuận gộp dự kiến";
    var hero = new AdminPageHeroVM
    {
        Eyebrow = "Sản phẩm / Phân tích giá vốn",
        Title = "Vốn và lợi nhuận gộp dự kiến",
        Description = "Đối chiếu giá vốn theo nhập trước - xuất trước (FIFO), giá bán và khả năng sinh lời theo từng size đồ uống.",
        IconClass = "fas fa-chart-line",
        Breadcrumbs = [new() { Label = "Sản phẩm" }, new() { Label = "Vốn và lợi nhuận" }],
        Actions =
        [
            new()
            {
                Label = "Mở công thức và BOM",
                Url = Url.Action("Index", "AdminRecipe", new { area = "Admin" }) ?? "#",
                IconClass = "fas fa-flask"
            }
        ]
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/Profitability/drink-profitability.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/production-bom-ui.css" asp-append-version="true" />
    <style>
        .pf-status {
            white-space: nowrap !important;
        }
    </style>
}

<main class="pf-page ops-shell cc-warehouse-page" id="profitabilityApp"
      data-can-update-price="@Model.CanUpdateGlobalPrice.ToString().ToLowerInvariant()"
      data-can-manage-policy="@Model.CanManageToppingPolicy.ToString().ToLowerInvariant()">
    @Html.AntiForgeryToken()

    <header class="pf-header ops-header cc-warehouse-header">
        <div>
            <div class="ops-eyebrow">Sản phẩm / Phân tích giá vốn</div>
            <h1 class="ops-title">Vốn và lợi nhuận gộp dự kiến</h1>
            <p class="ops-subtitle">Đối chiếu giá vốn theo nhập trước - xuất trước (FIFO), giá bán và khả năng sinh lời theo từng size đồ uống.</p>
        </div>
        <div class="ops-actions">
            <a class="pf-link-button ops-btn" asp-area="Admin" asp-controller="AdminRecipe" asp-action="Index">
                <i class="fas fa-flask" aria-hidden="true"></i>
                <span>Mở công thức và BOM</span>
            </a>
        </div>
    </header>

    <div class="pf-section-heading">
        <div>
            <span class="pf-section-icon"><i class="fas fa-sliders"></i></span>
            <div><h2>Thiết lập mô phỏng</h2><p>Chọn phạm vi dữ liệu cần phân tích.</p></div>
        </div>
        <span class="pf-section-note"><i class="fas fa-shield-halved"></i> Dữ liệu FIFO theo cửa hàng</span>
    </div>
    <section class="pf-filter-band" aria-label="Bộ lọc mô phỏng giá vốn">
        <label>
            <span>Cửa hàng mô phỏng FIFO</span>
            <select id="storeSelect" class="pf-control">
                @foreach (var store in Model.Stores)
                {
                    <option value="@store.Id">@store.Name</option>
                }
            </select>
        </label>
        <label>
            <span>Đồ uống</span>
            <select id="drinkSelect" class="pf-control">
                @foreach (var drink in Model.Drinks)
                {
                    <option value="@drink.Id">@drink.Name</option>
                }
            </select>
        </label>
        <button type="button" id="refreshPreview" class="pf-primary-button">
            <i class="fas fa-rotate" aria-hidden="true"></i>
            Tải lại
        </button>
    </section>

    <aside class="pf-global-notice">
        <i class="fas fa-circle-info" aria-hidden="true"></i>
        <strong>Giá bán áp dụng toàn hệ thống.</strong>
        <span>Giá vốn được mô phỏng theo cửa hàng đang chọn.</span>
    </aside>

    <section class="pf-meta" id="previewMeta" hidden>
        <div><span>Nguồn chi phí</span><strong>FIFO cửa hàng</strong></div>
        <div><span>Thời điểm tính</span><strong id="costTimestamp">-</strong></div>
        <div><span>Số size</span><strong id="sizeCount">0</strong></div>
        <div><span>Dữ liệu hoàn chỉnh</span><strong id="readyCount">0</strong></div>
    </section>

    <section class="pf-result-band" aria-live="polite">
        <div class="pf-result-heading">
            <div><span class="pf-section-icon"><i class="fas fa-table-list"></i></span><div><h2>Kết quả phân tích</h2><p>So sánh chi phí và khả năng sinh lời theo từng cấu hình size.</p></div></div>
        </div>
        <div id="loadingState" class="pf-state" hidden>
            <span class="pf-spinner" aria-hidden="true"></span>
            <strong>Đang mô phỏng lớp giá FIFO...</strong>
        </div>
        <div id="errorState" class="pf-state pf-state-error" hidden>
            <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
            <div><strong>Không tải được dữ liệu</strong><p id="errorMessage"></p></div>
            <button type="button" id="retryPreview" class="pf-secondary-button">Thử lại</button>
        </div>
        <div id="emptyState" class="pf-state" hidden>
            <i class="fas fa-mug-saucer" aria-hidden="true"></i>
            <strong>Chưa có size đang hoạt động cho đồ uống này.</strong>
        </div>

        <div class="pf-table-wrap" id="tableWrap" hidden>
            <table class="pf-table">
                <colgroup>
                    <col class="pf-col-size" />
                    <col class="pf-col-status" />
                    <col class="pf-col-cost" />
                    <col class="pf-col-price" />
                    <col class="pf-col-profit" />
                    <col class="pf-col-margin" />
                    <col class="pf-col-markup" />
                    <col class="pf-col-actions" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Size / Định mức nguyên liệu (BOM)</th>
                        <th>Trạng thái chi phí</th>
                        <th class="pf-number">Giá vốn FIFO</th>
                        <th class="pf-number">Giá bán toàn hệ thống</th>
                        <th class="pf-number">Lợi nhuận gộp</th>
                        <th class="pf-number">Biên lợi nhuận gộp (Margin)</th>
                        <th class="pf-number">Tỷ lệ cộng giá (Markup)</th>
                        <th class="pf-action-header">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="profitabilityRows"></tbody>
            </table>
        </div>
    </section>

    <aside class="offcanvas offcanvas-end pf-drawer" id="priceDrawer" tabindex="-1" aria-labelledby="priceDrawerTitle">
        <div class="pf-drawer-header">
            <div><span class="cc-page-kicker">Giá bán toàn hệ thống</span><h2 class="cc-page-title" id="priceDrawerTitle">Cập nhật giá</h2></div>
            <button type="button" class="pf-icon-button" data-bs-dismiss="offcanvas" title="Đóng"><i class="fas fa-xmark"></i></button>
        </div>
        <div class="pf-drawer-body">
            <div class="pf-price-summary">
                <div><span>Giá vốn FIFO</span><strong id="drawerCost">-</strong></div>
                <div><span>Giá hiện tại</span><strong id="drawerCurrentPrice">-</strong></div>
            </div>
            <section class="pf-form-section">
                <h3>Giá đề xuất</h3>
                <div class="pf-form-grid">
                    <label><span>Mục tiêu</span><select id="targetMode" class="pf-control"><option value="MARGIN">Biên lợi nhuận gộp (Margin)</option><option value="MARKUP">Tỷ lệ cộng giá (Markup)</option><option value="PROFIT_AMOUNT">Tiền lời mong muốn</option></select></label>
                    <label><span>Giá trị mục tiêu</span><input id="targetValue" class="pf-control" type="number" min="0" step="0.01" /></label>
                    <label class="pf-span-2"><span>Quy tắc làm tròn giá</span><select id="roundingMode" class="pf-control"><option value="NONE">Không làm tròn</option><option value="NEAREST_500">Gần nhất 500đ</option><option value="CEILING_500">Làm tròn lên 500đ</option><option value="NEAREST_1000">Gần nhất 1.000đ</option><option value="CEILING_1000">Làm tròn lên 1.000đ</option></select></label>
                </div>
                <button type="button" id="calculateSuggestion" class="pf-secondary-button">Tính giá đề xuất</button>
                <div id="suggestionResult" class="pf-suggestion" hidden></div>
            </section>
            <section class="pf-form-section">
                <h3>Giá bán mới</h3>
                <label><span>Giá bán (VND)</span><input id="newSellingPrice" class="pf-control" type="number" min="1" step="500" /></label>
                <div class="pf-price-summary">
                    <div><span>Phạm vi áp dụng</span><strong>Toàn hệ thống</strong></div>
                    <div><span>Thời điểm hiệu lực</span><strong>Ngay khi xác nhận</strong></div>
                </div>
                <label><span>Lý do thay đổi <strong aria-hidden="true">*</strong></span><textarea id="priceReason" class="pf-control" rows="3" maxlength="500" required></textarea></label>
                <label id="incompleteConfirmation" class="pf-check" hidden><input type="checkbox" id="confirmIncomplete" /><span>Tôi xác nhận giá vốn chưa đầy đủ và vẫn muốn lưu giá thủ công.</span></label>
                <div id="priceFormError" class="pf-inline-error" hidden></div>
            </section>
        </div>
        <div class="pf-drawer-footer">
            <button type="button" class="pf-secondary-button" data-bs-dismiss="offcanvas">Hủy</button>
            <button type="button" id="savePrice" class="pf-primary-button">Xác nhận áp dụng giá</button>
        </div>
    </aside>

    <aside class="offcanvas offcanvas-end pf-drawer" id="policyDrawer" tabindex="-1" aria-labelledby="policyDrawerTitle">
        <div class="pf-drawer-header">
            <div><span class="cc-page-kicker">Chính sách topping theo size</span><h2 class="cc-page-title" id="policyDrawerTitle">Topping cho món</h2></div>
            <button type="button" class="pf-icon-button" data-bs-dismiss="offcanvas" title="Đóng"><i class="fas fa-xmark"></i></button>
        </div>
        <div class="pf-drawer-body">
            <div id="policyList" class="pf-policy-list"></div>
            <section class="pf-form-section" id="policyFormSection">
                <h3 id="policyFormTitle">Thêm chính sách</h3>
                <input type="hidden" id="policyId" />
                <input type="hidden" id="policyRowVersion" />
                <label><span>Topping</span><select id="policyTopping" class="pf-control"></select></label>
                <label><span>Xử lý giá bán</span><select id="priceTreatment" class="pf-control"><option value="INCLUDED_IN_BASE_PRICE">Đã gồm trong giá gốc</option><option value="ADD_TOPPING_PRICE">Cộng giá topping</option></select></label>
                <label><span>Xử lý giá vốn</span><select id="costTreatment" class="pf-control"><option value="INCLUDED_IN_DRINK_RECIPE">Đã gồm trong BOM đồ uống</option><option value="ADD_TOPPING_RECIPE_COST">Cộng thêm giá vốn topping</option></select></label>
                <div class="pf-field-pair">
                    <label><span>Số lượng mỗi ly</span><input id="policyQuantity" class="pf-control" type="number" min="0.00001" step="0.01" value="1" /></label>
                    <label><span>Đơn vị</span><select id="policyQuantityUnit" class="pf-control"><option value="RECIPE_PORTION">Phần công thức</option></select></label>
                </div>
                <small>Một phần công thức tương ứng với một lần thực hiện BOM topping; nguyên liệu bên trong được quy đổi về đơn vị tồn kho.</small>
                <label class="pf-check"><input type="checkbox" id="policyDefaultSelected" checked /><span>Chọn mặc định trên POS</span></label>
                <label class="pf-check"><input type="checkbox" id="policyRequired" /><span>Bắt buộc chọn trên POS</span></label>
                <label><span>Lý do thay đổi <strong aria-hidden="true">*</strong></span><textarea id="policyReason" class="pf-control" rows="2" maxlength="500" required></textarea></label>
                <div id="policyFormError" class="pf-inline-error" hidden></div>
                <button type="button" id="savePolicy" class="pf-primary-button">Lưu chính sách</button>
            </section>
        </div>
    </aside>
</main>

@section Scripts {
    <script src="~/js/Admin/Profitability/drink-profitability.js" asp-append-version="true"></script>
}
