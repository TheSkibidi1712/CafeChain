@model CafeChain.ViewModels.Admin.Profitability.DrinkProfitabilityPageVM
@using Microsoft.Extensions.Localization
@using System.Text.Json
@inject IStringLocalizer<CafeChain.ProductResource> ProductText
@using CafeChain.ViewModels.Admin.Shared
@{
    ViewData["Title"] = ProductText["Profit.Title"];
    var hero = new AdminPageHeroVM
    {
        Eyebrow = ProductText["Profit.Eyebrow"],
        Title = ProductText["Profit.Title"],
        Description = ProductText["Profit.Description"],
        IconClass = "fas fa-chart-line",
        Breadcrumbs = [new() { Label = ProductText["Profit.Breadcrumb.Products"] }, new() { Label = ProductText["Profit.Breadcrumb.Current"] }],
        Actions =
        [
            new()
            {
                Label = ProductText["Profit.OpenBom"],
                Url = Url.Action("Index", "AdminRecipe", new { area = "Admin" }) ?? "#",
                IconClass = "fas fa-flask"
            }
        ]
    };
    var profitabilityJsCatalog = JsonSerializer.Serialize(ProductText.GetAllStrings()
        .Where(message => message.Name.StartsWith("Profit.Js.", StringComparison.Ordinal)
            || message.Name.StartsWith("Profit.Status.", StringComparison.Ordinal)
            || message.Name.StartsWith("Profit.Treatment.", StringComparison.Ordinal))
        .ToDictionary(message => message.Name, message => message.Value));
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/Profitability/drink-profitability.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/production-bom-ui.css" asp-append-version="true" />
    <style>
        .pf-status {
            white-space: nowrap !important;
        }
    </style>
}

<main class="pf-page ops-shell cc-warehouse-page" id="profitabilityApp"
      data-can-update-price="@Model.CanUpdateGlobalPrice.ToString().ToLowerInvariant()"
      data-can-manage-policy="@Model.CanManageToppingPolicy.ToString().ToLowerInvariant()">
    @Html.AntiForgeryToken()

    <header class="pf-header ops-header cc-warehouse-header">
        <div>
            <div class="ops-eyebrow">@ProductText["Profit.Eyebrow"]</div>
            <h1 class="ops-title"><i class="fa-solid fa-calculator me-2 text-warning" aria-hidden="true"></i>@ProductText["Profit.Title"]</h1>
            <p class="ops-subtitle">@ProductText["Profit.Description"]</p>
        </div>
        <div class="ops-actions">
            <a class="pf-link-button ops-btn" asp-area="Admin" asp-controller="AdminRecipe" asp-action="Index">
                <i class="fas fa-flask" aria-hidden="true"></i>
                <span>@ProductText["Profit.OpenBom"]</span>
            </a>
        </div>
    </header>

    <div class="pf-section-heading">
        <div>
            <span class="pf-section-icon"><i class="fas fa-sliders"></i></span>
            <div><h2>@ProductText["Profit.Setup"]</h2><p>@ProductText["Profit.SetupHint"]</p></div>
        </div>
        <span class="pf-section-note"><i class="fas fa-shield-halved"></i> @ProductText["Profit.ScopeNote"]</span>
    </div>
    <section class="pf-filter-band" aria-label="@ProductText["Profit.FilterAria"]">
        <label>
            <span>@ProductText["Profit.Store"]</span>
            <select id="storeSelect" class="pf-control">
                @foreach (var store in Model.Stores)
                {
                    <option value="@store.Id">@store.Name</option>
                }
            </select>
        </label>
        <label>
            <span>@ProductText["Profit.Drink"]</span>
            <select id="drinkSelect" class="pf-control">
                @foreach (var drink in Model.Drinks)
                {
                    <option value="@drink.Id">@drink.Name</option>
                }
            </select>
        </label>
        <button type="button" id="refreshPreview" class="pf-primary-button">
            <i class="fas fa-rotate" aria-hidden="true"></i>
            @ProductText["Profit.Reload"]
        </button>
    </section>

    <aside class="pf-global-notice">
        <i class="fas fa-circle-info" aria-hidden="true"></i>
        <strong>@ProductText["Profit.GlobalPrice"]</strong>
        <span>@ProductText["Profit.StoreCostHint"]</span>
    </aside>

    <section class="pf-meta" id="previewMeta" hidden>
        <div><span>@ProductText["Profit.CostSource"]</span><strong>@ProductText["Profit.StoreFifo"]</strong></div>
        <div><span>@ProductText["Profit.CalculatedAt"]</span><strong id="costTimestamp">-</strong></div>
        <div><span>@ProductText["Profit.SizeCount"]</span><strong id="sizeCount">0</strong></div>
        <div><span>@ProductText["Profit.ReadyCount"]</span><strong id="readyCount">0</strong></div>
    </section>

    <section class="pf-result-band" aria-live="polite">
        <div class="pf-result-heading">
            <div><span class="pf-section-icon"><i class="fas fa-table-list"></i></span><div><h2>@ProductText["Profit.Result"]</h2><p>@ProductText["Profit.ResultHint"]</p></div></div>
        </div>
        <div id="loadingState" class="pf-state" hidden>
            <span class="pf-spinner" aria-hidden="true"></span>
            <strong>@ProductText["Profit.Loading"]</strong>
        </div>
        <div id="errorState" class="pf-state pf-state-error" hidden>
            <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
            <div><strong>@ProductText["Profit.LoadError"]</strong><p id="errorMessage"></p></div>
            <button type="button" id="retryPreview" class="pf-secondary-button">@ProductText["Common.Retry"]</button>
        </div>
        <div id="emptyState" class="pf-state" hidden>
            <i class="fas fa-mug-saucer" aria-hidden="true"></i>
            <strong>@ProductText["Profit.Empty"]</strong>
        </div>

        <div class="pf-table-wrap" id="tableWrap" hidden>
            <table class="pf-table">
                <colgroup>
                    <col class="pf-col-size" />
                    <col class="pf-col-status" />
                    <col class="pf-col-cost" />
                    <col class="pf-col-price" />
                    <col class="pf-col-profit" />
                    <col class="pf-col-margin" />
                    <col class="pf-col-markup" />
                    <col class="pf-col-actions" />
                </colgroup>
                <thead>
                    <tr>
                        <th>@ProductText["Profit.Table.SizeBom"]</th>
                        <th>@ProductText["Profit.Table.CostStatus"]</th>
                        <th class="pf-number">@ProductText["Profit.Table.FifoCost"]</th>
                        <th class="pf-number">@ProductText["Profit.Table.GlobalPrice"]</th>
                        <th class="pf-number">@ProductText["Profit.Table.GrossProfit"]</th>
                        <th class="pf-number">@ProductText["Profit.Table.Margin"]</th>
                        <th class="pf-number">@ProductText["Profit.Table.Markup"]</th>
                        <th class="pf-action-header">@ProductText["Common.Actions"]</th>
                    </tr>
                </thead>
                <tbody id="profitabilityRows"></tbody>
            </table>
        </div>
    </section>

    <aside class="offcanvas offcanvas-end pf-drawer" id="priceDrawer" tabindex="-1" aria-labelledby="priceDrawerTitle">
        <div class="pf-drawer-header">
            <div><span class="cc-page-kicker">@ProductText["Profit.Price.Scope"]</span><h2 class="cc-page-title" id="priceDrawerTitle">@ProductText["Profit.Price.Update"]</h2></div>
            <button type="button" class="pf-icon-button" data-bs-dismiss="offcanvas" title="@ProductText["Common.Close"]"><i class="fas fa-xmark"></i></button>
        </div>
        <div class="pf-drawer-body">
            <div class="pf-price-summary">
                <div><span>@ProductText["Profit.Price.FifoCost"]</span><strong id="drawerCost">-</strong></div>
                <div><span>@ProductText["Profit.Price.Current"]</span><strong id="drawerCurrentPrice">-</strong></div>
            </div>
            <section class="pf-form-section">
                <h3>@ProductText["Profit.Price.Suggestion"]</h3>
                <div class="pf-form-grid">
                    <label><span>@ProductText["Profit.Price.Target"]</span><select id="targetMode" class="pf-control"><option value="MARGIN">@ProductText["Profit.Price.TargetMargin"]</option><option value="MARKUP">@ProductText["Profit.Price.TargetMarkup"]</option><option value="PROFIT_AMOUNT">@ProductText["Profit.Price.TargetProfit"]</option></select></label>
                    <label><span>@ProductText["Profit.Price.TargetValue"]</span><input id="targetValue" class="pf-control" type="number" min="0" step="0.01" /></label>
                    <label class="pf-span-2"><span>@ProductText["Profit.Price.Rounding"]</span><select id="roundingMode" class="pf-control"><option value="NONE">@ProductText["Profit.Price.NoRounding"]</option><option value="NEAREST_500">@ProductText["Profit.Price.Nearest500"]</option><option value="CEILING_500">@ProductText["Profit.Price.Ceiling500"]</option><option value="NEAREST_1000">@ProductText["Profit.Price.Nearest1000"]</option><option value="CEILING_1000">@ProductText["Profit.Price.Ceiling1000"]</option></select></label>
                </div>
                <button type="button" id="calculateSuggestion" class="pf-secondary-button">@ProductText["Profit.Price.Calculate"]</button>
                <div id="suggestionResult" class="pf-suggestion" hidden></div>
            </section>
            <section class="pf-form-section">
                <h3>@ProductText["Profit.Price.New"]</h3>
                <label><span>@ProductText["Profit.Price.Label"]</span><input id="newSellingPrice" class="pf-control" type="number" min="1" step="500" /></label>
                <div class="pf-price-summary">
                    <div><span>@ProductText["Profit.Price.ApplyScope"]</span><strong>@ProductText["Profit.Price.SystemWide"]</strong></div>
                    <div><span>@ProductText["Profit.Price.EffectiveAt"]</span><strong>@ProductText["Profit.Price.Immediate"]</strong></div>
                </div>
                <label><span>@ProductText["Profit.Reason"] <strong aria-hidden="true">*</strong></span><textarea id="priceReason" class="pf-control" rows="3" maxlength="500" required></textarea></label>
                <label id="incompleteConfirmation" class="pf-check" hidden><input type="checkbox" id="confirmIncomplete" /><span>@ProductText["Profit.Price.IncompleteConfirm"]</span></label>
                <div id="priceFormError" class="pf-inline-error" hidden></div>
            </section>
        </div>
        <div class="pf-drawer-footer">
            <button type="button" class="pf-secondary-button" data-bs-dismiss="offcanvas">@ProductText["Common.Cancel"]</button>
            <button type="button" id="savePrice" class="pf-primary-button">@ProductText["Profit.Price.Apply"]</button>
        </div>
    </aside>

    <aside class="offcanvas offcanvas-end pf-drawer" id="policyDrawer" tabindex="-1" aria-labelledby="policyDrawerTitle">
        <div class="pf-drawer-header">
            <div><span class="cc-page-kicker">@ProductText["Profit.Policy.Eyebrow"]</span><h2 class="cc-page-title" id="policyDrawerTitle">@ProductText["Profit.Policy.Title"]</h2></div>
            <button type="button" class="pf-icon-button" data-bs-dismiss="offcanvas" title="@ProductText["Common.Close"]"><i class="fas fa-xmark"></i></button>
        </div>
        <div class="pf-drawer-body">
            <div id="policyList" class="pf-policy-list"></div>
            <section class="pf-form-section" id="policyFormSection">
                <h3 id="policyFormTitle">@ProductText["Profit.Policy.Add"]</h3>
                <input type="hidden" id="policyId" />
                <input type="hidden" id="policyRowVersion" />
                <label><span>Topping</span><select id="policyTopping" class="pf-control"></select></label>
                <label><span>@ProductText["Profit.Policy.PriceTreatment"]</span><select id="priceTreatment" class="pf-control"><option value="INCLUDED_IN_BASE_PRICE">@ProductText["Profit.Policy.PriceIncluded"]</option><option value="ADD_TOPPING_PRICE">@ProductText["Profit.Policy.PriceAdd"]</option></select></label>
                <label><span>@ProductText["Profit.Policy.CostTreatment"]</span><select id="costTreatment" class="pf-control"><option value="INCLUDED_IN_DRINK_RECIPE">@ProductText["Profit.Policy.CostIncluded"]</option><option value="ADD_TOPPING_RECIPE_COST">@ProductText["Profit.Policy.CostAdd"]</option></select></label>
                <div class="pf-field-pair">
                    <label><span>@ProductText["Profit.Policy.Quantity"]</span><input id="policyQuantity" class="pf-control" type="number" min="0.00001" step="0.01" value="1" /></label>
                    <label><span>@ProductText["Profit.Policy.Unit"]</span><select id="policyQuantityUnit" class="pf-control"><option value="RECIPE_PORTION">@ProductText["Profit.Policy.RecipePortion"]</option></select></label>
                </div>
                <small>@ProductText["Profit.Policy.QuantityHint"]</small>
                <label class="pf-check"><input type="checkbox" id="policyDefaultSelected" checked /><span>@ProductText["Profit.Policy.Default"]</span></label>
                <label class="pf-check"><input type="checkbox" id="policyRequired" /><span>@ProductText["Profit.Policy.Required"]</span></label>
                <label><span>@ProductText["Profit.Reason"] <strong aria-hidden="true">*</strong></span><textarea id="policyReason" class="pf-control" rows="2" maxlength="500" required></textarea></label>
                <div id="policyFormError" class="pf-inline-error" hidden></div>
                <button type="button" id="savePolicy" class="pf-primary-button">@ProductText["Profit.Policy.Save"]</button>
            </section>
        </div>
    </aside>
</main>

@section Scripts {
    <script id="profitabilityUiCatalog" type="application/json">@Html.Raw(profitabilityJsCatalog)</script>
    <script src="~/js/Admin/Profitability/drink-profitability.js" asp-append-version="true"></script>
}
