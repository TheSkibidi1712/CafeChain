@using CafeChain.Application.Constants
@using CafeChain.ViewModels.Admin.Shared
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ProcurementResource> L
@model CafeChain.Application.DTOs.Admin.Procurement.PurchaseAdvicePageDto
@{
    ViewData["Title"] = L["PurchaseAdvice.Title"];
    var createStoreId = Model.Filter.StoreId.HasValue
        && Model.Stores.Any(x => x.StoreId == Model.Filter.StoreId.Value)
            ? Model.Filter.StoreId
            : Model.Stores.Any(x => x.StoreId == Model.Actor.StoreId)
                ? Model.Actor.StoreId
                : Model.Stores.FirstOrDefault().StoreId;
    var canCreate = ViewBag.CanCreate is true && createStoreId > 0;
}
@section Styles { <link rel="stylesheet" href="~/css/Admin/PurchaseAdvice/purchase-advice.css" asp-append-version="true" /> }

<div class="pa-page pa-advice-index-page cc-warehouse-page">
    <header class="pa-header cc-warehouse-header">
        <div>
            <div class="pa-eyebrow">@L["PurchaseAdvice.Eyebrow"]</div>
            <h1><i class="fa-solid fa-file-invoice-dollar me-2 text-warning" aria-hidden="true"></i>@L["PurchaseAdvice.Heading"]</h1>
            <p class="pa-subtitle">@L["PurchaseAdvice.Subtitle"]</p>
        </div>
        @if (canCreate)
        {
            <a class="pa-action pa-action-primary" asp-action="Create" asp-route-storeId="@createStoreId"><i class="fas fa-plus"></i> @L["PurchaseAdvice.Create"]</a>
        }
    </header>

    @if (TempData["Success"] is string success) { <div class="pa-alert pa-alert-success">@success</div> }
    @if (TempData["Error"] is string error) { <div class="pa-alert">@error</div> }

    <form method="get" class="pa-band pa-filter-grid cc-warehouse-filter">
        <div class="pa-field"><label>@L["Common.Branch"]</label><select name="storeId"><option value="">@L["PurchaseAdvice.AllInScope"]</option>@foreach (var store in Model.Stores) { <option value="@store.StoreId" selected="@(Model.Filter.StoreId == store.StoreId)">@store.StoreName</option> }</select></div>
        <div class="pa-field"><label>@L["Common.Status"]</label><select name="status"><option value="">@L["Common.All"]</option>@foreach (var s in new[] { PurchaseAdviceStatuses.Draft, PurchaseAdviceStatuses.Submitted, PurchaseAdviceStatuses.UnderReview, PurchaseAdviceStatuses.Allocated, PurchaseAdviceStatuses.Rejected, PurchaseAdviceStatuses.Cancelled }) { <option value="@s" selected="@(Model.Filter.Status == s)">@L[$"Status.{s}"]</option> }</select></div>
        <div class="pa-field"><label>@L["Common.Priority"]</label><select name="priority"><option value="">@L["Common.All"]</option>@foreach (var p in new[] { PurchaseAdvicePriorities.Normal, PurchaseAdvicePriorities.High, PurchaseAdvicePriorities.Urgent }) { <option value="@p" selected="@(Model.Filter.Priority == p)">@L[$"Priority.{p}"]</option> }</select></div>
        <div class="pa-field"><label>@L["Common.FromDate"]</label><input type="date" name="fromDate" value="@Model.Filter.FromDate?.ToString("yyyy-MM-dd")" /></div>
        <div class="pa-field"><label>@L["Common.ToDate"]</label><input type="date" name="toDate" value="@Model.Filter.ToDate?.ToString("yyyy-MM-dd")" /></div>
        <div class="pa-field pa-field-button"><label class="pa-field-spacer">&nbsp;</label><button class="pa-action" type="submit"><i class="fas fa-filter"></i> @L["Common.Apply"]</button></div>
    </form>

    <div class="pa-table-wrap cc-warehouse-table-shell">
        <table class="pa-table">
            <thead><tr><th>@L["PurchaseAdvice.Code"]</th><th>@L["PurchaseAdvice.BranchSource"]</th><th>@L["PurchaseAdvice.RequestedBy"]</th><th>@L["PurchaseAdvice.NeededBy"]</th><th>@L["Common.Priority"]</th><th>@L["Common.Status"]</th><th>@L["PurchaseAdvice.LineCount"]</th></tr></thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="7" class="pa-empty" role="status">@L["PurchaseAdvice.Empty"]</td></tr>
            }
            @foreach (var item in Model.Items)
            {
                <tr>
                    @{ var status = AdminStatusDisplay.PurchaseAdvice(item.Status); var priority = AdminStatusDisplay.PurchaseAdvicePriority(item.Priority); }
                    <td><a class="pa-code" asp-action="Details" asp-route-id="@item.PurchaseAdviceId">@item.AdviceNumber</a><div class="pa-muted">@AdminStatusDisplay.DateTime(item.CreatedAtUtc.ToLocalTime())</div></td>
                    <td><strong>@item.StoreName</strong><div class="pa-muted">@L["PurchaseAdvice.SourceRequest", item.SourceRestockSummary]</div></td>
                    <td>@item.RequestedByName</td><td>@AdminStatusDisplay.Date(item.NeededByDate)</td><td><span class="@priority.CssClass">@L[$"Priority.{item.Priority}"]</span></td>
                    <td><span class="pa-badge @status.CssClass">@L[$"Status.{item.Status}"]</span></td><td>@item.LineCount</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
