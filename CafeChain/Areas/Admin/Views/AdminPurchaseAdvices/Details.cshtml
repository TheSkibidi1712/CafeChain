@using CafeChain.Application.Constants
@using CafeChain.ViewModels.Admin.Shared
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ProcurementResource> L
@model CafeChain.Application.DTOs.Admin.Procurement.PurchaseAdviceDetailDto
@{
    ViewData["Title"] = Model.AdviceNumber;
}
@section Styles { <link rel="stylesheet" href="~/css/Admin/PurchaseAdvice/purchase-advice.css" asp-append-version="true" /> }
<div class="pa-page pa-advice-detail-page cc-warehouse-page">
    <header class="pa-header cc-warehouse-header cc-warehouse-header--compact cc-warehouse-header--detail"><div><div class="pa-eyebrow">@L["PurchaseAdvice.Details.Eyebrow"]</div><h1>@Model.AdviceNumber</h1><p class="pa-subtitle">@L["PurchaseAdvice.Details.CreatedBy", Model.StoreName, Model.RequestedByName]</p></div><div class="pa-actions"><a class="pa-action" asp-action="Index"><i class="fas fa-arrow-left"></i> @L["Common.List"]</a>@if (Model.CanEdit) { <a class="pa-action pa-action-primary" asp-action="Edit" asp-route-id="@Model.PurchaseAdviceId"><i class="fas fa-pen"></i> @L["PurchaseAdvice.Details.Edit"]</a> }</div></header>
    @if (TempData["Success"] is string success) { <div class="pa-alert pa-alert-success">@success</div> }
    @if (TempData["Error"] is string error) { <div class="pa-alert">@error</div> }
    @{ var adviceStatus = AdminStatusDisplay.PurchaseAdvice(Model.Status); var advicePriority = AdminStatusDisplay.PurchaseAdvicePriority(Model.Priority); }
    <section class="pa-band"><div class="pa-summary-grid"><div class="pa-kpi"><span>@L["Common.Status"]</span><strong><span class="pa-badge @adviceStatus.CssClass">@adviceStatus.Label</span></strong></div><div class="pa-kpi"><span>@L["Common.Priority"]</span><strong class="@advicePriority.CssClass">@advicePriority.Label</strong></div><div class="pa-kpi"><span>@L["PurchaseAdvice.Details.NeedBy"]</span><strong>@AdminStatusDisplay.Date(Model.NeededByDate)</strong></div><div class="pa-kpi"><span>@L["PurchaseAdvice.LineCount"]</span><strong>@Model.Lines.Count</strong></div></div>@if (!string.IsNullOrWhiteSpace(Model.Note)) { <p class="pa-note"><strong>@L["Common.Notes"]:</strong> @Model.Note</p> }@if (!string.IsNullOrWhiteSpace(Model.RejectionReason)) { <div class="pa-alert pa-alert-compact"><strong>@L["PurchaseAdvice.Details.RejectionReason"]</strong> @Model.RejectionReason</div> }</section>
    <section class="pa-table-wrap cc-warehouse-table-shell"><table class="pa-table"><thead><tr><th>@L["PurchaseAdvice.Details.ColSource"]</th><th>@L["PurchaseAdvice.Details.ColAlloc"]</th><th>@L["PurchaseAdvice.Details.ColQty"]</th><th>@L["PurchaseAdvice.Details.NeedBy"]</th></tr></thead><tbody>
    @foreach (var line in Model.Lines)
    {
        var usesProcurement = line.RequestedProcurementQuantity.HasValue;
        var unitName = AdminStatusDisplay.Unit(usesProcurement ? line.ProcurementUnitName : line.BaseUnitName);
        <tr><td><strong>@line.IngredientName</strong><div class="pa-muted">@AdminStatusDisplay.RestockReference(line.RestockReferenceCode, line.RestockRequestId) · @unitName</div></td><td><div class="pa-quantity-grid"><div><span>@L["PurchaseAdvice.Details.RestockQty"]</span><strong>@AdminStatusDisplay.Quantity(usesProcurement ? line.RestockRequestedProcurementQuantity.GetValueOrDefault() : line.RestockRequestedQuantity) @unitName</strong></div><div><span>@L["PurchaseAdvice.Details.Transfer"]</span><strong>@AdminStatusDisplay.Quantity(usesProcurement ? line.TransferAllocatedProcurementQuantity.GetValueOrDefault() : line.TransferAllocatedQuantity) @unitName</strong></div><div><span>@L["PurchaseAdvice.Details.OtherAdvice"]</span><strong>@AdminStatusDisplay.Quantity(usesProcurement ? line.ExistingPurchaseAdviceProcurementQuantity.GetValueOrDefault() : line.ExistingPurchaseAdviceQuantity) @unitName</strong></div><div><span>@L["PurchaseAdvice.Details.Ordered"]</span><strong>@AdminStatusDisplay.Quantity(usesProcurement ? line.ExistingPurchaseOrderProcurementQuantity.GetValueOrDefault() : line.ExistingPurchaseOrderQuantity) @unitName</strong></div><div><span>@L["PurchaseAdvice.Details.Closed"]</span><strong>@AdminStatusDisplay.Quantity(usesProcurement ? line.ExplicitlyClosedProcurementQuantity.GetValueOrDefault() : line.ExplicitlyClosedQuantity) @unitName</strong></div></div></td><td><strong>@AdminStatusDisplay.Quantity(usesProcurement ? line.RequestedProcurementQuantity!.Value : line.RequestedPurchaseBaseQuantity) @unitName</strong>@if (!string.IsNullOrWhiteSpace(line.Note)) { <div class="pa-muted">@line.Note</div> }</td><td>@AdminStatusDisplay.Date(line.NeededByDate)</td></tr>
    }
    </tbody></table></section>
    <section class="pa-band pa-section-spaced">
        <h2 class="pa-section-title">@L["PurchaseAdvice.Details.SupplierTitle"]</h2>
        <p class="pa-muted">@L["PurchaseAdvice.Details.SupplierHelp"]</p>
        @if (Model.Status is PurchaseAdviceStatuses.Submitted or PurchaseAdviceStatuses.UnderReview)
        {
            <a class="pa-action pa-action-primary" asp-area="Admin" asp-controller="AdminPurchaseAdviceConsolidation" asp-action="Index" asp-route-storeId="@Model.StoreId"><i class="fas fa-layer-group"></i> @L["PurchaseAdvice.Details.Consolidate"]</a>
        }
        else if (Model.Status == PurchaseAdviceStatuses.Draft)
        {
            <span class="pa-muted">@L["PurchaseAdvice.Details.SubmitFirst"]</span>
        }
    </section>
    <section class="pa-band pa-section-spaced"><h2 class="pa-section-title">@L["Common.Actions"]</h2><div class="pa-actions">
        @if (Model.CanSubmit) { <form asp-action="Submit" asp-route-id="@Model.PurchaseAdviceId" method="post">@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@Model.RowVersion" /><button class="pa-action pa-action-primary" type="submit"><i class="fas fa-paper-plane"></i> @L["PurchaseAdvice.Details.Submit"]</button></form> }
        @if (Model.CanReview) { <form asp-action="StartReview" asp-route-id="@Model.PurchaseAdviceId" method="post">@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@Model.RowVersion" /><button class="pa-action pa-action-primary" type="submit"><i class="fas fa-search"></i> @L["PurchaseAdvice.Details.StartReview"]</button></form> }
        @if (Model.CanReject) { <form asp-action="Reject" asp-route-id="@Model.PurchaseAdviceId" method="post" class="pa-actions">@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@Model.RowVersion" /><div class="pa-field"><label>@L["PurchaseAdvice.Details.RejectionReason"]</label><input name="Reason" maxlength="500" required /></div><button class="pa-action pa-action-danger" type="submit"><i class="fas fa-times"></i> @L["PurchaseAdvice.Details.Reject"]</button></form> }
        @if (Model.CanCancel) { <form asp-action="Cancel" asp-route-id="@Model.PurchaseAdviceId" method="post">@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@Model.RowVersion" /><button class="pa-action pa-action-danger" type="submit"><i class="fas fa-ban"></i> @L["PurchaseAdvice.Details.CancelAdvice"]</button></form> }
        @if (!Model.CanSubmit && !Model.CanReview && !Model.CanReject && !Model.CanCancel) { <span class="pa-muted">@L["PurchaseAdvice.Details.NoActions"]</span> }
    </div></section>
    <section class="pa-band"><h2 class="pa-section-title">@L["PurchaseAdvice.Details.History"]</h2><div class="pa-timeline">@foreach (var transition in Model.Transitions) { <div class="pa-timeline-item"><strong>@AdminStatusDisplay.PurchaseAdvice(transition.NewStatus).Label</strong><div class="pa-muted">@transition.ActorName · @AdminStatusDisplay.DateTime(transition.OccurredAtUtc.ToLocalTime())</div>@if (!string.IsNullOrWhiteSpace(transition.Reason)) { <div>@transition.Reason</div> }</div> }</div></section>
</div>
