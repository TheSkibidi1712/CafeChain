@using CafeChain.Application.Constants
@using CafeChain.ViewModels.Admin.Shared
@model CafeChain.Application.DTOs.Admin.Procurement.PurchaseAdviceDetailDto
@{
    ViewData["Title"] = Model.AdviceNumber;
}
@section Styles { <link rel="stylesheet" href="~/css/Admin/PurchaseAdvice/purchase-advice.css" asp-append-version="true" /> }
<div class="pa-page pa-advice-detail-page cc-warehouse-page">
    <header class="pa-header cc-warehouse-header cc-warehouse-header--compact cc-warehouse-header--detail"><div><div class="pa-eyebrow">Đề nghị mua hàng</div><h1>@Model.AdviceNumber</h1><p class="pa-subtitle">@Model.StoreName · tạo bởi @Model.RequestedByName</p></div><div class="pa-actions"><a class="pa-action" asp-action="Index"><i class="fas fa-arrow-left"></i> Danh sách</a>@if (Model.CanEdit) { <a class="pa-action" asp-action="Edit" asp-route-id="@Model.PurchaseAdviceId"><i class="fas fa-pen"></i> Sửa</a> }</div></header>
    @if (TempData["Success"] is string success) { <div class="pa-alert pa-alert-success">@success</div> }
    @if (TempData["Error"] is string error) { <div class="pa-alert">@error</div> }
    @{ var adviceStatus = AdminStatusDisplay.PurchaseAdvice(Model.Status); var advicePriority = AdminStatusDisplay.PurchaseAdvicePriority(Model.Priority); }
    <section class="pa-band"><div class="pa-summary-grid"><div class="pa-kpi"><span>Trạng thái</span><strong><span class="pa-badge @adviceStatus.CssClass">@adviceStatus.Label</span></strong></div><div class="pa-kpi"><span>Ưu tiên</span><strong class="@advicePriority.CssClass">@advicePriority.Label</strong></div><div class="pa-kpi"><span>Ngày cần hàng</span><strong>@AdminStatusDisplay.Date(Model.NeededByDate)</strong></div><div class="pa-kpi"><span>Số dòng đề nghị</span><strong>@Model.Lines.Count</strong></div></div>@if (!string.IsNullOrWhiteSpace(Model.Note)) { <p class="pa-note"><strong>Ghi chú:</strong> @Model.Note</p> }@if (!string.IsNullOrWhiteSpace(Model.RejectionReason)) { <div class="pa-alert pa-alert-compact"><strong>Lý do từ chối:</strong> @Model.RejectionReason</div> }</section>
    <section class="pa-table-wrap cc-warehouse-table-shell"><table class="pa-table"><thead><tr><th>Nguồn yêu cầu / nguyên liệu</th><th>Phân bổ số lượng</th><th>Số lượng đề nghị</th><th>Ngày cần hàng</th></tr></thead><tbody>
    @foreach (var line in Model.Lines)
    {
        var usesProcurement = line.RequestedProcurementQuantity.HasValue;
        var unitName = AdminStatusDisplay.Unit(usesProcurement ? line.ProcurementUnitName : line.BaseUnitName);
        <tr><td><strong>@line.IngredientName</strong><div class="pa-muted">@AdminStatusDisplay.RestockReference(line.RestockReferenceCode, line.RestockRequestId) · @unitName</div></td><td><div class="pa-quantity-grid"><div><span>Yêu cầu nhập</span><strong>@AdminStatusDisplay.Quantity(usesProcurement ? line.RestockRequestedProcurementQuantity.GetValueOrDefault() : line.RestockRequestedQuantity) @unitName</strong></div><div><span>Điều chuyển</span><strong>@AdminStatusDisplay.Quantity(usesProcurement ? line.TransferAllocatedProcurementQuantity.GetValueOrDefault() : line.TransferAllocatedQuantity) @unitName</strong></div><div><span>Đề nghị khác</span><strong>@AdminStatusDisplay.Quantity(usesProcurement ? line.ExistingPurchaseAdviceProcurementQuantity.GetValueOrDefault() : line.ExistingPurchaseAdviceQuantity) @unitName</strong></div><div><span>Đã đặt hàng</span><strong>@AdminStatusDisplay.Quantity(usesProcurement ? line.ExistingPurchaseOrderProcurementQuantity.GetValueOrDefault() : line.ExistingPurchaseOrderQuantity) @unitName</strong></div><div><span>Phần đã đóng</span><strong>@AdminStatusDisplay.Quantity(usesProcurement ? line.ExplicitlyClosedProcurementQuantity.GetValueOrDefault() : line.ExplicitlyClosedQuantity) @unitName</strong></div></div></td><td><strong>@AdminStatusDisplay.Quantity(usesProcurement ? line.RequestedProcurementQuantity!.Value : line.RequestedPurchaseBaseQuantity) @unitName</strong>@if (!string.IsNullOrWhiteSpace(line.Note)) { <div class="pa-muted">@line.Note</div> }</td><td>@AdminStatusDisplay.Date(line.NeededByDate)</td></tr>
    }
    </tbody></table></section>
    <section class="pa-band pa-section-spaced">
        <h2 class="pa-section-title">Nhà cung cấp và hình thức mua</h2>
        <p class="pa-muted">Nhà cung cấp, mã SKU của nhà cung cấp và phương thức mua theo quy cách hoặc mua lẻ được chọn tại bước tổng hợp đề nghị mua. Bản nháp chưa khóa nhà cung cấp.</p>
        @if (Model.Status is PurchaseAdviceStatuses.Submitted or PurchaseAdviceStatuses.UnderReview)
        {
            <a class="pa-action pa-action-primary" asp-area="Admin" asp-controller="AdminPurchaseAdviceConsolidation" asp-action="Index" asp-route-storeId="@Model.StoreId"><i class="fas fa-layer-group"></i> Chọn nhà cung cấp và tổng hợp</a>
        }
        else if (Model.Status == PurchaseAdviceStatuses.Draft)
        {
            <span class="pa-muted">Gửi đề nghị mua để chuyển sang bước chọn nhà cung cấp.</span>
        }
    </section>
    <section class="pa-band pa-section-spaced"><h2 class="pa-section-title">Thao tác</h2><div class="pa-actions">
        @if (Model.CanSubmit) { <form asp-action="Submit" asp-route-id="@Model.PurchaseAdviceId" method="post">@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@Model.RowVersion" /><button class="pa-action pa-action-primary" type="submit"><i class="fas fa-paper-plane"></i> Chuyển sang xem xét</button></form> }
        @if (Model.CanReview) { <form asp-action="StartReview" asp-route-id="@Model.PurchaseAdviceId" method="post">@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@Model.RowVersion" /><button class="pa-action pa-action-primary" type="submit"><i class="fas fa-search"></i> Bắt đầu xem xét</button></form> }
        @if (Model.CanReject) { <form asp-action="Reject" asp-route-id="@Model.PurchaseAdviceId" method="post" class="pa-actions">@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@Model.RowVersion" /><div class="pa-field"><label>Lý do từ chối</label><input name="Reason" maxlength="500" required /></div><button class="pa-action pa-action-danger" type="submit"><i class="fas fa-times"></i> Từ chối</button></form> }
        @if (Model.CanCancel) { <form asp-action="Cancel" asp-route-id="@Model.PurchaseAdviceId" method="post">@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@Model.RowVersion" /><button class="pa-action pa-action-danger" type="submit"><i class="fas fa-ban"></i> Hủy đề nghị</button></form> }
        @if (!Model.CanSubmit && !Model.CanReview && !Model.CanReject && !Model.CanCancel) { <span class="pa-muted">Không có thao tác phù hợp với quyền và trạng thái hiện tại.</span> }
    </div></section>
    <section class="pa-band"><h2 class="pa-section-title">Lịch sử trạng thái</h2><div class="pa-timeline">@foreach (var transition in Model.Transitions) { <div class="pa-timeline-item"><strong>@AdminStatusDisplay.PurchaseAdvice(transition.NewStatus).Label</strong><div class="pa-muted">@transition.ActorName · @AdminStatusDisplay.DateTime(transition.OccurredAtUtc.ToLocalTime())</div>@if (!string.IsNullOrWhiteSpace(transition.Reason)) { <div>@transition.Reason</div> }</div> }</div></section>
</div>
