@using CafeChain.Application.Constants
@using CafeChain.Application.DTOs.Admin.Procurement
@using CafeChain.ViewModels.Admin.Shared
@using Microsoft.Extensions.Localization
@using System.Text.Json
@inject IStringLocalizer<ProcurementResource> L
@model CreatePurchaseAdviceRequest
@{
    ViewData["Title"] = L["PurchaseAdvice.Create.Title"];
    var sources = (IReadOnlyList<PurchaseAdviceSourceDto>)(ViewBag.Sources ?? Array.Empty<PurchaseAdviceSourceDto>());
    var selected = ViewBag.SelectedRestockIds as int[] ?? Array.Empty<int>();
    var preselected = ViewBag.SelectedRestockRequestId as int?;
    var selectedIds = selected.ToHashSet();
    if (preselected.HasValue)
    {
        selectedIds.Add(preselected.Value);
    }

    decimal EligibleQuantity(PurchaseAdviceSourceDto source)
    {
        var usesProcurement = source.RestockRequestedProcurementQuantity.HasValue
            && source.RemainingToPurchaseProcurementQuantity.HasValue;
        var remaining = usesProcurement
            ? source.RemainingToPurchaseProcurementQuantity!.Value
            : source.RemainingToPurchaseQuantity;
        var pendingPurchase = usesProcurement
            ? source.PendingPurchaseAllocationProcurementQuantity.GetValueOrDefault()
            : source.PendingPurchaseAllocationBaseQuantity;
        var isLegacy = string.Equals(
            source.SourceType,
            RestockRequestSourceTypes.Legacy,
            StringComparison.OrdinalIgnoreCase);
        return isLegacy ? remaining : Math.Min(remaining, pendingPurchase);
    }

    var hasInitialValidSelection = sources.Any(source =>
        selectedIds.Contains(source.RestockRequestId)
        && EligibleQuantity(source) > 0);
}
@section Styles { <link rel="stylesheet" href="~/css/Admin/PurchaseAdvice/purchase-advice.css" asp-append-version="true" /> }

<main class="pa-page pa-create-page pa-advice-form-page cc-warehouse-page">
    <header class="pa-header cc-warehouse-header cc-warehouse-header--compact">
        <div>
            <div class="pa-eyebrow">@L["PurchaseAdvice.Create.Eyebrow"]</div>
            <h1>@L["PurchaseAdvice.Create.Heading"]</h1>
            <p class="pa-subtitle">@L["PurchaseAdvice.Create.Subtitle"]</p>
        </div>
        <a class="pa-action" asp-action="Index"><i class="fas fa-arrow-left" aria-hidden="true"></i> @L["PurchaseAdvice.Create.BackList"]</a>
    </header>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="pa-alert cc-warehouse-alert cc-warehouse-alert-danger" role="alert"></div>
    }

    <form id="purchaseAdviceForm" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="StoreId" />
        <input type="hidden" asp-for="RequestKey" />

        <section class="pa-band" aria-labelledby="adviceInfoTitle">
            <div class="pa-section-heading">
                <div><h2 id="adviceInfoTitle">@L["PurchaseAdvice.Create.InfoTitle"]</h2><span class="pa-muted">@L["PurchaseAdvice.Create.InfoHelp"]</span></div>
            </div>
            <div class="pa-create-info-grid">
                <div class="pa-field"><label asp-for="NeededByDate">@L["PurchaseAdvice.NeededBy"]</label><input asp-for="NeededByDate" type="date" lang="vi" required /><span class="pa-muted">@L["PurchaseAdvice.Create.DateHelp"]</span></div>
                <div class="pa-field"><label asp-for="Priority">@L["Common.Priority"]</label><select asp-for="Priority"><option value="NORMAL">@L["Priority.NORMAL"]</option><option value="HIGH">@L["Priority.HIGH"]</option><option value="URGENT">@L["Priority.URGENT"]</option></select></div>
                <div class="pa-field pa-create-note"><label asp-for="Note">@L["Common.Notes"]</label><input asp-for="Note" maxlength="1000" placeholder="@L["PurchaseAdvice.Create.NotePlaceholder"]" /></div>
            </div>
        </section>

        @if (sources.Count == 0)
        {
            <section class="pa-band pa-create-empty cc-warehouse-empty" aria-label="@L["PurchaseAdvice.Create.EmptyAria"]" role="status">
                <i class="fas fa-clipboard-check" aria-hidden="true"></i>
                <h2>@L["PurchaseAdvice.Create.EmptyTitle"]</h2>
                <p>@L["PurchaseAdvice.Create.EmptyCopy"]</p>
                <div class="pa-actions">
                    <a class="pa-action pa-action-primary" asp-area="Admin" asp-controller="AdminRestockRequests" asp-action="Index" asp-route-storeId="@Model.StoreId">@L["PurchaseAdvice.Create.ViewRestock"]</a>
                    <a class="pa-action" asp-action="Create" asp-route-storeId="@Model.StoreId"><i class="fas fa-rotate" aria-hidden="true"></i> @L["PurchaseAdvice.Create.Refresh"]</a>
                </div>
            </section>
        }
        else
        {
            <section class="pa-table-wrap cc-warehouse-table-shell" aria-label="@L["PurchaseAdvice.Create.TableAria"]">
                <table class="pa-table pa-create-source-table">
                    <thead>
                        <tr>
                            <th>@L["PurchaseAdvice.Create.ColSelect"]</th><th>@L["PurchaseAdvice.Create.ColRequest"]</th><th>@L["Common.Ingredient"]</th><th class="pa-number">@L["PurchaseAdvice.Create.ColPurchaseNeed"]</th><th class="pa-number">@L["PurchaseAdvice.Create.ColInAdvice"]</th><th class="pa-number">@L["PurchaseAdvice.Create.ColNotInAdvice"]</th><th>@L["PurchaseAdvice.Create.ColNeedBy"]</th><th>@L["Common.Priority"]</th><th>@L["PurchaseAdvice.Create.ColSourcing"]</th><th class="pa-number">@L["PurchaseAdvice.Create.ColQty"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @for (var i = 0; i < sources.Count; i++)
                    {
                        var source = sources[i];
                        var isSelected = selectedIds.Contains(source.RestockRequestId);
                        var usesProcurement = source.RestockRequestedProcurementQuantity.HasValue
                            && source.RemainingToPurchaseProcurementQuantity.HasValue;
                        var requested = usesProcurement ? source.RestockRequestedProcurementQuantity!.Value : source.RestockRequestedQuantity;
                        var remaining = usesProcurement ? source.RemainingToPurchaseProcurementQuantity!.Value : source.RemainingToPurchaseQuantity;
                        var pendingPurchase = usesProcurement
                            ? source.PendingPurchaseAllocationProcurementQuantity.GetValueOrDefault()
                            : source.PendingPurchaseAllocationBaseQuantity;
                        var proposed = usesProcurement
                            ? source.ExistingPurchaseAdviceProcurementQuantity.GetValueOrDefault()
                            : source.ExistingPurchaseAdviceQuantity;
                        var eligible = EligibleQuantity(source);
                        var unitName = AdminStatusDisplay.Unit(usesProcurement ? source.ProcurementUnitName : source.BaseUnitName);
                        var sourcingLabel = source.SourcingStatus switch { "FULLY_ALLOCATED" => L["PurchaseAdvice.Create.Sourcing.Full"].Value, "PARTIALLY_ALLOCATED" => L["PurchaseAdvice.Create.Sourcing.Partial"].Value, _ => L["PurchaseAdvice.Create.Sourcing.None"].Value };
                        var modelLine = Model.Lines.FirstOrDefault(x => x.RestockRequestId == source.RestockRequestId);
                        var modelQuantity = usesProcurement
                            ? modelLine?.RequestedPurchaseProcurementQuantity.GetValueOrDefault() ?? 0m
                            : modelLine?.RequestedPurchaseBaseQuantity ?? 0m;
                        var initialQuantity = isSelected && modelQuantity > 0 ? Math.Min(modelQuantity, eligible) : isSelected ? eligible : 0m;
                        <tr data-source-row>
                            <td><input class="pa-check" type="checkbox" name="selectedRestockIds" value="@source.RestockRequestId" checked="@isSelected" @(eligible <= 0 ? "disabled" : null) aria-label="@L["PurchaseAdvice.Create.SelectAria", AdminStatusDisplay.RestockReference(source.RestockReferenceCode, source.RestockRequestId)]" /></td>
                            <td><a class="pa-code" asp-area="Admin" asp-controller="AdminRestockRequests" asp-action="Details" asp-route-id="@source.RestockRequestId">@AdminStatusDisplay.RestockReference(source.RestockReferenceCode, source.RestockRequestId)</a><div class="pa-muted">@source.StoreName</div><input type="hidden" name="Lines[@i].RestockRequestId" value="@source.RestockRequestId" /><input type="hidden" name="Lines[@i].RestockRowVersion" value="@source.RestockRowVersion" /></td>
                            <td><strong>@source.IngredientName</strong><div class="pa-muted">@unitName</div></td>
                            <td class="pa-number">@AdminStatusDisplay.Quantity(requested) @unitName</td>
                            <td class="pa-number">@AdminStatusDisplay.Quantity(proposed) @unitName</td>
                            <td class="pa-number"><strong>@AdminStatusDisplay.Quantity(eligible) @unitName</strong></td>
                            <td>@(source.NeedByDate?.ToLocalTime().ToString("dd/MM/yyyy") ?? L["PurchaseAdvice.Create.NeedUnset"].Value)<input type="hidden" name="Lines[@i].NeededByDate" value="@(source.NeedByDate?.ToString("yyyy-MM-dd") ?? Model.NeededByDate.ToString("yyyy-MM-dd"))" /></td>
                            <td><span class="pa-badge pa-priority-@source.Priority.ToLowerInvariant()">@AdminStatusDisplay.RestockRequestPriority(source.Priority).Label</span></td>
                            <td><span class="pa-badge">@sourcingLabel</span></td>
                            <td class="pa-field pa-quantity-cell">
                                @if (usesProcurement)
                                {
                                    <input type="hidden" name="Lines[@i].RequestedPurchaseBaseQuantity" value="0" />
                                    <input name="Lines[@i].RequestedPurchaseProcurementQuantity" type="number" min="0.001" max="@eligible.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.001" value="@initialQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-quantity data-max-quantity="@eligible.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                }
                                else
                                {
                                    <input name="Lines[@i].RequestedPurchaseBaseQuantity" type="number" min="0.001" max="@eligible.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.001" value="@initialQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-quantity data-max-quantity="@eligible.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                }
                                <input type="hidden" name="Lines[@i].Note" value="" />
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </section>
        }

        <div class="pa-actions pa-create-actions">
            <span id="purchaseAdviceSubmitStatus" class="pa-muted pa-submit-status" role="status" aria-live="polite"></span>
            <button id="savePurchaseAdvice" class="pa-action pa-action-primary" type="submit" disabled="@(!hasInitialValidSelection)"><i class="fas fa-save" aria-hidden="true"></i> @L["PurchaseAdvice.Create.SaveDraft"]</button>
            <a class="pa-action" asp-action="Index">@L["Common.Cancel"]</a>
        </div>
    </form>
</main>

<script>
(() => {
    const form = document.getElementById('purchaseAdviceForm');
    const save = document.getElementById('savePurchaseAdvice');
    const status = document.getElementById('purchaseAdviceSubmitStatus');
    const rows = [...document.querySelectorAll('[data-source-row]')];
    const originalButtonContent = save.innerHTML;
    const i18n = {
        invalid: @Html.Raw(JsonSerializer.Serialize(L["PurchaseAdvice.Create.JsInvalid"].Value)),
        saving: @Html.Raw(JsonSerializer.Serialize(L["PurchaseAdvice.Create.JsSaving"].Value)),
        sending: @Html.Raw(JsonSerializer.Serialize(L["PurchaseAdvice.Create.JsSending"].Value)),
        timeout: @Html.Raw(JsonSerializer.Serialize(L["PurchaseAdvice.Create.JsTimeout"].Value))
    };
    let submitting = false;
    let submitWatchdog = null;

    const rowIsValid = row => {
        const check = row.querySelector('.pa-check');
        const qty = row.querySelector('[data-quantity]');
        if (!check || !qty || !check.checked || qty.disabled) return false;
        const value = qty.valueAsNumber;
        const max = Number(qty.dataset.maxQuantity);
        return Number.isFinite(value) && Number.isFinite(max) && value > 0 && value <= max;
    };

    const syncSave = () => {
        if (submitting) return;
        save.disabled = !rows.some(rowIsValid);
    };
    rows.forEach(row => {
        const check = row.querySelector('.pa-check');
        const qty = row.querySelector('[data-quantity]');
        if (!check || !qty) return;
        const syncRow = () => {
            row.classList.toggle('pa-source-disabled', !check.checked);
            qty.disabled = !check.checked;
            syncSave();
        };
        check.addEventListener('change', syncRow);
        qty.addEventListener('input', syncSave);
        syncRow();
    });
    form.addEventListener('submit', event => {
        if (submitting || !rows.some(rowIsValid)) {
            event.preventDefault();
            status.textContent = i18n.invalid;
            syncSave();
            return;
        }

        submitting = true;
        save.setAttribute('aria-disabled', 'true');
        save.setAttribute('aria-busy', 'true');
        save.style.pointerEvents = 'none';
        save.innerHTML = '<i class="fas fa-spinner fa-spin" aria-hidden="true"></i> ' + i18n.saving;
        status.textContent = i18n.sending;

        submitWatchdog = window.setTimeout(() => {
            submitting = false;
            save.removeAttribute('aria-disabled');
            save.removeAttribute('aria-busy');
            save.style.pointerEvents = '';
            save.innerHTML = originalButtonContent;
            status.textContent = i18n.timeout;
            syncSave();
        }, 15000);
    });

    window.addEventListener('pageshow', () => {
        if (submitWatchdog) window.clearTimeout(submitWatchdog);
        submitting = false;
        save.removeAttribute('aria-disabled');
        save.removeAttribute('aria-busy');
        save.style.pointerEvents = '';
        save.innerHTML = originalButtonContent;
        syncSave();
    });
    syncSave();
})();
</script>
