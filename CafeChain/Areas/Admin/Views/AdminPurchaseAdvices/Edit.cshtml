@using CafeChain.Application.DTOs.Admin.Procurement
@using CafeChain.ViewModels.Admin.Shared
@model UpdatePurchaseAdviceRequest
@{
    ViewData["Title"] = "Sửa đề nghị mua";
    var detail = (PurchaseAdviceDetailDto)ViewBag.Detail;
}
@section Styles { <link rel="stylesheet" href="~/css/Admin/PurchaseAdvice/purchase-advice.css" asp-append-version="true" /> }
<div class="pa-page cc-warehouse-page">
    <header class="pa-header cc-warehouse-header"><div><div class="pa-eyebrow">@detail.AdviceNumber</div><h1>Sửa đề nghị mua hàng nháp</h1><p class="pa-subtitle">Nguồn yêu cầu nhập được giữ nguyên; hệ thống kiểm tra lại số lượng còn có thể mua khi lưu.</p></div><a class="pa-action" asp-action="Details" asp-route-id="@Model.PurchaseAdviceId"><i class="fas fa-arrow-left"></i> Quay lại</a></header>
    <div asp-validation-summary="All" class="pa-alert cc-warehouse-alert cc-warehouse-alert-danger" role="alert"></div>
    <form method="post">
        @Html.AntiForgeryToken()<input type="hidden" asp-for="PurchaseAdviceId" /><input type="hidden" asp-for="RowVersion" />
    <section class="pa-band"><div class="pa-filter-grid pa-filter-grid-three"><div class="pa-field"><label>Ngày cần hàng</label><input asp-for="NeededByDate" type="date" lang="vi" required /><span class="pa-muted">Ngày/tháng/năm</span></div><div class="pa-field"><label>Ưu tiên</label><select asp-for="Priority"><option value="NORMAL">Bình thường</option><option value="HIGH">Cao</option><option value="URGENT">Khẩn cấp</option></select></div><div class="pa-field"><label>Ghi chú</label><input asp-for="Note" maxlength="1000" /></div></div></section>
        <div class="pa-table-wrap cc-warehouse-table-shell"><table class="pa-table"><thead><tr><th>Nguồn</th><th>Phân bổ</th><th>Còn khả dụng khi sửa</th><th>Số lượng</th><th>Ngày cần / ghi chú</th></tr></thead><tbody>
        @for (var i = 0; i < Model.Lines.Count; i++)
        {
            var source = detail.Lines.Single(x => x.PurchaseAdviceLineId == Model.Lines[i].PurchaseAdviceLineId);
            var usesProcurement = source.RequestedProcurementQuantity.HasValue
                && source.RemainingToPurchaseProcurementQuantity.HasValue;
            var available = usesProcurement
                ? source.RemainingToPurchaseProcurementQuantity!.Value
                : source.RemainingToPurchaseQuantity;
            var unitName = usesProcurement ? source.ProcurementUnitName : source.BaseUnitName;
            <tr><td><strong>@source.IngredientName</strong><div class="pa-muted">Yêu cầu nhập hàng #@source.RestockRequestId</div><input type="hidden" asp-for="Lines[i].PurchaseAdviceLineId" /><input type="hidden" asp-for="Lines[i].RowVersion" /></td><td><div class="pa-muted">Điều chuyển @AdminStatusDisplay.Quantity(usesProcurement ? source.TransferAllocatedProcurementQuantity.GetValueOrDefault() : source.TransferAllocatedQuantity) @unitName · Đề nghị khác @AdminStatusDisplay.Quantity(usesProcurement ? source.ExistingPurchaseAdviceProcurementQuantity.GetValueOrDefault() : source.ExistingPurchaseAdviceQuantity) @unitName · Đã đặt hàng @AdminStatusDisplay.Quantity(usesProcurement ? source.ExistingPurchaseOrderProcurementQuantity.GetValueOrDefault() : source.ExistingPurchaseOrderQuantity) @unitName</div></td><td><strong>@AdminStatusDisplay.Quantity(available) @unitName</strong></td><td class="pa-field">
                @if (usesProcurement)
                {
                    <input type="hidden" asp-for="Lines[i].RequestedPurchaseBaseQuantity" />
                    <input asp-for="Lines[i].RequestedPurchaseProcurementQuantity" type="number" min="0.001" max="@available" step="0.001" />
                }
                else
                {
                    <input asp-for="Lines[i].RequestedPurchaseBaseQuantity" type="number" min="0.001" max="@available" step="0.001" />
                }
                </td><td><div class="pa-field"><input asp-for="Lines[i].NeededByDate" type="date" lang="vi" /><span class="pa-muted">Ngày/tháng/năm</span></div><div class="pa-field pa-field-spaced"><input asp-for="Lines[i].Note" maxlength="500" /></div></td></tr>
        }
        </tbody></table></div>
    <div class="pa-actions pa-actions-spaced"><button class="pa-action pa-action-primary" type="submit"><i class="fas fa-save"></i> Lưu thay đổi</button><a class="pa-action" asp-action="Details" asp-route-id="@Model.PurchaseAdviceId">Hủy</a></div>
    </form>
</div>
