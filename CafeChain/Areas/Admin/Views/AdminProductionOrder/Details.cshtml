@model CafeChain.Application.DTOs.Admin.Production.ProductionRunDetailDto
@{
    ViewData["Title"] = $"Lệnh PR-{Model.ProductionRunId}";
    var unit = Model.OutputUnitCode;
}
<link rel="stylesheet" href="~/css/Admin/ProductionOrder/production-order.css" />

<main class="container-fluid px-4 mt-4 po-page">
    <header class="po-title-section bom-depth-header">
        <nav class="rb-breadcrumb po-breadcrumb" aria-label="Điều hướng">
            <a asp-action="Index" asp-route-storeId="@Model.StoreId">Lệnh sản xuất</a> &gt; <span>PR-@Model.ProductionRunId</span>
        </nav>
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div class="admin-module-title-row">
                <span class="admin-module-title-icon" aria-hidden="true"><i class="fas fa-industry"></i></span>
                <div>
                    <div class="small text-uppercase text-muted">@Model.StoreName · @Model.OutputName</div>
                    <h1 class="po-title">PR-@Model.ProductionRunId</h1>
                    <p class="po-subtitle">@Model.RecipeName · @(Model.PlannedBatchCount?.ToString() ?? Model.RequestedRunCount.ToString("0.#####")) mẻ</p>
                </div>
            </div>
            <span class="badge-status-done">@Model.StatusLabel</span>
        </div>
    </header>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <section class="po-main-card mb-4" aria-labelledby="production-summary-title">
        <h2 id="production-summary-title" class="po-section-title">Kế hoạch và nhu cầu</h2>
        <div class="row g-4">
            <div class="col-md-3"><div class="text-muted small">Số mẻ kế hoạch</div><strong class="fs-4">@(Model.PlannedBatchCount?.ToString() ?? Model.RequestedRunCount.ToString("0.#####"))</strong></div>
            <div class="col-md-3"><div class="text-muted small">Sản lượng mỗi mẻ</div><strong class="fs-4">@(Model.ExpectedOutputPerBatchBase?.ToString("0.###") ?? "—") @unit</strong></div>
            <div class="col-md-3"><div class="text-muted small">Sản lượng dự kiến</div><strong class="fs-4">@(Model.ExpectedOutputBase?.ToString("0.###") ?? "—") @unit</strong></div>
            <div class="col-md-3"><div class="text-muted small">Ngưỡng chênh lệch</div><strong class="fs-4">@Model.YieldVarianceTolerancePercent.ToString("0.##")%</strong></div>
        </div>
        @if (Model.RestockRequestId.HasValue)
        {
            <hr />
            <div class="row g-3">
                <div class="col-md-3"><span class="text-muted">Yêu cầu nhập hàng</span><div><a asp-controller="AdminRestockRequests" asp-action="Details" asp-route-id="@Model.RestockRequestId">@(Model.RestockReferenceCode ?? $"RR #{Model.RestockRequestId}")</a></div></div>
                <div class="col-md-3"><span class="text-muted">Nhu cầu</span><div><strong>@Model.RestockRequestedQuantity?.ToString("0.###") @unit</strong></div></div>
                <div class="col-md-3"><span class="text-muted">Đã đáp ứng</span><div><strong>@Model.RestockFulfilledQuantity.ToString("0.###") @unit</strong></div></div>
                <div class="col-md-3"><span class="text-muted">Còn lại</span><div><strong>@Model.RestockRemainingQuantity.ToString("0.###") @unit</strong></div></div>
            </div>
        }
    </section>

    <section class="history-section mb-4" aria-labelledby="actual-input-title">
        <div class="history-header"><h2 id="actual-input-title" class="history-title">Đầu vào thực tế</h2><span class="small text-muted">FIFO dùng số lượng thực tế đã xác nhận</span></div>
        <div class="history-card">
            <div class="table-responsive">
                <table class="table po-table align-middle">
                    <thead><tr><th>ĐẦU VÀO</th><th>KẾ HOẠCH</th><th>THỰC TẾ</th></tr></thead>
                    <tbody>
                    @foreach (var input in Model.Inputs)
                    {
                        <tr><td><strong>@input.Name</strong><div class="small text-muted">@input.Code</div></td><td>@input.PlannedBaseQuantity.ToString("0.###") @input.BaseUnitCode</td><td>@(input.ActualBaseQuantity?.ToString("0.###") ?? "Chưa xác nhận") @input.BaseUnitCode</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    @if (Model.Output != null)
    {
        <section class="po-main-card mb-4" aria-labelledby="actual-output-title">
            <h2 id="actual-output-title" class="po-section-title">Sản lượng thực tế</h2>
            <div class="row g-4">
                <div class="col-md-3"><div class="text-muted small">Đã sản xuất</div><strong>@Model.Output.ActualProducedBase.ToString("0.###") @unit</strong></div>
                <div class="col-md-3"><div class="text-muted small">Sản lượng đạt</div><strong>@Model.Output.AcceptedOutputBase.ToString("0.###") @unit</strong></div>
                <div class="col-md-3"><div class="text-muted small">Loại bỏ / hao hụt</div><strong>@Model.Output.RejectedOutputBase.ToString("0.###") @unit</strong></div>
                <div class="col-md-3"><div class="text-muted small">Chênh lệch</div><strong>@Model.Output.VariancePercent.ToString("0.##")%</strong></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Output.Reason)) { <p class="mt-3 mb-0"><span class="text-muted">Lý do:</span> @Model.Output.Reason</p> }
        </section>
    }

    <section class="po-main-card mb-4" aria-labelledby="production-actions-title">
        <h2 id="production-actions-title" class="po-section-title">Thao tác hợp lệ tiếp theo</h2>
        <div class="d-flex flex-wrap gap-3">
            @if (Model.CanRelease)
            {
                <form asp-action="Release" asp-route-id="@Model.ProductionRunId" method="post">@Html.AntiForgeryToken()<button class="btn btn-primary-action" type="submit"><i class="fas fa-paper-plane" aria-hidden="true"></i> Phát hành lệnh</button></form>
            }
            @if (Model.CanStart)
            {
                <form asp-action="Start" asp-route-id="@Model.ProductionRunId" method="post">@Html.AntiForgeryToken()<button class="btn btn-primary-action" type="submit"><i class="fas fa-play" aria-hidden="true"></i> Bắt đầu sản xuất</button></form>
            }
            @if (Model.CanApproveVariance)
            {
                <form asp-action="ApproveVariance" asp-route-id="@Model.ProductionRunId" method="post" class="d-flex flex-wrap gap-2">
                    @Html.AntiForgeryToken()<label class="visually-hidden" for="approveReason">Ghi chú phê duyệt</label><input id="approveReason" class="form-control" name="reason" maxlength="500" placeholder="Ghi chú phê duyệt" /><button class="btn btn-primary-action" type="submit"><i class="fas fa-user-check" aria-hidden="true"></i> Duyệt chênh lệch</button>
                </form>
            }
            @if (Model.CanAcceptOutput)
            {
                <form asp-action="AcceptOutput" asp-route-id="@Model.ProductionRunId" method="post">@Html.AntiForgeryToken()<button class="btn btn-primary-action" type="submit"><i class="fas fa-boxes-stacked" aria-hidden="true"></i> Xác nhận nhập đầu ra</button></form>
            }
            @if (Model.CanCancel)
            {
                <form asp-action="Cancel" asp-route-id="@Model.ProductionRunId" method="post" class="d-flex flex-wrap gap-2">
                    @Html.AntiForgeryToken()<label class="visually-hidden" for="cancelReason">Lý do hủy</label><input id="cancelReason" class="form-control" name="reason" maxlength="500" required placeholder="Lý do hủy" /><button class="btn btn-outline-danger" type="submit"><i class="fas fa-ban" aria-hidden="true"></i> Hủy lệnh</button>
                </form>
            }
            @if (!Model.CanRelease && !Model.CanStart && !Model.CanRecordActual && !Model.CanApproveVariance && !Model.CanAcceptOutput && !Model.CanCancel)
            {
                <span class="text-muted">Không có thao tác phù hợp với quyền và trạng thái hiện tại.</span>
            }
        </div>
    </section>

    @if (Model.CanRecordActual)
    {
        <section class="po-main-card mb-4" aria-labelledby="record-actual-title">
            <h2 id="record-actual-title" class="po-section-title">Xác nhận đầu vào và sản lượng thực tế</h2>
            <form asp-action="RecordActual" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ProductionRunId" value="@Model.ProductionRunId" />
                @for (var i = 0; i < Model.Inputs.Count; i++)
                {
                    <input type="hidden" name="Inputs[@i].IngredientId" value="@Model.Inputs[i].IngredientId" />
                    <input type="hidden" name="Inputs[@i].PreparedItemId" value="@Model.Inputs[i].PreparedItemId" />
                    <div class="col-lg-6">
                        <label class="form-label" for="input-@i">@Model.Inputs[i].Name thực tế (@Model.Inputs[i].BaseUnitCode)</label>
                        <input id="input-@i" class="form-control" type="number" step="0.001" min="0" required name="Inputs[@i].ActualBaseQuantity" value="@Model.Inputs[i].PlannedBaseQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                        <div class="form-text">Kế hoạch: @Model.Inputs[i].PlannedBaseQuantity.ToString("0.###") @Model.Inputs[i].BaseUnitCode</div>
                    </div>
                }
                <div class="col-md-4"><label class="form-label" for="actualProduced">Tổng sản lượng thực tế (@unit)</label><input id="actualProduced" class="form-control" name="ActualProducedBase" type="number" step="0.001" min="0" required /></div>
                <div class="col-md-4"><label class="form-label" for="acceptedOutput">Sản lượng đạt (@unit)</label><input id="acceptedOutput" class="form-control" name="AcceptedOutputBase" type="number" step="0.001" min="0" required /></div>
                <div class="col-md-4"><label class="form-label" for="rejectedOutput">Lượng loại bỏ (@unit)</label><input id="rejectedOutput" class="form-control" name="RejectedOutputBase" type="number" step="0.001" min="0" value="0" required /></div>
                <div class="col-12"><label class="form-label" for="varianceReason">Lý do chênh lệch</label><textarea id="varianceReason" class="form-control" name="Reason" maxlength="500" rows="2" placeholder="Bắt buộc khi vượt ngưỡng hoặc sản lượng đạt bằng 0"></textarea></div>
                <div class="col-12"><button class="btn btn-primary-action" type="submit"><i class="fas fa-clipboard-check" aria-hidden="true"></i> Xác nhận số liệu thực tế</button></div>
            </form>
        </section>
    }

    <section class="history-section mb-5" aria-labelledby="timeline-title">
        <div class="history-header"><h2 id="timeline-title" class="history-title">Lịch sử trạng thái</h2></div>
        <div class="history-card">
            @if (Model.Transitions.Count == 0)
            {
                <div class="p-4 text-muted">Chưa có lịch sử chuyển trạng thái.</div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var transition in Model.Transitions)
                    {
                        <div class="list-group-item py-3">
                            <div class="d-flex flex-wrap justify-content-between gap-2"><strong>@transition.FromStatusLabel → @transition.ToStatusLabel</strong><time class="small text-muted">@transition.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time></div>
                            <div class="small text-muted">@transition.ActorName</div>
                            @if (!string.IsNullOrWhiteSpace(transition.Reason)) { <div class="mt-1">@transition.Reason</div> }
                        </div>
                    }
                </div>
            }
        </div>
    </section>
</main>
