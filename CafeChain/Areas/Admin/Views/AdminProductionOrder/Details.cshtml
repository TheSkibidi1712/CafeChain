@model CafeChain.Application.DTOs.Admin.Production.ProductionRunDetailDto
@using CafeChain.Models.Enums.Inventory
@using CafeChain.ViewModels.Admin.Shared
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ProductionResource> L
@{
    ViewData["Title"] = L["Details.PageTitle", Model.ProductionRunId].Value;
    var unit = Model.OutputUnitCode;
    var currentStep = Model.Status switch
    {
        ProductionRunStatus.Planned => 0,
        ProductionRunStatus.Released => 1,
        ProductionRunStatus.InProgress => 2,
        ProductionRunStatus.AwaitingVarianceApproval => 3,
        ProductionRunStatus.AwaitingAcceptance => 4,
        ProductionRunStatus.Completed => 5,
        ProductionRunStatus.Confirmed => 2,
        _ => 0
    };
    var hero = new AdminPageHeroVM
    {
        Eyebrow = L["Details.Eyebrow"].Value,
        Title = L["Details.Title", Model.ProductionRunId].Value,
        Description = L["Details.Description", Model.StoreName, Model.OutputName].Value,
        IconClass = "fas fa-industry",
        StatusLabel = L[$"ProductionOrder.Status.{Model.Status}"].Value,
        StatusCssClass = Model.Status == ProductionRunStatus.Cancelled ? "rb-status-inactive" : "rb-status-active",
        Breadcrumbs =
        [
            new() { Label = L["Details.List"].Value, Url = Url.Action("Index", new { storeId = Model.StoreId }) },
            new() { Label = $"PR-{Model.ProductionRunId}" }
        ],
        Actions =
        [
            new()
            {
                Label = L["Details.Back"].Value,
                Url = Url.Action("Index", new { storeId = Model.StoreId }) ?? "#",
                IconClass = "fas fa-arrow-left"
            }
        ]
    };
    var lifecycle = new AdminLifecycleStepperVM
    {
        AccessibleLabel = L["Details.Progress"].Value,
        Steps = new[]
        {
            new AdminLifecycleStepVM { Label = L["Details.Step.Plan"].Value, IconClass = "fas fa-clipboard-list", IsCompleted = currentStep > 0, IsCurrent = currentStep == 0 },
            new AdminLifecycleStepVM { Label = L["Details.Step.Release"].Value, IconClass = "fas fa-paper-plane", IsCompleted = currentStep > 1, IsCurrent = currentStep == 1 },
            new AdminLifecycleStepVM { Label = L["Details.Step.Produce"].Value, IconClass = "fas fa-gears", IsCompleted = currentStep > 2, IsCurrent = currentStep == 2 },
            new AdminLifecycleStepVM { Label = L["Details.Step.Record"].Value, IconClass = "fas fa-clipboard-check", IsCompleted = currentStep > 3, IsCurrent = currentStep == 3 },
            new AdminLifecycleStepVM { Label = L["Details.Step.Accept"].Value, IconClass = "fas fa-boxes-stacked", IsCompleted = currentStep > 4, IsCurrent = currentStep == 4 },
            new AdminLifecycleStepVM { Label = L["Details.Step.Complete"].Value, IconClass = "fas fa-check", IsCompleted = currentStep >= 5, IsCurrent = currentStep == 5 }
        }
    };
    var nextAction = Model.Status switch
    {
        ProductionRunStatus.Planned => new AdminNextActionPanelVM { Description = L["Details.Next.Planned"].Value, RoleLabel = L["Details.Role.StoreManager"].Value, IconClass = "fas fa-paper-plane" },
        ProductionRunStatus.Released => new AdminNextActionPanelVM { Description = L["Details.Next.Released"].Value, RoleLabel = L["Details.Role.ShiftSupervisor"].Value, IconClass = "fas fa-play" },
        ProductionRunStatus.InProgress => new AdminNextActionPanelVM { Description = L["Details.Next.InProgress"].Value, RoleLabel = L["Details.Role.ShiftSupervisor"].Value, IconClass = "fas fa-clipboard-check" },
        ProductionRunStatus.AwaitingVarianceApproval => new AdminNextActionPanelVM { Description = L["Details.Next.Variance"].Value, RoleLabel = L["Details.Role.Owner"].Value, IconClass = "fas fa-user-check" },
        ProductionRunStatus.AwaitingAcceptance => new AdminNextActionPanelVM { Description = L["Details.Next.Acceptance"].Value, RoleLabel = L["Details.Role.StoreManager"].Value, IconClass = "fas fa-boxes-stacked" },
        ProductionRunStatus.Completed => new AdminNextActionPanelVM { Title = L["Details.Next.CompletedTitle"].Value, Description = L["Details.Next.Completed"].Value, IconClass = "fas fa-circle-check" },
        ProductionRunStatus.Cancelled => new AdminNextActionPanelVM { Title = L["Details.Next.CancelledTitle"].Value, Description = L["Details.Next.Cancelled"].Value, IconClass = "fas fa-ban" },
        _ => new AdminNextActionPanelVM { Description = L["Details.Next.Default"].Value, IconClass = "fas fa-arrow-right" }
    };
}
<link rel="stylesheet" href="~/css/Admin/ProductionOrder/production-order.css" />
<link rel="stylesheet" href="~/css/Admin/production-bom-ui.css" asp-append-version="true" />

<main class="po-page production-bom-page production-bom-shell production-detail-page">
    <partial name="_PageHero" model="hero" />
    <partial name="_LifecycleStepper" model="lifecycle" />

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <section id="production-plan" class="po-main-card mb-4" aria-labelledby="production-summary-title">
        <h2 id="production-summary-title" class="po-section-title">@L["Details.Plan.Title"]</h2>
        <div class="row g-4">
            <div class="col-md-3">
                <div class="text-muted small">@(Model.PlannedBatchCount.HasValue ? L["Details.Plan.Batches"].Value : L["Details.Plan.Factor"].Value)</div>
                <strong class="fs-4">@(Model.PlannedBatchCount?.ToString() ?? Model.RequestedRunCount.ToString("0.#####"))</strong>
            </div>
            <div class="col-md-3"><div class="text-muted small">@L["Details.Plan.PerBatch"]</div><strong class="fs-4">@(Model.ExpectedOutputPerBatchBase?.ToString("0.###") ?? "—") @unit</strong></div>
            <div class="col-md-3"><div class="text-muted small">@L["Details.Plan.Expected"]</div><strong class="fs-4">@(Model.ExpectedOutputBase?.ToString("0.###") ?? "—") @unit</strong></div>
            <div class="col-md-3"><div class="text-muted small">@L["Details.Plan.Tolerance"]</div><strong class="fs-4">@Model.YieldVarianceTolerancePercent.ToString("0.##")%</strong></div>
        </div>
        @if (Model.RestockRequestId.HasValue)
        {
            <hr />
            <div class="row g-3">
                <div class="col-md-3"><span class="text-muted">@L["Details.Restock.Reference"]</span><div><a asp-controller="AdminRestockRequests" asp-action="Details" asp-route-id="@Model.RestockRequestId">@AdminStatusDisplay.RestockReference(Model.RestockReferenceCode, Model.RestockRequestId.Value)</a></div></div>
                <div class="col-md-3"><span class="text-muted">@L["Details.Restock.Requested"]</span><div><strong>@Model.RestockRequestedQuantity?.ToString("0.###") @unit</strong></div></div>
                <div class="col-md-3"><span class="text-muted">@L["Details.Restock.Fulfilled"]</span><div><strong>@Model.RestockFulfilledQuantity.ToString("0.###") @unit</strong></div></div>
                <div class="col-md-3"><span class="text-muted">@L["Details.Restock.Remaining"]</span><div><strong>@Model.RestockRemainingQuantity.ToString("0.###") @unit</strong></div></div>
            </div>
        }
    </section>

    <section id="production-inputs" class="history-section mb-4" aria-labelledby="actual-input-title">
        <div class="history-header"><h2 id="actual-input-title" class="history-title">@L["Details.Input.Title"]</h2><span class="small text-muted">@L["Details.Input.Help"]</span></div>
        <div class="history-card">
            <div class="table-responsive">
                <table class="table po-table align-middle">
                    <thead><tr><th>@L["Details.Input.Column"]</th><th>@L["Details.Plan.Column"]</th><th>@L["Details.Actual.Column"]</th></tr></thead>
                    <tbody>
                    @foreach (var input in Model.Inputs)
                    {
                        <tr><td><strong>@input.Name</strong><div class="small text-muted">@input.Code</div></td><td>@input.PlannedBaseQuantity.ToString("0.###") @input.BaseUnitCode</td><td>@(input.ActualBaseQuantity?.ToString("0.###") ?? L["Details.NotConfirmed"].Value) @input.BaseUnitCode</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    @if (Model.Output != null)
    {
        <section id="production-output" class="po-main-card mb-4" aria-labelledby="actual-output-title">
            <h2 id="actual-output-title" class="po-section-title">@L["Details.Output.Title"]</h2>
            <div class="row g-4">
                <div class="col-md-3"><div class="text-muted small">@L["Details.Output.Produced"]</div><strong>@Model.Output.ActualProducedBase.ToString("0.###") @unit</strong></div>
                <div class="col-md-3"><div class="text-muted small">@L["Details.Output.Accepted"]</div><strong>@Model.Output.AcceptedOutputBase.ToString("0.###") @unit</strong></div>
                <div class="col-md-3"><div class="text-muted small">@L["Details.Output.Rejected"]</div><strong>@Model.Output.RejectedOutputBase.ToString("0.###") @unit</strong></div>
                <div class="col-md-3"><div class="text-muted small">@L["Details.Output.Variance"]</div><strong>@Model.Output.VariancePercent.ToString("0.##")%</strong></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Output.Reason)) { <p class="mt-3 mb-0"><span class="text-muted">@L["Details.Reason"]</span> @Model.Output.Reason</p> }
        </section>
    }

    <partial name="_NextActionPanel" model="nextAction" />

    <section id="production-actions" class="po-main-card mb-4" aria-labelledby="production-actions-title">
        <h2 id="production-actions-title" class="po-section-title">@L["Details.Actions.Title"]</h2>
        <div class="d-flex flex-wrap gap-3">
            @if (Model.CanRelease)
            {
                <form asp-action="Release" asp-route-id="@Model.ProductionRunId" method="post">@Html.AntiForgeryToken()<button class="btn btn-primary-action" type="submit"><i class="fas fa-paper-plane" aria-hidden="true"></i> @L["Details.Actions.Release"]</button></form>
            }
            @if (Model.CanStart)
            {
                <form asp-action="Start" asp-route-id="@Model.ProductionRunId" method="post">@Html.AntiForgeryToken()<button class="btn btn-primary-action" type="submit"><i class="fas fa-play" aria-hidden="true"></i> @L["Details.Actions.Start"]</button></form>
            }
            @if (Model.CanApproveVariance)
            {
                <form asp-action="ApproveVariance" asp-route-id="@Model.ProductionRunId" method="post" class="d-flex flex-wrap gap-2">
                    @Html.AntiForgeryToken()<label class="visually-hidden" for="approveReason">@L["Details.Actions.ApprovalNote"]</label><input id="approveReason" class="form-control" name="reason" maxlength="500" placeholder="@L["Details.Actions.ApprovalNote"]" /><button class="btn btn-primary-action" type="submit"><i class="fas fa-user-check" aria-hidden="true"></i> @L["Details.Actions.Approve"]</button>
                </form>
            }
            @if (Model.CanAcceptOutput)
            {
                <form asp-action="AcceptOutput" asp-route-id="@Model.ProductionRunId" method="post">@Html.AntiForgeryToken()<button class="btn btn-primary-action" type="submit"><i class="fas fa-boxes-stacked" aria-hidden="true"></i> @L["Details.Actions.Accept"]</button></form>
            }
            @if (Model.CanCancel)
            {
                <form asp-action="Cancel" asp-route-id="@Model.ProductionRunId" method="post" class="d-flex flex-wrap gap-2">
                    @Html.AntiForgeryToken()<label class="visually-hidden" for="cancelReason">@L["Details.Actions.CancelReason"]</label><input id="cancelReason" class="form-control" name="reason" maxlength="500" required placeholder="@L["Details.Actions.CancelReason"]" /><button class="btn btn-outline-danger" type="submit"><i class="fas fa-ban" aria-hidden="true"></i> @L["Details.Actions.Cancel"]</button>
                </form>
            }
            @if (!Model.CanRelease && !Model.CanStart && !Model.CanRecordActual && !Model.CanApproveVariance && !Model.CanAcceptOutput && !Model.CanCancel)
            {
                <span class="text-muted">@L["Details.Actions.ReadOnly"]</span>
            }
        </div>
    </section>

    @if (Model.CanRecordActual)
    {
        <section id="production-record-actual" class="po-main-card mb-4" aria-labelledby="record-actual-title">
            <h2 id="record-actual-title" class="po-section-title">@L["Details.Record.Title"]</h2>
            <form asp-action="RecordActual" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ProductionRunId" value="@Model.ProductionRunId" />
                @for (var i = 0; i < Model.Inputs.Count; i++)
                {
                    <input type="hidden" name="Inputs[@i].IngredientId" value="@Model.Inputs[i].IngredientId" />
                    <input type="hidden" name="Inputs[@i].PreparedItemId" value="@Model.Inputs[i].PreparedItemId" />
                    <div class="col-lg-6">
                        <label class="form-label" for="input-@i">@L["Details.Record.Input", Model.Inputs[i].Name, Model.Inputs[i].BaseUnitCode]</label>
                        <input id="input-@i" class="form-control" type="number" step="0.001" min="0" required name="Inputs[@i].ActualBaseQuantity" value="@Model.Inputs[i].PlannedBaseQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                        <div class="form-text">@L["Details.Record.Planned", Model.Inputs[i].PlannedBaseQuantity.ToString("0.###"), Model.Inputs[i].BaseUnitCode]</div>
                    </div>
                }
                <div class="col-md-4"><label class="form-label" for="actualProduced">@L["Details.Record.Produced", unit]</label><input id="actualProduced" class="form-control" name="ActualProducedBase" type="number" step="0.001" min="0" required /></div>
                <div class="col-md-4"><label class="form-label" for="acceptedOutput">@L["Details.Record.Accepted", unit]</label><input id="acceptedOutput" class="form-control" name="AcceptedOutputBase" type="number" step="0.001" min="0" required /></div>
                <div class="col-md-4"><label class="form-label" for="rejectedOutput">@L["Details.Record.Rejected", unit]</label><input id="rejectedOutput" class="form-control" name="RejectedOutputBase" type="number" step="0.001" min="0" value="0" required /></div>
                <div class="col-12"><label class="form-label" for="varianceReason">@L["Details.Record.VarianceReason"]</label><textarea id="varianceReason" class="form-control" name="Reason" maxlength="500" rows="2" placeholder="@L["Details.Record.VariancePlaceholder"]"></textarea></div>
                <div class="col-12"><button class="btn btn-primary-action" type="submit"><i class="fas fa-clipboard-check" aria-hidden="true"></i> @L["Details.Record.Submit"]</button></div>
            </form>
        </section>
    }

    <section id="production-history" class="history-section mb-5" aria-labelledby="timeline-title">
        <div class="history-header"><h2 id="timeline-title" class="history-title">@L["Details.History.Title"]</h2></div>
        <div class="history-card">
            @if (Model.Transitions.Count == 0)
            {
                <div class="p-4 text-muted">@L["Details.History.Empty"]</div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var transition in Model.Transitions)
                    {
                        <div class="list-group-item py-3">
                            <div class="d-flex flex-wrap justify-content-between gap-2"><strong>@transition.FromStatusLabel → @transition.ToStatusLabel</strong><time class="small text-muted">@transition.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time></div>
                            <div class="small text-muted">@transition.ActorName</div>
                            @if (!string.IsNullOrWhiteSpace(transition.Reason)) { <div class="mt-1">@transition.Reason</div> }
                        </div>
                    }
                </div>
            }
        </div>
    </section>
</main>
