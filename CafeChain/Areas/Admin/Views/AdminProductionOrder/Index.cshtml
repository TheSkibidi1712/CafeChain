@model CafeChain.Application.DTOs.Admin.Production.ProductionRunListDto
@using CafeChain.Application.DTOs.Admin.Production
@using CafeChain.Application.DTOs.Admin.StoreInventories
@using CafeChain.Models.Enums.Inventory
@using CafeChain.ViewModels.Admin.Shared
@{
    ViewData["Title"] = "Lệnh sản xuất theo mẻ";
    var stores = ViewBag.Stores as IReadOnlyCollection<InventoryStoreDTO> ?? [];
    var selectedStoreId = ViewBag.SelectedStoreId as int? ?? 0;
    var selectedStatus = ViewBag.SelectedStatus as string;
    var canCreateLegacy = ViewBag.CanCreateLegacy is true;
    var heroActions = canCreateLegacy
        ? new List<AdminPageHeroActionVM>
        {
            new()
            {
                Label = "Sơ chế độc lập (quy trình cũ)",
                Url = Url.Action("Create", new { storeId = selectedStoreId }) ?? "#",
                IconClass = "fas fa-fire-burner"
            }
        }
        : [];
    var hero = new AdminPageHeroVM
    {
        Eyebrow = "Sản xuất / BOM",
        Title = "Lệnh sản xuất",
        Description = "Theo dõi kế hoạch theo mẻ, sản lượng thực tế, chênh lệch và tiến độ đáp ứng nhu cầu tại cửa hàng.",
        IconClass = "fas fa-industry",
        Breadcrumbs = [new() { Label = "Sản xuất / BOM" }, new() { Label = "Lệnh sản xuất" }],
        Actions = heroActions
    };
}
<link rel="stylesheet" href="~/css/Admin/ProductionOrder/production-order.css" />
<link rel="stylesheet" href="~/css/Admin/production-bom-ui.css" asp-append-version="true" />

<main class="po-page production-bom-page">
    <partial name="_PageHero" model="hero" />

    @if (ViewBag.ErrorMessage is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <section class="po-main-card mb-4" aria-labelledby="production-filter-title">
        <h2 id="production-filter-title" class="po-section-title">Bộ lọc vận hành</h2>
        <form method="get" class="row g-3 align-items-end">
            <div class="col-lg-5 col-md-7">
                <label for="storeId" class="form-label">Cửa hàng</label>
                <select id="storeId" name="storeId" class="form-select">
                    @foreach (var store in stores)
                    {
                        <option value="@store.StoreId" selected="@(store.StoreId == selectedStoreId)">@store.StoreName</option>
                    }
                </select>
            </div>
            <div class="col-lg-4 col-md-5">
                <label for="status" class="form-label">Trạng thái</label>
                <select id="status" name="status" class="form-select">
                    <option value="">Tất cả trạng thái</option>
                    @foreach (var status in Enum.GetValues<ProductionRunStatus>())
                    {
                        <option value="@status" selected="@(string.Equals(selectedStatus, status.ToString(), StringComparison.OrdinalIgnoreCase))">
                            @ProductionRunDisplay.Status(status)
                        </option>
                    }
                </select>
            </div>
            <div class="col-lg-3 d-flex gap-2">
                <button class="btn btn-primary-action flex-grow-1" type="submit"><i class="fas fa-filter" aria-hidden="true"></i> Áp dụng</button>
                <a class="btn btn-ghost" asp-action="Index" asp-route-storeId="@selectedStoreId" aria-label="Xóa bộ lọc" title="Xóa bộ lọc">
                    <i class="fas fa-rotate-left" aria-hidden="true"></i>
                </a>
            </div>
        </form>
    </section>

    <section class="history-section" aria-labelledby="production-list-title">
        <div class="history-header">
            <h2 id="production-list-title" class="history-title">Danh sách lệnh</h2>
            <span class="text-muted small">@Model.TotalCount lệnh</span>
        </div>
        <div class="history-card">
            <div class="table-responsive">
                <table class="table po-table align-middle">
                    <thead>
                        <tr>
                            <th>LỆNH</th>
                            <th>ĐẦU RA</th>
                            <th>QUY MÔ</th>
                            <th>SẢN LƯỢNG DỰ KIẾN</th>
                            <th>YÊU CẦU</th>
                            <th>TRẠNG THÁI</th>
                            <th>NGƯỜI LẬP</th>
                            <th class="text-end">THAO TÁC</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr><td colspan="8" class="text-center text-muted py-5">Chưa có lệnh sản xuất phù hợp với bộ lọc.</td></tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td><strong>PR-@item.ProductionRunId</strong><div class="small text-muted">@(item.ContractVersion == 2 ? "Quy trình theo nhu cầu" : "Quy trình cũ")</div></td>
                                    <td><strong>@item.OutputName</strong><div class="small text-muted">@item.RecipeName</div></td>
                                    <td>
                                        @if (item.PlannedBatchCount.HasValue)
                                        {
                                            <span>@item.PlannedBatchCount mẻ</span>
                                        }
                                        else
                                        {
                                            <span>@item.RequestedRunCount.ToString("0.#####") hệ số</span>
                                        }
                                    </td>
                                    <td>@(item.ExpectedOutputBase?.ToString("0.###") ?? "—") @item.OutputUnitCode</td>
                                    <td>@(item.RestockRequestId.HasValue ? $"Yêu cầu nhập hàng #{item.RestockRequestId}" : "Sơ chế độc lập")</td>
                                    <td>
                                        @{ var statusClass = item.Status switch
                                            {
                                                ProductionRunStatus.Completed => "is-complete",
                                                ProductionRunStatus.Cancelled => "is-cancelled",
                                                ProductionRunStatus.AwaitingVarianceApproval => "is-warning",
                                                ProductionRunStatus.InProgress or ProductionRunStatus.AwaitingAcceptance => "is-progress",
                                                _ => "is-neutral"
                                            }; }
                                        <span class="production-status @statusClass">@item.StatusLabel</span>
                                    </td>
                                    <td>@item.CreatedByName<div class="small text-muted">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div></td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-primary rb-table-action" asp-action="Details" asp-route-id="@item.ProductionRunId">
                                            <i class="fas fa-arrow-right" aria-hidden="true"></i> Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.TotalPages > 1)
            {
                <nav class="d-flex justify-content-between align-items-center p-3" aria-label="Phân trang lệnh sản xuất">
                    <span class="small text-muted">Trang @Model.Page / @Model.TotalPages</span>
                    <div class="d-flex gap-2">
                        <a class="btn btn-sm btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")" asp-route-storeId="@selectedStoreId" asp-route-status="@selectedStatus" asp-route-page="@(Model.Page - 1)">Trang trước</a>
                        <a class="btn btn-sm btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")" asp-route-storeId="@selectedStoreId" asp-route-status="@selectedStatus" asp-route-page="@(Model.Page + 1)">Trang sau</a>
                    </div>
                </nav>
            }
        </div>
    </section>
</main>
