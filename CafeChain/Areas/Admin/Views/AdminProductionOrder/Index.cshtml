@model CafeChain.Application.DTOs.Admin.Production.ProductionRunListDto
@using CafeChain.Application.DTOs.Admin.Production
@using CafeChain.Application.DTOs.Admin.StoreInventories
@using CafeChain.Models.Enums.Inventory
@using CafeChain.ViewModels.Admin.Shared
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ProductionResource> ProductionText
@{
    ViewData["Title"] = ProductionText["ProductionOrder.PageTitle"];
    var stores = ViewBag.Stores as IReadOnlyCollection<InventoryStoreDTO> ?? [];
    var selectedStoreId = ViewBag.SelectedStoreId as int? ?? 0;
    var selectedStatus = ViewBag.SelectedStatus as string;
    var canCreateLegacy = ViewBag.CanCreateLegacy is true;
    string StatusText(ProductionRunStatus value) => ProductionText[$"ProductionOrder.Status.{value}"];
    var heroActions = new List<AdminPageHeroActionVM>
    {
        new()
        {
            Label = ProductionText["ProductionOrder.Capabilities"],
            Url = Url.Action("Capabilities", new { storeId = selectedStoreId }) ?? "#",
            IconClass = "fas fa-sliders"
        }
    };
    if (canCreateLegacy)
    {
        heroActions.Add(new()
        {
            Label = ProductionText["ProductionOrder.Standalone"],
            Url = Url.Action("Create", new { storeId = selectedStoreId }) ?? "#",
            IconClass = "fas fa-fire-burner"
        });
    }
    var hero = new AdminPageHeroVM
    {
        Eyebrow = ProductionText["Production.Breadcrumb"],
        Title = ProductionText["ProductionOrder.Title"],
        Description = ProductionText["ProductionOrder.Description"],
        IconClass = "fas fa-industry",
        Breadcrumbs = [new() { Label = ProductionText["Production.Breadcrumb"] }, new() { Label = ProductionText["ProductionOrder.Title"] }],
        Actions = heroActions
    };
}
<link rel="stylesheet" href="~/css/Admin/ProductionOrder/production-order.css" />
<link rel="stylesheet" href="~/css/Admin/production-bom-ui.css" asp-append-version="true" />

<main class="po-page production-bom-page production-bom-shell bom-list-page production-run-list-page">
    <partial name="_PageHero" model="hero" />

    @if (ViewBag.ErrorMessage is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <section class="production-filter-card" aria-labelledby="production-filter-title">
        <header class="production-filter-card__heading">
            <h2 id="production-filter-title">@ProductionText["ProductionOrder.Filter.Title"]</h2>
            <p>@ProductionText["ProductionOrder.Filter.Description"]</p>
        </header>
        <form method="get" class="production-filter-grid">
            <div class="production-filter-field">
                <label for="storeId" class="form-label">@ProductionText["Common.Store"]</label>
                <select id="storeId" name="storeId" class="form-select">
                    @foreach (var store in stores)
                    {
                        <option value="@store.StoreId" selected="@(store.StoreId == selectedStoreId)">@store.StoreName</option>
                    }
                </select>
            </div>
            <div class="production-filter-field">
                <label for="status" class="form-label">@ProductionText["Common.Status"]</label>
                <select id="status" name="status" class="form-select">
                    <option value="">@ProductionText["Common.AllStatuses"]</option>
                    @foreach (var status in Enum.GetValues<ProductionRunStatus>())
                    {
                        <option value="@status" selected="@(string.Equals(selectedStatus, status.ToString(), StringComparison.OrdinalIgnoreCase))">
                            @StatusText(status)
                        </option>
                    }
                </select>
            </div>
            <div class="production-filter-actions">
                <button class="btn btn-primary-action" type="submit"><i class="fas fa-filter" aria-hidden="true"></i> @ProductionText["Common.Apply"]</button>
                <a class="btn btn-ghost production-filter-reset" asp-action="Index" asp-route-storeId="@selectedStoreId" aria-label="@ProductionText["Common.ResetFilters"]" title="@ProductionText["Common.ResetFilters"]">
                    <i class="fas fa-rotate-left" aria-hidden="true"></i>
                </a>
            </div>
        </form>
    </section>

    <section class="production-list-section" aria-labelledby="production-list-title">
        <header class="production-section-header">
            <div>
                <h2 id="production-list-title">@ProductionText["ProductionOrder.List.Title"]</h2>
                <p>@ProductionText["ProductionOrder.List.Description"]</p>
            </div>
            <span class="production-section-header__count">@ProductionText["ProductionOrder.List.Count", Model.TotalCount]</span>
        </header>
        <div class="history-card production-table-panel p-0">
            <div class="table-responsive">
                <table class="table po-table production-data-table align-middle">
                    <colgroup>
                        <col class="production-col-run" />
                        <col class="production-col-output" />
                        <col class="production-col-scale" />
                        <col class="production-col-yield" />
                        <col class="production-col-request" />
                        <col class="production-col-status" />
                        <col class="production-col-actor" />
                        <col class="production-col-action" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>@ProductionText["ProductionOrder.Column.Order"]</th>
                            <th>@ProductionText["ProductionOrder.Column.Output"]</th>
                            <th>@ProductionText["ProductionOrder.Column.Scale"]</th>
                            <th>@ProductionText["ProductionOrder.Column.ExpectedOutput"]</th>
                            <th>@ProductionText["ProductionOrder.Column.Request"]</th>
                            <th>@ProductionText["Common.Status"]</th>
                            <th>@ProductionText["ProductionOrder.Column.CreatedBy"]</th>
                            <th class="production-action-column">@ProductionText["Common.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr><td colspan="8" class="text-center text-muted py-5">@ProductionText["ProductionOrder.Empty"]</td></tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td><strong>PR-@item.ProductionRunId</strong><div class="small text-muted">@(item.ContractVersion == 2 ? ProductionText["ProductionOrder.RestockDriven"] : ProductionText["ProductionOrder.Standalone"])</div></td>
                                    <td><strong>@item.OutputName</strong><div class="small text-muted">@item.RecipeName</div></td>
                                    <td>
                                        @if (item.PlannedBatchCount.HasValue)
                                        {
                                            <span>@ProductionText["ProductionOrder.BatchCount", item.PlannedBatchCount]</span>
                                        }
                                        else
                                        {
                                            <span>@ProductionText["ProductionOrder.RunFactor", item.RequestedRunCount.ToString("0.#####")]</span>
                                        }
                                    </td>
                                    <td>@(item.ExpectedOutputBase?.ToString("0.###") ?? "—") @item.OutputUnitCode</td>
                                    <td>@(item.RestockRequestId.HasValue ? ProductionText["ProductionOrder.RestockRequest", item.RestockRequestId] : ProductionText["ProductionOrder.Standalone"])</td>
                                    <td>
                                        @{ var statusClass = item.Status switch
                                            {
                                                ProductionRunStatus.Completed => "is-complete",
                                                ProductionRunStatus.Cancelled => "is-cancelled",
                                                ProductionRunStatus.AwaitingVarianceApproval => "is-warning",
                                                ProductionRunStatus.InProgress or ProductionRunStatus.AwaitingAcceptance => "is-progress",
                                                _ => "is-neutral"
                                            }; }
                                        <span class="production-status @statusClass">@StatusText(item.Status)</span>
                                    </td>
                                    <td>@item.CreatedByName<div class="small text-muted">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div></td>
                                    <td class="production-action-column">
                                        <a class="btn btn-sm rb-table-action production-row-action" asp-action="Details" asp-route-id="@item.ProductionRunId">
                                            <i class="fas fa-arrow-right" aria-hidden="true"></i> @ProductionText["Common.Details"]
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.TotalPages > 1)
            {
                var firstPage = Math.Max(1, Model.Page - 2);
                var lastPage = Math.Min(Model.TotalPages, firstPage + 4);
                firstPage = Math.Max(1, lastPage - 4);
                <nav class="production-pagination" aria-label="@ProductionText["ProductionOrder.Pagination.Label"]">
                    <span class="production-pagination__summary">@ProductionText["ProductionOrder.Pagination", Model.Page, Model.TotalPages]</span>
                    <div class="production-pagination__links">
                        @if (Model.Page > 1)
                        {
                            <a class="production-page-link is-nav" aria-label="@ProductionText["Common.PreviousPage"]" asp-route-storeId="@selectedStoreId" asp-route-status="@selectedStatus" asp-route-page="@(Model.Page - 1)"><i class="fas fa-chevron-left" aria-hidden="true"></i></a>
                        }
                        @for (var pageNumber = firstPage; pageNumber <= lastPage; pageNumber++)
                        {
                            <a class="production-page-link @(pageNumber == Model.Page ? "is-current" : "")"
                               aria-current="@(pageNumber == Model.Page ? "page" : null)"
                               aria-label="Trang @pageNumber"
                               asp-route-storeId="@selectedStoreId"
                               asp-route-status="@selectedStatus"
                               asp-route-page="@pageNumber">@pageNumber</a>
                        }
                        @if (Model.Page < Model.TotalPages)
                        {
                            <a class="production-page-link is-nav" aria-label="@ProductionText["Common.NextPage"]" asp-route-storeId="@selectedStoreId" asp-route-status="@selectedStatus" asp-route-page="@(Model.Page + 1)"><i class="fas fa-chevron-right" aria-hidden="true"></i></a>
                        }
                    </div>
                </nav>
            }
        </div>
    </section>
</main>
