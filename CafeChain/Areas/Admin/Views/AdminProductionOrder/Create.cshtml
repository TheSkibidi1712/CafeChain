@model CafeChain.ViewModels.Admin.Productions.ProductionOrderVM

@{
    ViewData["Title"] = "Lệnh Sơ Chế";
}

<link rel="stylesheet" href="~/css/Admin/ProductionOrder/production-order.css" />

<div class="container-fluid px-4 mt-4 po-page">
    <div class="po-title-section bom-depth-header">
        <nav class="rb-breadcrumb po-breadcrumb" aria-label="breadcrumb">
            <span>Sản xuất / BOM</span> &gt; <span>Lệnh sơ chế</span>
        </nav>
        <div class="admin-module-title-row">
            <span class="admin-module-title-icon" aria-hidden="true"><i class="fas fa-fire-burner"></i></span>
            <div>
                <h1 class="po-title">LỆNH SƠ CHẾ</h1>
                <p class="po-subtitle">Quản lý định lượng và quy trình sơ chế thực phẩm hàng ngày.</p>
            </div>
        </div>
    </div>

    <form asp-action="Create" method="post" id="productionForm">
        @Html.AntiForgeryToken()

        <div class="po-main-card">
            <div class="row g-5">
                <!-- Left Column -->
                <div class="col-lg-5 po-form-pane">
                    <div class="po-section-title">
                        <i class="fas fa-fire-burner"></i> Thông tin sơ chế chi tiết
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label" asp-for="StoreId">Cửa hàng <span class="text-danger">*</span></label>
                            <select asp-for="StoreId" id="storeSelect" class="form-select" required>
                                <option value="">-- Chọn cửa hàng --</option>
                                @foreach (var store in Model.Stores)
                                {
                                    <option value="@store.StoreId">@store.StoreName</option>
                                }
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Tên thành phẩm sơ chế <span class="text-danger">*</span></label>
                            <select asp-for="TargetRecipeId" id="recipeSelect" class="form-select" required>
                                <option value="">-- Chọn thành phẩm --</option>
                                @foreach (var recipe in Model.RecipeOptions)
                                {
                                    <option value="@recipe.RecipeId"
                                            disabled="@(!recipe.Selectable ? "disabled" : null)"
                                            data-code="@recipe.RecipeCode"
                                            data-disabled-reason="@recipe.DisabledReason">
                                        [@recipe.PreparedItemCode] @recipe.PreparedItemName · @recipe.OutputPerRunDisplay/mẻ
                                        @if (!recipe.Selectable)
                                        {
                                            <text> · @recipe.DisabledReason</text>
                                        }
                                    </option>
                                }
                            </select>
                            <div class="form-text">Chỉ hiển thị công thức BTP đang hoạt động; món bán tại quầy và topping không dùng cho lệnh sơ chế.</div>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Mã SKU dự kiến</label>
                            <input type="text" id="skuInput" class="form-control" readonly placeholder="Tự động tạo..." />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Số lượng mẻ <span class="text-danger">*</span></label>
                            <input type="number" step="any" min="0.00001" max="9999" name="PlannedBatches" id="batchInput"
                                   class="form-control fw-bold text-center" value="1" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Đơn vị</label>
                            <input type="text" class="form-control" value="mẻ" readonly />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Ghi chú hướng dẫn sơ chế</label>
                            <textarea name="Notes" class="form-control" rows="3" placeholder="Ví dụ: Cần băm nhuyễn, chú ý nhiệt độ..."></textarea>
                        </div>

                        <!-- Using ProductionDate as per the ViewModel instead of pure "Thời gian" text -->
                        <div class="col-12">
                            <label class="form-label">Thời gian dự kiến / Ngày thực hiện</label>
                            <div class="input-group">
                                <input type="datetime-local" name="ProductionDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                                <span class="input-group-text bg-white"><i class="far fa-clock text-muted"></i></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column (BOM Table) -->
                <div class="col-lg-7 d-flex flex-column po-bom-pane">
                    <div class="po-bom-header">
                        <div class="po-bom-title">Nguyên liệu tiêu hao (BOM)</div>
                        <div class="po-bom-badge">Tính toán tự động theo định mức</div>
                    </div>

                    <div id="readinessSummary" class="po-readiness-summary" aria-live="polite">
                        <span class="po-readiness-state is-neutral">Chưa xem trước</span>
                        <span class="small text-muted">Chọn cửa hàng, BTP và số mẻ để kiểm tra.</span>
                    </div>

                    <div id="outputSummary" class="po-output-summary d-none"></div>

                    <div class="po-table-wrapper flex-grow-1 bg-white">
                        <table class="table po-table">
                            <thead>
                                <tr>
                                    <th>ĐẦU VÀO</th>
                                    <th class="text-end">YÊU CẦU</th>
                                    <th class="text-end">HIỆN CÓ</th>
                                    <th class="text-end">ĐÃ GIỮ</th>
                                    <th class="text-end">KHẢ DỤNG</th>
                                    <th class="text-end">THIẾU</th>
                                    <th>GIÁ VỐN FIFO</th>
                                </tr>
                            </thead>
                            <tbody id="resultTableBody">
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-5">
                                        <i class="fas fa-boxes fa-2x mb-2 text-light"></i><br />
                                        Vui lòng chọn thành phẩm và nhập số lượng
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Footer Actions -->
            <div class="po-actions">
                <button type="button" class="btn btn-ghost" onclick="window.location.reload()">
                    <i class="fas fa-redo-alt me-1"></i> Làm lại form
                </button>
                <div class="d-flex gap-3">
                    <button type="button" class="btn btn-outline-dark">
                        <i class="fas fa-print me-1"></i> In nhãn
                    </button>
                    <button type="button" class="btn btn-primary-action" id="btnComplete" disabled>
                        <i class="fas fa-check-circle me-1"></i> Ghi nhận lệnh sơ chế
                    </button>
                </div>
            </div>
        </div>
    </form>

    <div class="history-section">
        <div class="history-header">
            <h3 class="history-title">Lịch sử lệnh sơ chế gần đây</h3>
            <span class="history-link text-muted small">Chưa áp dụng tồn kho (chờ bước kho)</span>
        </div>
        <div class="history-card">
            <div class="table-responsive">
            <table class="table po-table">
                <thead>
                    <tr>
                        <th>MÃ LỆNH</th>
                        <th>CỬA HÀNG</th>
                        <th>CÔNG THỨC</th>
                        <th>SỐ MẺ</th>
                        <th>NGƯỜI GHI NHẬN</th>
                        <th>XÁC NHẬN</th>
                        <th class="text-center">TRẠNG THÁI</th>
                        <th class="text-center">TỒN KHO</th>
                        <th class="text-center">GIÁ VỐN</th>
                        <th class="text-center">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var history = ViewBag.RecentHistory as IEnumerable<CafeChain.Application.DTOs.Admin.Production.ProductionRunHistoryItemDto>;
                    }
                    @if (history != null && history.Any())
                    {
                        foreach (var hist in history)
                        {
                            <tr>
                                <td class="text-muted fw-bold">#PR-@hist.ProductionRunId</td>
                                <td>@(hist.StoreName ?? hist.StoreId.ToString())</td>
                                <td class="fw-bold">@(hist.RecipeName ?? $"Công thức #{hist.RecipeId}")</td>
                                <td>@hist.RequestedRunCount.ToString("0.#####") mẻ</td>
                                <td>@(hist.ActorName ?? "—")</td>
                                <td class="small">@hist.ConfirmedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-center"><span class="badge-status-done">@hist.Status</span></td>
                                <td class="text-center text-muted small">
                                    @(hist.StockApplied ? "Đã áp dụng vào kho" : "Chưa áp dụng vào kho")
                                    @if (hist.CompletedAt.HasValue)
                                    {
                                        <br /><span class="small">@hist.CompletedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                    }
                                    @if (hist.NormalizedOutputQuantity.HasValue)
                                    {
                                        <br /><span class="small">SL ra: @hist.NormalizedOutputQuantity.Value.ToString("0.###")</span>
                                    }
                                </td>
                                <td class="text-center text-muted small">
                                    <div>@hist.ValuationStatus</div>
                                    @if (hist.TotalInputCost.HasValue)
                                    {
                                        <div>Tổng: @hist.TotalInputCost.Value.ToString("N2")</div>
                                    }
                                    @if (hist.OutputUnitCost.HasValue)
                                    {
                                        <div>/đv: @hist.OutputUnitCost.Value.ToString("N4")</div>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (hist.CanApplyStock && !hist.StockApplied)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary btn-apply-stock rb-table-action"
                                                data-run-id="@hist.ProductionRunId">
                                            <i class="fas fa-boxes-stacked" aria-hidden="true"></i> Áp dụng vào kho
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">Chưa có lệnh sơ chế nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            let previewReady = false;
            let requestKey = (window.crypto && crypto.randomUUID)
                ? crypto.randomUUID()
                : ('xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
                    const r = Math.random() * 16 | 0;
                    const v = c === 'x' ? r : (r & 0x3 | 0x8);
                    return v.toString(16);
                }));

            function newRequestKey() {
                requestKey = (window.crypto && crypto.randomUUID)
                    ? crypto.randomUUID()
                    : ('xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
                        const r = Math.random() * 16 | 0;
                        const v = c === 'x' ? r : (r & 0x3 | 0x8);
                        return v.toString(16);
                    }));
            }

            function antiforgeryHeaders() {
                const token = $('input[name="__RequestVerificationToken"]').val() || '';
                return { 'RequestVerificationToken': token, 'Content-Type': 'application/json' };
            }

            $('#storeSelect').select2({ theme: 'bootstrap-5', placeholder: '-- Chọn cửa hàng --', width: '100%' });
            $('#recipeSelect').select2({ theme: 'bootstrap-5', placeholder: '-- Tìm BTP sơ chế --', width: '100%' });

            function escapeHtml(value) {
                return $('<div>').text(value == null ? '' : String(value)).html();
            }

            function formatQty(value) {
                return Number(value || 0).toLocaleString('vi-VN', { maximumFractionDigits: 4 });
            }

            function formatMoney(value) {
                return Number(value || 0).toLocaleString('vi-VN', { maximumFractionDigits: 0 }) + ' đ';
            }

            function translateReadinessStatus(value, isReady) {
                const labels = {
                    READY: 'Sẵn sàng',
                    BLOCKED: 'Chưa sẵn sàng',
                    INCOMPLETE: 'Chưa đầy đủ',
                    ERROR: 'Có lỗi'
                };
                return labels[String(value || '').toUpperCase()] || (isReady ? 'Sẵn sàng' : 'Chưa sẵn sàng');
            }

            function translateWriterMode(value) {
                const labels = {
                    PreparedItem: 'Bán thành phẩm',
                    LegacyRecipe: 'Công thức cũ'
                };
                return labels[value] || value || 'Chưa xác định';
            }

            function translateSourceType(value) {
                const labels = {
                    Ingredient: 'Nguyên liệu',
                    PreparedItem: 'Bán thành phẩm',
                    ChildRecipe: 'Công thức thành phần'
                };
                return labels[value] || value || 'Chưa xác định';
            }

            function debounce(func, wait) {
                let timeout;
                return function () {
                    const context = this, args = arguments;
                    clearTimeout(timeout);
                    timeout = setTimeout(() => func.apply(context, args), wait);
                };
            }

            $('#recipeSelect').on('change', function() {
                const selected = $(this).find(':selected');
                if(selected.val()) {
                    $('#skuInput').val(selected.data('code') || ('RECIPE-' + selected.val()));
                } else {
                    $('#skuInput').val('');
                }
            });

            const fetchBOM = debounce(function () {
                const recipeId = $('#recipeSelect').val();
                const storeId = parseInt($('#storeSelect').val(), 10) || 0;
                const batches = parseFloat($('#batchInput').val()) || 0;
                const tbody = $('#resultTableBody');
                const btnComplete = $('#btnComplete');
                const readiness = $('#readinessSummary');
                const output = $('#outputSummary');

                previewReady = false;
                output.addClass('d-none').empty();

                if (!storeId || !recipeId || batches <= 0) {
                    tbody.html('<tr><td colspan="7" class="text-center text-muted py-5"><i class="fas fa-boxes fa-2x mb-2 text-light"></i><br/>Vui lòng chọn cửa hàng, BTP và nhập số mẻ</td></tr>');
                    readiness.html('<span class="po-readiness-state is-neutral">Chưa xem trước</span><span class="small text-muted">Thiếu dữ liệu đầu vào.</span>');
                    btnComplete.prop('disabled', true);
                    return;
                }

                tbody.html('<tr><td colspan="7" class="text-center text-muted py-5"><i class="fas fa-spinner fa-spin fa-2x mb-2 text-primary"></i><br/>Đang kiểm tra mức độ sẵn sàng...</td></tr>');
                readiness.html('<span class="po-readiness-state is-neutral">Đang kiểm tra</span>');

                $.getJSON('@Url.Action("CalculateIngredients", "AdminProductionOrder", new { area = "Admin" })',
                    { storeId: storeId, recipeId: recipeId, batches: batches },
                    function (response) {
                        if (!response.success) {
                            tbody.html(`<tr><td colspan="7" class="text-center text-danger py-4">${escapeHtml(response.message)}</td></tr>`);
                            readiness.html(`<span class="po-readiness-state is-error">Không thể xem trước</span><span class="small text-danger">${escapeHtml(response.message)}</span>`);
                            btnComplete.prop('disabled', true);
                            return;
                        }

                        const preview = response.data;
                        tbody.empty();
                        if (!preview.inputs || preview.inputs.length === 0) {
                            tbody.append('<tr><td colspan="7" class="text-center text-muted py-4">Công thức chưa có đầu vào BOM hợp lệ</td></tr>');
                            btnComplete.prop('disabled', true);
                        } else {
                            preview.inputs.forEach(function (item) {
                                const shortageClass = item.shortageQuantity > 0 ? 'text-danger fw-bold' : 'text-success';
                                const costText = item.costEvidenceComplete
                                    ? formatMoney(item.projectedFifoCost)
                                    : `Thiếu lớp giá ${formatQty(item.costEvidenceShortage)} ${escapeHtml(item.baseUnitCode)}`;
                                tbody.append(`
                                    <tr>
                                        <td>
                                            <div class="item-name">[${escapeHtml(item.itemCode)}] ${escapeHtml(item.itemName)}</div>
                                            <div class="small text-muted">${escapeHtml(translateSourceType(item.sourceType))}${item.childRecipeId ? ' · cố định Công thức #' + item.childRecipeId : ''}</div>
                                        </td>
                                        <td class="text-end fw-semibold">${formatQty(item.requiredTotal)} ${escapeHtml(item.baseUnitCode)}</td>
                                        <td class="text-end">${formatQty(item.currentQuantity)}</td>
                                        <td class="text-end">${formatQty(item.reservedQuantity)}</td>
                                        <td class="text-end">${formatQty(item.usableQuantity)}</td>
                                        <td class="text-end ${shortageClass}">${formatQty(item.shortageQuantity)}</td>
                                        <td class="small ${item.costEvidenceComplete ? 'text-success' : 'text-danger'}">${costText}</td>
                                    </tr>
                                `);
                            });
                        }

                        const reasonHtml = (preview.reasons || []).map(function (reason) {
                            return `<li class="${reason.blocking ? 'text-danger' : 'text-warning'}"><code>${escapeHtml(reason.code)}</code> ${escapeHtml(reason.message)}</li>`;
                        }).join('');
                        readiness.html(`
                            <span class="po-readiness-state ${preview.isReady ? 'is-ready' : 'is-error'}">${escapeHtml(translateReadinessStatus(preview.overallStatus, preview.isReady))}</span>
                            <span class="small">Chế độ ghi kho: <strong>${escapeHtml(translateWriterMode(preview.writerMode))}</strong> · Tối đa ${formatQty(preview.maxSupportedRunCount)} mẻ</span>
                            ${reasonHtml ? '<ul class="po-readiness-reasons">' + reasonHtml + '</ul>' : ''}
                        `);
                        output.removeClass('d-none').html(`
                            <div><span>Đầu ra/mẻ</span><strong>${formatQty(preview.outputQuantityPerRun)} ${escapeHtml(preview.outputUnitCode)}</strong></div>
                            <div><span>Tổng đầu ra chưa chuẩn hóa</span><strong>${formatQty(preview.rawTotalOutput)} ${escapeHtml(preview.outputUnitCode)}</strong></div>
                            <div><span>Đầu ra tổng chuẩn hóa</span><strong>${formatQty(preview.normalizedTotalOutput)} ${escapeHtml(preview.outputBaseUnitCode)}</strong></div>
                            <div><span>Giá vốn BOM ước tính</span><strong>${preview.estimatedBomCostComplete ? formatMoney(preview.estimatedBomCostTotal) : 'Chưa đầy đủ'}</strong></div>
                            <div><span>FIFO dự kiến trước khi hoàn tất</span><strong>${preview.costEvidenceComplete ? formatMoney(preview.projectedFifoInputCost) : 'Thiếu bằng chứng'}</strong></div>
                        `);
                        previewReady = preview.isReady === true;
                        btnComplete.prop('disabled', !previewReady);
                    }
                ).fail(function () {
                    tbody.html('<tr><td colspan="7" class="text-center text-danger py-4">Lỗi kết nối máy chủ. Không thể tải mức độ sẵn sàng.</td></tr>');
                    readiness.html('<span class="po-readiness-state is-error">Lỗi kết nối</span>');
                    btnComplete.prop('disabled', true);
                });
            }, 400);

            $('#storeSelect').on('change', fetchBOM);
            $('#recipeSelect').on('change', fetchBOM);
            $('#batchInput').on('input', fetchBOM);

            if ($('#recipeSelect').val()) { fetchBOM(); }

            // Issue #120 — apply stock for CONFIRMED runs (backend validates mode/capability)
            $(document).on('click', '.btn-apply-stock', function () {
                const runId = parseInt($(this).data('run-id'), 10);
                const btn = $(this);
                if (!runId) return;

                Swal.fire({
                    icon: 'question',
                    title: 'Áp dụng vào kho?',
                    html: '<p>Hệ thống sẽ <b>trừ nguyên liệu / BTP đầu vào</b> và <b>cộng bán thành phẩm đầu ra</b> theo công thức đã ghi nhận.</p>',
                    showCancelButton: true,
                    confirmButtonText: 'Áp dụng',
                    cancelButtonText: 'Hủy',
                    confirmButtonColor: '#ea580c'
                }).then((result) => {
                    if (!result.isConfirmed) return;
                    btn.prop('disabled', true).text('Đang xử lý...');
                    $.ajax({
                        url: '@Url.Action("ExecuteStock", "AdminProductionOrder", new { area = "Admin" })',
                        type: 'POST',
                        headers: antiforgeryHeaders(),
                        data: JSON.stringify({ productionRunId: runId }),
                        success: function (res) {
                            if (res.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: res.wasReplay ? 'Đã áp dụng (replay)' : 'Đã áp dụng vào kho',
                                    text: res.message || 'Tồn kho đã được cập nhật.',
                                    confirmButtonColor: '#10b981'
                                }).then(() => window.location.reload());
                            } else {
                                btn.prop('disabled', false).text('Áp dụng vào kho');
                                let errTitle = 'Thất bại';
                                const code = res.errorCode || '';
                                if (code === 'MODE_LEGACY' || (res.message || '').indexOf('LegacyRecipe') >= 0)
                                    errTitle = 'Chưa chuyển đổi kho BTP';
                                if (code === 'MODE_BLOCKED' || code === 'BTP_WRITER_BLOCKED')
                                    errTitle = 'Kho BTP đang khóa';
                                if (code === 'PRODUCTION_COST_EVIDENCE_INCOMPLETE')
                                    errTitle = 'Thiếu bằng chứng giá vốn';
                                let html = res.message || 'Không áp dụng được kho.';
                                if (code === 'PRODUCTION_COST_EVIDENCE_INCOMPLETE') {
                                    html = '<p>Không thể hoàn tất lệnh sơ chế vì tồn kho đầu vào chưa có đủ bằng chứng giá vốn.</p>';
                                    if (res.costEvidenceGaps && res.costEvidenceGaps.length) {
                                        html += '<ul style="text-align:left">';
                                        res.costEvidenceGaps.forEach(function (g) {
                                            html += '<li><b>' + (g.inputCode || '') + ' ' + (g.inputName || '') + '</b>: cần '
                                                + g.requiredQuantity + ', lớp giá hiện có ' + g.availableLayerQuantity
                                                + ', thiếu ' + g.missingQuantity + '</li>';
                                        });
                                        html += '</ul>';
                                    }
                                }
                                Swal.fire({
                                    icon: 'error',
                                    title: errTitle,
                                    html: html,
                                    confirmButtonColor: '#ef4444'
                                });
                            }
                        },
                        error: function () {
                            btn.prop('disabled', false).text('Áp dụng vào kho');
                            Swal.fire({ icon: 'error', title: 'Lỗi mạng', text: 'Không kết nối được với máy chủ.', confirmButtonColor: '#ef4444' });
                        }
                    });
                });
            });

            // Issue #119 — confirm durable intent only
            let lastPayloadSignature = null;

            function payloadSignature(storeId, recipeId, runCount, notes) {
                return [storeId, recipeId, String(runCount), (notes || '').trim()].join('|');
            }

            $('#btnComplete').click(function (e) {
                e.preventDefault();
                const storeId = parseInt($('#storeSelect').val(), 10) || 0;
                const recipeId = parseInt($('#recipeSelect').val(), 10) || 0;
                const runCount = parseFloat($('#batchInput').val());
                const notes = $('textarea[name="Notes"]').val();

                if (!previewReady) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Chưa sẵn sàng',
                        text: 'Vui lòng xử lý các nguyên nhân chưa sẵn sàng trước khi ghi nhận lệnh.',
                        confirmButtonColor: '#ea580c'
                    });
                    return;
                }

                if (!storeId || !recipeId || !(runCount > 0) || runCount > 9999 || Number.isNaN(runCount)) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Số mẻ không hợp lệ',
                        text: 'Số mẻ nấu phải > 0 và ≤ 9999 (hỗ trợ số thập phân).',
                        confirmButtonColor: '#ea580c'
                    });
                    return;
                }

                const sig = payloadSignature(storeId, recipeId, runCount, notes);
                if (lastPayloadSignature !== null && lastPayloadSignature !== sig) {
                    newRequestKey();
                }
                lastPayloadSignature = sig;

                Swal.fire({
                    icon: 'question',
                    title: 'Ghi nhận lệnh sơ chế?',
                    html: '<p>Hệ thống sẽ <b>ghi nhận lệnh</b> (idempotent).<br/>Tồn kho <b>chưa được cập nhật</b> ở bước này.</p>',
                    showCancelButton: true,
                    confirmButtonText: '<i class="fas fa-check me-1"></i> Xác nhận',
                    cancelButtonText: 'Hủy',
                    confirmButtonColor: '#ea580c',
                }).then((result) => {
                    if (!result.isConfirmed) return;

                    const btn = $('#btnComplete');
                    btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i>Đang xử lý...');

                    $.ajax({
                        url: '@Url.Action("Execute", "AdminProductionOrder", new { area = "Admin" })',
                        type: 'POST',
                        headers: antiforgeryHeaders(),
                        data: JSON.stringify({
                            requestKey: requestKey,
                            storeId: storeId,
                            recipeId: recipeId,
                            requestedRunCount: runCount,
                            notes: notes
                        }),
                        success: function(res) {
                            const label = '<i class="fas fa-check-circle me-1"></i> Ghi nhận lệnh sơ chế';
                            if (res.success) {
                                newRequestKey();
                                lastPayloadSignature = null;
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Đã ghi nhận',
                                    text: res.message || 'Lệnh sơ chế đã được ghi nhận. Tồn kho chưa được cập nhật.',
                                    confirmButtonColor: '#10b981'
                                }).then(() => window.location.reload());
                            } else {
                                btn.prop('disabled', false).html(label);
                                // #131 — surface structured writer-mode messages from server
                                let errTitle = 'Thất bại!';
                                const code = res.errorCode || '';
                                if (code === 'BTP_WRITER_LEGACY') errTitle = 'Chưa chuyển đổi kho BTP';
                                if (code === 'BTP_WRITER_BLOCKED') errTitle = 'Kho BTP đang khóa';
                                Swal.fire({
                                    icon: 'error',
                                    title: errTitle,
                                    text: res.message || 'Không ghi nhận được lệnh.',
                                    confirmButtonColor: '#ef4444'
                                });
                            }
                        },
                        error: function() {
                            // Keep same requestKey for retry after network loss
                            btn.prop('disabled', false).html('<i class="fas fa-check-circle me-1"></i> Ghi nhận lệnh sơ chế');
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi mạng',
                                text: 'Không kết nối được với máy chủ. Bạn có thể thử lại với cùng mã yêu cầu.',
                                confirmButtonColor: '#ef4444'
                            });
                        }
                    });
                });
            });
        });
    </script>
}
