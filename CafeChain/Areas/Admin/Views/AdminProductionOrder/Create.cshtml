@model CafeChain.ViewModels.Admin.Productions.ProductionOrderVM

@{
    ViewData["Title"] = "Lệnh Sơ Chế";
}

<link rel="stylesheet" href="~/css/production-order.css" />

<div class="container-fluid px-4 mt-4">
    <div class="po-title-section">
        <h1 class="po-title">LỆNH SƠ CHẾ</h1>
        <p class="po-subtitle">Quản lý định lượng và quy trình sơ chế thực phẩm hàng ngày.</p>
    </div>

    <form asp-action="Create" method="post" id="productionForm">
        @Html.AntiForgeryToken()

        <div class="po-main-card">
            <div class="row g-5">
                <!-- Left Column -->
                <div class="col-lg-5">
                    <div class="po-section-title">
                        <i class="fas fa-fire-burner"></i> Thông tin sơ chế chi tiết
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Tên thành phẩm sơ chế <span class="text-danger">*</span></label>
                            <select name="TargetRecipeId" id="recipeSelect" class="form-select" required>
                                <option value="">-- Chọn thành phẩm --</option>
                                @if (ViewBag.SubRecipes != null)
                                {
                                    foreach (dynamic rec in ViewBag.SubRecipes)
                                    {
                                        <option value="@rec.RecipeId">@rec.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Mã SKU dự kiến</label>
                            <input type="text" id="skuInput" class="form-control" readonly placeholder="Tự động tạo..." />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Số lượng mẻ <span class="text-danger">*</span></label>
                            <input type="number" step="any" min="0.00001" max="9999" name="PlannedBatches" id="batchInput"
                                   class="form-control fw-bold text-center" value="1" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Đơn vị</label>
                            <input type="text" class="form-control" value="mẻ" readonly />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Ghi chú hướng dẫn sơ chế</label>
                            <textarea name="Notes" class="form-control" rows="3" placeholder="Ví dụ: Cần băm nhuyễn, chú ý nhiệt độ..."></textarea>
                        </div>

                        <!-- Using ProductionDate as per the ViewModel instead of pure "Thời gian" text -->
                        <div class="col-12">
                            <label class="form-label">Thời gian dự kiến / Ngày thực hiện</label>
                            <div class="input-group">
                                <input type="datetime-local" name="ProductionDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                                <span class="input-group-text bg-white"><i class="far fa-clock text-muted"></i></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column (BOM Table) -->
                <div class="col-lg-7 d-flex flex-column">
                    <div class="po-bom-header">
                        <div class="po-bom-title">Nguyên liệu tiêu hao (BOM)</div>
                        <div class="po-bom-badge">Tính toán tự động theo định mức</div>
                    </div>

                    <div class="po-table-wrapper flex-grow-1 bg-white">
                        <table class="table po-table">
                            <thead>
                                <tr>
                                    <th width="45%">NGUYÊN LIỆU</th>
                                    <th width="20%" class="text-center">TỒN KHO</th>
                                    <th width="20%" class="text-center">YÊU CẦU</th>
                                    <th width="15%" class="text-center">ĐƠN VỊ</th>
                                </tr>
                            </thead>
                            <tbody id="resultTableBody">
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-5">
                                        <i class="fas fa-boxes fa-2x mb-2 text-light"></i><br />
                                        Vui lòng chọn thành phẩm và nhập số lượng
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Footer Actions -->
            <div class="po-actions">
                <button type="button" class="btn btn-ghost" onclick="window.location.reload()">
                    <i class="fas fa-redo-alt me-1"></i> Làm lại form
                </button>
                <div class="d-flex gap-3">
                    <button type="button" class="btn btn-outline-dark">
                        <i class="fas fa-print me-1"></i> In nhãn
                    </button>
                    <button type="button" class="btn btn-primary-action" id="btnComplete" disabled>
                        <i class="fas fa-check-circle me-1"></i> Ghi nhận lệnh sơ chế
                    </button>
                </div>
            </div>
        </div>
    </form>

    <div class="history-section">
        <div class="history-header">
            <h3 class="history-title">Lịch sử lệnh sơ chế gần đây</h3>
            <span class="history-link text-muted small">Chưa áp dụng tồn kho (chờ bước kho)</span>
        </div>
        <div class="history-card">
            <table class="table po-table">
                <thead>
                    <tr>
                        <th>MÃ LỆNH</th>
                        <th>CỬA HÀNG</th>
                        <th>CÔNG THỨC</th>
                        <th>SỐ MẺ</th>
                        <th>NGƯỜI GHI NHẬN</th>
                        <th>XÁC NHẬN</th>
                        <th class="text-center">TRẠNG THÁI</th>
                        <th class="text-center">TỒN KHO</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var history = ViewBag.RecentHistory as IEnumerable<CafeChain.Application.DTOs.Admin.Production.ProductionRunHistoryItemDto>;
                    }
                    @if (history != null && history.Any())
                    {
                        foreach (var hist in history)
                        {
                            <tr>
                                <td class="text-muted fw-bold">#PR-@hist.ProductionRunId</td>
                                <td>@(hist.StoreName ?? hist.StoreId.ToString())</td>
                                <td class="fw-bold">@(hist.RecipeName ?? $"Recipe #{hist.RecipeId}")</td>
                                <td>@hist.RequestedRunCount.ToString("0.#####") mẻ</td>
                                <td>@(hist.ActorName ?? "—")</td>
                                <td class="small">@hist.ConfirmedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-center"><span class="badge-status-done">@hist.Status</span></td>
                                <td class="text-center text-muted small">Chưa áp dụng vào kho</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">Chưa có lệnh sơ chế nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            const defaultStoreId = @(ViewBag.DefaultStoreId ?? 0);
            let requestKey = (window.crypto && crypto.randomUUID)
                ? crypto.randomUUID()
                : ('xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
                    const r = Math.random() * 16 | 0;
                    const v = c === 'x' ? r : (r & 0x3 | 0x8);
                    return v.toString(16);
                }));

            function newRequestKey() {
                requestKey = (window.crypto && crypto.randomUUID)
                    ? crypto.randomUUID()
                    : ('xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
                        const r = Math.random() * 16 | 0;
                        const v = c === 'x' ? r : (r & 0x3 | 0x8);
                        return v.toString(16);
                    }));
            }

            function antiforgeryHeaders() {
                const token = $('input[name="__RequestVerificationToken"]').val() || '';
                return { 'RequestVerificationToken': token, 'Content-Type': 'application/json' };
            }

            $('#recipeSelect').select2({ theme: 'bootstrap-5', placeholder: '-- Tìm công thức sơ chế --', width: '100%' });

            function debounce(func, wait) {
                let timeout;
                return function () {
                    const context = this, args = arguments;
                    clearTimeout(timeout);
                    timeout = setTimeout(() => func.apply(context, args), wait);
                };
            }

            $('#recipeSelect').on('change', function() {
                const recipeId = $(this).val();
                if(recipeId) {
                    $('#skuInput').val('SKU-PREP-' + recipeId.padStart(4, '0'));
                } else {
                    $('#skuInput').val('');
                }
            });

            const fetchBOM = debounce(function () {
                const recipeId = $('#recipeSelect').val();
                const batches = parseFloat($('#batchInput').val()) || 0;
                const tbody = $('#resultTableBody');
                const btnComplete = $('#btnComplete');

                if (!recipeId || batches <= 0) {
                    tbody.html('<tr><td colspan="4" class="text-center text-muted py-5"><i class="fas fa-boxes fa-2x mb-2 text-light"></i><br/>Vui lòng chọn thành phẩm và nhập số lượng</td></tr>');
                    btnComplete.prop('disabled', true);
                    return;
                }

                tbody.html('<tr><td colspan="4" class="text-center text-muted py-5"><i class="fas fa-spinner fa-spin fa-2x mb-2 text-primary"></i><br/>Đang tính toán BOM...</td></tr>');

                $.getJSON('@Url.Action("CalculateIngredients", "AdminProductionOrder", new { area = "Admin" })',
                    { recipeId: recipeId, batches: batches },
                    function (response) {
                        if (!response.success) {
                            tbody.html(`<tr><td colspan="4" class="text-center text-danger py-4">${response.message}</td></tr>`);
                            btnComplete.prop('disabled', true);
                            return;
                        }

                        tbody.empty();

                        if (response.data.length === 0) {
                            tbody.append('<tr><td colspan="4" class="text-center text-muted py-4">Công thức chưa có chi tiết BOM</td></tr>');
                            btnComplete.prop('disabled', true);
                        } else {
                            response.data.forEach(function (item) {
                                const reqClass = item.actualQuantity > 10 ? 'req-val exceeds' : 'req-val';
                                const stockVisual = '---';

                                tbody.append(`
                                    <tr>
                                        <td class="item-name">${item.itemName}</td>
                                        <td class="text-center stock-val">${stockVisual}</td>
                                        <td class="text-center ${reqClass}">${item.actualQuantity}</td>
                                        <td class="text-center text-muted">${item.unitName}</td>
                                    </tr>
                                `);
                            });
                            btnComplete.prop('disabled', false);
                        }
                    }
                ).fail(function () {
                    tbody.html('<tr><td colspan="4" class="text-center text-danger py-4">Lỗi kết nối Server. Không thể tải BOM.</td></tr>');
                    btnComplete.prop('disabled', true);
                });
            }, 400);

            $('#recipeSelect').on('change', fetchBOM);
            $('#batchInput').on('input', fetchBOM);

            if ($('#recipeSelect').val()) { fetchBOM(); }

            // Issue #119 — confirm durable intent only (no stock write until #120)
            let lastPayloadSignature = null;

            function payloadSignature(recipeId, runCount, notes) {
                return [recipeId, String(runCount), (notes || '').trim()].join('|');
            }

            $('#btnComplete').click(function (e) {
                e.preventDefault();
                const recipeId = parseInt($('#recipeSelect').val(), 10) || 0;
                const runCount = parseFloat($('#batchInput').val());
                const notes = $('textarea[name="Notes"]').val();

                if (!recipeId || !(runCount > 0) || runCount > 9999 || Number.isNaN(runCount)) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Số mẻ không hợp lệ',
                        text: 'Số mẻ nấu phải > 0 và ≤ 9999 (hỗ trợ số thập phân).',
                        confirmButtonColor: '#ea580c'
                    });
                    return;
                }

                const sig = payloadSignature(recipeId, runCount, notes);
                if (lastPayloadSignature !== null && lastPayloadSignature !== sig) {
                    newRequestKey();
                }
                lastPayloadSignature = sig;

                Swal.fire({
                    icon: 'question',
                    title: 'Ghi nhận lệnh sơ chế?',
                    html: '<p>Hệ thống sẽ <b>ghi nhận lệnh</b> (idempotent).<br/>Tồn kho <b>chưa được cập nhật</b> ở bước này.</p>',
                    showCancelButton: true,
                    confirmButtonText: '<i class="fas fa-check me-1"></i> Xác nhận',
                    cancelButtonText: 'Hủy',
                    confirmButtonColor: '#ea580c',
                }).then((result) => {
                    if (!result.isConfirmed) return;

                    const btn = $('#btnComplete');
                    btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i>Đang xử lý...');

                    $.ajax({
                        url: '@Url.Action("Execute", "AdminProductionOrder", new { area = "Admin" })',
                        type: 'POST',
                        headers: antiforgeryHeaders(),
                        data: JSON.stringify({
                            requestKey: requestKey,
                            storeId: defaultStoreId > 0 ? defaultStoreId : null,
                            recipeId: recipeId,
                            requestedRunCount: runCount,
                            notes: notes
                        }),
                        success: function(res) {
                            const label = '<i class="fas fa-check-circle me-1"></i> Ghi nhận lệnh sơ chế';
                            if (res.success) {
                                newRequestKey();
                                lastPayloadSignature = null;
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Đã ghi nhận',
                                    text: res.message || 'Lệnh sơ chế đã được ghi nhận. Tồn kho chưa được cập nhật.',
                                    confirmButtonColor: '#10b981'
                                }).then(() => window.location.reload());
                            } else {
                                btn.prop('disabled', false).html(label);
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Thất bại!',
                                    text: res.message || 'Không ghi nhận được lệnh.',
                                    confirmButtonColor: '#ef4444'
                                });
                            }
                        },
                        error: function() {
                            // Keep same requestKey for retry after network loss
                            btn.prop('disabled', false).html('<i class="fas fa-check-circle me-1"></i> Ghi nhận lệnh sơ chế');
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi mạng',
                                text: 'Không kết nối được với server. Bạn có thể thử lại với cùng RequestKey.',
                                confirmButtonColor: '#ef4444'
                            });
                        }
                    });
                });
            });
        });
    </script>
}
