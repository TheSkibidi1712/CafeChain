@model CafeChain.ViewModels.Admin.Productions.ProductionOrderVM
@using CafeChain.ViewModels.Admin.Shared
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ProductionResource> ProductionText

@{
    ViewData["Title"] = ProductionText["Create.Title"];
    var hero = new AdminPageHeroVM
    {
        Eyebrow = ProductionText["Create.Breadcrumb"],
        Title = ProductionText["Create.Title"],
        Description = ProductionText["Create.Description"],
        IconClass = "fas fa-fire-burner",
        Breadcrumbs =
        [
            new() { Label = ProductionText["ProductionOrder.Title"], Url = Url.Action("Index", new { storeId = Model.StoreId }) },
            new() { Label = ProductionText["Create.Title"] }
        ],
        Actions =
        [
            new()
            {
                Label = ProductionText["Create.BackToList"],
                Url = Url.Action("Index", new { storeId = Model.StoreId }) ?? "#",
                IconClass = "fas fa-arrow-left"
            }
        ]
    };
}

<link rel="stylesheet" href="~/css/Admin/ProductionOrder/production-order.css" />
<link rel="stylesheet" href="~/css/Admin/production-bom-ui.css" asp-append-version="true" />

<div class="po-page production-bom-page production-bom-shell production-create-page">
    <partial name="_PageHero" model="hero" />

    <form asp-action="Create" method="post" id="productionForm">
        @Html.AntiForgeryToken()

        <section class="po-main-card production-form-section">
            <div class="production-operation-grid">
                <!-- Left Column -->
                <div class="po-form-pane production-operation-form">
                    <h2 class="po-section-title">
                        <i class="fas fa-fire-burner"></i> @ProductionText["Create.DetailsTitle"]
                    </h2>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label" asp-for="StoreId">@ProductionText["Common.Store"] <span class="text-danger">*</span></label>
                            <select asp-for="StoreId" id="storeSelect" class="form-select" required>
                                <option value="">@ProductionText["Create.SelectStore"]</option>
                                @foreach (var store in Model.Stores)
                                {
                                    <option value="@store.StoreId">@store.StoreName</option>
                                }
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label">@ProductionText["Create.PreparedItemName"] <span class="text-danger">*</span></label>
                            <select asp-for="TargetRecipeId" id="recipeSelect" class="form-select" required>
                                <option value="">@ProductionText["Create.SelectPreparedItem"]</option>
                                @foreach (var recipe in Model.RecipeOptions)
                                {
                                    <option value="@recipe.RecipeId"
                                            disabled="@(!recipe.Selectable ? "disabled" : null)"
                                            data-code="@recipe.RecipeCode"
                                            data-disabled-reason="@recipe.DisabledReason">
                                        [@recipe.PreparedItemCode] @recipe.PreparedItemName · @ProductionText["Create.OutputAtFactorOne", recipe.OutputPerRunDisplay]
                                        @if (!recipe.Selectable)
                                        {
                                            <text> · @recipe.DisabledReason</text>
                                        }
                                    </option>
                                }
                            </select>
                            <div class="form-text">@ProductionText["Create.RecipeHelp"]</div>
                        </div>

                        <div class="col-12">
                            <label class="form-label">@ProductionText["Create.ExpectedSku"]</label>
                            <input type="text" id="skuInput" class="form-control production-readonly-field" readonly placeholder="@ProductionText["Create.AutoGenerated"]" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="batchInput">@ProductionText["Create.RecipeFactor"] <span class="text-danger">*</span></label>
                            <input type="number" step="any" min="0.00001" max="9999" name="PlannedBatches" id="batchInput"
                                   class="form-control fw-bold text-center" value="1" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="scaleMeaning">@ProductionText["Create.Meaning"]</label>
                            <input id="scaleMeaning" type="text" class="form-control production-readonly-field" value="@ProductionText["Create.ScaleMeaning"]" readonly />
                        </div>

                        <div class="col-12">
                            <label class="form-label">@ProductionText["Create.Notes"]</label>
                            <textarea name="Notes" class="form-control" rows="3" placeholder="@ProductionText["Create.NotesPlaceholder"]"></textarea>
                        </div>

                        <!-- Use the view model production date as the technical payload value. -->
                        <div class="col-12">
                            <label class="form-label">@ProductionText["Create.ScheduledAt"]</label>
                            <div class="input-group">
                                <input type="datetime-local" name="ProductionDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                                <span class="input-group-text bg-white"><i class="far fa-clock text-muted"></i></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column (BOM Table) -->
                <div class="d-flex flex-column po-bom-pane production-operation-preview">
                    <div class="po-bom-header">
                        <div class="po-bom-title">@ProductionText["Create.BomTitle"]</div>
                        <div class="po-bom-badge">@ProductionText["Create.AutoCalculated"]</div>
                    </div>

                    <div id="readinessSummary" class="po-readiness-summary" aria-live="polite">
                        <span class="po-readiness-state is-neutral">@ProductionText["Create.NotPreviewed"]</span>
                        <span class="small text-muted">@ProductionText["Create.PreviewHelp"]</span>
                    </div>

                    <div id="outputSummary" class="po-output-summary d-none"></div>

                    <div class="po-table-wrapper flex-grow-1 bg-white">
                        <table class="table po-table">
                            <thead>
                                <tr>
                                    <th>@ProductionText["Create.Column.Input"]</th>
                                    <th class="text-end">@ProductionText["Create.Column.Required"]</th>
                                    <th class="text-end">@ProductionText["Create.Column.OnHand"]</th>
                                    <th class="text-end">@ProductionText["Create.Column.Reserved"]</th>
                                    <th class="text-end">@ProductionText["Create.Column.Available"]</th>
                                    <th class="text-end">@ProductionText["Create.Column.Shortage"]</th>
                                    <th>@ProductionText["Create.Column.FifoCost"]</th>
                                </tr>
                            </thead>
                            <tbody id="resultTableBody">
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-5">
                                        <i class="fas fa-boxes fa-2x mb-2 text-light"></i><br />
                                        @ProductionText["Create.SelectPrompt"]
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Footer Actions -->
            <div class="po-actions">
                <button type="button" class="btn btn-ghost" onclick="window.location.reload()">
                    <i class="fas fa-redo-alt me-1"></i> @ProductionText["Create.ResetForm"]
                </button>
                <div class="d-flex gap-3">
                    <button type="button" class="btn btn-outline-dark">
                        <i class="fas fa-print me-1"></i> @ProductionText["Create.PrintLabel"]
                    </button>
                    <button type="button" class="btn btn-primary-action" id="btnComplete" disabled>
                        <i class="fas fa-check-circle me-1"></i> @ProductionText["Create.RecordOrder"]
                    </button>
                </div>
            </div>
        </section>
    </form>

    <section class="production-list-section" aria-labelledby="standalone-history-title">
        <header class="production-section-header">
            <div>
                <h2 id="standalone-history-title">@ProductionText["Create.History.Title"]</h2>
                <p>@ProductionText["Create.History.Description"]</p>
            </div>
        </header>
        <div class="history-card production-table-panel p-0">
            <div class="table-responsive">
            <table class="table po-table production-data-table mb-0">
                <thead>
                    <tr>
                        <th>@ProductionText["Create.Column.Code"]</th><th>@ProductionText["Common.Store"]</th><th>@ProductionText["Create.Column.Recipe"]</th>
                        <th>@ProductionText["Create.RecipeFactor"]</th><th>@ProductionText["Create.Column.RecordedBy"]</th><th>@ProductionText["Create.Column.ConfirmedAt"]</th>
                        <th>@ProductionText["Common.Status"]</th><th>@ProductionText["Create.Column.Inventory"]</th><th>@ProductionText["Create.Column.Cost"]</th><th class="production-action-column">@ProductionText["Common.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var history = ViewBag.RecentHistory as IEnumerable<CafeChain.Application.DTOs.Admin.Production.ProductionRunHistoryItemDto>;
                    }
                    @if (history != null && history.Any())
                    {
                        foreach (var hist in history)
                        {
                            <tr>
                                <td class="text-muted fw-bold">#PR-@hist.ProductionRunId</td>
                                <td>@(hist.StoreName ?? hist.StoreId.ToString())</td>
                                <td class="fw-bold">@(hist.RecipeName ?? ProductionText["Create.UnnamedRecipe"])</td>
                                <td>@ProductionText["ProductionOrder.RunFactor", hist.RequestedRunCount.ToString("0.#####")]</td>
                                <td>@(hist.ActorName ?? "—")</td>
                                <td class="small">@hist.ConfirmedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-center"><span class="badge-status-done">@hist.Status</span></td>
                                <td class="text-center text-muted small">
                                    @(hist.StockApplied ? ProductionText["Create.StockApplied"] : ProductionText["Create.StockNotApplied"])
                                    @if (hist.CompletedAt.HasValue)
                                    {
                                        <br /><span class="small">@hist.CompletedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                    }
                                    @if (hist.NormalizedOutputQuantity.HasValue)
                                    {
                                        <br /><span class="small">@ProductionText["Create.OutputQuantity", hist.NormalizedOutputQuantity.Value.ToString("0.###")]</span>
                                    }
                                </td>
                                <td class="text-center text-muted small">
                                    <div>@(string.Equals(hist.ValuationStatus, "Complete", StringComparison.OrdinalIgnoreCase) ? ProductionText["Create.CostComplete"] : ProductionText["Create.CostPending"])</div>
                                    @if (hist.TotalInputCost.HasValue)
                                    {
                                        <div>@ProductionText["Create.TotalCost", hist.TotalInputCost.Value.ToString("N2")]</div>
                                    }
                                    @if (hist.OutputUnitCost.HasValue)
                                    {
                                        <div>@ProductionText["Create.UnitCost", hist.OutputUnitCost.Value.ToString("N4")]</div>
                                    }
                                </td>
                                <td class="production-action-column">
                                    @if (hist.CanApplyStock && !hist.StockApplied)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary btn-apply-stock rb-table-action"
                                                data-run-id="@hist.ProductionRunId">
                                            <i class="fas fa-boxes-stacked" aria-hidden="true"></i> @ProductionText["Create.ApplyStock"]
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">@ProductionText["Create.EmptyHistory"]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        </div>
    </section>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <partial name="_ProductionCreateUiCatalog" />
    <script>
        $(document).ready(function () {
            const catalog = window.CafeChainUiCatalog.read('productionCreateUiCatalog');
            const t = (key, values) => window.CafeChainUiCatalog.text(catalog, key, values);
            let previewReady = false;
            let requestKey = (window.crypto && crypto.randomUUID)
                ? crypto.randomUUID()
                : ('xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
                    const r = Math.random() * 16 | 0;
                    const v = c === 'x' ? r : (r & 0x3 | 0x8);
                    return v.toString(16);
                }));

            function newRequestKey() {
                requestKey = (window.crypto && crypto.randomUUID)
                    ? crypto.randomUUID()
                    : ('xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
                        const r = Math.random() * 16 | 0;
                        const v = c === 'x' ? r : (r & 0x3 | 0x8);
                        return v.toString(16);
                    }));
            }

            function antiforgeryHeaders() {
                const token = $('input[name="__RequestVerificationToken"]').val() || '';
                return { 'RequestVerificationToken': token, 'Content-Type': 'application/json' };
            }

            $('#storeSelect').select2({ theme: 'bootstrap-5', placeholder: t('Create.SelectStore'), width: '100%' });
            $('#recipeSelect').select2({ theme: 'bootstrap-5', placeholder: t('Create.Js.SearchPreparedItem'), width: '100%' });

            function escapeHtml(value) {
                return $('<div>').text(value == null ? '' : String(value)).html();
            }

            function formatQty(value) {
                return Number(value || 0).toLocaleString('vi-VN', { maximumFractionDigits: 4 });
            }

            function formatMoney(value) {
                return new Intl.NumberFormat(document.documentElement.dataset.culture || 'vi-VN', { style: 'currency', currency: 'VND', maximumFractionDigits: 0 }).format(Number(value || 0));
            }

            function translateReadinessStatus(value, isReady) {
                const labels = {
                    READY: t('Create.Js.Ready'), BLOCKED: t('Create.Js.Blocked'),
                    INCOMPLETE: t('Create.Js.Incomplete'), ERROR: t('Create.Js.Error')
                };
                return labels[String(value || '').toUpperCase()] || (isReady ? t('Create.Js.Ready') : t('Create.Js.Blocked'));
            }

            function translateSourceType(value) {
                const labels = {
                    Ingredient: t('Create.Js.Ingredient'), PreparedItem: t('Create.Js.PreparedItem'),
                    ChildRecipe: t('Create.Js.ChildRecipe')
                };
                return labels[value] || t('Create.Js.Unknown');
            }

            function debounce(func, wait) {
                let timeout;
                return function () {
                    const context = this, args = arguments;
                    clearTimeout(timeout);
                    timeout = setTimeout(() => func.apply(context, args), wait);
                };
            }

            $('#recipeSelect').on('change', function() {
                const selected = $(this).find(':selected');
                if(selected.val()) {
                    $('#skuInput').val(selected.data('code') || ('RECIPE-' + selected.val()));
                } else {
                    $('#skuInput').val('');
                }
            });

            const fetchBOM = debounce(function () {
                const recipeId = $('#recipeSelect').val();
                const storeId = parseInt($('#storeSelect').val(), 10) || 0;
                const batches = parseFloat($('#batchInput').val()) || 0;
                const tbody = $('#resultTableBody');
                const btnComplete = $('#btnComplete');
                const readiness = $('#readinessSummary');
                const output = $('#outputSummary');

                previewReady = false;
                output.addClass('d-none').empty();

                if (!storeId || !recipeId || batches <= 0) {
                    tbody.html(`<tr><td colspan="7" class="text-center text-muted py-5"><i class="fas fa-boxes fa-2x mb-2 text-light"></i><br/>${escapeHtml(t('Create.PreviewHelp'))}</td></tr>`);
                    readiness.html(`<span class="po-readiness-state is-neutral">${escapeHtml(t('Create.NotPreviewed'))}</span><span class="small text-muted">${escapeHtml(t('Create.Js.MissingInput'))}</span>`);
                    btnComplete.prop('disabled', true);
                    return;
                }

                tbody.html(`<tr><td colspan="7" class="text-center text-muted py-5"><i class="fas fa-spinner fa-spin fa-2x mb-2 text-primary"></i><br/>${escapeHtml(t('Create.Js.Checking'))}</td></tr>`);
                readiness.html(`<span class="po-readiness-state is-neutral">${escapeHtml(t('Create.Js.Checking'))}</span>`);

                $.getJSON('@Url.Action("CalculateIngredients", "AdminProductionOrder", new { area = "Admin" })',
                    { storeId: storeId, recipeId: recipeId, batches: batches },
                    function (response) {
                        if (!response.success) {
                            tbody.html(`<tr><td colspan="7" class="text-center text-danger py-4">${escapeHtml(response.message)}</td></tr>`);
                            readiness.html(`<span class="po-readiness-state is-error">${escapeHtml(t('Create.Js.CannotPreview'))}</span><span class="small text-danger">${escapeHtml(response.message)}</span>`);
                            btnComplete.prop('disabled', true);
                            return;
                        }

                        const preview = response.data;
                        tbody.empty();
                        if (!preview.inputs || preview.inputs.length === 0) {
                            tbody.append(`<tr><td colspan="7" class="text-center text-muted py-4">${escapeHtml(t('Create.Js.NoBomInputs'))}</td></tr>`);
                            btnComplete.prop('disabled', true);
                        } else {
                            preview.inputs.forEach(function (item) {
                                const shortageClass = item.shortageQuantity > 0 ? 'text-danger fw-bold' : 'text-success';
                                const costText = item.costEvidenceComplete
                                    ? formatMoney(item.projectedFifoCost)
                                    : t('Create.Js.MissingCostLayer', { quantity: formatQty(item.costEvidenceShortage), unit: item.baseUnitCode });
                                tbody.append(`
                                    <tr>
                                        <td>
                                            <div class="item-name">[${escapeHtml(item.itemCode)}] ${escapeHtml(item.itemName)}</div>
                                            <div class="small text-muted">${escapeHtml(translateSourceType(item.sourceType))}${item.childRecipeId ? escapeHtml(t('Create.Js.SelectedRecipeVersion')) : ''}</div>
                                        </td>
                                        <td class="text-end fw-semibold">${formatQty(item.requiredTotal)} ${escapeHtml(item.baseUnitCode)}</td>
                                        <td class="text-end">${formatQty(item.currentQuantity)}</td>
                                        <td class="text-end">${formatQty(item.reservedQuantity)}</td>
                                        <td class="text-end">${formatQty(item.usableQuantity)}</td>
                                        <td class="text-end ${shortageClass}">${formatQty(item.shortageQuantity)}</td>
                                        <td class="small ${item.costEvidenceComplete ? 'text-success' : 'text-danger'}">${costText}</td>
                                    </tr>
                                `);
                            });
                        }

                        const reasonHtml = (preview.reasons || []).map(function (reason) {
                            return `<li class="${reason.blocking ? 'text-danger' : 'text-warning'}">${escapeHtml(reason.message)}</li>`;
                        }).join('');
                        readiness.html(`
                            <span class="po-readiness-state ${preview.isReady ? 'is-ready' : 'is-error'}">${escapeHtml(translateReadinessStatus(preview.overallStatus, preview.isReady))}</span>
                            <span class="small">${escapeHtml(t('Create.Js.WriterMode'))} <strong>${escapeHtml(preview.writerModeLabel || t('Create.Js.Unknown'))}</strong> · ${escapeHtml(t('Create.Js.MaximumFactor'))} ${formatQty(preview.maxSupportedRunCount)}</span>
                            ${reasonHtml ? '<ul class="po-readiness-reasons">' + reasonHtml + '</ul>' : ''}
                        `);
                        output.removeClass('d-none').html(`
                            <div><span>${escapeHtml(t('Create.Js.OutputAtOne'))}</span><strong>${formatQty(preview.outputQuantityPerRun)} ${escapeHtml(preview.outputUnitCode)}</strong></div>
                            <div><span>${escapeHtml(t('Create.Js.RawOutput'))}</span><strong>${formatQty(preview.rawTotalOutput)} ${escapeHtml(preview.outputUnitCode)}</strong></div>
                            <div><span>${escapeHtml(t('Create.Js.NormalizedOutput'))}</span><strong>${formatQty(preview.normalizedTotalOutput)} ${escapeHtml(preview.outputBaseUnitCode)}</strong></div>
                            <div><span>${escapeHtml(t('Create.Js.EstimatedBomCost'))}</span><strong>${preview.estimatedBomCostComplete ? formatMoney(preview.estimatedBomCostTotal) : escapeHtml(t('Create.Js.Incomplete'))}</strong></div>
                            <div><span>${escapeHtml(t('Create.Js.ProjectedFifo'))}</span><strong>${preview.costEvidenceComplete ? formatMoney(preview.projectedFifoInputCost) : escapeHtml(t('Create.Js.MissingEvidence'))}</strong></div>
                        `);
                        previewReady = preview.isReady === true;
                        btnComplete.prop('disabled', !previewReady);
                    }
                ).fail(function () {
                    tbody.html(`<tr><td colspan="7" class="text-center text-danger py-4">${escapeHtml(t('Create.Js.ConnectionLoadError'))}</td></tr>`);
                    readiness.html(`<span class="po-readiness-state is-error">${escapeHtml(t('Create.Js.ConnectionError'))}</span>`);
                    btnComplete.prop('disabled', true);
                });
            }, 400);

            $('#storeSelect').on('change', fetchBOM);
            $('#recipeSelect').on('change', fetchBOM);
            $('#batchInput').on('input', fetchBOM);

            if ($('#recipeSelect').val()) { fetchBOM(); }

            // Issue #120 — apply stock for CONFIRMED runs (backend validates mode/capability)
            $(document).on('click', '.btn-apply-stock', function () {
                const runId = parseInt($(this).data('run-id'), 10);
                const btn = $(this);
                if (!runId) return;

                Swal.fire({
                    icon: 'question',
                    title: t('Create.Js.ApplyTitle'), text: t('Create.Js.ApplyDescription'),
                    showCancelButton: true,
                    confirmButtonText: t('Create.ApplyStock'), cancelButtonText: t('Create.Js.Cancel'),
                    confirmButtonColor: '#ea580c'
                }).then((result) => {
                    if (!result.isConfirmed) return;
                    btn.prop('disabled', true).text(t('Create.Js.Processing'));
                    $.ajax({
                        url: '@Url.Action("ExecuteStock", "AdminProductionOrder", new { area = "Admin" })',
                        type: 'POST',
                        headers: antiforgeryHeaders(),
                        data: JSON.stringify({ productionRunId: runId }),
                        success: function (res) {
                            if (res.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: res.wasReplay ? t('Create.Js.AppliedReplay') : t('Create.Js.Applied'),
                                    text: res.message || t('Create.Js.InventoryUpdated'),
                                    confirmButtonColor: '#10b981'
                                }).then(() => window.location.reload());
                            } else {
                                btn.prop('disabled', false).text(t('Create.ApplyStock'));
                                const code = res.errorCode || '';
                                const executionErrors = {
                                    MODE_LEGACY: {
                                        title: t('Create.Js.LegacyWriterTitle'), message: t('Create.Js.LegacyWriterMessage')
                                    },
                                    MODE_BLOCKED: {
                                        title: t('Create.Js.WriterBlockedTitle'), message: t('Create.Js.WriterBlockedMessage')
                                    },
                                    BTP_WRITER_BLOCKED: {
                                        title: t('Create.Js.WriterBlockedTitle'), message: t('Create.Js.WriterBlockedMessage')
                                    }
                                };
                                const mappedError = executionErrors[code] || {
                                    title: t('Create.Js.ApplyFailedTitle'), message: t('Create.Js.ApplyFailedMessage')
                                };
                                let errTitle = mappedError.title;
                                let html = mappedError.message;
                                if (code === 'PRODUCTION_COST_EVIDENCE_INCOMPLETE') {
                                    errTitle = t('Create.Js.CostEvidenceTitle');
                                    html = `<p>${escapeHtml(t('Create.Js.CostEvidenceMessage'))}</p>`;
                                    if (res.costEvidenceGaps && res.costEvidenceGaps.length) {
                                        html += '<ul style="text-align:left">';
                                        res.costEvidenceGaps.forEach(function (g) {
                                            html += '<li><b>' + escapeHtml((g.inputCode || '') + ' ' + (g.inputName || '')) + '</b>: '
                                                + escapeHtml(t('Create.Js.CostEvidenceLine', { required: g.requiredQuantity, available: g.availableLayerQuantity, missing: g.missingQuantity })) + '</li>';
                                        });
                                        html += '</ul>';
                                    }
                                }
                                Swal.fire({
                                    icon: 'error',
                                    title: errTitle,
                                    html: html,
                                    confirmButtonColor: '#ef4444'
                                });
                            }
                        },
                        error: function () {
                            btn.prop('disabled', false).text(t('Create.ApplyStock'));
                            Swal.fire({ icon: 'error', title: t('Create.Js.NetworkError'), text: t('Create.Js.NetworkMessage'), confirmButtonColor: '#ef4444' });
                        }
                    });
                });
            });

            // Issue #119 — confirm durable intent only
            let lastPayloadSignature = null;

            function payloadSignature(storeId, recipeId, runCount, notes) {
                return [storeId, recipeId, String(runCount), (notes || '').trim()].join('|');
            }

            $('#btnComplete').click(function (e) {
                e.preventDefault();
                const storeId = parseInt($('#storeSelect').val(), 10) || 0;
                const recipeId = parseInt($('#recipeSelect').val(), 10) || 0;
                const runCount = parseFloat($('#batchInput').val());
                const notes = $('textarea[name="Notes"]').val();

                if (!previewReady) {
                    Swal.fire({
                        icon: 'warning',
                        title: t('Create.Js.NotReadyTitle'), text: t('Create.Js.NotReadyMessage'),
                        confirmButtonColor: '#ea580c'
                    });
                    return;
                }

                if (!storeId || !recipeId || !(runCount > 0) || runCount > 9999 || Number.isNaN(runCount)) {
                    Swal.fire({
                        icon: 'warning',
                        title: t('Create.Js.InvalidFactorTitle'), text: t('Create.Js.InvalidFactorMessage'),
                        confirmButtonColor: '#ea580c'
                    });
                    return;
                }

                const sig = payloadSignature(storeId, recipeId, runCount, notes);
                if (lastPayloadSignature !== null && lastPayloadSignature !== sig) {
                    newRequestKey();
                }
                lastPayloadSignature = sig;

                Swal.fire({
                    icon: 'question',
                    title: t('Create.Js.RecordTitle'), text: t('Create.Js.RecordDescription'),
                    showCancelButton: true,
                    confirmButtonText: t('Create.Js.Confirm'), cancelButtonText: t('Create.Js.Cancel'),
                    confirmButtonColor: '#ea580c',
                }).then((result) => {
                    if (!result.isConfirmed) return;

                    const btn = $('#btnComplete');
                    btn.prop('disabled', true).html(`<i class="fas fa-spinner fa-spin me-1"></i>${escapeHtml(t('Create.Js.Processing'))}`);

                    $.ajax({
                        url: '@Url.Action("Execute", "AdminProductionOrder", new { area = "Admin" })',
                        type: 'POST',
                        headers: antiforgeryHeaders(),
                        data: JSON.stringify({
                            requestKey: requestKey,
                            storeId: storeId,
                            recipeId: recipeId,
                            requestedRunCount: runCount,
                            notes: notes
                        }),
                        success: function(res) {
                            const label = `<i class="fas fa-check-circle me-1"></i> ${escapeHtml(t('Create.RecordOrder'))}`;
                            if (res.success) {
                                newRequestKey();
                                lastPayloadSignature = null;
                                Swal.fire({
                                    icon: 'success',
                                    title: t('Create.Js.Recorded'), text: res.message || t('Create.Js.RecordedMessage'),
                                    confirmButtonColor: '#10b981'
                                }).then(() => window.location.reload());
                            } else {
                                btn.prop('disabled', false).html(label);
                                // #131 — surface structured writer-mode messages from server
                                let errTitle = t('Create.Js.Failed');
                                const code = res.errorCode || '';
                                if (code === 'BTP_WRITER_LEGACY') errTitle = t('Create.Js.LegacyShortTitle');
                                if (code === 'BTP_WRITER_BLOCKED') errTitle = t('Create.Js.BlockedShortTitle');
                                Swal.fire({
                                    icon: 'error',
                                    title: errTitle,
                                    text: res.message || t('Create.Js.RecordFailed'),
                                    confirmButtonColor: '#ef4444'
                                });
                            }
                        },
                        error: function() {
                            // Keep same requestKey for retry after network loss
                            btn.prop('disabled', false).html(`<i class="fas fa-check-circle me-1"></i> ${escapeHtml(t('Create.RecordOrder'))}`);
                            Swal.fire({
                                icon: 'error',
                                title: t('Create.Js.NetworkError'), text: t('Create.Js.NetworkMessage'),
                                confirmButtonColor: '#ef4444'
                            });
                        }
                    });
                });
            });
        });
    </script>
}
