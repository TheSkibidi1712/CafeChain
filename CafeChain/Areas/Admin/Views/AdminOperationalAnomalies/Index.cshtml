@model IReadOnlyList<CafeChain.Application.DTOs.AI.OperationalAnomalyDto>
@{ ViewData["Title"] = "Tín hiệu vận hành"; }
@Html.AntiForgeryToken()
<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3"><div><h3 class="mb-1">Tín hiệu vận hành</h3><div class="text-muted">Tín hiệu thống kê cần điều tra; không phải kết luận gian lận.</div></div>
        <form method="get"><select class="form-select" name="targetStoreId" onchange="this.form.submit()">@foreach(var s in (IReadOnlyList<CafeChain.Application.DTOs.Admin.StoreScope.AdminStoreOptionDto>)ViewBag.Stores){<option value="@s.StoreId" selected="@(s.StoreId == (int?)ViewBag.SelectedStoreId)">@s.StoreName</option>}</select></form>
    </div>
    <div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Metric</th><th>Hiện tại</th><th>Baseline</th><th>Độ lệch</th><th>Mức độ</th><th>Trạng thái</th><th></th></tr></thead><tbody>
    @if(Model.Count == 0){<tr><td colspan="7" class="text-center text-muted py-4">Không có tín hiệu đang mở.</td></tr>}
    @foreach(var x in Model){<tr id="anomaly-@x.Id"><td><code>@x.MetricCode</code><div class="small text-muted">@x.PeriodKey · score @x.RobustScore.ToString("N2")</div></td><td>@x.CurrentValue.ToString("N0")</td><td>@x.BaselineValue.ToString("N0")</td><td>@x.PercentageDeviation.ToString("P1")</td><td><span class="badge bg-@(x.Severity == "CRITICAL" ? "danger" : "warning")">@x.Severity</span></td><td>@x.Status</td><td class="text-end"><button class="btn btn-sm btn-outline-secondary" data-explain="@x.Id">Giải thích AI</button> <button class="btn btn-sm btn-outline-primary" data-ack="@x.Id" data-version="@x.RowVersion">Đã xem</button></td></tr>}
    </tbody></table></div></div>
</div>
@section Scripts { <script src="~/js/Admin/Dashboard/operational-anomalies.js" asp-append-version="true"></script> }
