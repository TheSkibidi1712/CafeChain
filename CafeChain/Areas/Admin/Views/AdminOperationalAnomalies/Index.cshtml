@model IReadOnlyList<CafeChain.Application.DTOs.AI.OperationalAnomalyDto>
@using System.Text.Json
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<OperationsResource> L
@{
    ViewData["Title"] = L["Anomalies.Index.Title"].Value;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var canAcknowledge = ViewBag.CanAcknowledge is true;
    var canResolve = ViewBag.CanResolve is true;
    var canFeedback = ViewBag.CanFeedback is true;
    var canUseAi = ViewBag.CanUseAi is true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />
    <link rel="stylesheet" href="~/css/Admin/OperationalAnomalies/operational-anomalies.css" asp-append-version="true" />
}

@Html.AntiForgeryToken()
<main class="anomalies-page cc-page ops-shell cc-warehouse-page">
    <header class="anomalies-header ops-header cc-warehouse-header">
        <div>
            <div class="anomalies-eyebrow">@L["Anomalies.Index.Eyebrow"]</div>
            <h1><i class="fa-solid fa-signal me-2 text-warning" aria-hidden="true"></i>@L["Anomalies.Index.Title"]</h1>
            <p class="anomalies-subtitle">@L["Anomalies.Index.Subtitle"]</p>
        </div>
        <div class="anomalies-header-actions">
            <form method="get" class="anomalies-store-filter">
                <select class="form-select" name="targetStoreId" onchange="this.form.submit()" aria-label="@L["Anomalies.Index.StoreSelectorAria"]">
                    @foreach (var store in (IReadOnlyList<CafeChain.Application.DTOs.Admin.StoreScope.AdminStoreOptionDto>)ViewBag.Stores)
                    {
                        <option value="@store.StoreId" selected="@(store.StoreId == (int?)ViewBag.SelectedStoreId)">@store.StoreName</option>
                    }
                </select>
            </form>
        </div>
    </header>

    <div class="cc-anomaly-card">
        <div class="table-responsive">
            <table class="cc-anomaly-table">
                <thead>
                    <tr>
                        <th>@L["Anomalies.Index.Col.Metric"]</th>
                        <th>@L["Anomalies.Index.Col.CurrentValue"]</th>
                        <th>@L["Anomalies.Index.Col.Baseline"]</th>
                        <th>@L["Anomalies.Index.Col.Deviation"]</th>
                        <th>@L["Anomalies.Index.Col.Severity"]</th>
                        <th>@L["Anomalies.Index.Col.Status"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">@L["Anomalies.Index.Empty"]</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr id="anomaly-@item.Id">
                        <td>
                            <div class="anomaly-title">@item.MetricDisplayName</div>
                            <div class="anomaly-meta">@L["Anomalies.Index.DateLabel"] @item.BusinessDate.ToString("dd/MM/yyyy")</div>
                            <details class="anomaly-details">
                                <summary>@L["Anomalies.Index.Basis"]</summary>
                                <div class="mt-2">@L["Anomalies.Index.BusinessDateLabel"] @item.BusinessDate.ToString("dd/MM/yyyy") &bull; @L["Anomalies.Index.RobustScoreLabel"] @item.RobustScore.ToString("N2")</div>
                                <div>@item.ConfidenceDisplay</div>
                            </details>
                        </td>
                        <td><strong>@item.CurrentValueDisplay</strong></td>
                        <td>@item.BaselineValueDisplay</td>
                        <td><strong>@item.DeviationDisplay</strong></td>
                        <td><span class="@(item.Severity == "CRITICAL" ? "anomaly-badge-critical" : "anomaly-badge-warning")">@item.SeverityDisplay</span></td>
                        <td>@item.StatusDisplay</td>
                        <td class="text-end text-nowrap">
                            @if (canUseAi)
                            {
                                <button class="cc-btn-outline" data-explain="@item.Id">@L["Anomalies.Index.Explain"]</button>
                            }
                            @if (canAcknowledge && item.Status == "OPEN")
                            {
                                <button class="cc-btn-outline cc-btn-outline-primary" data-ack="@item.Id" data-version="@item.RowVersion">@L["Anomalies.Index.Acknowledge"]</button>
                            }
                            @if (canResolve && (item.Status == "OPEN" || item.Status == "ACKNOWLEDGED"))
                            {
                                <button class="cc-btn-outline cc-btn-outline-success" data-resolve="@item.Id" data-version="@item.RowVersion">@L["Anomalies.Index.Resolve"]</button>
                            }
                            @if (canFeedback)
                            {
                                var feedbackLabel = string.IsNullOrWhiteSpace(item.FeedbackDisplay) ? L["Anomalies.Index.Feedback"].Value : item.FeedbackDisplay;
                                <button class="cc-btn-outline @(string.IsNullOrWhiteSpace(item.FeedbackDisplay) ? "" : "is-completed")" data-feedback="@item.Id" data-version="@item.RowVersion" @(string.IsNullOrWhiteSpace(item.FeedbackDisplay) ? null : "disabled")>
                                    @feedbackLabel
                                </button>
                                <small class="anomaly-feedback-status d-block" data-feedback-status="@item.Id">@item.FeedbackDisplay</small>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</main>

@section Scripts {
    <script type="application/json" id="anomalies-ui-catalog">@Html.Raw(JsonSerializer.Serialize(L.GetAllStrings().Where(x => x.Name.StartsWith("Anomalies.Js.")).ToDictionary(x => x.Name, x => x.Value)))</script>
    <script src="~/js/Admin/Dashboard/operational-anomalies.js" asp-append-version="true"></script>
}
