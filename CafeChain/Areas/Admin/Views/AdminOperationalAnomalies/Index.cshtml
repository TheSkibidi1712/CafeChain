@model IReadOnlyList<CafeChain.Application.DTOs.AI.OperationalAnomalyDto>
@{
    ViewData["Title"] = "Tín hiệu vận hành";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var canAcknowledge = ViewBag.CanAcknowledge is true;
    var canResolve = ViewBag.CanResolve is true;
    var canFeedback = ViewBag.CanFeedback is true;
    var canUseAi = ViewBag.CanUseAi is true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />
    <link rel="stylesheet" href="~/css/Admin/OperationalAnomalies/operational-anomalies.css" asp-append-version="true" />
}

@Html.AntiForgeryToken()
<main class="cc-page ops-shell cc-warehouse-page">
    <header class="anomalies-header ops-header cc-warehouse-header">
        <div>
            <div class="anomalies-eyebrow">Nhân sự & vận hành</div>
            <h1>Tín hiệu vận hành</h1>
            <p class="anomalies-subtitle">Các thay đổi đáng chú ý cần đối chiếu thêm; đây không phải kết luận sai phạm.</p>
        </div>
        <div class="anomalies-header-actions">
            <form method="get" class="d-flex align-items-center">
                <select class="form-select" name="targetStoreId" onchange="this.form.submit()" style="min-width: 240px; border-radius: 8px;">
                    @foreach (var store in (IReadOnlyList<CafeChain.Application.DTOs.Admin.StoreScope.AdminStoreOptionDto>)ViewBag.Stores)
                    {
                        <option value="@store.StoreId" selected="@(store.StoreId == (int?)ViewBag.SelectedStoreId)">@store.StoreName</option>
                    }
                </select>
            </form>
        </div>
    </header>

    <div class="cc-anomaly-card">
        <div class="table-responsive">
            <table class="cc-anomaly-table">
                <thead>
                    <tr>
                        <th>Chỉ số cần kiểm tra</th>
                        <th>Giá trị ghi nhận</th>
                        <th>Mức thông thường trước đây</th>
                        <th>Mức chênh lệch</th>
                        <th>Mức cần ưu tiên</th>
                        <th>Trạng thái xử lý</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Không có tín hiệu đang mở.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr id="anomaly-@item.Id">
                        <td>
                            <div class="anomaly-title">@item.MetricDisplayName</div>
                            <div class="anomaly-meta">Ngày @item.BusinessDate.ToString("dd/MM/yyyy")</div>
                            <details class="anomaly-details">
                                <summary>Thông tin kỹ thuật</summary>
                                <div class="mt-2">Mã: @item.MetricCode &bull; phiên bản @item.DetectionVersion &bull; điểm chuẩn hóa @item.RobustScore.ToString("N2")</div>
                                <div>@item.ConfidenceDisplay</div>
                            </details>
                        </td>
                        <td><strong>@item.CurrentValueDisplay</strong></td>
                        <td>@item.BaselineValueDisplay</td>
                        <td><strong>@item.DeviationDisplay</strong></td>
                        <td>
                            <span class="@(item.Severity == "CRITICAL" ? "anomaly-badge-critical" : "anomaly-badge-warning")">
                                @item.SeverityDisplay
                            </span>
                        </td>
                        <td>@item.StatusDisplay</td>
                        <td class="text-end text-nowrap">
                            @if (canUseAi) { <button class="cc-btn-outline" data-explain="@item.Id">Giải thích</button> }
                            @if (canAcknowledge && item.Status == "OPEN") { <button class="cc-btn-outline cc-btn-outline-primary" data-ack="@item.Id" data-version="@item.RowVersion">Tiếp nhận</button> }
                            @if (canResolve && item.Status is "OPEN" or "ACKNOWLEDGED") { <button class="cc-btn-outline cc-btn-outline-success" data-resolve="@item.Id" data-version="@item.RowVersion">Đánh dấu đã xử lý</button> }
                            @if (canFeedback) { <button class="cc-btn-outline" data-feedback="@item.Id" data-version="@item.RowVersion">Phản hồi</button> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="cc-anomaly-card">
        <div class="table-responsive">
            <table class="cc-anomaly-table">
                <thead>
                    <tr>
                        <th>Metric</th>
                        <th>Hiện tại</th>
                        <th>Baseline</th>
                        <th>Độ lệch</th>
                        <th>Mức độ</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if(Model.Count == 0){<tr><td colspan="7" class="text-center text-muted py-4">Không có tín hiệu đang mở.</td></tr>}
                    @foreach(var x in Model){
                    <tr id="anomaly-@x.Id">
                        <td>
                            <div class="anomaly-title">@x.MetricCode</div>
                            <div class="anomaly-meta">@x.PeriodKey &bull; score @x.RobustScore.ToString("N2")</div>
                        </td>
                        <td>@x.CurrentValue.ToString("N0")</td>
                        <td>@x.BaselineValue.ToString("N0")</td>
                        <td>@x.PercentageDeviation.ToString("P1")</td>
                        <td>
                            <span class="@(x.Severity == "CRITICAL" ? "anomaly-badge-critical" : "anomaly-badge-warning")">
                                @x.Severity
                            </span>
                        </td>
                        <td>@x.Status</td>
                        <td class="text-center">
                            <button class="cc-btn-outline" data-explain="@x.Id">Giải thích AI</button> 
                            <button class="cc-btn-outline cc-btn-outline-primary" data-ack="@x.Id" data-version="@x.RowVersion">Đã xem</button>
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</main>

@section Scripts { <script src="~/js/Admin/Dashboard/operational-anomalies.js" asp-append-version="true"></script> }
