@model CafeChain.Application.DTOs.Admin.Procurement.ReorderSuggestionListDto
@using CafeChain.Application.Constants
@{
    ViewData["Title"] = "Gợi ý nhập hàng";
    var stores = ViewBag.Stores as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
        ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var selectedStoreId = (int?)ViewBag.SelectedStoreId ?? Model.StoreId;
    var labels = new Dictionary<string, string>
    {
        [ReorderRecommendationLevels.Urgent] = "Cần nhập gấp",
        [ReorderRecommendationLevels.NearReorder] = "Gần điểm đặt hàng",
        [ReorderRecommendationLevels.Normal] = "Chưa cần nhập",
        [ReorderRecommendationLevels.IncomingCoversDemand] = "Hàng về đã đủ",
        [ReorderRecommendationLevels.ProcurementInProgress] = "Đang xử lý mua hàng",
        [ReorderRecommendationLevels.DataIncomplete] = "Thiếu dữ liệu"
    };
    var actionableItems = Model.Items
        .Where(item =>
            item.CanConfirm
            && item.FinalSuggestedQuantity.GetValueOrDefault() > 0m
            && item.SuggestionStatus is
                ReorderRecommendationLevels.Urgent
                or ReorderRecommendationLevels.NearReorder
                or ReorderRecommendationLevels.ProcurementInProgress)
        .ToList();
    var dataIncompleteItems = Model.Items
        .Where(item => item.SuggestionStatus == ReorderRecommendationLevels.DataIncomplete)
        .ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/Procurement/reorder-suggestions.css" asp-append-version="true" />
}

<main class="reorder-page cc-page cc-warehouse-page">
    <div class="d-none" aria-hidden="true">@Html.AntiForgeryToken()</div>
    <header class="reorder-header cc-page-header cc-warehouse-header">
        <div>
            <p class="reorder-eyebrow cc-page-kicker">Kho &amp; Cung ứng / Lập kế hoạch</p>
            <h1 class="cc-page-title">Gợi ý nhập hàng</h1>
            <p class="cc-page-description">
                Một nguồn tính toán chung cho tồn kho, nhu cầu, pipeline mua hàng và quy cách nhà cung cấp.
            </p>
        </div>
        <div class="reorder-header-actions">
            <button type="button"
                    id="openReorderBulkModal"
                    class="cc-button cc-button-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#reorderBulkModal"
                    disabled="@((actionableItems.Any() || dataIncompleteItems.Any()) ? null : "disabled")">
                <i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i>
                Xem nguyên liệu sắp hết
                <span class="reorder-count-badge" aria-label="@actionableItems.Count nguyên liệu cần xử lý">
                    @actionableItems.Count
                </span>
            </button>
            <a asp-controller="AdminRestockRequests" asp-action="Index" class="cc-button cc-button-secondary">
                <i class="fas fa-list-check" aria-hidden="true"></i> Xem yêu cầu nhập
            </a>
        </div>
    </header>

    @if (ViewBag.ErrorMessage is string loadError)
    {
        <div class="ops-notice ops-notice-error" role="alert">@loadError</div>
    }

    <form method="get" class="reorder-filters">
        <div>
            <label for="storeId">Cửa hàng</label>
            <select id="storeId" name="storeId" class="form-select">
                @foreach (var store in stores)
                {
                    <option value="@store.Value" selected="@(store.Value == selectedStoreId.ToString())">@store.Text</option>
                }
            </select>
        </div>
        <div>
            <label for="analysisWindowDays">Kỳ phân tích</label>
            <select id="analysisWindowDays" name="analysisWindowDays" class="form-select">
                <option value="30" selected="@(Model.AnalysisWindowDays == 30)">30 ngày</option>
                <option value="60" selected="@(Model.AnalysisWindowDays == 60)">60 ngày</option>
                <option value="90" selected="@(Model.AnalysisWindowDays == 90)">90 ngày</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary reorder-refresh-button">
            <i class="fas fa-rotate" aria-hidden="true"></i> Tính lại
        </button>
    </form>

    <div class="reorder-note" role="note">
        <i class="fas fa-circle-info" aria-hidden="true"></i>
        Xác nhận sẽ tạo yêu cầu nhập nháp hoặc bổ sung nhu cầu vào yêu cầu đang mở.
        Hệ thống luôn tính lại dữ liệu và từ chối nếu gợi ý đã thay đổi.
    </div>

    <section class="reorder-table-shell cc-warehouse-table-shell" aria-label="Danh sách gợi ý nhập hàng">
        @if (!Model.Items.Any())
        {
            <div class="reorder-empty cc-empty-state">
                <i class="fas fa-box-open" aria-hidden="true"></i>
                <h2>Chưa có dữ liệu gợi ý</h2>
                <p>Chọn cửa hàng có tồn kho nguyên liệu để bắt đầu phân tích.</p>
            </div>
        }
        else
        {
            <div class="reorder-table-scrollbar js-reorder-table-scrollbar"
                 role="region"
                 aria-label="Thanh cuộn ngang cho bảng gợi ý nhập hàng"
                 tabindex="0">
                <div class="reorder-table-scrollbar-spacer"></div>
            </div>
            <div class="table-responsive js-reorder-table-viewport">
                <table class="table reorder-table align-middle">
                    <thead>
                        <tr>
                            <th>Nguyên liệu</th>
                            <th class="text-center">Tồn kho</th>
                            <th class="text-center">Nhu cầu</th>
                            <th class="text-center">Pipeline</th>
                            <th class="text-center">Đề xuất cuối</th>
                            <th class="text-center">Nhà cung cấp</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr id="ingredient-@item.IngredientId" class="reorder-data-row">
                            <td class="reorder-ingredient-cell align-middle">
                                <strong>@item.IngredientName</strong>
                                <span>@item.IngredientCode · @item.BaseUnitCode</span>
                            </td>
                            <td class="text-center align-middle">
                                <strong>@item.AvailableStock.ToString("N3") @item.BaseUnitCode khả dụng</strong>
                                <span>Tồn @item.OnHandQuantity.ToString("N3") · giữ @item.ReservedQuantity.ToString("N3")</span>
                                <span>Tối thiểu @(item.MinimumStock?.ToString("N3") ?? "-")</span>
                            </td>
                            <td class="text-center align-middle">
                                <strong>ROP @(item.ReorderPoint?.ToString("N3") ?? "-")</strong>
                                <span>Dùng/ngày @(item.AverageDailyConsumption?.ToString("N3") ?? "-") · lead @(item.LeadTimeDays?.ToString() ?? "-") ngày</span>
                                <span>Nhu cầu thô @(item.RawDemand?.ToString("N3") ?? "-")</span>
                            </td>
                            <td class="text-center align-middle">
                                <strong>Đang về @item.IncomingQuantity.ToString("N3")</strong>
                                <span>Tồn dự kiến @(item.ProjectedStock?.ToString("N3") ?? "-")</span>
                                <span>Pipeline bao phủ @item.ProcurementCoveredQuantity.ToString("N3")</span>
                            </td>
                            <td class="reorder-suggestion-cell text-center align-middle">
                                <strong>@(item.FinalSuggestedQuantity?.ToString("N3") ?? "-") @item.BaseUnitCode</strong>
                                <span>Còn thiếu @(item.RemainingDemand?.ToString("N3") ?? "-")</span>
                                @if (item.SuggestedPackageCount.HasValue)
                                {
                                    <span>@item.SuggestedPackageCount.Value.ToString("N0") gói · @((item.EstimatedCost ?? 0m).ToString("N0"))đ</span>
                                }
                            </td>
                            <td class="text-center align-middle">
                                <strong>@(item.SupplierName ?? "-")</strong>
                                @if (item.PackageBaseQuantity.HasValue)
                                {
                                    <span>@item.PackageBaseQuantity.Value.ToString("N3") @item.BaseUnitCode/gói</span>
                                }
                                @if (item.PackagePrice.HasValue)
                                {
                                    <span>@item.PackagePrice.Value.ToString("N0")đ/gói</span>
                                }
                            </td>
                            <td class="text-center align-middle">
                                <span class="reorder-status reorder-status--@item.SuggestionStatus.ToLowerInvariant()">
                                    @labels.GetValueOrDefault(item.SuggestionStatus, item.SuggestionStatus)
                                </span>
                                <small>@item.Reason</small>
                            </td>
                            <td class="text-end reorder-actions-cell">
                                <div class="reorder-action-group">
                                    <button type="button"
                                            class="cc-button cc-button-ai reorder-action-button reorder-action-button--explain js-reorder-explain"
                                            data-store-id="@item.StoreId"
                                            data-ingredient-id="@item.IngredientId"
                                            data-suggestion-token="@item.SuggestionToken">
                                        <i class="fas fa-lightbulb" aria-hidden="true"></i>
                                        Giải thích
                                    </button>
                                    @if (item.ActiveRestockRequestId.HasValue)
                                    {
                                        <a asp-controller="AdminRestockRequests"
                                           asp-action="Details"
                                           asp-route-id="@item.ActiveRestockRequestId"
                                           class="cc-button cc-button-secondary reorder-action-button reorder-action-button--view">
                                            <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
                                            Xem yêu cầu
                                        </a>
                                    }
                                    @if (item.CanConfirm)
                                    {
                                        <button type="button"
                                                class="cc-button cc-button-primary reorder-action-button reorder-action-button--confirm js-reorder-confirm"
                                                data-store-id="@item.StoreId"
                                                data-ingredient-id="@item.IngredientId"
                                                data-suggestion-token="@item.SuggestionToken">
                                            <i class="fas fa-circle-check" aria-hidden="true"></i>
                                            @(item.ActiveRestockRequestId.HasValue ? "Bổ sung yêu cầu" : "Xác nhận nhập")
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <div class="modal fade reorder-bulk-modal"
         id="reorderBulkModal"
         tabindex="-1"
         aria-labelledby="reorderBulkModalLabel"
         aria-hidden="true"
         data-auto-open="@(actionableItems.Any() ? "true" : "false")">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <p class="reorder-modal-eyebrow">Kiểm tra tự động theo rule</p>
                        <h2 class="modal-title fs-5" id="reorderBulkModalLabel">
                            Nguyên liệu cần xử lý tại @Model.StoreName
                        </h2>
                        <p class="reorder-modal-subtitle">
                            Kỳ phân tích @Model.AnalysisWindowDays ngày · hệ thống sẽ tính lại trước mỗi lần xác nhận.
                        </p>
                    </div>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    @if (actionableItems.Any())
                    {
                        <div class="reorder-bulk-notice" role="note">
                            <i class="fas fa-circle-info" aria-hidden="true"></i>
                            <span>
                                <strong>Danh sách đề xuất, chưa phải chứng từ.</strong>
                                Hệ thống tính theo tồn kho, nhu cầu và pipeline; bạn vẫn là người xác nhận cuối cùng.
                            </span>
                        </div>

                        <div class="reorder-bulk-toolbar">
                            <label class="reorder-select-all" for="reorderSelectAll">
                                <input type="checkbox"
                                       id="reorderSelectAll"
                                       class="form-check-input"
                                       checked />
                                <span class="reorder-select-copy">
                                    <strong>Chọn tất cả</strong>
                                    <small>Áp dụng cho các dòng đủ điều kiện</small>
                                </span>
                            </label>
                            <span id="reorderBulkSelectedCount"
                                  class="reorder-selected-count"
                                  role="status"
                                  aria-live="polite">
                                Đã chọn @actionableItems.Count/@actionableItems.Count nguyên liệu
                            </span>
                        </div>

                        <div class="table-responsive reorder-bulk-table-shell">
                            <table class="table reorder-bulk-table align-middle">
                                <thead>
                                    <tr>
                                        <th class="reorder-checkbox-column text-center">
                                            <span class="visually-hidden">Chọn</span>
                                        </th>
                                        <th>Nguyên liệu</th>
                                        <th class="text-center">Tồn / ngưỡng</th>
                                        <th class="text-center">Pipeline</th>
                                        <th class="text-center">Đề xuất mua</th>
                                        <th class="text-center">Nhà cung cấp</th>
                                        <th class="text-center">Kết quả</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var item in actionableItems)
                                {
                                    <tr class="js-reorder-bulk-row"
                                        data-store-id="@item.StoreId"
                                        data-ingredient-id="@item.IngredientId"
                                        data-ingredient-name="@item.IngredientName"
                                        data-suggestion-token="@item.SuggestionToken"
                                        data-state="pending">
                                        <td class="text-center align-middle">
                                            <input type="checkbox"
                                                   id="bulk-ingredient-@item.IngredientId"
                                                   class="form-check-input js-reorder-bulk-select"
                                                   aria-label="Chọn @item.IngredientName"
                                                   checked />
                                        </td>
                                        <td class="align-middle">
                                            <label for="bulk-ingredient-@item.IngredientId">
                                                <strong>@item.IngredientName</strong>
                                                <span>@item.IngredientCode · @item.BaseUnitCode</span>
                                            </label>
                                            <span class="reorder-status reorder-status--@item.SuggestionStatus.ToLowerInvariant()">
                                                @labels.GetValueOrDefault(item.SuggestionStatus, item.SuggestionStatus)
                                            </span>
                                        </td>
                                        <td class="text-center align-middle">
                                            <strong>@item.AvailableStock.ToString("N3") @item.BaseUnitCode khả dụng</strong>
                                            <span>ROP @(item.ReorderPoint?.ToString("N3") ?? "-")</span>
                                        </td>
                                        <td class="text-center align-middle">
                                            <strong>Đang về @item.IncomingQuantity.ToString("N3")</strong>
                                            <span>Bao phủ @item.ProcurementCoveredQuantity.ToString("N3")</span>
                                            <span>Còn thiếu @(item.RemainingDemand?.ToString("N3") ?? "-")</span>
                                        </td>
                                        <td class="text-center align-middle">
                                            <strong>@item.FinalSuggestedQuantity!.Value.ToString("N3") @item.BaseUnitCode</strong>
                                            @if (item.SuggestedPackageCount.HasValue)
                                            {
                                                <span>@item.SuggestedPackageCount.Value.ToString("N0") gói</span>
                                            }
                                            @if (item.PackageBaseQuantity.HasValue)
                                            {
                                                <span>Quy cách @item.PackageBaseQuantity.Value.ToString("N3") @item.BaseUnitCode/gói</span>
                                            }
                                        </td>
                                        <td class="text-center align-middle">
                                            <strong>@(item.SupplierName ?? "-")</strong>
                                            @if (item.EstimatedCost.HasValue)
                                            {
                                                <span>Dự kiến @item.EstimatedCost.Value.ToString("N0")đ</span>
                                            }
                                        </td>
                                        <td class="text-center align-middle">
                                            <div class="reorder-bulk-result reorder-bulk-result--pending js-reorder-bulk-result"
                                                 role="status">
                                                Sẵn sàng
                                            </div>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="reorder-empty reorder-empty--compact">
                            <i class="fas fa-circle-check" aria-hidden="true"></i>
                            <h3>Không có nguyên liệu cần tạo yêu cầu nhập</h3>
                            <p>Tồn kho và pipeline hiện đang đáp ứng nhu cầu tại cửa hàng này.</p>
                        </div>
                    }

                    @if (dataIncompleteItems.Any())
                    {
                        <section class="reorder-incomplete"
                                 aria-labelledby="reorderIncompleteHeading">
                            <h3 id="reorderIncompleteHeading">
                                <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
                                @dataIncompleteItems.Count nguyên liệu thiếu dữ liệu
                            </h3>
                            <p>Các dòng này chỉ để kiểm tra và không thể chọn xác nhận.</p>
                            <ul>
                            @foreach (var item in dataIncompleteItems)
                            {
                                <li>
                                    <strong>@item.IngredientName</strong>
                                    <span>@item.IngredientCode · @item.Reason</span>
                                </li>
                            }
                            </ul>
                        </section>
                    }
                </div>
                <div class="modal-footer reorder-bulk-footer">
                    <div id="reorderBulkProgress"
                         class="reorder-bulk-progress"
                         role="status"
                         aria-live="polite"></div>
                    <button type="button"
                            id="reloadReorderSuggestions"
                            class="cc-button"
                            hidden>
                        <i class="fas fa-rotate" aria-hidden="true"></i>
                        Tải lại dữ liệu
                    </button>
                    <button type="button"
                            class="cc-button"
                            data-bs-dismiss="modal">
                        Đóng
                    </button>
                    <button type="button"
                            id="confirmSelectedReorders"
                            class="cc-button cc-button-primary"
                            disabled="@(actionableItems.Any() ? null : "disabled")">
                        Tạo yêu cầu nhập đã chọn
                    </button>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        (() => {
            const explainEndpoint = '@Url.Action("Explain", "AdminReorderSuggestions")';
            const confirmEndpoint = '@Url.Action("Confirm", "AdminReorderSuggestions")';
            const antiForgery = () =>
                document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            const setupTopTableScrollbar = () => {
                const topScrollbar = document.querySelector('.js-reorder-table-scrollbar');
                const tableViewport = document.querySelector('.js-reorder-table-viewport');
                const spacer = topScrollbar?.querySelector('.reorder-table-scrollbar-spacer');
                const table = tableViewport?.querySelector('.reorder-table');

                if (!topScrollbar || !tableViewport || !spacer || !table)
                    return;

                let syncingFromTop = false;
                let syncingFromTable = false;

                const updateScrollbar = () => {
                    spacer.style.width = `${table.scrollWidth}px`;
                    topScrollbar.hidden = table.scrollWidth <= tableViewport.clientWidth;
                    topScrollbar.scrollLeft = tableViewport.scrollLeft;
                };

                topScrollbar.addEventListener('scroll', () => {
                    if (syncingFromTable)
                        return;

                    syncingFromTop = true;
                    tableViewport.scrollLeft = topScrollbar.scrollLeft;
                    requestAnimationFrame(() => syncingFromTop = false);
                });

                tableViewport.addEventListener('scroll', () => {
                    if (syncingFromTop)
                        return;

                    syncingFromTable = true;
                    topScrollbar.scrollLeft = tableViewport.scrollLeft;
                    requestAnimationFrame(() => syncingFromTable = false);
                });

                if (window.ResizeObserver) {
                    const resizeObserver = new ResizeObserver(updateScrollbar);
                    resizeObserver.observe(tableViewport);
                    resizeObserver.observe(table);
                } else {
                    window.addEventListener('resize', updateScrollbar);
                }

                updateScrollbar();
            };

            setupTopTableScrollbar();

            const postForm = async (endpoint, values) => {
                const body = new URLSearchParams({
                    ...values,
                    __RequestVerificationToken: antiForgery()
                });
                const response = await fetch(endpoint, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body
                });
                let data = {};
                try {
                    data = await response.json();
                } catch {
                    // Preserve the HTTP status and expose a deterministic
                    // message when a proxy returns a non-JSON error page.
                }
                if (!response.ok || !data.success) {
                    const error = new Error(data.message || 'Không thể xử lý yêu cầu.');
                    error.status = response.status;
                    error.code = data.code;
                    throw error;
                }
                return data;
            };

            document.querySelectorAll('.js-reorder-explain').forEach(button => {
                button.addEventListener('click', async () => {
                    button.disabled = true;
                    try {
                        const data = await postForm(explainEndpoint, {
                            storeId: button.dataset.storeId,
                            ingredientId: button.dataset.ingredientId,
                            suggestionToken: button.dataset.suggestionToken
                        });
                        const panel = document.createElement('div');
                        panel.className = 'reorder-explain-grid';
                        [
                            ['Tóm tắt', data.summary],
                            ['Giải thích', data.explanation],
                            ['Rủi ro', data.risk],
                            ['Hành động đề xuất', data.recommendedActionText]
                        ].forEach(([title, value]) => {
                            const section = document.createElement('article');
                            section.className = 'reorder-explain-section';
                            const heading = document.createElement('strong');
                            heading.textContent = title;
                            const paragraph = document.createElement('p');
                            paragraph.textContent = value || 'Không có.';
                            section.append(heading, paragraph);
                            panel.append(section);
                        });
                        await Swal.fire({
                            icon: data.usedOllama ? 'info' : 'warning',
                            title: data.usedOllama ? 'Giải thích AI' : 'Giải thích theo rule',
                            html: panel,
                            buttonsStyling: false,
                            customClass: {
                                popup: 'reorder-explain-dialog',
                                title: 'reorder-explain-title',
                                htmlContainer: 'reorder-explain-content',
                                confirmButton: 'cc-button cc-button-primary reorder-explain-close'
                            },
                            confirmButtonText: 'Đóng'
                        });
                    } catch (error) {
                        const result = await Swal.fire({
                            icon: 'error',
                            title: 'Không thể giải thích',
                            text: error.message,
                            showCancelButton: error.status === 409,
                            confirmButtonText: error.status === 409 ? 'Tải lại' : 'Đóng',
                            cancelButtonText: 'Để sau'
                        });
                        if (error.status === 409 && result.isConfirmed)
                            window.location.reload();
                    } finally {
                        button.disabled = false;
                    }
                });
            });

            document.querySelectorAll('.js-reorder-confirm').forEach(button => {
                button.addEventListener('click', async () => {
                    button.dataset.requestKey ||= crypto.randomUUID();
                    const originalContent = Array.from(
                        button.childNodes,
                        node => node.cloneNode(true));
                    const loadingIcon = document.createElement('i');
                    loadingIcon.className = 'fas fa-spinner fa-spin';
                    loadingIcon.setAttribute('aria-hidden', 'true');
                    button.disabled = true;
                    button.replaceChildren(
                        loadingIcon,
                        document.createTextNode(' Đang xác nhận...'));
                    try {
                        const data = await postForm(confirmEndpoint, {
                            storeId: button.dataset.storeId,
                            ingredientId: button.dataset.ingredientId,
                            suggestionToken: button.dataset.suggestionToken,
                            requestKey: button.dataset.requestKey
                        });
                        await Swal.fire({
                            icon: 'success',
                            title: 'Đã xác nhận',
                            text: data.data.message,
                            confirmButtonText: 'Mở yêu cầu'
                        });
                        window.location.href =
                            `/Admin/AdminRestockRequests/Details/${data.data.restockRequestId}`;
                    } catch (error) {
                        const stale = error.code === 'REORDER_SUGGESTION_CHANGED'
                            || error.code === 'REORDER_SUGGESTION_EXPIRED';
                        const result = await Swal.fire({
                            icon: 'error',
                            title: 'Chưa thể xác nhận',
                            text: error.message,
                            showCancelButton: stale,
                            confirmButtonText: stale ? 'Tải lại dữ liệu' : 'Đóng',
                            cancelButtonText: 'Để sau'
                        });
                        if (stale && result.isConfirmed) {
                            window.location.reload();
                            return;
                        }
                        // Keep the same RequestKey for a safe retry after a
                        // network failure or an in-progress response.
                        button.disabled = false;
                        button.replaceChildren(...originalContent);
                    }
                });
            });

            const bulkModalElement = document.getElementById('reorderBulkModal');
            const bulkRows = Array.from(
                document.querySelectorAll('.js-reorder-bulk-row'));
            const selectAll = document.getElementById('reorderSelectAll');
            const selectedCount = document.getElementById('reorderBulkSelectedCount');
            const bulkProgress = document.getElementById('reorderBulkProgress');
            const bulkConfirm = document.getElementById('confirmSelectedReorders');
            const reloadButton = document.getElementById('reloadReorderSuggestions');
            let bulkProcessing = false;

            const reloadRequiredCodes = new Set([
                'REORDER_SUGGESTION_CHANGED',
                'REORDER_SUGGESTION_EXPIRED',
                'REORDER_CONFIRM_CONCURRENT_UPDATE',
                'REORDER_DATA_INCOMPLETE',
                'REORDER_NO_REMAINING_DEMAND'
            ]);

            const setBulkResult = (row, state, message, restockRequestId) => {
                const result = row.querySelector('.js-reorder-bulk-result');
                if (!result)
                    return;

                row.dataset.state = state;
                result.className =
                    `reorder-bulk-result reorder-bulk-result--${state} js-reorder-bulk-result`;
                result.replaceChildren();

                const messageNode = document.createElement('span');
                messageNode.textContent = message;
                result.append(messageNode);

                if (restockRequestId) {
                    const separator = document.createTextNode(' · ');
                    const link = document.createElement('a');
                    link.href =
                        `/Admin/AdminRestockRequests/Details/${encodeURIComponent(restockRequestId)}`;
                    link.textContent = 'Mở yêu cầu';
                    result.append(separator, link);
                }
            };

            const getSelectableRows = () =>
                bulkRows.filter(row => {
                    const checkbox = row.querySelector('.js-reorder-bulk-select');
                    return checkbox && !checkbox.disabled && row.dataset.state !== 'success';
                });

            const updateBulkSelection = () => {
                const selectableRows = getSelectableRows();
                const checkedRows = selectableRows.filter(row =>
                    row.querySelector('.js-reorder-bulk-select')?.checked);

                if (selectedCount) {
                    selectedCount.textContent =
                        `Đã chọn ${checkedRows.length}/${bulkRows.length} nguyên liệu`;
                }
                if (selectAll) {
                    selectAll.disabled = bulkProcessing || selectableRows.length === 0;
                    selectAll.checked =
                        selectableRows.length > 0
                        && checkedRows.length === selectableRows.length;
                    selectAll.indeterminate =
                        checkedRows.length > 0
                        && checkedRows.length < selectableRows.length;
                }
                if (bulkConfirm) {
                    bulkConfirm.disabled = bulkProcessing || checkedRows.length === 0;
                    bulkConfirm.textContent = bulkRows.some(row =>
                        row.dataset.state !== 'pending')
                        ? 'Thử lại các dòng đã chọn'
                        : 'Tạo yêu cầu nhập đã chọn';
                }
            };

            selectAll?.addEventListener('change', () => {
                getSelectableRows().forEach(row => {
                    const checkbox = row.querySelector('.js-reorder-bulk-select');
                    checkbox.checked = selectAll.checked;
                });
                updateBulkSelection();
            });

            bulkRows.forEach(row => {
                row.querySelector('.js-reorder-bulk-select')
                    ?.addEventListener('change', updateBulkSelection);
            });

            reloadButton?.addEventListener('click', () => window.location.reload());

            bulkConfirm?.addEventListener('click', async () => {
                const selectedRows = getSelectableRows().filter(row =>
                    row.querySelector('.js-reorder-bulk-select')?.checked);
                if (selectedRows.length === 0)
                    return;

                const confirmation = await Swal.fire({
                    icon: 'question',
                    title: 'Xác nhận tạo yêu cầu nhập',
                    text: `Hệ thống sẽ lần lượt xác nhận ${selectedRows.length} nguyên liệu. Tiếp tục?`,
                    showCancelButton: true,
                    confirmButtonText: 'Xác nhận tạo',
                    cancelButtonText: 'Kiểm tra lại',
                    reverseButtons: true
                });
                if (!confirmation.isConfirmed)
                    return;

                bulkProcessing = true;
                bulkRows.forEach(row => {
                    const checkbox = row.querySelector('.js-reorder-bulk-select');
                    if (checkbox)
                        checkbox.disabled = true;
                });
                if (bulkProgress) {
                    bulkProgress.textContent =
                        `Đang xử lý 0/${selectedRows.length} nguyên liệu...`;
                }
                updateBulkSelection();

                let completed = 0;
                for (const row of selectedRows) {
                    const ingredientName =
                        row.dataset.ingredientName || 'Nguyên liệu';
                    row.dataset.requestKey ||= crypto.randomUUID();
                    setBulkResult(row, 'processing', 'Đang xác nhận...');

                    try {
                        const data = await postForm(confirmEndpoint, {
                            storeId: row.dataset.storeId,
                            ingredientId: row.dataset.ingredientId,
                            suggestionToken: row.dataset.suggestionToken,
                            requestKey: row.dataset.requestKey
                        });
                        const requestId = data.data?.restockRequestId;
                        setBulkResult(
                            row,
                            'success',
                            data.data?.message || 'Đã tạo yêu cầu nhập.',
                            requestId);
                        const checkbox = row.querySelector('.js-reorder-bulk-select');
                        if (checkbox)
                            checkbox.checked = false;
                    } catch (error) {
                        const requiresReload =
                            reloadRequiredCodes.has(error.code);
                        const forbidden =
                            error.status === 403
                            || error.code === 'REORDER_CONFIRM_UNAUTHORIZED';
                        const state = requiresReload
                            ? 'reload'
                            : forbidden
                                ? 'blocked'
                                : 'retry';
                        const prefix = requiresReload
                            ? 'Cần tải lại dữ liệu: '
                            : forbidden
                                ? 'Không có quyền: '
                                : 'Có thể thử lại: ';
                        setBulkResult(
                            row,
                            state,
                            `${prefix}${error.message}`);
                    } finally {
                        completed += 1;
                        if (bulkProgress) {
                            bulkProgress.textContent =
                                `Đang xử lý ${completed}/${selectedRows.length}: ${ingredientName}`;
                        }
                    }
                }

                bulkProcessing = false;
                bulkRows.forEach(row => {
                    const checkbox = row.querySelector('.js-reorder-bulk-select');
                    if (!checkbox)
                        return;

                    const retryable =
                        row.dataset.state === 'pending'
                        || row.dataset.state === 'retry';
                    checkbox.disabled = !retryable;
                    if (row.dataset.state === 'retry')
                        checkbox.checked = true;
                });

                const succeeded = bulkRows.filter(row =>
                    row.dataset.state === 'success').length;
                const retryable = bulkRows.filter(row =>
                    row.dataset.state === 'retry').length;
                const needsReload = bulkRows.filter(row =>
                    row.dataset.state === 'reload').length;
                if (bulkProgress) {
                    bulkProgress.textContent =
                        `Hoàn tất: ${succeeded} thành công`
                        + (retryable ? ` · ${retryable} có thể thử lại` : '')
                        + (needsReload ? ` · ${needsReload} cần tải lại` : '');
                }
                if (reloadButton)
                    reloadButton.hidden = false;
                updateBulkSelection();
            });

            updateBulkSelection();

            if (bulkRows.length > 0
                && bulkModalElement?.dataset.autoOpen === 'true'
                && window.bootstrap?.Modal) {
                requestAnimationFrame(() => {
                    bootstrap.Modal.getOrCreateInstance(bulkModalElement).show();
                });
            }
        })();
    </script>
}
