@model CafeChain.Application.DTOs.Admin.Procurement.ReorderSuggestionListDto
@using CafeChain.Application.Constants
@{
    ViewData["Title"] = "Gợi ý nhập hàng";
    var stores = ViewBag.Stores as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
        ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var selectedStoreId = (int?)ViewBag.SelectedStoreId ?? Model.StoreId;
    var canCreateDraft = (bool?)ViewBag.CanCreateDraft == true;
    var labels = new Dictionary<string, string>
    {
        [ReorderSuggestionStatuses.Ready] = "Sẵn sàng",
        [ReorderSuggestionStatuses.NoReorderNeeded] = "Chưa cần nhập",
        [ReorderSuggestionStatuses.InsufficientHistory] = "Thiếu lịch sử",
        [ReorderSuggestionStatuses.MissingThreshold] = "Thiếu ngưỡng tồn",
        [ReorderSuggestionStatuses.NoActiveSupplier] = "Thiếu nguồn cung",
        [ReorderSuggestionStatuses.InvalidConversion] = "Sai quy cách gói",
        [ReorderSuggestionStatuses.MissingLeadTime] = "Thiếu thời gian giao",
        [ReorderSuggestionStatuses.MissingCost] = "Thiếu giá mua",
        [ReorderSuggestionStatuses.IncomingCoversDemand] = "Hàng về đã đủ",
        [ReorderSuggestionStatuses.ProcurementInProgress] = "Đang mua hàng",
        [ReorderSuggestionStatuses.Unknown] = "Chưa xác định"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/Procurement/reorder-suggestions.css" asp-append-version="true" />
}

<main class="reorder-page cc-page">
    <div class="d-none" aria-hidden="true">@Html.AntiForgeryToken()</div>
    <header class="reorder-header cc-page-header">
        <div>
            <p class="reorder-eyebrow cc-page-kicker">Kho &amp; Cung ứng / Lập kế hoạch</p>
            <h1 class="cc-page-title">Gợi ý nhập hàng</h1>
            <p class="cc-page-description">Phân tích tiêu thụ, tồn khả dụng, ngưỡng an toàn và quy cách mua theo cửa hàng.</p>
        </div>
        <a asp-controller="AdminRestockRequests" asp-action="Index" class="cc-button">
            <i class="fas fa-list-check" aria-hidden="true"></i> Xem yêu cầu nhập
        </a>
    </header>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="ops-notice ops-notice-success" role="status">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="ops-notice ops-notice-error" role="alert">@error</div>
    }
    @if (ViewBag.ErrorMessage is string loadError)
    {
        <div class="ops-notice ops-notice-error" role="alert">@loadError</div>
    }

    <form method="get" class="reorder-filters">
        <div>
            <label for="storeId">Cửa hàng</label>
            <select id="storeId" name="storeId" class="form-select">
                @foreach (var store in stores)
                {
                    <option value="@store.Value" selected="@(store.Value == selectedStoreId.ToString())">@store.Text</option>
                }
            </select>
        </div>
        <div>
            <label for="analysisWindowDays">Kỳ phân tích</label>
            <select id="analysisWindowDays" name="analysisWindowDays" class="form-select">
                <option value="30" selected="@(Model.AnalysisWindowDays == 30)">30 ngày</option>
                <option value="60" selected="@(Model.AnalysisWindowDays == 60)">60 ngày</option>
                <option value="90" selected="@(Model.AnalysisWindowDays == 90)">90 ngày</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary"><i class="fas fa-rotate" aria-hidden="true"></i> Tính lại</button>
    </form>

    <div class="reorder-note" role="note">
        <i class="fas fa-circle-info" aria-hidden="true"></i>
        Đây là gợi ý đọc dữ liệu, không tự đặt hàng. “Tạo/mở cảnh báo” đưa nguyên liệu vào bước xác nhận trước khi lập yêu cầu nhập nháp.
    </div>

    <section class="reorder-table-shell" aria-label="Danh sách gợi ý nhập hàng">
        @if (!Model.Items.Any())
        {
            <div class="reorder-empty cc-empty-state">
                <i class="fas fa-box-open" aria-hidden="true"></i>
                <h2>Chưa có dữ liệu gợi ý</h2>
                <p>Chọn cửa hàng có tồn kho nguyên liệu để bắt đầu phân tích, hoặc mở danh sách yêu cầu bổ sung để kiểm tra nhu cầu hiện tại.</p>
                <a asp-controller="AdminRestockRequests" asp-action="Index" class="cc-button mt-3">Xem yêu cầu bổ sung</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table reorder-table align-middle">
                    <thead>
                        <tr>
                            <th>Nguyên liệu</th>
                            <th>Tồn / giữ chỗ / khả dụng</th>
                            <th>Ngưỡng tối thiểu</th>
                            <th>Dùng/ngày</th>
                            <th>Lead time</th>
                            <th>Đang về</th>
                            <th>Tồn dự kiến</th>
                            <th>Đề xuất</th>
                            <th>Nhà cung cấp</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var ready = item.Status == ReorderSuggestionStatuses.Ready;
                        <tr id="ingredient-@item.IngredientId">
                            <td>
                                <strong>@item.IngredientName</strong>
                                <span>@item.IngredientCode</span>
                            </td>
                            <td>
                                <strong>@item.UsableQuantity.ToString("N3") @item.BaseUnitCode</strong>
                                <span>Tồn @item.AvailableQuantity.ToString("N3") · giữ @item.ReservedQuantity.ToString("N3")</span>
                            </td>
                            <td>@(item.MinLevel?.ToString("N3") ?? "-")</td>
                            <td>@(item.AverageDailyUsage?.ToString("N3") ?? "-")</td>
                            <td>@(item.LeadTimeDays.HasValue ? $"{item.LeadTimeDays} ngày" : "-")</td>
                            <td>@item.IncomingApprovedPoQuantity.ToString("N3")</td>
                            <td>@item.ProjectedQuantity.ToString("N3") @item.BaseUnitCode</td>
                            <td>
                                <strong>@(item.SuggestedBaseQuantity?.ToString("N3") ?? "-") @item.BaseUnitCode</strong>
                                @if (item.SuggestedPackageCount.HasValue)
                                {
                                    <span>@item.SuggestedPackageCount gói · @((item.EstimatedAmount ?? 0).ToString("N0"))đ</span>
                                }
                            </td>
                            <td>
                                <strong>@(item.SupplierName ?? "-")</strong>
                                @if (item.PackagePrice.HasValue)
                                {
                                    <span>@item.PackagePrice.Value.ToString("N0")đ/gói</span>
                                }
                            </td>
                            <td>
                                <span class="reorder-status reorder-status--@item.Status.ToLowerInvariant()">@(labels.GetValueOrDefault(item.Status, item.Status))</span>
                                <small>@item.Reason</small>
                            </td>
                            <td class="text-end">
                                <button type="button"
                                        class="cc-button js-reorder-explain"
                                        data-store-id="@item.StoreId"
                                        data-ingredient-id="@item.IngredientId">
                                    Xem giải thích AI
                                </button>
                                @if (item.ActiveRestockRequestId.HasValue)
                                {
                                    <a asp-controller="AdminRestockRequests" asp-action="Details" asp-route-id="@item.ActiveRestockRequestId" class="cc-button">Xem yêu cầu</a>
                                }
                                else
                                {
                                    <form asp-action="CreateDraft" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="storeId" value="@item.StoreId" />
                                        <input type="hidden" name="ingredientId" value="@item.IngredientId" />
                                        <button type="submit" class="cc-button cc-button-primary" disabled="@(!ready || !canCreateDraft)">Tạo/mở cảnh báo</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</main>

@section Scripts {
    <script>
        (() => {
            const endpoint = '@Url.Action("Explain", "AdminReorderSuggestions")';
            const windowDays = @Model.AnalysisWindowDays;
            document.querySelectorAll('.js-reorder-explain').forEach(button => {
                button.addEventListener('click', async () => {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    const body = new URLSearchParams({
                        storeId: button.dataset.storeId,
                        ingredientId: button.dataset.ingredientId,
                        analysisWindowDays: String(windowDays),
                        __RequestVerificationToken: token || ''
                    });
                    button.disabled = true;
                    try {
                        const response = await fetch(endpoint, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                            body
                        });
                        const data = await response.json();
                        if (!response.ok || !data.success) throw new Error(data.message || 'Không tạo được giải thích.');
                        await Swal.fire({
                            icon: data.usedOllama ? 'info' : 'warning',
                            title: data.usedOllama ? 'Giải thích AI' : 'Giải thích theo rule',
                            text: data.explanation,
                            confirmButtonText: 'Đóng'
                        });
                    } catch (error) {
                        await Swal.fire({ icon: 'error', title: 'Không thể giải thích', text: error.message });
                    } finally {
                        button.disabled = false;
                    }
                });
            });
        })();
    </script>
}
