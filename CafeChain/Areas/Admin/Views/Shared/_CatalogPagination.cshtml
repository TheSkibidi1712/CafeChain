@model CafeChain.ViewModels.Admin.Shared.AdminCatalogPaginationVM
@{
    var totalPages = Math.Max(1, Model.TotalPages);
    var currentPage = Math.Min(Math.Max(1, Model.PageIndex), totalPages);
    var startItem = Model.TotalCount == 0 ? 0 : ((currentPage - 1) * Model.PageSize) + 1;
    var endItem = Model.TotalCount == 0 ? 0 : Math.Min(startItem + Model.CurrentItemCount - 1, Model.TotalCount);
    var fromPage = Math.Max(1, currentPage - 2);
    var toPage = Math.Min(totalPages, currentPage + 2);
}

<div class="catalog-table-footer">
    <span>Hiển thị @startItem-@endItem trong số @Model.TotalCount</span>

    <nav class="catalog-pagination" aria-label="Phân trang danh sách">
        <a asp-action="Index"
           asp-route-keyword="@Model.Keyword"
           asp-route-active="@Model.Active"
           asp-route-page="@(currentPage - 1)"
           asp-route-pageSize="@Model.PageSize"
           class="@(currentPage > 1 ? null : "disabled")"
           aria-disabled="@(currentPage > 1 ? "false" : "true")"
           aria-label="Trang trước"><i class="fas fa-chevron-left"></i></a>

        @if (fromPage > 1)
        {
            <a asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-active="@Model.Active" asp-route-page="1" asp-route-pageSize="@Model.PageSize">1</a>
            @if (fromPage > 2) { <span>...</span> }
        }

        @for (var pageNumber = fromPage; pageNumber <= toPage; pageNumber++)
        {
            <a asp-action="Index"
               asp-route-keyword="@Model.Keyword"
               asp-route-active="@Model.Active"
               asp-route-page="@pageNumber"
               asp-route-pageSize="@Model.PageSize"
               class="@(pageNumber == currentPage ? "active" : null)"
               aria-current="@(pageNumber == currentPage ? "page" : null)">@pageNumber</a>
        }

        @if (toPage < totalPages)
        {
            @if (toPage < totalPages - 1) { <span>...</span> }
            <a asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-active="@Model.Active" asp-route-page="@totalPages" asp-route-pageSize="@Model.PageSize">@totalPages</a>
        }

        <a asp-action="Index"
           asp-route-keyword="@Model.Keyword"
           asp-route-active="@Model.Active"
           asp-route-page="@(currentPage + 1)"
           asp-route-pageSize="@Model.PageSize"
           class="@(currentPage < totalPages ? null : "disabled")"
           aria-disabled="@(currentPage < totalPages ? "false" : "true")"
           aria-label="Trang sau"><i class="fas fa-chevron-right"></i></a>
    </nav>
</div>
