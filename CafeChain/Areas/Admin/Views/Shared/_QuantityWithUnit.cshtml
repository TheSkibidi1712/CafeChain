@model (decimal? Quantity, string? Unit, string? AriaLabel)
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<CafeChain.SharedResource> SharedText
@{
    var qty = Model.Quantity;
    var unit = Model.Unit ?? "";
    var aria = Model.AriaLabel ?? SharedText["Common.QuantityAndUnit"];
    var text = qty.HasValue
        ? $"{qty.Value.ToString("0.####", System.Globalization.CultureInfo.CurrentCulture)} {unit}".Trim()
        : "—";
}
<span class="font-monospace" aria-label="@aria">@text</span>
