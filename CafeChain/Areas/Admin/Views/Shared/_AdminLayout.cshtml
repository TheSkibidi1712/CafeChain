@using CafeChain.Helpers
@{
    var isAdminArea = ViewContext.RouteData.Values["area"]?.ToString() == "Admin";
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CafeChain Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
    <link rel="stylesheet" href="~/css/toast/toast.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* ========== BASE ========== */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9fa;
        }

        /* ========== SIDEBAR ========== */
        .sidebar {
            height: 100vh;
            background-color: #ffffff;
            border-right: 1px solid #e9ecef;
            position: fixed;
            width: 260px;
            left: 0;
            top: 0;
            padding-top: 20px;
            overflow-y: auto;
            overflow-x: hidden;
            z-index: 1000;
        }

        /* Scrollbar styling */
        .sidebar::-webkit-scrollbar {
            width: 4px;
        }
        .sidebar::-webkit-scrollbar-track {
            background: transparent;
        }
        .sidebar::-webkit-scrollbar-thumb {
            background: #e2e8f0;
            border-radius: 4px;
        }
        .sidebar::-webkit-scrollbar-thumb:hover {
            background: #cbd5e1;
        }

        /* --- Sidebar links --- */
        .sidebar a {
            padding: 10px 20px;
            display: block;
            color: #495057;
            text-decoration: none;
            font-weight: 500;
            font-size: 13.5px;
            transition: all 0.15s ease;
            border-right: 3px solid transparent;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background-color: #fdf2f0;
            color: #d93d20;
            border-right: 3px solid #d93d20;
        }

        .sidebar a i {
            width: 22px;
            text-align: center;
            margin-right: 10px;
            font-size: 14px;
        }

        /* --- Section Headers (Group parent toggle) --- */
        .sidebar-section-header {
            display: flex;
            align-items: center;
            padding: 10px 20px;
            color: #495057;
            text-decoration: none;
            font-weight: 600;
            font-size: 13.5px;
            cursor: pointer;
            transition: all 0.15s ease;
            border-right: 3px solid transparent;
            user-select: none;
        }
        .sidebar-section-header:hover {
            background-color: #f8fafc;
            color: #d93d20;
        }
        .sidebar-section-header.active {
            background-color: #fdf2f0;
            color: #d93d20;
        }
        .sidebar-section-header i.section-icon {
            width: 22px;
            text-align: center;
            margin-right: 10px;
            font-size: 14px;
        }
        .sidebar-section-header .chevron {
            margin-left: auto;
            font-size: 10px;
            transition: transform 0.2s ease;
            color: #adb5bd;
        }
        .sidebar-section-header[aria-expanded="true"] .chevron {
            transform: rotate(180deg);
        }

        /* --- Sub-items (inside collapse) --- */
        .sidebar-sub {
            background-color: #fafbfc;
            border-left: 2px solid #e9ecef;
            margin-left: 28px;
        }
        .sidebar-sub a {
            padding: 8px 15px;
            font-size: 13px;
            font-weight: 400;
            color: #64748b;
        }
        .sidebar-sub a i {
            font-size: 8px;
            width: 14px;
            margin-right: 8px;
            color: #94a3b8;
        }
        .sidebar-sub a:hover,
        .sidebar-sub a.active {
            color: #d93d20;
            background-color: #fef2f0;
        }
        .sidebar-sub a.active i,
        .sidebar-sub a:hover i {
            color: #d93d20;
        }

        /* --- Dividers --- */
        .sidebar-divider {
            height: 1px;
            background-color: #f1f5f9;
            margin: 8px 16px;
        }

        /* ========== LOGO ========== */
        .logo-wrap {
            display: flex;
            align-items: center;
            padding: 0 20px 20px;
            margin-bottom: 12px;
            border-bottom: 1px solid #e9ecef;
        }

        .logo-icon {
            background: linear-gradient(135deg, #d93d20, #e85d3a);
            color: white;
            border-radius: 10px;
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
            font-weight: 800;
            font-size: 16px;
            box-shadow: 0 2px 8px rgba(217, 61, 32, 0.25);
        }

        .logo-text {
            font-size: 18px;
            font-weight: 700;
            color: #212529;
            line-height: 1.2;
        }

        .logo-sub {
            font-size: 11px;
            color: #94a3b8;
            font-weight: 500;
        }

        /* ========== MAIN CONTENT ========== */
        .main-content {
            margin-left: 260px;
            padding: 30px;
        }

        .topbar {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding-bottom: 20px;
            margin-bottom: 30px;
            border-bottom: 1px solid #e9ecef;
        }

        /* ========== TOAST ========== */
        #toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 999999;
        }

        /* ========== SYSTEM SECTION (bottom) ========== */
        .sidebar-system {
            margin-top: auto;
            border-top: 1px solid #f1f5f9;
            padding-top: 8px;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="sidebar d-flex flex-column">
        <!-- ===== LOGO ===== -->
        <div class="logo-wrap">
            <div class="logo-icon">C</div>
            <div>
                <div class="logo-text">CafeChain</div>
                <div class="logo-sub">Admin Dashboard</div>
            </div>
        </div>

        <!-- ===== SCROLLABLE NAV ===== -->
        <div style="flex: 1; overflow-y: auto; overflow-x: hidden;">

            <!-- ━━━ 📊 TỔNG QUAN (Direct link) ━━━ -->
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="@Html.IsActive("Dashboard")">
                <i class="fas fa-chart-pie"></i> Tổng quan
            </a>

            <div class="sidebar-divider"></div>

            @using Microsoft.AspNetCore.Authorization
            @inject IAuthorizationService AuthorizationService

            @if ((await AuthorizationService.AuthorizeAsync(User, "RequireAdminPanelAccess")).Succeeded)
            {
                <!-- ━━━ ☕ SẢN PHẨM ━━━ -->
                <a href="#collapseProducts" data-bs-toggle="collapse"
                   aria-expanded="@(Html.IsActive("AdminCategory,AdminDrink,AdminSize,AdminTopping") != "" ? "true" : "false")"
                   class="sidebar-section-header @Html.IsActive("AdminCategory,AdminDrink,AdminSize,AdminTopping")">
                    <i class="fas fa-mug-hot section-icon"></i> Sản phẩm
                    <i class="fas fa-chevron-down chevron"></i>
                </a>
                <div class="collapse @Html.IsActive("AdminCategory,AdminDrink,AdminSize,AdminTopping", cssClass: "show")" id="collapseProducts">
                    <div class="sidebar-sub">
                        <a asp-area="Admin" asp-controller="AdminCategory" asp-action="Index" class="@Html.IsActive("AdminCategory")"><i class="fas fa-circle"></i> Danh mục</a>
                        <a asp-area="Admin" asp-controller="AdminDrink" asp-action="Index" class="@Html.IsActive("AdminDrink")"><i class="fas fa-circle"></i> Đồ uống</a>
                        <a asp-area="Admin" asp-controller="AdminSize" asp-action="Index" class="@Html.IsActive("AdminSize")"><i class="fas fa-circle"></i> Size</a>
                        <a asp-area="Admin" asp-controller="AdminTopping" asp-action="Index" class="@Html.IsActive("AdminTopping")"><i class="fas fa-circle"></i> Topping</a>
                    </div>
                </div>

                <!-- ━━━ 🧪 SẢN XUẤT / BOM ━━━ -->
                <a href="#collapseProduction" data-bs-toggle="collapse"
                   aria-expanded="@(Html.IsActive("AdminRecipe,AdminProductionOrder") != "" ? "true" : "false")"
                   class="sidebar-section-header @Html.IsActive("AdminRecipe,AdminProductionOrder")">
                    <i class="fas fa-flask section-icon"></i> Sản xuất / BOM
                    <i class="fas fa-chevron-down chevron"></i>
                </a>
                <div class="collapse @Html.IsActive("AdminRecipe,AdminProductionOrder", cssClass: "show")" id="collapseProduction">
                    <div class="sidebar-sub">
                        <a asp-area="Admin" asp-controller="AdminRecipe" asp-action="Index" class="@Html.IsActive("AdminRecipe")"><i class="fas fa-circle"></i> Cấu trúc BOM</a>
                        <a asp-area="Admin" asp-controller="AdminProductionOrder" asp-action="Create" class="@Html.IsActive("AdminProductionOrder")"><i class="fas fa-circle"></i> Lệnh Sơ Chế</a>
                    </div>
                </div>

                <!-- ━━━ 📦 KHO & CUNG ỨNG ━━━ -->
                <a href="#collapseInventory" data-bs-toggle="collapse"
                   aria-expanded="@(Html.IsActive("AdminStoreInventory,AdminIngredient,AdminUnitConversion,AdminInventorydocument,AdminSupplier") != "" ? "true" : "false")"
                   class="sidebar-section-header @Html.IsActive("AdminStoreInventory,AdminIngredient,AdminUnitConversion,AdminInventorydocument,AdminSupplier")">
                    <i class="fas fa-warehouse section-icon"></i> Kho & Cung ứng
                    <i class="fas fa-chevron-down chevron"></i>
                </a>
                <div class="collapse @Html.IsActive("AdminStoreInventory,AdminIngredient,AdminUnitConversion,AdminInventorydocument,AdminSupplier", cssClass: "show")" id="collapseInventory">
                    <div class="sidebar-sub">
                        <a asp-area="Admin" asp-controller="AdminStoreInventory" asp-action="Index" class="@Html.IsActive("AdminStoreInventory")"><i class="fas fa-circle"></i> Tồn kho cửa hàng</a>
                        <a asp-area="Admin" asp-controller="AdminIngredient" asp-action="Index" class="@Html.IsActive("AdminIngredient")"><i class="fas fa-circle"></i> Nguyên liệu</a>
                        <a asp-area="Admin" asp-controller="AdminUnitConversion" asp-action="Index" class="@Html.IsActive("AdminUnitConversion")"><i class="fas fa-circle"></i> Quy đổi đơn vị</a>
                        <a asp-area="Admin" asp-controller="AdminInventorydocument" asp-action="Index" class="@Html.IsActive("AdminInventorydocument")"><i class="fas fa-circle"></i> Phiếu xuất nhập kho</a>
                        <a asp-area="Admin" asp-controller="AdminSupplier" asp-action="Index" class="@Html.IsActive("AdminSupplier")"><i class="fas fa-circle"></i> Nhà cung cấp</a>
                    </div>
                </div>

                <!-- ━━━ 🛒 ĐƠN HÀNG & BÁN HÀNG ━━━ -->
                <a href="#collapseOrders" data-bs-toggle="collapse"
                   aria-expanded="@(Html.IsActive("AdminOrder") != "" ? "true" : "false")"
                   class="sidebar-section-header @Html.IsActive("AdminOrder")">
                    <i class="fas fa-receipt section-icon"></i> Đơn hàng
                    <i class="fas fa-chevron-down chevron"></i>
                </a>
                <div class="collapse @Html.IsActive("AdminOrder", cssClass: "show")" id="collapseOrders">
                    <div class="sidebar-sub">
                        <a asp-area="Admin" asp-controller="AdminOrder" asp-action="Index" class="@Html.IsActive("AdminOrder", "Index")"><i class="fas fa-circle"></i> Bảng điều phối</a>
                        <a asp-area="Admin" asp-controller="AdminOrder" asp-action="History" class="@Html.IsActive("AdminOrder", "History")"><i class="fas fa-circle"></i> Lịch sử đơn hàng</a>
                    </div>
                </div>

                <!-- ━━━ 🎁 KHUYẾN MÃI & MARKETING ━━━ -->
                <a href="#collapsePromo" data-bs-toggle="collapse"
                   aria-expanded="@(Html.IsActive("AdminVoucher,AdminWheel") != "" ? "true" : "false")"
                   class="sidebar-section-header @Html.IsActive("AdminVoucher,AdminWheel")">
                    <i class="fas fa-tags section-icon"></i> Khuyến mãi
                    <i class="fas fa-chevron-down chevron"></i>
                </a>
                <div class="collapse @Html.IsActive("AdminVoucher,AdminWheel", cssClass: "show")" id="collapsePromo">
                    <div class="sidebar-sub">
                        <a asp-area="Admin" asp-controller="AdminVoucher" asp-action="Index" class="@Html.IsActive("AdminVoucher")"><i class="fas fa-circle"></i> Voucher</a>
                        <a asp-area="Admin" asp-controller="AdminWheel" asp-action="Index" class="@Html.IsActive("AdminWheel")"><i class="fas fa-circle"></i> Vòng quay may mắn</a>
                    </div>
                </div>
            }

            <div class="sidebar-divider"></div>

            <!-- ━━━ 👥 NHÂN SỰ & VẬN HÀNH ━━━ -->
            @{
                var hrControllers = "AdminStaff,AdminStaffShift,AdminStoreIP,AdminStore";
                var isHrGroupActive = Html.IsActive(hrControllers) != "";
            }

            @if (User.IsInRole("Super Admin") || User.IsInRole("CEO / Ban Giám đốc") || User.IsInRole("Quản lý Khu vực") || User.IsInRole("Cửa hàng trưởng") || User.IsInRole("Quản lý Nhân sự") || User.IsInRole("Giám đốc Vận hành"))
            {
                <a href="#collapseHR" data-bs-toggle="collapse"
                   aria-expanded="@(isHrGroupActive ? "true" : "false")"
                   class="sidebar-section-header @(isHrGroupActive ? "active" : "")">
                    <i class="fas fa-users-cog section-icon"></i> Nhân sự & Vận hành
                    <i class="fas fa-chevron-down chevron"></i>
                </a>
                <div class="collapse @(isHrGroupActive ? "show" : "")" id="collapseHR">
                    <div class="sidebar-sub">
                        @if (User.IsInRole("Super Admin") || User.IsInRole("CEO / Ban Giám đốc") || User.IsInRole("Quản lý Khu vực") || User.IsInRole("Cửa hàng trưởng") || User.IsInRole("Quản lý Nhân sự"))
                        {
                            <a asp-area="Admin" asp-controller="AdminStaff" asp-action="Index" class="@Html.IsActive("AdminStaff")"><i class="fas fa-circle"></i> Quản lý nhân viên</a>
                        }

                        @if (User.IsInRole("Super Admin") || User.IsInRole("CEO / Ban Giám đốc") || User.IsInRole("Cửa hàng trưởng") || User.IsInRole("Quản lý Khu vực"))
                        {
                            <a asp-area="Admin" asp-controller="AdminStaffShift" asp-action="Index" class="@Html.IsActive("AdminStaffShift")"><i class="fas fa-circle"></i> Lịch làm việc</a>
                        }

                        @if (User.IsInRole("Super Admin") || User.IsInRole("CEO / Ban Giám đốc") || User.IsInRole("Cửa hàng trưởng"))
                        {
                            <a asp-area="Admin" asp-controller="AdminStoreIP" asp-action="Index" class="@Html.IsActive("AdminStoreIP")"><i class="fas fa-circle"></i> IP chấm công</a>
                        }

                        @if (User.IsInRole("Super Admin") || User.IsInRole("CEO / Ban Giám đốc") || User.IsInRole("Giám đốc Vận hành"))
                        {
                            <a asp-area="Admin" asp-controller="AdminStore" asp-action="Index" class="@Html.IsActive("AdminStore")"><i class="fas fa-circle"></i> Quản lý cửa hàng</a>
                        }
                    </div>
                </div>
            }

        </div><!-- end scrollable nav -->

        <!-- ===== SYSTEM SECTION (pinned to bottom) ===== -->
        <div class="sidebar-system">
            <a asp-area="" asp-controller="Profile" asp-action="MyProfile" class="@Html.IsActive("Profile")">
                <i class="fas fa-user-circle"></i> Hồ sơ của tôi
            </a>

            @if (User.Identity != null && User.Identity.IsAuthenticated && RoleHelper.IsAdminGroup(User))
            {
                @if (isAdminArea)
                {
                    <a asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-arrow-left"></i> Quay lại trang chủ
                    </a>
                }
            }

            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" style="padding: 4px 0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-link shadow-none" style="text-decoration:none; color:#dc3545; font-weight: 500; font-size:13.5px; padding: 10px 20px; width: 100%; text-align: left;">
                    <i class="fas fa-sign-out-alt" style="width: 22px; text-align: center; margin-right: 10px;"></i> Đăng xuất
                </button>
            </form>
        </div>
    </div>

    <div class="main-content">
        <div class="topbar">
            <!-- Notification Sound Toggle -->
            <button id="globalSoundToggle" class="btn btn-link text-muted shadow-none p-0 me-3" title="Âm thanh thông báo">
                <i class="fas fa-bell-slash" id="globalSoundIcon"></i>
            </button>
            <i class="fas fa-user-circle text-muted fs-4"></i>
        </div>
        @RenderBody()
    </div>

    <!-- Toast Container -->
    <div id="toast-container"></div>

    <!-- Bootstrap & Plugins -->
    <script src="~/js/toast/toast.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <!-- Select2 (Global for BOM ecosystem) -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
