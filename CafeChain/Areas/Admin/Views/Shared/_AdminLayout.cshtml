@using CafeChain.Helpers
@using System.Security.Claims
@using CafeChain.Application.Constants
@using CafeChain.Application.Constants.Cloudinaries
@using CafeChain.Application.Interfaces.Admin.Permissions
@inject IAdminPermissionService PermissionService

@{
    var isAdminArea =
        ViewContext.RouteData.Values["area"]?.ToString() == "Admin";

    var canManagePermissions = false;
    var canAccessDashboard = false;
    var effectivePermissions = new HashSet<string>(StringComparer.Ordinal);

    var currentAccountIdValue =
        User.FindFirstValue(ClaimTypes.NameIdentifier);
    var currentStaffName = User.FindFirstValue(ClaimTypes.Name);
    if (string.IsNullOrWhiteSpace(currentStaffName))
    {
        currentStaffName = "Nhân viên";
    }
    var currentAvatarUrl = User.FindFirstValue("AvatarUrl");
    if (string.IsNullOrWhiteSpace(currentAvatarUrl))
    {
        currentAvatarUrl = DefaultImages.StaffAvatarUrl;
    }

    if (User.Identity?.IsAuthenticated == true &&
        int.TryParse(currentAccountIdValue, out var currentAccountId))
    {
        var snapshot = await PermissionService.GetEffectivePermissionCodesAsync(currentAccountId);
        effectivePermissions = snapshot.Data ?? new HashSet<string>(StringComparer.Ordinal);
        canManagePermissions = effectivePermissions.Contains(PermissionConstants.SystemPermissionManage);
        canAccessDashboard = effectivePermissions.Contains(PermissionConstants.AppAdminDashboard);
    }

    var canAccessProduction = effectivePermissions.Overlaps(new[]
    {
        PermissionConstants.PreparedItemView,
        PermissionConstants.RecipeView,
        PermissionConstants.ProductionOrderView
    });
    var canAccessInventory = effectivePermissions.Overlaps(new[]
    {
        PermissionConstants.InventoryView,
        PermissionConstants.InventoryThresholdView,
        PermissionConstants.StockAlertView,
        PermissionConstants.OperationalIceView,
        PermissionConstants.RestockView,
        PermissionConstants.ReorderSuggestionView,
        PermissionConstants.PurchaseAdviceView,
        PermissionConstants.PurchaseAdviceConsolidate,
        PermissionConstants.PurchaseOrderViewBatch,
        PermissionConstants.PurchaseOrderView,
        PermissionConstants.SupplierQualityView,
        PermissionConstants.IngredientView,
        PermissionConstants.UnitConversionView,
        PermissionConstants.SupplierView,
        PermissionConstants.ReceiptView
    });
    var canAccessInventoryDocuments = effectivePermissions.Contains(PermissionConstants.InventoryDocumentView)
        || effectivePermissions.Contains(PermissionConstants.InventoryTransferView);
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CafeChain Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
    <link rel="stylesheet" href="~/css/toast/toast.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* ========== BASE ========== */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9fa;
        }

        /* ========== SIDEBAR ========== */
        .sidebar {
            height: 100vh;
            background-color: #ffffff;
            border-right: 1px solid #e9ecef;
            position: fixed;
            width: 260px;
            left: 0;
            top: 0;
            padding-top: 20px;
            overflow-y: auto;
            overflow-x: hidden;
            z-index: 1000;
        }

        /* Scrollbar styling */
        .sidebar::-webkit-scrollbar {
            width: 4px;
        }
        .sidebar::-webkit-scrollbar-track {
            background: transparent;
        }
        .sidebar::-webkit-scrollbar-thumb {
            background: #e2e8f0;
            border-radius: 4px;
        }
        .sidebar::-webkit-scrollbar-thumb:hover {
            background: #cbd5e1;
        }

        /* --- Sidebar links --- */
        .sidebar a {
            padding: 10px 20px;
            display: block;
            color: #495057;
            text-decoration: none;
            font-weight: 500;
            font-size: 13.5px;
            transition: all 0.15s ease;
            border-right: 3px solid transparent;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background-color: #f5ede3;
            color: #5c3f2b;
            border-right: 3px solid #6f4e37;
        }

        .sidebar a i {
            width: 22px;
            text-align: center;
            margin-right: 10px;
            font-size: 14px;
        }

        /* --- Section Headers (Group parent toggle) --- */
        .sidebar-section-header {
            display: flex;
            align-items: center;
            padding: 10px 20px;
            color: #495057;
            text-decoration: none;
            font-weight: 600;
            font-size: 13.5px;
            cursor: pointer;
            transition: all 0.15s ease;
            border-right: 3px solid transparent;
            user-select: none;
        }
        .sidebar-section-header:hover {
            background-color: #f5ede3;
            color: #5c3f2b;
        }
        .sidebar-section-header.active {
            background-color: #f5ede3;
            color: #5c3f2b;
            border-right-color: #6f4e37;
        }
        .sidebar-section-header i.section-icon {
            width: 22px;
            text-align: center;
            margin-right: 10px;
            font-size: 14px;
        }
        .sidebar-section-header .chevron {
            margin-left: auto;
            font-size: 10px;
            transition: transform 0.2s ease;
            color: #adb5bd;
        }
        .sidebar-section-header[aria-expanded="true"] .chevron {
            transform: rotate(180deg);
        }

        /* --- Sub-items (inside collapse) --- */
        .sidebar-sub {
            background-color: #fafbfc;
            border-left: 2px solid #e9ecef;
            margin-left: 18px !important;
        }
        .sidebar-sub a {
            padding: 7px 8px !important;
            font-size: 12.5px !important;
            font-weight: 400 !important;
            color: #64748b;
            white-space: nowrap !important;
            word-break: keep-all !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            display: flex !important;
            align-items: center !important;
        }
        .sidebar-sub a i {
            font-size: 8px !important;
            width: 14px !important;
            margin-right: 6px !important;
            color: #94a3b8;
            flex-shrink: 0 !important;
        }
        .sidebar-sub a:hover,
        .sidebar-sub a.active {
            color: #5c3f2b;
            background-color: #f5ede3;
            border-right-color: #6f4e37;
        }
        .sidebar-sub a.active i,
        .sidebar-sub a:hover i {
            color: #6f4e37;
        }

        /* --- Dividers --- */
        .sidebar-divider {
            height: 1px;
            background-color: #f1f5f9;
            margin: 8px 16px;
        }

        /* ========== LOGO ========== */
        .logo-wrap {
            display: flex;
            align-items: center;
            padding: 0 20px 20px;
            margin-bottom: 12px;
            border-bottom: 1px solid #e9ecef;
        }

        .logo-icon {
            background: linear-gradient(135deg, #6f4e37, #5c3f2b);
            color: white;
            border-radius: 10px;
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
            font-weight: 800;
            font-size: 16px;
            box-shadow: 0 2px 8px rgba(111, 78, 55, 0.25);
        }

        .logo-text {
            font-size: 18px;
            font-weight: 700;
            color: #212529;
            line-height: 1.2;
        }

        .logo-sub {
            font-size: 11px;
            color: #94a3b8;
            font-weight: 500;
        }

        /* ========== MAIN CONTENT ========== */
        .main-content {
            margin-left: 260px;
            min-height: 100dvh;
            padding: 30px;
            display: flex;
            flex-direction: column;
            box-sizing: border-box;
        }

        .admin-page-body {
            display: flex;
            flex: 1 1 auto;
            min-width: 0;
            flex-direction: column;
        }

        .topbar {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding-bottom: 20px;
            margin-bottom: 30px;
            border-bottom: 1px solid #e9ecef;
        }

        .topbar-user {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            min-width: 0;
            color: #64748b;
            padding: 5px 10px 5px 6px;
            border: 1px solid #cdb7a6;
            border-radius: 999px;
            background: #fffdfb;
            text-decoration: none;
            transition: border-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
        }

        .admin-notification-bell {
            position: relative;
            color: var(--muted-text, #6c757d);
            text-decoration: none;
            margin-right: 1rem;
            font-size: 1.1rem;
        }

        .admin-notification-badge {
            position: absolute;
            top: -0.55rem;
            right: -0.7rem;
            min-width: 1.2rem;
            height: 1.2rem;
            padding: 0 0.3rem;
            border-radius: 999px;
            background: #c0392b;
            color: #fff;
            font-size: 0.7rem;
            line-height: 1.2rem;
            text-align: center;
            font-variant-numeric: tabular-nums;
            white-space: nowrap;
        }

        .topbar-user:hover,
        .topbar-user.active {
            color: #5c3f2b;
            border-color: #cdb7a6;
            box-shadow: 0 2px 8px rgba(111, 78, 55, 0.14);
        }

        .topbar-user:focus-visible {
            color: #5c3f2b;
            outline: 3px solid rgba(111, 78, 55, 0.2);
            outline-offset: 2px;
        }

        .topbar-user-avatar {
            width: 32px;
            height: 32px;
            flex-shrink: 0;
            border-radius: 50%;
            border: 2px solid #8b6b55;
            object-fit: cover;
            background: #f8fafc;
        }

        .topbar-user-name {
            display: inline-block;
            max-width: min(220px, 35vw);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-size: 13.5px;
            font-weight: 600;
        }

        /* ========== TOAST ========== */
        #toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 999999;
        }

        /* ========== SYSTEM SECTION (bottom) ========== */
        .sidebar-system {
            margin-top: auto;
            border-top: 1px solid #f1f5f9;
            padding-top: 8px;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/Admin/Procurement/procurement-design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/admin-unified-depth.css" asp-append-version="true" />
</head>

<body>
    <div class="sidebar d-flex flex-column">
        <!-- ===== LOGO ===== -->
        <div class="logo-wrap">
            <div class="logo-icon" aria-hidden="true"><i class="fas fa-mug-hot"></i></div>
            <div>
                <div class="logo-text">CafeChain</div>
                <div class="logo-sub">Admin Dashboard</div>
            </div>
        </div>

        <!-- ===== SCROLLABLE NAV ===== -->
        <div style="flex: 1; overflow-y: auto; overflow-x: hidden;">

            <!-- ━━━ 📊 TỔNG QUAN (Direct link) ━━━ -->
            @if (canAccessDashboard)
            {
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="@Html.IsActive("Dashboard")">
                    <i class="fas fa-chart-pie"></i> Tổng quan
                </a>
            }

            <div class="sidebar-divider"></div>

            @using Microsoft.AspNetCore.Authorization
            @inject IAuthorizationService AuthorizationService

            @if ((await AuthorizationService.AuthorizeAsync(User, "RequireAdminPanelAccess")).Succeeded)
            {
                <!-- ━━━ ☕ SẢN PHẨM ━━━ -->
                <a href="#collapseProducts" data-bs-toggle="collapse"
                   aria-expanded="@(Html.IsActive("AdminCategory,AdminDrink,AdminSize,AdminTopping,AdminDrinkProfitability,AdminStoreMenu") != "" ? "true" : "false")"
                   class="sidebar-section-header @Html.IsActive("AdminCategory,AdminDrink,AdminSize,AdminTopping,AdminDrinkProfitability,AdminStoreMenu")">
                    <i class="fas fa-mug-hot section-icon"></i> Sản phẩm
                    <i class="fas fa-chevron-down chevron"></i>
                </a>
                <div class="collapse @Html.IsActive("AdminCategory,AdminDrink,AdminSize,AdminTopping,AdminDrinkProfitability,AdminStoreMenu", cssClass: "show")" id="collapseProducts">
                    <div class="sidebar-sub">
                        <a asp-area="Admin" asp-controller="AdminCategory" asp-action="Index" class="@Html.IsActive("AdminCategory")"><i class="fas fa-circle"></i> Danh mục</a>
                        <a asp-area="Admin" asp-controller="AdminDrink" asp-action="Index" class="@Html.IsActive("AdminDrink")"><i class="fas fa-circle"></i> Đồ uống</a>
                        <a asp-area="Admin" asp-controller="AdminSize" asp-action="Index" class="@Html.IsActive("AdminSize")"><i class="fas fa-circle"></i> Size</a>
                        <a asp-area="Admin" asp-controller="AdminTopping" asp-action="Index" class="@Html.IsActive("AdminTopping")"><i class="fas fa-circle"></i> Topping</a>
                        @if (User.IsInRole(CafeChain.Application.Constants.RoleConstants.BusinessOwner)
                            || User.IsInRole(CafeChain.Application.Constants.RoleConstants.AccountantWarehouse)
                            || User.IsInRole(CafeChain.Application.Constants.RoleConstants.AreaManager)
                            || User.IsInRole(CafeChain.Application.Constants.RoleConstants.StoreManager)
                            || User.IsInRole(CafeChain.Application.Constants.RoleConstants.SystemAdmin))
                        {
                            <a asp-area="Admin" asp-controller="AdminDrinkProfitability" asp-action="Index" class="@Html.IsActive("AdminDrinkProfitability")"><i class="fas fa-circle"></i> Vốn & lợi nhuận dự kiến</a>
                            <a asp-area="Admin" asp-controller="AdminStoreMenu" asp-action="Index" class="@Html.IsActive("AdminStoreMenu")"><i class="fas fa-circle"></i> Menu cửa hàng</a>
                        }
                    </div>
                </div>

                <!-- ━━━ 🧪 SẢN XUẤT / BOM ━━━ -->
                @if (canAccessProduction)
                {
                <a href="#collapseProduction" data-bs-toggle="collapse"
                   aria-expanded="@(Html.IsActive("AdminRecipe,AdminProductionOrder,AdminPreparedItem") != "" ? "true" : "false")"
                   class="sidebar-section-header @Html.IsActive("AdminRecipe,AdminProductionOrder,AdminPreparedItem")">
                    <i class="fas fa-flask section-icon"></i> Sản xuất / BOM
                    <i class="fas fa-chevron-down chevron"></i>
                </a>
                <div class="collapse @Html.IsActive("AdminRecipe,AdminProductionOrder,AdminPreparedItem", cssClass: "show")" id="collapseProduction">
                    <div class="sidebar-sub">
                        @if (effectivePermissions.Contains(PermissionConstants.PreparedItemView))
                        {
                            <a asp-area="Admin" asp-controller="AdminPreparedItem" asp-action="Index" class="@Html.IsActive("AdminPreparedItem")"><i class="fas fa-circle"></i> Danh mục bán thành phẩm</a>
                        }
                        @if (effectivePermissions.Contains(PermissionConstants.RecipeView))
                        {
                            <a asp-area="Admin" asp-controller="AdminRecipe" asp-action="Index" class="@Html.IsActive("AdminRecipe", "Index,Create,Edit,Visualize")"><i class="fas fa-circle"></i> Công thức BOM</a>
                            <a asp-area="Admin" asp-controller="AdminRecipe" asp-action="DataHealth" class="@Html.IsActive("AdminRecipe", "DataHealth")"><i class="fas fa-circle"></i> Tình trạng dữ liệu BOM</a>
                        }
                        @if (effectivePermissions.Contains(PermissionConstants.ProductionOrderView))
                        {
                            <a asp-area="Admin" asp-controller="AdminProductionOrder" asp-action="Create" class="@Html.IsActive("AdminProductionOrder")"><i class="fas fa-circle"></i> Lệnh sơ chế</a>
                        }
                    </div>
                </div>

                <!-- ━━━ 📦 KHO & CUNG ỨNG ━━━ -->
                }

                @if (canAccessInventory)
                {
                <a href="#collapseInventory" data-bs-toggle="collapse"
                   aria-expanded="@(Html.IsActive("AdminStoreInventory,AdminInventoryThresholds,AdminIngredient,AdminUnitConversion,AdminSupplier,AdminStockAlerts,AdminRestockRequests,AdminReorderSuggestions,AdminPurchaseAdvices,AdminPurchaseAdviceConsolidation,AdminPurchaseOrderBatches,AdminPurchaseOrders,AdminSupplierQuality,AdminOperationalIce") != "" ? "true" : "false")"
                   class="sidebar-section-header @Html.IsActive("AdminStoreInventory,AdminInventoryThresholds,AdminIngredient,AdminUnitConversion,AdminSupplier,AdminStockAlerts,AdminRestockRequests,AdminReorderSuggestions,AdminPurchaseAdvices,AdminPurchaseAdviceConsolidation,AdminPurchaseOrderBatches,AdminPurchaseOrders,AdminSupplierQuality,AdminOperationalIce")">
                    <i class="fas fa-warehouse section-icon"></i> Kho & Cung ứng
                    <i class="fas fa-chevron-down chevron"></i>
                </a>
                <div class="collapse @Html.IsActive("AdminStoreInventory,AdminInventoryThresholds,AdminIngredient,AdminUnitConversion,AdminSupplier,AdminStockAlerts,AdminRestockRequests,AdminReorderSuggestions,AdminPurchaseAdvices,AdminPurchaseAdviceConsolidation,AdminPurchaseOrderBatches,AdminPurchaseOrders,AdminSupplierQuality,AdminOperationalIce", cssClass: "show")" id="collapseInventory">
                    <div class="sidebar-sub">
                        @if (effectivePermissions.Contains(PermissionConstants.InventoryView))
                        {
                            <a asp-area="Admin" asp-controller="AdminStoreInventory" asp-action="Index" class="@Html.IsActive("AdminStoreInventory")"><i class="fas fa-circle"></i> Tồn kho cửa hàng</a>
                        }
                        @if (effectivePermissions.Contains(PermissionConstants.InventoryThresholdView))
                        {
                            <a asp-area="Admin" asp-controller="AdminInventoryThresholds" asp-action="Index" class="@Html.IsActive("AdminInventoryThresholds")"><i class="fas fa-circle"></i> Ngưỡng tồn kho</a>
                        }
                        @if (effectivePermissions.Contains(PermissionConstants.StockAlertView))
                        {
                            <a asp-area="Admin" asp-controller="AdminStockAlerts" asp-action="Index" class="@Html.IsActive("AdminStockAlerts")"><i class="fas fa-circle"></i> Cảnh báo kho</a>
                        }
                        @if (effectivePermissions.Contains(PermissionConstants.OperationalIceView))
                        {
                            <a asp-area="Admin" asp-controller="AdminOperationalIce" asp-action="Index" class="@Html.IsActive("AdminOperationalIce")"><i class="fas fa-circle"></i> Quản lý đá theo ca</a>
                        }
                        @if (effectivePermissions.Contains(PermissionConstants.RestockView))
                        {
                            <a asp-area="Admin" asp-controller="AdminRestockRequests" asp-action="Index" class="@Html.IsActive("AdminRestockRequests")"><i class="fas fa-circle"></i> Yêu cầu nhập hàng</a>
                        }
                        @if (effectivePermissions.Contains(PermissionConstants.ReorderSuggestionView))
                        {
                            <a asp-area="Admin" asp-controller="AdminReorderSuggestions" asp-action="Index" class="@Html.IsActive("AdminReorderSuggestions")"><i class="fas fa-circle"></i> Gợi ý nhập hàng</a>
                        }
                        @if (effectivePermissions.Contains(PermissionConstants.PurchaseAdviceView))
                        {
                            <a asp-area="Admin" asp-controller="AdminPurchaseAdvices" asp-action="Index" class="@Html.IsActive("AdminPurchaseAdvices")"><i class="fas fa-circle"></i> Đề nghị mua hàng</a>
                        }
                        @if (effectivePermissions.Contains(PermissionConstants.PurchaseAdviceConsolidate))
                        {
                            <a asp-area="Admin" asp-controller="AdminPurchaseAdviceConsolidation" asp-action="Index" class="@Html.IsActive("AdminPurchaseAdviceConsolidation")"><i class="fas fa-circle"></i> Tổng hợp đề nghị mua</a>
                        }
                        @if (effectivePermissions.Contains(PermissionConstants.PurchaseOrderViewBatch))
                        {
                            <a asp-area="Admin" asp-controller="AdminPurchaseOrderBatches" asp-action="Index" class="@Html.IsActive("AdminPurchaseOrderBatches")"><i class="fas fa-circle"></i> Đơn đặt hàng gộp</a>
                        }
                        @if (effectivePermissions.Contains(PermissionConstants.PurchaseOrderView))
                        {
                            <a asp-area="Admin" asp-controller="AdminPurchaseOrders" asp-action="Index" class="@Html.IsActive("AdminPurchaseOrders")"><i class="fas fa-circle"></i> Đơn đặt hàng</a>
                        }
                        @if (effectivePermissions.Contains(PermissionConstants.ReceiptView))
                        {
                            <a asp-area="Admin" asp-controller="AdminBranchReceipts" asp-action="Index" class="@Html.IsActive("AdminBranchReceipts")"><i class="fas fa-circle"></i> Phiếu nhận hàng</a>
                        }
                        @if (effectivePermissions.Contains(PermissionConstants.SupplierQualityView))
                        {
                            <a asp-area="Admin" asp-controller="AdminSupplierQuality" asp-action="Index" class="@Html.IsActive("AdminSupplierQuality")"><i class="fas fa-circle"></i> Chất lượng nhà cung cấp</a>
                        }
                        @if (effectivePermissions.Contains(PermissionConstants.IngredientView))
                        {
                            <a asp-area="Admin" asp-controller="AdminIngredient" asp-action="Index" class="@Html.IsActive("AdminIngredient")"><i class="fas fa-circle"></i> Nguyên liệu</a>
                        }
                        @if (effectivePermissions.Contains(PermissionConstants.UnitConversionView))
                        {
                            <a asp-area="Admin" asp-controller="AdminUnitConversion" asp-action="Index" class="@Html.IsActive("AdminUnitConversion")"><i class="fas fa-circle"></i> Đơn vị và quy đổi</a>
                        }
                        @if (effectivePermissions.Contains(PermissionConstants.SupplierView))
                        {
                            <a asp-area="Admin" asp-controller="AdminSupplier" asp-action="Index" class="@Html.IsActive("AdminSupplier")"><i class="fas fa-circle"></i> Nhà cung cấp</a>
                        }
                    </div>
                </div>

                <!-- ━━━ 📦 Phiếu Kho ━━━ -->
                }

                @if (canAccessInventoryDocuments)
                {
                <a href="#collapseInventoryDocument" data-bs-toggle="collapse"
                   aria-expanded="@(Html.IsActive("AdminInventorydocument,AdminInventoryTransfer") != "" ? "true" : "false")"
                   class="sidebar-section-header @Html.IsActive("AdminInventorydocument,AdminInventoryTransfer")">
                    <i class="fas fa-warehouse section-icon"></i> Phiếu Kho
                    <i class="fas fa-chevron-down chevron"></i>
                </a>
                <div class="collapse @Html.IsActive("AdminInventorydocument,AdminInventoryTransfer", cssClass: "show")" id="collapseInventoryDocument">
                    <div class="sidebar-sub">
                        @if (effectivePermissions.Contains(PermissionConstants.InventoryDocumentView))
                        {
                            <a asp-area="Admin" asp-controller="AdminInventorydocument" asp-action="Index" class="@Html.IsActive("AdminInventorydocument")"><i class="fas fa-circle"></i> Phiếu kho</a>
                        }
                        @if (effectivePermissions.Contains(PermissionConstants.InventoryTransferView))
                        {
                            <a asp-area="Admin" asp-controller="AdminInventoryTransfer" asp-action="Index" class="@Html.IsActive("AdminInventoryTransfer")"><i class="fas fa-circle"></i> Phiếu chuyển kho</a>
                        }
                    </div>
                </div>

                <!-- ━━━ 🛒 ĐƠN HÀNG & BÁN HÀNG ━━━ -->
                }

                <a href="#collapseOrders" data-bs-toggle="collapse"
                   aria-expanded="@(Html.IsActive("AdminOrder") != "" ? "true" : "false")"
                   class="sidebar-section-header @Html.IsActive("AdminOrder")">
                    <i class="fas fa-receipt section-icon"></i> Đơn hàng
                    <i class="fas fa-chevron-down chevron"></i>
                </a>
                <div class="collapse @Html.IsActive("AdminOrder", cssClass: "show")" id="collapseOrders">
                    <div class="sidebar-sub">
                        <a asp-area="Admin" asp-controller="AdminOrder" asp-action="History" class="@Html.IsActive("AdminOrder", "History")"><i class="fas fa-circle"></i> Lịch sử bán hàng</a>
                    </div>
                </div>

                @* Soft-removal: Voucher / vòng quay may mắn (loyalty) removed from active product scope. *@
            }

            <div class="sidebar-divider"></div>

            <!-- ━━━ 👥 NHÂN SỰ & VẬN HÀNH ━━━ -->
           @{
                var hrControllers = "AdminPermission,AdminStaff,AdminStaffShift,AdminStore";
                var isHrGroupActive = Html.IsActive(hrControllers) != "";

                var canManageStaff = effectivePermissions.Contains(PermissionConstants.StaffView);
                var canManageStaffShift = effectivePermissions.Contains(PermissionConstants.ShiftView);

                var canManageStore = effectivePermissions.Contains(PermissionConstants.StoreView);

                var canViewHrGroup =
                    canManagePermissions ||
                    canManageStaff ||
                    canManageStaffShift || canManageStore;
            }

            @if (canViewHrGroup)
            {
                <a href="#collapseHR"
                data-bs-toggle="collapse"
                aria-expanded="@(isHrGroupActive ? "true" : "false")"
                class="sidebar-section-header @(isHrGroupActive ? "active" : "")">
                    <i class="fas fa-users-cog section-icon"></i> Nhân sự & Vận hành
                    <i class="fas fa-chevron-down chevron"></i>
                </a>

                <div class="collapse @(isHrGroupActive ? "show" : "")" id="collapseHR">
                    <div class="sidebar-sub">

                        @if (canManagePermissions)
                        {
                            <a asp-area="Admin"
                            asp-controller="AdminPermission"
                            asp-action="Index"
                            class="@Html.IsActive("AdminPermission")">
                                <i class="fas fa-circle"></i> Bảng phân quyền
                            </a>
                        }

                        @if (canManageStaff)
                        {
                            <a asp-area="Admin"
                            asp-controller="AdminStaff"
                            asp-action="Index"
                            class="@Html.IsActive("AdminStaff")">
                                <i class="fas fa-circle"></i> Quản lý nhân viên
                            </a>
                        }

                        @if (canManageStaffShift)
                        {
                            <a asp-area="Admin"
                            asp-controller="AdminStaffShift"
                            asp-action="Index"
                            class="@Html.IsActive("AdminStaffShift")">
                                <i class="fas fa-circle"></i> Lịch làm việc
                            </a>
                        }

                        @if (canManageStore)
                        {
                            <a asp-area="Admin"
                            asp-controller="AdminStore"
                            asp-action="Index"
                            class="@Html.IsActive("AdminStore")">
                                <i class="fas fa-circle"></i> Quản lý cửa hàng
                            </a>
                        }

                    </div>
                </div>
            }

        </div><!-- end scrollable nav -->

        <!-- ===== SYSTEM SECTION (pinned to bottom) ===== -->
            <div class="sidebar-system">
            @if (effectivePermissions.Contains(PermissionConstants.SettingsView))
            {
                <a asp-area="Admin" asp-controller="AdminSetting" asp-action="Index" class="@Html.IsActive("AdminSetting")">
                    <i class="fas fa-sliders"></i> Cài đặt hệ thống
                </a>
            }

            @if (User.Identity?.IsAuthenticated == true && User.HasClaim(claim => claim.Type == "StaffId"))
            {
                <a asp-area="" asp-controller="AppLauncher" asp-action="Index">
                    <i class="fas fa-grip"></i> Chọn ứng dụng
                </a>
            }

            <partial name="~/Views/Shared/_LogoutForm.cshtml"
                     model="CafeChain.ViewModels.Shared.LogoutFormViewModel.AdminSidebar()" />
        </div>
    </div>

    <div class="main-content">
        <div class="topbar">
            @if (effectivePermissions.Contains(PermissionConstants.NotificationView))
            {
            <a asp-area="Admin"
               asp-controller="AdminNotifications"
               asp-action="Index"
               class="admin-notification-bell"
               data-admin-notification-bell
               data-unread-url="@Url.Action("UnreadCount", "AdminNotifications", new { area = "Admin" })"
               data-list-url="@Url.Action("ListJson", "AdminNotifications", new { area = "Admin", page = 1, pageSize = 20 })"
               title="Thông báo"
               aria-label="Mở danh sách thông báo">
                <i class="fas fa-bell" aria-hidden="true"></i>
                <span id="adminNotificationBadge" class="admin-notification-badge d-none" aria-live="polite"></span>
            </a>
            }
            <a asp-area="Admin"
               asp-controller="AdminProfile"
               asp-action="MyProfile"
               class="topbar-user @Html.IsActive("AdminProfile")"
               title="Mở hồ sơ của @currentStaffName">
                <img id="adminTopbarAvatar"
                     class="topbar-user-avatar"
                     src="@currentAvatarUrl"
                     alt="Ảnh đại diện của @currentStaffName"
                     onerror="this.onerror=null; this.src='@DefaultImages.StaffAvatarUrl';" />
                <span class="topbar-user-name">@currentStaffName</span>
            </a>
        </div>
        <div class="admin-page-body">
            @RenderBody()
        </div>
    </div>

    <!-- Toast Container -->
    <div id="toast-container"></div>

    <!-- Bootstrap & Plugins -->
    <script src="~/js/Toast/toast.js" asp-append-version="true"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/lib/microsoft-signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/Admin/Notifications/inventory-notification-realtime.js" asp-append-version="true"></script>
    <script src="~/js/shared/mutation-guard.js" asp-append-version="true"></script>
    
    <!-- Select2 (Global for BOM ecosystem) -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
