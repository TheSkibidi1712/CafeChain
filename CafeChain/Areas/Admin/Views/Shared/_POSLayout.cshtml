@using CafeChain.Helpers
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CafeChain POS</title>
    <meta name="description" content="Hệ thống POS bán hàng tại quầy CafeChain - Quản lý két tiền, bán hàng, chốt ca chuyên nghiệp" />

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <!-- Google Font: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        /* ========================================
           POS GLOBAL STYLES — Premium F&B Theme
           ======================================== */
        *, *::before, *::after { box-sizing: border-box; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: #f1f5f9;
            margin: 0;
            padding: 0;
            overflow: hidden;
            height: 100vh;
            font-size: 14px;
            color: #1e293b;
        }

        /* ---- POS Header ---- */
        .pos-header {
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 50%, #3b82f6 100%);
            color: white;
            padding: 10px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 56px;
            box-shadow: 0 4px 20px rgba(30, 58, 138, 0.3);
            position: relative;
            z-index: 100;
        }

        .pos-header .logo-section {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .pos-header .logo-icon {
            width: 36px;
            height: 36px;
            background: rgba(255,255,255,0.2);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            font-size: 18px;
            backdrop-filter: blur(10px);
        }

        .pos-header .logo-text {
            font-weight: 800;
            font-size: 18px;
            letter-spacing: -0.3px;
        }

        .pos-header .header-info {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .pos-header .info-badge {
            display: flex;
            align-items: center;
            gap: 6px;
            background: rgba(255,255,255,0.15);
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 500;
            backdrop-filter: blur(10px);
        }

        .pos-header .info-badge i { font-size: 12px; }

        .pos-header .header-actions {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .pos-header .btn-header {
            background: rgba(255,255,255,0.15);
            border: 1px solid rgba(255,255,255,0.25);
            color: white;
            padding: 6px 16px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .pos-header .btn-header:hover {
            background: rgba(255,255,255,0.25);
            transform: translateY(-1px);
        }

        .pos-header .btn-header.btn-danger-header {
            background: rgba(239, 68, 68, 0.8);
            border-color: rgba(239, 68, 68, 0.9);
        }

        .pos-header .btn-header.btn-danger-header:hover {
            background: rgba(239, 68, 68, 1);
        }

        /* ---- Network Status ---- */
        .network-indicator {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #22c55e;
            animation: pulse-green 2s infinite;
        }

        .network-indicator.offline {
            background: #ef4444;
            animation: pulse-red 1.5s infinite;
        }

        @@keyframes pulse-green {
            0%, 100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7); }
            50% { box-shadow: 0 0 0 6px rgba(34, 197, 94, 0); }
        }

        @@keyframes pulse-red {
            0%, 100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
            50% { box-shadow: 0 0 0 6px rgba(239, 68, 68, 0); }
        }

        /* ---- Main Container ---- */
        .pos-container {
            display: flex;
            height: calc(100vh - 56px);
            overflow: hidden;
        }

        /* ---- Scrollbar Custom ---- */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

        /* ---- SweetAlert2 Overrides ---- */
        .swal2-popup { font-family: 'Inter', sans-serif !important; }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <!-- POS Header -->
    <header class="pos-header" id="posHeader">
        <div class="logo-section">
            <div class="logo-icon">C</div>
            <span class="logo-text">CafeChain POS</span>
        </div>

        <div class="header-info">
            <div class="info-badge">
                <i class="fas fa-store"></i>
                <span id="headerStoreName">Cửa hàng</span>
            </div>
            <div class="info-badge">
                <i class="fas fa-user-tie"></i>
                <span id="headerStaffName">Thu ngân</span>
            </div>
            <div class="info-badge" id="shiftBadge">
                <i class="fas fa-cash-register"></i>
                <span id="headerShiftStatus">Chưa mở ca</span>
            </div>
            <div class="info-badge">
                <div class="network-indicator" id="networkIndicator"></div>
                <span id="networkStatusText">Online</span>
            </div>
        </div>

        <div class="header-actions">
            <button class="btn-header" id="btnCloseShift" style="display:none;">
                <i class="fas fa-lock"></i> Đóng ca
            </button>
            <a href="/Admin/Dashboard" class="btn-header">
                <i class="fas fa-arrow-left"></i> Quay lại
            </a>
        </div>
    </header>

    <!-- Main Content -->
    <div class="pos-container">
        @RenderBody()
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Global Network Detection
        function updateNetworkUI() {
            const indicator = document.getElementById('networkIndicator');
            const text = document.getElementById('networkStatusText');
            if (navigator.onLine) {
                indicator.classList.remove('offline');
                text.textContent = 'Online';
            } else {
                indicator.classList.add('offline');
                text.textContent = 'Offline';
            }
        }
        window.addEventListener('online', updateNetworkUI);
        window.addEventListener('offline', updateNetworkUI);
        updateNetworkUI();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
