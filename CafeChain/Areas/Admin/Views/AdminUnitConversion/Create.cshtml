@model CafeChain.ViewModels.Admin.UnitConversions.AdminUnitConversionFormPageVM
@using CafeChain.Application.DTOs.Admin.UnitConversions
@using Microsoft.Extensions.Localization
@using System.Text.Json
@inject IStringLocalizer<InventoryResource> L
@{
    ViewData["Title"] = L["UnitConversion.CreateTitle"].Value;
    var form = Model.Form;
    var ingredients = Model.Ingredients ?? new();
    var units = Model.Units ?? new();
    var physical = Model.PhysicalStandards ?? new();
}

<link rel="stylesheet" href="~/css/unit-conversion.css" asp-append-version="true" />

<div class="uc-page cc-page cc-warehouse-page">
<div class="container-fluid px-4 pt-4 pb-5">
<header class="cc-page-header cc-warehouse-header cc-warehouse-header--compact">
        <div class="cc-warehouse-header-main">
            <p class="cc-page-kicker">@L["UnitConversion.Eyebrow"]</p>
            <h1 class="uc-page-title cc-page-title">@L["UnitConversion.Create.Heading"]</h1>
            <p class="cc-page-description">@L["UnitConversion.Create.Description"]</p>
        </div>
        <a asp-action="Index" class="btn btn-uc-ghost">@L["Common.Back"]</a>
    </header>

    <div class="uc-phys-strip">
        <strong class="small">@L["UnitConversion.Create.PhysicalStrip"]</strong>
        @foreach (var p in physical)
        {
            <span class="uc-phys-item ms-2">@p.DisplayText</span>
        }
    </div>

    <form asp-action="Create" method="post" id="conversionForm" class="uc-card cc-warehouse-form-section p-4">
        @Html.AntiForgeryToken()
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="alert alert-danger cc-warehouse-alert cc-warehouse-alert-danger" role="alert" tabindex="-1"></div>
        }

        <div class="row g-4 uc-form-grid">
            <div class="col-lg-7">
                <div class="mb-3">
                    <label class="form-label fw-semibold" for="ingredientSelect">@L["UnitConversion.Create.IngredientLabel"] <span class="text-danger">*</span></label>
                    <select name="IngredientId" id="ingredientSelect" class="form-select" required aria-describedby="ingHelp" value="@form.IngredientId">
                        <option value="">@L["UnitConversion.Create.IngredientPlaceholder"]</option>
                        @foreach (var ing in ingredients)
                        {
                            <option value="@ing.IngredientId" data-code="@ing.Code" data-base="@ing.BaseUnitCode">
                                [@ing.Code] @ing.Name
                            </option>
                        }
                    </select>
                    <div id="ingHelp" class="form-text">@L["UnitConversion.Create.IngredientHelp"]</div>
                    <span class="text-danger small" data-valmsg-for="IngredientId"></span>
                </div>

                <div class="row g-3 align-items-end mb-3">
                    <div class="col-md-2">
                        <label class="form-label fw-semibold" for="FromQuantity">@L["UnitConversion.Create.FromQtyLabel"] <span class="text-danger">*</span></label>
                        <input name="FromQuantity" id="FromQuantity" class="form-control text-end" type="number" step="any" min="0.0001" value="@form.FromQuantity" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-semibold" for="FromUnitId">@L["UnitConversion.Create.FromUnitLabel"] <span class="text-danger">*</span></label>
                        <select name="FromUnitId" id="FromUnitId" class="form-select" required title="@L["UnitConversion.Create.FromUnitTitle"]">
                            <option value="">@L["UnitConversion.Create.UnitPlaceholder"]</option>
                            @foreach (var u in units)
                            {
                                <option value="@u.UnitId"
                                        data-code="@u.UnitCode"
                                        data-type="@u.Type"
                                        data-pack="@(u.IsPackagingCount ? "1" : "0")"
                                        data-phys="@(u.IsPhysicalStandard ? "1" : "0")">
                                    @u.Name (@u.UnitCode)@(u.IsPackagingCount ? L["UnitConversion.Create.PackagingSuffix"].Value : "")
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-1 text-center fw-bold text-muted pb-2">=</div>
                    <div class="col-md-2">
                        <label class="form-label fw-semibold" for="ToQuantity">@L["UnitConversion.Create.ToQtyLabel"] <span class="text-danger">*</span></label>
                        <input name="ToQuantity" id="ToQuantity" class="form-control text-end" type="number" step="any" min="0.0001" value="@form.ToQuantity" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-semibold" for="ToUnitId">@L["UnitConversion.Create.ToUnitLabel"] <span class="text-danger">*</span></label>
                        <select name="ToUnitId" id="ToUnitId" class="form-select" required title="@L["UnitConversion.Create.ToUnitTitle"]">
                            <option value="">@L["UnitConversion.Create.UnitPlaceholder"]</option>
                            @foreach (var u in units)
                            {
                                <option value="@u.UnitId"
                                        data-code="@u.UnitCode"
                                        data-type="@u.Type"
                                        data-pack="@(u.IsPackagingCount ? "1" : "0")"
                                        data-phys="@(u.IsPhysicalStandard ? "1" : "0")">
                                    @u.Name (@u.UnitCode)
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <div class="form-check mb-3" id="pkgAckWrap" style="display:none;">
                    <input class="form-check-input" name="PackageConflictAcknowledged" type="checkbox" value="true" id="PackageConflictAcknowledged" checked="@form.PackageConflictAcknowledged" />
                    <label class="form-check-label" for="PackageConflictAcknowledged" id="pkgAckLabel">
                        @L["UnitConversion.Create.PkgAckLabel"]
                    </label>
                </div>
            </div>

            <div class="col-lg-5">
                <div id="evalPanel" class="uc-eval-panel" aria-live="polite">
                    <div class="small text-muted">@L["UnitConversion.Create.EvalInitial"]</div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4 cc-warehouse-action-bar">
            <a asp-action="Index" class="btn btn-uc-ghost">@L["Common.Cancel"]</a>
            <button type="submit" class="btn btn-uc-primary" id="btnSave">@L["UnitConversion.Create.Submit"]</button>
        </div>
    </form>
</div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/Admin/UnitConversion/unit-conversion-form.js" asp-append-version="true"></script>
    <script>
        window.CafeChainUnitConversionForm.init({
            evaluateUrl: '@Url.Action("Evaluate", "AdminUnitConversion", new { area = "Admin" })',
            isEdit: false,
            locale: @Html.Raw(JsonSerializer.Serialize(System.Globalization.CultureInfo.CurrentUICulture.Name)),
            text: @Html.Raw(JsonSerializer.Serialize(new Dictionary<string, string> {
                ["insufficientData"] = L["UnitConversion.Form.Js.InsufficientData"].Value,
                ["factorLabel"] = L["UnitConversion.Form.Js.FactorLabel"].Value,
                ["factorFormula"] = L["UnitConversion.Form.Js.FactorFormula"].Value,
                ["reverseNote"] = L["UnitConversion.Form.Js.ReverseNote"].Value,
                ["direction"] = L["UnitConversion.Form.Js.Direction"].Value,
                ["physicalConflict"] = L["UnitConversion.Form.Js.PhysicalConflict"].Value,
                ["physicalNote"] = L["UnitConversion.Form.Js.PhysicalNote"].Value,
                ["crossDimension"] = L["UnitConversion.Form.Js.CrossDimension"].Value,
                ["packageConflict"] = L["UnitConversion.Form.Js.PackageConflict"].Value,
                ["supplierSpec"] = L["UnitConversion.Form.Js.SupplierSpec"].Value,
                ["impliedMeasuring"] = L["UnitConversion.Form.Js.ImpliedMeasuring"].Value,
                ["baseCostNote"] = L["UnitConversion.Form.Js.BaseCostNote"].Value,
                ["valid"] = L["UnitConversion.Form.Js.Valid"].Value,
                ["needPackageAck"] = L["UnitConversion.Form.Js.NeedPackageAck"].Value,
                ["loading"] = L["UnitConversion.Form.Js.Loading"].Value,
                ["error"] = L["UnitConversion.Form.Js.Error"].Value
            }))
        });
        $('#ingredientSelect').select2({
            theme: 'bootstrap-5', width: '100%',
            placeholder: @Html.Raw(JsonSerializer.Serialize(L["UnitConversion.Create.IngredientPlaceholder"].Value)),
            matcher: function (params, data) {
                if ($.trim(params.term) === '') return data;
                if (!data.id) return null;
                var term = params.term.toLowerCase();
                var $el = $(data.element);
                var code = String($el.data('code') || '').toLowerCase();
                var text = String(data.text || '').toLowerCase();
                if (code.indexOf(term) > -1 || text.indexOf(term) > -1) return data;
                return null;
            }
        });
    </script>
}
