@model CafeChain.ViewModels.Admin.UnitConversions.UnitConversionVM
@using CafeChain.Application.DTOs.Admin.UnitConversions
@{
    ViewData["Title"] = "Sửa quy đổi đo lường";
    var ingredients = ViewBag.Ingredients as List<AdminIngredientOptionDto> ?? new();
    var units = ViewBag.Units as List<AdminUnitOptionDto> ?? new();
    var physical = ViewBag.PhysicalStandards as List<PhysicalStandardDto> ?? new();
    var eval = ViewBag.Eval as AdminUnitConversionEvaluateResult;
}

<link rel="stylesheet" href="~/css/unit-conversion.css" asp-append-version="true" />

<div class="uc-page">
<div class="container-fluid px-4 pt-4 pb-5">
    <div class="d-flex flex-wrap justify-content-between mb-3">
        <div>
            <h1 class="uc-page-title mb-1">Sửa quy đổi đo lường #@Model.UnitConversionId</h1>
            <p class="text-muted small">Server re-evaluate trước khi lưu. Không đổi schema package.</p>
        </div>
        <a asp-action="Index" class="btn btn-uc-ghost">Quay lại</a>
    </div>

    <div class="uc-phys-strip">
        @foreach (var p in physical)
        {
            <span class="uc-phys-item me-2">@p.DisplayText</span>
        }
        <span class="uc-status uc-status-ok">Vật lý chuẩn · read-only</span>
    </div>

    <form asp-action="Edit" method="post" id="conversionForm" class="uc-card p-4">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UnitConversionId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        @if (eval != null && eval.IsMassVolumeCross)
        {
            <div class="alert alert-warning">
                Hàng hiện tại là quy đổi khối lượng ↔ thể tích. Không sửa hệ số — chỉ được xóa.
            </div>
        }

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="mb-3">
                    <label class="form-label fw-semibold" for="ingredientSelect">Nguyên liệu</label>
                    <select asp-for="IngredientId" id="ingredientSelect" class="form-select" required>
                        @foreach (var ing in ingredients)
                        {
                            <option value="@ing.IngredientId" selected="@(ing.IngredientId == Model.IngredientId)" data-code="@ing.Code">
                                [@ing.Code] @ing.Name
                            </option>
                        }
                    </select>
                </div>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold" asp-for="FromQuantity">SL đầu vào</label>
                        <input asp-for="FromQuantity" id="FromQuantity" class="form-control text-end" type="number" step="any" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold" asp-for="FromUnitId">ĐVT vào</label>
                        <select asp-for="FromUnitId" id="FromUnitId" class="form-select">
                            @foreach (var u in units)
                            {
                                <option value="@u.UnitId" selected="@(u.UnitId == Model.FromUnitId)" data-code="@u.UnitCode" data-type="@u.Type" data-pack="@(u.IsPackagingCount ? "1" : "0")">@u.UnitCode</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold" asp-for="ToQuantity">SL đầu ra</label>
                        <input asp-for="ToQuantity" id="ToQuantity" class="form-control text-end" type="number" step="any" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold" asp-for="ToUnitId">ĐVT ra</label>
                        <select asp-for="ToUnitId" id="ToUnitId" class="form-select">
                            @foreach (var u in units)
                            {
                                <option value="@u.UnitId" selected="@(u.UnitId == Model.ToUnitId)" data-code="@u.UnitCode" data-type="@u.Type" data-pack="@(u.IsPackagingCount ? "1" : "0")">@u.UnitCode</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-check mt-3" id="pkgAckWrap" style="display:none;">
                    <input class="form-check-input" asp-for="PackageConflictAcknowledged" id="PackageConflictAcknowledged" />
                    <label class="form-check-label" for="PackageConflictAcknowledged">
                        Xác nhận mâu thuẫn package NCC và vẫn lưu (package không đổi).
                    </label>
                </div>
            </div>
            <div class="col-lg-5">
                <div id="evalPanel" class="uc-eval-panel" aria-live="polite">Đang đánh giá…</div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-uc-ghost">Hủy</a>
            <button type="submit" class="btn btn-uc-primary" id="btnSave">Lưu</button>
        </div>
    </form>
</div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/Admin/UnitConversion/unit-conversion-form.js" asp-append-version="true"></script>
    <script>
        window.CafeChainUnitConversionForm.init({
            evaluateUrl: '@Url.Action("Evaluate", "AdminUnitConversion", new { area = "Admin" })',
            isEdit: true,
            unitConversionId: @Model.UnitConversionId
        });
        $('#ingredientSelect').select2({ theme: 'bootstrap-5', width: '100%' });
    </script>
}
