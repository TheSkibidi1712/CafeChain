@model CafeChain.ViewModels.Admin.UnitConversions.AdminUnitConversionFormPageVM
@using CafeChain.Application.DTOs.Admin.UnitConversions
@{
    ViewData["Title"] = "Sửa quy đổi đo lường";
    var form = Model.Form;
    var ingredients = Model.Ingredients ?? new();
    var units = Model.Units ?? new();
    var physical = Model.PhysicalStandards ?? new();
    var eval = Model.Eval;
}

<link rel="stylesheet" href="~/css/unit-conversion.css" asp-append-version="true" />

<div class="uc-page cc-page cc-warehouse-page">
<div class="container-fluid px-4 pt-4 pb-5">
    <header class="cc-page-header cc-warehouse-header">
        <div class="cc-warehouse-header-main">
            <p class="cc-page-kicker">Kho &amp; Cung ứng / Đơn vị và quy đổi</p>
            <h1 class="uc-page-title cc-page-title">Sửa quy đổi đo lường #@form.UnitConversionId</h1>
            <p class="cc-page-description">Hệ thống kiểm tra lại hệ số trước khi lưu và không thay đổi cấu trúc quy cách đóng gói.</p>
        </div>
        <a asp-action="Index" class="btn btn-uc-ghost">Quay lại</a>
    </header>

    <div class="uc-phys-strip">
        @foreach (var p in physical)
        {
            <span class="uc-phys-item me-2">@p.DisplayText</span>
        }
        <span class="uc-status uc-status-ok">Vật lý chuẩn · chỉ đọc</span>
    </div>

    <form asp-action="Edit" method="post" id="conversionForm" class="uc-card cc-warehouse-form-section p-4">
        @Html.AntiForgeryToken()
        <input type="hidden" name="UnitConversionId" value="@form.UnitConversionId" />
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="alert alert-danger cc-warehouse-alert cc-warehouse-alert-danger" role="alert" tabindex="-1"></div>
        }

        @if (eval != null && eval.IsMassVolumeCross)
        {
            <div class="alert alert-warning">
                Hàng hiện tại là quy đổi khối lượng ↔ thể tích. Không sửa hệ số — chỉ được xóa.
            </div>
        }

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="mb-3">
                    <label class="form-label fw-semibold" for="ingredientSelect">Nguyên liệu</label>
                    <select name="IngredientId" id="ingredientSelect" class="form-select" required>
                        @foreach (var ing in ingredients)
                        {
                            <option value="@ing.IngredientId" selected="@(ing.IngredientId == form.IngredientId)" data-code="@ing.Code">
                                [@ing.Code] @ing.Name
                            </option>
                        }
                    </select>
                </div>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold" for="FromQuantity">SL đầu vào</label>
                        <input name="FromQuantity" id="FromQuantity" class="form-control text-end" type="number" step="any" value="@form.FromQuantity" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold" for="FromUnitId">ĐVT vào</label>
                        <select name="FromUnitId" id="FromUnitId" class="form-select">
                            @foreach (var u in units)
                            {
                                <option value="@u.UnitId" selected="@(u.UnitId == form.FromUnitId)" data-code="@u.UnitCode" data-type="@u.Type" data-pack="@(u.IsPackagingCount ? "1" : "0")">@u.UnitCode</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold" for="ToQuantity">SL đầu ra</label>
                        <input name="ToQuantity" id="ToQuantity" class="form-control text-end" type="number" step="any" value="@form.ToQuantity" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold" for="ToUnitId">ĐVT ra</label>
                        <select name="ToUnitId" id="ToUnitId" class="form-select">
                            @foreach (var u in units)
                            {
                                <option value="@u.UnitId" selected="@(u.UnitId == form.ToUnitId)" data-code="@u.UnitCode" data-type="@u.Type" data-pack="@(u.IsPackagingCount ? "1" : "0")">@u.UnitCode</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-check mt-3" id="pkgAckWrap" style="display:none;">
                    <input class="form-check-input" name="PackageConflictAcknowledged" type="checkbox" value="true" id="PackageConflictAcknowledged" checked="@form.PackageConflictAcknowledged" />
                    <label class="form-check-label" for="PackageConflictAcknowledged">
                        Xác nhận mâu thuẫn quy cách nhà cung cấp và vẫn lưu (quy cách đóng gói không đổi).
                    </label>
                </div>
            </div>
            <div class="col-lg-5">
                <div id="evalPanel" class="uc-eval-panel" aria-live="polite">Đang đánh giá…</div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4 cc-warehouse-action-bar">
            <a asp-action="Index" class="btn btn-uc-ghost">Hủy</a>
            <button type="submit" class="btn btn-uc-primary" id="btnSave">Lưu</button>
        </div>
    </form>
</div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/Admin/UnitConversion/unit-conversion-form.js" asp-append-version="true"></script>
    <script>
        window.CafeChainUnitConversionForm.init({
            evaluateUrl: '@Url.Action("Evaluate", "AdminUnitConversion", new { area = "Admin" })',
            isEdit: true,
            unitConversionId: @form.UnitConversionId
        });
        $('#ingredientSelect').select2({ theme: 'bootstrap-5', width: '100%' });
    </script>
}
