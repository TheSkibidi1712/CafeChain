@model IReadOnlyList<CafeChain.Application.DTOs.Admin.Procurement.PurchaseOrderListItemDto>
@using CafeChain.Application.DTOs.Admin.StoreScope
@using CafeChain.ViewModels.Admin.Shared
@{
    ViewData["Title"] = "Đơn đặt hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var stores = ViewBag.StoreOptions as IReadOnlyList<AdminStoreOptionDto> ?? Array.Empty<AdminStoreOptionDto>();
    var selectedStoreId = ViewBag.SelectedStoreId as int? ?? 0;
    var statusFilter = ViewBag.StatusFilter as string;
}
<link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />

<main class="ops-shell">
    <header class="ops-header">
        <div>
            <div class="ops-eyebrow">Mua hàng từ nhà cung cấp</div>
            <h1 class="ops-title">Đơn đặt hàng</h1>
            <p class="ops-subtitle">Theo dõi số lượng đã đặt, tiến độ nhận và giá trị chứng từ. Tồn kho chỉ thay đổi khi phiếu nhận hàng được xác nhận.</p>
        </div>
        <a class="ops-btn ops-btn-primary" asp-action="Create"><i class="fa-solid fa-plus" aria-hidden="true"></i> Tạo đơn đặt hàng</a>
    </header>

    @if (TempData["SuccessMessage"] != null) { <div class="ops-notice ops-notice-success" role="status">@TempData["SuccessMessage"]</div> }
    @if (TempData["ErrorMessage"] != null) { <div class="ops-notice ops-notice-error" role="alert">@TempData["ErrorMessage"]</div> }

    @if (stores.Count > 1)
    {
        <form method="get" class="ops-filterbar" aria-label="Lọc đơn đặt hàng theo chi nhánh">
            <input type="hidden" name="status" value="@statusFilter" />
            <div class="ops-filter-group">
                <label class="ops-form-label mb-0" for="purchaseOrderStoreId">Chi nhánh</label>
                <select id="purchaseOrderStoreId" name="storeId" class="ops-select" onchange="this.form.submit()">
                    @foreach (var store in stores)
                    {
                        <option value="@store.StoreId" selected="@(store.StoreId == selectedStoreId)">@store.StoreName</option>
                    }
                </select>
            </div>
            <noscript><button type="submit" class="ops-btn">Áp dụng</button></noscript>
        </form>
    }

    @if (Model.Count == 0)
    {
        <section class="ops-empty" aria-labelledby="purchaseOrderEmptyTitle">
            <span class="ops-empty-icon"><i class="fa-solid fa-file-circle-plus" aria-hidden="true"></i></span>
            <h2 id="purchaseOrderEmptyTitle" class="ops-empty-title">Chưa có đơn đặt hàng</h2>
            <p class="ops-empty-copy">Tạo đơn từ nhu cầu mua đã được xét nguồn cung, hoặc lập đơn mua chủ động khi bạn có đủ quyền và thông tin nhà cung cấp.</p>
            <div class="ops-empty-actions">
                <a class="ops-btn" asp-area="Admin" asp-controller="AdminRestockRequests" asp-action="Index" asp-route-storeId="@selectedStoreId">Xem yêu cầu bổ sung</a>
                <a class="ops-btn ops-btn-primary" asp-action="Create">Tạo đơn đặt hàng</a>
            </div>
        </section>
    }
    else
    {
        <section class="ops-table-wrap" aria-label="Danh sách đơn đặt hàng">
            <div class="ops-table-scroll">
                <table class="ops-table ops-po-table">
                    <thead><tr><th class="text-center">Mã đơn</th><th class="text-center">Chi nhánh</th><th class="text-center">Nhà cung cấp</th><th class="text-center">Ngày đặt</th><th class="text-center">Trạng thái</th><th class="number text-center">Giá trị</th><th class="text-center">Thao tác</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        var orderStatus = AdminStatusDisplay.PurchaseOrder(item.Status);
                        <tr>
                            <td class="text-center"><strong>@item.Code</strong></td>
                            <td class="text-center">@item.StoreName</td>
                            <td class="text-center">@item.SupplierName</td>
                            <td class="text-center">@AdminStatusDisplay.Date(item.OrderDate.ToLocalTime())</td>
                            <td class="text-center"><span class="ops-badge @orderStatus.CssClass">@orderStatus.Label</span></td>
                            <td class="number text-center">@AdminStatusDisplay.Currency(item.TotalAmount)</td>
                            <td class="text-center"><a class="ops-btn" asp-action="Details" asp-route-id="@item.PurchaseOrderId">Chi tiết <i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }
</main>
