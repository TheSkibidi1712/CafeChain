@model IReadOnlyList<CafeChain.Application.DTOs.Admin.Procurement.PurchaseOrderListItemDto>
@using CafeChain.Application.DTOs.Admin.StoreScope
@using CafeChain.ViewModels.Admin.Shared
@{
    ViewData["Title"] = "Đơn đặt hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var stores = ViewBag.StoreOptions as IReadOnlyList<AdminStoreOptionDto> ?? Array.Empty<AdminStoreOptionDto>();
    var selectedStoreId = ViewBag.SelectedStoreId as int? ?? 0;
    var statusFilter = ViewBag.StatusFilter as string;
}
<link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />
<main class="ops-shell">
    <header class="ops-header"><div><div class="ops-eyebrow">Mua hàng từ Nhà cung cấp</div><h1 class="ops-title">Đơn đặt hàng</h1><p class="ops-subtitle">Theo dõi số lượng đã đặt và đã nhận hợp lệ; tồn kho chỉ thay đổi qua phiếu nhận hàng.</p></div><a class="ops-btn ops-btn-primary" asp-action="Create"><i class="fa-solid fa-plus"></i> Tạo đơn đặt hàng</a></header>
    @if (stores.Count > 1)
    {
        <form method="get" class="ops-filterbar" aria-label="Chọn chi nhánh">
            <input type="hidden" name="status" value="@statusFilter" />
            <div class="ops-filter-group">
                <label class="ops-form-label mb-0" for="purchaseOrderStoreId">Chi nhánh</label>
                <select id="purchaseOrderStoreId" name="storeId" class="ops-select" onchange="this.form.submit()">
                    @foreach (var store in stores)
                    {
                        <option value="@store.StoreId" selected="@(store.StoreId == selectedStoreId)">@store.StoreName</option>
                    }
                </select>
            </div>
            <noscript><button type="submit" class="ops-btn">Áp dụng</button></noscript>
        </form>
    }
    <section class="ops-panel"><div class="ops-panel-body p-0"><div class="ops-table-scroll"><table class="ops-table"><thead><tr><th>Mã đơn</th><th>Chi nhánh</th><th>Nhà cung cấp</th><th>Ngày đặt</th><th>Trạng thái</th><th class="number">Giá trị</th><th></th></tr></thead><tbody>
    @foreach (var item in Model) { var orderStatus = AdminStatusDisplay.PurchaseOrder(item.Status); <tr><td><strong>@item.Code</strong></td><td>@item.StoreName</td><td>@item.SupplierName</td><td>@AdminStatusDisplay.Date(item.OrderDate.ToLocalTime())</td><td><span class="ops-badge @orderStatus.CssClass">@orderStatus.Label</span></td><td class="number">@AdminStatusDisplay.Currency(item.TotalAmount)</td><td><a class="ops-btn" asp-action="Details" asp-route-id="@item.PurchaseOrderId">Chi tiết</a></td></tr> }
    @if (Model.Count == 0) { <tr><td colspan="7" class="text-center ops-secondary p-4">Chưa có đơn đặt hàng.</td></tr> }
    </tbody></table></div></div></section>
</main>
