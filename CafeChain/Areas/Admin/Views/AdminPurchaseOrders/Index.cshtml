@model IReadOnlyList<CafeChain.Application.DTOs.Admin.Procurement.PurchaseOrderListItemDto>
@using CafeChain.Application.DTOs.Admin.StoreScope
@using CafeChain.ViewModels.Admin.Shared
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ProcurementResource> L
@{
    ViewData["Title"] = L["PurchaseOrder.Title"];
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var stores = ViewBag.StoreOptions as IReadOnlyList<AdminStoreOptionDto> ?? Array.Empty<AdminStoreOptionDto>();
    var selectedStoreId = ViewBag.SelectedStoreId as int? ?? 0;
    var statusFilter = ViewBag.StatusFilter as string;
    var canCreate = (bool?)ViewBag.CanCreate == true;
}
<link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />

<main class="ops-shell purchase-order-page purchase-order-index-page cc-warehouse-page">
    <header class="ops-header cc-warehouse-header">
        <div>
            <div class="ops-eyebrow">@L["PurchaseOrder.Eyebrow"]</div>
            <h1 class="ops-title"><i class="fa-solid fa-cart-shopping me-2 text-warning" aria-hidden="true"></i>@L["PurchaseOrder.Title"]</h1>
            <p class="ops-subtitle">@L["PurchaseOrder.Subtitle"]</p>
        </div>
        @if (canCreate)
        {
            <a class="ops-btn ops-btn-primary" asp-action="Create"><i class="fa-solid fa-plus" aria-hidden="true"></i> @L["PurchaseOrder.Create"]</a>
        }
    </header>

    @if (TempData["SuccessMessage"] != null) { <div class="ops-notice ops-notice-success" role="status">@TempData["SuccessMessage"]</div> }
    @if (TempData["ErrorMessage"] != null) { <div class="ops-notice ops-notice-error" role="alert">@TempData["ErrorMessage"]</div> }

    <!-- Main Module Panel -->
    <section class="po-panel">
        @if (stores.Count > 1)
        {
            <form method="get" class="po-filter-toolbar cc-warehouse-filter" aria-label="@L["PurchaseOrder.FilterAria"]">
                <input type="hidden" name="status" value="@statusFilter" />
                <div class="po-filter-grid">
                    <div class="po-field">
                        <label class="ops-form-label mb-0" for="purchaseOrderStoreId">@L["Common.Branch"]</label>
                        <select id="purchaseOrderStoreId" name="storeId" class="po-select" onchange="this.form.submit()">
                            @foreach (var store in stores)
                            {
                                <option value="@store.StoreId" selected="@(store.StoreId == selectedStoreId)">@store.StoreName</option>
                            }
                        </select>
                    </div>
                </div>
                <noscript><button type="submit" class="ops-btn">@L["Common.Apply"]</button></noscript>
            </form>
        }

        @if (Model.Count == 0)
        {
            <div class="po-empty-wrap">
                <section class="ops-empty cc-warehouse-empty" aria-labelledby="purchaseOrderEmptyTitle" role="status">
                    <span class="ops-empty-icon"><i class="fa-solid fa-file-circle-plus" aria-hidden="true"></i></span>
                    <h2 id="purchaseOrderEmptyTitle" class="ops-empty-title">@L["PurchaseOrder.EmptyTitle"]</h2>
                    <p class="ops-empty-copy">@L["PurchaseOrder.EmptyCopy"]</p>
                    <div class="ops-empty-actions">
                        <a class="ops-btn" asp-area="Admin" asp-controller="AdminRestockRequests" asp-action="Index" asp-route-storeId="@selectedStoreId">@L["PurchaseOrder.ViewRequests"]</a>
                        @if (canCreate)
                        {
                            <a class="ops-btn ops-btn-primary" asp-action="Create">@L["PurchaseOrder.Create"]</a>
                        }
                    </div>
                </section>
            </div>
        }
        else
        {
            <section class="po-table-wrap cc-warehouse-table-shell" aria-label="@L["PurchaseOrder.ListAria"]">
                <div class="ops-table-scroll">
                    <table class="ops-table ops-po-table">
                        <thead><tr><th class="text-center">@L["PurchaseOrder.Code"]</th><th class="text-center">@L["Common.Branch"]</th><th class="text-center">@L["Common.Supplier"]</th><th class="text-center">@L["PurchaseOrder.OrderDate"]</th><th class="text-center">@L["Common.Status"]</th><th class="number text-center">@L["Common.Value"]</th><th class="text-center">@L["Common.Actions"]</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model)
                        {
                            var orderStatus = AdminStatusDisplay.PurchaseOrder(item.Status);
                            <tr>
                                <td class="text-center"><strong>@item.Code</strong></td>
                                <td class="text-center">@item.StoreName</td>
                                <td class="text-center">@item.SupplierName</td>
                                <td class="text-center">@AdminStatusDisplay.Date(item.OrderDate.ToLocalTime())</td>
                                <td class="text-center"><span class="ops-badge @orderStatus.CssClass">@L[$"Status.{item.Status}"]</span></td>
                                <td class="number text-center">@AdminStatusDisplay.Currency(item.TotalAmount)</td>
                                <td class="text-center"><a class="ops-btn" asp-action="Details" asp-route-id="@item.PurchaseOrderId">@L["Common.Details"] <i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    </section>
</main>
