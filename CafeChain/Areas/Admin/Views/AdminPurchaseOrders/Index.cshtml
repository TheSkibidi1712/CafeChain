@model IReadOnlyList<CafeChain.Application.DTOs.Admin.Procurement.PurchaseOrderListItemDto>
@{
    ViewData["Title"] = "Đơn mua hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    string StatusLabel(string value) => value switch
    {
        "DRAFT" => "Bản nháp",
        "APPROVED" => "Đã duyệt",
        "MARKED_AS_SENT" => "Đã gửi nhà cung cấp",
        "PARTIALLY_RECEIVED" => "Đã nhận một phần",
        "COMPLETED" => "Hoàn tất",
        "CANCELLED" => "Đã hủy",
        _ => value
    };
    string StatusClass(string value) => value switch
    {
        "COMPLETED" => "ops-badge-success",
        "PARTIALLY_RECEIVED" => "ops-badge-warning",
        "APPROVED" or "MARKED_AS_SENT" => "ops-badge-info",
        _ => "ops-badge-neutral"
    };
}
<link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />
<main class="ops-shell">
    <header class="ops-header"><div><div class="ops-eyebrow">Mua hàng nhà cung cấp</div><h1 class="ops-title">Đơn mua hàng</h1><p class="ops-subtitle">Theo dõi lượng đặt và lượng thực nhận; tồn kho chỉ thay đổi qua phiếu nhận.</p></div><a class="ops-btn ops-btn-primary" asp-action="Create"><i class="fa-solid fa-plus"></i> Tạo đơn mua</a></header>
    <section class="ops-panel"><div class="ops-panel-body p-0"><div class="ops-table-scroll"><table class="ops-table"><thead><tr><th>Mã PO</th><th>Cửa hàng</th><th>Nhà cung cấp</th><th>Ngày đặt</th><th>Trạng thái</th><th class="number">Giá trị</th><th></th></tr></thead><tbody>
    @foreach (var item in Model) { <tr><td><strong>@item.Code</strong></td><td>@item.StoreName</td><td>@item.SupplierName</td><td>@item.OrderDate.ToLocalTime().ToString("dd/MM/yyyy")</td><td><span class="ops-badge @StatusClass(item.Status)">@StatusLabel(item.Status)</span></td><td class="number">@item.TotalAmount.ToString("N0") đ</td><td><a class="ops-btn" asp-action="Details" asp-route-id="@item.PurchaseOrderId">Chi tiết</a></td></tr> }
    @if (Model.Count == 0) { <tr><td colspan="7" class="text-center ops-secondary p-4">Chưa có đơn mua hàng.</td></tr> }
    </tbody></table></div></div></section>
</main>
