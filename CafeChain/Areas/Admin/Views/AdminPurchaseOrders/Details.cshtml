@model CafeChain.Application.DTOs.Admin.Procurement.PurchaseOrderDetailDto
@using CafeChain.ViewModels.Admin.Shared
@{
    ViewData["Title"] = "Chi tiết đơn đặt hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var canReceive = (bool?)ViewBag.CanReceive == true;
    var canCloseRemaining = (bool?)ViewBag.CanCloseRemaining == true;
    var canReceiveStatus = Model.Status is "APPROVED" or "MARKED_AS_SENT" or "PARTIALLY_RECEIVED";
    var totalAccepted = Model.Lines.Sum(x => x.AcceptedBaseQuantity);
    var totalRejected = Model.Lines.Sum(x => x.RejectedBaseQuantity);
    var totalClosed = Model.Lines.Sum(x => x.ClosedRemainingQuantity);
    var totalRemaining = Model.Lines.Sum(x => x.RemainingBaseQuantity);
    var completedWithShortfall = Model.Status == "COMPLETED" && totalClosed > 0;
    var orderStatus = AdminStatusDisplay.PurchaseOrder(Model.Status);
    var orderStatusLabel = completedWithShortfall
        ? "Hoàn thành có phần không giao bù"
        : orderStatus.Label;
}

<link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />

<main class="ops-shell">
    <header class="ops-header">
        <div>
            <div class="ops-eyebrow">@Model.Code · @Model.StoreName</div>
            <h1 class="ops-title">@Model.SupplierName</h1>
            <p class="ops-subtitle">@orderStatusLabel. Số lượng còn phải giao chỉ trừ phần đã nhận hợp lệ hoặc phần được đóng rõ ràng.</p>
        </div>
        <div class="ops-actions">
            @if (canReceive && canReceiveStatus && totalRemaining > 0)
            {
                <a class="ops-btn ops-btn-primary" asp-area="Admin" asp-controller="AdminBranchReceipts" asp-action="ReceivePurchaseOrder" asp-route-purchaseOrderId="@Model.PurchaseOrderId">
                    <i class="fa-solid fa-box-open" aria-hidden="true"></i>
                    @(Model.ActiveReceiptDraftId.HasValue ? "Tiếp tục kiểm đếm" : "Nhận hàng")
                </a>
            }
            <a class="ops-btn" asp-action="Index"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Danh sách</a>
        </div>
    </header>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="ops-notice ops-notice-success">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="ops-notice ops-notice-error">@error</div>
    }
    @if (completedWithShortfall)
    {
        <div class="ops-notice ops-notice-info">Đơn đặt hàng đã hoàn thành với @AdminStatusDisplay.Quantity(totalClosed) đơn vị cơ sở được đóng theo quyết định không yêu cầu giao bù. Phần này không nhập kho và không hoàn thành yêu cầu nhập hàng.</div>
    }

    <section class="ops-metrics">
        <div class="ops-metric"><span class="ops-metric-label">Giá trị đặt</span><strong class="ops-metric-value">@AdminStatusDisplay.Currency(Model.TotalAmount)</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Đã nhận hợp lệ</span><strong class="ops-metric-value success">@AdminStatusDisplay.Quantity(totalAccepted)</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Đã từ chối</span><strong class="ops-metric-value danger">@AdminStatusDisplay.Quantity(totalRejected)</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Còn phải giao</span><strong class="ops-metric-value warning">@AdminStatusDisplay.Quantity(totalRemaining)</strong></div>
    </section>

    <section class="ops-panel">
        <div class="ops-panel-header"><h2 class="ops-panel-title">Chi tiết nghĩa vụ giao hàng</h2></div>
        <div class="ops-panel-body p-0">
            <div class="ops-table-scroll">
                <table class="ops-table">
                    <thead>
                        <tr>
                            <th>Nguyên liệu</th>
                            <th>Nguồn yêu cầu nhập</th>
                            <th class="number">Đặt</th>
                            <th class="number">Số lượng chấp nhận</th>
                            <th class="number">Số lượng từ chối</th>
                            <th class="number">Phần còn lại đã đóng</th>
                            <th class="number">Còn phải giao</th>
                            <th>Lịch sử</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>
                                <strong class="ops-item-name">@line.IngredientName</strong>
                                @if (line.PurchaseMode == CafeChain.Models.Enums.Inventory.PurchaseMode.Loose)
                                {
                                    <div class="ops-secondary">Mua rời @AdminStatusDisplay.Quantity(line.OrderedProcurementQuantity.GetValueOrDefault()) @line.ProcurementUnitName · @AdminStatusDisplay.Currency(line.UnitPricePerProcurementUnit.GetValueOrDefault())/@line.ProcurementUnitName</div>
                                }
                                else
                                {
                                    <div class="ops-secondary">@AdminStatusDisplay.Quantity(line.PackageCount.GetValueOrDefault()) gói · @AdminStatusDisplay.Currency(line.PackagePriceSnapshot.GetValueOrDefault())/gói · 1 gói = @AdminStatusDisplay.Quantity(line.PackageQuantitySnapshot.GetValueOrDefault()) @line.PackageUnitName</div>
                                }
                            </td>
                            <td>@(line.RestockRequestId.HasValue ? $"Yêu cầu nhập hàng #{line.RestockRequestId}" : "Mua chủ động")</td>
                            <td class="number">@AdminStatusDisplay.Quantity(line.OrderedBaseQuantity) @line.BaseUnitName@if (line.OrderedProcurementQuantity.HasValue) { <div class="ops-secondary">@AdminStatusDisplay.Quantity(line.OrderedProcurementQuantity.Value) @line.ProcurementUnitName</div> }</td>
                            <td class="number">@AdminStatusDisplay.Quantity(line.AcceptedBaseQuantity) @line.BaseUnitName@if (line.AcceptedProcurementQuantity.HasValue) { <div class="ops-secondary">@AdminStatusDisplay.Quantity(line.AcceptedProcurementQuantity.Value) @line.ProcurementUnitName</div> }</td>
                            <td class="number">@AdminStatusDisplay.Quantity(line.RejectedBaseQuantity) @line.BaseUnitName</td>
                            <td class="number">
                                @AdminStatusDisplay.Quantity(line.ClosedRemainingQuantity) @line.BaseUnitName
                                @if (line.ClosedRemainingQuantity > 0 && line.ProcurementUnitName != null)
                                {
                                    <div class="ops-secondary">@AdminStatusDisplay.Quantity(line.ClosedRemainingQuantity / (line.OrderedBaseQuantity > 0 && line.OrderedProcurementQuantity.HasValue ? line.OrderedBaseQuantity / line.OrderedProcurementQuantity.Value : 1m)) @line.ProcurementUnitName</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(line.CloseRemainingReason))
                                {
                                    <div class="ops-secondary" title="@line.CloseRemainingReason">@line.CloseRemainingReason</div>
                                }
                            </td>
                            <td class="number"><strong>@AdminStatusDisplay.Quantity(line.RemainingBaseQuantity) @line.BaseUnitName</strong>@if (line.RemainingProcurementQuantity.HasValue) { <div class="ops-secondary">@AdminStatusDisplay.Quantity(line.RemainingProcurementQuantity.Value) @line.ProcurementUnitName</div> }</td>
                            <td>
                                <span class="ops-badge ops-badge-neutral">@line.ReceiptCount lần nhận</span>
                                @if (canCloseRemaining && canReceiveStatus && line.RemainingBaseQuantity > 0)
                                {
                                    <form method="post" asp-action="CloseLineRemaining" asp-route-id="@Model.PurchaseOrderId" class="mt-2" onsubmit="return confirm('Đóng phần còn lại sẽ chấm dứt nghĩa vụ giao bù và không nhập kho. Bạn chắc chắn?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="lineId" value="@line.PurchaseOrderLineId" />
                                        <input type="hidden" name="rowVersion" value="@line.RowVersion" />
                                        <input type="hidden" name="requestKey" value="@Guid.NewGuid().ToString("N")" />
                                        <label class="ops-form-label" for="closeReason-@line.PurchaseOrderLineId">Lý do không yêu cầu giao bù</label>
                                        <input id="closeReason-@line.PurchaseOrderLineId" class="ops-input w-100" name="reason" maxlength="500" required placeholder="Nhập lý do..." />
                                        <button class="ops-btn ops-btn-danger mt-2" type="submit">Đóng phần còn lại</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="ops-panel ops-action-panel">
        <div class="ops-panel-header">
            <div><h2 class="ops-panel-title">Thao tác tiếp theo</h2><div class="ops-secondary">Chỉ các thao tác phù hợp với trạng thái hiện tại được hiển thị.</div></div>
        </div>
        <div class="ops-panel-body">
            <div class="ops-inline-actions">
                @if (Model.Status == "DRAFT")
                {
                    <form method="post" asp-action="Approve" asp-route-id="@Model.PurchaseOrderId">@Html.AntiForgeryToken()<input type="hidden" name="rowVersion" value="@Model.RowVersion" /><button class="ops-btn ops-btn-primary">Duyệt đơn</button></form>
                }
                @if (Model.Status == "APPROVED")
                {
                    <form method="post" asp-action="MarkSent" asp-route-id="@Model.PurchaseOrderId">@Html.AntiForgeryToken()<input type="hidden" name="rowVersion" value="@Model.RowVersion" /><button class="ops-btn ops-btn-primary">Đánh dấu đã gửi Nhà cung cấp</button></form>
                }
                @if (Model.ActiveReceiptDraftId.HasValue)
                {
                    <a class="ops-btn" asp-area="Admin" asp-controller="AdminBranchReceipts" asp-action="EditPurchaseOrderDraft" asp-route-id="@Model.ActiveReceiptDraftId">Mở phiếu kiểm đếm nháp</a>
                }
            </div>
            @if (Model.Status is "DRAFT" or "APPROVED" or "MARKED_AS_SENT")
            {
                <details class="ops-danger-disclosure">
                    <summary>Hủy đơn đặt hàng</summary>
                    <div class="ops-danger-content">
                        <p class="ops-secondary">Chỉ hủy khi đơn không còn được tiếp tục xử lý. Lý do sẽ được lưu cùng lịch sử chứng từ.</p>
                        <form method="post" asp-action="Cancel" asp-route-id="@Model.PurchaseOrderId">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                            <label class="ops-form-label" for="cancelReason">Lý do hủy đơn đặt hàng <span class="ops-required">*</span></label>
                            <div class="ops-inline-actions"><input id="cancelReason" name="reason" class="ops-input flex-grow-1" maxlength="500" required placeholder="Nhập lý do hủy..." /><button class="ops-btn ops-btn-danger" type="submit">Xác nhận hủy</button></div>
                        </form>
                    </div>
                </details>
            }
        </div>
    </section>
</main>
