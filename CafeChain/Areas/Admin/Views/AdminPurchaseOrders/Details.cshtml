@model CafeChain.Application.DTOs.Admin.Procurement.PurchaseOrderDetailDto
@using CafeChain.ViewModels.Admin.Shared
@{
    ViewData["Title"] = "Chi tiết đơn đặt hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var canApprove = (bool?)ViewBag.CanApprove == true;
    var canSend = (bool?)ViewBag.CanSend == true;
    var canCancel = (bool?)ViewBag.CanCancel == true;
    var canReceive = (bool?)ViewBag.CanReceive == true;
    var canCloseRemaining = (bool?)ViewBag.CanCloseRemaining == true;
    var canReceiveStatus = Model.Status is "APPROVED" or "MARKED_AS_SENT" or "PARTIALLY_RECEIVED";
    var totalClosed = Model.Lines.Sum(x => x.ClosedRemainingQuantity);
    var totalRemaining = Model.Lines.Sum(x => x.RemainingBaseQuantity);
    var acceptedLineCount = Model.Lines.Count(x => x.AcceptedBaseQuantity > 0);
    var rejectedLineCount = Model.Lines.Count(x => x.RejectedBaseQuantity > 0);
    var remainingLineCount = Model.Lines.Count(x => x.RemainingBaseQuantity > 0);
    var completedWithShortfall = Model.Status == "COMPLETED" && totalClosed > 0;
    var orderStatus = AdminStatusDisplay.PurchaseOrder(Model.Status);
    var orderStatusLabel = completedWithShortfall
        ? "Hoàn thành có phần không giao bù"
        : orderStatus.Label;
}

<link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />

<main class="ops-shell cc-warehouse-page">
<header class="ops-header cc-warehouse-header cc-warehouse-header--compact cc-warehouse-header--detail">
        <div>
            <div class="ops-eyebrow">@Model.Code · @Model.StoreName</div>
            <h1 class="ops-title">@Model.SupplierName</h1>
            <p class="ops-subtitle">@orderStatusLabel. Số lượng còn phải giao chỉ trừ phần đã nhận hợp lệ hoặc phần được đóng rõ ràng.</p>
        </div>
        <div class="ops-actions">
            <a class="ops-btn ops-btn-primary" asp-action="Print" asp-route-id="@Model.PurchaseOrderId" target="_blank">
                <i class="fa-solid fa-file-pdf" aria-hidden="true"></i> Xuất PDF
            </a>
            @if (canReceive && canReceiveStatus && totalRemaining > 0)
            {
                <a class="ops-btn" asp-area="Admin" asp-controller="AdminBranchReceipts" asp-action="ReceivePurchaseOrder" asp-route-purchaseOrderId="@Model.PurchaseOrderId">
                    <i class="fa-solid fa-box-open" aria-hidden="true"></i>
                    @(Model.ActiveReceiptDraftId.HasValue ? "Tiếp tục kiểm đếm" : "Nhận hàng")
                </a>
            }
            <a class="ops-btn" asp-action="Index"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Danh sách</a>
        </div>
    </header>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="ops-notice ops-notice-success">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="ops-notice ops-notice-error">@error</div>
    }
    @if (completedWithShortfall)
    {
        <div class="ops-notice ops-notice-info">Đơn đặt hàng đã hoàn thành với @AdminStatusDisplay.Quantity(totalClosed) đơn vị cơ sở được đóng theo quyết định không yêu cầu giao bù. Phần này không nhập kho và không hoàn thành yêu cầu nhập hàng.</div>
    }

    <section class="ops-metrics">
        <div class="ops-metric"><span class="ops-metric-label">Giá trị đặt</span><strong class="ops-metric-value">@AdminStatusDisplay.Currency(Model.TotalAmount)</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Dòng đã nhận hợp lệ</span><strong class="ops-metric-value success">@acceptedLineCount</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Dòng có từ chối</span><strong class="ops-metric-value danger">@rejectedLineCount</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Dòng còn phải giao</span><strong class="ops-metric-value warning">@remainingLineCount</strong></div>
    </section>

    <section class="ops-panel">
        <div class="ops-panel-header"><h2 class="ops-panel-title">Chi tiết nghĩa vụ giao hàng</h2></div>
        <div class="ops-panel-body p-0">
            <div class="ops-table-scroll cc-warehouse-table-shell">
                <table class="ops-table">
                    <thead>
                        <tr>
                            <th>Nguyên liệu</th>
                            <th>Nguồn yêu cầu nhập</th>
                            <th class="number">Đặt</th>
                            <th class="number">Số lượng chấp nhận</th>
                            <th class="number">Số lượng từ chối</th>
                            <th class="number">Phần còn lại đã đóng</th>
                            <th class="number">Còn phải giao</th>
                            <th>Lịch sử</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>
                                <strong class="ops-item-name">@line.IngredientName</strong>
                                @if (line.PurchaseMode == CafeChain.Models.Enums.Inventory.PurchaseMode.Loose)
                                {
                                    <div class="ops-secondary">Mua rời @AdminStatusDisplay.Quantity(line.OrderedProcurementQuantity.GetValueOrDefault()) @AdminStatusDisplay.Unit(line.ProcurementUnitName) · @AdminStatusDisplay.Currency(line.UnitPricePerProcurementUnit.GetValueOrDefault())/@AdminStatusDisplay.Unit(line.ProcurementUnitName)</div>
                                }
                                else
                                {
                                    <div class="ops-secondary">@AdminStatusDisplay.Quantity(line.PackageCount.GetValueOrDefault()) gói · @AdminStatusDisplay.Currency(line.PackagePriceSnapshot.GetValueOrDefault())/gói · 1 gói = @AdminStatusDisplay.Quantity(line.PackageQuantitySnapshot.GetValueOrDefault()) @AdminStatusDisplay.Unit(line.PackageUnitName)</div>
                                }
                            </td>
                            <td>@(line.RestockRequestId.HasValue ? AdminStatusDisplay.RestockReference(line.RestockReferenceCode, line.RestockRequestId.Value) : "Mua chủ động")</td>
                            <td class="number">@AdminStatusDisplay.Quantity(line.OrderedBaseQuantity) @AdminStatusDisplay.Unit(line.BaseUnitName)@if (line.OrderedProcurementQuantity.HasValue) { <div class="ops-secondary">@AdminStatusDisplay.Quantity(line.OrderedProcurementQuantity.Value) @AdminStatusDisplay.Unit(line.ProcurementUnitName)</div> }</td>
                            <td class="number">@AdminStatusDisplay.Quantity(line.AcceptedBaseQuantity) @AdminStatusDisplay.Unit(line.BaseUnitName)@if (line.AcceptedProcurementQuantity.HasValue) { <div class="ops-secondary">@AdminStatusDisplay.Quantity(line.AcceptedProcurementQuantity.Value) @AdminStatusDisplay.Unit(line.ProcurementUnitName)</div> }</td>
                            <td class="number">@AdminStatusDisplay.Quantity(line.RejectedBaseQuantity) @AdminStatusDisplay.Unit(line.BaseUnitName)</td>
                            <td class="number">
                                @AdminStatusDisplay.Quantity(line.ClosedRemainingQuantity) @AdminStatusDisplay.Unit(line.BaseUnitName)
                                @if (line.ClosedRemainingQuantity > 0 && line.ProcurementUnitName != null)
                                {
                                    <div class="ops-secondary">@AdminStatusDisplay.Quantity(line.ClosedRemainingQuantity / (line.OrderedBaseQuantity > 0 && line.OrderedProcurementQuantity.HasValue ? line.OrderedBaseQuantity / line.OrderedProcurementQuantity.Value : 1m)) @AdminStatusDisplay.Unit(line.ProcurementUnitName)</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(line.CloseRemainingReason))
                                {
                                    <div class="ops-secondary" title="@line.CloseRemainingReason">@line.CloseRemainingReason</div>
                                }
                            </td>
                            <td class="number"><strong>@AdminStatusDisplay.Quantity(line.RemainingBaseQuantity) @AdminStatusDisplay.Unit(line.BaseUnitName)</strong>@if (line.RemainingProcurementQuantity.HasValue) { <div class="ops-secondary">@AdminStatusDisplay.Quantity(line.RemainingProcurementQuantity.Value) @AdminStatusDisplay.Unit(line.ProcurementUnitName)</div> }</td>
                            <td>
                                <span class="ops-badge ops-badge-neutral"><i class="fa-solid fa-clock-rotate-left me-1"></i>@line.ReceiptCount lần nhận</span>
                                @if (canCloseRemaining && canReceiveStatus && line.RemainingBaseQuantity > 0)
                                {
                                    <div class="ops-line-closure-box p-2 mt-2 rounded-3 border text-start" style="background-color: #FAF6F0; border-color: #E2D7CD !important; min-width: 320px;">
                                        <label class="ops-form-label mb-1 d-block fw-bold text-dark small" for="closeReason-@line.PurchaseOrderLineId">
                                            Lý do không yêu cầu giao bù <span class="text-danger">*</span>
                                        </label>
                                        <form method="post" asp-action="CloseLineRemaining" asp-route-id="@Model.PurchaseOrderId" onsubmit="return confirm('Đóng phần còn lại sẽ chấm dứt nghĩa vụ giao bù và không nhập kho. Bạn chắc chắn?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="lineId" value="@line.PurchaseOrderLineId" />
                                            <input type="hidden" name="rowVersion" value="@line.RowVersion" />
                                            <input type="hidden" name="requestKey" value="@Guid.NewGuid().ToString("N")" />
                                            <div class="d-flex gap-2 align-items-center">
                                                <input id="closeReason-@line.PurchaseOrderLineId" class="ops-input flex-grow-1" name="reason" maxlength="500" required placeholder="Nhập lý do không yêu cầu giao..." style="min-width: 170px; text-align: left !important; font-size: 0.85rem; height: 36px !important; background: #FFFFFF !important;" />
                                                <button class="ops-btn ops-btn-danger text-nowrap flex-shrink-0" type="submit" style="white-space: nowrap; height: 36px !important; padding: 0 14px; font-size: 0.85rem; font-weight: 600;">Đóng phần còn lại</button>
                                            </div>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="ops-panel ops-action-panel">
        <div class="ops-panel-header">
            <div><h2 class="ops-panel-title">Thao tác tiếp theo</h2><div class="ops-secondary">Chỉ các thao tác phù hợp với trạng thái hiện tại được hiển thị.</div></div>
        </div>
        <div class="ops-panel-body">
            <div class="ops-inline-actions">
                <a class="ops-btn ops-btn-secondary" asp-action="Print" asp-route-id="@Model.PurchaseOrderId" target="_blank">
                    <i class="fa-solid fa-file-pdf text-danger" aria-hidden="true"></i> Xuất PDF Đơn đặt hàng
                </a>
                @if (canApprove && Model.Status == "DRAFT")
                {
                    <form method="post" asp-action="Approve" asp-route-id="@Model.PurchaseOrderId">@Html.AntiForgeryToken()<input type="hidden" name="rowVersion" value="@Model.RowVersion" /><button class="ops-btn ops-btn-primary">Duyệt đơn</button></form>
                }
                @if (Model.Status is "APPROVED" or "MARKED_AS_SENT" or "PARTIALLY_RECEIVED" or "COMPLETED")
                {
                    <form method="post" asp-action="MarkSent" asp-route-id="@Model.PurchaseOrderId">@Html.AntiForgeryToken()<input type="hidden" name="rowVersion" value="@Model.RowVersion" /><button class="ops-btn ops-btn-primary" @(canSend ? "" : "disabled") title="@(canSend ? "" : "Bạn chưa được cấp mã quyền PurchaseOrder.Send")">Đánh dấu đã gửi Nhà cung cấp</button></form>
                }
                @if (Model.ActiveReceiptDraftId.HasValue)
                {
                    <a class="ops-btn" asp-area="Admin" asp-controller="AdminBranchReceipts" asp-action="EditPurchaseOrderDraft" asp-route-id="@Model.ActiveReceiptDraftId">Mở phiếu kiểm đếm nháp</a>
                }
            </div>
            @if (canCancel && Model.Status is "DRAFT" or "APPROVED" or "MARKED_AS_SENT")
            {
                <details class="ops-danger-disclosure">
                    <summary>Hủy đơn đặt hàng</summary>
                    <div class="ops-danger-content">
                        <p class="ops-secondary">Chỉ hủy khi đơn không còn được tiếp tục xử lý. Lý do sẽ được lưu cùng lịch sử chứng từ.</p>
                        <form method="post" asp-action="Cancel" asp-route-id="@Model.PurchaseOrderId">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                            <label class="ops-form-label" for="cancelReason">Lý do hủy đơn đặt hàng <span class="ops-required">*</span></label>
                            <div class="ops-inline-actions"><input id="cancelReason" name="reason" class="ops-input flex-grow-1" maxlength="500" required placeholder="Nhập lý do hủy..." /><button class="ops-btn ops-btn-danger" type="submit">Xác nhận hủy</button></div>
                        </form>
                    </div>
                </details>
            }
        </div>
    </section>
</main>
