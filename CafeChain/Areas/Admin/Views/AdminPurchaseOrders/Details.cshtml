@model CafeChain.Application.DTOs.Admin.Procurement.PurchaseOrderDetailDto
@using CafeChain.ViewModels.Admin.Shared
@{
    ViewData["Title"] = "Chi tiết đơn đặt hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var canApprove = (bool?)ViewBag.CanApprove == true;
    var canSend = (bool?)ViewBag.CanSend == true;
    var canCancel = (bool?)ViewBag.CanCancel == true;
    var canReceive = (bool?)ViewBag.CanReceive == true;
    var canCloseRemaining = (bool?)ViewBag.CanCloseRemaining == true;
    var canReceiveStatus = Model.Status is "MARKED_AS_SENT" or "PARTIALLY_RECEIVED";
    var totalClosed = Model.Lines.Sum(x => x.ClosedRemainingQuantity);
    var totalRemaining = Model.Lines.Sum(x => x.RemainingBaseQuantity);
    var acceptedLineCount = Model.Lines.Count(x => x.AcceptedBaseQuantity > 0);
    var rejectedLineCount = Model.Lines.Count(x => x.RejectedBaseQuantity > 0);
    var remainingLineCount = Model.Lines.Count(x => x.RemainingBaseQuantity > 0);
    var completedWithShortfall = Model.Status == "COMPLETED" && totalClosed > 0;
    var orderStatus = AdminStatusDisplay.PurchaseOrder(Model.Status);
    var orderStatusLabel = completedWithShortfall
        ? "Hoàn thành có phần không giao bù"
        : orderStatus.Label;
    var lifecycle = new[]
    {
        (Label: "Đề nghị mua", Complete: Model.LinkedAdvices.Count > 0),
        (Label: "Đơn đặt hàng", Complete: true),
        (Label: "Duyệt", Complete: Model.ApprovedAtUtc.HasValue),
        (Label: "Gửi nhà cung cấp", Complete: Model.SentAtUtc.HasValue),
        (Label: "Nhận hàng", Complete: Model.Receipts.Any(x => x.Status == "CONFIRMED")),
        (Label: "Hoàn tất", Complete: Model.Status == "COMPLETED")
    };
}

<link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />
<link rel="stylesheet" href="~/css/Admin/Procurement/procurement-design-system.css" />

<main class="ops-shell cc-warehouse-page">
<header class="ops-header cc-warehouse-header cc-warehouse-header--compact cc-warehouse-header--detail">
        <div>
            <div class="ops-eyebrow">@Model.Code · @Model.StoreName</div>
            <h1 class="ops-title">@Model.SupplierName</h1>
            <p class="ops-subtitle">@orderStatusLabel. Số lượng còn phải giao chỉ trừ phần đã nhận hợp lệ hoặc phần được đóng rõ ràng.</p>
        </div>
        <div class="ops-actions">
            <a class="ops-btn ops-btn-primary" asp-action="Print" asp-route-id="@Model.PurchaseOrderId" target="_blank">
                <i class="fa-solid fa-file-pdf" aria-hidden="true"></i> Xuất PDF
            </a>
            @if (canReceive && canReceiveStatus && totalRemaining > 0)
            {
                <a class="ops-btn" asp-area="Admin" asp-controller="AdminBranchReceipts" asp-action="ReceivePurchaseOrder" asp-route-purchaseOrderId="@Model.PurchaseOrderId">
                    <i class="fa-solid fa-box-open" aria-hidden="true"></i>
                    @(Model.ActiveReceiptDraftId.HasValue ? "Tiếp tục kiểm đếm" : "Nhận hàng")
                </a>
            }
            <a class="ops-btn" asp-action="Index"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Danh sách</a>
        </div>
    </header>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="ops-notice ops-notice-success">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="ops-notice ops-notice-error">@error</div>
    }
    @if (completedWithShortfall)
    {
        <div class="ops-notice ops-notice-info">Đơn đặt hàng đã hoàn thành với một phần nghĩa vụ được đóng rõ ràng. Phần đã đóng không nhập kho; chỉ số lượng nhận hợp lệ mới cập nhật tồn.</div>
    }

    <section class="ops-panel" aria-labelledby="poLifecycleTitle">
        <div class="ops-panel-header">
            <div>
                <h2 id="poLifecycleTitle" class="ops-panel-title">Tiến trình đơn đặt hàng</h2>
                <div class="ops-secondary">Mỗi bước chỉ hoàn tất khi có sự kiện nghiệp vụ tương ứng.</div>
            </div>
            <span class="ops-badge @orderStatus.CssClass">@orderStatusLabel</span>
        </div>
        <div class="ops-panel-body">
            <div class="ops-workflow" role="list" aria-label="Các bước xử lý đơn đặt hàng">
                @for (var stepIndex = 0; stepIndex < lifecycle.Length; stepIndex++)
                {
                    var step = lifecycle[stepIndex];
                    var hasLaterCompleted = lifecycle.Skip(stepIndex + 1).Any(x => x.Complete);
                    var stepClass = step.Complete ? "is-completed" : !hasLaterCompleted && lifecycle.Take(stepIndex).All(x => x.Complete) ? "is-active" : "is-pending";
                    <div class="ops-workflow-step @stepClass" role="listitem" aria-current="@(stepClass == "is-active" ? "step" : null)">
                        <span class="ops-workflow-index" aria-hidden="true">@(step.Complete ? "✓" : (stepIndex + 1).ToString())</span>
                        <strong>@step.Label</strong>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="ops-panel" aria-labelledby="poIdentityTitle">
        <div class="ops-panel-header"><h2 id="poIdentityTitle" class="ops-panel-title">Thông tin chứng từ</h2></div>
        <div class="ops-panel-body ops-detail-grid">
            <div><span class="ops-secondary">Mã đơn</span><strong class="d-block">@Model.Code</strong></div>
            <div><span class="ops-secondary">Nhà cung cấp</span><strong class="d-block">@Model.SupplierName</strong></div>
            <div><span class="ops-secondary">Nơi nhận</span><strong class="d-block">@Model.StoreName</strong></div>
            <div><span class="ops-secondary">Người tạo</span><strong class="d-block">@Model.CreatedByStaffName</strong><small>@Model.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></div>
            <div><span class="ops-secondary">Người duyệt</span><strong class="d-block">@(Model.ApprovedByStaffName ?? "Chưa duyệt")</strong>@if (Model.ApprovedAtUtc.HasValue) { <small>@Model.ApprovedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small> }</div>
            <div><span class="ops-secondary">Người gửi nhà cung cấp</span><strong class="d-block">@(Model.SentByStaffName ?? "Chưa gửi")</strong>@if (Model.SentAtUtc.HasValue) { <small>@Model.SentAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small> }</div>
        </div>
    </section>

    <section class="ops-metrics">
        <div class="ops-metric"><span class="ops-metric-label">Giá trị đặt</span><strong class="ops-metric-value">@AdminStatusDisplay.Currency(Model.TotalAmount)</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Số dòng hàng</span><strong class="ops-metric-value">@Model.Lines.Count</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Dòng đã nhận đủ</span><strong class="ops-metric-value success">@Model.Lines.Count(x => x.RemainingBaseQuantity <= 0 && x.AcceptedBaseQuantity > 0)</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Dòng có từ chối</span><strong class="ops-metric-value danger">@rejectedLineCount</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Dòng còn phải giao</span><strong class="ops-metric-value warning">@remainingLineCount</strong></div>
    </section>

    <section class="ops-panel">
        <div class="ops-panel-header"><h2 class="ops-panel-title">Chi tiết nghĩa vụ giao hàng</h2></div>
        <div class="ops-panel-body p-0">
            <div class="ops-table-scroll cc-warehouse-table-shell">
                <table class="ops-table">
                    <thead>
                        <tr>
                            <th>Nguyên liệu</th>
                            <th>Nguồn yêu cầu nhập</th>
                            <th class="number">Đặt</th>
                            <th class="number">Số lượng chấp nhận</th>
                            <th class="number">Số lượng từ chối</th>
                            <th class="number">Phần còn lại đã đóng</th>
                            <th class="number">Còn phải giao</th>
                            <th>Lịch sử</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>
                                <strong class="ops-item-name">@line.IngredientName</strong>
                                @if (line.PurchaseMode == CafeChain.Models.Enums.Inventory.PurchaseMode.Loose)
                                {
                                    <div class="ops-secondary">Mua rời @AdminStatusDisplay.Quantity(line.OrderedProcurementQuantity.GetValueOrDefault()) @AdminStatusDisplay.Unit(line.ProcurementUnitName) · @AdminStatusDisplay.Currency(line.UnitPricePerProcurementUnit.GetValueOrDefault())/@AdminStatusDisplay.Unit(line.ProcurementUnitName)</div>
                                }
                                else
                                {
                                    <div class="ops-secondary">@AdminStatusDisplay.Quantity(line.PackageCount.GetValueOrDefault()) gói · @AdminStatusDisplay.Currency(line.PackagePriceSnapshot.GetValueOrDefault())/gói · 1 gói = @AdminStatusDisplay.Quantity(line.PackageQuantitySnapshot.GetValueOrDefault()) @AdminStatusDisplay.Unit(line.PackageUnitName)</div>
                                }
                            </td>
                            <td>@(line.RestockRequestId.HasValue ? AdminStatusDisplay.RestockReference(line.RestockReferenceCode, line.RestockRequestId.Value) : "Mua chủ động")</td>
                            <td class="number">
                                @if (line.PurchaseMode == CafeChain.Models.Enums.Inventory.PurchaseMode.Loose)
                                {
                                    <strong>@AdminStatusDisplay.Quantity(line.OrderedProcurementQuantity.GetValueOrDefault()) @AdminStatusDisplay.Unit(line.ProcurementUnitName)</strong>
                                    <div class="ops-secondary">@AdminStatusDisplay.Currency(line.UnitPricePerProcurementUnit.GetValueOrDefault())/@AdminStatusDisplay.Unit(line.ProcurementUnitName)</div>
                                }
                                else
                                {
                                    <strong>@AdminStatusDisplay.Quantity(line.PackageCount.GetValueOrDefault()) gói</strong>
                                    <div class="ops-secondary">Tương đương @AdminStatusDisplay.Quantity(line.PackageEquivalentQuantity.GetValueOrDefault()) @AdminStatusDisplay.Unit(line.PackageUnitName)</div>
                                }
                                <div class="ops-secondary">Thành tiền @AdminStatusDisplay.Currency(line.LineTotal)</div>
                            </td>
                            <td class="number">@AdminStatusDisplay.Quantity(line.AcceptedDisplayQuantity) @AdminStatusDisplay.Unit(line.FulfillmentDisplayUnitName)</td>
                            <td class="number">@AdminStatusDisplay.Quantity(line.RejectedDisplayQuantity) @AdminStatusDisplay.Unit(line.FulfillmentDisplayUnitName)<div class="ops-secondary">Không làm giảm phần còn phải giao</div></td>
                            <td class="number">
                                @AdminStatusDisplay.Quantity(line.ClosedDisplayQuantity) @AdminStatusDisplay.Unit(line.FulfillmentDisplayUnitName)
                                @if (!string.IsNullOrWhiteSpace(line.CloseRemainingReason))
                                {
                                    <div class="ops-secondary" title="@line.CloseRemainingReason">@line.CloseRemainingReason</div>
                                }
                            </td>
                            <td class="number"><strong>@AdminStatusDisplay.Quantity(line.RemainingDisplayQuantity) @AdminStatusDisplay.Unit(line.FulfillmentDisplayUnitName)</strong></td>
                            <td>
                                <span class="ops-badge ops-badge-neutral"><i class="fa-solid fa-clock-rotate-left me-1"></i>@line.ReceiptCount lần nhận</span>
                                @if (canCloseRemaining && canReceiveStatus && line.RemainingBaseQuantity > 0)
                                {
                                    <div class="ops-line-closure-box p-2 mt-2 rounded-3 border text-start" style="background-color: var(--cc-surface-muted); border-color: var(--cc-border) !important; min-width: 320px;">
                                        <form method="post" asp-action="CloseLineRemaining" asp-route-id="@Model.PurchaseOrderId" onsubmit="return confirm('Đóng phần còn lại sẽ chấm dứt nghĩa vụ giao bù và không nhập kho. Bạn chắc chắn?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="lineId" value="@line.PurchaseOrderLineId" />
                                            <input type="hidden" name="rowVersion" value="@line.RowVersion" />
                                            <input type="hidden" name="requestKey" value="@Guid.NewGuid().ToString("N")" />
                                            <div class="ops-form-grid">
                                                <div>
                                                    <label class="ops-form-label" for="closeQuantity-@line.PurchaseOrderLineId">Số lượng đóng (@AdminStatusDisplay.Unit(line.BaseUnitName)) <span class="ops-required">*</span></label>
                                                    <input id="closeQuantity-@line.PurchaseOrderLineId" class="ops-input" type="number" name="closeBaseQuantity" min="0.001" max="@line.RemainingBaseQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.001" value="@line.RemainingBaseQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" required />
                                                </div>
                                                <div>
                                                    <label class="ops-form-label" for="closeReason-@line.PurchaseOrderLineId">Lý do không yêu cầu giao bù <span class="ops-required">*</span></label>
                                                    <input id="closeReason-@line.PurchaseOrderLineId" class="ops-input" name="reason" maxlength="500" required placeholder="Ví dụ: Nhà cung cấp xác nhận không giao bù" />
                                                </div>
                                            </div>
                                            <div class="d-flex gap-2 align-items-center mt-2">
                                                <button class="ops-btn ops-btn-danger text-nowrap flex-shrink-0" type="submit" style="white-space: nowrap; height: 36px !important; padding: 0 14px; font-size: 0.85rem; font-weight: 600;">Đóng phần còn lại</button>
                                            </div>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <div class="ops-two-column">
        <section class="ops-panel" aria-labelledby="traceabilityTitle">
            <div class="ops-panel-header"><h2 id="traceabilityTitle" class="ops-panel-title">Chứng từ liên quan</h2></div>
            <div class="ops-panel-body">
                <div class="ops-link-list">
                    @foreach (var line in Model.Lines.Where(x => x.RestockRequestId.HasValue).GroupBy(x => new { x.RestockRequestId, x.RestockReferenceCode }).Select(x => x.Key))
                    {
                        <a class="ops-btn" asp-area="Admin" asp-controller="AdminRestockRequests" asp-action="Details" asp-route-id="@line.RestockRequestId">Yêu cầu nhập @AdminStatusDisplay.RestockReference(line.RestockReferenceCode, line.RestockRequestId!.Value)</a>
                    }
                    @foreach (var advice in Model.LinkedAdvices)
                    {
                        <a class="ops-btn" asp-area="Admin" asp-controller="AdminPurchaseAdvices" asp-action="Details" asp-route-id="@advice.PurchaseAdviceId">Đề nghị mua @advice.AdviceNumber</a>
                    }
                    @foreach (var receipt in Model.Receipts)
                    {
                        <a class="ops-btn" asp-area="Admin" asp-controller="AdminBranchReceipts" asp-action="Details" asp-route-id="@receipt.BranchReceiptId">Phiếu nhận @receipt.ReceiptCode</a>
                    }
                    @if (!Model.Lines.Any(x => x.RestockRequestId.HasValue) && Model.LinkedAdvices.Count == 0 && Model.Receipts.Count == 0)
                    {
                        <p class="ops-secondary mb-0">Chưa có chứng từ nguồn hoặc phiếu nhận liên kết.</p>
                    }
                </div>
            </div>
        </section>

        <section class="ops-panel" aria-labelledby="historyTitle">
            <div class="ops-panel-header"><h2 id="historyTitle" class="ops-panel-title">Lịch sử nghiệp vụ</h2></div>
            <div class="ops-panel-body">
                <ol class="ops-timeline">
                    @foreach (var item in Model.History.OrderByDescending(x => x.OccurredAtUtc))
                    {
                        <li>
                            <strong>@item.Title</strong>
                            <div class="ops-secondary">@item.Description</div>
                            <small>@item.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")@(!string.IsNullOrWhiteSpace(item.ActorName) ? $" · {item.ActorName}" : string.Empty)</small>
                        </li>
                    }
                </ol>
            </div>
        </section>
    </div>

    <section class="ops-panel ops-action-panel">
        <div class="ops-panel-header">
            <div><h2 class="ops-panel-title">Thao tác tiếp theo</h2><div class="ops-secondary">Chỉ các thao tác phù hợp với trạng thái hiện tại được hiển thị.</div></div>
        </div>
        <div class="ops-panel-body">
            <div class="ops-inline-actions">
                <a class="ops-btn ops-btn-secondary" asp-action="Print" asp-route-id="@Model.PurchaseOrderId" target="_blank">
                    <i class="fa-solid fa-file-pdf text-danger" aria-hidden="true"></i> Xuất PDF Đơn đặt hàng
                </a>
                @if (canApprove && Model.Status == "DRAFT")
                {
                    <form method="post" asp-action="Approve" asp-route-id="@Model.PurchaseOrderId">@Html.AntiForgeryToken()<input type="hidden" name="rowVersion" value="@Model.RowVersion" /><button class="ops-btn ops-btn-primary">Duyệt đơn</button></form>
                }
                @if (canSend && Model.Status == "APPROVED")
                {
                    <form method="post" asp-action="MarkSent" asp-route-id="@Model.PurchaseOrderId">@Html.AntiForgeryToken()<input type="hidden" name="rowVersion" value="@Model.RowVersion" /><button class="ops-btn ops-btn-primary">Đánh dấu đã gửi nhà cung cấp</button></form>
                }
                @if (Model.ActiveReceiptDraftId.HasValue)
                {
                    <a class="ops-btn" asp-area="Admin" asp-controller="AdminBranchReceipts" asp-action="EditPurchaseOrderDraft" asp-route-id="@Model.ActiveReceiptDraftId">Mở phiếu kiểm đếm nháp</a>
                }
            </div>
            @if (!canApprove && !canSend && !canReceive && !canCloseRemaining)
            {
                <div class="ops-notice ops-notice-info mt-3">
                    <strong>Bước tiếp theo do vai trò phụ trách thực hiện.</strong>
                    @if (Model.Status == "DRAFT")
                    {
                        <span> Chủ doanh nghiệp xem xét và duyệt đơn.</span>
                    }
                    else if (Model.Status == "APPROVED")
                    {
                        <span> Kế toán kho gửi đơn cho nhà cung cấp.</span>
                    }
                    else if (Model.Status is "MARKED_AS_SENT" or "PARTIALLY_RECEIVED")
                    {
                        <span> Kế toán kho hoặc bộ phận nhận hàng ghi nhận hàng nhà cung cấp giao.</span>
                    }
                    else
                    {
                        <span> Chứng từ hiện chỉ cho phép theo dõi và xem lịch sử.</span>
                    }
                </div>
            }
            @if (canCancel && Model.Status is "DRAFT" or "APPROVED" or "MARKED_AS_SENT")
            {
                <details class="ops-danger-disclosure">
                    <summary>Hủy đơn đặt hàng</summary>
                    <div class="ops-danger-content">
                        <p class="ops-secondary">Chỉ hủy khi đơn không còn được tiếp tục xử lý. Lý do sẽ được lưu cùng lịch sử chứng từ.</p>
                        <form method="post" asp-action="Cancel" asp-route-id="@Model.PurchaseOrderId">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                            <label class="ops-form-label" for="cancelReason">Lý do hủy đơn đặt hàng <span class="ops-required">*</span></label>
                            <div class="ops-inline-actions"><input id="cancelReason" name="reason" class="ops-input flex-grow-1" maxlength="500" required placeholder="Nhập lý do hủy..." /><button class="ops-btn ops-btn-danger" type="submit">Xác nhận hủy</button></div>
                        </form>
                    </div>
                </details>
            }
        </div>
    </section>
</main>
