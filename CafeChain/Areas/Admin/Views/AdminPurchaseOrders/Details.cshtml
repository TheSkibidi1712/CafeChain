@model CafeChain.Application.DTOs.Admin.Procurement.PurchaseOrderDetailDto
@using CafeChain.ViewModels.Admin.Shared
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ProcurementResource> L
@{
    ViewData["Title"] = L["PurchaseOrder.Details.Title"];
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var canApprove = (bool?)ViewBag.CanApprove == true;
    var canSend = (bool?)ViewBag.CanSend == true;
    var canCancel = (bool?)ViewBag.CanCancel == true;
    var canReceive = (bool?)ViewBag.CanReceive == true;
    var canCloseRemaining = (bool?)ViewBag.CanCloseRemaining == true;
    var canReceiveStatus = Model.Status is "MARKED_AS_SENT" or "PARTIALLY_RECEIVED";
    var totalClosed = Model.Lines.Sum(x => x.ClosedRemainingQuantity);
    var totalRemaining = Model.Lines.Sum(x => x.RemainingBaseQuantity);
    var acceptedLineCount = Model.Lines.Count(x => x.AcceptedBaseQuantity > 0);
    var rejectedLineCount = Model.Lines.Count(x => x.RejectedBaseQuantity > 0);
    var remainingLineCount = Model.Lines.Count(x => x.RemainingBaseQuantity > 0);
    var completedWithShortfall = Model.Status == "COMPLETED" && totalClosed > 0;
    var orderStatus = AdminStatusDisplay.PurchaseOrder(Model.Status);
    var orderStatusLabel = completedWithShortfall
        ? L["PurchaseOrder.Details.CompletedShortfall"].Value
        : orderStatus.Label;
    var lifecycle = new[]
    {
        (Label: L["PurchaseOrder.Details.Step.Advice"].Value, Complete: Model.LinkedAdvices.Count > 0),
        (Label: L["PurchaseOrder.Details.Step.Order"].Value, Complete: true),
        (Label: L["PurchaseOrder.Details.Step.Approve"].Value, Complete: Model.ApprovedAtUtc.HasValue),
        (Label: L["PurchaseOrder.Details.Step.Send"].Value, Complete: Model.SentAtUtc.HasValue),
        (Label: L["PurchaseOrder.Details.Step.Receive"].Value, Complete: Model.Receipts.Any(x => x.Status == "CONFIRMED")),
        (Label: L["PurchaseOrder.Details.Step.Complete"].Value, Complete: Model.Status == "COMPLETED")
    };
}

<link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />
<link rel="stylesheet" href="~/css/Admin/Procurement/procurement-design-system.css" />

<main class="ops-shell purchase-order-page purchase-order-detail-page cc-warehouse-page">
<header class="ops-header cc-warehouse-header cc-warehouse-header--compact cc-warehouse-header--detail">
        <div>
            <div class="ops-eyebrow">@Model.Code · @Model.StoreName</div>
            <h1 class="ops-title">@Model.SupplierName</h1>
            <p class="ops-subtitle">@L["PurchaseOrder.Details.Subtitle", orderStatusLabel]</p>
        </div>
        <div class="ops-actions">
            <a class="ops-btn ops-btn-primary" asp-action="Print" asp-route-id="@Model.PurchaseOrderId" target="_blank">
                <i class="fa-solid fa-file-pdf" aria-hidden="true"></i> @L["PurchaseOrder.Details.ExportPdf"]
            </a>
            @if (canReceive && canReceiveStatus && totalRemaining > 0)
            {
                <a class="ops-btn" asp-area="Admin" asp-controller="AdminBranchReceipts" asp-action="ReceivePurchaseOrder" asp-route-purchaseOrderId="@Model.PurchaseOrderId">
                    <i class="fa-solid fa-box-open" aria-hidden="true"></i>
                    @(Model.ActiveReceiptDraftId.HasValue ? L["PurchaseOrder.Details.ContinueCount"] : L["PurchaseOrder.Details.Receive"])
                </a>
            }
            <a class="ops-btn" asp-action="Index"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> @L["Common.List"]</a>
        </div>
    </header>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="ops-notice ops-notice-success">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="ops-notice ops-notice-error">@error</div>
    }
    @if (completedWithShortfall)
    {
        <div class="ops-notice ops-notice-info">@L["PurchaseOrder.Details.ShortfallNotice"]</div>
    }

    <section class="ops-panel" aria-labelledby="poLifecycleTitle">
        <div class="ops-panel-header">
            <div>
                <h2 id="poLifecycleTitle" class="ops-panel-title">@L["PurchaseOrder.Details.Lifecycle"]</h2>
                <div class="ops-secondary">@L["PurchaseOrder.Details.LifecycleHelp"]</div>
            </div>
            <span class="ops-badge @orderStatus.CssClass">@orderStatusLabel</span>
        </div>
        <div class="ops-panel-body">
            <div class="ops-workflow" role="list" aria-label="@L["PurchaseOrder.Details.StepsAria"]">
                @for (var stepIndex = 0; stepIndex < lifecycle.Length; stepIndex++)
                {
                    var step = lifecycle[stepIndex];
                    var hasLaterCompleted = lifecycle.Skip(stepIndex + 1).Any(x => x.Complete);
                    var stepClass = step.Complete ? "is-completed" : !hasLaterCompleted && lifecycle.Take(stepIndex).All(x => x.Complete) ? "is-active" : "is-pending";
                    <div class="ops-workflow-step @stepClass" role="listitem" aria-current="@(stepClass == "is-active" ? "step" : null)">
                        <span class="ops-workflow-index" aria-hidden="true">@(step.Complete ? "✓" : (stepIndex + 1).ToString())</span>
                        <strong>@step.Label</strong>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="ops-panel" aria-labelledby="poIdentityTitle">
        <div class="ops-panel-header"><h2 id="poIdentityTitle" class="ops-panel-title">@L["PurchaseOrder.Details.DocumentInfo"]</h2></div>
        <div class="ops-panel-body ops-detail-grid">
            <div><span class="ops-secondary">@L["PurchaseOrder.Code"]</span><strong class="d-block">@Model.Code</strong></div>
            <div><span class="ops-secondary">@L["Common.Supplier"]</span><strong class="d-block">@Model.SupplierName</strong></div>
            <div><span class="ops-secondary">@L["PurchaseOrder.Details.Destination"]</span><strong class="d-block">@Model.StoreName</strong></div>
            <div><span class="ops-secondary">@L["PurchaseOrder.Details.CreatedBy"]</span><strong class="d-block">@Model.CreatedByStaffName</strong><small>@Model.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></div>
            <div><span class="ops-secondary">@L["PurchaseOrder.Details.ApprovedBy"]</span><strong class="d-block">@(Model.ApprovedByStaffName ?? L["PurchaseOrder.Details.NotApproved"].Value)</strong>@if (Model.ApprovedAtUtc.HasValue) { <small>@Model.ApprovedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small> }</div>
            <div><span class="ops-secondary">@L["PurchaseOrder.Details.SentBy"]</span><strong class="d-block">@(Model.SentByStaffName ?? L["PurchaseOrder.Details.NotSent"].Value)</strong>@if (Model.SentAtUtc.HasValue) { <small>@Model.SentAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small> }</div>
        </div>
    </section>

    <section class="ops-metrics">
        <div class="ops-metric"><span class="ops-metric-label">@L["PurchaseOrder.Details.OrderValue"]</span><strong class="ops-metric-value">@AdminStatusDisplay.Currency(Model.TotalAmount)</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">@L["PurchaseOrder.Details.LineCount"]</span><strong class="ops-metric-value">@Model.Lines.Count</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">@L["PurchaseOrder.Details.FullyReceived"]</span><strong class="ops-metric-value success">@Model.Lines.Count(x => x.RemainingBaseQuantity <= 0 && x.AcceptedBaseQuantity > 0)</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">@L["PurchaseOrder.Details.RejectedLines"]</span><strong class="ops-metric-value danger">@rejectedLineCount</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">@L["PurchaseOrder.Details.RemainingLines"]</span><strong class="ops-metric-value warning">@remainingLineCount</strong></div>
    </section>

    <section class="ops-panel">
        <div class="ops-panel-header"><h2 class="ops-panel-title">@L["PurchaseOrder.Details.ObligationTitle"]</h2></div>
        <div class="ops-panel-body p-0">
            <div class="ops-table-scroll cc-warehouse-table-shell">
                <table class="ops-table">
                    <thead>
                        <tr>
                            <th>@L["Common.Ingredient"]</th>
                            <th>@L["PurchaseOrder.Details.RestockSource"]</th>
                            <th class="number">@L["PurchaseOrder.Details.Ordered"]</th>
                            <th class="number">@L["PurchaseOrder.Details.Accepted"]</th>
                            <th class="number">@L["PurchaseOrder.Details.Rejected"]</th>
                            <th class="number">@L["PurchaseOrder.Details.ClosedRemainder"]</th>
                            <th class="number">@L["PurchaseOrder.Details.StillDue"]</th>
                            <th>@L["PurchaseOrder.Details.History"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>
                                <strong class="ops-item-name">@line.IngredientName</strong>
                                @if (line.PurchaseMode == CafeChain.Models.Enums.Inventory.PurchaseMode.Loose)
                                {
                                    <div class="ops-secondary">@L["PurchaseOrder.Details.LooseMeta", AdminStatusDisplay.Quantity(line.OrderedProcurementQuantity.GetValueOrDefault()), AdminStatusDisplay.Unit(line.ProcurementUnitName), AdminStatusDisplay.Currency(line.UnitPricePerProcurementUnit.GetValueOrDefault())]</div>
                                }
                                else
                                {
                                    <div class="ops-secondary">@L["PurchaseOrder.Details.PackageMeta", AdminStatusDisplay.Quantity(line.PackageCount.GetValueOrDefault()), AdminStatusDisplay.Currency(line.PackagePriceSnapshot.GetValueOrDefault()), AdminStatusDisplay.Quantity(line.PackageQuantitySnapshot.GetValueOrDefault()), AdminStatusDisplay.Unit(line.PackageUnitName)]</div>
                                }
                            </td>
                            <td>@(line.RestockRequestId.HasValue ? AdminStatusDisplay.RestockReference(line.RestockReferenceCode, line.RestockRequestId.Value) : L["PurchaseOrder.Details.DirectPurchase"].Value)</td>
                            <td class="number">
                                @if (line.PurchaseMode == CafeChain.Models.Enums.Inventory.PurchaseMode.Loose)
                                {
                                    <strong>@AdminStatusDisplay.Quantity(line.OrderedProcurementQuantity.GetValueOrDefault()) @AdminStatusDisplay.Unit(line.ProcurementUnitName)</strong>
                                    <div class="ops-secondary">@AdminStatusDisplay.Currency(line.UnitPricePerProcurementUnit.GetValueOrDefault())/@AdminStatusDisplay.Unit(line.ProcurementUnitName)</div>
                                }
                                else
                                {
                                    <strong>@L["Reorder.PackageCount", AdminStatusDisplay.Quantity(line.PackageCount.GetValueOrDefault())]</strong>
                                    <div class="ops-secondary">@L["PurchaseOrder.Details.Equivalent", AdminStatusDisplay.Quantity(line.PackageEquivalentQuantity.GetValueOrDefault()), AdminStatusDisplay.Unit(line.PackageUnitName)]</div>
                                }
                                <div class="ops-secondary">@L["PurchaseOrder.Details.LineAmount", AdminStatusDisplay.Currency(line.LineTotal)]</div>
                            </td>
                            <td class="number">@AdminStatusDisplay.Quantity(line.AcceptedDisplayQuantity) @AdminStatusDisplay.Unit(line.FulfillmentDisplayUnitName)</td>
                            <td class="number">@AdminStatusDisplay.Quantity(line.RejectedDisplayQuantity) @AdminStatusDisplay.Unit(line.FulfillmentDisplayUnitName)<div class="ops-secondary">@L["PurchaseOrder.Details.RejectDoesNotReduce"]</div></td>
                            <td class="number">
                                @AdminStatusDisplay.Quantity(line.ClosedDisplayQuantity) @AdminStatusDisplay.Unit(line.FulfillmentDisplayUnitName)
                                @if (!string.IsNullOrWhiteSpace(line.CloseRemainingReason))
                                {
                                    <div class="ops-secondary" title="@line.CloseRemainingReason">@line.CloseRemainingReason</div>
                                }
                            </td>
                            <td class="number"><strong>@AdminStatusDisplay.Quantity(line.RemainingDisplayQuantity) @AdminStatusDisplay.Unit(line.FulfillmentDisplayUnitName)</strong></td>
                            <td>
                                <span class="ops-badge ops-badge-neutral"><i class="fa-solid fa-clock-rotate-left me-1"></i>@L["PurchaseOrder.Details.ReceiptCount", line.ReceiptCount]</span>
                            </td>
                        </tr>
                        @if (canCloseRemaining && canReceiveStatus && line.RemainingBaseQuantity > 0)
                        {
                            <tr>
                                <td colspan="8" class="p-0 border-0">
                                    <div class="ops-line-closure-box p-3 mx-2 my-2 rounded-3 border text-start" style="background-color: var(--cc-surface-muted); border-color: var(--cc-border) !important;">
                                        <form method="post" asp-action="CloseLineRemaining" asp-route-id="@Model.PurchaseOrderId" onsubmit="return confirm('@L["PurchaseOrder.Details.ClosePrompt"]');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="lineId" value="@line.PurchaseOrderLineId" />
                                            <input type="hidden" name="rowVersion" value="@line.RowVersion" />
                                            <input type="hidden" name="requestKey" value="@Guid.NewGuid().ToString("N")" />
                                            <div class="ops-form-grid" style="grid-template-columns: 1fr 2fr;">
                                                <div>
                                                    <label class="ops-form-label" for="closeQuantity-@line.PurchaseOrderLineId">@L["PurchaseOrder.Details.CloseQty", AdminStatusDisplay.Unit(line.BaseUnitName)] <span class="ops-required">*</span></label>
                                                    <input id="closeQuantity-@line.PurchaseOrderLineId" class="ops-input w-100" type="number" name="closeBaseQuantity" min="0.001" max="@line.RemainingBaseQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.001" value="@line.RemainingBaseQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" required />
                                                </div>
                                                <div>
                                                    <label class="ops-form-label" for="closeReason-@line.PurchaseOrderLineId">@L["PurchaseOrder.Details.CloseReason"] <span class="ops-required">*</span></label>
                                                    <div class="d-flex gap-2">
                                                        <input id="closeReason-@line.PurchaseOrderLineId" class="ops-input flex-grow-1" name="reason" maxlength="500" required placeholder="@L["PurchaseOrder.Details.CloseReasonPlaceholder"]" />
                                                        <button class="ops-btn ops-btn-danger text-nowrap flex-shrink-0" type="submit" style="white-space: nowrap; height: 38px !important; padding: 0 16px; font-size: 0.85rem; font-weight: 700;">@L["PurchaseOrder.Details.CloseRemaining"]</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <div class="ops-two-column">
        <section class="ops-panel" aria-labelledby="traceabilityTitle">
            <div class="ops-panel-header"><h2 id="traceabilityTitle" class="ops-panel-title">@L["PurchaseOrder.Details.RelatedDocs"]</h2></div>
            <div class="ops-panel-body">
                <div class="ops-link-list">
                    @foreach (var line in Model.Lines.Where(x => x.RestockRequestId.HasValue).GroupBy(x => new { x.RestockRequestId, x.RestockReferenceCode }).Select(x => x.Key))
                    {
                        <a class="ops-btn" asp-area="Admin" asp-controller="AdminRestockRequests" asp-action="Details" asp-route-id="@line.RestockRequestId">@L["PurchaseOrder.Details.RestockLink", AdminStatusDisplay.RestockReference(line.RestockReferenceCode, line.RestockRequestId!.Value)]</a>
                    }
                    @foreach (var advice in Model.LinkedAdvices)
                    {
                        <a class="ops-btn" asp-area="Admin" asp-controller="AdminPurchaseAdvices" asp-action="Details" asp-route-id="@advice.PurchaseAdviceId">@L["PurchaseOrder.Details.AdviceLink", advice.AdviceNumber]</a>
                    }
                    @foreach (var receipt in Model.Receipts)
                    {
                        <a class="ops-btn" asp-area="Admin" asp-controller="AdminBranchReceipts" asp-action="Details" asp-route-id="@receipt.BranchReceiptId">@L["PurchaseOrder.Details.ReceiptLink", receipt.ReceiptCode]</a>
                    }
                    @if (!Model.Lines.Any(x => x.RestockRequestId.HasValue) && Model.LinkedAdvices.Count == 0 && Model.Receipts.Count == 0)
                    {
                        <p class="ops-secondary mb-0">@L["PurchaseOrder.Details.NoRelated"]</p>
                    }
                </div>
            </div>
        </section>

        <section class="ops-panel" aria-labelledby="historyTitle">
            <div class="ops-panel-header"><h2 id="historyTitle" class="ops-panel-title">@L["PurchaseOrder.Details.HistoryTitle"]</h2></div>
            <div class="ops-panel-body">
                <ol class="ops-timeline">
                    @foreach (var item in Model.History.OrderByDescending(x => x.OccurredAtUtc))
                    {
                        <li>
                            <strong>@item.Title</strong>
                            <div class="ops-secondary">@item.Description</div>
                            <small>@item.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")@(!string.IsNullOrWhiteSpace(item.ActorName) ? $" · {item.ActorName}" : string.Empty)</small>
                        </li>
                    }
                </ol>
            </div>
        </section>
    </div>

    <section class="ops-panel ops-action-panel">
        <div class="ops-panel-header">
            <div><h2 class="ops-panel-title">@L["PurchaseOrder.Details.NextActions"]</h2><div class="ops-secondary">@L["PurchaseOrder.Details.NextHelp"]</div></div>
        </div>
        <div class="ops-panel-body">
            <div class="ops-inline-actions">
                <a class="ops-btn ops-btn-secondary" asp-action="Print" asp-route-id="@Model.PurchaseOrderId" target="_blank">
                    <i class="fa-solid fa-file-pdf text-danger" aria-hidden="true"></i> @L["PurchaseOrder.Details.ExportPdfOrder"]
                </a>
                @if (canApprove && Model.Status == "DRAFT")
                {
                    <form method="post" asp-action="Approve" asp-route-id="@Model.PurchaseOrderId">@Html.AntiForgeryToken()<input type="hidden" name="rowVersion" value="@Model.RowVersion" /><button class="ops-btn ops-btn-primary">@L["PurchaseOrder.Details.Approve"]</button></form>
                }
                @if (canSend && Model.Status == "APPROVED")
                {
                    <form method="post" asp-action="MarkSent" asp-route-id="@Model.PurchaseOrderId">@Html.AntiForgeryToken()<input type="hidden" name="rowVersion" value="@Model.RowVersion" /><button class="ops-btn ops-btn-primary">@L["PurchaseOrder.Details.MarkSent"]</button></form>
                }
                @if (Model.ActiveReceiptDraftId.HasValue)
                {
                    <a class="ops-btn" asp-area="Admin" asp-controller="AdminBranchReceipts" asp-action="EditPurchaseOrderDraft" asp-route-id="@Model.ActiveReceiptDraftId">@L["PurchaseOrder.Details.OpenDraft"]</a>
                }
            </div>
            @if (!canApprove && !canSend && !canReceive && !canCloseRemaining)
            {
                <div class="ops-notice ops-notice-info mt-3">
                    <strong>@L["PurchaseOrder.Details.RoleNextTitle"]</strong>
                    @if (Model.Status == "DRAFT")
                    {
                        <span> @L["PurchaseOrder.Details.RoleNext.Draft"]</span>
                    }
                    else if (Model.Status == "APPROVED")
                    {
                        <span> @L["PurchaseOrder.Details.RoleNext.Approved"]</span>
                    }
                    else if (Model.Status is "MARKED_AS_SENT" or "PARTIALLY_RECEIVED")
                    {
                        <span> @L["PurchaseOrder.Details.RoleNext.Receive"]</span>
                    }
                    else
                    {
                        <span> @L["PurchaseOrder.Details.RoleNext.Track"]</span>
                    }
                </div>
            }
            @if (canCancel && Model.Status is "DRAFT" or "APPROVED" or "MARKED_AS_SENT")
            {
                <details class="ops-danger-disclosure">
                    <summary>@L["PurchaseOrder.Details.CancelOrder"]</summary>
                    <div class="ops-danger-content">
                        <p class="ops-secondary">@L["PurchaseOrder.Details.CancelHelp"]</p>
                        <form method="post" asp-action="Cancel" asp-route-id="@Model.PurchaseOrderId">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                            <label class="ops-form-label" for="cancelReason">@L["PurchaseOrder.Details.CancelReason"] <span class="ops-required">*</span></label>
                            <div class="ops-inline-actions"><input id="cancelReason" name="reason" class="ops-input flex-grow-1" maxlength="500" required placeholder="@L["PurchaseOrder.Details.CancelPlaceholder"]" /><button class="ops-btn ops-btn-danger" type="submit">@L["PurchaseOrder.Details.ConfirmCancel"]</button></div>
                        </form>
                    </div>
                </details>
            }
        </div>
    </section>
</main>
