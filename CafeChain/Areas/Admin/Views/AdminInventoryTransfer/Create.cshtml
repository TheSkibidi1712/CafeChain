@model CafeChain.ViewModels.Admin.InventoryTransfers.AdminInventoryTransferCreateVM
@inject Microsoft.Extensions.Localization.IStringLocalizer<CafeChain.InventoryResource> InventoryText

@{
    ViewData["Title"] = InventoryText["Transfer.Create.Title"];
}

<link rel="stylesheet" href="~/css/Admin/InventoryTransfer/inventorytransfer.css" />

<div class="transfer-page"
     id="inventoryTransferForm"
     data-items-url="@Url.Action("Items", "AdminInventoryTransfer", new { area = "Admin" })"
     data-preflight-url="@Url.Action("Preflight", "AdminInventoryTransfer", new { area = "Admin" })"
     data-save-draft-url="@Url.Action("SaveDraft", "AdminInventoryTransfer", new { area = "Admin" })"
     data-dispatch-url="@Url.Action("Dispatch", "AdminInventoryTransfer", new { area = "Admin" })"
     data-detail-url="@Url.Action("Detail", "AdminInventoryTransfer", new { area = "Admin" })">
    @Html.AntiForgeryToken()
    <input type="hidden" id="transferId" value="" />
    <input type="hidden" id="transferRowVersion" value="" />

    @await Html.PartialAsync("Partials/Create/_Header", Model)

    <main class="transfer-main">
        @await Html.PartialAsync("Partials/Create/_DocumentInfo", Model)
        @await Html.PartialAsync("Partials/Create/_StoreSelector", Model)
        @await Html.PartialAsync("Partials/Create/_DetailTable", Model)
        @await Html.PartialAsync("Partials/Create/_Note", Model)
    </main>

    @await Html.PartialAsync("Partials/Create/_ActionBar", Model)
</div>

<partial name="_InventoryTransferUiCatalog" />
<script src="~/js/Admin/InventoryTransfer/inventorytransfercreate.js"></script>
