@model CafeChain.ViewModels.Admin.InventoryTransfers.AdminInventoryTransferIndexVM
@using CafeChain.Models.Enums.Inventory
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<CafeChain.InventoryResource> InventoryText

@{
    ViewData["Title"] = InventoryText["Transfer.Index.Title"];
    var previousPage = Model.Page <= 1 ? 1 : Model.Page - 1;
    var nextPage = Model.Page >= Model.TotalPages ? Model.TotalPages : Model.Page + 1;
    string StatusLabel(InventoryTransferStatus status) => InventoryText[$"Transfer.Status.{status}"];
    string PurposeLabel(InventoryTransferPurpose purpose) => InventoryText[$"Transfer.Purpose.{purpose}"];
}

<link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />
<link rel="stylesheet" href="~/css/Admin/InventoryTransfer/inventorytransfer.css" />

<main class="transfer-page transfer-index-page ops-shell cc-warehouse-page">
    <header class="transfer-header ops-header cc-warehouse-header">
        <div>
            <div class="transfer-eyebrow">@InventoryText["Transfer.Index.Eyebrow"]</div>
            <h1><i class="fa-solid fa-arrows-left-right me-2 text-warning" aria-hidden="true"></i>@InventoryText["Transfer.Index.Title"]</h1>
            <p class="transfer-subtitle">@InventoryText["Transfer.Index.Description"]</p>
        </div>

        <div class="transfer-header-actions ops-actions">
            <a class="transfer-primary-button"
               asp-area="Admin"
               asp-controller="AdminInventoryTransfer"
               asp-action="Create">
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
                @InventoryText["Transfer.Index.Create"]
            </a>
        </div>
    </header>

    <div class="transfer-main">
        <section class="transfer-card cc-warehouse-filter">
            <div class="transfer-filter-heading">
                <div>
                    <span>@InventoryText["Transfer.Index.QuickFilter"]</span>
                    <strong>@InventoryText["Transfer.Index.Find"]</strong>
                </div>
                <span class="transfer-filter-scope"><i class="fa-solid fa-filter" aria-hidden="true"></i>@InventoryText["Transfer.Index.FilterHint"]</span>
            </div>
            <form method="get" class="transfer-filter-grid">
                <div class="transfer-field">
                    <label for="Keyword">@InventoryText["Transfer.Code"]</label>
                    <input id="Keyword"
                           name="Keyword"
                           class="transfer-input"
                           value="@Model.Keyword"
                           placeholder="@InventoryText["Transfer.Index.CodePlaceholder"]" />
                </div>

                <div class="transfer-field">
                    <label for="Status">@InventoryText["Common.Status"]</label>
                    <select id="Status" name="Status" class="transfer-input">
                        <option value="">@InventoryText["Transfer.Index.AllStatuses"]</option>
                        @foreach (InventoryTransferStatus status in Enum.GetValues(typeof(InventoryTransferStatus)))
                        {
                            <option value="@status" selected="@(Model.Status == status)">
                                @StatusLabel(status)
                            </option>
                        }
                    </select>
                </div>

                <div class="transfer-field">
                    <label for="FromStoreId">@InventoryText["Transfer.SourceStore"]</label>
                    <select id="FromStoreId" name="FromStoreId" class="transfer-input">
                        <option value="">@InventoryText["Transfer.Index.AllSourceStores"]</option>
                        @foreach (var store in Model.Stores)
                        {
                            <option value="@store.StoreId" selected="@(Model.FromStoreId == store.StoreId)">
                                @store.StoreName
                            </option>
                        }
                    </select>
                </div>

                <div class="transfer-field">
                    <label for="ToStoreId">@InventoryText["Transfer.DestinationStore"]</label>
                    <select id="ToStoreId" name="ToStoreId" class="transfer-input">
                        <option value="">@InventoryText["Transfer.Index.AllDestinationStores"]</option>
                        @foreach (var store in Model.Stores)
                        {
                            <option value="@store.StoreId" selected="@(Model.ToStoreId == store.StoreId)">
                                @store.StoreName
                            </option>
                        }
                    </select>
                </div>

                <input type="hidden" name="PageSize" value="@Model.PageSize" />

                <div class="transfer-filter-actions">
                    <button class="transfer-secondary-button" type="submit">
                        <i class="fa-solid fa-filter"></i>
                        @InventoryText["Common.Filter"]
                    </button>

                    <a class="transfer-ghost-button"
                       asp-area="Admin"
                       asp-controller="AdminInventoryTransfer"
                       asp-action="Index">
                        <i class="fa-solid fa-rotate-left"></i>
                        @InventoryText["Common.ClearFilters"]
                    </a>
                </div>
            </form>
        </section>

        <section class="transfer-card">
            <div class="transfer-toolbar">
                <div>
                    <span class="section-kicker">
                        <i class="fas fa-list"></i>
                        @InventoryText["Transfer.Index.List"]
                    </span>
                    <h2>@InventoryText["Transfer.Index.Total", Model.TotalItems]</h2>
                </div>
            </div>

            <div class="transfer-table-wrap">
                <table class="transfer-table transfer-index-table">
                    <thead>
                        <tr>
                            <th class="text-center">@InventoryText["Transfer.Code"]</th>
                            <th class="text-center">@InventoryText["Common.Status"]</th>
                            <th class="text-center">@InventoryText["Transfer.Purpose"]</th>
                            <th class="text-center">@InventoryText["Transfer.SourceStore"]</th>
                            <th class="text-center">@InventoryText["Transfer.DestinationStore"]</th>
                            <th class="text-center">@InventoryText["Transfer.CreatedBy"]</th>
                            <th class="text-center">@InventoryText["Transfer.DocumentDate"]</th>
                            <th class="text-center">@InventoryText["Common.LineCount"]</th>
                            <th class="text-center">@InventoryText["Common.Actions"]</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (!Model.Items.Any())
                        {
                            <tr class="transfer-empty-row">
                                <td colspan="9" class="text-center">@InventoryText["Transfer.Index.Empty"]</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="text-center">
                                        <strong>@item.Code</strong>
                                        <span class="transfer-index-date">
                                            @InventoryText["Common.CreatedAt", item.CreatedAt.ToLocalTime().ToString("g")]
                                        </span>
                                    </td>

                                    <td class="text-center">
                                        <span class="transfer-status-pill transfer-status-@item.Status.ToString().ToLower()">
                                            @StatusLabel(item.Status)
                                        </span>
                                    </td>

                                    <td class="text-center">@PurposeLabel(item.Purpose)</td>
                                    <td class="text-center">@item.FromStoreName</td>
                                    <td class="text-center">@item.ToStoreName</td>
                                    <td class="text-center">@(string.IsNullOrWhiteSpace(item.CreatedByName) ? "-" : item.CreatedByName)</td>
                                    <td class="text-center">@item.DocumentDate.ToString("d")</td>
                                    <td class="text-center">@item.DetailCount</td>
                                    <td class="text-center">
                                        <a class="transfer-outline-button transfer-table-action"
                                           asp-area="Admin"
                                           asp-controller="AdminInventoryTransfer"
                                           asp-action="Detail"
                                           asp-route-id="@item.InventoryTransferId">
                                            <i class="fas fa-eye"></i>
                                            @InventoryText["Common.View"]
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="transfer-pagination justify-content-center">
                <a class="transfer-ghost-button @(Model.Page <= 1 ? "disabled" : "")"
                   asp-area="Admin"
                   asp-controller="AdminInventoryTransfer"
                   asp-action="Index"
                   asp-route-Page="@previousPage"
                   asp-route-PageSize="@Model.PageSize"
                   asp-route-Keyword="@Model.Keyword"
                   asp-route-Status="@Model.Status"
                   asp-route-FromStoreId="@Model.FromStoreId"
                   asp-route-ToStoreId="@Model.ToStoreId">
                    <i class="fas fa-chevron-left"></i>
                    @InventoryText["Common.Previous"]
                </a>

                <span>@InventoryText["Common.PageOf", Model.Page, Model.TotalPages]</span>

                <a class="transfer-ghost-button @(Model.Page >= Model.TotalPages ? "disabled" : "")"
                   asp-area="Admin"
                   asp-controller="AdminInventoryTransfer"
                   asp-action="Index"
                   asp-route-Page="@nextPage"
                   asp-route-PageSize="@Model.PageSize"
                   asp-route-Keyword="@Model.Keyword"
                   asp-route-Status="@Model.Status"
                   asp-route-FromStoreId="@Model.FromStoreId"
                   asp-route-ToStoreId="@Model.ToStoreId">
                    @InventoryText["Common.Next"]
                    <i class="fas fa-chevron-right"></i>
                </a>
            </div>
        </section>
    </div>
</main>
