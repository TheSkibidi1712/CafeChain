@model CafeChain.ViewModels.Admin.InventoryTransfers.AdminInventoryTransferCreateVM
@inject Microsoft.Extensions.Localization.IStringLocalizer<CafeChain.InventoryResource> InventoryText

<section class="transfer-card">
    <div class="transfer-toolbar">
        <div>
            <span class="section-kicker">
                <i class="fas fa-boxes-stacked"></i>
                @InventoryText["Transfer.Create.LinesTitle"]
            </span>
            <p id="transferStockStatus">@InventoryText["Transfer.Create.SelectSourceToLoad"]</p>
        </div>

        <button class="transfer-outline-button" type="button" id="btnAddTransferIngredient" disabled>
            <i class="fas fa-plus"></i>
            @InventoryText["Common.AddLine"]
        </button>
    </div>

    <div class="transfer-table-wrap">
        <table class="transfer-table">
            <thead>
                <tr>
                    <th class="col-index">#</th>
                    <th>@InventoryText["Common.Item"]</th>
                    <th>@InventoryText["Common.Unit"]</th>
                    <th>@InventoryText["Transfer.Create.SourceStock"]</th>
                    <th>@InventoryText["Transfer.Create.TransferQuantity"]</th>
                    <th title="@InventoryText["Transfer.Create.RemainingTitle"]">@InventoryText["Transfer.Create.Remaining"]</th>
                    <th>@InventoryText["Common.Status"]</th>
                    <th class="col-action"></th>
                </tr>
            </thead>
            <tbody id="transferDetailBody">
                <tr class="transfer-empty-row">
                    <td colspan="8">@InventoryText["Transfer.Create.NoItems"]</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="transfer-warning" id="transferWarnings" hidden></div>
</section>
