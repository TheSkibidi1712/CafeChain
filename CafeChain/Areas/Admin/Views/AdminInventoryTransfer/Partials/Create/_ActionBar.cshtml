@model CafeChain.ViewModels.Admin.InventoryTransfers.AdminInventoryTransferCreateVM
@inject Microsoft.Extensions.Localization.IStringLocalizer<CafeChain.InventoryResource> InventoryText

<footer class="transfer-action-bar">
    <div class="transfer-action-status" id="transferActionStatus">
        <i class="fas fa-circle-info"></i>
        @InventoryText["Transfer.Create.CheckStockFirst"]
    </div>

    <div class="transfer-action-buttons">
        <a class="transfer-ghost-button"
           asp-area="Admin"
           asp-controller="AdminInventoryTransfer"
           asp-action="Index">
            <i class="fas fa-xmark"></i>
            @InventoryText["Common.Cancel"]
        </a>

        <button class="transfer-secondary-button" type="button" id="btnSaveTransferDraft">
            <i class="fas fa-floppy-disk"></i>
            @InventoryText["Common.SaveDraft"]
        </button>

        <button class="transfer-primary-button" type="button" id="btnConfirmTransfer" title="@InventoryText["Transfer.Create.ConfirmDisabledTitle"]">
            <i class="fas fa-truck-fast"></i>
            @InventoryText["Transfer.Create.Confirm"]
        </button>
    </div>
</footer>
