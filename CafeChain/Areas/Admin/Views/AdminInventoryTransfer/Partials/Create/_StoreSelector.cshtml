@model CafeChain.ViewModels.Admin.InventoryTransfers.AdminInventoryTransferCreateVM
@inject Microsoft.Extensions.Localization.IStringLocalizer<CafeChain.InventoryResource> InventoryText

<section class="transfer-card">
    <div class="transfer-card-header compact">
        <div>
            <span class="section-kicker">
                <i class="fas fa-shuffle"></i>
                @InventoryText["Transfer.Create.StoreSelection"]
            </span>
        </div>
    </div>

    <div class="store-route">
        <div class="transfer-field route-field route-source">
            <label for="transferFromStore">
                <i class="fas fa-warehouse"></i>
                @InventoryText["Transfer.SourceStore"]
            </label>
            <select class="transfer-input" id="transferFromStore">
                <option value="">@InventoryText["Transfer.Create.SelectSourceStore"]</option>
                @foreach (var store in Model.Stores)
                {
                    <option value="@store.StoreId">@store.StoreName</option>
                }
            </select>
        </div>

        <div class="route-arrow" aria-hidden="true">
            <i class="fas fa-arrow-right"></i>
            <span>@InventoryText["Transfer.Create.Transfer"]</span>
        </div>

        <div class="transfer-field route-field route-destination">
            <label for="transferToStore">
                <i class="fas fa-store"></i>
                @InventoryText["Transfer.DestinationStore"]
            </label>
            <select class="transfer-input" id="transferToStore">
                <option value="">@InventoryText["Transfer.Create.SelectDestinationStore"]</option>
                @foreach (var store in Model.Stores)
                {
                    <option value="@store.StoreId">@store.StoreName</option>
                }
            </select>
        </div>
    </div>

    <div class="transfer-purpose-row">
        <label for="transferPurpose">@InventoryText["Transfer.Purpose"]</label>
        <select class="transfer-input" id="transferPurpose">
            <option value="@((int)CafeChain.Models.Enums.Inventory.InventoryTransferPurpose.REPLENISHMENT)">@InventoryText["Transfer.Purpose.REPLENISHMENT"]</option>
            <option value="@((int)CafeChain.Models.Enums.Inventory.InventoryTransferPurpose.BALANCING)">@InventoryText["Transfer.Purpose.BALANCING"]</option>
            <option value="@((int)CafeChain.Models.Enums.Inventory.InventoryTransferPurpose.OTHER)">@InventoryText["Transfer.Purpose.OTHER"]</option>
        </select>
    </div>
</section>
