@model CafeChain.ViewModels.Admin.InventoryTransfers.AdminInventoryTransferCreateVM
@inject Microsoft.Extensions.Localization.IStringLocalizer<CafeChain.InventoryResource> InventoryText

<section class="transfer-card">
    <div class="transfer-card-header">
        <div>
            <span class="section-kicker">
                <i class="fas fa-circle-info"></i>
                @InventoryText["Common.GeneralInformation"]
            </span>
            <h2>@InventoryText["Transfer.Create.DocumentInformation"]</h2>
        </div>

        <span class="auto-pill">@InventoryText["Common.AutomaticCode"]</span>
    </div>

    <div class="transfer-info-grid">
        <div class="transfer-field">
            <label for="transferCodePreview">@InventoryText["Transfer.Code"]</label>
            <input id="transferCodePreview"
                   class="transfer-input transfer-static-input"
                   value="@InventoryText["Common.AutomaticallyGenerated"]"
                   tabindex="-1"
                   readonly />
        </div>

        <div class="transfer-field">
            <label for="transferDateDisplay">@InventoryText["Transfer.DocumentDate"] <span>*</span></label>
            <input class="transfer-input transfer-static-input"
                   type="text"
                   id="transferDateDisplay"
                   value="@Model.DocumentDate.ToString("d")"
                   tabindex="-1"
                   onfocus="this.blur()"
                   readonly />
            <input type="hidden"
                   id="transferDate"
                   value="@Model.DocumentDate.ToString("yyyy-MM-dd")" />
        </div>

        <div class="transfer-field transfer-field-wide">
            <label for="transferCreatedByPreview">@InventoryText["Transfer.CreatedBy"]</label>
            <input id="transferCreatedByPreview"
                   class="transfer-input transfer-static-input"
                   value="@Model.CreatedByName"
                   tabindex="-1"
                   readonly />
        </div>
    </div>
</section>
