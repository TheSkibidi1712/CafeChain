@model CafeChain.ViewModels.Admin.InventoryTransfers.AdminInventoryTransferCreateVM

<header class="transfer-header">
    <div class="transfer-title-block">
        <div class="transfer-breadcrumb">
            <span>Phiếu kho</span>
            <i class="fas fa-chevron-right"></i>
            <span>Điều chuyển kho liên chi nhánh</span>
        </div>

        <div class="transfer-title-row">
            <div class="transfer-icon">
                <i class="fas fa-right-left"></i>
            </div>

            <div>
                <h1>Điều chuyển kho</h1>
                <p>Chuyển nguyên liệu giữa các chi nhánh trong hệ thống</p>
            </div>

            <span class="transfer-status-pill">Nháp</span>
        </div>
    </div>

    <a class="transfer-back-link"
       asp-area="Admin"
       asp-controller="AdminInventoryTransfer"
       asp-action="Index">
        <i class="fas fa-arrow-left"></i>
        Danh sách chuyển kho
    </a>
</header>
