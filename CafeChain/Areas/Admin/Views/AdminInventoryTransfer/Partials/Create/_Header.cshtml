@model CafeChain.ViewModels.Admin.InventoryTransfers.AdminInventoryTransferCreateVM
@inject Microsoft.Extensions.Localization.IStringLocalizer<CafeChain.InventoryResource> InventoryText

<header class="transfer-header">
    <div class="transfer-title-block">
        <div class="transfer-breadcrumb">
            <span>@InventoryText["Transfer.Create.InventoryDocuments"]</span>
            <i class="fas fa-chevron-right"></i>
            <span>@InventoryText["Transfer.Create.InterBranchTransfer"]</span>
        </div>

        <div class="transfer-title-row">
            <div class="transfer-icon">
                <i class="fas fa-right-left"></i>
            </div>

            <div>
                <h1>@InventoryText["Transfer.Create.Title"]</h1>
                <p>@InventoryText["Transfer.Create.Description"]</p>
            </div>

            <span class="transfer-status-pill">@InventoryText["Transfer.Status.DRAFT"]</span>
        </div>
    </div>

    <a class="transfer-back-link"
       asp-area="Admin"
       asp-controller="AdminInventoryTransfer"
       asp-action="Index">
        <i class="fas fa-arrow-left"></i>
        @InventoryText["Transfer.Create.BackToList"]
    </a>
</header>
