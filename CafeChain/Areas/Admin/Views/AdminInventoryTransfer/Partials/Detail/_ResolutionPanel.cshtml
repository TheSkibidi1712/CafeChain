@model CafeChain.ViewModels.Admin.InventoryTransfers.AdminInventoryTransferDetailVM

@if (Model.Status == CafeChain.Models.Enums.Inventory.InventoryTransferStatus.DISPATCHED
    && (Model.CanReceive || Model.CanRequestReturn || Model.CanConfirmReturn || Model.CanResolveShortage || Model.CanCreateFollowUp))
{
    <section class="transfer-card transfer-resolution-panel"
             id="transfer-resolution-panel"
             data-transfer-id="@Model.InventoryTransferId"
             data-row-version="@Model.RowVersion"
             data-receive-url="@Url.Action("Receive", "AdminInventoryTransfer", new { area = "Admin", id = Model.InventoryTransferId })"
             data-return-url="@Url.Action("RequestReturn", "AdminInventoryTransfer", new { area = "Admin", id = Model.InventoryTransferId })"
             data-confirm-return-url="@Url.Action("ConfirmReturn", "AdminInventoryTransfer", new { area = "Admin", id = Model.InventoryTransferId })"
             data-resolve-url="@Url.Action("ResolveShortage", "AdminInventoryTransfer", new { area = "Admin", id = Model.InventoryTransferId })"
             data-follow-up-url="@Url.Action("CreateFollowUp", "AdminInventoryTransfer", new { area = "Admin", id = Model.InventoryTransferId })">
        @Html.AntiForgeryToken()
        <div class="transfer-card-header">
            <div>
                <span class="section-kicker"><i class="fas fa-route"></i> Xử lý chênh lệch</span>
                <h2>Tiếp tục nhận hoặc kết thúc phần đang vận chuyển</h2>
                <p>Mọi thao tác dùng đúng giá vốn từ lần xuất kho gốc.</p>
            </div>
            <select id="transfer-resolution-action" class="transfer-input transfer-action-select" aria-label="Chọn thao tác">
                <option value="">Chọn thao tác</option>
                @if (Model.CanReceive) { <option value="receive">Nhận hàng tại kho đích</option> }
                @if (Model.CanRequestReturn) { <option value="request-return">Yêu cầu hoàn trả kho nguồn</option> }
                @if (Model.CanConfirmReturn) { <option value="confirm-return">Xác nhận kho nguồn đã nhận lại</option> }
                @if (Model.CanResolveShortage) { <option value="write-off">Ghi nhận mất/hư hỏng</option> }
                @if (Model.CanResolveShortage) { <option value="close-shortage">Đóng phần thiếu</option> }
                @if (Model.CanCreateFollowUp) { <option value="follow-up">Tạo điều chuyển gửi bù</option> }
            </select>
        </div>

        <div class="transfer-resolution-warning">
            <i class="fas fa-triangle-exclamation"></i>
            <span>Đóng chênh lệch chỉ kết thúc điều chuyển. Nhu cầu nhập hàng tại chi nhánh có thể vẫn còn thiếu.</span>
        </div>

        <div class="transfer-resolution-lines">
            @foreach (var item in Model.Details.Where(x => x.InTransitOpen > 0 || x.PendingReturn > 0))
            {
                <div class="transfer-resolution-line"
                     data-detail-id="@item.InventoryTransferDetailId"
                     data-open="@item.InTransitOpen.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                     data-returnable="@item.ReturnableRejected.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                     data-pending-return="@item.PendingReturn.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                    <div class="transfer-resolution-line-label">
                        <strong>@item.ItemName</strong>
                        <span>Còn xử lý @item.InTransitOpen.ToString("0.###") @item.BaseUnitCode</span>
                    </div>
                    <label class="transfer-action-field transfer-action-quantity">
                        <span>Số lượng</span>
                        <input class="transfer-input js-resolution-quantity" type="number" min="0" step="0.001" value="0" />
                    </label>
                    <label class="transfer-action-field transfer-receive-only">
                        <span>Nhận hợp lệ</span>
                        <input class="transfer-input js-accepted-quantity" type="number" min="0" step="0.001" value="0" />
                    </label>
                    <label class="transfer-action-field transfer-receive-only">
                        <span>Từ chối/hư hỏng</span>
                        <input class="transfer-input js-rejected-quantity" type="number" min="0" step="0.001" value="0" />
                    </label>
                    <label class="transfer-action-field transfer-receive-only transfer-rejection-field">
                        <span>Loại chênh lệch</span>
                        <select class="transfer-input js-rejection-type">
                            <option value="">Chọn loại</option>
                            <option value="DAMAGED">Hư hỏng</option>
                            <option value="SHORTAGE">Giao thiếu</option>
                            <option value="QUALITY_REJECTED">Không đạt chất lượng</option>
                        </select>
                    </label>
                    <label class="transfer-action-field transfer-receive-only transfer-rejection-field">
                        <span>Lý do từ chối</span>
                        <input class="transfer-input js-rejection-reason" maxlength="500" placeholder="Mô tả tình trạng" />
                    </label>
                </div>
            }
        </div>

        <div class="transfer-resolution-footer">
            <label class="transfer-field transfer-resolution-reason">
                <span>Lý do / ghi chú thao tác</span>
                <textarea id="transfer-resolution-reason" class="transfer-input" maxlength="500" rows="2" placeholder="Bắt buộc với hoàn trả, mất/hư hỏng và đóng thiếu"></textarea>
            </label>
            <div class="transfer-resolution-submit-wrap">
                <div id="transfer-resolution-message" class="transfer-resolution-message" role="status"></div>
                <button id="transfer-resolution-submit" class="transfer-primary-button" type="button" disabled>
                    <i class="fas fa-check"></i>
                    Xác nhận thao tác
                </button>
            </div>
        </div>
    </section>
}
