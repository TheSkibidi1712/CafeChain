@model CafeChain.ViewModels.Admin.InventoryTransfers.AdminInventoryTransferDetailVM

<section class="transfer-card">
    <div class="transfer-card-header">
        <div>
            <span class="section-kicker">
                <i class="fas fa-circle-info"></i>
                Thông tin chung
            </span>
            <h2>Thông tin phiếu</h2>
        </div>

        <span class="auto-pill">Chỉ xem</span>
    </div>

    <div class="transfer-readonly-grid">
        <div class="transfer-readonly-field">
            <span>Mã phiếu</span>
            <strong>@Model.Code</strong>
        </div>

        <div class="transfer-readonly-field">
            <span>Ngày chứng từ</span>
            <strong>@Model.DocumentDate.ToString("dd/MM/yyyy")</strong>
        </div>

        <div class="transfer-readonly-field">
            <span>Loại phiếu</span>
            <strong>@Model.Type.ToVietnamese()</strong>
        </div>

        <div class="transfer-readonly-field">
            <span>Mục đích</span>
            <strong>@Model.Purpose.ToVietnamese()</strong>
        </div>

        <div class="transfer-readonly-field">
            <span>Người lập</span>
            <strong>@(string.IsNullOrWhiteSpace(Model.CreatedByName) ? "-" : Model.CreatedByName)</strong>
        </div>

        <div class="transfer-readonly-field">
            <span>Ngày lập</span>
            <strong>@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong>
        </div>

        <div class="transfer-readonly-field">
            <span>Người xác nhận</span>
            <strong>@(Model.ConfirmedByName ?? "-")</strong>
        </div>

        <div class="transfer-readonly-field">
            <span>Ngày xác nhận</span>
            <strong>@(Model.ConfirmedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</strong>
        </div>

        <div class="transfer-readonly-field">
            <span>Người hủy</span>
            <strong>@(Model.CancelledByName ?? "-")</strong>
        </div>

        <div class="transfer-readonly-field">
            <span>Ngày hủy</span>
            <strong>@(Model.CancelledAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</strong>
        </div>

        <div class="transfer-readonly-field transfer-readonly-wide">
            <span>Request Key</span>
            <strong>@(Model.RequestKey ?? "-")</strong>
        </div>
    </div>
</section>
