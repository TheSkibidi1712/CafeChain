@model CafeChain.ViewModels.Admin.InventoryTransfers.AdminInventoryTransferDetailVM
@inject Microsoft.Extensions.Localization.IStringLocalizer<CafeChain.InventoryResource> InventoryText

<section class="transfer-card">
    <div class="transfer-card-header">
        <div>
            <span class="section-kicker">
                <i class="fas fa-circle-info"></i>
                @InventoryText["Common.GeneralInformation"]
            </span>
            <h2>@InventoryText["Transfer.Create.DocumentInformation"]</h2>
        </div>

        <span class="auto-pill">@InventoryText["Common.ReadOnly"]</span>
    </div>

    <div class="transfer-readonly-grid">
        <div class="transfer-readonly-field">
            <span>@InventoryText["Transfer.Code"]</span>
            <strong>@Model.Code</strong>
        </div>

        <div class="transfer-readonly-field">
            <span>@InventoryText["Transfer.DocumentDate"]</span>
            <strong>@Model.DocumentDate.ToString("d")</strong>
        </div>

        <div class="transfer-readonly-field">
            <span>@InventoryText["Transfer.Detail.Type"]</span>
            <strong>@InventoryText[$"Transfer.Type.{Model.Type}"]</strong>
        </div>

        <div class="transfer-readonly-field">
            <span>@InventoryText["Transfer.Purpose"]</span>
            <strong>@InventoryText[$"Transfer.Purpose.{Model.Purpose}"]</strong>
        </div>

        <div class="transfer-readonly-field">
            <span>@InventoryText["Transfer.CreatedBy"]</span>
            <strong>@(string.IsNullOrWhiteSpace(Model.CreatedByName) ? "-" : Model.CreatedByName)</strong>
        </div>

        <div class="transfer-readonly-field">
            <span>@InventoryText["Common.CreatedDate"]</span>
            <strong>@Model.CreatedAt.ToLocalTime().ToString("g")</strong>
        </div>

        <div class="transfer-readonly-field">
            <span>@InventoryText["Common.ConfirmedBy"]</span>
            <strong>@(Model.ConfirmedByName ?? "-")</strong>
        </div>

        <div class="transfer-readonly-field">
            <span>@InventoryText["Common.ConfirmedDate"]</span>
            <strong>@(Model.ConfirmedAt?.ToLocalTime().ToString("g") ?? "-")</strong>
        </div>

        <div class="transfer-readonly-field">
            <span>@InventoryText["Common.CancelledBy"]</span>
            <strong>@(Model.CancelledByName ?? "-")</strong>
        </div>

        <div class="transfer-readonly-field">
            <span>@InventoryText["Common.CancelledDate"]</span>
            <strong>@(Model.CancelledAt?.ToLocalTime().ToString("g") ?? "-")</strong>
        </div>

    </div>

    @if (!string.IsNullOrWhiteSpace(Model.RequestKey))
    {
        <details class="transfer-technical-details">
            <summary>
                <i class="fas fa-code"></i>
                @InventoryText["Common.TechnicalInformation"]
            </summary>
            <div class="transfer-readonly-field transfer-readonly-wide">
                <span>Request Key</span>
                <strong>@Model.RequestKey</strong>
            </div>
        </details>
    }
</section>
