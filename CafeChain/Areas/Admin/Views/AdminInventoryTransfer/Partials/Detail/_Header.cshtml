@model CafeChain.ViewModels.Admin.InventoryTransfers.AdminInventoryTransferDetailVM
@inject Microsoft.Extensions.Localization.IStringLocalizer<CafeChain.InventoryResource> InventoryText

<header class="transfer-header">
    <div>
        <div class="transfer-breadcrumb">
            <span>@InventoryText["Transfer.Create.InventoryDocuments"]</span>
            <i class="fas fa-chevron-right"></i>
            <span>@InventoryText["Transfer.Detail.Breadcrumb"]</span>
        </div>

        <div class="transfer-title-row">
            <div class="transfer-icon">
                <i class="fas fa-right-left"></i>
            </div>

            <div>
                <h1>@Model.Code</h1>
                <p>@InventoryText["Transfer.Detail.Description"]</p>
            </div>

            <span class="transfer-status-pill transfer-status-@Model.Status.ToString().ToLower()">
                @InventoryText[$"Transfer.Status.{Model.Status}"]
            </span>
        </div>
    </div>

    <div class="transfer-header-actions">
        <a class="transfer-back-link"
           asp-area="Admin"
           asp-controller="AdminInventoryTransfer"
           asp-action="Index">
            <i class="fas fa-arrow-left"></i>
            @InventoryText["Transfer.Detail.BackToList"]
        </a>

        <a class="transfer-back-link"
           asp-area="Admin"
           asp-controller="AdminInventoryTransfer"
           asp-action="Create">
            <i class="fas fa-plus"></i>
            @InventoryText["Transfer.Detail.CreateNew"]
        </a>
    </div>
</header>
