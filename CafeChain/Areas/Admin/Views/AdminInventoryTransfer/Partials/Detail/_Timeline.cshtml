@model CafeChain.ViewModels.Admin.InventoryTransfers.AdminInventoryTransferDetailVM
@inject Microsoft.Extensions.Localization.IStringLocalizer<CafeChain.InventoryResource> InventoryText

<section class="transfer-card">
    <div class="transfer-card-header compact">
        <div>
            <span class="section-kicker"><i class="fas fa-clock-rotate-left"></i> @InventoryText["Transfer.Detail.Timeline"]</span>
            <h2>@InventoryText["Transfer.Detail.ReceiptAndDiscrepancy"]</h2>
        </div>
    </div>
    @if (!Model.Timeline.Any())
    {
        <p class="transfer-empty-timeline">@InventoryText["Transfer.Detail.NoTimeline"]</p>
    }
    else
    {
        <div class="transfer-timeline">
            @foreach (var item in Model.Timeline)
            {
                <div class="transfer-timeline-item">
                    <span class="transfer-timeline-dot"></span>
                    <div>
                        <strong>@item.EventType</strong>
                        <span>@item.ItemName · @item.Quantity.ToString("0.###") @item.UnitCode</span>
                        <small>@item.OccurredAt.ToLocalTime().ToString("g") · @(string.IsNullOrWhiteSpace(item.ActorName) ? InventoryText["Common.System"] : item.ActorName)</small>
                        @if (!string.IsNullOrWhiteSpace(item.Reason)) { <p>@item.Reason</p> }
                    </div>
                </div>
            }
        </div>
    }
</section>
