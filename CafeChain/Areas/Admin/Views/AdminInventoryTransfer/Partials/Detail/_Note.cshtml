@model CafeChain.ViewModels.Admin.InventoryTransfers.AdminInventoryTransferDetailVM
@inject Microsoft.Extensions.Localization.IStringLocalizer<CafeChain.InventoryResource> InventoryText

<section class="transfer-card">
    <div class="transfer-card-header compact">
        <div>
            <span class="section-kicker">
                <i class="fas fa-note-sticky"></i>
                @InventoryText["Common.Note"]
            </span>
            <h2>@InventoryText["Transfer.Detail.NoteTitle"]</h2>
        </div>
    </div>

    <div class="transfer-note-readonly">
        @(string.IsNullOrWhiteSpace(Model.Note) ? InventoryText["Common.NoNote"] : Model.Note)
    </div>
</section>
