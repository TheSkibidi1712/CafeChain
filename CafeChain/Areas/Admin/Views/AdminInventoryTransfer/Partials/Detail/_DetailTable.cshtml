@model CafeChain.ViewModels.Admin.InventoryTransfers.AdminInventoryTransferDetailVM
@inject Microsoft.Extensions.Localization.IStringLocalizer<CafeChain.InventoryResource> InventoryText

<section class="transfer-card">
    <div class="transfer-toolbar">
        <div>
            <span class="section-kicker">
                <i class="fas fa-boxes-stacked"></i>
                @InventoryText["Transfer.Create.LinesTitle"]
            </span>
            <h2>@InventoryText["Transfer.Detail.ItemList"]</h2>
            <p>@InventoryText["Transfer.Detail.QuantityEvidenceHint"]</p>
        </div>
    </div>

    <div class="transfer-table-wrap">
        <table class="transfer-table transfer-detail-readonly-table">
            <thead>
                <tr>
                    <th class="col-index">#</th>
                    <th>@InventoryText["Common.Item"]</th>
                    <th>@InventoryText["Common.Unit"]</th>
                    <th class="text-end">@InventoryText["Transfer.Detail.Requested"]</th>
                    <th class="text-end">@InventoryText["Transfer.Detail.Dispatched"]</th>
                    <th class="text-end">@InventoryText["Transfer.Detail.Accepted"]</th>
                    <th class="text-end">@InventoryText["Transfer.Detail.Rejected"]</th>
                    <th class="text-end">@InventoryText["Transfer.Detail.Returned"]</th>
                    <th class="text-end">@InventoryText["Transfer.Detail.WrittenOff"]</th>
                    <th class="text-end">@InventoryText["Transfer.Detail.ClosedShortage"]</th>
                    <th class="text-end">@InventoryText["Transfer.Detail.Pending"]</th>
                    <th>@InventoryText["Common.Status"]</th>
                </tr>
            </thead>

            <tbody>
                @if (!Model.Details.Any())
                {
                    <tr class="transfer-empty-row">
                        <td colspan="12">@InventoryText["Transfer.Detail.NoItems"]</td>
                    </tr>
                }
                else
                {
                    var index = 1;

                    foreach (var item in Model.Details)
                    {
                        <tr>
                            <td>@index</td>

                            <td>
                                <strong>@item.ItemName</strong>
                                <span class="readonly-pill">@item.ItemType</span>

                                @if (item.RestockRequestId.HasValue)
                                {
                                    <span class="transfer-detail-note">@InventoryText["Transfer.Detail.RestockRequestNumber", item.RestockRequestId]</span>
                                }

                                @if (!string.IsNullOrWhiteSpace(item.Note))
                                {
                                    <span class="transfer-detail-note">@item.Note</span>
                                }
                            </td>

                            <td>
                                <span class="readonly-pill">@item.UnitName (@item.UnitCode)</span>
                            </td>

                            <td class="text-end">
                                @item.BaseQuantity.ToString("0.###") @item.BaseUnitCode
                            </td>

                            <td class="text-end">
                                @item.DispatchedBaseQuantity.ToString("0.###")
                            </td>

                            <td class="text-end">
                                @item.DestinationAccepted.ToString("0.###")
                            </td>

                            <td class="text-end transfer-diff-negative">
                                @item.DestinationRejected.ToString("0.###")
                            </td>

                            <td class="text-end">
                                @item.ReturnedToSource.ToString("0.###")
                            </td>

                            <td class="text-end transfer-diff-negative">
                                @item.WrittenOff.ToString("0.###")
                            </td>

                            <td class="text-end transfer-diff-negative">
                                @item.ClosedShortage.ToString("0.###")
                            </td>

                            <td class="text-end @(item.InTransitOpen > 0 ? "transfer-diff-warning" : "transfer-diff-positive")">
                                <strong>@item.InTransitOpen.ToString("0.###")</strong>
                            </td>

                            <td>
                                <span class="transfer-discrepancy-status">@item.DiscrepancyStatus</span>
                            </td>
                        </tr>

                        index++;
                    }
                }
            </tbody>
        </table>
    </div>
</section>
