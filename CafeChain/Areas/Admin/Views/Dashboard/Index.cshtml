@model CafeChain.Application.DTOs.Admin.Dashboard.DashboardPageDto
@using CafeChain.Application.DTOs.Admin.Dashboard
@using System.Text.Json
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<CafeChain.SharedResource> SharedText
@{
    ViewData["Title"] = SharedText["Dashboard.Title"];
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var storesJson = JsonSerializer.Serialize(Model.Stores, jsonOptions);
    var contextJson = JsonSerializer.Serialize(Model.AnalysisContext, jsonOptions);
    var tabs = new[]
    {
        ("Executive", SharedText["Dashboard.Tab.Executive"].Value, "bi-speedometer2"),
        ("Operations", SharedText["Dashboard.Tab.Operations"].Value, "bi-cash-stack"),
        ("Inventory", SharedText["Dashboard.Tab.Inventory"].Value, "bi-box-seam"),
        ("Procurement", SharedText["Dashboard.Tab.Procurement"].Value, "bi-truck"),
        ("Product", SharedText["Dashboard.Tab.Product"].Value, "bi-cup-straw"),
        ("Workforce", SharedText["Dashboard.Tab.Workforce"].Value, "bi-people")
    }.Where(tab => Enum.TryParse<DashboardSection>(tab.Item1, out var section)
        && Model.AllowedSections.Contains(section)).ToArray();
    var firstSection = tabs.First().Item1;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/Dashboard/dashboard.css" asp-append-version="true" />
}

<main class="analytics-page" id="dashboardRoot"
      data-endpoint="@Url.Action("GetSection", "Dashboard", new { area = "Admin" })"
      data-ai-parse="@Url.Action("Parse", "AdminDashboardIntelligence", new { area = "Admin" })"
      data-ai-execute="@Url.Action("Execute", "AdminDashboardIntelligence", new { area = "Admin" })"
      data-ai-explain="@Url.Action("Explain", "AdminDashboardIntelligence", new { area = "Admin" })"
      data-ai-analyze="@Url.Action("Analyze", "AdminDashboardIntelligence", new { area = "Admin" })"
      data-context-endpoint="@Url.Action("CreateContext", "Dashboard", new { area = "Admin" })"
      data-context-id="@Model.AnalysisContext?.ContextId"
      data-generated-at="@Model.AnalysisContext?.GeneratedAt.ToString("O")"
      data-filter-fingerprint="@Model.AnalysisContext?.FilterFingerprint"
      data-default-section="@firstSection"
      data-can-select-province="@Model.Scope.CanSelectProvince.ToString().ToLowerInvariant()"
      data-can-select-ward="@Model.Scope.CanSelectWard.ToString().ToLowerInvariant()"
      data-can-select-store="@Model.Scope.CanSelectStore.ToString().ToLowerInvariant()"
      data-province="@Model.Filter.ProvinceId" data-ward="@Model.Filter.WardId" data-store="@Model.Filter.StoreId">
    <form id="dashboardAntiForgery" hidden>@Html.AntiForgeryToken()</form>
    <header class="analytics-header">
        <div class="analytics-header__copy">
            <span class="analytics-eyebrow">@Model.RoleName</span>
            <h1><i class="fa-solid fa-chart-pie me-2 text-warning" aria-hidden="true"></i>@SharedText["Dashboard.Title"]</h1>
            <p>@SharedText["Dashboard.ScopeDescription"]</p>
        </div>
        <div class="analytics-header__actions">
            <a class="analytics-button analytics-button--secondary text-decoration-none" asp-area="Admin" asp-controller="Dashboard" asp-action="Guide">
                <i class="bi bi-question-circle"></i> @SharedText["Dashboard.Guide"]
            </a>
            <button type="button" class="analytics-button" id="dashboardApply">
                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                <span>@SharedText["Dashboard.Apply"]</span>
            </button>
        </div>
    </header>

    <section class="analytics-filter" aria-label="@SharedText["Dashboard.Filter.Aria"]">
        <div class="analytics-filter__header">
            <div>
                <span class="analytics-filter__kicker">@SharedText["Dashboard.Filter.Scope"]</span>
                <strong>@SharedText["Dashboard.Filter.Title"]</strong>
            </div>
            <span class="analytics-filter__hint"><i class="bi bi-shield-check"></i> @SharedText["Dashboard.Filter.AccessScope"]</span>
        </div>
        <div class="analytics-filter__grid">
            <label>@SharedText["Dashboard.Filter.From"]<input id="dashboardFromDate" type="date" value="@Model.Filter.FromDate.ToString("yyyy-MM-dd")" /></label>
            <label>@SharedText["Dashboard.Filter.To"]<input id="dashboardToDate" type="date" value="@Model.Filter.ToDate.ToString("yyyy-MM-dd")" /></label>
            <label>@SharedText["Dashboard.Filter.Province"]<select id="dashboardProvince"><option value="">@SharedText["Dashboard.Filter.All"]</option></select></label>
            <label>@SharedText["Dashboard.Filter.Ward"]<select id="dashboardWard"><option value="">@SharedText["Dashboard.Filter.All"]</option></select></label>
            <label>@SharedText["Dashboard.Filter.Store"]<select id="dashboardStore"><option value="">@SharedText["Dashboard.Filter.All"]</option></select></label>
            <label>@SharedText["Dashboard.Filter.Granularity"]
                <select id="dashboardGranularity">
                    <option value="Hour" selected="@(Model.Filter.Granularity == "Hour")">@SharedText["Dashboard.Filter.Hour"]</option>
                    <option value="Day" selected="@(Model.Filter.Granularity == "Day")">@SharedText["Dashboard.Filter.Day"]</option>
                    <option value="Week" selected="@(Model.Filter.Granularity == "Week")">@SharedText["Dashboard.Filter.Week"]</option>
                    <option value="Month" selected="@(Model.Filter.Granularity == "Month")">@SharedText["Dashboard.Filter.Month"]</option>
                </select>
            </label>
            <label>@SharedText["Dashboard.Filter.Top"]<input id="dashboardTop" type="number" min="1" max="100" value="@Model.Filter.Top" /></label>
            <label>@SharedText["Dashboard.Filter.Preset"]
                <select id="dashboardPreset">
                    <option value="">@SharedText["Dashboard.Filter.Current"]</option>
                    <option value="Today">@SharedText["Dashboard.Filter.Today"]</option>
                    <option value="Last7Days">@SharedText["Dashboard.Filter.Last7"]</option>
                    <option value="Last30Days">@SharedText["Dashboard.Filter.Last30"]</option>
                    <option value="ThisMonth">@SharedText["Dashboard.Filter.ThisMonth"]</option>
                </select>
            </label>
        </div>
    </section>

    <nav class="analytics-tabs" role="tablist" aria-label="@SharedText["Dashboard.Tabs.Aria"]">
        @foreach (var tab in tabs)
        {
            <button type="button" role="tab" class="analytics-tab @(tab.Item1 == firstSection ? "is-active" : "")"
                    id="dashboardTab@tab.Item1"
                    data-section="@tab.Item1"
                    aria-controls="dashboardPanel"
                    aria-selected="@(tab.Item1 == firstSection ? "true" : "false")"
                    tabindex="@(tab.Item1 == firstSection ? "0" : "-1")">
                <i class="bi @tab.Item3"></i><span>@tab.Item2</span>
            </button>
        }
        <button type="button"
                role="tab"
                class="analytics-tab"
                id="dashboardAiTab"
                hidden="@(!Model.CanUseAi)"
                data-ai-tab="true"
                aria-controls="dashboardAiPanel"
                aria-selected="false"
                tabindex="-1">
            <i class="bi bi-stars"></i><span>@SharedText["Dashboard.Tab.Ai"]</span>
        </button>
    </nav>

    <div id="dashboardNotice" class="analytics-notice" role="status" hidden></div>
    <section id="dashboardPanel"
             class="analytics-panel"
             role="tabpanel"
             aria-labelledby="dashboardTabExecutive"
             aria-live="polite"></section>

    <section id="dashboardAiPanel"
             data-authorized="@Model.CanUseAi.ToString().ToLowerInvariant()"
             class="dashboard-intelligence dashboard-ai-panel"
             role="tabpanel"
             aria-labelledby="dashboardAiTab"
             hidden>
        <span class="dashboard-intelligence__accent" aria-hidden="true"></span>
        <div class="dashboard-intelligence__heading">
            <div class="dashboard-intelligence__brand">
                <span class="dashboard-intelligence__icon" aria-hidden="true">
                    <svg class="dashboard-ai-logo" viewBox="0 0 32 32" fill="none">
                        <path class="dashboard-ai-logo__orbit" d="M7.1 11.2C9 6.8 13.7 4.3 18.4 5.3C23 6.2 26.3 10.5 26 15.2" />
                        <path class="dashboard-ai-logo__orbit" d="M24.9 20.8C22.4 25 17.3 27 12.8 25.4C8.3 23.9 5.6 19.2 6.5 14.6" />
                        <path class="dashboard-ai-logo__core" d="M16 8.2L18.1 13.6L23.6 15.8L18.1 17.9L16 23.4L13.8 17.9L8.4 15.8L13.8 13.6L16 8.2Z" />
                        <circle cx="6.7" cy="10.5" r="1.8" />
                        <circle cx="25.6" cy="20.7" r="1.8" />
                        <circle cx="24.9" cy="8.7" r="1.25" />
                    </svg>
                </span>
                <div>
                    <span class="analytics-eyebrow">@SharedText["Dashboard.Ai.Eyebrow"]</span>
                    <h2 id="dashboardIntelligenceTitle">@SharedText["Dashboard.Ai.Title"]</h2>
                    <p>@SharedText["Dashboard.Ai.Description"]</p>
                </div>
            </div>
            <div class="dashboard-intelligence__heading-actions">
                <span class="dashboard-intelligence__safe"><i class="bi bi-lock"></i> @SharedText["Dashboard.Ai.ReadOnly"]</span>
                <button type="button"
                        class="analytics-button analytics-button--secondary dashboard-intelligence__toggle"
                        id="dashboardAiToggleResult"
                        aria-controls="dashboardAiResult"
                        aria-expanded="false"
                        disabled>
                    <i class="bi bi-eye"></i>
                    <span data-ai-toggle-label>@SharedText["Dashboard.Ai.HideAnalysis"]</span>
                </button>
            </div>
        </div>
        <div class="dashboard-intelligence__input">
            <div class="dashboard-intelligence__input-wrap">
                <i class="bi bi-stars" aria-hidden="true"></i>
                <input id="dashboardAiPrompt" maxlength="500" autocomplete="off" required
                       aria-describedby="dashboardAiStatus"
                       placeholder="@SharedText["Dashboard.Ai.Placeholder"]" />
            </div>
            <button type="button" class="analytics-button" id="dashboardAiParse">
                <i class="bi bi-stars" data-ai-analyze-icon aria-hidden="true"></i>
                <span data-ai-analyze-label>@SharedText["Dashboard.Ai.Analyze"]</span>
            </button>
        </div>
        <div class="dashboard-intelligence__scope" aria-label="Phạm vi phân tích hiện tại">
            <span><i class="bi bi-calendar3"></i> @Model.Filter.FromDate.ToString("dd/MM/yyyy") – @Model.Filter.ToDate.ToString("dd/MM/yyyy")</span>
            <span><i class="bi bi-shop"></i> Phạm vi cửa hàng được cấp quyền</span>
            <span><i class="bi bi-bar-chart"></i> @(Model.Filter.Granularity == "Hour" ? "Giờ" : Model.Filter.Granularity == "Day" ? "Ngày" : Model.Filter.Granularity == "Week" ? "Tuần" : Model.Filter.Granularity == "Month" ? "Tháng" : Model.Filter.Granularity)</span>
        </div>
        <div id="dashboardAiStatus" class="analytics-notice" role="status" hidden></div>
        <div id="dashboardAiPreview" class="dashboard-intelligence__preview" hidden></div>
        <div id="dashboardAiResult" class="dashboard-intelligence__result" hidden></div>
    </section>
</main>

<script id="dashboardStores" type="application/json">@Html.Raw(storesJson)</script>
<script id="dashboardContext" type="application/json">@Html.Raw(contextJson)</script>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/echarts/dist/echarts.min.js"></script>
    <script src="~/js/Admin/Dashboard/dashboard.js" asp-append-version="true"></script>
    <script src="~/js/Admin/Dashboard/dashboard-intelligence.js" asp-append-version="true"></script>
}
