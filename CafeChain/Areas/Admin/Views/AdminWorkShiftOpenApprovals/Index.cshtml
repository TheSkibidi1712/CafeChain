@model IReadOnlyList<CafeChain.Application.DTOs.POS.WorkShiftOpenApprovalDto>
@{
    ViewData["Title"] = "Duyệt mở ca trễ";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<main class="cc-page ops-shell cc-warehouse-page">
    <header class="work-shift-open-approvals-header ops-header cc-warehouse-header">
        <div>
            <div class="ops-eyebrow">Nhân sự & vận hành</div>
            <h1 class="ops-title"><i class="fa-solid fa-lock-open me-2 text-warning" aria-hidden="true"></i>Duyệt mở ca trễ</h1>
            <p class="ops-subtitle">Chỉ Quản lý cửa hàng, Quản lý khu vực hoặc Chủ doanh nghiệp đúng phạm vi mới có quyền quyết định.</p>
        </div>
    </header>
    @if (TempData["SuccessMessage"] != null) { <div class="ops-notice ops-notice-success">@TempData["SuccessMessage"]</div> }
    @if (TempData["ErrorMessage"] != null) { <div class="ops-notice ops-notice-error">@TempData["ErrorMessage"]</div> }

    @section Styles {
        <link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />
        <link rel="stylesheet" href="~/css/Admin/WorkShiftOpenApprovals/workshift-approvals.css" asp-append-version="true" />
    }

    @if (Model.Count == 0)
    {
        <section class="cc-empty-state"><h2>Không có yêu cầu đang chờ</h2></section>
    }
    else
    {
        <section class="cc-approval-grid">
            @foreach (var item in Model)
            {
                <article class="approval-card" id="approval-@item.Id">
                    <div class="approval-card-info">
                        <div class="approval-card-title">@item.RequestedByName</div>
                        <div class="approval-card-detail">Trạng thái: <strong>Trễ @item.MinutesLate phút</strong></div>
                        <div class="approval-card-detail">Terminal: <strong>@item.TerminalId</strong> &bull; Cửa hàng: <strong>#@item.StoreId</strong></div>
                        <div class="approval-card-detail">Hết hạn: <strong>@item.ExpiresAtUtc.ToLocalTime().ToString("HH:mm:ss dd/MM/yyyy")</strong></div>
                        <div class="approval-card-reason">@item.Reason</div>
                    </div>
                    <form asp-action="Decide" method="post" data-decision-form class="approval-card-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.PublicId" />
                        <input type="hidden" name="storeId" value="@item.StoreId" />
                        <input type="hidden" name="Decision" value="" data-decision-value />
                        <input type="hidden" name="RequestKey" value="@Guid.NewGuid().ToString("N")" />
                        <input type="hidden" name="RowVersion" value="@item.RowVersion" />
                        <label>Lý do quyết định
                            <input name="Reason" minlength="10" maxlength="500" required data-decision-reason />
                            <small data-decision-reason-counter>0 / 500</small>
                        </label>
                        @if (!item.CanApproveAsScheduled)
                        {
                            <p class="ops-notice ops-notice-warning" style="font-size:12px; padding: 10px;">
                                Ca đã trễ quá @item.ScheduledApprovalMaxLateMinutes phút nên không thể mở theo lịch cũ.
                                Hãy từ chối hoặc chuyển sang ca ngoài lịch.
                            </p>
                        }
                        <div class="approval-card-actions">
                            <button class="cc-btn btn-approve"
                                    data-decision="APPROVED"
                                    type="submit"
                                    disabled="@(!item.CanApproveAsScheduled)"
                                    title="@(!item.CanApproveAsScheduled ? $"Ca trễ quá {item.ScheduledApprovalMaxLateMinutes} phút không thể duyệt theo lịch cũ." : $"Duyệt mở ca trễ trong giới hạn {item.ScheduledApprovalMaxLateMinutes} phút")">
                                Duyệt mở ca
                            </button>
                            <button class="cc-btn btn-reject" data-decision="REJECTED" type="submit">Từ chối</button>
                            <button class="cc-btn btn-convert" data-decision="CONVERTED_TO_OUTSIDE_SCHEDULE" type="submit">Chuyển ngoài lịch</button>
                        </div>
                    </form>
                </article>
            }
        </section>
    }
</main>

<script>
document.addEventListener('submit', function (event) {
    var form = event.target.closest('[data-decision-form]');
    if (!form) return;
    var decision = event.submitter?.dataset.decision;
    var decisionField = form.querySelector('[data-decision-value]');
    var allowedDecisions = ['APPROVED', 'REJECTED', 'CONVERTED_TO_OUTSIDE_SCHEDULE'];
    if (!decisionField || !allowedDecisions.includes(decision)) {
        event.preventDefault();
        if (typeof window.toast === 'function') {
            window.toast('Không nhận được lựa chọn xử lý. Vui lòng thử lại.', 'warning');
        }
        return;
    }
    var reason = form.querySelector('[data-decision-reason]');
    var normalizedReason = reason?.value.trim() || '';
    if (normalizedReason.length < 10 || normalizedReason.length > 500 || !/[\p{L}\p{N}]/u.test(normalizedReason)) {
        event.preventDefault();
        reason?.focus();
        if (typeof window.toast === 'function') {
            window.toast('Lý do quyết định phải có từ 10 đến 500 ký tự và có nội dung cụ thể.', 'warning');
        }
        return;
    }
    reason.value = normalizedReason;
    decisionField.value = decision;
});
document.addEventListener('input', function (event) {
    if (!event.target.matches?.('[data-decision-reason]')) return;
    var counter = event.target.closest('label')?.querySelector('[data-decision-reason-counter]');
    if (counter) counter.textContent = `${event.target.value.length} / 500`;
});
document.addEventListener('DOMContentLoaded', function () {
if (window.signalR?.HubConnectionBuilder) {
    const approvalConnection = new signalR.HubConnectionBuilder()
        .withUrl('/hubs/workshifts')
        .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
        .build();
    approvalConnection.on('LateOpenApprovalChanged', function () {
        if (!document.querySelector('[data-decision-form][data-submit-pending="true"], [data-decision-form][data-submit-busy="true"]')) {
            window.location.reload();
        }
    });
    approvalConnection.onreconnected(function () { window.location.reload(); });
    approvalConnection.start().catch(function (error) {
        console.warn('[late-open-approval] Realtime unavailable; manual refresh remains available.', error);
    });
    window.addEventListener('pagehide', function () { void approvalConnection.stop(); }, { once: true });
}
}, { once: true });
</script>
