@model CafeChain.Application.DTOs.Admin.StockAlerts.StockAlertListResultDto
@using CafeChain.Application.DTOs.Admin.StoreScope
@using CafeChain.ViewModels.Admin.Shared
@{
    ViewData["Title"] = "Cảnh báo kho";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var statusFilter = ViewBag.StatusFilter as string ?? "OPEN";
    var currentPage = Model.Page;
    var totalPages = Math.Max(1, (int)Math.Ceiling(Model.Total / (double)Math.Max(1, Model.PageSize)));
    var outCount = Model.Items.Count(x => x.AlertType == "OUT_OF_STOCK");
    var lowCount = Model.Items.Count(x => x.AlertType == "LOW_STOCK");
    var manualCount = Model.Items.Count(x => x.Source == "SALES_REPORT");
    var stores = ViewBag.StoreOptions as IReadOnlyList<AdminStoreOptionDto>
        ?? Array.Empty<AdminStoreOptionDto>();
}

<link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />

<main class="ops-shell">
    <header class="ops-header">
        <div>
            <div class="ops-eyebrow">Kho &amp; Cung ứng</div>
            <h1 class="ops-title"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> Cảnh báo kho</h1>
            <p class="ops-subtitle">Theo dõi thiếu hụt tại chi nhánh #@Model.StoreId. Trạng thái tồn kho và trạng thái xử lý được hiển thị riêng để quản lý ra quyết định rõ ràng.</p>
        </div>
        <div class="ops-actions">
            <a class="ops-btn" asp-area="Admin" asp-controller="AdminStoreInventory" asp-action="Index" asp-route-storeId="@Model.StoreId">
                <i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i> Xem tồn kho
            </a>
            <a class="ops-btn ops-btn-primary" asp-area="Admin" asp-controller="AdminRestockRequests" asp-action="Index" asp-route-storeId="@Model.StoreId">
                <i class="fa-solid fa-truck-ramp-box" aria-hidden="true"></i> Yêu cầu nhập hàng
            </a>
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="ops-notice ops-notice-success" role="status">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="ops-notice ops-notice-warning" role="status">@TempData["WarningMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="ops-notice ops-notice-error" role="alert">@TempData["ErrorMessage"]</div>
    }

    @if (stores.Count > 1)
    {
        <form method="get" class="ops-filterbar" aria-label="Chọn chi nhánh">
            <input type="hidden" name="status" value="@statusFilter" />
            <div class="ops-filter-group">
                <label class="ops-form-label mb-0" for="stockAlertStoreId">Chi nhánh</label>
                <select id="stockAlertStoreId" name="storeId" class="ops-select" onchange="this.form.submit()">
                    @foreach (var store in stores)
                    {
                        <option value="@store.StoreId" selected="@(store.StoreId == Model.StoreId)">@store.StoreName</option>
                    }
                </select>
            </div>
            <noscript><button type="submit" class="ops-btn">Áp dụng</button></noscript>
        </form>
    }

    <section class="ops-metrics" aria-label="Tóm tắt cảnh báo trên trang">
        <div class="ops-metric"><span class="ops-metric-label">Kết quả theo bộ lọc</span><strong class="ops-metric-value">@Model.Total</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Hết hàng trên trang</span><strong class="ops-metric-value danger">@outCount</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Sắp hết trên trang</span><strong class="ops-metric-value warning">@lowCount</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Nhân viên báo thiếu</span><strong class="ops-metric-value">@manualCount</strong></div>
    </section>

    <nav class="ops-status-tabs" aria-label="Lọc theo trạng thái xử lý">
        @foreach (var status in new[] { "OPEN", "CONFIRMED", "MANAGER_REJECTED", "RESOLVED", "" })
        {
            <a class="ops-tab @(statusFilter == status ? "active" : "")"
               asp-area="Admin" asp-controller="AdminStockAlerts" asp-action="Index" asp-route-storeId="@Model.StoreId"
               asp-route-status="@status">@(string.IsNullOrEmpty(status) ? "Tất cả" : AdminStatusDisplay.StockAlert(status).Label)</a>
        }
    </nav>

    @if (Model.Items.Count == 0)
    {
        <section class="ops-empty">
            <i class="fa-regular fa-circle-check fa-xl mb-3" aria-hidden="true"></i>
            <div class="fw-bold text-dark">Không có cảnh báo phù hợp</div>
            <div class="mt-1">Thử chọn trạng thái khác hoặc kiểm tra lại sau khi có biến động kho.</div>
        </section>
    }
    else
    {
        <section class="ops-table-wrap" aria-label="Danh sách cảnh báo kho">
            <div class="ops-table-scroll">
                <table class="ops-table">
                    <thead>
                        <tr>
                            <th>Mặt hàng</th>
                            <th>Trạng thái tồn</th>
                            <th class="number">Tồn vật lý</th>
                            <th class="number">Giữ chỗ</th>
                            <th class="number">Khả dụng</th>
                            <th class="number">Ngưỡng</th>
                            <th>Luồng xử lý</th>
                            <th>Nguồn</th>
                            <th>Cập nhật</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="ops-item-name">@item.ItemName</div>
                                <div class="ops-secondary">@item.ItemTypeLabel@(string.IsNullOrWhiteSpace(item.ReporterName) ? "" : $" · Báo bởi {item.ReporterName}")</div>
                            </td>
                            <td>
                                <span class="ops-badge @(item.AlertType == "OUT_OF_STOCK" ? "ops-badge-danger" : "ops-badge-warning")">
                                    <i class="fa-solid @(item.AlertType == "OUT_OF_STOCK" ? "fa-circle-xmark" : "fa-arrow-trend-down")" aria-hidden="true"></i>
                                    @AdminStatusDisplay.StockAlertType(item.AlertType)
                                </span>
                            </td>
                            <td class="number">@(item.OnHandQty.HasValue ? AdminStatusDisplay.Quantity(item.OnHandQty.Value) : "—")</td>
                            <td class="number">@(item.ReservedQty.HasValue ? AdminStatusDisplay.Quantity(item.ReservedQty.Value) : "—")</td>
                            <td class="number fw-bold @(item.AvailableQty.HasValue && item.AvailableQty.Value <= 0 ? "text-danger" : "")">@(item.AvailableQty.HasValue ? AdminStatusDisplay.Quantity(item.AvailableQty.Value) : AdminStatusDisplay.Quantity(item.CurrentQtySnapshot))</td>
                            <td class="number">@(item.ThresholdSnapshot.HasValue ? AdminStatusDisplay.Quantity(item.ThresholdSnapshot.Value) : "—")</td>
                            <td><span class="ops-badge @AdminStatusDisplay.StockAlert(item.Status).CssClass">@AdminStatusDisplay.StockAlert(item.Status).Label</span></td>
                            <td><span class="ops-secondary">@AdminStatusDisplay.StockAlertSource(item.Source)</span></td>
                            <td class="text-nowrap"><span class="ops-secondary">@item.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></td>
                            <td class="text-end">
                                <a class="ops-btn" asp-area="Admin" asp-controller="AdminStockAlerts" asp-action="Details" asp-route-id="@item.StockAlertId" asp-route-storeId="@item.StoreId">
                                    Chi tiết <i class="fa-solid fa-chevron-right ms-1" aria-hidden="true"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>

        <div class="ops-pagination">
            <span>Trang @currentPage / @totalPages · Tổng @Model.Total cảnh báo</span>
            <div class="ops-page-links">
                @if (currentPage > 1)
                {
                    <a class="ops-btn" asp-area="Admin" asp-controller="AdminStockAlerts" asp-action="Index" asp-route-status="@statusFilter" asp-route-storeId="@Model.StoreId" asp-route-page="@(currentPage - 1)">Trước</a>
                }
                @if (currentPage < totalPages)
                {
                    <a class="ops-btn" asp-area="Admin" asp-controller="AdminStockAlerts" asp-action="Index" asp-route-status="@statusFilter" asp-route-storeId="@Model.StoreId" asp-route-page="@(currentPage + 1)">Sau</a>
                }
            </div>
        </div>
    }
</main>
