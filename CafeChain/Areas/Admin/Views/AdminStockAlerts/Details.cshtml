@model CafeChain.Application.DTOs.Admin.StockAlerts.StockAlertDetailDto
@using CafeChain.Application.DTOs.Admin.RestockRequests
@using CafeChain.Application.DTOs.Admin.Replenishment
@using CafeChain.Application.Interfaces.Systems
@using CafeChain.ViewModels.Admin.Shared
@using Microsoft.Extensions.Localization
@inject IBusinessDateService BusinessDateService
@inject IStringLocalizer<InventoryResource> L
@{
    ViewData["Title"] = L["StockAlert.Details.Title"];
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var isOpen = Model.Status == "OPEN";
    var isConfirmed = Model.Status == "CONFIRMED";
    var openRestock = ViewBag.OpenRestockRequest as RestockRequestListItemDto;
    var suggestedBase = Model.ThresholdSnapshot.HasValue
        ? Math.Max(0m, Model.ThresholdSnapshot.Value - Model.CurrentQtySnapshot)
        : (decimal?)null;
    var suggestedProcurement = Model.SuggestedProcurementQuantity;
    var defaultPriority = Model.AlertType == "OUT_OF_STOCK" ? "URGENT" : "HIGH";
    var unitSuffix = string.IsNullOrWhiteSpace(Model.BaseUnitName) ? "" : $" {Model.BaseUnitName}";
    var procurementUnitSuffix = string.IsNullOrWhiteSpace(Model.ProcurementUnitName)
        ? ""
        : $" {Model.ProcurementUnitName}";
    var replenishment = ViewBag.PreparedItemReplenishment as PreparedItemReplenishmentDto;
    var isPreparedItemDemand = replenishment != null;
    var isManualPreparedItemDemand = isPreparedItemDemand
        && Model.IsOutOfThresholdManualDemand
        && Model.DecisionTargetBaseQuantity.HasValue;
    var preparedItemDemandBase = isManualPreparedItemDemand
        ? Math.Max(
            Model.DecisionTargetBaseQuantity!.Value - replenishment!.UsableBase - replenishment.OpenProductionCoverageBase.GetValueOrDefault(),
            0m)
        : replenishment?.NetNeedBase;
}

<link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" asp-append-version="true" />

<main class="ops-shell cc-warehouse-page">
<header class="ops-header cc-warehouse-header cc-warehouse-header--compact cc-warehouse-header--detail">
        <div>
            <div class="ops-eyebrow">@L["StockAlert.Details.Eyebrow", Model.StockAlertId, Model.ItemTypeLabel]</div>
            <h1 class="ops-title">@Model.ItemName</h1>
            <p class="ops-subtitle">@L["StockAlert.Details.Subtitle", AdminStatusDisplay.DateTime(BusinessDateService.ToBusinessTime(Model.CreatedAt))]</p>
        </div>
        <div class="ops-actions">
            <a class="ops-btn" asp-area="Admin" asp-controller="AdminStockAlerts" asp-action="Index" asp-route-storeId="@Model.StoreId">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> @L["StockAlert.Details.ButtonList"]
            </a>
            <a class="ops-btn" asp-area="Admin" asp-controller="AdminStoreInventory" asp-action="Index">
                <i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i> @L["StockAlert.Details.ButtonInventory"]
            </a>
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="ops-notice ops-notice-success" role="status">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="ops-notice ops-notice-error" role="alert">@TempData["ErrorMessage"]</div>
    }
    @if (Model.Status == "RESOLVED" && openRestock != null)
    {
        <div class="ops-notice ops-notice-info">@Html.Raw(L["StockAlert.Details.ResolvedButOpen"].Value)</div>
    }

    <section class="ops-metrics cc-warehouse-summary-grid" aria-label="@L["StockAlert.Details.MetricsAria"]">
        <div class="ops-metric"><span class="ops-metric-label">@L["StockAlert.Details.PhysicalNow"]</span><strong class="ops-metric-value">@(Model.OnHandQty.HasValue ? AdminStatusDisplay.Quantity(Model.OnHandQty.Value) : "—")</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">@L["StockAlert.Details.ReservedNow"]</span><strong class="ops-metric-value warning">@(Model.ReservedQty.HasValue ? AdminStatusDisplay.Quantity(Model.ReservedQty.Value) : "—")</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">@L["StockAlert.Details.AvailableNow"]</span><strong class="ops-metric-value @(Model.AvailableQty.HasValue && Model.AvailableQty.Value <= 0 ? "danger" : "success")">@(Model.AvailableQty.HasValue ? AdminStatusDisplay.Quantity(Model.AvailableQty.Value) : "—")</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">@L["StockAlert.Details.Threshold"]</span><strong class="ops-metric-value">@(Model.CurrentMinimumThresholdBaseQuantity.HasValue ? $"{AdminStatusDisplay.Quantity(Model.CurrentMinimumThresholdBaseQuantity.Value)}{unitSuffix}" : L["Common.NotSet"].Value)</strong></div>
    </section>

    <div class="ops-detail-grid">
        <div>
            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">@L["StockAlert.Details.SummaryTitle"]</h2></div>
                <div class="ops-panel-body">
                    <div class="ops-inline-actions mb-3">
                        <span class="ops-badge @(Model.AlertType == "OUT_OF_STOCK" ? "ops-badge-danger" : "ops-badge-warning")">
                            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                            @AdminStatusDisplay.StockAlertType(Model.AlertType)
                        </span>
                        <span class="ops-badge @AdminStatusDisplay.StockAlert(Model.Status).CssClass">@AdminStatusDisplay.StockAlert(Model.Status).Label</span>
                    </div>
                    <div class="ops-data-grid">
                        <div><span class="ops-data-label">@L["StockAlert.Details.AvailableAtAlert"]</span><span class="ops-data-value">@AdminStatusDisplay.Quantity(Model.CurrentQtySnapshot)</span></div>
                        @if (Model.IsOutOfThresholdManualDemand)
                        {
                            <div><span class="ops-data-label">@L["StockAlert.Details.ManualTarget"]</span><span class="ops-data-value">@(Model.DecisionTargetBaseQuantity.HasValue ? $"{AdminStatusDisplay.Quantity(Model.DecisionTargetBaseQuantity.Value)}{unitSuffix}" : L["Common.Unknown"].Value)</span></div>
                        }
                        else
                        {
                            <div><span class="ops-data-label">@L["StockAlert.Details.ThresholdAtAlert"]</span><span class="ops-data-value">@(Model.ThresholdSnapshot.HasValue ? $"{AdminStatusDisplay.Quantity(Model.ThresholdSnapshot.Value)}{unitSuffix}" : L["Common.NotConfigured"].Value)</span></div>
                        }
                        <div><span class="ops-data-label">@L["StockAlert.Details.DetectionSource"]</span><span class="ops-data-value">@AdminStatusDisplay.StockAlertSource(Model.Source)</span></div>
                        <div><span class="ops-data-label">@L["StockAlert.Details.LastUpdated"]</span><span class="ops-data-value">@BusinessDateService.ToBusinessTime(Model.UpdatedAt).ToString("g")</span></div>
                        <div><span class="ops-data-label">@L["StockAlert.Details.Reporter"]</span><span class="ops-data-value">@(Model.ReporterName ?? L["Common.System"].Value)</span></div>
                        <div><span class="ops-data-label">@L["StockAlert.Details.ItemType"]</span><span class="ops-data-value">@Model.ItemTypeLabel</span></div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.ReporterNote))
                    {
                        <div class="mt-3"><span class="ops-data-label">@L["StockAlert.Details.NoteTitle"]</span><div class="ops-notice mt-1 mb-0">@Model.ReporterNote</div></div>
                    }
                </div>
            </section>

            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">@L["StockAlert.Details.TimelineTitle"]</h2></div>
                <div class="ops-panel-body">
                    <ol class="ops-timeline">
                        @if (Model.Transitions.Count == 0)
                        {
                            <li><strong>@L["StockAlert.Details.Timeline.Detection"]</strong><div class="ops-secondary">@AdminStatusDisplay.DateTime(BusinessDateService.ToBusinessTime(Model.CreatedAt)) · @L["StockAlert.Details.Timeline.AvailablePrefix"] @AdminStatusDisplay.Quantity(Model.CurrentQtySnapshot)</div></li>
                        }
                        @foreach (var transition in Model.Transitions)
                        {
                            <li>
                                <strong>@AdminStatusDisplay.StockAlert(transition.NewStatus).Label · @AdminStatusDisplay.StockAlertType(transition.NewAlertType)</strong>
                                <div class="ops-secondary">@BusinessDateService.ToBusinessTime(transition.CreatedAtUtc).ToString("g") · @(transition.ActorName ?? (transition.ActorStaffId.HasValue ? L["Common.StaffNumber", transition.ActorStaffId].Value : L["Common.System"].Value))</div>
                                <div>@L["StockAlert.Details.Timeline.Snapshot", AdminStatusDisplay.Quantity(transition.OnHandSnapshot), AdminStatusDisplay.Quantity(transition.ReservedSnapshot), AdminStatusDisplay.Quantity(transition.AvailableSnapshot)]</div>
                                @if (!string.IsNullOrWhiteSpace(transition.Reason)) { <div>@AdminStatusDisplay.SystemGeneratedMessage(transition.Reason)</div> }
                            </li>
                        }
                        @if (openRestock != null)
                        {
                            <li><strong>@L["StockAlert.Details.Timeline.CreatedRequest", isPreparedItemDemand ? L["StockAlert.Details.CreateReplenishment"].Value : L["StockAlert.Details.CreateRestockRequest"].Value, openRestock.RestockRequestId]</strong><div class="ops-secondary">@AdminStatusDisplay.DateTime(BusinessDateService.ToBusinessTime(openRestock.CreatedAt)) · @AdminStatusDisplay.RestockRequest(openRestock.Status).Label</div></li>
                        }
                        @if (Model.ResolvedAt.HasValue)
                        {
                            <li><strong>@L["StockAlert.Details.Timeline.StockRecovered"]</strong><div class="ops-secondary">@BusinessDateService.ToBusinessTime(Model.ResolvedAt.Value).ToString("g")</div><div>@AdminStatusDisplay.SystemGeneratedMessage(Model.ResolvedReason)</div></li>
                        }
                    </ol>
                </div>
            </section>

            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">@L["StockAlert.Details.MovementsTitle"]</h2></div>
                <div class="ops-panel-body p-0">
                    @if (Model.RecentMovements.Count == 0)
                    {
                        <div class="p-3 ops-secondary">@L["StockAlert.Details.MovementsEmpty"]</div>
                    }
                    else
                    {
                        <div class="ops-table-scroll">
<table class="ops-table ops-table-min-680">
                                <thead><tr><th>@L["StockAlert.Details.Movements.Time"]</th><th>@L["StockAlert.Details.Movements.Type"]</th><th class="number">@L["StockAlert.Details.Movements.Change"]</th><th class="number">@L["StockAlert.Details.Movements.Before"]</th><th class="number">@L["StockAlert.Details.Movements.After"]</th><th>@L["StockAlert.Details.Movements.Reference"]</th></tr></thead>
                                <tbody>
                                @foreach (var movement in Model.RecentMovements)
                                {
                                    var reference = movement.BranchReceiptLineId.HasValue ? L["StockAlert.Details.Movements.Reference.Import", movement.BranchReceiptLineId].Value : movement.InventoryTransferId.HasValue ? L["StockAlert.Details.Movements.Reference.Transfer", movement.InventoryTransferId].Value : movement.ReferenceOrderId.HasValue ? L["StockAlert.Details.Movements.Reference.Order", movement.ReferenceOrderId].Value : movement.ProductionRunId.HasValue ? L["StockAlert.Details.Movements.Reference.Preparation", movement.ProductionRunId].Value : movement.InventoryDocumentId.HasValue ? L["StockAlert.Details.Movements.Reference.Document", movement.InventoryDocumentId].Value : L["StockAlert.Details.Movements.Reference.Direct"].Value;
                                    <tr>
                                        <td class="text-nowrap">@AdminStatusDisplay.DateTime(BusinessDateService.ToBusinessTime(movement.CreatedAt))</td>
                                        <td>@AdminStatusDisplay.InventoryTransactionType(movement.Type)</td>
                                        <td class="number fw-bold @(movement.Quantity < 0 ? "text-danger" : "text-success")">@(movement.Quantity > 0 ? "+" : "")@AdminStatusDisplay.Quantity(movement.Quantity)</td>
                                        <td class="number">@AdminStatusDisplay.Quantity(movement.BeforeQty)</td>
                                        <td class="number">@AdminStatusDisplay.Quantity(movement.AfterQty)</td>
                                        <td><span class="ops-secondary">@reference</span></td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </section>
        </div>

        <aside>
            @if (isOpen)
            {
                <section class="ops-panel">
                    <div class="ops-panel-header"><h2 class="ops-panel-title">@L["StockAlert.Details.ManagerTitle"]</h2></div>
                    <div class="ops-panel-body">
                        <form asp-area="Admin" asp-controller="AdminStockAlerts" asp-action="Confirm" method="post" class="mb-4">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.StockAlertId" />
                            <input type="hidden" name="storeId" value="@Model.StoreId" />
                            <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                            <div class="ops-form-group">
                                <label class="ops-form-label" for="managerNote">@L["StockAlert.Details.ConfirmNoteLabel"] <span class="ops-required">*</span></label>
                                <textarea id="managerNote" name="managerNote" class="ops-textarea" maxlength="500" required placeholder="@L["StockAlert.Details.ConfirmNotePlaceholder"]"></textarea>
                            </div>
                            <button type="submit" class="ops-btn ops-btn-primary w-100"><i class="fa-solid fa-check" aria-hidden="true"></i> @L["StockAlert.Details.ConfirmButton"]</button>
                        </form>
                        <details class="ops-danger-disclosure">
                            <summary>@L["StockAlert.Details.FalseReportDisclosure"]</summary>
                            <div class="ops-danger-content">
                                <form asp-area="Admin" asp-controller="AdminStockAlerts" asp-action="Reject" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.StockAlertId" />
                                    <input type="hidden" name="storeId" value="@Model.StoreId" />
                                    <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                                    <div class="ops-form-group">
                                        <label class="ops-form-label" for="rejectReason">@L["StockAlert.Details.FalseReasonLabel"] <span class="ops-required">*</span></label>
                                        <textarea id="rejectReason" name="rejectReason" class="ops-textarea" maxlength="500" required placeholder="@L["StockAlert.Details.FalseReasonPlaceholder"]"></textarea>
                                    </div>
                                    <button type="submit" class="ops-btn ops-btn-danger w-100"><i class="fa-solid fa-xmark" aria-hidden="true"></i> @L["StockAlert.Details.FalseReportButton"]</button>
                                </form>
                                <form asp-area="Admin" asp-controller="AdminStockAlerts" asp-action="Close" method="post" class="mt-4">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.StockAlertId" />
                                    <input type="hidden" name="storeId" value="@Model.StoreId" />
                                    <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                                    <label class="ops-form-label" for="closeReason">@L["StockAlert.Details.CloseReasonLabel"] <span class="ops-required">*</span></label>
                                    <textarea id="closeReason" name="closeReason" class="ops-textarea" maxlength="500" required placeholder="@L["StockAlert.Details.CloseReasonPlaceholder"]"></textarea>
                                    <button type="submit" class="ops-btn w-100 mt-2">@L["StockAlert.Details.CloseButton"]</button>
                                </form>
                            </div>
                        </details>
                    </div>
                </section>
            }

            @if (openRestock != null)
            {
                <section class="ops-panel">
                    <div class="ops-panel-header"><h2 class="ops-panel-title">@L["StockAlert.Details.OpenRestockTitle"]</h2></div>
                    <div class="ops-panel-body">
                        <div class="ops-data-grid">
                            <div><span class="ops-data-label">@L["StockAlert.Details.OpenRestock.Code"]</span><span class="ops-data-value">#@openRestock.RestockRequestId</span></div>
                            <div><span class="ops-data-label">@L["Common.Status"]</span><span class="ops-data-value">@AdminStatusDisplay.RestockRequest(openRestock.Status).Label</span></div>
                            <div><span class="ops-data-label">@L["StockAlert.Details.OpenRestock.Quantity"]</span><span class="ops-data-value">@AdminStatusDisplay.Quantity(openRestock.RequestedQuantity)</span></div>
                            <div><span class="ops-data-label">@L["Common.Priority"]</span><span class="ops-data-value">@AdminStatusDisplay.RestockRequestPriority(openRestock.Priority).Label</span></div>
                        </div>
                        <a class="ops-btn ops-btn-primary w-100 text-center mt-3" asp-area="Admin" asp-controller="AdminRestockRequests" asp-action="Details" asp-route-id="@openRestock.RestockRequestId" asp-route-storeId="@Model.StoreId">@L["StockAlert.Details.OpenRestock.Link"]</a>
                    </div>
                </section>
            }
            else if (isConfirmed)
            {
                <section class="ops-panel">
                    <div class="ops-panel-header"><h2 class="ops-panel-title">@(isPreparedItemDemand ? L["StockAlert.Details.CreateReplenishment"] : L["StockAlert.Details.CreateRestockRequest"])</h2></div>
                    <div class="ops-panel-body">
                        <form asp-area="Admin" asp-controller="AdminStockAlerts" asp-action="CreateRestockRequest" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.StockAlertId" />
                            <input type="hidden" name="storeId" value="@Model.StoreId" />
                            <input type="hidden" name="rowVersion" value="@(replenishment?.RowVersion ?? Model.RowVersion)" />
                            @if (!isPreparedItemDemand)
                            {
                                <input type="hidden" name="procurementUnitId" value="@Model.ProcurementUnitId" />
                            }
                            <div class="ops-form-group">
                                @if (isPreparedItemDemand)
                                {
                                    <div class="ops-data-grid">
                                        <div><span class="ops-data-label">@L["StockAlert.Details.Create.Available"]</span><span class="ops-data-value">@replenishment!.UsableBase.ToString("N3") @replenishment.BaseUnitCode</span></div>
                                        <div><span class="ops-data-label">@L["StockAlert.Details.Threshold"]</span><span class="ops-data-value">@(replenishment.LowThresholdBase?.ToString("N3") ?? L["Common.NotConfigured"].Value)</span></div>
                                        <div><span class="ops-data-label">@L["StockAlert.Details.Create.ManualTarget"]</span><span class="ops-data-value">@(replenishment.TargetStockBase?.ToString("N3") ?? L["Common.NotConfigured"].Value)</span></div>
                                        <div><span class="ops-data-label">@L["StockAlert.Details.Create.OpenProductionSource"]</span><span class="ops-data-value">@(replenishment.OpenProductionCoverageBase?.ToString("N3") ?? L["Common.Unknown"].Value)</span></div>
                                        <div><span class="ops-data-label">@L["StockAlert.Details.Create.StillNeeded"]</span><span class="ops-data-value">@(preparedItemDemandBase?.ToString("N3") ?? L["StockAlert.Details.Create.CannotCompute"].Value) @replenishment.BaseUnitCode</span></div>
                                    </div>
                                    @if (!replenishment.NetNeedBase.HasValue)
                                    {
                                        <div class="ops-notice ops-notice-warning mt-2">@replenishment.BusinessMessageVi</div>
                                    }
                                }
                                else
                                {
                                    <label class="ops-form-label" for="requestedProcurementQuantity">@L["StockAlert.Details.Create.QuantityLabel"]@(string.IsNullOrWhiteSpace(Model.ProcurementUnitName) ? "" : $" ({Model.ProcurementUnitName})") <span class="text-danger">*</span></label>
                                    <input id="requestedProcurementQuantity" type="number" name="requestedProcurementQuantity" class="ops-input w-100" step="0.001" min="0.001" max="@(suggestedProcurement is > 0 ? suggestedProcurement.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")" required disabled="@(suggestedProcurement is not > 0 || !Model.ProcurementUnitId.HasValue ? "disabled" : null)" value="@(suggestedProcurement is > 0 ? suggestedProcurement.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")" />
                                }
                                <div class="ops-help">
                                    @if (isPreparedItemDemand)
                                    {
                                        <span>@L["StockAlert.Details.Create.ServerRecalcHelp"]</span>
                                    }
                                    else if (Model.IsOutOfThresholdManualDemand)
                                    {
                                        <span>@L["StockAlert.Details.Create.VerifiedDemand", suggestedProcurement.HasValue ? $"{AdminStatusDisplay.Quantity(suggestedProcurement.Value)}{procurementUnitSuffix}" : L["StockAlert.Details.Create.InsufficientPurchaseUnit"].Value]</span>
                                    }
                                    else
                                    {
                                        <span>@L["StockAlert.Details.Create.ThresholdTopUp", suggestedProcurement.HasValue ? $"{AdminStatusDisplay.Quantity(suggestedProcurement.Value)}{procurementUnitSuffix}" : L["StockAlert.Details.Create.InsufficientPurchaseUnit"].Value]</span>
                                    }
                                    <span class="d-block mt-1">@L["StockAlert.Details.Create.SnapshotNote", suggestedBase.HasValue ? $"{AdminStatusDisplay.Quantity(suggestedBase.Value)}{unitSuffix}" : L["StockAlert.Details.Create.InsufficientData"].Value]</span>
                                </div>
                            </div>
                            <div class="ops-form-group">
                                <label class="ops-form-label" for="priority">@L["StockAlert.Details.Create.PriorityLabel"]</label>
                                <select id="priority" name="priority" class="ops-select w-100">
                                    <option value="NORMAL">@L["Common.Priority.Normal"]</option>
                                    <option value="HIGH" selected="@(defaultPriority == "HIGH")">@L["Common.Priority.High"]</option>
                                    <option value="URGENT" selected="@(defaultPriority == "URGENT")">@L["Common.Priority.Urgent"]</option>
                                </select>
                            </div>
                            <div class="ops-form-group">
                                <label class="ops-form-label" for="note">@L["Common.Note"]</label>
                                <textarea id="note" name="note" class="ops-textarea" maxlength="500" placeholder="@L["StockAlert.Details.Create.NotesPlaceholder"]"></textarea>
                            </div>
                            <button type="submit" class="ops-btn ops-btn-primary w-100" disabled="@(isPreparedItemDemand ? preparedItemDemandBase is not > 0 : suggestedProcurement is not > 0 || !Model.ProcurementUnitId.HasValue ? "disabled" : null)"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i> @(isPreparedItemDemand ? L["StockAlert.Details.Create.SubmitReplenishment"] : L["StockAlert.Details.Create.SubmitRestockRequest"])</button>
                        </form>
                        <details class="ops-danger-disclosure">
                            <summary>@L["StockAlert.Details.CloseDisclosure"]</summary>
                            <div class="ops-danger-content">
                                <form asp-area="Admin" asp-controller="AdminStockAlerts" asp-action="Close" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.StockAlertId" />
                                    <input type="hidden" name="storeId" value="@Model.StoreId" />
                                    <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                                    <label class="ops-form-label" for="confirmedCloseReason">@L["StockAlert.Details.CloseReason"] <span class="ops-required">*</span></label>
                                    <textarea id="confirmedCloseReason" name="closeReason" class="ops-textarea" maxlength="500" required placeholder="@L["StockAlert.Details.CloseReasonPlaceholder"]"></textarea>
                                    <button type="submit" class="ops-btn w-100 mt-2">@L["StockAlert.Details.ConfirmClose"]</button>
                                </form>
                            </div>
                        </details>
                    </div>
                </section>
            }
        </aside>
    </div>
</main>
