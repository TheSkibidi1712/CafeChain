@model CafeChain.Application.DTOs.Admin.StockAlerts.StockAlertDetailDto
@using CafeChain.Application.DTOs.Admin.RestockRequests
@using CafeChain.Application.Constants
@using CafeChain.Application.Interfaces.Admin.Permissions
@using CafeChain.ViewModels.Admin.Shared
@using System.Security.Claims
@inject IAdminPermissionService PermissionService
@{
    ViewData["Title"] = "Chi tiết cảnh báo kho";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var isOpen = Model.Status == "OPEN";
    var isConfirmed = Model.Status == "CONFIRMED";
    var openRestock = ViewBag.OpenRestockRequest as RestockRequestListItemDto;
    var permissions = new HashSet<string>(StringComparer.Ordinal);
    if (int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var accountId)
        && accountId > 0)
    {
        permissions = (await PermissionService.GetEffectivePermissionCodesAsync(accountId)).Data
            ?? new HashSet<string>(StringComparer.Ordinal);
    }
    var canResolve = permissions.Contains(PermissionConstants.StockAlertResolve);
    var canCreateRestock =
        permissions.Contains(PermissionConstants.StockAlertCreateRestockRequest);
    var canViewRestock = permissions.Contains(PermissionConstants.RestockView);
    var suggestedBase = Model.ThresholdSnapshot.HasValue
        ? Math.Max(0m, Model.ThresholdSnapshot.Value - Model.CurrentQtySnapshot)
        : (decimal?)null;
    var suggestedProcurement = Model.SuggestedProcurementQuantity;
    var defaultPriority = Model.AlertType == "OUT_OF_STOCK" ? "URGENT" : "HIGH";
    var unitSuffix = string.IsNullOrWhiteSpace(Model.BaseUnitName) ? "" : $" {Model.BaseUnitName}";
    var procurementUnitSuffix = string.IsNullOrWhiteSpace(Model.ProcurementUnitName)
        ? ""
        : $" {Model.ProcurementUnitName}";
}

<link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />

<main class="ops-shell">
    <header class="ops-header">
        <div>
            <div class="ops-eyebrow">Cảnh báo #@Model.StockAlertId · @Model.ItemTypeLabel</div>
            <h1 class="ops-title">@Model.ItemName</h1>
            <p class="ops-subtitle">Cảnh báo ghi nhận lúc @AdminStatusDisplay.DateTime(Model.CreatedAt.ToLocalTime()). Số liệu hiện tại được tách riêng khỏi dữ liệu tại thời điểm cảnh báo để tránh nhầm lẫn khi kho đã thay đổi.</p>
        </div>
        <div class="ops-actions">
            <a class="ops-btn" asp-area="Admin" asp-controller="AdminStockAlerts" asp-action="Index" asp-route-storeId="@Model.StoreId">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Danh sách
            </a>
            <a class="ops-btn" asp-area="Admin" asp-controller="AdminStoreInventory" asp-action="Index">
                <i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i> Tồn kho
            </a>
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="ops-notice ops-notice-success" role="status">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="ops-notice ops-notice-error" role="alert">@TempData["ErrorMessage"]</div>
    }
    @if (Model.Status == "RESOLVED" && openRestock != null)
    {
        <div class="ops-notice ops-notice-info"><strong>Tồn kho đã phục hồi nhưng yêu cầu nhập vẫn đang mở.</strong> Người phụ trách cần kiểm tra và quyết định tiếp tục hoặc hủy yêu cầu.</div>
    }

    <section class="ops-metrics" aria-label="Số liệu tồn kho">
        <div class="ops-metric"><span class="ops-metric-label">Tồn vật lý hiện tại</span><strong class="ops-metric-value">@(Model.OnHandQty.HasValue ? AdminStatusDisplay.Quantity(Model.OnHandQty.Value) : "—")</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Đang giữ chỗ</span><strong class="ops-metric-value warning">@(Model.ReservedQty.HasValue ? AdminStatusDisplay.Quantity(Model.ReservedQty.Value) : "—")</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Khả dụng hiện tại</span><strong class="ops-metric-value @(Model.AvailableQty.HasValue && Model.AvailableQty.Value <= 0 ? "danger" : "success")">@(Model.AvailableQty.HasValue ? AdminStatusDisplay.Quantity(Model.AvailableQty.Value) : "—")</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Ngưỡng tối thiểu hiện tại</span><strong class="ops-metric-value">@(Model.CurrentMinimumThresholdBaseQuantity.HasValue ? $"{AdminStatusDisplay.Quantity(Model.CurrentMinimumThresholdBaseQuantity.Value)}{unitSuffix}" : "Chưa đặt")</strong></div>
    </section>

    <div class="ops-detail-grid">
        <div>
            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">Tóm tắt cảnh báo</h2></div>
                <div class="ops-panel-body">
                    <div class="ops-inline-actions mb-3">
                        <span class="ops-badge @(Model.AlertType == "OUT_OF_STOCK" ? "ops-badge-danger" : "ops-badge-warning")">
                            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                            @AdminStatusDisplay.StockAlertType(Model.AlertType)
                        </span>
                        <span class="ops-badge @AdminStatusDisplay.StockAlert(Model.Status).CssClass">@AdminStatusDisplay.StockAlert(Model.Status).Label</span>
                    </div>
                    <div class="ops-data-grid">
                        <div><span class="ops-data-label">Khả dụng lúc cảnh báo</span><span class="ops-data-value">@AdminStatusDisplay.Quantity(Model.CurrentQtySnapshot)</span></div>
                        @if (Model.IsOutOfThresholdManualDemand)
                        {
                            <div><span class="ops-data-label">Mục tiêu thủ công</span><span class="ops-data-value">@(Model.DecisionTargetBaseQuantity.HasValue ? $"{AdminStatusDisplay.Quantity(Model.DecisionTargetBaseQuantity.Value)}{unitSuffix}" : "Chưa xác định")</span></div>
                        }
                        else
                        {
                            <div><span class="ops-data-label">Ngưỡng lúc cảnh báo</span><span class="ops-data-value">@(Model.ThresholdSnapshot.HasValue ? $"{AdminStatusDisplay.Quantity(Model.ThresholdSnapshot.Value)}{unitSuffix}" : "Chưa cấu hình")</span></div>
                        }
                        <div><span class="ops-data-label">Nguồn phát hiện</span><span class="ops-data-value">@AdminStatusDisplay.StockAlertSource(Model.Source)</span></div>
                        <div><span class="ops-data-label">Cập nhật gần nhất</span><span class="ops-data-value">@Model.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></div>
                        <div><span class="ops-data-label">Người báo</span><span class="ops-data-value">@(Model.ReporterName ?? "Hệ thống")</span></div>
                        <div><span class="ops-data-label">Mã định danh kho</span><span class="ops-data-value">@(Model.IngredientId.HasValue ? $"Nguyên liệu #{Model.IngredientId}" : Model.PreparedItemId.HasValue ? $"Bán thành phẩm #{Model.PreparedItemId}" : $"Công thức cũ #{Model.RecipeId}")</span></div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.ReporterNote))
                    {
                        <div class="mt-3"><span class="ops-data-label">Ghi chú báo cáo</span><div class="ops-notice mt-1 mb-0">@Model.ReporterNote</div></div>
                    }
                </div>
            </section>

            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">Dòng thời gian xử lý</h2></div>
                <div class="ops-panel-body">
                    <ol class="ops-timeline">
                        @if (Model.Transitions.Count == 0)
                        {
                            <li><strong>Phát hiện cảnh báo</strong><div class="ops-secondary">@AdminStatusDisplay.DateTime(Model.CreatedAt.ToLocalTime()) · Khả dụng @AdminStatusDisplay.Quantity(Model.CurrentQtySnapshot)</div></li>
                        }
                        @foreach (var transition in Model.Transitions)
                        {
                            <li>
                                <strong>@AdminStatusDisplay.StockAlert(transition.NewStatus).Label · @AdminStatusDisplay.StockAlertType(transition.NewAlertType)</strong>
                                <div class="ops-secondary">@transition.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @(transition.ActorName ?? (transition.ActorStaffId.HasValue ? $"Nhân viên #{transition.ActorStaffId}" : "Hệ thống"))</div>
                                <div>Tồn vật lý @AdminStatusDisplay.Quantity(transition.OnHandSnapshot) · Giữ chỗ @AdminStatusDisplay.Quantity(transition.ReservedSnapshot) · Khả dụng @AdminStatusDisplay.Quantity(transition.AvailableSnapshot)</div>
                                @if (!string.IsNullOrWhiteSpace(transition.Reason)) { <div>@AdminStatusDisplay.SystemGeneratedMessage(transition.Reason)</div> }
                            </li>
                        }
                        @if (openRestock != null)
                        {
                            <li><strong>Đã tạo yêu cầu nhập hàng #@openRestock.RestockRequestId</strong><div class="ops-secondary">@AdminStatusDisplay.DateTime(openRestock.CreatedAt.ToLocalTime()) · @AdminStatusDisplay.RestockRequest(openRestock.Status).Label</div></li>
                        }
                        @if (Model.ResolvedAt.HasValue)
                        {
                            <li><strong>Tồn kho đã phục hồi</strong><div class="ops-secondary">@Model.ResolvedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div><div>@AdminStatusDisplay.SystemGeneratedMessage(Model.ResolvedReason)</div></li>
                        }
                    </ol>
                </div>
            </section>

            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">Biến động kho gần nhất</h2></div>
                <div class="ops-panel-body p-0">
                    @if (Model.RecentMovements.Count == 0)
                    {
                        <div class="p-3 ops-secondary">Chưa có biến động kho để đối chiếu.</div>
                    }
                    else
                    {
                        <div class="ops-table-scroll">
<table class="ops-table ops-table-min-680">
                                <thead><tr><th>Thời gian</th><th>Loại biến động</th><th class="number">Thay đổi</th><th class="number">Trước</th><th class="number">Sau</th><th>Chứng từ</th></tr></thead>
                                <tbody>
                                @foreach (var movement in Model.RecentMovements)
                                {
                                    var reference = movement.BranchReceiptLineId.HasValue ? $"Phiếu nhận · dòng #{movement.BranchReceiptLineId}" : movement.InventoryTransferId.HasValue ? $"Điều chuyển #{movement.InventoryTransferId}" : movement.ReferenceOrderId.HasValue ? $"Đơn hàng #{movement.ReferenceOrderId}" : movement.ProductionRunId.HasValue ? $"Lệnh sơ chế #{movement.ProductionRunId}" : movement.InventoryDocumentId.HasValue ? $"Chứng từ kho #{movement.InventoryDocumentId}" : "Biến động trực tiếp";
                                    <tr>
                                        <td class="text-nowrap">@AdminStatusDisplay.DateTime(movement.CreatedAt.ToLocalTime())</td>
                                        <td>@AdminStatusDisplay.InventoryTransactionType(movement.Type)</td>
                                        <td class="number fw-bold @(movement.Quantity < 0 ? "text-danger" : "text-success")">@(movement.Quantity > 0 ? "+" : "")@AdminStatusDisplay.Quantity(movement.Quantity)</td>
                                        <td class="number">@AdminStatusDisplay.Quantity(movement.BeforeQty)</td>
                                        <td class="number">@AdminStatusDisplay.Quantity(movement.AfterQty)</td>
                                        <td><span class="ops-secondary">@reference</span></td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </section>
        </div>

        <aside>
            @if (isOpen && canResolve)
            {
                <section class="ops-panel">
                    <div class="ops-panel-header"><h2 class="ops-panel-title">Quyết định của quản lý</h2></div>
                    <div class="ops-panel-body">
                        <form asp-area="Admin" asp-controller="AdminStockAlerts" asp-action="Confirm" method="post" class="mb-4">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.StockAlertId" />
                            <input type="hidden" name="storeId" value="@Model.StoreId" />
                            <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                            <div class="ops-form-group">
                                <label class="ops-form-label" for="managerNote">Ghi chú xác nhận <span class="ops-required">*</span></label>
                                <textarea id="managerNote" name="managerNote" class="ops-textarea" maxlength="500" required placeholder="Nêu kết quả kiểm tra và hướng xử lý..."></textarea>
                            </div>
                            <button type="submit" class="ops-btn ops-btn-primary w-100"><i class="fa-solid fa-check" aria-hidden="true"></i> Xác nhận cảnh báo</button>
                        </form>
                        <details class="ops-danger-disclosure">
                            <summary>Đánh dấu báo sai hoặc đóng cảnh báo</summary>
                            <div class="ops-danger-content">
                                <form asp-area="Admin" asp-controller="AdminStockAlerts" asp-action="Reject" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.StockAlertId" />
                                    <input type="hidden" name="storeId" value="@Model.StoreId" />
                                    <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                                    <div class="ops-form-group">
                                        <label class="ops-form-label" for="rejectReason">Lý do báo sai <span class="ops-required">*</span></label>
                                        <textarea id="rejectReason" name="rejectReason" class="ops-textarea" maxlength="500" required placeholder="Nêu lý do số liệu hoặc báo cáo không chính xác..."></textarea>
                                    </div>
                                    <button type="submit" class="ops-btn ops-btn-danger w-100"><i class="fa-solid fa-xmark" aria-hidden="true"></i> Đánh dấu báo sai</button>
                                </form>
                                <form asp-area="Admin" asp-controller="AdminStockAlerts" asp-action="Close" method="post" class="mt-4">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.StockAlertId" />
                                    <input type="hidden" name="storeId" value="@Model.StoreId" />
                                    <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                                    <label class="ops-form-label" for="closeReason">Lý do đóng thủ công <span class="ops-required">*</span></label>
                                    <textarea id="closeReason" name="closeReason" class="ops-textarea" maxlength="500" required placeholder="Lý do đóng cảnh báo..."></textarea>
                                    <button type="submit" class="ops-btn w-100 mt-2">Đóng cảnh báo</button>
                                </form>
                            </div>
                        </details>
                    </div>
                </section>
            }

            @if (openRestock != null)
            {
                <section class="ops-panel">
                    <div class="ops-panel-header"><h2 class="ops-panel-title">Yêu cầu nhập đang mở</h2></div>
                    <div class="ops-panel-body">
                        <div class="ops-data-grid">
                            <div><span class="ops-data-label">Mã yêu cầu</span><span class="ops-data-value">#@openRestock.RestockRequestId</span></div>
                            <div><span class="ops-data-label">Trạng thái</span><span class="ops-data-value">@AdminStatusDisplay.RestockRequest(openRestock.Status).Label</span></div>
                            <div><span class="ops-data-label">Số lượng</span><span class="ops-data-value">@AdminStatusDisplay.Quantity(openRestock.RequestedQuantity)</span></div>
                            <div><span class="ops-data-label">Ưu tiên</span><span class="ops-data-value">@AdminStatusDisplay.RestockRequestPriority(openRestock.Priority).Label</span></div>
                        </div>
                        @if (canViewRestock)
                        {
                            <a class="ops-btn ops-btn-primary w-100 text-center mt-3" asp-area="Admin" asp-controller="AdminRestockRequests" asp-action="Details" asp-route-id="@openRestock.RestockRequestId" asp-route-storeId="@Model.StoreId">Mở yêu cầu nhập</a>
                        }
                    </div>
                </section>
            }
            else if (isConfirmed && canCreateRestock)
            {
                <section class="ops-panel">
                    <div class="ops-panel-header"><h2 class="ops-panel-title">Tạo yêu cầu nhập hàng</h2></div>
                    <div class="ops-panel-body">
                        <form asp-area="Admin" asp-controller="AdminStockAlerts" asp-action="CreateRestockRequest" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.StockAlertId" />
                            <input type="hidden" name="storeId" value="@Model.StoreId" />
                            <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                            <input type="hidden" name="procurementUnitId" value="@Model.ProcurementUnitId" />
                            <div class="ops-form-group">
                                <label class="ops-form-label" for="requestedProcurementQuantity">Số lượng yêu cầu theo đơn vị mua hàng@(string.IsNullOrWhiteSpace(Model.ProcurementUnitName) ? "" : $" ({Model.ProcurementUnitName})") <span class="text-danger">*</span></label>
                                <input id="requestedProcurementQuantity" type="number" name="requestedProcurementQuantity" class="ops-input w-100" step="0.001" min="0.001" max="@(suggestedProcurement is > 0 ? suggestedProcurement.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")" required disabled="@(suggestedProcurement is not > 0 || !Model.ProcurementUnitId.HasValue ? "disabled" : null)" value="@(suggestedProcurement is > 0 ? suggestedProcurement.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")" />
                                <div class="ops-help">
                                    @if (Model.IsOutOfThresholdManualDemand)
                                    {
                                        <span>Nhu cầu đã xác minh: mục tiêu thủ công − khả dụng = @(suggestedProcurement.HasValue ? $"{AdminStatusDisplay.Quantity(suggestedProcurement.Value)}{procurementUnitSuffix}" : "chưa đủ dữ liệu đơn vị mua hàng").</span>
                                    }
                                    else
                                    {
                                        <span>Bù đến ngưỡng tối thiểu: max(0, ngưỡng − khả dụng) = @(suggestedProcurement.HasValue ? $"{AdminStatusDisplay.Quantity(suggestedProcurement.Value)}{procurementUnitSuffix}" : "chưa đủ dữ liệu đơn vị mua hàng").</span>
                                    }
                                    <span class="d-block mt-1">Snapshot tồn kho tương ứng: @(suggestedBase.HasValue ? $"{AdminStatusDisplay.Quantity(suggestedBase.Value)}{unitSuffix}" : "chưa đủ dữ liệu").</span>
                                </div>
                            </div>
                            <div class="ops-form-group">
                                <label class="ops-form-label" for="priority">Mức ưu tiên</label>
                                <select id="priority" name="priority" class="ops-select w-100">
                                    <option value="NORMAL">Bình thường</option>
                                    <option value="HIGH" selected="@(defaultPriority == "HIGH")">Cao</option>
                                    <option value="URGENT" selected="@(defaultPriority == "URGENT")">Khẩn cấp</option>
                                </select>
                            </div>
                            <div class="ops-form-group">
                                <label class="ops-form-label" for="note">Ghi chú</label>
                                <textarea id="note" name="note" class="ops-textarea" maxlength="500" placeholder="Thông tin cần lưu ý cho bộ phận kho..."></textarea>
                            </div>
                            <button type="submit" class="ops-btn ops-btn-primary w-100" disabled="@(suggestedProcurement is not > 0 || !Model.ProcurementUnitId.HasValue ? "disabled" : null)"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Gửi yêu cầu nhập</button>
                        </form>
                        <details class="ops-danger-disclosure">
                            <summary>Đóng cảnh báo mà không tạo yêu cầu</summary>
                            <div class="ops-danger-content">
                                <form asp-area="Admin" asp-controller="AdminStockAlerts" asp-action="Close" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.StockAlertId" />
                                    <input type="hidden" name="storeId" value="@Model.StoreId" />
                                    <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                                    <label class="ops-form-label" for="confirmedCloseReason">Lý do đóng <span class="ops-required">*</span></label>
                                    <textarea id="confirmedCloseReason" name="closeReason" class="ops-textarea" maxlength="500" required placeholder="Lý do đóng cảnh báo..."></textarea>
                                    <button type="submit" class="ops-btn w-100 mt-2">Xác nhận đóng</button>
                                </form>
                            </div>
                        </details>
                    </div>
                </section>
            }
        </aside>
    </div>
</main>
