@model CafeChain.Application.DTOs.Admin.InventoryThresholds.InventoryThresholdListResultDto
@{
    ViewData["Title"] = "Ngưỡng tồn kho";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var currentPage = Model.Page;
    var totalPages = Math.Max(1, (int)Math.Ceiling(Model.Total / (double)Math.Max(1, Model.PageSize)));
    var search = Model.Search ?? "";
    var canEdit = ViewBag.CanEditThreshold as bool? == true;
    var configured = Model.Items.Count(x => x.ThresholdConfigured);
    var low = Model.Items.Count(x => x.MinStockLevel.HasValue && x.UsableQty <= x.MinStockLevel.Value);
}

<link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />

<main class="ops-shell cc-warehouse-page">
    <header class="ops-header cc-warehouse-header">
        <div>
            <div class="ops-eyebrow">Kho &amp; Cung ứng</div>
            <h1 class="ops-title"><i class="fa-solid fa-sliders" aria-hidden="true"></i> Ngưỡng tồn kho</h1>
            <p class="ops-subtitle">Thiết lập mức tồn tối thiểu theo từng cửa hàng và mặt hàng. Cảnh báo được đánh giá theo <strong>Khả dụng = Tồn vật lý − Giữ chỗ</strong>.</p>
        </div>
        <div class="ops-actions">
            <a class="ops-btn" asp-area="Admin" asp-controller="AdminStoreInventory" asp-action="Index"><i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i> Tồn kho</a>
            <a class="ops-btn ops-btn-primary" asp-area="Admin" asp-controller="AdminStockAlerts" asp-action="Index"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> Cảnh báo</a>
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null) { <div class="ops-notice ops-notice-success" role="status">@TempData["SuccessMessage"]</div> }
    @if (TempData["ErrorMessage"] != null) { <div class="ops-notice ops-notice-error" role="alert">@TempData["ErrorMessage"]</div> }
    @if (!canEdit) { <div class="ops-notice ops-notice-info">Bạn đang ở chế độ chỉ xem. Chỉ vai trò quản lý có phạm vi phù hợp mới được cập nhật ngưỡng.</div> }

    <section class="ops-metrics cc-warehouse-summary-grid" aria-label="Tóm tắt ngưỡng trên trang">
        <div class="ops-metric cc-warehouse-kpi"><span class="ops-metric-label">Mặt hàng theo bộ lọc</span><strong class="ops-metric-value">@Model.Total</strong></div>
        <div class="ops-metric cc-warehouse-kpi"><span class="ops-metric-label">Đã cấu hình trên trang</span><strong class="ops-metric-value success">@configured</strong></div>
        <div class="ops-metric cc-warehouse-kpi"><span class="ops-metric-label">Chưa cấu hình trên trang</span><strong class="ops-metric-value warning">@(Model.Items.Count - configured)</strong></div>
        <div class="ops-metric cc-warehouse-kpi"><span class="ops-metric-label">Đang dưới ngưỡng</span><strong class="ops-metric-value danger">@low</strong></div>
    </section>

    @if (Model.Stores.Count > 0)
    {
        <nav class="ops-store-tabs" aria-label="Chọn cửa hàng">
            @foreach (var store in Model.Stores)
            {
                <a class="ops-tab @(store.StoreId == Model.SelectedStoreId ? "active" : "")" asp-area="Admin" asp-controller="AdminInventoryThresholds" asp-action="Index" asp-route-storeId="@store.StoreId" asp-route-search="@search">@store.StoreName</a>
            }
        </nav>
    }

    <form method="get" class="ops-filterbar cc-warehouse-filter">
        <input type="hidden" name="storeId" value="@Model.SelectedStoreId" />
        <div class="ops-filter-group">
            <label class="visually-hidden" for="thresholdSearch">Tìm mặt hàng</label>
            <input id="thresholdSearch" type="search" name="search" value="@search" class="ops-input" placeholder="Tìm nguyên liệu hoặc bán thành phẩm..." />
            <button type="submit" class="ops-btn ops-btn-primary"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Tìm</button>
        </div>
        <span class="ops-secondary">Cửa hàng đang chọn: #@Model.SelectedStoreId</span>
    </form>

    @if (Model.Items.Count == 0)
    {
        <section class="ops-empty cc-warehouse-empty" aria-labelledby="thresholdEmptyTitle">
            <span class="ops-empty-icon"><i class="fa-solid fa-sliders" aria-hidden="true"></i></span>
            <h2 id="thresholdEmptyTitle" class="ops-empty-title">Không tìm thấy mặt hàng cần cấu hình</h2>
            <p class="ops-empty-copy">Thử đổi từ khóa hoặc chọn cửa hàng khác. Mặt hàng chỉ xuất hiện khi tài khoản có phạm vi xem kho tương ứng.</p>
            <div class="ops-empty-actions">
                <a class="ops-btn" asp-area="Admin" asp-controller="AdminInventoryThresholds" asp-action="Index" asp-route-storeId="@Model.SelectedStoreId">Xóa từ khóa</a>
                <a class="ops-btn ops-btn-primary" asp-area="Admin" asp-controller="AdminStoreInventory" asp-action="Index" asp-route-storeId="@Model.SelectedStoreId">Mở tồn kho cửa hàng</a>
            </div>
        </section>
    }
    else
    {
        <section class="ops-table-wrap cc-warehouse-table-shell">
            <div class="ops-table-scroll">
                <table class="ops-table">
                    <thead><tr><th>Mặt hàng</th><th>Loại</th><th class="number">Tồn vật lý</th><th class="number">Giữ chỗ</th><th class="number">Khả dụng</th><th>Trạng thái</th><th class="number">Ngưỡng tối thiểu</th><th class="text-center">THAO TÁC</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var isOut = item.UsableQty <= 0;
                        var isLow = item.MinStockLevel.HasValue && item.UsableQty <= item.MinStockLevel.Value;
                        <tr>
                            <td><div class="ops-item-name">@item.ItemName</div><div class="ops-secondary">ĐVT: @(item.UnitCode ?? "—")</div></td>
                            <td>@item.ItemTypeLabel</td>
                            <td class="number">@item.OnHandQty.ToString("N3")</td>
                            <td class="number">@item.ReservedQty.ToString("N3")</td>
                            <td class="number fw-bold @(isOut ? "ops-text-danger" : "")">@item.UsableQty.ToString("N3")</td>
                            <td>
                                @if (!item.ThresholdConfigured) { <span class="ops-badge ops-badge-neutral">Chưa cấu hình</span> }
                                else if (isOut) { <span class="ops-badge ops-badge-danger">Hết khả dụng</span> }
                                else if (isLow) { <span class="ops-badge ops-badge-warning">Dưới ngưỡng</span> }
                                else { <span class="ops-badge ops-badge-success">Bình thường</span> }
                            </td>
                            <td class="number">@(item.MinStockLevel?.ToString("N3") ?? "—")</td>
                            <td class="text-center">
                                @if (canEdit)
                                {
                                    <form asp-area="Admin" asp-controller="AdminInventoryThresholds" asp-action="Update" method="post" class="ops-inline-actions ops-inline-actions-center">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="storeInventoryId" value="@item.StoreInventoryId" />
                                        <input type="hidden" name="rowVersion" value="@item.RowVersion" />
                                        <input type="hidden" name="storeId" value="@Model.SelectedStoreId" />
                                        <input type="hidden" name="search" value="@search" />
                                        <input type="hidden" name="page" value="@currentPage" />
                            <input type="number" name="minStockLevel" class="ops-input ops-quantity-input" step="0.001" min="0" value="@(item.MinStockLevel?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" aria-label="Ngưỡng tối thiểu cho @item.ItemName" placeholder="Để trống" />
                                        <button type="submit" class="ops-btn ops-btn-primary">Lưu</button>
                                    </form>
                                }
                                else { <span class="ops-secondary">Chỉ xem</span> }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
        <div class="ops-pagination">
            <span>Trang @currentPage / @totalPages · Tổng @Model.Total mặt hàng</span>
            <div class="ops-page-links">
                @if (currentPage > 1) { <a class="ops-btn" asp-area="Admin" asp-controller="AdminInventoryThresholds" asp-action="Index" asp-route-storeId="@Model.SelectedStoreId" asp-route-search="@search" asp-route-page="@(currentPage - 1)">Trước</a> }
                @if (currentPage < totalPages) { <a class="ops-btn" asp-area="Admin" asp-controller="AdminInventoryThresholds" asp-action="Index" asp-route-storeId="@Model.SelectedStoreId" asp-route-search="@search" asp-route-page="@(currentPage + 1)">Sau</a> }
            </div>
        </div>
    }
</main>
