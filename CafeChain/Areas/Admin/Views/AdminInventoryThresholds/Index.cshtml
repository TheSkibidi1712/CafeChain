@model CafeChain.Application.DTOs.Admin.InventoryThresholds.InventoryThresholdListResultDto
@{
    ViewData["Title"] = "Ngưỡng tồn kho";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int page = Model.Page;
    int totalPages = Math.Max(1, (int)Math.Ceiling(Model.Total / (double)Math.Max(1, Model.PageSize)));
    var search = Model.Search ?? "";
    var canEdit = ViewBag.CanEditThreshold as bool? == true;
}

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h4 class="mb-0">Ngưỡng tồn kho</h4>
            <small class="text-muted">Cấu hình <strong>Ngưỡng tồn tối thiểu</strong> (MinStockLevel) cho cảnh báo kho tự động</small>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }
    @if (!canEdit)
    {
        <div class="alert alert-info py-2">
            Bạn chỉ có quyền <strong>xem</strong> ngưỡng tồn kho. Chỉ Quản lý chi nhánh / Quản lý vùng / Chủ doanh nghiệp / Quản trị hệ thống được cập nhật.
        </div>
    }

    @if (Model.Stores != null && Model.Stores.Count > 0)
    {
        <ul class="nav nav-tabs mb-3">
            @foreach (var s in Model.Stores)
            {
                <li class="nav-item">
                    <a class="nav-link @(s.StoreId == Model.SelectedStoreId ? "active" : "")"
                       asp-area="Admin" asp-controller="AdminInventoryThresholds" asp-action="Index"
                       asp-route-storeId="@s.StoreId" asp-route-search="@search">@s.StoreName</a>
                </li>
            }
        </ul>
    }

    <form method="get" class="row g-2 mb-3">
        <input type="hidden" name="storeId" value="@Model.SelectedStoreId" />
        <div class="col-auto">
            <input type="text" name="search" value="@search" class="form-control form-control-sm"
                   placeholder="Tìm theo tên..." />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-sm btn-outline-primary">Tìm</button>
        </div>
    </form>

    @if (Model.Items == null || Model.Items.Count == 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center text-muted py-5">Không có dòng tồn kho phù hợp.</div>
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm bg-white rounded">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tên</th>
                        <th>Loại</th>
                        <th>Tồn khả dụng</th>
                        <th>Đang giữ chỗ</th>
                        <th>Ngưỡng tồn tối thiểu</th>
                        <th style="min-width: 220px;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@item.ItemName</div>
                            @if (!string.IsNullOrEmpty(item.UnitCode))
                            {
                                <small class="text-muted">ĐVT: @item.UnitCode</small>
                            }
                        </td>
                        <td>@item.ItemTypeLabel</td>
                        <td>@item.AvailableQty.ToString("N3")</td>
                        <td>@item.ReservedQty.ToString("N3")</td>
                        <td>
                            @if (item.ThresholdConfigured)
                            {
                                <span>@item.MinStockLevel!.Value.ToString("N3")</span>
                            }
                            else
                            {
                                <span class="text-muted small">Chưa cấu hình ngưỡng tối thiểu</span>
                            }
                        </td>
                        <td>
                            @if (canEdit)
                            {
                                <form asp-area="Admin" asp-controller="AdminInventoryThresholds" asp-action="Update"
                                      method="post" class="d-flex flex-wrap gap-1 align-items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="storeInventoryId" value="@item.StoreInventoryId" />
                                    <input type="hidden" name="storeId" value="@Model.SelectedStoreId" />
                                    <input type="hidden" name="search" value="@search" />
                                    <input type="hidden" name="page" value="@(page)" />
                                    <input type="number" name="minStockLevel" class="form-control form-control-sm"
                                           style="width: 110px;" step="0.001" min="0"
                                           value="@(item.MinStockLevel?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                           placeholder="Trống = xóa" />
                                    <button type="submit" class="btn btn-sm btn-primary">Lưu ngưỡng</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">Chỉ xem</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination pagination-sm">
                    @for (var p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == page ? "active" : "")">
                            <a class="page-link"
                               asp-area="Admin" asp-controller="AdminInventoryThresholds" asp-action="Index"
                               asp-route-storeId="@Model.SelectedStoreId"
                               asp-route-search="@search"
                               asp-route-page="@(p)">@p</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>
