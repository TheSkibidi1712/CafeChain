@{
    ViewData["Title"] = "Máy POS Thu Ngân — CafeChain";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
<link rel="stylesheet" href="~/css/pos-premium.css" />
}

<!-- ====== OFFLINE BANNER ====== -->
<div class="offline-banner" id="offlineBanner">
    ⚠️ Mất kết nối mạng — Đơn hàng sẽ được lưu tạm và đồng bộ khi có mạng trở lại
</div>

<!-- ====== POS HEADER ====== -->
<div class="pos-wrapper">
<header class="pos-header">
    <div class="logo-section">
        <div class="logo-icon"><i class="fas fa-coffee"></i></div>
        <span class="logo-text">Cafe<span>Chain</span></span>
    </div>
    <div class="header-info">
        <div class="info-badge" id="shiftBadge">
            <i class="fas fa-cash-register"></i>
            <span id="headerShiftStatus">Chưa mở ca</span>
        </div>
        <span id="headerTerminalName" style="font-size:12px;opacity:0.8;margin-left:6px;background:rgba(255,255,255,0.15);padding:2px 8px;border-radius:4px;">POS Thiết Bị</span>
        <div class="info-badge">
            <div class="network-indicator" id="networkIndicator"></div>
            <span id="networkStatusText">Online</span>
        </div>
    </div>
    <div style="display:flex;gap:10px;align-items:center;">
        <button class="btn-header btn-danger-header" id="btnCloseShift" style="display:none;">
            <i class="fas fa-lock"></i> Đóng ca
        </button>
        <a href="/Admin/Dashboard" class="btn-header">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>
</header>

<!-- ====== OPEN SHIFT OVERLAY (Hình 2) ====== -->
<div class="shift-overlay" id="shiftOverlay">
    <div class="shift-modal">
        <div class="modal-icon"><i class="fas fa-cash-register"></i></div>
        <h4>Mở Ca Két Tiền</h4>
        <p class="modal-desc">Đếm số tiền lẻ trong két và nhập chính xác<br>để bắt đầu phiên bán hàng.</p>
        <div class="staff-card" id="staffCard">
            <div class="staff-avatar" id="staffAvatar">NV</div>
            <div class="staff-info">
                <div class="staff-name" id="staffName">Nhân viên</div>
                <div class="staff-role" id="staffRole">Thu ngân (Cashier)</div>
                <div class="staff-store" id="staffStore">🏪 Chi nhánh</div>
            </div>
        </div>
        <div class="cash-label">💰 Tiền lẻ đầu ca (Starting Cash)</div>
        <input type="number" class="cash-input" id="startingCashInput" placeholder="0" min="0" step="10000">
        <div class="quick-cash">
            <button onclick="setQuickCash(500000, this)">500K</button>
            <button onclick="setQuickCash(1000000, this)">1,000K</button>
            <button onclick="setQuickCash(1500000, this)">1,500K</button>
            <button onclick="setQuickCash(2000000, this)">2,000K</button>
        </div>
        <div class="info-banner">
            <i class="fas fa-lightbulb"></i>
            <span>Hãy đếm kỹ số tiền mặt lẻ trong hộc kéo. Nếu khác với định mức tiêu chuẩn (1,000,000đ), hãy nhập đúng số thực tế bạn đếm được.</span>
        </div>
        <button class="btn-open-shift" id="btnOpenShift">
            <i class="fas fa-unlock"></i> Xác Nhận Mở Ca
        </button>
    </div>
</div>

<!-- ====== MAIN POS LAYOUT (Hình 1) ====== -->
<div class="pos-container">
<!-- LEFT: Menu Panel -->
<div class="pos-menu-panel">
    <div class="menu-search-bar" style="position:relative;">
        <i class="fas fa-search search-icon"></i>
        <input type="text" id="searchInput" placeholder="Tìm kiếm đồ uống...">
    </div>
    <div class="category-tabs" id="categoryTabs">
        <div class="cat-tab active" data-cat="all">Tất cả</div>
    </div>
    <div class="product-grid" id="productGrid">
        <div class="cart-empty" style="grid-column:1/-1;">
            <i class="fas fa-spinner fa-spin"></i>
            <p>Đang tải menu...</p>
        </div>
    </div>
</div>

<!-- RIGHT: Cart & Payment Panel -->
<div class="pos-cart-panel">
    <!-- Customer section (voucher/điểm thưởng removed from product scope) -->
    <div class="cart-customer-section">
        <div class="cust-input-row">
            <input type="text" id="customerPhone" placeholder="📱 SĐT khách hàng...">
            <button class="btn-search-cust" onclick="searchCustomer()"><i class="fas fa-search"></i></button>
            <button type="button" class="btn-quick-reg" id="btnOpenQuickReg" onclick="openQuickRegModal()" title="Đăng ký nhanh hội viên"><i class="fas fa-plus"></i></button>
        </div>
        <div class="customer-info-badge" id="customerBadge">
            <div style="display:flex;align-items:center;gap:8px;">
                <div class="cust-avatar" id="custAvatar">KH</div>
                <div><span class="cust-name" id="custName"></span></div>
            </div>
            <button class="btn-remove-cust" onclick="clearCustomer()"><i class="fas fa-times"></i></button>
        </div>
    </div>

    <!-- Order Type Toggle -->
    <div class="order-type-toggle">
        <div class="order-type-btn active" data-type="1" onclick="setOrderType(1, this)">
            <i class="fas fa-utensils"></i> Tại quán
        </div>
        <div class="order-type-btn" data-type="2" onclick="setOrderType(2, this)">
            <i class="fas fa-bag-shopping"></i> Mang đi
        </div>
    </div>

    <!-- Cart Header -->
    <div class="cart-header">
        <h6><i class="fas fa-shopping-cart me-2"></i>Giỏ hàng</h6>
        <span class="item-count" id="cartCount">0</span>
    </div>

    <!-- Cart Items -->
    <div class="cart-items" id="cartItems">
        <div class="cart-empty" id="cartEmpty">
            <i class="fas fa-shopping-basket"></i>
            <p>Chọn sản phẩm để bắt đầu</p>
        </div>
    </div>

    <!-- Payment Summary & Checkout -->
    <div class="payment-section">
        <div class="payment-summary">
            <div class="summary-row">
                <span>Tạm tính</span><span id="sumSubTotal">0đ</span>
            </div>
            <div class="summary-row total-row">
                <span>Tổng cộng</span><span id="sumTotal">0đ</span>
            </div>
        </div>
        <button class="btn-checkout" id="btnCheckout" disabled onclick="openCheckoutModal()">
            <i class="fas fa-credit-card"></i> THANH TOÁN
        </button>
    </div>
</div>
</div><!-- /.pos-container -->

<!-- ====== SIZE/TOPPING SELECTOR ====== -->
<div class="size-selector-overlay" id="sizeSelectorOverlay" onclick="if(event.target===this)closeSizeSelector()">
    <div class="size-selector-modal">
        <h5 id="sizeModalTitle">Chọn size</h5>
        <p style="color:#64748b;font-size:13px;margin-bottom:12px;" id="sizeModalSub"></p>
        <div id="sizeOptions"></div>
        <div class="topping-section" id="toppingSection" style="display:none;">
            <h6><i class="fas fa-plus-circle me-1"></i>Thêm topping</h6>
            <div id="toppingOptions"></div>
        </div>
        <button class="btn-add-to-cart" id="btnAddToCart" onclick="confirmAddToCart()">
            <i class="fas fa-cart-plus me-2"></i>Thêm vào giỏ hàng
        </button>
    </div>
</div>

<!-- ====== CHECKOUT MODAL (Hình 4) ====== -->
<div class="checkout-overlay" id="checkoutOverlay">
    <div class="checkout-modal">
        <div class="ck-header">
            <h4><i class="fas fa-cash-register"></i> Thanh Toán Đa Kênh</h4>
            <div style="display:flex;align-items:center;gap:12px;">
                <div class="total-badge" id="ckTotalBadge">0đ</div>
                <button onclick="closeCheckoutModal()" style="border:1px solid #e2e8f0;background:white;border-radius:8px;width:32px;height:32px;cursor:pointer;font-size:14px;color:#64748b;">✕</button>
            </div>
        </div>
        <div class="ck-tabs">
            <div class="ck-tab active" data-tab="cash" onclick="switchCkTab('cash',this)"><i class="fas fa-money-bill-wave"></i> Tiền mặt</div>
            <div class="ck-tab" data-tab="qr" onclick="switchCkTab('qr',this)"><i class="fas fa-qrcode"></i> Quét mã QR</div>
            <div class="ck-tab" data-tab="split" onclick="switchCkTab('split',this)"><i class="fas fa-arrows-split-up-and-left"></i> Chia thanh toán</div>
        </div>
        <!-- Split Payment Panel -->
        <div id="ckSplitPanel" style="display:none;padding:16px;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
                <h6 style="margin:0;font-weight:700;font-size:14px;"><i class="fas fa-arrows-split-up-and-left" style="color:#F97316;margin-right:6px;"></i>Chia thanh toán</h6>
                <span style="font-size:12px;color:#64748b;">Tổng: <b id="splitTotalLabel">0đ</b></span>
            </div>
            <div class="split-row" style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
                <div style="flex:1;display:flex;align-items:center;gap:8px;background:#f8fafc;padding:10px 12px;border-radius:10px;border:1px solid #e2e8f0;">
                    <i class="fas fa-money-bill-wave" style="color:#16a34a;"></i>
                    <span style="font-size:13px;font-weight:600;">Tiền mặt</span>
                </div>
                <input type="number" id="splitCashAmount" class="form-control" placeholder="0" min="0" step="1000" style="width:140px;border-radius:10px;text-align:right;font-weight:600;" oninput="updateSplitTotal()">
            </div>
            <div class="split-row" style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
                <div style="flex:1;display:flex;align-items:center;gap:8px;background:#f8fafc;padding:10px 12px;border-radius:10px;border:1px solid #e2e8f0;">
                    <i class="fas fa-qrcode" style="color:#3b82f6;"></i>
                    <span style="font-size:13px;font-weight:600;">QR / Chuyển khoản</span>
                </div>
                <input type="number" id="splitQrAmount" class="form-control" placeholder="0" min="0" step="1000" style="width:140px;border-radius:10px;text-align:right;font-weight:600;" oninput="updateSplitTotal()">
            </div>
            <div id="splitValidation" style="text-align:center;padding:8px;border-radius:8px;font-size:12px;font-weight:600;margin-top:8px;"></div>
        </div>
        <div class="ck-body">
            <div class="ck-left">
                <!-- Cash Numpad -->
                <div id="ckCashPanel">
                    <div class="numpad-display">
                        <div class="display-label">Tiền khách đưa</div>
                        <div class="display-value" id="ckCashDisplay">0đ</div>
                    </div>
                    <div class="quick-amount-grid">
                        <button class="quick-amount-btn" onclick="setCkAmount('exact')">Đúng tiền</button>
                        <button class="quick-amount-btn" onclick="setCkAmount(10000)">10K</button>
                        <button class="quick-amount-btn" onclick="setCkAmount(20000)">20K</button>
                        <button class="quick-amount-btn" onclick="setCkAmount(50000)">50K</button>
                        <button class="quick-amount-btn" onclick="setCkAmount(100000)">100K</button>
                        <button class="quick-amount-btn" onclick="setCkAmount(200000)">200K</button>
                        <button class="quick-amount-btn" onclick="setCkAmount(500000)">500K</button>
                        <button class="quick-amount-btn" onclick="setCkAmount(1000000)">1,000K</button>
                        <button class="quick-amount-btn btn-clear" onclick="setCkAmount(0)">Xóa</button>
                    </div>
                    <div class="numpad-grid">
                        <button class="numpad-btn" onclick="numpadInput('1')">1</button>
                        <button class="numpad-btn" onclick="numpadInput('2')">2</button>
                        <button class="numpad-btn" onclick="numpadInput('3')">3</button>
                        <button class="numpad-btn" onclick="numpadInput('4')">4</button>
                        <button class="numpad-btn" onclick="numpadInput('5')">5</button>
                        <button class="numpad-btn" onclick="numpadInput('6')">6</button>
                        <button class="numpad-btn" onclick="numpadInput('7')">7</button>
                        <button class="numpad-btn" onclick="numpadInput('8')">8</button>
                        <button class="numpad-btn" onclick="numpadInput('9')">9</button>
                        <div></div>
                        <button class="numpad-btn" onclick="numpadInput('0')">0</button>
                        <button class="numpad-btn btn-backspace" onclick="numpadInput('back')"><i class="fas fa-backspace"></i></button>
                    </div>
                </div>
            </div>
            <div class="ck-right">
                <div class="qr-section" id="ckQrSection">
                    <div class="qr-badge" style="display:inline-flex;align-items:center;gap:4px;background:#f0fdf4;padding:3px 8px;border-radius:6px;font-size:11px;font-weight:600;color:#16a34a;margin-bottom:8px;">Quét mã QR <span style="background:#16a34a;color:white;padding:1px 6px;border-radius:4px;font-size:10px;">VietQR</span></div>
                    <div class="qr-placeholder"><i class="fas fa-qrcode"></i></div>
                    <div style="font-size:12px;color:#94a3b8;">Mã QR thanh toán</div>
                    <div class="qr-bank-info">
                        <div style="display:flex;justify-content:space-between;font-size:11px;"><span>Ngân hàng</span><b>VietinBank</b></div>
                        <div style="display:flex;justify-content:space-between;font-size:11px;"><span>Số tài khoản</span><b>113000xxxxxx</b></div>
                        <div style="display:flex;justify-content:space-between;font-size:11px;"><span>Chủ TK</span><b>CAFECHAIN CORP</b></div>
                    </div>
                    <div class="qr-timer">Hết hạn trong <span id="qrTimer">05:00</span></div>
                </div>
                <div class="change-summary" id="ckChangeSummary">
                    <div class="change-row"><span>Tổng tiền</span><span id="ckSumTotal">0đ</span></div>
                    <div class="change-row"><span>Khách đưa</span><span id="ckSumReceived">0đ</span></div>
                    <div class="change-total"><span>Tiền thối lại</span><span id="ckSumChange">0đ</span></div>
                </div>
            </div>
        </div>
        <div class="ck-footer">
            <button class="btn-ck-cancel" onclick="closeCheckoutModal()">Hủy</button>
            <button class="btn-ck-confirm" id="btnConfirmPayment" onclick="confirmPayment()" disabled>
                <i class="fas fa-check-circle"></i> XÁC NHẬN THANH TOÁN
            </button>
        </div>
    </div>
</div>

<!-- ====== CLOSE SHIFT MODAL (Hình 3) ====== -->
<div class="close-shift-overlay" id="closeShiftOverlay">
    <div class="close-shift-modal">
        <div class="modal-header-bar">
            <h4><i class="fas fa-cash-register" style="color:#F97316"></i> Đóng Ca Két Tiền</h4>
            <button class="modal-close-btn" onclick="closeCloseShiftModal()">✕</button>
        </div>
        <div class="modal-body">
            <div class="left-col">
                <h6 style="font-size:14px;font-weight:700;margin-bottom:10px;"><i class="fas fa-clock" style="color:#F97316"></i> Tóm tắt ca làm việc</h6>
                <div class="stat-grid">
                    <div class="stat-box"><div class="stat-label">Thời gian mở ca</div><div class="stat-value" id="csStartTime">--:--</div></div>
                    <div class="stat-box"><div class="stat-label">Thời gian hiện tại</div><div class="stat-value" id="csCurrentTime">--:--</div></div>
                    <div class="stat-box"><div class="stat-label">Thời lượng ca</div><div class="stat-value orange" id="csDuration">--</div></div>
                    <div class="stat-box"><div class="stat-label">Tổng đơn hàng</div><div class="stat-value orange" id="csTotalOrders">0 đơn</div></div>
                </div>
                <div style="font-size:13px;color:#475569;margin-bottom:12px;">Tiền lẻ đầu ca: <b id="csStartingCash">0đ</b></div>
                <div class="revenue-section">
                    <h6>💰 Bảng kê doanh thu ca</h6>
                    <div class="revenue-row"><span><i class="fas fa-money-bill-wave rev-icon" style="color:#16a34a"></i> Tiền mặt thu được</span><span class="rev-amount" id="csCashSales">0đ</span></div>
                    <div class="revenue-row"><span><i class="fas fa-qrcode rev-icon" style="color:#3b82f6"></i> Tiền qua QR / Chuyển khoản</span><span class="rev-amount" id="csQrSales">0đ</span></div>
                    <div class="revenue-row"><span><i class="fas fa-arrow-down rev-icon" style="color:#ef4444"></i> Tiền thối ra</span><span class="rev-amount negative" id="csCashChange">-0đ</span></div>
                    <div class="revenue-total"><span>Tổng doanh thu ròng</span><span id="csNetRevenue">0đ</span></div>
                </div>
            </div>
            <div class="right-col">
                <h6 style="font-size:14px;font-weight:700;margin-bottom:10px;"><i class="fas fa-hand-holding-usd" style="color:#F97316"></i> Kiểm két thực tế</h6>
                <div style="font-size:12px;color:#64748b;margin-bottom:6px;">Tiền mặt thực tế tại két (đếm tay)</div>
                <input type="number" class="cash-input" id="csActualCash" placeholder="0" min="0" step="10000" style="margin-bottom:8px;" oninput="checkDiscrepancy()">
                <div class="quick-cash" style="margin-bottom:12px;">
                    <button onclick="setCloseCash(500000)">500K</button>
                    <button onclick="setCloseCash(1000000)">1,000K</button>
                    <button onclick="setCloseCash(2000000)">2,000K</button>
                    <button onclick="setCloseCash(3000000)">3,000K</button>
                    <button onclick="setCloseCash(5000000)">5,000K</button>
                </div>
                <div class="discrepancy-box" id="discrepancyBox">
                    <div class="disc-title"><i class="fas fa-exclamation-triangle"></i> <span id="discTitle">Phát hiện chênh lệch két tiền!</span></div>
                    <div class="disc-compare">Tiền mặt lý thuyết (Expected): <b id="discExpected">0đ</b></div>
                    <div class="disc-compare">Tiền mặt thực tế (Actual): <b id="discActual">0đ</b></div>
                    <div class="disc-amount" id="discAmount">0đ</div>
                    <div class="disc-reason-label"><i class="fas fa-pen"></i> Lý do chênh lệch két tiền (bắt buộc)</div>
                    <textarea id="discReason" placeholder="Nhập lý do chênh lệch... (VD: Thối nhầm cho khách đơn #1234)" oninput="checkCloseShiftReady()"></textarea>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-cancel" onclick="closeCloseShiftModal()">Hủy</button>
            <button class="btn-confirm-close" id="btnConfirmCloseShift" onclick="confirmCloseShift()">
                <i class="fas fa-lock"></i> XÁC NHẬN ĐÓNG CA
            </button>
        </div>
    </div>
</div>

@* Phase 3 (#140): PIN AUTH MODAL removed — AuthorizeSupervisor returns FEATURE_NOT_AVAILABLE. *@
<div class="pin-overlay" id="pinOverlay" style="display:none" aria-hidden="true"></div>

<!-- ====== SUCCESS MODAL (Hình 6) ====== -->
<div class="success-overlay" id="successOverlay">
    <div class="success-modal">
        <div class="success-header">
            <div class="success-icon"><i class="fas fa-check"></i></div>
            <h4>Thanh toán thành công!</h4>
            <p>Giao dịch đã được ghi nhận vào hệ thống</p>
        </div>
        <div class="order-info">
            <div class="order-badge" id="successOrderBadge">ĐƠN #0000</div>
            <span id="successOrderTime" style="font-size:12px;color:#94a3b8;margin-left:8px;"></span>
            <div class="order-items" id="successOrderItems"></div>
        </div>
        <div class="financial-summary" id="successFinSummary"></div>
        <div class="change-box" id="successChangeBox">
            <div class="change-label">Tiền mặt: <span id="successCashPaid">0đ</span></div>
            <div class="change-title">TIỀN THỐI LẠI</div>
            <div class="change-value" id="successChangeAmount">0đ</div>
        </div>

        <div class="auto-redirect" id="successCountdown">Tự động chuyển sau <b id="countdownSec">10</b> giây</div>
        <div class="success-actions">
            <button class="btn-print" onclick="printReceipt()"><i class="fas fa-print"></i> In hóa đơn</button>
            <button class="btn-next-order" onclick="nextOrder()">Đơn tiếp theo <i class="fas fa-arrow-right"></i></button>
        </div>
    </div>
</div>

<!-- ====== QUICK REGISTER CUSTOMER MODAL (Hình 7) ====== -->
<div class="pos-modal-overlay" id="quickRegOverlay">
    <div class="shift-modal" style="width: 360px;">
        <h5 style="text-align: center; font-weight: 800; margin-bottom: 12px;">Đăng Ký Nhanh Hội Viên</h5>
        <div class="mb-3">
            <label class="form-label" style="font-size:12px;font-weight:600;">Số điện thoại</label>
            <input type="text" id="quickRegPhone" class="form-control" disabled style="background:#f1f5f9;cursor:not-allowed;font-weight:600;text-align:center;border-radius:10px;">
        </div>
        <div class="mb-3">
            <label class="form-label" style="font-size:12px;font-weight:600;">Họ và tên <span class="text-danger">*</span></label>
            <input type="text" id="quickRegName" class="form-control" placeholder="Nhập tên khách hàng" required style="border-radius:10px;">
        </div>
        <div class="mb-3">
            <label class="form-label" style="font-size:12px;font-weight:600;">Ngày sinh (Tùy chọn)</label>
            <input type="date" id="quickRegDob" class="form-control" style="border-radius:10px;">
        </div>
        <div style="display:flex;gap:10px;margin-top:16px;">
            <button class="btn-pin-cancel" onclick="closeQuickRegModal()" style="flex:1;">Hủy</button>
            <button class="btn-checkout" onclick="submitQuickRegister()" style="flex:1;box-shadow:none;border-radius:10px;">Xác nhận tạo</button>
        </div>
    </div>
</div>

</div><!-- /.pos-wrapper -->

@section Scripts {
<script src="~/js/pos-app.js"></script>
}
