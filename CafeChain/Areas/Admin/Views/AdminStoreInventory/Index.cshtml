@model CafeChain.ViewModels.Admin.StoreInventories.InventoryIndexVM
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<InventoryResource> L

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/StoreInventory/storeinventory.css" asp-append-version="true" />
}

@{
    var isPreparedItems = Model.ActiveTab == CafeChain.Application.DTOs.Admin.StoreInventories.InventoryCatalogTypes.PreparedItems;
    ViewData["Title"] = L["StoreInventory.Title"];
}

<main class="inventory-container cc-page cc-warehouse-page">

    <header class="inventory-header cc-page-header cc-warehouse-header">
        <div>
            <p class="cc-page-kicker">@L["Common.InventorySupply"]</p>
            <h1 class="cc-page-title"><i class="fa-solid fa-boxes-stacked me-2 text-warning" aria-hidden="true"></i> @L["StoreInventory.Title"]</h1>
            <p class="inventory-subtitle cc-page-description">
                @L["StoreInventory.Subtitle"]
            </p>
        </div>

        <div class="header-actions cc-warehouse-actions">
            <form method="get" class="search-form">
                <label class="visually-hidden" for="inventorySearch">@L["StoreInventory.SearchAria"]</label>
                <div class="inventory-search-field">
                    <i class="fas fa-search inventory-search-icon" aria-hidden="true"></i>
                    <input type="text"
                           id="inventorySearch"
                           name="search"
                           value="@Model.Search"
                           placeholder="@(isPreparedItems ? L["StoreInventory.SearchPrepared"] : L["StoreInventory.SearchIngredient"])" />
                </div>

                <input type="hidden"
                       name="storeId"
                       value="@Model.StoreId" />

                <input type="hidden"
                       name="inventoryType"
                       value="@Model.ActiveTab" />

                <button type="submit" class="cc-button cc-button-primary"><i class="fas fa-search me-1" aria-hidden="true"></i> @L["Common.Search"]</button>
            </form>
        </div>
    </header>

    @await Html.PartialAsync("Partials/_StoreTabsPartial", Model)

    <nav class="inventory-kind-tabs" aria-label="@L["StoreInventory.TypeAria"]">
        <a class="inventory-kind-tab @(!isPreparedItems ? "active" : "")"
           href="@Url.Action("Index", "AdminStoreInventory", new { area = "Admin", storeId = Model.StoreId, inventoryType = "ingredients", search = Model.Search, page = 1 })">
            @L["Common.Ingredients"]
        </a>
        <a class="inventory-kind-tab @(isPreparedItems ? "active" : "")"
           href="@Url.Action("Index", "AdminStoreInventory", new { area = "Admin", storeId = Model.StoreId, inventoryType = "prepared-items", search = Model.Search, page = 1 })">
            @L["Common.PreparedItems"]
        </a>
    </nav>

    <div class="inventory-result-meta">
        @L[isPreparedItems ? "StoreInventory.PreparedCount" : "StoreInventory.IngredientCount", Model.TotalCount]
    </div>

    @await Html.PartialAsync("Partials/_InventoryTablePartial", Model)

    @await Html.PartialAsync("Partials/_PaginationPartial", Model)

</main>

@await Html.PartialAsync("Partials/_TransactionModalPartial")

@section Scripts {
    <script src="~/js/Admin/StoreInventory/storeinventory.js" asp-append-version="true"></script>
}
