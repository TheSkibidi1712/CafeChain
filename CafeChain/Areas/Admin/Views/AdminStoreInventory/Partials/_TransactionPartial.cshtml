@model List<CafeChain.ViewModels.Admin.StoreInventories.InventoryTransactionVM>

@using CafeChain.Application.Interfaces.Systems
@using CafeChain.ViewModels.Admin.StoreInventories
@inject IBusinessDateService BusinessDateService

@{
    var currentStoreId = ViewBag.StoreId != null
        ? (int)ViewBag.StoreId
        : 0;

    var storeTabs = ViewBag.StoreTabs as List<InventoryStoreTabVM>
        ?? new List<InventoryStoreTabVM>();
}

<div class="store-tabs modal-store-tabs">

    @foreach (var store in storeTabs)
    {
        <button type="button"
                class="store-tab @(store.StoreId == currentStoreId ? "active" : "")"
                onclick="loadTransactionPage(1, @store.StoreId)">
            @store.StoreName
        </button>
    }

</div>

<table class="transaction-table">
    <thead>
        <tr>
            <th>Kho</th>
            <th>Mặt hàng</th>
            <th>Loại</th>
            <th>Nguồn</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Tổng tiền</th>
            <th>Trước</th>
            <th>Sau</th>
            <th>Ngày</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.StoreName</td>

                    <td>
                        @item.IngredientName
                        @if (!string.IsNullOrWhiteSpace(item.IdentityBadge))
                        {
                            <small class="text-muted d-block">@item.IdentityBadge</small>
                        }
                        @if (item.QuantitySemanticsStatus == "QUANTITY_SEMANTICS_UNKNOWN")
                        {
                            <small class="text-warning d-block">Chưa xác nhận đơn vị tồn</small>
                        }
                    </td>

                    <td>
                        <span title="@item.StockStatusName">
                            @item.TypeName
                        </span>
                    </td>

                    <td>@item.ReferenceType</td>

                    <td>
                        @if (item.Quantity > 0)
                        {
                            <span class="plus">
                                +@($"{item.Quantity:N0} {item.UnitCode}")
                            </span>
                        }
                        else if (item.Quantity < 0)
                        {
                            <span class="minus">
                                @($"{item.Quantity:N0} {item.UnitCode}")
                            </span>
                        }
                        else
                        {
                            <span>@($"{item.Quantity:N0} {item.UnitCode}")</span>
                        }
                    </td>

                    <td>
                        @if (item.UnitPrice.HasValue)
                        {
                            @($"{item.UnitPrice:N0} đ")
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>

                    <td>
                        @if (item.TotalAmount.HasValue)
                        {
                            @($"{item.TotalAmount:N0} đ")
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>

                    <td>
                        @($"{item.BeforeQty:N0} {item.UnitCode}")
                    </td>

                    <td>
                        @($"{item.AfterQty:N0} {item.UnitCode}")
                    </td>

                    <td>
                        @BusinessDateService.ToBusinessTime(item.CreatedAt).ToString("dd/MM/yyyy HH:mm")
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="10" class="empty-data">
                    <div class="cc-empty-state cc-warehouse-empty" role="status">
                        <h2>Chưa có giao dịch tồn kho</h2>
                        <p>Chưa phát sinh nhập, xuất hoặc điều chỉnh kho trong phạm vi đang chọn.</p>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@{
    var currentPage = ViewBag.Page != null ? (int)ViewBag.Page : 1;
    var totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 0;
}

@if (totalPages > 1)
{
    <div class="pagination">

        @if (currentPage > 1)
        {
            <button type="button"
                    class="page-btn"
                    onclick="loadTransactionPage(@(currentPage - 1), @currentStoreId)">
                ←
            </button>
        }

        @for (int i = 1; i <= totalPages; i++)
        {
            <button type="button"
                    class="page-btn @(i == currentPage ? "active" : "")"
                    onclick="loadTransactionPage(@i, @currentStoreId)">
                @i
            </button>
        }

        @if (currentPage < totalPages)
        {
            <button type="button"
                    class="page-btn"
                    onclick="loadTransactionPage(@(currentPage + 1), @currentStoreId)">
                →
            </button>
        }

    </div>
}
