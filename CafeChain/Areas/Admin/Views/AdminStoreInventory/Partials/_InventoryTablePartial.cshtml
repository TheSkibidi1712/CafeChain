@model CafeChain.ViewModels.Admin.StoreInventories.InventoryIndexVM
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<InventoryResource> L
@{
    var isPreparedItems = Model.ActiveTab == CafeChain.Application.DTOs.Admin.StoreInventories.InventoryCatalogTypes.PreparedItems;
}

<div class="inventory-table-wrap cc-warehouse-table-shell">
    <table class="inventory-table @(isPreparedItems ? "prepared-item-table" : "ingredient-table")">
        <thead>
            <tr>
                <th>@L[isPreparedItems ? "StoreInventory.PreparedCode" : "StoreInventory.IngredientCode"]</th>
                <th>@L[isPreparedItems ? "Common.PreparedItem" : "Common.Ingredient"]</th>
                <th>@L["Common.Unit"]</th>
                <th title="@L["StoreInventory.OnHandTitle"]">@L["Common.OnHand"]</th>
                <th title="@L["StoreInventory.ReservedTitle"]">@L["Common.Reserved"]</th>
                <th title="@L["StoreInventory.AvailableTitle"]">@L["Common.Available"]</th>
                @if (isPreparedItems)
                {
                    <th class="inventory-secondary">@L["StoreInventory.ActualCost"]</th>
                    <th class="inventory-secondary">@L["StoreInventory.LatestSource"]</th>
                }
                else
                {
                    <th class="inventory-secondary">@L["StoreInventory.LatestPurchasePrice"]</th>
                    <th class="inventory-secondary">@L["StoreInventory.LatestSupplier"]</th>
                }
                <th class="inventory-secondary">@L["Common.Updated"]</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Items.Any())
            {
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="item-code">@(string.IsNullOrWhiteSpace(item.ItemCode) ? "—" : item.ItemCode)</td>
                        <td class="ingredient-name">
                            <div>@item.IngredientName</div>
                            @if (isPreparedItems)
                            {
                                <span class="inventory-identity-badge">@item.IdentityBadge</span>
                                @if (item.QuantitySemanticsStatus == "QUANTITY_SEMANTICS_UNKNOWN")
                                {
                                    <small class="inventory-warning d-block">@L["StoreInventory.QuantityUnknown"]</small>
                                }
                            }
                        </td>
                        <td class="unit-code">@(string.IsNullOrWhiteSpace(item.UnitCode) ? "—" : item.UnitCode)</td>
                        <td class="stock">@($"{item.AvailableQty:N2} {item.UnitCode}")</td>
                        <td class="reserved @(item.ReservedQty > 0 ? "highlight" : "")">
                            @($"{item.ReservedQty:N2} {item.UnitCode}")
                        </td>
                        <td class="usable @(item.UsableQty <= 0 ? "danger" : "")">
                            @($"{item.UsableQty:N2} {item.UnitCode}")
                        </td>
                        @if (isPreparedItems)
                        {
                            <td class="inventory-secondary">
                                @if (item.CostEvidenceStatus == "ACTUAL_LAYER" && item.LastUnitPrice.HasValue)
                                {
                                    <div class="cost-value">@item.LastUnitPrice.Value.ToString("N2") @L["Common.Currency"]/@item.UnitCode</div>
                                    <small class="text-muted">@L["StoreInventory.CostLayer", item.LatestCostLayerId]</small>
                                }
                                else
                                {
                                    <span class="cost-missing">@L["StoreInventory.NoFifoLayer"]</span>
                                }
                            </td>
                            <td class="inventory-secondary">
                                @if (item.SourceProductionRunId.HasValue)
                                {
                                    <div>@L["StoreInventory.ProductionRun", item.SourceProductionRunId]</div>
                                    <small class="text-muted">@(item.LatestCostLayerAt?.ToString("dd/MM/yyyy HH:mm"))</small>
                                }
                                else if (item.LatestCostLayerId.HasValue)
                                {
                                    <span>@L["StoreInventory.InventoryCostLayer", item.LatestCostLayerId]</span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                        }
                        else
                        {
                            <td class="inventory-secondary">
                                @(item.LastUnitPrice.HasValue ? $"{item.LastUnitPrice:N0} {L["Common.Currency"]}" : "—")
                            </td>
                            <td class="inventory-secondary">
                                @(!string.IsNullOrWhiteSpace(item.LastSupplierName) ? item.LastSupplierName : "—")
                            </td>
                        }
                        <td class="inventory-secondary">@item.LastUpdated.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="empty-data">
                        <div class="cc-empty-state cc-warehouse-empty" role="status">
                            <h2>@L[isPreparedItems ? "StoreInventory.EmptyPreparedTitle" : "StoreInventory.EmptyIngredientTitle"]</h2>
                            <p>@L[isPreparedItems ? "StoreInventory.EmptyPreparedCopy" : "StoreInventory.EmptyIngredientCopy"]</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
