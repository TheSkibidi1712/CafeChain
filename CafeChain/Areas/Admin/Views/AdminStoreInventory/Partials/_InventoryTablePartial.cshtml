@model CafeChain.ViewModels.Admin.StoreInventories.InventoryIndexVM
@{
    var isPreparedItems = Model.ActiveTab == CafeChain.Application.DTOs.Admin.StoreInventories.InventoryCatalogTypes.PreparedItems;
}

<div class="inventory-table-wrap cc-warehouse-table-shell">
    <table class="inventory-table @(isPreparedItems ? "prepared-item-table" : "ingredient-table")">
        <thead>
            <tr>
                <th>@(isPreparedItems ? "Mã BTP" : "Mã NL")</th>
                <th>@(isPreparedItems ? "Bán thành phẩm" : "Nguyên liệu")</th>
                <th>ĐVT</th>
                <th title="Tổng số lượng trong kho">Tồn kho</th>
                <th title="Số lượng đã được giữ cho đơn hàng / phiếu">Đang giữ</th>
                <th title="Số lượng có thể sử dụng ngay">Khả dụng</th>
                @if (isPreparedItems)
                {
                    <th class="inventory-secondary">Giá vốn thực tế</th>
                    <th class="inventory-secondary">Nguồn gần nhất</th>
                }
                else
                {
                    <th class="inventory-secondary">Giá nhập gần nhất</th>
                    <th class="inventory-secondary">NCC</th>
                }
                <th class="inventory-secondary">Cập nhật</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Items.Any())
            {
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="item-code">@(string.IsNullOrWhiteSpace(item.ItemCode) ? "—" : item.ItemCode)</td>
                        <td class="ingredient-name">
                            <div>@item.IngredientName</div>
                            @if (isPreparedItems)
                            {
                                <span class="inventory-identity-badge">@item.IdentityBadge</span>
                                @if (item.LegacyRecipeId.HasValue)
                                {
                                    <small class="inventory-warning d-block">
                                        Dữ liệu công thức cũ #@item.LegacyRecipeId; bán thành phẩm vẫn là định danh tồn kho chính.
                                    </small>
                                }
                                @if (item.QuantitySemanticsStatus == "QUANTITY_SEMANTICS_UNKNOWN")
                                {
                                    <small class="inventory-warning d-block">Chưa xác nhận số lượng theo đơn vị tồn kho.</small>
                                }
                            }
                        </td>
                        <td class="unit-code">@(string.IsNullOrWhiteSpace(item.UnitCode) ? "—" : item.UnitCode)</td>
                        <td class="stock">@($"{item.AvailableQty:N2} {item.UnitCode}")</td>
                        <td class="reserved @(item.ReservedQty > 0 ? "highlight" : "")">
                            @($"{item.ReservedQty:N2} {item.UnitCode}")
                        </td>
                        <td class="usable @(item.UsableQty <= 0 ? "danger" : "")">
                            @($"{item.UsableQty:N2} {item.UnitCode}")
                        </td>
                        @if (isPreparedItems)
                        {
                            <td class="inventory-secondary">
                                @if (item.CostEvidenceStatus == "ACTUAL_LAYER" && item.LastUnitPrice.HasValue)
                                {
                                    <div class="cost-value">@item.LastUnitPrice.Value.ToString("N2") đ/@item.UnitCode</div>
                                    <small class="text-muted">Lô giá #@item.LatestCostLayerId</small>
                                }
                                else
                                {
                                    <span class="cost-missing">Chưa có lớp giá FIFO</span>
                                }
                            </td>
                            <td class="inventory-secondary">
                                @if (item.SourceProductionRunId.HasValue)
                                {
                                    <div>Lệnh sơ chế #@item.SourceProductionRunId</div>
                                    <small class="text-muted">@(item.LatestCostLayerAt?.ToString("dd/MM/yyyy HH:mm"))</small>
                                }
                                else if (item.LatestCostLayerId.HasValue)
                                {
                                    <span>Lô giá kho #@item.LatestCostLayerId</span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                        }
                        else
                        {
                            <td class="inventory-secondary">
                                @(item.LastUnitPrice.HasValue ? $"{item.LastUnitPrice:N0} đ" : "—")
                            </td>
                            <td class="inventory-secondary">
                                @(!string.IsNullOrWhiteSpace(item.LastSupplierName) ? item.LastSupplierName : "—")
                            </td>
                        }
                        <td class="inventory-secondary">@item.LastUpdated.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="empty-data">
                        <div class="cc-empty-state cc-warehouse-empty" role="status">
                            <h2>@(isPreparedItems ? "Chưa có bán thành phẩm" : "Không tìm thấy nguyên liệu")</h2>
                            <p>@(isPreparedItems
                                ? "Bán thành phẩm chỉ xuất hiện sau khi lệnh sản xuất hoàn tất và ghi tăng tồn kho."
                                : "Hãy kiểm tra lại từ khóa, loại tồn kho hoặc chi nhánh đang chọn.")</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
