@model CafeChain.ViewModels.Admin.StoreInventories.InventoryIndexVM

@{
    var currentPage = Model.Page;
    var totalPages = Model.TotalPages;
}

@if (totalPages > 1)
{
    <div class="pagination">

        @if (currentPage > 1)
        {
            <a class="page-btn"
               href="@Url.Action("Index", "AdminStoreInventory", new { area = "Admin", storeId = Model.StoreId, inventoryType = Model.ActiveTab, search = Model.Search, page = currentPage - 1 })">
                ←
            </a>
        }

        @for (int i = 1; i <= totalPages; i++)
        {
            <a class="page-btn @(i == currentPage ? "active" : "")"
               href="@Url.Action("Index", "AdminStoreInventory", new { area = "Admin", storeId = Model.StoreId, inventoryType = Model.ActiveTab, search = Model.Search, page = i })">
                @i
            </a>
        }

        @if (currentPage < totalPages)
        {
            <a class="page-btn"
               href="@Url.Action("Index", "AdminStoreInventory", new { area = "Admin", storeId = Model.StoreId, inventoryType = Model.ActiveTab, search = Model.Search, page = currentPage + 1 })">
                →
            </a>
        }

    </div>
}
