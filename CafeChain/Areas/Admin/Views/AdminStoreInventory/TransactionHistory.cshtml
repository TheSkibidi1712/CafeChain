@model CafeChain.ViewModels.Admin.StoreInventories.InventoryTransactionHistoryVM
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<InventoryResource> L

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/StoreInventory/transaction-history.css" asp-append-version="true" />
}

@{
    var currentStoreName = Model.Stores.FirstOrDefault(x => x.StoreId == Model.StoreId)?.StoreName ?? L["StoreInventory.Transaction.FallbackStore"].Value;
}

<main class="txn-history-page cc-warehouse-page">

    <header class="ice-page-header cc-warehouse-header">
        <div>
            <div class="ice-eyebrow">@L["Common.InventorySupply"]</div>
            <h1><i class="fa-solid fa-clock-rotate-left me-2 text-warning" aria-hidden="true"></i>@L["StoreInventory.Transaction.Title"]</h1>
            <p>@Html.Raw(L["StoreInventory.Transaction.Subtitle", currentStoreName].Value)</p>
        </div>
    </header>

    @* ── Store Tabs ── *@
    <div class="txn-history-store-tabs">
        @foreach (var store in Model.Stores)
        {
            <a class="txn-history-store-tab @(store.StoreId == Model.StoreId ? "active" : "")"
               href="@Url.Action("TransactionHistory", "AdminStoreInventory", new { area = "Admin", storeId = store.StoreId, page = 1 })">
                @store.StoreName
            </a>
        }
    </div>

    <div class="txn-history-filter-bar d-flex align-items-center justify-content-between gap-3 mb-3 p-3 bg-white border rounded-3 shadow-sm" style="margin-top: 15px;">
        <div class="d-flex align-items-center gap-2">
            <span class="text-secondary fw-semibold small">@L["StoreInventory.Transaction.ItemTypeLabel"]</span>
            <div class="d-inline-flex gap-2" role="group" aria-label="@L["StoreInventory.Transaction.FilterAria"]">
                <button type="button" class="btn btn-outline-secondary btn-sm active" data-filter-type="all">@L["StoreInventory.Transaction.All"]</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-filter-type="raw">@L["StoreInventory.Transaction.RawIngredient"]</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-filter-type="btp">@L["Common.PreparedItems"] (BTP)</button>
            </div>
        </div>
        <div class="position-relative flex-grow-1" style="max-width: 320px;">
            <i class="fa-solid fa-magnifying-glass position-absolute top-50 translate-middle-y text-muted" style="left: 12px; z-index: 5;"></i>
            <input type="text" id="txnItemSearch" class="form-control form-control-sm" placeholder="@L["StoreInventory.Transaction.SearchPlaceholder"]" style="padding-left: 32px !important; border-radius: 8px;" />
        </div>
    </div>

    <div class="txn-history-result-meta">
        @Html.Raw(L["StoreInventory.Transaction.ResultMeta", Model.TotalCount].Value)
    </div>

    @* ── Transactions Table ── *@
    <div class="txn-history-table-wrap">
        <table class="txn-history-table">
            <thead>
                <tr>
                    <th>@L["StoreInventory.Transaction.Col.Store"]</th><th>@L["StoreInventory.Transaction.Col.Item"]</th><th>@L["StoreInventory.Transaction.Col.Type"]</th><th>@L["StoreInventory.Transaction.Col.Source"]</th><th>@L["StoreInventory.Transaction.Col.Quantity"]</th><th>@L["StoreInventory.Transaction.Col.UnitPrice"]</th><th>@L["StoreInventory.Transaction.Col.Total"]</th><th>@L["StoreInventory.Transaction.Col.Before"]</th><th>@L["StoreInventory.Transaction.Col.After"]</th><th>@L["StoreInventory.Transaction.Col.Date"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items != null && Model.Items.Any())
                {
                    @inject CafeChain.Application.Interfaces.Systems.IBusinessDateService BusinessDateService
                    foreach (var item in Model.Items)
                    {
                        <tr data-timestamp="@item.CreatedAt.Ticks">
                            <td>@item.StoreName</td>
                            <td>
                                <strong>@item.IngredientName</strong>
                                @if (!string.IsNullOrWhiteSpace(item.IdentityBadge))
                                {
                                    <small class="text-muted d-block">@item.IdentityBadge</small>
                                }
                                @if (item.QuantitySemanticsStatus == "QUANTITY_SEMANTICS_UNKNOWN")
                                {
                                    <small class="text-warning d-block">@L["StoreInventory.Transaction.UnitUnconfirmed"]</small>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border" title="@item.StockStatusName">
                                    @item.TypeName
                                </span>
                            </td>
                            <td>@item.ReferenceType</td>
                            <td>
                                @if (item.Quantity > 0)
                                {
                                    <span class="plus">+@($"{item.Quantity:N0} {item.UnitCode}")</span>
                                }
                                else if (item.Quantity < 0)
                                {
                                    <span class="minus">@($"{item.Quantity:N0} {item.UnitCode}")</span>
                                }
                                else
                                {
                                    <span>@($"{item.Quantity:N0} {item.UnitCode}")</span>
                                }
                            </td>
                            <td>
                                @if (item.UnitPrice.HasValue)
                                {
                                    @($"{item.UnitPrice:N0} đ")
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td>
                                @if (item.TotalAmount.HasValue)
                                {
                                    @($"{item.TotalAmount:N0} đ")
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td>@($"{item.BeforeQty:N0} {item.UnitCode}")</td>
                            <td>@($"{item.AfterQty:N0} {item.UnitCode}")</td>
                            <td>
                                @BusinessDateService.ToBusinessTime(item.CreatedAt).ToString("dd/MM/yyyy HH:mm")
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="empty-data">
                            <div class="txn-history-empty" role="status">
                                <i class="fas fa-inbox" aria-hidden="true"></i>
                                <h2>@L["StoreInventory.Transaction.EmptyTitle"]</h2>
                                <p>@L["StoreInventory.Transaction.EmptyCopy"]</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ── Sliding Window Pagination ── *@
    @{
        var currentPage = Model.Page;
        var totalPages = Model.TotalPages;

        var pages = new List<int?>();

        if (totalPages <= 8)
        {
            for (int i = 1; i <= totalPages; i++)
            {
                pages.Add(i);
            }
        }
        else
        {
            // Always show first 3 pages
            pages.Add(1);
            pages.Add(2);
            pages.Add(3);

            if (currentPage > 3 && currentPage < totalPages - 2)
            {
                if (currentPage > 4)
                {
                    pages.Add(null); // ellipsis
                }

                for (int i = currentPage - 1; i <= currentPage + 1; i++)
                {
                    if (!pages.Contains(i))
                    {
                        pages.Add(i);
                    }
                }
            }

            var lastStart = totalPages - 2;
            var lastPageInList = pages.LastOrDefault(x => x.HasValue) ?? 0;
            if (lastStart - lastPageInList > 1)
            {
                pages.Add(null); // ellipsis
            }
            else if (lastStart - lastPageInList == 1)
            {
                pages.Add(lastStart - 1);
            }

            // Always show last 3 pages
            for (int i = totalPages - 2; i <= totalPages; i++)
            {
                if (!pages.Contains(i))
                {
                    pages.Add(i);
                }
            }
        }
    }

    <nav class="txn-history-pagination" aria-label="@L["StoreInventory.Transaction.PaginationAria"]" style="@(totalPages <= 1 ? "display: none;" : "")">
        @if (currentPage > 1)
        {
            <a class="txn-history-page-btn"
               aria-label="@L["Common.PreviousPage"]"
               href="@Url.Action("TransactionHistory", "AdminStoreInventory", new { area = "Admin", storeId = Model.StoreId, page = currentPage - 1 })">
                <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
            </a>
        }

        @foreach (var p in pages)
        {
            if (p.HasValue)
            {
                <a class="txn-history-page-btn @(p.Value == currentPage ? "active" : "")"
                   aria-label="@L["Common.Page", p.Value]"
                   aria-current="@(p.Value == currentPage ? "page" : null)"
                   href="@Url.Action("TransactionHistory", "AdminStoreInventory", new { area = "Admin", storeId = Model.StoreId, page = p.Value })">
                    @p.Value
                </a>
            }
            else
            {
                <span class="txn-history-page-ellipsis">...</span>
            }
        }

        @if (currentPage < totalPages)
        {
            <a class="txn-history-page-btn"
               aria-label="@L["Common.NextPage"]"
               href="@Url.Action("TransactionHistory", "AdminStoreInventory", new { area = "Admin", storeId = Model.StoreId, page = currentPage + 1 })">
                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
            </a>
        }
    </nav>

</main>

@section Scripts {
    <script>
        const transactionTexts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
            empty = L["StoreInventory.Transaction.Js.EmptyFilter"].Value,
            loading = L["StoreInventory.Transaction.Js.LoadingMore"].Value,
            result = L["StoreInventory.Transaction.Js.ResultMeta"].Value
        }));
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('txnItemSearch');
            const filterButtons = document.querySelectorAll('[data-filter-type]');
            const resultMeta = document.querySelector('.txn-history-result-meta');
            const tableBody = document.querySelector('.txn-history-table tbody');

            // Load server-rendered data
            const storeId = @Model.StoreId;
            const serverCurrentPage = @Model.Page;
            const serverTotalPages = @Model.TotalPages;
            const baseUrl = '@Url.Action("TransactionHistory", "AdminStoreInventory", new { area = "Admin" })';

            let currentSearch = '';
            let currentType = 'all'; // 'all', 'raw', 'btp'
            let currentPageIndex = 1;
            let loadedPagesCount = 1;

            // Load initial page rows into client memory
            const initialRows = Array.from(tableBody.querySelectorAll('tr:not(#txnEmptyRow)'));
            let allRows = [...initialRows];

            // Create empty state row
            const emptyRow = document.createElement('tr');
            emptyRow.id = 'txnEmptyRow';
            emptyRow.style.display = 'none';
            emptyRow.innerHTML = `
                <td colspan="10" class="text-center py-5 text-muted">
                    <i class="fa-solid fa-box-open d-block mb-3 fs-3 text-warning"></i>
                    <span>${transactionTexts.empty}</span>
                </td>
            `;
            tableBody.appendChild(emptyRow);

            // Add background loading indicator to result meta
            const loadingIndicator = document.createElement('span');
            loadingIndicator.className = 'ms-2 text-muted small';
            loadingIndicator.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin text-warning me-1"></i>' + transactionTexts.loading;
            if (resultMeta && serverTotalPages > 1) {
                resultMeta.appendChild(loadingIndicator);
            }

            function updateDisplay() {
                let filteredRows = [];

                allRows.forEach(row => {
                    if (row.id === 'txnEmptyRow') return;

                    const itemNameEl = row.querySelector('td:nth-child(2) strong');
                    const badgeEl = row.querySelector('td:nth-child(2) small');

                    const itemName = itemNameEl ? itemNameEl.textContent.toLowerCase() : '';
                    const isBtp = badgeEl ? badgeEl.textContent.includes('BTP') : false;

                    // Match search text
                    const matchesSearch = itemName.includes(currentSearch);

                    // Match type
                    let matchesType = false;
                    if (currentType === 'all') {
                        matchesType = true;
                    } else if (currentType === 'btp') {
                        matchesType = isBtp;
                    } else if (currentType === 'raw') {
                        matchesType = !isBtp;
                    }

                    if (matchesSearch && matchesType) {
                        filteredRows.push(row);
                    }
                });

                // Sort rows descending (newest first)
                filteredRows.sort((a, b) => {
                    const valA = parseInt(a.getAttribute('data-timestamp') || '0', 10);
                    const valB = parseInt(b.getAttribute('data-timestamp') || '0', 10);
                    return valB - valA;
                });

                const totalItems = filteredRows.length;
                const itemsPerPage = 10;
                const totalPages = Math.ceil(totalItems / itemsPerPage);

                // Adjust current page index if it goes out of range
                if (currentPageIndex > totalPages) {
                    currentPageIndex = totalPages > 0 ? totalPages : 1;
                }
                if (currentPageIndex < 1) currentPageIndex = 1;

                // Clear current table body rows (except empty row)
                const existingRows = tableBody.querySelectorAll('tr:not(#txnEmptyRow)');
                existingRows.forEach(row => row.remove());

                // Crop items for the current page
                const startIdx = (currentPageIndex - 1) * itemsPerPage;
                const endIdx = startIdx + itemsPerPage;
                const pageRows = filteredRows.slice(startIdx, endIdx);

                // Append the rows to tableBody
                pageRows.forEach(row => {
                    row.style.display = '';
                    tableBody.insertBefore(row, emptyRow);
                });

                // Handle empty state row
                if (totalItems === 0) {
                    emptyRow.style.display = '';
                } else {
                    emptyRow.style.display = 'none';
                }

                // Update search counter description
                if (resultMeta) {
                    resultMeta.innerHTML = transactionTexts.result.replace('{0}', pageRows.length).replace('{1}', totalItems);
                    if (loadedPagesCount < serverTotalPages) {
                        resultMeta.appendChild(loadingIndicator);
                    }
                }

                // Render pagination links
                renderPagination(currentPageIndex, totalPages);
            }

            function renderPagination(currentPage, totalPages) {
                const paginationNav = document.querySelector('.txn-history-pagination');
                if (!paginationNav) return;

                if (totalPages <= 1) {
                    paginationNav.style.display = 'none';
                    return;
                }

                paginationNav.style.display = '';
                paginationNav.innerHTML = '';

                // Prev button
                if (currentPage > 1) {
                    const prevBtn = document.createElement('a');
                    prevBtn.className = 'txn-history-page-btn';
                    prevBtn.innerHTML = '<i class="fa-solid fa-chevron-left" aria-hidden="true"></i>';
                    prevBtn.href = '#';
                    prevBtn.addEventListener('click', function (e) {
                        e.preventDefault();
                        currentPageIndex = currentPage - 1;
                        updateDisplay();
                    });
                    paginationNav.appendChild(prevBtn);
                }

                const pages = [];
                if (totalPages <= 8) {
                    for (let i = 1; i <= totalPages; i++) {
                        pages.push(i);
                    }
                } else {
                    // Always show first 3 pages
                    pages.push(1, 2, 3);

                    if (currentPage > 3 && currentPage < totalPages - 2) {
                        if (currentPage > 4) {
                            pages.push(null); // ellipsis
                        }
                        for (let i = currentPage - 1; i <= currentPage + 1; i++) {
                            if (!pages.includes(i)) {
                                pages.push(i);
                            }
                        }
                    }

                    const lastPageInList = pages.filter(x => x !== null).pop() || 0;
                    const lastStart = totalPages - 2;
                    if (lastStart - lastPageInList > 1) {
                        pages.push(null);
                    } else if (lastStart - lastPageInList === 1) {
                        pages.push(lastStart - 1);
                    }

                    // Always show last 3 pages
                    for (let i = totalPages - 2; i <= totalPages; i++) {
                        if (!pages.includes(i)) {
                            pages.push(i);
                        }
                    }
                }

                pages.forEach(p => {
                    if (p === null) {
                        const ellipsis = document.createElement('span');
                        ellipsis.className = 'txn-history-page-ellipsis';
                        ellipsis.textContent = '...';
                        paginationNav.appendChild(ellipsis);
                    } else {
                        const pageBtn = document.createElement('a');
                        pageBtn.className = `txn-history-page-btn ${p === currentPage ? 'active' : ''}`;
                        pageBtn.textContent = p;
                        pageBtn.href = '#';
                        if (p === currentPage) {
                            pageBtn.setAttribute('aria-current', 'page');
                        }
                        pageBtn.addEventListener('click', function (e) {
                            e.preventDefault();
                            currentPageIndex = p;
                            updateDisplay();
                        });
                        paginationNav.appendChild(pageBtn);
                    }
                });

                // Next button
                if (currentPage < totalPages) {
                    const nextBtn = document.createElement('a');
                    nextBtn.className = 'txn-history-page-btn';
                    nextBtn.innerHTML = '<i class="fa-solid fa-chevron-right" aria-hidden="true"></i>';
                    nextBtn.href = '#';
                    nextBtn.addEventListener('click', function (e) {
                        e.preventDefault();
                        currentPageIndex = currentPage + 1;
                        updateDisplay();
                    });
                    paginationNav.appendChild(nextBtn);
                }
            }

            // Background prefetching of remaining pages
            async function prefetchNextPages() {
                for (let p = 1; p <= serverTotalPages; p++) {
                    if (p === serverCurrentPage) continue;
                    try {
                        const response = await fetch(`${baseUrl}?storeId=${storeId}&page=${p}`);
                        if (!response.ok) continue;
                        const htmlText = await response.text();
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(htmlText, 'text/html');
                        const rows = doc.querySelectorAll('.txn-history-table tbody tr');

                        rows.forEach(row => {
                            if (row.id !== 'txnEmptyRow' && !row.querySelector('.txn-history-empty')) {
                                allRows.push(row);
                            }
                        });

                        loadedPagesCount++;
                        updateDisplay();
                    } catch (err) {
                        console.error('Error prefetching page ' + p, err);
                    }
                }

                // Remove loading indicator when done
                if (loadingIndicator) {
                    loadingIndicator.remove();
                }
            }

            // Initialize display
            updateDisplay();

            // Start prefetching if there are other pages
            if (serverTotalPages > 1) {
                prefetchNextPages();
            }

            // Bind search input events
            if (searchInput) {
                searchInput.addEventListener('input', function (e) {
                    currentSearch = e.target.value.toLowerCase().trim();
                    currentPageIndex = 1;
                    updateDisplay();
                });
            }

            // Bind filter button click events
            filterButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    filterButtons.forEach(b => {
                        b.classList.remove('active', 'btn-primary', 'category-primary-btn');
                        b.classList.add('btn-outline-secondary');
                    });

                    btn.classList.remove('btn-outline-secondary');
                    btn.classList.add('active', 'btn-primary', 'category-primary-btn');

                    currentType = btn.getAttribute('data-filter-type');
                    currentPageIndex = 1;
                    updateDisplay();
                });
            });

            // Set initially active button styling
            const initialActive = document.querySelector('[data-filter-type="all"]');
            if (initialActive) {
                initialActive.classList.remove('btn-outline-secondary');
                initialActive.classList.add('active', 'btn-primary', 'category-primary-btn');
            }
        });
    </script>
}
