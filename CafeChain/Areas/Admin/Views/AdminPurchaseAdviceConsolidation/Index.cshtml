@using CafeChain.Application.Constants
@using CafeChain.Application.DTOs.Admin.Procurement
@model PurchaseAdviceConsolidationPageDto
@{
    ViewData["Title"] = "PA chờ tổng hợp";
    var canConsolidate = Model.Actor.RoleNames.Contains(RoleConstants.AccountantWarehouse)
        || Model.Actor.RoleNames.Contains(RoleConstants.BusinessOwner);
    var preview = ViewBag.Preview as PurchaseAdviceConsolidationPreviewDto;
    var selectedIds = ViewBag.SelectedLineIds as int[] ?? Array.Empty<int>();
    var selectedSupplierId = ViewBag.SelectedSupplierId as int?;
}
@section Styles { <link rel="stylesheet" href="~/css/Admin/PurchaseAdvice/purchase-advice.css" asp-append-version="true" /> }

<div class="pa-page">
    <header class="pa-header">
        <div>
            <div class="pa-eyebrow">Kho &amp; Cung ứng / Mua ngoài</div>
            <h1>PA chờ tổng hợp</h1>
            <p class="pa-subtitle">Đối chiếu nhu cầu còn lại với nhà cung cấp và gói mua hiện hành. Bước này chỉ tạo bản xem trước, chưa tạo PO.</p>
        </div>
        <a class="pa-action" asp-controller="AdminPurchaseAdvices" asp-action="Index"><i class="fas fa-arrow-left"></i> Danh sách PA</a>
    </header>

    @if (TempData["Error"] is string error) { <div class="pa-alert">@error</div> }
    @if (ViewBag.PreviewError is string previewError) { <div class="pa-alert">@previewError</div> }

    <form method="get" class="pa-band pa-filter-grid pa-filter-grid-wide">
        <div class="pa-field"><label>Cửa hàng</label><select name="storeId"><option value="">Tất cả</option>@foreach (var item in Model.Stores) { <option value="@item.Id" selected="@(Model.Filter.StoreId == item.Id)">@item.Label</option> }</select></div>
        <div class="pa-field"><label>Khu vực</label><select name="areaId"><option value="">Tất cả</option>@foreach (var item in Model.Areas) { <option value="@item.Id" selected="@(Model.Filter.AreaId == item.Id)">@item.Label</option> }</select></div>
        <div class="pa-field"><label>Trạng thái</label><select name="status"><option value="">SUBMITTED + REVIEW</option><option value="@PurchaseAdviceStatuses.Submitted" selected="@(Model.Filter.Status == PurchaseAdviceStatuses.Submitted)">Đã gửi</option><option value="@PurchaseAdviceStatuses.UnderReview" selected="@(Model.Filter.Status == PurchaseAdviceStatuses.UnderReview)">Đang xem xét</option></select></div>
        <div class="pa-field"><label>Cần trước ngày</label><input type="date" name="neededByDate" value="@Model.Filter.NeededByDate?.ToString("yyyy-MM-dd")" /></div>
        <div class="pa-field"><label>Nguyên liệu</label><select name="ingredientId"><option value="">Tất cả</option>@foreach (var item in Model.Ingredients) { <option value="@item.Id" selected="@(Model.Filter.IngredientId == item.Id)">@item.Label</option> }</select></div>
        <div class="pa-field"><label>Ưu tiên</label><select name="priority"><option value="">Tất cả</option>@foreach (var value in PurchaseAdvicePriorities.All) { <option value="@value" selected="@(Model.Filter.Priority == value)">@value</option> }</select></div>
        <div class="pa-field"><label>NCC tương thích</label><select name="supplierId"><option value="">Tất cả</option>@foreach (var item in Model.Suppliers) { <option value="@item.Id" selected="@(Model.Filter.SupplierId == item.Id)">@item.Label</option> }</select></div>
        <button class="pa-action" type="submit"><i class="fas fa-filter"></i> Lọc</button>
    </form>

    <form asp-action="Preview" method="post" id="consolidation-form">
        @Html.AntiForgeryToken()
        <section class="pa-band pa-actions pa-consolidation-toolbar">
            <div class="pa-field pa-grow">
                <label>Nhà cung cấp cho bản tổng hợp</label>
                <select name="SupplierId" id="supplier-select" required disabled="@(!canConsolidate)">
                    <option value="">Chọn nhà cung cấp</option>
                    @foreach (var item in Model.Suppliers) { <option value="@item.Id" selected="@(selectedSupplierId == item.Id)">@item.Label</option> }
                </select>
            </div>
            <div class="pa-muted">Giá, MOQ, quy đổi và khả năng giao Store sẽ được backend tải lại.</div>
            <button class="pa-action pa-action-primary" type="submit" disabled="@(!canConsolidate)"><i class="fas fa-layer-group"></i> Kiểm tra bản tổng hợp</button>
        </section>

        <div class="pa-table-wrap">
            <table class="pa-table pa-consolidation-table">
                <thead><tr><th>Chọn</th><th>PA / Store</th><th>Nguyên liệu</th><th>Nhu cầu</th><th>Đã phân bổ</th><th>Còn đặt</th><th>Ngày cần</th><th>Offer</th><th>Số kiện</th></tr></thead>
                <tbody>
                @if (Model.Lines.Count == 0) { <tr><td colspan="9" class="pa-empty">Không có PA SUBMITTED/UNDER_REVIEW còn số lượng cần đặt.</td></tr> }
                @for (var i = 0; i < Model.Lines.Count; i++)
                {
                    var line = Model.Lines[i];
                    var offers = Model.Offers.Where(x => x.IngredientId == line.IngredientId && line.CompatibleSupplierIds.Contains(x.SupplierId)).ToList();
                    <tr data-line data-compatible="@string.Join(',', line.CompatibleSupplierIds)">
                        <td><input class="pa-check line-check" type="checkbox" name="selectedLineIds" value="@line.PurchaseAdviceLineId" checked="@(selectedIds.Contains(line.PurchaseAdviceLineId))" disabled="@(!canConsolidate || offers.Count == 0)" /></td>
                        <td><a class="pa-code" asp-controller="AdminPurchaseAdvices" asp-action="Details" asp-route-id="@line.PurchaseAdviceId">@line.AdviceNumber</a><div class="pa-muted">@line.StoreName · Restock #@line.RestockRequestId</div><input type="hidden" name="Lines[@i].PurchaseAdviceLineId" value="@line.PurchaseAdviceLineId" /><input type="hidden" name="Lines[@i].RowVersion" value="@line.RowVersion" /></td>
                        <td><strong>@line.IngredientName</strong><div class="pa-muted">@line.BaseUnitName · @line.Priority</div></td>
                        <td>@line.RequestedPurchaseBaseQuantity.ToString("N3")</td>
                        <td>@line.AllocatedToPoBaseQuantity.ToString("N3")</td>
                        <td><strong>@line.RemainingToOrderBaseQuantity.ToString("N3")</strong></td>
                        <td>@line.NeededByDate.ToString("dd/MM/yyyy")</td>
                        <td><select class="offer-select" name="Lines[@i].IngredientSupplierId" disabled="@(!canConsolidate)"><option value="">Chọn offer</option>@foreach (var offer in offers) { <option value="@offer.IngredientSupplierId" data-supplier="@offer.SupplierId">@offer.SupplierName · @offer.PackageQuantity.ToString("N3") @offer.PackageUnitName · @offer.CurrentPackagePrice.ToString("N0")đ · MOQ @offer.MinimumOrderPackageCount</option> }</select>@if (offers.Count == 0) { <div class="pa-inline-warning">Chưa có offer/NCC phục vụ Store.</div> }</td>
                        <td><input type="number" name="Lines[@i].PackageCount" value="1" min="1" step="1" disabled="@(!canConsolidate)" /></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </form>

    @if (preview != null)
    {
        <section class="pa-band pa-preview">
            <div class="pa-preview-heading"><div><div class="pa-eyebrow">Bản xem trước hợp lệ</div><h2>@preview.SupplierName</h2></div><div class="pa-preview-total">@preview.TotalAmount.ToString("N0") đ</div></div>
            <div class="pa-summary-grid"><div class="pa-kpi"><span>Cửa hàng</span><strong>@preview.StoreCount</strong></div><div class="pa-kpi"><span>Dòng PA</span><strong>@preview.LineCount</strong></div><div class="pa-kpi"><span>Nhóm mua tương thích</span><strong>@preview.Groups.Count</strong></div><div class="pa-kpi"><span>Trạng thái</span><strong>Chưa tạo PO</strong></div></div>
            @foreach (var warning in preview.Warnings) { <div class="pa-inline-warning">@warning</div> }
            @foreach (var group in preview.Groups)
            {
                <div class="pa-preview-group"><div><strong>@group.IngredientName</strong><div class="pa-muted">@group.PackageQuantity.ToString("N3") @group.PackageUnitName/kiện · @group.PackagePriceSnapshot.ToString("N0") đ · @group.PackageCount kiện</div></div><strong>@group.LineTotal.ToString("N0") đ</strong></div>
            }
            <p class="pa-muted">Bản xem trước này không lưu allocation. #186 sẽ khóa/revalidate lại trước khi tạo batch và child PO trong một transaction.</p>
        </section>
    }
</div>

@section Scripts {
<script>
(() => {
    const supplier = document.getElementById('supplier-select');
    if (!supplier) return;
    const syncOffers = () => {
        const supplierId = supplier.value;
        document.querySelectorAll('[data-line]').forEach(row => {
            const select = row.querySelector('.offer-select');
            if (!select) return;
            let first = null;
            Array.from(select.options).forEach(option => {
                if (!option.value) return;
                const visible = !supplierId || option.dataset.supplier === supplierId;
                option.hidden = !visible;
                option.disabled = !visible;
                if (visible && !first) first = option;
            });
            if (select.selectedOptions[0]?.disabled) select.value = first?.value ?? '';
        });
    };
    supplier.addEventListener('change', syncOffers);
    syncOffers();
})();
</script>
}
