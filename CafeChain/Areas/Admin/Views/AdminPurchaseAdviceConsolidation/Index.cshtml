@using CafeChain.Application.Constants
@using CafeChain.Application.DTOs.Admin.Procurement
@using CafeChain.Models.Enums.Inventory
@using CafeChain.ViewModels.Admin.Shared
@model PurchaseAdviceConsolidationPageDto
@{
    ViewData["Title"] = "Tổng hợp đề nghị mua";
    var canConsolidate = Model.Actor.RoleNames.Contains(RoleConstants.AccountantWarehouse)
        || Model.Actor.RoleNames.Contains(RoleConstants.BusinessOwner);
    var preview = ViewBag.Preview as PurchaseAdviceConsolidationPreviewDto;
    var createsConsolidatedOrder = preview?.LineCount > 1;
    var createOrderLabel = createsConsolidatedOrder
        ? "Tạo đơn đặt hàng gộp"
        : "Tạo đơn đặt hàng";
    var creatingOrderLabel = createsConsolidatedOrder
        ? "Đang tạo đơn đặt hàng gộp..."
        : "Đang tạo đơn đặt hàng...";
    var selectedIds = ViewBag.SelectedLineIds as int[] ?? Array.Empty<int>();
    var selectedSupplierId = ViewBag.SelectedSupplierId as int?;
    var submittedSelections = ViewBag.SubmittedSelections as IReadOnlyDictionary<int, PurchaseAdviceConsolidationSelectionRequest>
        ?? new Dictionary<int, PurchaseAdviceConsolidationSelectionRequest>();
}
@section Styles { <link rel="stylesheet" href="~/css/Admin/PurchaseAdvice/purchase-advice.css" asp-append-version="true" /> }

<main class="pa-page">
    <header class="pa-header">
        <div>
            <div class="pa-eyebrow">Kho &amp; Cung ứng / Mua hàng</div>
            <h1>Tổng hợp đề nghị mua</h1>
            <p class="pa-subtitle">Kiểm tra nhu cầu, quy cách mua và phân bổ đơn đặt hàng về đúng từng chi nhánh.</p>
        </div>
        <div class="pa-actions">
            <a class="pa-action" asp-controller="AdminPurchaseOrderBatches" asp-action="Index"><i class="fas fa-boxes-stacked"></i> Đơn đặt hàng gộp</a>
            <a class="pa-action" asp-controller="AdminPurchaseAdvices" asp-action="Index"><i class="fas fa-arrow-left"></i> Danh sách đề nghị</a>
        </div>
    </header>

    @if (TempData["Error"] is string error) { <div class="pa-alert" role="alert">@error</div> }
    @if (TempData["Success"] is string success) { <div class="pa-alert pa-alert-success" role="status">@success</div> }
    @if (ViewBag.PreviewError is string previewError) { <div class="pa-alert" role="alert">@previewError <span class="pa-alert-help">Các giá trị vừa nhập vẫn được giữ để bạn điều chỉnh.</span></div> }

    <form method="get" class="pa-band pa-filter-grid pa-filter-grid-wide">
        <div class="pa-field"><label>Chi nhánh</label><select name="storeId"><option value="">Tất cả</option>@foreach (var item in Model.Stores) { <option value="@item.Id" selected="@(Model.Filter.StoreId == item.Id)">@item.Label</option> }</select></div>
        <div class="pa-field"><label>Khu vực</label><select name="areaId"><option value="">Tất cả</option>@foreach (var item in Model.Areas) { <option value="@item.Id" selected="@(Model.Filter.AreaId == item.Id)">@item.Label</option> }</select></div>
        <div class="pa-field"><label>Trạng thái</label><select name="status"><option value="">Đã gửi + Đang xem xét</option><option value="@PurchaseAdviceStatuses.Submitted" selected="@(Model.Filter.Status == PurchaseAdviceStatuses.Submitted)">Đã gửi</option><option value="@PurchaseAdviceStatuses.UnderReview" selected="@(Model.Filter.Status == PurchaseAdviceStatuses.UnderReview)">Đang xem xét</option></select></div>
        <div class="pa-field"><label>Cần trước ngày</label><input type="date" name="neededByDate" lang="vi" value="@Model.Filter.NeededByDate?.ToString("yyyy-MM-dd")" /></div>
        <div class="pa-field"><label>Nguyên liệu</label><select name="ingredientId"><option value="">Tất cả</option>@foreach (var item in Model.Ingredients) { <option value="@item.Id" selected="@(Model.Filter.IngredientId == item.Id)">@item.Label</option> }</select></div>
        <div class="pa-field"><label>Ưu tiên</label><select name="priority"><option value="">Tất cả</option>@foreach (var value in PurchaseAdvicePriorities.All) { <option value="@value" selected="@(Model.Filter.Priority == value)">@AdminStatusDisplay.PurchaseAdvicePriority(value).Label</option> }</select></div>
        <div class="pa-field"><label>Nhà cung cấp phù hợp</label><select name="supplierId"><option value="">Tất cả</option>@foreach (var item in Model.Suppliers) { <option value="@item.Id" selected="@(Model.Filter.SupplierId == item.Id)">@item.Label</option> }</select></div>
        <div class="pa-field pa-field-button"><label class="pa-field-spacer">&nbsp;</label><button class="pa-action" type="submit"><i class="fas fa-filter"></i> Lọc</button></div>
    </form>

    <div class="pa-workspace">
        <section class="pa-queue-pane" aria-labelledby="pa-queue-title">
            <form asp-action="Preview" method="post" id="consolidation-form" data-loading-form>
                @Html.AntiForgeryToken()
                <div class="pa-band pa-actions pa-consolidation-toolbar">
                    <div class="pa-field pa-grow">
                        <label for="supplier-select">Nhà cung cấp</label>
                        <select name="SupplierId" id="supplier-select" required disabled="@(!canConsolidate)">
                            <option value="">Chọn nhà cung cấp</option>
                            @foreach (var item in Model.Suppliers) { <option value="@item.Id" selected="@(selectedSupplierId == item.Id)">@item.Label</option> }
                        </select>
                    </div>
                    <div class="pa-toolbar-copy"><strong id="pa-queue-title">Đề nghị chờ tổng hợp</strong><span>Hệ thống sẽ kiểm tra lại giá, số lượng đặt tối thiểu, quy đổi và phạm vi phục vụ chi nhánh.</span></div>
                    <button class="pa-action pa-action-primary" type="submit" disabled="@(!canConsolidate)" data-submit-label="Đang kiểm tra..."><i class="fas fa-layer-group"></i> Kiểm tra bản tổng hợp</button>
                </div>

                <div class="pa-table-wrap">
                    <table class="pa-table pa-consolidation-table">
                        <thead><tr><th>Chọn</th><th>Đề nghị / chi nhánh</th><th>Nguyên liệu</th><th>Số lượng còn cần đặt</th><th>Ngày cần hàng</th><th>Quy cách và giá cung cấp</th><th>Hình thức / số lượng</th></tr></thead>
                        <tbody>
                        @if (Model.Lines.Count == 0) { <tr><td colspan="7" class="pa-empty"><i class="fas fa-inbox"></i><strong>Không có đề nghị mua sẵn sàng tổng hợp</strong><span>Hãy kiểm tra bộ lọc hoặc trạng thái đề nghị.</span></td></tr> }
                        @for (var i = 0; i < Model.Lines.Count; i++)
                        {
                            var line = Model.Lines[i];
                            var offers = Model.Offers.Where(x => x.IngredientId == line.IngredientId && line.CompatibleSupplierIds.Contains(x.SupplierId)).ToList();
                            submittedSelections.TryGetValue(line.PurchaseAdviceLineId, out var submitted);
                            var isSelected = selectedIds.Contains(line.PurchaseAdviceLineId);
                            var initialOffer = offers.FirstOrDefault(x => x.IngredientSupplierId == submitted?.IngredientSupplierId)
                                ?? offers.FirstOrDefault(x => !selectedSupplierId.HasValue || x.SupplierId == selectedSupplierId.Value)
                                ?? offers.FirstOrDefault();
                            var hasProcurementContract = line.RemainingToOrderProcurementQuantity.HasValue;
                            var planningRemaining = hasProcurementContract
                                ? line.RemainingToOrderProcurementQuantity!.Value
                                : line.RemainingToOrderBaseQuantity;
                            var planningUnitName = hasProcurementContract
                                ? line.ProcurementUnitName
                                : line.BaseUnitName;
                            var planningUnitLabel = AdminStatusDisplay.Unit(planningUnitName);
                            var packageQuantityForPlanning = hasProcurementContract
                                ? initialOffer?.PackageProcurementQuantity
                                : initialOffer?.PackageBaseQuantity;
                            var suggestedPackageCount = packageQuantityForPlanning > 0
                                ? (int)Math.Ceiling(planningRemaining / packageQuantityForPlanning.Value)
                                : 1;
                            var initialMode = submitted?.PurchaseMode ?? PurchaseMode.Packaged;
                            if (initialMode == PurchaseMode.Loose && initialOffer?.AllowsLoosePurchase != true)
                                initialMode = PurchaseMode.Packaged;
                            var initialLooseQuantity = submitted?.OrderedProcurementQuantity ?? planningRemaining;
                            <tr data-line data-compatible="@string.Join(',', line.CompatibleSupplierIds)" data-remaining="@planningRemaining.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-plan-unit="@planningUnitLabel" data-procurement="@hasProcurementContract.ToString().ToLowerInvariant()" class="@(isSelected ? "pa-row-selected" : string.Empty)">
                                <td><input class="pa-check line-check" type="checkbox" name="selectedLineIds" value="@line.PurchaseAdviceLineId" checked="@isSelected" disabled="@(!canConsolidate || offers.Count == 0)" aria-label="Chọn @line.IngredientName từ @line.StoreName" /></td>
                                <td><a class="pa-code" asp-controller="AdminPurchaseAdvices" asp-action="Details" asp-route-id="@line.PurchaseAdviceId">@line.AdviceNumber</a><div class="pa-muted">@line.StoreName · Yêu cầu nhập hàng #@line.RestockRequestId</div><input type="hidden" name="Lines[@i].PurchaseAdviceLineId" value="@line.PurchaseAdviceLineId" /><input type="hidden" name="Lines[@i].RowVersion" value="@line.RowVersion" /></td>
                                <td><strong>@line.IngredientName</strong><div class="pa-muted">@planningUnitLabel · @AdminStatusDisplay.PurchaseAdvicePriority(line.Priority).Label</div></td>
                                <td>
                                    <strong>@AdminStatusDisplay.Quantity(planningRemaining) @planningUnitLabel</strong>
                                    <div class="pa-muted">Đã đưa vào đơn @(hasProcurementContract ? AdminStatusDisplay.Quantity(line.AllocatedToPoProcurementQuantity.GetValueOrDefault()) + " " + AdminStatusDisplay.Unit(line.ProcurementUnitName) : AdminStatusDisplay.Quantity(line.AllocatedToPoBaseQuantity) + " " + AdminStatusDisplay.Unit(line.BaseUnitName))</div>
                                    @if (hasProcurementContract) { <div class="pa-muted">Tồn kho chỉ quy đổi khi xác nhận nhập.</div> }
                                </td>
                                <td>@AdminStatusDisplay.Date(line.NeededByDate)</td>
                                <td>
                                    <select class="offer-select" name="Lines[@i].IngredientSupplierId" disabled="@(!canConsolidate)">
                                        <option value="">Chọn quy cách cung cấp</option>
                                        @foreach (var offer in offers)
                                        {
                                            var packageContentUnitLabel = hasProcurementContract
                                                ? AdminStatusDisplay.Unit(line.ProcurementUnitName)
                                                : AdminStatusDisplay.Unit(line.BaseUnitName);
                                            var looseUnitLabel = AdminStatusDisplay.Unit(offer.LooseProcurementUnitName);
                                            <option value="@offer.IngredientSupplierId" data-supplier="@offer.SupplierId" data-package-base="@offer.PackageBaseQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-package-proc="@offer.PackageProcurementQuantity?.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-allows-loose="@offer.AllowsLoosePurchase.ToString().ToLowerInvariant()" data-loose-unit="@looseUnitLabel" data-loose-price="@offer.CurrentProcurementUnitPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture)" selected="@(initialOffer?.IngredientSupplierId == offer.IngredientSupplierId)">
                                                @offer.SupplierName · @(offer.PackageQuantity > 0 ? $"1 gói = {AdminStatusDisplay.Quantity(hasProcurementContract && offer.PackageProcurementQuantity.HasValue ? offer.PackageProcurementQuantity.Value : offer.PackageBaseQuantity)} {packageContentUnitLabel} · {AdminStatusDisplay.Currency(offer.CurrentPackagePrice)}/gói" : "Không có quy cách đóng gói")@(offer.AllowsLoosePurchase ? $" · mua rời {AdminStatusDisplay.Currency(offer.CurrentProcurementUnitPrice.GetValueOrDefault())}/{looseUnitLabel}" : string.Empty) · giao trong @offer.LeadTimeDays ngày
                                            </option>
                                        }
                                    </select>
                                    @if (offers.Count == 0) { <div class="pa-inline-warning">Chưa có quy cách cung cấp hoặc Nhà cung cấp chưa phục vụ chi nhánh này.</div> }
                                </td>
                                <td>
                                    <select class="purchase-mode mb-2" name="Lines[@i].PurchaseMode" disabled="@(!canConsolidate || !hasProcurementContract)">
                                        <option value="@PurchaseMode.Packaged" selected="@(initialMode == PurchaseMode.Packaged)">Đóng gói</option>
                                        <option value="@PurchaseMode.Loose" selected="@(initialMode == PurchaseMode.Loose)" disabled="@(initialOffer?.AllowsLoosePurchase != true)">Mua rời</option>
                                    </select>
                                    <input class="pack-count" type="number" name="Lines[@i].PackageCount" value="@(submitted?.PackageCount ?? suggestedPackageCount)" min="1" step="1" readonly disabled="@(!canConsolidate || initialMode == PurchaseMode.Loose)" aria-label="Số gói đề xuất cho @line.IngredientName" />
                                    <input class="loose-quantity" type="number" name="Lines[@i].OrderedProcurementQuantity" value="@initialLooseQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" min="0.001" max="@planningRemaining.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.001" disabled="@(!canConsolidate || initialMode != PurchaseMode.Loose)" aria-label="Số lượng mua rời cho @line.IngredientName" />
                                    <div class="pa-muted pack-math">Tự tính theo phần còn cần và quy cách.</div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </form>
        </section>

        <aside class="pa-draft-pane" aria-live="polite">
            @if (preview == null)
            {
                <div class="pa-band pa-draft-empty">
                    <i class="fas fa-file-circle-plus"></i>
                    <h2>Bản nháp đơn đặt hàng</h2>
                    <p>Chọn đề nghị, Nhà cung cấp và quy cách cung cấp để xem phân bổ theo chi nhánh trước khi tạo đơn đặt hàng.</p>
                </div>
            }
            else
            {
                <div class="pa-band pa-preview">
                    <div class="pa-preview-heading"><div><div class="pa-eyebrow">Bản tổng hợp hợp lệ</div><h2>@preview.SupplierName</h2></div><div class="pa-preview-total">@AdminStatusDisplay.Currency(preview.TotalAmount)</div></div>
                    <div class="pa-summary-grid"><div class="pa-kpi"><span>Chi nhánh</span><strong>@preview.StoreCount</strong></div><div class="pa-kpi"><span>Dòng đề nghị</span><strong>@preview.LineCount</strong></div><div class="pa-kpi"><span>Nhóm mua</span><strong>@preview.Groups.Count</strong></div><div class="pa-kpi"><span>Trạng thái</span><strong>Chờ tạo</strong></div></div>
                    @foreach (var warning in preview.Warnings) { <div class="pa-inline-warning"><i class="fas fa-triangle-exclamation"></i> @warning</div> }
                    @foreach (var group in preview.Groups)
                    {
                        <div class="pa-preview-group">
                            <div class="pa-preview-group-head"><div><strong>@group.IngredientName</strong><div class="pa-muted">@(group.PurchaseMode == CafeChain.Models.Enums.Inventory.PurchaseMode.Loose ? $"Mua rời theo {AdminStatusDisplay.Unit(group.ProcurementUnitName)}" : $"{AdminStatusDisplay.Quantity(group.PackageQuantity.GetValueOrDefault())} {AdminStatusDisplay.Unit(group.PackageUnitName)}/gói · tối thiểu {group.MinimumOrderPackageCount} gói") · giao trong @group.LeadTimeDays ngày</div></div><strong>@AdminStatusDisplay.Currency(group.LineTotal)</strong></div>
                            <div class="pa-package-line">@if (group.PurchaseMode == CafeChain.Models.Enums.Inventory.PurchaseMode.Packaged) { <span>@AdminStatusDisplay.Quantity(group.PackageCount.GetValueOrDefault()) gói</span><span>@AdminStatusDisplay.Currency(group.PackagePriceSnapshot.GetValueOrDefault())/gói</span> } else { <span>@AdminStatusDisplay.Currency(group.UnitPricePerProcurementUnit.GetValueOrDefault())/@AdminStatusDisplay.Unit(group.ProcurementUnitName)</span> }@if (group.OrderedProcurementQuantity.HasValue) { <span>Đặt @AdminStatusDisplay.Quantity(group.OrderedProcurementQuantity.Value) @AdminStatusDisplay.Unit(group.ProcurementUnitName)</span> } else { <span>Đặt @AdminStatusDisplay.Quantity(group.OrderedBaseQuantity) đơn vị cơ sở</span> }</div>
                            <div class="pa-package-line">@if (group.DemandCoveredProcurementQuantity.HasValue) { <span>Phủ @AdminStatusDisplay.Quantity(group.DemandCoveredProcurementQuantity.Value) @AdminStatusDisplay.Unit(group.ProcurementUnitName)</span><span>Dư quy cách @AdminStatusDisplay.Quantity(group.RoundingSurplusProcurementQuantity.GetValueOrDefault()) @AdminStatusDisplay.Unit(group.ProcurementUnitName)</span> } else { <span>Phủ nhu cầu @AdminStatusDisplay.Quantity(group.DemandCoveredBaseQuantity)</span><span>Dư quy cách @AdminStatusDisplay.Quantity(group.RoundingSurplusBaseQuantity)</span> }</div>
                            <div class="pa-allocation-list">
                                @foreach (var allocation in group.Allocations)
                                {
                                    <div>
                                        <span>@allocation.StoreName · Yêu cầu nhập #@allocation.RestockRequestId</span>
                                    <strong>@if (allocation.PurchaseMode == CafeChain.Models.Enums.Inventory.PurchaseMode.Packaged) { <span>@allocation.PackageCount gói</span> } @if (allocation.OrderedProcurementQuantity.HasValue) { <span>· đặt @AdminStatusDisplay.Quantity(allocation.OrderedProcurementQuantity.Value) @AdminStatusDisplay.Unit(allocation.ProcurementUnitName), phủ @AdminStatusDisplay.Quantity(allocation.DemandCoveredProcurementQuantity.GetValueOrDefault()) @AdminStatusDisplay.Unit(allocation.ProcurementUnitName), dư @AdminStatusDisplay.Quantity(allocation.RoundingSurplusProcurementQuantity.GetValueOrDefault()) @AdminStatusDisplay.Unit(allocation.ProcurementUnitName)</span> } else { <span>· đặt @AdminStatusDisplay.Quantity(allocation.OrderedBaseQuantity), phủ @AdminStatusDisplay.Quantity(allocation.DemandCoveredBaseQuantity), dư @AdminStatusDisplay.Quantity(allocation.RoundingSurplusBaseQuantity)</span> }</strong>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <form asp-controller="AdminPurchaseOrderBatches" asp-action="Create" method="post" class="pa-create-form" data-loading-form>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="SupplierId" value="@preview.SupplierId" />
                        <input type="hidden" name="RequestKey" value="@Guid.NewGuid().ToString("N")" />
                        @{ var selectionIndex = 0; }
                        @foreach (var group in preview.Groups)
                        {
                            @foreach (var allocation in group.Allocations)
                            {
                                <input type="hidden" name="Lines[@selectionIndex].PurchaseAdviceLineId" value="@allocation.PurchaseAdviceLineId" />
                                <input type="hidden" name="Lines[@selectionIndex].IngredientSupplierId" value="@group.IngredientSupplierId" />
                                <input type="hidden" name="Lines[@selectionIndex].PurchaseMode" value="@allocation.PurchaseMode" />
                                @if (allocation.PurchaseMode == PurchaseMode.Packaged)
                                {
                                    <input type="hidden" name="Lines[@selectionIndex].PackageCount" value="@allocation.PackageCount" />
                                }
                                else
                                {
                                    <input type="hidden" name="Lines[@selectionIndex].OrderedProcurementQuantity" value="@allocation.OrderedProcurementQuantity" />
                                }
                                <input type="hidden" name="Lines[@selectionIndex].RowVersion" value="@allocation.LineRowVersion" />
                                selectionIndex++;
                            }
                        }
                        <div class="pa-delivery-grid">
                            <div class="pa-field"><label>Giao từ ngày</label><input type="date" name="ExpectedDeliveryFrom" lang="vi" value="@preview.Groups.SelectMany(x => x.Allocations).Min(x => x.NeededByDate).ToString("yyyy-MM-dd")" required /><span class="pa-muted">Ngày/tháng/năm</span></div>
                            <div class="pa-field"><label>Đến ngày</label><input type="date" name="ExpectedDeliveryTo" lang="vi" value="@preview.Groups.SelectMany(x => x.Allocations).Max(x => x.NeededByDate).ToString("yyyy-MM-dd")" required /><span class="pa-muted">Ngày/tháng/năm</span></div>
                        </div>
                        <div class="pa-field"><label>Ghi chú cho đơn đặt hàng</label><textarea name="Note" rows="2" maxlength="1000" placeholder="Điều kiện giao hàng hoặc lưu ý chung..."></textarea></div>
                        <div class="pa-create-warning"><i class="fas fa-lock"></i> Khi tạo, hệ thống khóa và kiểm tra lại số lượng còn cần đặt, giá, số lượng tối thiểu và phạm vi phục vụ chi nhánh.</div>
                        <button class="pa-action pa-action-primary pa-action-block" type="submit" data-submit-label="@creatingOrderLabel"><i class="fas fa-boxes-stacked"></i> @createOrderLabel</button>
                    </form>
                </div>
            }
        </aside>
    </div>
</main>

@section Scripts {
<script>
(() => {
    const supplier = document.getElementById('supplier-select');
    const updatePackMath = (row, resetQuantity = false) => {
        const select = row.querySelector('.offer-select');
        const packInput = row.querySelector('.pack-count');
        const looseInput = row.querySelector('.loose-quantity');
        const modeInput = row.querySelector('.purchase-mode');
        const copy = row.querySelector('.pack-math');
        const useProcurement = row.dataset.procurement === 'true';
        const offer = select?.selectedOptions[0];
        const allowsLoose = useProcurement && offer?.dataset.allowsLoose === 'true';
        const looseOption = modeInput?.querySelector('option[value="Loose"]');
        if (looseOption) looseOption.disabled = !allowsLoose;
        if (modeInput?.value === 'Loose' && !allowsLoose) modeInput.value = 'Packaged';
        if (resetQuantity) {
            if (packInput) packInput.value = '';
            if (looseInput) looseInput.value = '';
        }
        const isLoose = modeInput?.value === 'Loose';
        if (packInput) packInput.disabled = isLoose;
        if (looseInput) looseInput.disabled = !isLoose;
        if (isLoose) {
            if (packInput) packInput.value = '';
            const remaining = Number(row.dataset.remaining || 0);
            if (looseInput && (!Number(looseInput.value) || Number(looseInput.value) > remaining))
                looseInput.value = String(remaining);
            if (copy) copy.textContent = `Mua rời ${Number(looseInput?.value || 0).toLocaleString('vi-VN')} ${offer?.dataset.looseUnit || row.dataset.planUnit} · ${Number(offer?.dataset.loosePrice || 0).toLocaleString('vi-VN')} ₫/đơn vị.`;
            return;
        }
        if (looseInput) looseInput.value = '';
        const packageQuantity = Number(
            (useProcurement
                ? offer?.dataset.packageProc
                : offer?.dataset.packageBase) || 0);
        const remaining = Number(row.dataset.remaining || 0);
        if (!packInput || !copy || packageQuantity <= 0 || remaining <= 0) {
            if (packInput) packInput.value = '1';
            if (copy) copy.textContent = 'Chọn quy cách hợp lệ để tính số gói.';
            return;
        }
        const count = Math.ceil(remaining / packageQuantity);
        const ordered = count * packageQuantity;
        packInput.value = String(count);
        copy.textContent = `${count} gói · đặt ${ordered.toLocaleString('vi-VN')} ${row.dataset.planUnit} · dư ${(ordered - remaining).toLocaleString('vi-VN')} ${row.dataset.planUnit}`;
    };
    if (supplier) {
        const syncOffers = (resetQuantity = false) => {
            const supplierId = supplier.value;
            document.querySelectorAll('[data-line]').forEach(row => {
                const select = row.querySelector('.offer-select');
                if (!select) return;
                let first = null;
                Array.from(select.options).forEach(option => {
                    if (!option.value) return;
                    const visible = !supplierId || option.dataset.supplier === supplierId;
                    option.hidden = !visible;
                    option.disabled = !visible;
                    if (visible && !first) first = option;
                });
                if (select.selectedOptions[0]?.disabled) select.value = first?.value ?? '';
                if (!select.value && first) select.value = first.value;
                updatePackMath(row, resetQuantity);
            });
        };
        supplier.addEventListener('change', () => syncOffers(true));
        syncOffers();
    }

    document.querySelectorAll('.offer-select').forEach(select => {
        select.addEventListener('change', () => updatePackMath(select.closest('[data-line]'), true));
    });
    document.querySelectorAll('.purchase-mode, .loose-quantity').forEach(input => {
        input.addEventListener('change', () => updatePackMath(input.closest('[data-line]')));
        input.addEventListener('input', () => updatePackMath(input.closest('[data-line]')));
    });
    document.querySelectorAll('[data-line]').forEach(updatePackMath);
    document.querySelectorAll('.line-check').forEach(check => check.addEventListener('change', () => {
        check.closest('tr')?.classList.toggle('pa-row-selected', check.checked);
    }));
    const normalizeSelectionPayload = form => {
        form.querySelectorAll('[data-line]').forEach(row => {
            if (!row.querySelector('.line-check')?.checked) return;
            const isLoose = row.querySelector('.purchase-mode')?.value === 'Loose';
            const packInput = row.querySelector('.pack-count');
            const looseInput = row.querySelector('.loose-quantity');
            if (isLoose) {
                if (packInput) { packInput.value = ''; packInput.disabled = true; }
                if (looseInput) looseInput.disabled = false;
                return;
            }
            if (looseInput) { looseInput.value = ''; looseInput.disabled = true; }
            if (packInput) packInput.disabled = false;
        });
    };
    document.getElementById('consolidation-form')?.addEventListener('submit', event => {
        normalizeSelectionPayload(event.currentTarget);
    });
    document.querySelectorAll('[data-loading-form]').forEach(form => form.addEventListener('submit', () => {
        const button = form.querySelector('button[type="submit"]');
        if (!button || button.disabled) return;
        button.disabled = true;
        button.dataset.originalText = button.innerHTML;
        button.textContent = button.dataset.submitLabel || 'Đang xử lý...';
    }));
})();
</script>
}
