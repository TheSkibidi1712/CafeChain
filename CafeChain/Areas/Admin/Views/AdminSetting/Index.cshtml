@model CafeChain.ViewModels.Admin.Settings.AdminSettingIndexVM
@{
    ViewData["Title"] = "Cấu hình âm kho";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-2">Cấu hình âm kho</h1>
            <p class="text-muted mb-0">Quản lý kill switch và hạn mức xuất âm thủ công theo từng cửa hàng, nguyên liệu hoặc bán thành phẩm.</p>
        </div>
        <span class="badge text-bg-warning">Business Owner / System Admin</span>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            @if (Model.NegativeInventory != null)
            {
                <partial name="Partials/_NegativeInventorySettings" model="Model.NegativeInventory" />
                <form id="negativeInventorySettingsForm"
                      asp-area="Admin"
                      asp-controller="AdminSetting"
                      asp-action="UpdateNegativeInventory"
                      method="post"></form>
            }
        </div>
    </div>
</div>

<style>
    #negativeInventoryItemsTable .badge { white-space: normal; text-align: left; }
</style>

@section Scripts {
    <script src="~/js/Admin/Settings/adminsetting.js" asp-append-version="true"></script>
}
