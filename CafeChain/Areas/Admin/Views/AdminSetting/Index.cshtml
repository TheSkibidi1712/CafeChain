@model CafeChain.ViewModels.Admin.Settings.AdminSettingIndexVM
@{
    ViewData["Title"] = "Cấu hình âm kho";
}

<link rel="stylesheet" href="~/css/Admin/Settings/negative-inventory.css" asp-append-version="true" />

<div class="container-fluid py-4 negative-inventory-page">
    <div class="ni-page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="ni-eyebrow"><i class="fas fa-shield-halved"></i> Chính sách tồn kho</div>
            <h1 class="h3 fw-bold mb-2 ni-page-title">Cấu hình xuất âm kho</h1>
            <p class="text-muted mb-0">Kiểm soát quyền yêu cầu xuất vượt tồn và hạn mức áp dụng tại từng cửa hàng.</p>
        </div>
        <span class="badge rounded-pill px-3 py-2 ni-role-badge">
            <i class="fas fa-user-shield me-1"></i>Business Owner / System Admin
        </span>
    </div>

    <div class="card border-0 shadow-sm ni-settings-card">
        <div class="card-body p-4">
            @if (Model.NegativeInventory != null)
            {
                <partial name="Partials/_NegativeInventorySettings" model="Model.NegativeInventory" />
                <form id="negativeInventorySettingsForm"
                      asp-area="Admin"
                      asp-controller="AdminSetting"
                      asp-action="UpdateNegativeInventory"
                      method="post"></form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Admin/Settings/adminsetting.js" asp-append-version="true"></script>
}
