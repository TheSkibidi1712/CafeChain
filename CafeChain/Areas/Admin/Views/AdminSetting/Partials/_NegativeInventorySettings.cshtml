@using CafeChain.Application.DTOs.Admin.Settings
@model NegativeInventorySettingsDTO
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<CafeChain.SharedResource> SharedText

@{
    const string formId = "negativeInventorySettingsForm";
    var statusClass = !Model.IsConfigurationValid
        ? "text-bg-danger"
        : Model.Enabled ? "text-bg-success" : "text-bg-secondary";
    var statusText = !Model.IsConfigurationValid
        ? SharedText["Settings.Negative.Status.Invalid"]
        : Model.Enabled ? SharedText["Settings.Negative.Status.Enabled"] : SharedText["Settings.Negative.Status.Disabled"];
    var stores = Model.Items
        .GroupBy(x => new { x.StoreId, x.StoreName })
        .Select(x => x.Key)
        .OrderBy(x => x.StoreId)
        .ToList();
    Func<decimal, string> formatQuantity = value => value.ToString("#,##0.###");
    Func<decimal, string> formatInput = value => value.ToString(
        "0.###",
        System.Globalization.CultureInfo.InvariantCulture);
}

<div id="negative-inventory" data-pending-approval-count="@Model.PendingApprovalCount">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-4 mb-4 ni-feature-panel">
        <div class="d-flex align-items-start gap-3">
            <span class="ni-feature-icon"><i class="fas fa-box-open"></i></span>
            <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <h5 class="fw-bold mb-0">@SharedText["Settings.Negative.Title"]</h5>
                <span class="badge rounded-pill @statusClass">@statusText</span>
            </div>
            <p class="text-muted mb-0">
                @SharedText["Settings.Negative.Description"]
            </p>
            </div>
        </div>
        <div class="form-check form-switch fs-5 ni-master-switch">
            <input class="form-check-input" type="checkbox" role="switch"
                   id="negativeInventoryEnabled" name="Enabled" value="true"
                   aria-label="@SharedText["Settings.Negative.ToggleAria"]"
                   form="@formId" checked="@Model.Enabled" disabled="@(!Model.IsConfigurationValid)" />
            <input type="hidden" name="Enabled" value="false" form="@formId" />
            <label class="form-check-label fw-semibold" for="negativeInventoryEnabled">
                @SharedText["Settings.Negative.Toggle"]
            </label>
        </div>
    </div>

    @if (!Model.IsConfigurationValid)
    {
        <div class="alert alert-danger border-0 shadow-sm">
            <i class="fas fa-triangle-exclamation me-2"></i>
            @Model.ConfigurationError
        </div>
    }

    @if (Model.PendingApprovalCount > 0)
    {
        <div class="alert alert-warning border-0 shadow-sm">
            <i class="fas fa-shield-halved me-2"></i>
            @SharedText["Settings.Negative.PendingPrefix"] <strong>@Model.PendingApprovalCount</strong> @SharedText["Settings.Negative.PendingSuffix"]
            @SharedText["Settings.Negative.PendingHint"]
        </div>
    }

    <div class="ni-section-heading">
        <div>
            <h6>@SharedText["Settings.Negative.Policy.Title"]</h6>
            <p>@SharedText["Settings.Negative.Policy.Hint"]</p>
        </div>
    </div>

    <div class="ni-policy-grid mb-4">
        <div class="ni-meta-field">
            <span class="ni-meta-icon"><i class="fas fa-gauge-high"></i></span>
            <div class="flex-grow-1 min-w-0">
                <label class="form-label fw-bold mb-1.5 text-dark fs-7">@SharedText["Settings.Negative.DefaultLimit"]</label>
                <div class="input-group input-group-sm ni-input-group">
                    <input type="number" min="0" max="999999999999999.999" step="0.001"
                           class="form-control fw-bold text-dark" name="DefaultMaxNegativeQuantity"
                           value="@formatInput(Model.DefaultMaxNegativeQuantity)"
                           form="@formId" disabled="@(!Model.IsConfigurationValid)" />
                    <span class="input-group-text bg-light text-muted fw-semibold">@SharedText["Settings.Negative.BaseUnit"]</span>
                </div>
                <div class="form-text text-muted fs-8 mt-1">@SharedText["Settings.Negative.DefaultLimitHint"]</div>
            </div>
        </div>

        <div class="ni-meta-field">
            <span class="ni-meta-icon"><i class="fas fa-user-check"></i></span>
            <div class="flex-grow-1 min-w-0">
                <label class="form-label fw-bold mb-1.5 text-dark fs-7">@SharedText["Settings.Negative.TwoStep"]</label>
                <div class="ni-policy-value d-flex align-items-center gap-1.5 text-success fw-bold">
                    <i class="fas fa-circle-check"></i> <span>@SharedText["Settings.Negative.Required"]</span>
                </div>
                <div class="form-text text-muted fs-8 mt-1">@SharedText["Settings.Negative.TwoStepHint"]</div>
            </div>
        </div>

        <div class="ni-meta-field">
            <span class="ni-meta-icon"><i class="fas fa-code-branch"></i></span>
            <div class="flex-grow-1 min-w-0">
                <label class="form-label fw-bold mb-1.5 text-dark fs-7">@SharedText["Settings.Negative.PolicyVersion"]</label>
                <div class="ni-policy-version font-monospace fw-bold text-dark">
                    @(Model.PolicyVersion.StartsWith("manual-export-") ? $"{SharedText["Settings.Negative.ManualExport"]} - {Model.PolicyVersion["manual-export-".Length..]}" : Model.PolicyVersion)
                </div>
                <div class="form-text text-muted fs-8 mt-1">@SharedText["Settings.Negative.PolicyVersionHint"]</div>
            </div>
        </div>
    </div>

    <div class="ni-section-heading mb-2">
        <div>
            <h6>@SharedText["Settings.Negative.StoreLimits"]</h6>
            <p>@SharedText["Settings.Negative.StoreSummary", stores.Count, Model.Items.Count, Model.PendingApprovalCount]</p>
        </div>
    </div>

    @if (stores.Count > 0)
    {
        <div class="negative-store-tabs-wrap mb-3">
            <ul class="nav nav-tabs flex-nowrap" id="negativeInventoryStoreTabs" role="tablist" aria-label="@SharedText["Settings.Negative.StoresAria"]">
                @for (var storeIndex = 0; storeIndex < stores.Count; storeIndex++)
                {
                    var store = stores[storeIndex];
                    <li class="nav-item flex-shrink-0" role="presentation">
                        <button type="button"
                                class="nav-link negative-store-tab @(storeIndex == 0 ? "active" : null)"
                                role="tab"
                                aria-selected="@(storeIndex == 0 ? "true" : "false")"
                                data-store-id="@store.StoreId">
                            <i class="fas fa-store me-2"></i>#@store.StoreId — @store.StoreName
                        </button>
                    </li>
                }
            </ul>
        </div>
    }

    <div class="ni-toolbar row g-3 align-items-center mb-3">
        <div class="col-lg-7 col-md-7">
            <div class="ni-search-wrap">
                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                <input id="negativeInventoryItemSearch" type="search" class="form-control" placeholder="@SharedText["Settings.Negative.SearchPlaceholder"]" />
            </div>
        </div>
        <div class="col-lg-3 col-md-5">
            <select id="negativeInventoryPageSize" class="form-select">
                <option value="10" selected>@SharedText["Settings.Negative.Rows", 10]</option>
                <option value="20">@SharedText["Settings.Negative.Rows", 20]</option>
                <option value="50">@SharedText["Settings.Negative.Rows", 50]</option>
            </select>
        </div>
        <div class="col-lg-2 text-lg-end">
            <span class="ni-range-badge" id="negativeInventoryRangeSummary" aria-live="polite">
                <span id="negativeInventoryRangeStart">0</span>–<span id="negativeInventoryRangeEnd">0</span>
                / <span id="negativeInventoryFilteredCount">0</span> item
            </span>
        </div>
    </div>

    <div class="table-responsive border rounded-3 bg-white ni-table-wrap">
        <table class="table table-hover align-middle mb-0" id="negativeInventoryItemsTable">
            <thead class="table-light">
                <tr>
                    <th class="ni-col-code text-start">@SharedText["Settings.Negative.Column.Code"]</th>
                    <th class="ni-col-name text-start">@SharedText["Settings.Negative.Column.Name"]</th>
                    <th class="ni-col-stock text-end">@SharedText["Settings.Negative.Column.Available"]</th>
                    <th class="ni-col-mode text-center">@SharedText["Settings.Negative.Column.Mode"]</th>
                    <th class="ni-col-limit text-center">@SharedText["Settings.Negative.Column.CustomLimit"]</th>
                    <th class="ni-col-effective text-end">@SharedText["Settings.Negative.Column.Effective"]</th>
                    <th class="ni-col-status text-center">@SharedText["Settings.Negative.Column.Status"]</th>
                </tr>
            </thead>
            <tbody>
                @for (var index = 0; index < Model.Items.Count; index++)
                {
                    var item = Model.Items[index];
                    var searchText = $"{item.ItemId} {item.ItemCode} {item.ItemName}".ToLowerInvariant();
                    <tr class="negative-inventory-item-row" data-store-id="@item.StoreId" data-search="@searchText"
                        data-base-available="@formatInput(item.AvailableQty)"
                        data-base-reserved="@formatInput(item.ReservedQty)"
                        data-base-effective-limit="@formatInput(item.EffectiveMaxNegativeQty)"
                        data-current-factor="1">
                        <td class="text-start">
                            <span class="ni-item-code font-monospace fw-bold text-dark">@item.ItemCode</span>
                        </td>
                        <td class="text-start">
                            <div class="fw-bold text-dark" style="font-size: 13.5px;">@item.ItemName</div>
                            <div class="small text-muted" style="font-size: 11px;">@item.ItemType #@item.ItemId · @SharedText["Settings.Negative.BaseUnit"]: @item.BaseUnitCode</div>
                        </td>
                        <td class="text-end">
                            <div class="ni-stock-value"><span class="negative-available-qty">@formatQuantity(item.AvailableQty)</span> <span class="negative-display-unit-code">@item.BaseUnitCode</span></div>
                            <div class="small text-muted">@SharedText["Settings.Negative.Reserved"]: <span class="negative-reserved-qty">@formatQuantity(item.ReservedQty)</span></div>
                        </td>
                        <td class="text-center">
                            <input type="hidden" name="Items[@index].StoreInventoryId" value="@item.StoreInventoryId" form="@formId" />
                            <input type="hidden" name="Items[@index].RowVersion" value="@item.RowVersion" form="@formId" />
                            <div class="ni-custom-dropdown-wrap">
                                <select class="form-select form-select-sm negative-limit-mode d-none"
                                        name="Items[@index].LimitMode" form="@formId"
                                        disabled="@(!Model.IsConfigurationValid)">
                                    <option value="@NegativeInventoryLimitModes.Blocked" selected="@(item.LimitMode == NegativeInventoryLimitModes.Blocked)">@SharedText["Settings.Negative.Mode.Blocked"]</option>
                                    <option value="@NegativeInventoryLimitModes.Default" selected="@(item.LimitMode == NegativeInventoryLimitModes.Default)">@SharedText["Settings.Negative.Mode.Default"]</option>
                                    <option value="@NegativeInventoryLimitModes.Custom" selected="@(item.LimitMode == NegativeInventoryLimitModes.Custom)">@SharedText["Settings.Negative.Mode.Custom"]</option>
                                </select>
                                <div class="dropdown ni-custom-dropdown">
                                    <button class="btn btn-sm ni-dropdown-trigger dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" disabled="@(!Model.IsConfigurationValid)">
                                        <span class="ni-dropdown-selected-label">
                                            @if (item.LimitMode == NegativeInventoryLimitModes.Blocked)
                                            {
                                                <i class="fas fa-lock me-1 text-danger"></i><span>@SharedText["Settings.Negative.Mode.Blocked"]</span>
                                            }
                                            else if (item.LimitMode == NegativeInventoryLimitModes.Custom)
                                            {
                                                <i class="fas fa-sliders me-1 text-amber"></i><span>@SharedText["Settings.Negative.Mode.Custom"]</span>
                                            }
                                            else
                                            {
                                                <i class="fas fa-circle-check me-1 text-success"></i><span>@SharedText["Settings.Negative.Mode.Default"]</span>
                                            }
                                        </span>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-center ni-dropdown-menu shadow-sm">
                                        <li>
                                            <button type="button" class="dropdown-item ni-dropdown-item @(item.LimitMode == NegativeInventoryLimitModes.Blocked ? "active" : "")" data-value="BLOCKED">
                                                <i class="fas fa-lock me-2 text-danger"></i>@SharedText["Settings.Negative.Mode.Blocked"]
                                            </button>
                                        </li>
                                        <li>
                                            <button type="button" class="dropdown-item ni-dropdown-item @(item.LimitMode == NegativeInventoryLimitModes.Default ? "active" : "")" data-value="DEFAULT">
                                                <i class="fas fa-circle-check me-2 text-success"></i>@SharedText["Settings.Negative.Mode.Default"]
                                            </button>
                                        </li>
                                        <li>
                                            <button type="button" class="dropdown-item ni-dropdown-item @(item.LimitMode == NegativeInventoryLimitModes.Custom ? "active" : "")" data-value="CUSTOM">
                                                <i class="fas fa-sliders me-2 text-amber"></i>@SharedText["Settings.Negative.Mode.Custom"]
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </td>
                        <td class="text-center">
                            <div class="ni-limit-controls">
                            <select class="form-select form-select-sm mb-2 negative-display-unit"
                                    name="Items[@index].DisplayUnitId" form="@formId"
                                    disabled="@(!Model.IsConfigurationValid || item.UnitOptions.Count <= 1)">
                                @foreach (var unit in item.UnitOptions)
                                {
                                    <option value="@unit.UnitId"
                                            data-factor="@unit.ConversionFactorToBase.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-code="@unit.UnitCode"
                                            selected="@(unit.UnitId == item.DisplayUnitId)">@unit.UnitCode — @unit.UnitName</option>
                                }
                            </select>
                            @if (item.UnitOptions.Count <= 1)
                            {
                                <input type="hidden" name="Items[@index].DisplayUnitId" value="@item.BaseUnitId" form="@formId" />
                            }
                            <input type="number" min="0.001" max="999999999999999.999" step="0.001"
                                   class="form-control form-control-sm negative-custom-limit"
                                   name="Items[@index].MaxNegativeQuantity"
                                   value="@(item.MaxNegativeQty.HasValue ? formatInput(item.MaxNegativeQty.Value) : null)"
                                   form="@formId"
                                   disabled="@(item.LimitMode != NegativeInventoryLimitModes.Custom || !Model.IsConfigurationValid)" />
                            </div>
                        </td>
                        <td class="text-end">
                            <strong class="negative-effective-limit">@formatQuantity(item.EffectiveMaxNegativeQty)</strong>
                            <span class="negative-display-unit-code">@item.BaseUnitCode</span>
                        </td>
                        <td class="text-center">
                            <span class="badge rounded-pill ni-status-badge @(item.CanRequestNegative ? "text-bg-success" : "text-bg-secondary")">
                                @item.EligibilityText
                            </span>
                        </td>
                    </tr>
                }
                <tr id="negativeInventoryEmptyRow" class="d-none">
                    <td colspan="7" class="text-center py-5 text-muted">
                        <i class="fas fa-box-open fs-3 d-block mb-2"></i>
                        @SharedText["Settings.Negative.Empty"]
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-3">
        <span class="text-muted small" id="negativeInventoryPageStatus" aria-live="polite">@SharedText["Settings.Negative.PageStatus", 1, 1]</span>
        <nav aria-label="@SharedText["Settings.Negative.PaginationAria"]">
            <ul class="pagination pagination-sm mb-0" id="negativeInventoryPagination"></ul>
        </nav>
    </div>

    <div class="d-flex justify-content-end ni-save-bar">
        <button type="submit" class="btn btn-ni-primary px-5 py-2 fw-bold rounded-3"
                form="@formId" disabled="@(!Model.IsConfigurationValid)">
            <i class="fas fa-shield-halved me-2"></i>@SharedText["Settings.Negative.Save"]
        </button>
    </div>
</div>
