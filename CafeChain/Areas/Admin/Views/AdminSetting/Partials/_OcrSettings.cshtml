@model CafeChain.Application.DTOs.Admin.Settings.AIImportOcrSettingsDTO
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<CafeChain.SharedResource> SharedText

<div class="ocr-settings" id="ocrSettingsPanel">
    <div class="alert @(Model.EffectiveEnabled ? "alert-success" : "alert-warning")">
        <strong>@SharedText["Settings.Ocr.Status"]:</strong>
        @(Model.EffectiveEnabled ? SharedText["Settings.Ocr.Ready"] : !Model.InfrastructureConfigured ? SharedText["Settings.Ocr.InfrastructureUnavailable"] : Model.HealthStatus == "UNAVAILABLE" ? SharedText["Settings.Ocr.Error"] : SharedText["Settings.Ocr.Pending"])
        <div class="small mt-1">@Model.HealthMessage</div>
    </div>

    <form id="ocrSettingsForm" asp-area="Admin" asp-controller="AdminSetting" asp-action="UpdateOcr" method="post">
        <div class="alert alert-info mb-3">
            @SharedText["Settings.Ocr.PrivacyHint"]
        </div>
        <div class="row g-3 mb-3">
            <div class="col-md-4"><label class="form-label">Provider</label><input class="form-control" value="@Model.Provider" disabled /></div>
            <div class="col-md-4"><label class="form-label">@SharedText["Settings.Ocr.Version"]</label><input class="form-control" value="@(Model.ProviderVersion ?? SharedText["Settings.Ocr.NotChecked"])" disabled /></div>
            <div class="col-md-2"><label class="form-label">Executable</label><input class="form-control" value="@(Model.ExecutableAvailable ? SharedText["Settings.Ocr.Ready"] : SharedText["Settings.Ocr.NotReady"])" disabled /></div>
            <div class="col-md-2"><label class="form-label">Model</label><input class="form-control" value="@(Model.ModelDataReady ? SharedText["Settings.Ocr.ModelReady"] : SharedText["Settings.Ocr.ModelMissing"])" disabled /></div>
        </div>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label" asp-for="Languages">@SharedText["Settings.Ocr.Languages"]</label>
                <select class="form-select" asp-for="Languages">
                    <option value="vie+eng">@SharedText["Settings.Ocr.Language.Bilingual"]</option>
                    <option value="vie">@SharedText["Settings.Ocr.Language.Vietnamese"]</option>
                    <option value="eng">English (eng)</option>
                </select>
            </div>
            <div class="col-md-3"><label class="form-label" asp-for="ReviewConfidenceThreshold">@SharedText["Settings.Ocr.ReviewThreshold"]</label><input class="form-control" asp-for="ReviewConfidenceThreshold" type="number" min="0" max="1" step="0.01" /></div>
            <div class="col-md-3"><label class="form-label" asp-for="RenderDpi">Render DPI</label><input class="form-control" asp-for="RenderDpi" type="number" min="72" max="600" /></div>
            <div class="col-md-3"><label class="form-label" asp-for="MaxPages">@SharedText["Settings.Ocr.MaxPages"]</label><input class="form-control" asp-for="MaxPages" type="number" min="1" max="500" /></div>
            <div class="col-md-4"><label class="form-label" asp-for="MaxRenderedPixelsPerPage">@SharedText["Settings.Ocr.MaxPixelsPerPage"]</label><input class="form-control" asp-for="MaxRenderedPixelsPerPage" type="number" min="1" /></div>
            <div class="col-md-4"><label class="form-label" asp-for="MaxTotalRenderedPixels">@SharedText["Settings.Ocr.MaxTotalPixels"]</label><input class="form-control" asp-for="MaxTotalRenderedPixels" type="number" min="1" /></div>
            <div class="col-md-4"><label class="form-label" asp-for="MaxConcurrentPages">@SharedText["Settings.Ocr.ConcurrentPages"]</label><input class="form-control" asp-for="MaxConcurrentPages" type="number" min="1" max="16" /></div>
            <div class="col-md-6"><label class="form-label" asp-for="PageTimeoutSeconds">@SharedText["Settings.Ocr.PageTimeout"]</label><input class="form-control" asp-for="PageTimeoutSeconds" type="number" min="1" max="600" /></div>
            <div class="col-md-6"><label class="form-label" asp-for="TotalTimeoutSeconds">@SharedText["Settings.Ocr.TotalTimeout"]</label><input class="form-control" asp-for="TotalTimeoutSeconds" type="number" min="1" max="3600" /></div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-4">
            <small class="text-muted">@SharedText["Settings.Ocr.LastCheck"]: @(Model.LastHealthCheckedAtUtc?.ToLocalTime().ToString("g") ?? SharedText["Settings.Ocr.NotChecked"]) · @SharedText["Settings.Ocr.ConfigVersion"] @Model.ConfigVersion</small>
            <div class="d-flex gap-2"><button type="button" class="btn btn-outline-secondary" id="checkOcrButton" data-url="@Url.Action("CheckOcr", "AdminSetting", new { area = "Admin" })">@SharedText["Settings.Ocr.Check"]</button><button type="submit" class="btn btn-primary">@SharedText["Settings.Ocr.Save"]</button></div>
        </div>
    </form>
</div>
