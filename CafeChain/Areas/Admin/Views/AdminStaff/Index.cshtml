@model CafeChain.ViewModels.Admin.Staffs.StaffIndexPageVM
@using System.Security.Claims
@using CafeChain.Application.Constants
@using CafeChain.Application.Constants.Cloudinaries
@using CafeChain.Application.Interfaces.Admin.Permissions
@inject IAdminPermissionService StaffPermissionService

@{
    ViewData["Title"] = "Quản lý nhân sự";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var roles = ViewBag.Roles as List<CafeChain.Models.Permissions.Role>;
    var accountId = int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var parsedAccountId)
        ? parsedAccountId : 0;
    var permissionSnapshot = (await StaffPermissionService.GetEffectivePermissionCodesAsync(accountId)).Data
        ?? new HashSet<string>(StringComparer.Ordinal);
    var canCreateStaff = permissionSnapshot.Contains(PermissionConstants.StaffCreate);
    var canUpdateStaff = permissionSnapshot.Contains(PermissionConstants.StaffUpdate);
    var canToggleStaff = permissionSnapshot.Contains(PermissionConstants.StaffToggleStatus);
    var canResetPassword = permissionSnapshot.Contains(PermissionConstants.StaffResetPassword);
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />
    <link rel="stylesheet" href="~/css/admin-white-orange-forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/Staff/staff.css" asp-append-version="true" />
}

<main class="staff-page staff-index-page ops-shell cc-warehouse-page">

    
    <header class="staff-page-header ops-header cc-warehouse-header">
        <div>
            <div class="staff-eyebrow">Nhân sự &amp; Vận hành / Quản lý nhân viên</div>
            <h1><i class="fa-solid fa-users me-2 text-warning" aria-hidden="true"></i> Quản lý nhân sự</h1>
            <p class="staff-subtitle">Quản lý thông tin, vai trò và quyền hạn của đội ngũ nhân viên CafeChain.</p>
        </div>
        <div class="staff-header-actions">
            @if (canCreateStaff)
            {
                <button type="button" class="btn btn-primary d-flex align-items-center gap-2"
                        data-bs-toggle="modal" data-bs-target="#createStaffModal">
                    <i class="fas fa-user-plus"></i> Thêm nhân viên
                </button>
            }
        </div>
    </header>

    
    <div class="staff-kpi-row mb-4">
        <div class="staff-kpi-card">
            <div class="kpi-icon total"><i class="fas fa-users"></i></div>
            <div class="kpi-info">
                <h4>@Model.TotalStaff</h4>
                <span>Tổng nhân sự</span>
            </div>
        </div>
        <div class="staff-kpi-card">
            <div class="kpi-icon active"><i class="fas fa-user-check"></i></div>
            <div class="kpi-info">
                <h4>@Model.ActiveCount</h4>
                <span>Đang làm việc</span>
            </div>
        </div>
        <div class="staff-kpi-card">
            <div class="kpi-icon inactive"><i class="fas fa-user-lock"></i></div>
            <div class="kpi-info">
                <h4>@Model.InactiveCount</h4>
                <span>Đã khóa</span>
            </div>
        </div>
    </div>

    
    <div class="card admin-wo-card">
        <div class="card-body p-4">

            
            <form asp-action="Index" method="get" class="staff-filter-panel row g-3 mb-4 align-items-end">
                <div class="col-md-5">
                    <label class="form-label mb-1">Tìm kiếm nhân viên</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <i class="fas fa-search"></i>
                        </span>
                        <input type="text" name="search"
                               value="@Model.SearchTerm"
                               class="form-control border-start-0 ps-0"
                               placeholder="Tên hoặc email nhân viên..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label mb-1">Vai trò</label>
                    <select name="roleFilter" class="form-select" onchange="this.form.submit()">
                        <option value="">Tất cả vai trò</option>
                        @if (roles != null)
                        {
                            @foreach (var role in roles)
                            {
                                <option value="@role.RoleId"
                                        selected="@(Model.RoleFilter == role.RoleId)">
                                    @role.Name
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2">
                        <i class="fas fa-filter"></i> Lọc
                    </button>
                </div>
                <div class="col-md-2">
                    <a asp-action="Index" class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-2">
                        <i class="fas fa-undo"></i> Đặt lại
                    </a>
                </div>
            </form>

            
            <div class="staff-result-summary d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted">
                    <i class="fas fa-list-ul me-1"></i>
                    Tìm thấy <strong>@Model.StaffList.TotalCount</strong> nhân viên
                    @if (!string.IsNullOrEmpty(Model.SearchTerm))
                    {
                        <span> cho "<em>@Model.SearchTerm</em>"</span>
                    }
                </span>
            </div>

            
            <div class="staff-table-shell table-responsive">
                <table class="table table-custom">
                    <thead>
                        <tr>
                            <th>Nhân viên</th>
                            <th>Email</th>
                            <th>Vai trò</th>
                            <th>Cửa hàng</th>
                            <th style="min-width:140px;" class="text-center">Trạng thái</th>
                            <th style="min-width:140px;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.StaffList.Items == null || !Model.StaffList.Items.Any())
                        {
                            <tr>
                                <td colspan="6" class="admin-wo-empty py-5">
                                    <i class="fas fa-users-slash d-block mb-2" style="font-size:2rem;color:#DBC4A9;"></i>
                                    Chưa có nhân viên nào. Hãy thêm mới!
                                </td>
                            </tr>
                        }
                        @foreach (var item in Model.StaffList.Items)
                        {
                            <tr>
                                <td>
                                    <div class="staff-name-cell">
                                        <img src="@item.AvatarUrl"
                                             class="staff-avatar"
                                             alt="@item.FullName"
                                             onerror="this.onerror=null;this.src='@DefaultImages.StaffAvatarUrl'" />
                                        <span class="name">@item.FullName</span>
                                    </div>
                                </td>
                                <td class="text-muted" style="font-size:13px;">@item.Email</td>
                                <td>
                                    @foreach (var roleName in item.RoleNames)
                                    {
                                        <span class="role-badge default">@roleName</span>
                                    }
                                </td>
                                <td style="font-size:13px;">@item.StoreName</td>
                                <td>
                                    @if (item.Active)
                                    {
                                        <span class="status-badge active">
                                            <span class="dot"></span> Đang làm việc
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge inactive">
                                            <span class="dot"></span> Đã khóa
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.CanEdit)
                                    {
                                        @if (canUpdateStaff)
                                        {
                                            <a href="@Url.Action("Edit", "AdminStaff", new { area = "Admin", id = item.StaffId })"
                                               class="action-btn action-btn-edit me-1" title="Chỉnh sửa"><i class="fas fa-pen"></i></a>
                                        }
                                        @if (canToggleStaff)
                                        {
                                            <button type="button" class="action-btn @(item.Active ? "danger" : "success")"
                                                    onclick="toggleStaffStatus(@item.StaffId, '@item.FullName', @item.Active.ToString().ToLower(), this)"
                                                    title="@(item.Active ? "Khóa tài khoản" : "Mở khóa")">
                                                <i class="fas @(item.Active ? "fa-lock" : "fa-unlock")"></i>
                                            </button>
                                        }
                                        @if (canResetPassword)
                                        {
                                            <button type="button" class="action-btn"
                                                    onclick="resetStaffPassword(@item.AccountId, '@item.FullName', this)"
                                                    title="Đặt lại mật khẩu">
                                                <i class="fas fa-key"></i>
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border" title="Không có quyền chỉnh sửa">
                                            <i class="fas fa-ban me-1"></i> Thuộc cấp trên
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            
            <div class="staff-table-footer d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                <span class="text-muted">
                    Hiển thị @Model.StaffList.Items.Count / @Model.StaffList.TotalCount nhân viên
                </span>
                <div class="page-btns">
                    <a asp-action="Index"
                       asp-route-page="@(Model.StaffList.PageIndex - 1)"
                       asp-route-search="@Model.SearchTerm"
                       asp-route-roleFilter="@Model.RoleFilter"
                       class="page-btn @(!Model.StaffList.HasPreviousPage ? "disabled" : "")">
                        <i class="fas fa-chevron-left" style="font-size:11px;"></i>
                    </a>
                    @for (int i = 1; i <= Model.StaffList.TotalPages; i++)
                    {
                        <a asp-action="Index"
                           asp-route-page="@i"
                           asp-route-search="@Model.SearchTerm"
                           asp-route-roleFilter="@Model.RoleFilter"
                           class="page-btn @(i == Model.StaffList.PageIndex ? "active" : "")">@i</a>
                    }
                    <a asp-action="Index"
                       asp-route-page="@(Model.StaffList.PageIndex + 1)"
                       asp-route-search="@Model.SearchTerm"
                       asp-route-roleFilter="@Model.RoleFilter"
                       class="page-btn @(!Model.StaffList.HasNextPage ? "disabled" : "")">
                        <i class="fas fa-chevron-right" style="font-size:11px;"></i>
                    </a>
                </div>
            </div>

        </div>
    </div>
</main>


@if (canCreateStaff)
{
    <partial name="_CreateStaffModal" model="new CafeChain.ViewModels.Admin.Staffs.StaffCreateVM()" />
}

@section Scripts {
    <script>
        // ==================== Toggle Status ====================
        function toggleStaffStatus(staffId, staffName, isActive, button) {
            const action = isActive ? 'khóa' : 'mở khóa';
            const icon = isActive ? 'warning' : 'question';

            Swal.fire({
                title: `${isActive ? 'Khóa' : 'Mở khóa'} tài khoản`,
                html: `<div class="staff-swal-message">Bạn đang yêu cầu <strong>${action}</strong> tài khoản của</div><div class="staff-swal-subject">${staffName}</div><div class="staff-swal-note">${isActive ? 'Nhân viên sẽ không thể đăng nhập cho đến khi tài khoản được mở lại.' : 'Nhân viên sẽ có thể đăng nhập và tiếp tục làm việc.'}</div>`,
                icon: icon,
                iconHtml: `<i class="fas ${isActive ? 'fa-lock' : 'fa-lock-open'}"></i>`,
                showCancelButton: true,
                confirmButtonText: isActive ? '<i class="fas fa-lock"></i> Khóa tài khoản' : '<i class="fas fa-unlock"></i> Mở khóa tài khoản',
                cancelButtonText: 'Hủy bỏ',
                reverseButtons: true,
                buttonsStyling: false,
                focusCancel: isActive,
                customClass: {
                    popup: `staff-swal-popup ${isActive ? 'staff-swal-danger' : 'staff-swal-success'}`,
                    icon: 'staff-swal-icon',
                    title: 'staff-swal-title',
                    htmlContainer: 'staff-swal-content',
                    actions: 'staff-swal-actions',
                    confirmButton: 'staff-swal-button staff-swal-confirm',
                    cancelButton: 'staff-swal-button staff-swal-cancel'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    AdminMutationGuard.run(`staff-toggle-${staffId}`, button, () => fetch(`/Admin/AdminStaff/ToggleStatus/${staffId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        }
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({ title: 'Thành công!', text: data.message, icon: 'success', timer: 1500, showConfirmButton: false })
                                .then(() => location.reload());
                        } else {
                            Swal.fire('Lỗi!', data.message, 'error');
                        }
                    })
                    .catch(() => Swal.fire('Lỗi!', 'Không thể kết nối server.', 'error')));
                }
            });
        }

        async function resetStaffPassword(accountId, staffName, button) {
            const result = await Swal.fire({
                title: 'Đặt lại mật khẩu',
                html: `<div class="staff-swal-message">Tạo mật khẩu đăng nhập mới cho</div><div class="staff-swal-subject">${staffName}</div><div class="staff-swal-note">Mật khẩu mới cần có ít nhất 6 ký tự. Hãy gửi mật khẩu cho nhân viên qua kênh an toàn.</div>`,
                icon: 'info',
                iconHtml: '<i class="fas fa-key"></i>',
                input: 'password',
                inputLabel: 'Mật khẩu mới',
                inputPlaceholder: 'Nhập tối thiểu 6 ký tự',
                inputAttributes: { minlength: 6, autocomplete: 'new-password', autocapitalize: 'off', spellcheck: 'false' },
                showCancelButton: true,
                confirmButtonText: '<i class="fas fa-key"></i> Đặt lại mật khẩu',
                cancelButtonText: 'Hủy',
                reverseButtons: true,
                buttonsStyling: false,
                customClass: {
                    popup: 'staff-swal-popup staff-swal-password',
                    icon: 'staff-swal-icon',
                    title: 'staff-swal-title',
                    htmlContainer: 'staff-swal-content',
                    input: 'staff-swal-input',
                    inputLabel: 'staff-swal-input-label',
                    validationMessage: 'staff-swal-validation',
                    actions: 'staff-swal-actions',
                    confirmButton: 'staff-swal-button staff-swal-confirm',
                    cancelButton: 'staff-swal-button staff-swal-cancel'
                },
                inputValidator: value => !value || value.length < 6 ? 'Mật khẩu phải có ít nhất 6 ký tự.' : undefined
            });
            if (!result.isConfirmed) return;

            await AdminMutationGuard.run(`staff-reset-${accountId}`, button, async () => {
                try {
                    const response = await fetch('@Url.Action("ManualResetPassword", "AdminStaff", new { area = "Admin" })', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        },
                        body: JSON.stringify({ accountId, newPassword: result.value })
                    });
                    const data = await response.json();
                    await Swal.fire(data.success ? 'Thành công' : 'Không thành công', data.message, data.success ? 'success' : 'error');
                } catch {
                    await Swal.fire('Lỗi', 'Không thể kết nối server.', 'error');
                }
            });
        }

        // ==================== TempData Messages ====================
        @if (TempData["Success"] != null)
        {
            <text>
            Swal.fire({ title: 'Thành công!', html: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Success"])), icon: 'success', timer: 2000, showConfirmButton: false });
            </text>
        }
        @if (TempData["Error"] != null)
        {
            <text>
            Swal.fire({ title: 'Lỗi!', html: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Error"])), icon: 'error' });
            </text>
        }
    </script>

    
    <form id="__AjaxAntiForgeryForm" asp-controller="AdminStaff" asp-action="ToggleStatus" method="post" style="display:none"></form>
    <partial name="_ValidationScriptsPartial" />
}
