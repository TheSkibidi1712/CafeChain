@model CafeChain.ViewModels.Admin.Staffs.StaffEditVM
@using CafeChain.Application.Constants.Cloudinaries
@{
    var provinces = ViewBag.Provinces as List<CafeChain.Models.Locations.Province> ?? new();
    ViewData["Title"] = "Cập nhật nhân viên";
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-white-orange-forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/Staff/staff.css" asp-append-version="true" />
}

<div class="admin-wo-page">
    <div class="page-header">
        <div><h3 class="fw-bold mb-0">Cập nhật nhân viên</h3><p class="mb-0">Chỉnh sửa thông tin cá nhân; vai trò và phạm vi được quản lý ở màn hình phân quyền.</p></div>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
    </div>
    <form asp-action="Edit" method="post" enctype="multipart/form-data" id="editStaffForm" class="card admin-wo-card">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="StaffId" />
        <input type="hidden" asp-for="AccountId" />
        <input type="hidden" asp-for="SelectedRoleId" />
        <input type="hidden" asp-for="ScopeTypeId" />
        <input type="hidden" asp-for="ScopeRefId" />
        <input type="hidden" asp-for="StoreId" />
        <input type="hidden" asp-for="CurrentAvatarUrl" />
        <input type="hidden" asp-for="Active" />
        <div class="card-body p-4">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6"><label asp-for="FullName" class="form-label">Họ và tên *</label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger"></span></div>
                <div class="col-md-6"><label asp-for="Email" class="form-label">Email *</label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="CCCD" class="form-label">CCCD</label><input asp-for="CCCD" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="Gender" class="form-label">Giới tính</label><select asp-for="Gender" class="form-select"><option value="0">Nữ</option><option value="1">Nam</option><option value="2">Khác</option></select></div>
                <div class="col-md-4"><label asp-for="DateOfBirth" class="form-label">Ngày sinh</label><input asp-for="DateOfBirth" type="date" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="StartDate" class="form-label">Ngày bắt đầu</label><input asp-for="StartDate" type="date" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="EmployeeStatus" class="form-label">Trạng thái nhân sự</label><select asp-for="EmployeeStatus" class="form-select"><option value="1">Thử việc</option><option value="2">Chính thức</option><option value="3">Nghỉ việc</option></select></div>
                <div class="col-md-4"><label class="form-label">Số điện thoại</label><input name="Phones[0]" value="@(Model.Phones.FirstOrDefault())" class="form-control" /></div>
                <div class="col-md-6"><label asp-for="AvatarFile" class="form-label">Ảnh đại diện</label><div class="d-flex gap-3 align-items-center"><img id="staffAvatarPreview" src="@(string.IsNullOrWhiteSpace(Model.CurrentAvatarUrl) ? DefaultImages.StaffAvatarUrl : Model.CurrentAvatarUrl)" width="56" height="56" class="rounded-circle" style="object-fit:cover" onerror="this.src='@DefaultImages.StaffAvatarUrl'" /><input asp-for="AvatarFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" /></div></div>
            </div>

            <hr class="my-4" />
            <h6 class="text-uppercase text-muted mb-3">Địa chỉ thường trú</h6>
            <div class="row g-3">
                <div class="col-md-4"><label asp-for="ProvinceId" class="form-label">Tỉnh/Thành phố *</label><select asp-for="ProvinceId" id="editProvince" class="form-select"><option value="">-- Chọn Tỉnh/Thành phố --</option>@foreach (var p in provinces) { <option value="@p.ProvinceId">@p.Name</option> }</select></div>
                <div class="col-md-4"><label asp-for="DistrictId" class="form-label">Quận/Huyện *</label><select asp-for="DistrictId" id="editDistrict" class="form-select"><option value="">-- Chọn Quận/Huyện --</option></select></div>
                <div class="col-md-4"><label asp-for="WardId" class="form-label">Phường/Xã *</label><select asp-for="WardId" id="editWard" class="form-select"><option value="">-- Chọn Phường/Xã --</option></select></div>
                <div class="col-12"><label asp-for="Address" class="form-label">Địa chỉ chi tiết *</label><input asp-for="Address" class="form-control" placeholder="Số nhà, tên đường..." /><span asp-validation-for="Address" class="text-danger"></span></div>
            </div>
        </div>
        <div class="card-footer bg-white d-flex justify-content-end gap-2 p-3"><a asp-action="Index" class="btn btn-outline-secondary">Hủy</a><button type="submit" class="btn btn-primary">Lưu thay đổi</button></div>
    </form>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
(() => {
    const province = document.getElementById('editProvince'), district = document.getElementById('editDistrict'), ward = document.getElementById('editWard');
    const initialDistrict = '@Model.DistrictId', initialWard = '@Model.WardId';
    const base = '@Url.Action("GetScopeReferences", "AdminStaff", new { area = "Admin" })';
    const load = async (select, type, parent, placeholder, selected) => {
        select.disabled = true; select.innerHTML = `<option value="">${placeholder}</option>`;
        if (!parent) return;
        const response = await fetch(`${base}?scopeTypeId=${type}&parentId=${encodeURIComponent(parent)}`);
        const rows = response.ok ? await response.json() : [];
        rows.forEach(x => select.add(new Option(x.name, x.id, false, String(x.id) === String(selected))));
        select.disabled = false;
    };
    province.addEventListener('change', async () => { ward.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>'; ward.disabled = true; await load(district, 3, province.value, '-- Chọn Quận/Huyện --', ''); });
    district.addEventListener('change', () => load(ward, 4, district.value, '-- Chọn Phường/Xã --', ''));
    (async () => { await load(district, 3, province.value, '-- Chọn Quận/Huyện --', initialDistrict); await load(ward, 4, initialDistrict, '-- Chọn Phường/Xã --', initialWard); })();
    const avatar = document.getElementById('AvatarFile');
    avatar?.addEventListener('change', () => { const file = avatar.files?.[0]; if (!file) return; document.getElementById('staffAvatarPreview').src = URL.createObjectURL(file); });
})();
</script>
}
