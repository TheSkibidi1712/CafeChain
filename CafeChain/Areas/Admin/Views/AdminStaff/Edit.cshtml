@model CafeChain.ViewModels.Admin.Staffs.StaffEditVM
@using CafeChain.Application.Constants.Cloudinaries
@{
    var provinces = ViewBag.Provinces as List<CafeChain.Models.Locations.Province> ?? new();
    ViewData["Title"] = "Cập nhật nhân viên";
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-white-orange-forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/Staff/staff.css" asp-append-version="true" />
}

<div class="admin-wo-page staff-edit-page">
    <header class="page-header staff-edit-header cc-admin-heading">
        <div class="cc-admin-heading__copy">
            <div class="cc-admin-heading__eyebrow">Nhân sự &amp; Vận hành / Quản lý nhân viên / Cập nhật</div>
            <div class="cc-admin-heading__row">
                <span class="staff-edit-heading-icon cc-admin-heading__icon" aria-hidden="true"><i class="fas fa-user-pen"></i></span>
                <div class="cc-admin-heading__text">
                    <h1>Cập nhật nhân viên</h1>
                    <p>Chỉnh sửa thông tin cá nhân; vai trò và phạm vi được quản lý ở màn hình phân quyền.</p>
                </div>
            </div>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
    </header>
    <form asp-action="Edit" method="post" enctype="multipart/form-data" id="editStaffForm" class="card admin-wo-card staff-edit-card">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="StaffId" />
        <input type="hidden" asp-for="AccountId" />
        <input type="hidden" asp-for="SelectedRoleId" />
        <input type="hidden" asp-for="ScopeTypeId" />
        <input type="hidden" asp-for="ScopeRefId" />
        <input type="hidden" asp-for="StoreId" />
        <input type="hidden" asp-for="CurrentAvatarUrl" />
        <input type="hidden" asp-for="Active" />
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="staff-form-validation text-danger mb-3"></div>
            <section class="staff-form-section">
                <div class="staff-edit-section-title"><span><i class="fas fa-id-card"></i></span><div><strong>Thông tin nhân viên</strong><small>Thông tin định danh và trạng thái làm việc hiện tại.</small></div></div>
                <div class="row g-3">
                <div class="col-md-6"><label asp-for="FullName" class="form-label">Họ và tên *</label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger"></span></div>
                <div class="col-md-6"><label asp-for="Email" class="form-label">Email *</label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="CCCD" class="form-label">CCCD</label><input asp-for="CCCD" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="Gender" class="form-label">Giới tính</label><select asp-for="Gender" class="form-select"><option value="0">Nữ</option><option value="1">Nam</option><option value="2">Khác</option></select></div>
                <div class="col-md-4"><label asp-for="DateOfBirth" class="form-label">Ngày sinh</label><input asp-for="DateOfBirth" type="date" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="StartDate" class="form-label">Ngày bắt đầu</label><input asp-for="StartDate" type="date" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="EmployeeStatus" class="form-label">Trạng thái nhân sự</label><select asp-for="EmployeeStatus" class="form-select"><option value="1">Thử việc</option><option value="2">Chính thức</option><option value="3">Nghỉ việc</option></select></div>
                <div class="col-md-4"><label class="form-label">Số điện thoại</label><input name="Phones[0]" value="@(Model.Phones.FirstOrDefault())" class="form-control" /></div>
                    <div class="col-12"><label asp-for="AvatarFile" class="form-label">Ảnh đại diện</label><div class="staff-edit-avatar d-flex gap-3 align-items-center"><img id="staffAvatarPreview" src="@(string.IsNullOrWhiteSpace(Model.CurrentAvatarUrl) ? DefaultImages.StaffAvatarUrl : Model.CurrentAvatarUrl)" width="64" height="64" class="rounded-circle" onerror="this.src='@DefaultImages.StaffAvatarUrl'" /><div class="staff-edit-avatar-control"><input asp-for="AvatarFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" /><small>JPG, PNG hoặc WebP · dung lượng tối đa 2 MB.</small></div></div></div>
                </div>
            </section>

            <section class="staff-form-section">
                <div class="staff-edit-section-title"><span><i class="fas fa-location-dot"></i></span><div><strong>Địa chỉ thường trú</strong><small>Thông tin khu vực và địa chỉ liên hệ của nhân viên.</small></div></div>
                <div class="row g-3">
                <div class="col-md-6"><label asp-for="ProvinceId" class="form-label">Tỉnh/Thành phố *</label><select asp-for="ProvinceId" id="editProvince" class="form-select"><option value="">-- Chọn Tỉnh/Thành phố --</option>@foreach (var p in provinces) { <option value="@p.ProvinceId">@p.Name</option> }</select></div>
                <div class="col-md-6"><label asp-for="WardId" class="form-label">Xã/Phường/Đặc khu *</label><select asp-for="WardId" id="editWard" class="form-select"><option value="">-- Chọn Xã/Phường/Đặc khu --</option></select></div>
                <div class="col-12"><label asp-for="Address" class="form-label">Địa chỉ chi tiết *</label><input asp-for="Address" class="form-control" placeholder="Số nhà, tên đường..." /><span asp-validation-for="Address" class="text-danger"></span></div>
                </div>
            </section>
        </div>
        <div class="card-footer staff-form-actions"><span class="staff-form-actions__hint"><i class="fas fa-circle-info"></i> Các trường có dấu * là bắt buộc.</span><div><a asp-action="Index" class="btn btn-outline-secondary">Hủy</a><button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk me-1"></i>Lưu thay đổi</button></div></div>
    </form>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
(() => {
    const province = document.getElementById('editProvince'), ward = document.getElementById('editWard');
    const initialWard = '@Model.WardId';
    const wardsEndpoint = '@Url.Action("GetWards", "AdminStaff", new { area = "Admin" })';
    let wardRequestVersion = 0;
    const reset = (select, placeholder) => {
        select.disabled = true; select.innerHTML = `<option value="">${placeholder}</option>`;
    };
    const load = async (select, url, parameter, parent, placeholder, selected, isCurrent) => {
        reset(select, 'Đang tải...');
        if (!parent) { reset(select, placeholder); return []; }
        try {
            const response = await fetch(`${url}?${parameter}=${encodeURIComponent(parent)}`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            if (!response.ok) throw new Error();
            const rows = await response.json();
            if (!isCurrent()) return [];
            reset(select, placeholder);
            rows.forEach(x => select.add(new Option(x.name, x.id, false, String(x.id) === String(selected))));
            select.disabled = rows.length === 0;
            return rows;
        } catch {
            if (isCurrent()) reset(select, 'Không tải được dữ liệu');
            return [];
        }
    };
    province.addEventListener('change', async () => {
        const parentProvinceId = province.value;
        const version = ++wardRequestVersion;
        reset(ward, '-- Chọn Xã/Phường/Đặc khu --');
        if (parentProvinceId) await load(ward, wardsEndpoint, 'provinceId', parentProvinceId, '-- Chọn Xã/Phường/Đặc khu --', '', () => version === wardRequestVersion && province.value === parentProvinceId);
    });
    (async () => {
        const provinceId = province.value;
        const wardVersion = ++wardRequestVersion;
        await load(ward, wardsEndpoint, 'provinceId', provinceId, '-- Chọn Xã/Phường/Đặc khu --', initialWard, () => wardVersion === wardRequestVersion && province.value === provinceId);
    })();
    const avatar = document.getElementById('AvatarFile');
    avatar?.addEventListener('change', () => { const file = avatar.files?.[0]; if (!file) return; document.getElementById('staffAvatarPreview').src = URL.createObjectURL(file); });
})();
</script>
}
