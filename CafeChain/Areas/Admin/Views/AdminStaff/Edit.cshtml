@model CafeChain.ViewModels.Admin.Staffs.StaffEditVM
@{
    var roles = ViewBag.Roles as List<CafeChain.Models.Permissions.Role>;
    var stores = ViewBag.Stores as List<CafeChain.Models.Stores.Store>;
    var scopeTypes = ViewBag.ScopeTypes as List<CafeChain.Models.Staffs.ScopeType>;
    ViewData["Title"] = "Cập nhật nhân viên";
    Layout = "_AdminLayout";

    string GetScopeForRole(int roleId) => roleId switch
    {
        >= 1 and <= 6 => "HQ",
        7 => "PROVINCE",
        _ => "STORE"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-white-orange-forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/Staff/staff.css" asp-append-version="true" />
}

<div class="admin-wo-page">
    <div class="page-header">
        <div class="d-flex align-items-center gap-3">
            <div style="width:46px;height:46px;border-radius:12px;background:#fff7ed;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="fas fa-user-edit" style="font-size:20px;color:#f97316;"></i>
            </div>
            <div>
                <h3 class="fw-bold mb-0">Cập nhật nhân viên</h3>
                <p class="mb-0">Thiết lập thông tin, vai trò và quyền hạn</p>
            </div>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary d-flex align-items-center gap-2">
            <i class="fas fa-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" id="editStaffForm">
        <input type="hidden" asp-for="StaffId" />
        <input type="hidden" asp-for="AccountId" />
        <input type="hidden" asp-for="CurrentAvatarUrl" />
        <input type="hidden" asp-for="ScopeTypeId" id="HiddenScopeTypeId" />
        <input type="hidden" asp-for="ScopeRefId" id="HiddenScopeRefId" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="card admin-wo-card">
            <div class="card-header border-bottom-0 pb-0 pt-3">
                <ul class="nav nav-tabs" id="staffTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="tab-general" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab">Thông tin chung</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-job" data-bs-toggle="tab" data-bs-target="#job" type="button" role="tab">Công việc & Lương</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-ot" data-bs-toggle="tab" data-bs-target="#ot" type="button" role="tab">OT & Ca</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-dependent" data-bs-toggle="tab" data-bs-target="#dependent" type="button" role="tab">Người phụ thuộc</button>
                    </li>
                </ul>
            </div>
            <div class="card-body p-4">
                <div class="tab-content" id="staffTabsContent">

                    <!-- ═══════ TAB 1: THÔNG TIN CHUNG ═══════ -->
                    <div class="tab-pane fade show active" id="general" role="tabpanel">
                        <div class="row">
                            <div class="col-md-3 mb-4 d-flex justify-content-center">
                                <div>
                                    <label class="form-label">Ảnh đại diện</label>
                                    <div class="avatar-upload-box" onclick="document.getElementById('avatarInput').click()">
                                        <img id="avatarPreview" src="@Model.CurrentAvatarUrl" />
                                    </div>
                                    <input type="file" name="AvatarFile" id="avatarInput" class="d-none" accept="image/*" onchange="previewAvatar(this)" />
                                </div>
                            </div>
                            <div class="col-md-9">
                                <div class="row">
                                    <div class="col-lg-6 mb-3">
                                        <label class="form-label text-danger">Vai trò hệ thống *</label>
                                        <select asp-for="SelectedRoleId" class="form-select" id="dynamicRoleSelect">
                                            <option value="">-- Chọn vai trò --</option>
                                            @if (roles != null)
                                            {
                                                foreach (var r in roles)
                                                {
                                                    string constraint = r.RoleId <= 6 ? "HQ" : (r.RoleId == 7 ? "FLEXIBLE" : "STORE_ONLY");
                                                    <option value="@r.RoleId" data-constraint="@constraint">@r.Name</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-lg-6 mb-3">
                                        <label class="form-label">Họ và tên <span class="text-danger">*</span></label>
                                        <input asp-for="FullName" class="form-control" />
                                    </div>
                                    <div class="col-lg-6 mb-3">
                                        <label class="form-label">Email đăng nhập <span class="text-danger">*</span></label>
                                        <input asp-for="Email" type="email" class="form-control" autocomplete="email" />
                                        <div class="form-text">
                                            Email dùng để đăng nhập và nhận OTP ca trưởng nếu nhân viên có quyền phù hợp.
                                        </div>
                                        <span asp-validation-for="Email" class="text-danger small"></span>
                                    </div>
                                    <div class="col-lg-6 mb-3">
                                        <label class="form-label text-warning">Đổi mật khẩu (Tuỳ chọn)</label>
                                        <input type="password" asp-for="NewPassword" class="form-control" placeholder="Để trống nếu không đổi..." />
                                    </div>
                                    <div class="col-lg-4 mb-3">
                                        <label class="form-label">Căn cước công dân</label>
                                        <input asp-for="CCCD" class="form-control" />
                                    </div>
                                    <div class="col-lg-4 mb-3">
                                        <label class="form-label">Ngày sinh</label>
                                        <input asp-for="DateOfBirth" type="text" class="form-control flatpickr-date" />
                                    </div>
                                    <div class="col-lg-4 mb-3">
                                        <label class="form-label">Giới tính</label>
                                        <select asp-for="Gender" class="form-select">
                                            <option value="0">Nữ</option>
                                            <option value="1">Nam</option>
                                            <option value="2">Khác</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-lg-6 mb-3">
                                        <label class="form-label">Số điện thoại</label>
                                        <div id="phonesContainerModal">
                                            @for (int i = 0; i < Model.Phones.Count; i++)
                                            {
                                                <div class="dynamic-input-group d-flex mb-2">
                                                    <input name="Phones[@i]" value="@Model.Phones[i]" class="form-control me-2 phone-input" />
                                                    <button type="button" class="btn btn-sm btn-danger" onclick="removeDynamicInput(this, 'phonesContainerModal', 'Phones', 'phone-input')"><i class="fas fa-trash"></i></button>
                                                </div>
                                            }
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-secondary text-primary border-primary fw-bold" onclick="addDynamicInput('phonesContainerModal', 'Phones', 3, 'Nhập số điện thoại')"><i class="fas fa-plus"></i></button>
                                    </div>
                                    <div class="col-lg-6 mb-3">
                                        <label class="form-label">Địa chỉ liên hệ</label>
                                        <div id="addressesContainerModal">
                                            @for (int i = 0; i < Model.Addresses.Count; i++)
                                            {
                                                <div class="dynamic-input-group d-flex mb-2">
                                                    <input name="Addresses[@i]" value="@Model.Addresses[i]" class="form-control me-2 addr-input" />
                                                    <button type="button" class="btn btn-sm btn-danger" onclick="removeDynamicInput(this, 'addressesContainerModal', 'Addresses', 'addr-input')"><i class="fas fa-trash"></i></button>
                                                </div>
                                            }
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-secondary text-primary border-primary fw-bold" onclick="addDynamicInput('addressesContainerModal', 'Addresses', 3, 'Nhập địa chỉ')"><i class="fas fa-plus"></i></button>
                                    </div>

                                    <!-- NHÓM PHÂN QUYỀN -->
                                    <div class="col-12 mt-2">
                                        <h6 class="scope-section-title"><i class="fas fa-shield-alt me-1"></i> Nhóm phân quyền</h6>
                                    </div>
                                    
                                    <div class="col-lg-4 mb-3">
                                        <label class="form-label text-danger">Loại phạm vi *</label>
                                        <select class="form-select" id="uiScopeTypeSelect">
                                            <option value="">-- Xin vui lòng chọn --</option>
                                            <option value="2">Tỉnh/TP</option>
                                            <option value="3">Phường/Xã</option>
                                            <option value="4">Cửa hàng</option>
                                            <option value="1">Trụ sở (HQ)</option>
                                        </select>
                                    </div>
                                    
                                    <div class="col-lg-4 mb-3" id="scopeRefContainer">
                                        <label class="form-label text-danger" id="lblScopeRef">Mã tham chiếu *</label>
                                        <select class="form-select mb-2" id="uiCascadingProvince" style="display:none;">
                                            <option value="">-- Chọn Tỉnh/Thành phố trước --</option>
                                        </select>
                                        <select class="form-select" id="uiScopeRefSelect">
                                            <option value="">-- Bấm để chọn địa bàn --</option>
                                        </select>
                                    </div>
                                    
                                    <div class="col-lg-4 mb-3">
                                        <label class="form-label">Cửa hàng đồng bộ</label>
                                        <select asp-for="StoreId" class="form-select" id="uiSyncStoreSelect">
                                            <option value="">-- Tự động --</option>
                                            @if (stores != null)
                                            {
                                                foreach (var s in stores)
                                                {
                                                    <option value="@s.StoreId">@s.Name</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ═══════ TAB 2: CÔNG VIỆC & LƯƠNG ═══════ -->
                    <div class="tab-pane fade" id="job" role="tabpanel">
                        <div class="row">


                            <div class="col-12"><hr class="text-muted" /></div>
                            <div class="col-lg-4 mb-3">
                                <label class="form-label">Hình thức trả lương</label>
                                <select asp-for="SalaryType" class="form-select" id="SalaryTypeSelect">
                                    <option value="1">Cố định</option>
                                    <option value="2">Theo giờ</option>
                                </select>
                            </div>
                            <div class="col-lg-4 mb-3">
                                <label class="form-label">Lương gốc (VNĐ)</label>
                                <input asp-for="BaseSalary" type="number" class="form-control" />
                            </div>
                            <div class="col-lg-4 mb-3">
                                <label class="form-label">Phụ cấp (VNĐ)</label>
                                <input asp-for="Allowance" type="number" class="form-control" />
                            </div>
                            <div class="col-lg-4 mb-3">
                                <label class="form-label">Sổ BHXH</label>
                                <input asp-for="SocialInsuranceNumber" class="form-control" />
                            </div>
                            <div class="col-lg-4 mb-3">
                                <label class="form-label">Sổ BHYT</label>
                                <input asp-for="HealthInsuranceNumber" class="form-control" />
                            </div>
                            <div class="col-lg-4 mb-3">
                                <label class="form-label">Mã số thuế cá nhân</label>
                                <input asp-for="TaxCode" class="form-control" />
                            </div>
                            <div class="col-12 mt-3">
                                <h6 class="fw-bold mb-3" style="color:#ea580c;"><i class="fas fa-university me-2"></i>Tài khoản ngân hàng</h6>
                                <div class="table-responsive">
                                    <table class="table table-bordered table-sm align-middle text-center banks-table" id="banksTableModal">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Chính</th>
                                                <th>Ngân Hàng</th>
                                                <th>Số Tài Khoản</th>
                                                <th>Chủ Tài Khoản</th>
                                                <th style="width: 50px;"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.Banks != null && Model.Banks.Any())
                                            {
                                                for (int i = 0; i < Model.Banks.Count; i++)
                                                {
                                                    <tr>
                                                        <td>
                                                            <input type="radio" name="PrimaryBankIndex" value="@i" @(Model.Banks[i].IsPrimary ? "checked" : "") class="form-check-input" />
                                                        </td>
                                                        <td><input type="text" name="Banks[@i].BankName" value="@Model.Banks[i].BankName" class="form-control form-control-sm bank-name" placeholder="VD: MBBank" /></td>
                                                        <td><input type="text" name="Banks[@i].AccountNumber" value="@Model.Banks[i].AccountNumber" class="form-control form-control-sm bank-acc" /></td>
                                                        <td><input type="text" name="Banks[@i].AccountHolderName" value="@Model.Banks[i].AccountHolderName" class="form-control form-control-sm bank-holder text-uppercase" /></td>
                                                        <td><button type="button" class="btn btn-sm btn-danger border-0" onclick="removeBankRowModal(this)"><i class="fas fa-trash"></i></button></td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                    <button type="button" class="btn btn-sm btn-outline-primary fw-bold" onclick="addBankRowModal()"><i class="fas fa-plus me-1"></i>Thêm tài khoản</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ═══════ TAB 3: OT & CA ═══════ -->
                    <div class="tab-pane fade" id="ot" role="tabpanel">
                        <div class="row">
                            <div class="col-lg-6 mb-3">
                                <label class="form-label">Hệ số Thử việc</label>
                                <input asp-for="ProbationRate" id="ProbationRateInput" type="number" class="form-control" step="0.01" />
                                <small class="text-muted">Tỷ lệ nhân lương trong giai đoạn thử việc</small>
                            </div>
                            <div class="col-lg-6 mb-3">
                                <label class="form-label">Hệ số Nhân lương OT</label>
                                <input asp-for="OvertimeRate" type="number" class="form-control" step="0.1" />
                                <small class="text-muted">Hệ số nhân cho giờ làm thêm</small>
                            </div>
                        </div>
                    </div>

                    <!-- ═══════ TAB 4: NGƯỜI PHỤ THUỘC ═══════ -->
                    <div class="tab-pane fade" id="dependent" role="tabpanel">
                        <table class="table table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th class="small text-uppercase">Họ và Tên</th>
                                    <th class="small text-uppercase">Ngày sinh</th>
                                    <th class="small text-uppercase">Mã số Thuế</th>
                                    <th class="small text-uppercase">Quan hệ</th>
                                    <th class="text-center" style="width: 80px;"><i class="fas fa-cog"></i></th>
                                </tr>
                            </thead>
                            <tbody id="dependentsTableBody">
                                @if (Model.Dependents != null)
                                {
                                    for (int i = 0; i < Model.Dependents.Count; i++)
                                    {
                                        <tr>
                                            <td><input name="Dependents[@i].FullName" value="@Model.Dependents[i].FullName" class="form-control dep-fullName" /></td>
                                            <td><input name="Dependents[@i].DateOfBirth" value="@Model.Dependents[i].DateOfBirth?.ToString("yyyy-MM-dd")" class="form-control dep-date flatpickr-date" /></td>
                                            <td><input name="Dependents[@i].TaxCode" value="@Model.Dependents[i].TaxCode" class="form-control dep-taxCode" /></td>
                                            <td>
                                                <select name="Dependents[@i].Relationship" class="form-select dep-rel">
                                                    <option value="Con" selected="@(Model.Dependents[i].Relationship == "Con" ? "selected" : null)">Con</option>
                                                    <option value="Vợ/Chồng" selected="@(Model.Dependents[i].Relationship == "Vợ/Chồng" ? "selected" : null)">Vợ/Chồng</option>
                                                    <option value="Bố/Mẹ" selected="@(Model.Dependents[i].Relationship == "Bố/Mẹ" ? "selected" : null)">Bố/Mẹ</option>
                                                    <option value="Khác" selected="@(Model.Dependents[i].Relationship == "Khác" ? "selected" : null)">Khác</option>
                                                </select>
                                            </td>
                                            <td class="text-center"><button type="button" class="btn btn-link text-danger p-0" onclick="removeDependentRow(this)"><i class="fas fa-trash-alt"></i></button></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                        <div class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-primary fw-bold" onclick="addDependentRow()">
                                <i class="fas fa-plus"></i> Thêm Người phụ thuộc
                            </button>
                        </div>
                    </div>

                </div>
            </div>
            <div class="card-footer text-end border-0 pb-4 pe-4" style="background:#f8fafc;border-top:1px solid #e5e7eb;">
                <a asp-action="Index" class="btn btn-outline-secondary me-2">
                    <i class="fas fa-times me-1"></i> Hủy
                </a>
                <button type="button" class="btn btn-primary px-5" onclick="validateAndSubmit(this)">
                    <i class="fas fa-save me-1"></i> Lưu thay đổi
                </button>
            </div>
        </div>
    </form>
</div>

<link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://npmcdn.com/flatpickr/dist/l10n/vn.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    // ═══════════════════════════════════════════════════════
    // ROLE → SCOPE AUTO-RESOLVER (data-scope attribute driven)
    // ═══════════════════════════════════════════════════════
    const roleSelect = document.getElementById('dynamicRoleSelect');
    const typeSelect = document.getElementById('uiScopeTypeSelect');
    const refSelect = document.getElementById('uiScopeRefSelect');
    const provSelect = document.getElementById('uiCascadingProvince');
    const syncStore = document.getElementById('uiSyncStoreSelect');
    const lblScopeRef = document.getElementById('lblScopeRef');

    const hiddenScopeTypeId = document.getElementById('HiddenScopeTypeId');
    const hiddenScopeRefId = document.getElementById('HiddenScopeRefId');
    const existingScopeRefId = '@Model.ScopeRefId';
    const existingScopeTypeId = '@Model.ScopeTypeId';

    const storesCache = [
        @if(stores != null) { foreach(var s in stores) { <text>{ id: @s.StoreId, name: '@s.Name', parentId: '@s.WardId' },</text> } }
    ];

    async function initEditState() {
        const selected = roleSelect.options[roleSelect.selectedIndex];
        if (!selected) return;
        const constraint = selected.getAttribute('data-constraint');

        if (constraint === 'HQ') {
            typeSelect.value = "1";
            typeSelect.disabled = true;
            provSelect.style.display = 'none';
            refSelect.innerHTML = '<option value="1">Trụ sở chính</option>';
            refSelect.disabled = true;
        } else if (constraint === 'STORE_ONLY') {
            typeSelect.value = "4";
            typeSelect.disabled = true;
            lblScopeRef.textContent = "Chọn Cửa hàng *";
            provSelect.style.display = 'none';
            await fetchRefData(4, null, existingScopeRefId);
        } else if (constraint === 'FLEXIBLE') {
            typeSelect.disabled = false;
            // Restore from Model
            if (existingScopeTypeId) {
                // Backend store scope is 5; UI store option is 4.
                const uiType = existingScopeTypeId === "5" ? "4" : existingScopeTypeId;
                typeSelect.value = uiType;
                if (existingScopeTypeId === "1") {
                    lblScopeRef.textContent = "Mã tham chiếu *";
                    provSelect.style.display = 'none';
                    refSelect.innerHTML = '<option value="1">Trụ sở chính</option>';
                    refSelect.disabled = true;
                } else if (existingScopeTypeId === "3") {
                    lblScopeRef.textContent = "Chọn Phường/Xã *";
                    provSelect.style.display = 'block';
                    refSelect.disabled = false;
                    await loadCascadingProvinces();
                    await fetchRefData(3, null, existingScopeRefId); 
                } else {
                    const fetchType = existingScopeTypeId === "5" ? 4 : parseInt(existingScopeTypeId, 10);
                    lblScopeRef.textContent = existingScopeTypeId === "2" ? "Chọn Tỉnh/Thành phố *" : "Chọn Cửa hàng *";
                    provSelect.style.display = 'none';
                    refSelect.disabled = false;
                    await fetchRefData(fetchType, null, existingScopeRefId);
                }
            }
        }
        // Always re-sync hiddens from model fallbacks if UI left blanks.
        syncScopeData();
    }

    // ===================================
    // Role Change Logic
    // ===================================
    roleSelect.addEventListener('change', function () {
        const selected = this.options[this.selectedIndex];
        if (!selected || !selected.value) {
            resetScopeUI();
            return;
        }
        
        const constraint = selected.getAttribute('data-constraint');
        
        if (constraint === 'HQ') {
            typeSelect.value = "1";
            typeSelect.disabled = true;
            provSelect.style.display = 'none';
            refSelect.innerHTML = '<option value="1">Trụ sở chính</option>';
            refSelect.disabled = true;
            syncStore.value = "";
            syncStore.disabled = true;
            syncScopeData();
        } else if (constraint === 'STORE_ONLY') {
            typeSelect.value = "4";
            typeSelect.disabled = true;
            provSelect.style.display = 'none';
            lblScopeRef.textContent = "Chọn Cửa hàng *";
            refSelect.disabled = false;
            fetchRefData(4);
        } else if (constraint === 'FLEXIBLE') {
            typeSelect.value = "";
            typeSelect.disabled = false;
            provSelect.style.display = 'none';
            lblScopeRef.textContent = "Mã tham chiếu *";
            refSelect.innerHTML = '<option value="">-- Bấm để chọn địa bàn --</option>';
            refSelect.disabled = true;
            syncStore.value = "";
            syncStore.disabled = false;
            syncScopeData();
        }
    });

    // ===================================
    // Scope Type Logic
    // ===================================
    typeSelect.addEventListener('change', function() {
        var tId = parseInt(this.value);
        provSelect.style.display = 'none';

        if (isNaN(tId)) {
            lblScopeRef.textContent = "Mã tham chiếu *";
            refSelect.innerHTML = '<option value="">-- Bấm để chọn địa bàn --</option>';
            refSelect.disabled = true;
            syncScopeData();
            return;
        }
        
        if (tId === 1) lblScopeRef.textContent = "Mã tham chiếu *";
        else if (tId === 2) lblScopeRef.textContent = "Chọn Tỉnh/Thành phố *";
        else if (tId === 3) lblScopeRef.textContent = "Chọn Phường/Xã *";
        else if (tId === 4) lblScopeRef.textContent = "Chọn Cửa hàng *";

        if (tId === 1) {
            refSelect.innerHTML = '<option value="1">Trụ sở chính</option>';
            refSelect.disabled = true;
            syncStore.value = "";
            syncScopeData();
            return;
        }

        if (tId === 2 || tId === 4) {
            refSelect.disabled = false;
            fetchRefData(tId, null);
        } else if (tId === 3) {
            provSelect.style.display = 'block';
            refSelect.disabled = true;
            refSelect.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
            loadCascadingProvinces();
        }
    });

    // ===================================
    // Cascading Logic (Ward)
    // ===================================
    async function loadCascadingProvinces() {
        provSelect.innerHTML = '<option value="">Đang tải Tỉnh/Thành...</option>';
        try {
            const res = await fetch(`@Url.Action("GetScopeReferences", "AdminStaff", new { area = "Admin" })?scopeTypeId=2`);
            const data = await res.json();
            provSelect.innerHTML = '<option value="">-- Chọn Tỉnh/Thành phố trước --</option>';
            data.forEach((p) => {
                const opt = document.createElement('option');
                opt.value = p.id;
                opt.textContent = p.name;
                provSelect.appendChild(opt);
            });
        } catch (e) {
            provSelect.innerHTML = '<option value="">Lỗi tải dữ liệu</option>';
        }
    }

    provSelect.addEventListener('change', function() {
        if (!this.value) {
            refSelect.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
            refSelect.disabled = true;
            syncScopeData();
            return;
        }
        // Fetch ward based on Province
        refSelect.disabled = false;
        fetchRefData(3, this.value);
    });

    async function fetchRefData(scopeTypeId, parentId, autoSelectValue = null) {
        refSelect.innerHTML = '<option value="">Đang tải...</option>';
        try {
            let url = `@Url.Action("GetScopeReferences", "AdminStaff", new { area = "Admin" })?scopeTypeId=${scopeTypeId}`;
            if (parentId) url += `&parentId=${parentId}`;
            
            const res = await fetch(url);
            const data = await res.json();
            
            refSelect.innerHTML = '<option value="">-- Xin vui lòng chọn --</option>';
            data.forEach((p) => {
                const opt = document.createElement('option');
                opt.value = p.id;
                opt.textContent = p.name;
                if (autoSelectValue && String(p.id) === autoSelectValue) {
                    opt.selected = true;
                }
                refSelect.appendChild(opt);
            });
            
            if (!autoSelectValue && data.length > 0 && scopeTypeId === 4) {
                refSelect.selectedIndex = 1;
                refSelect.dispatchEvent(new Event('change'));
            } else {
                syncScopeData();
            }
        } catch (e) {
            console.error('Lỗi tải ScopeReferences:', e);
            refSelect.innerHTML = '<option value="">Lỗi tải dữ liệu</option>';
        }
    }

    refSelect.addEventListener('change', function() {
        const tId = parseInt(typeSelect.value);
        const rVal = this.value;
        if (tId === 4 && rVal) syncStore.value = rVal;
        syncScopeData();
    });

    syncStore.addEventListener('change', syncScopeData);

    function syncScopeData() {
        // Do NOT wipe existing hidden values with "" — empty string posts break non-nullable int binding
        // ("The value '' is invalid.") for ScopeTypeId / ScopeRefId.
        const typeVal = typeSelect.value;
        if (typeVal) {
            // UI uses "4" for store picker; backend ScopeType STORE = 5.
            hiddenScopeTypeId.value = typeVal === "4" ? "5" : typeVal;
        } else if (existingScopeTypeId) {
            hiddenScopeTypeId.value = existingScopeTypeId;
        }

        const refVal = refSelect.value;
        if (refVal) {
            hiddenScopeRefId.value = refVal;
        } else if (existingScopeRefId) {
            hiddenScopeRefId.value = existingScopeRefId;
        }
    }

    function resetScopeUI() {
        typeSelect.value = "";
        typeSelect.disabled = false;
        provSelect.style.display = 'none';
        lblScopeRef.textContent = "Mã tham chiếu *";
        refSelect.innerHTML = '<option value="">-- Bấm để chọn địa bàn --</option>';
        refSelect.disabled = true;
        syncStore.value = "";
        syncStore.disabled = false;
        syncScopeData();
    }

    // ═══════════════════════════════════════════════════════
    // DEPENDENTS
    // ═══════════════════════════════════════════════════════
    function addDependentRow() {
        const tbody = document.getElementById('dependentsTableBody');
        const index = tbody.children.length;
        const row = document.createElement('tr');
        row.innerHTML = `
            <td><input name="Dependents[${index}].FullName" class="form-control dep-fullName" placeholder="Nhập tên..." /></td>
            <td><input name="Dependents[${index}].DateOfBirth" class="form-control dep-date flatpickr-date" placeholder="Chọn ngày" /></td>
            <td><input name="Dependents[${index}].TaxCode" class="form-control dep-taxCode" placeholder="Mã số thuế" /></td>
            <td>
                <select name="Dependents[${index}].Relationship" class="form-select dep-rel">
                    <option value="Con">Con</option>
                    <option value="Vợ/Chồng">Vợ/Chồng</option>
                    <option value="Bố/Mẹ">Bố/Mẹ</option>
                    <option value="Khác">Khác</option>
                </select>
            </td>
            <td class="text-center"><button type="button" class="btn btn-link text-danger p-0" onclick="removeDependentRow(this)"><i class="fas fa-trash-alt"></i></button></td>
        `;
        tbody.appendChild(row);
        flatpickr(row.querySelector('.flatpickr-date'), { dateFormat: "Y-m-d", altInput: true, altFormat: "d/m/Y", locale: "vn" });
    }

    function removeDependentRow(btn) {
        btn.closest('tr').remove();
        document.getElementById('dependentsTableBody').querySelectorAll('tr').forEach((row, i) => {
            row.querySelector('.dep-fullName').name = `Dependents[${i}].FullName`;
            row.querySelector('.dep-date').name = `Dependents[${i}].DateOfBirth`;
            row.querySelector('.dep-taxCode').name = `Dependents[${i}].TaxCode`;
            if (row.querySelector('.dep-rel')) {
                row.querySelector('.dep-rel').name = `Dependents[${i}].Relationship`;
            }
        });
    }

    // ═══════════════════════════════════════════════════════
    // BANKS
    // ═══════════════════════════════════════════════════════
    function addBankRowModal() {
        const tbody = document.querySelector('#banksTableModal tbody');
        const index = tbody.children.length;
        const row = document.createElement('tr');
        row.innerHTML = `
            <td>
                <input type="radio" name="PrimaryBankIndex" value="${index}" class="form-check-input" />
            </td>
            <td><input type="text" name="Banks[${index}].BankName" class="form-control form-control-sm bank-name" placeholder="VD: MBBank" /></td>
            <td><input type="text" name="Banks[${index}].AccountNumber" class="form-control form-control-sm bank-acc" /></td>
            <td><input type="text" name="Banks[${index}].AccountHolderName" class="form-control form-control-sm bank-holder text-uppercase" /></td>
            <td><button type="button" class="btn btn-sm btn-danger border-0" onclick="removeBankRowModal(this)"><i class="fas fa-trash"></i></button></td>
        `;
        tbody.appendChild(row);
    }

    function removeBankRowModal(btn) {
        const tbody = document.querySelector('#banksTableModal tbody');
        btn.closest('tr').remove();
        
        tbody.querySelectorAll('tr').forEach((row, index) => {
            row.querySelector('input[type="radio"]').value = index;
            row.querySelector('.bank-name').name = `Banks[${index}].BankName`;
            row.querySelector('.bank-acc').name = `Banks[${index}].AccountNumber`;
            row.querySelector('.bank-holder').name = `Banks[${index}].AccountHolderName`;
        });
        
        if (tbody.children.length > 0) {
            const anyChecked = Array.from(tbody.querySelectorAll('input[type="radio"]')).some(r => r.checked);
            if (!anyChecked) {
                tbody.querySelector('input[type="radio"]').checked = true;
            }
        }
    }

    // ═══════════════════════════════════════════════════════
    // UTILITIES
    // ═══════════════════════════════════════════════════════
    function previewAvatar(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) { document.getElementById('avatarPreview').src = e.target.result; };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function addDynamicInput(containerId, fieldName, maxCount, placeholder) {
        const container = document.getElementById(containerId);
        const currentCount = container.querySelectorAll('.dynamic-input-group').length;
        if (currentCount >= maxCount) return alert('Tối đa ' + maxCount + ' dòng');
        const inputClass = fieldName === 'Phones' ? 'phone-input' : 'addr-input';
        const div = document.createElement('div');
        div.className = 'dynamic-input-group d-flex mb-2';
        div.innerHTML = `<input name="${fieldName}[${currentCount}]" class="form-control me-2 ${inputClass}" placeholder="${placeholder}" />
                         <button type="button" class="btn btn-sm btn-danger" onclick="removeDynamicInput(this, '${containerId}', '${fieldName}', '${inputClass}')"><i class="fas fa-trash"></i></button>`;
        container.appendChild(div);
    }

    function removeDynamicInput(btn, containerId, fieldName, inputClass) {
        btn.parentElement.remove();
        document.getElementById(containerId).querySelectorAll(`.${inputClass}`).forEach((input, i) => { input.name = `${fieldName}[${i}]`; });
    }

    function validateAndSubmit(btn) {
        const form = document.getElementById('editStaffForm');
        const roleEl = form.querySelector('[name="SelectedRoleId"]');
        if (!roleEl.value) return Swal.fire('Cảnh báo', 'Vui lòng chọn Vai trò!', 'warning');
        if (!form.querySelector('[name="FullName"]').value) return Swal.fire('Cảnh báo', 'Vui lòng nhập Họ và Tên!', 'warning');
        const emailEl = form.querySelector('[name="Email"]');
        if (emailEl && !emailEl.value.trim()) return Swal.fire('Cảnh báo', 'Vui lòng nhập Email!', 'warning');

        // Keep scope hiddens valid before submit (avoid "" on non-nullable ints).
        syncScopeData();
        if (!hiddenScopeTypeId.value) {
            return Swal.fire('Cảnh báo', 'Vui lòng chọn phạm vi quản lý!', 'warning');
        }
        if (!hiddenScopeRefId.value) {
            return Swal.fire('Cảnh báo', 'Vui lòng chọn phạm vi / cửa hàng tham chiếu!', 'warning');
        }

        // Optional StoreId: if placeholder "-- Tự động --" selected, keep current store from model.
        if (syncStore && !syncStore.value && '@(Model.StoreId?.ToString() ?? "")') {
            syncStore.value = '@(Model.StoreId?.ToString() ?? "")';
        }

        btn.disabled = true;
        btn.innerHTML = 'Đang xử lý...';
        form.submit();
    }

    // ═══════════════════════════════════════════════════════
    // INIT: Apply scope for existing role on page load
    // ═══════════════════════════════════════════════════════
    document.addEventListener('DOMContentLoaded', function () {
        flatpickr(".flatpickr-date", {
            dateFormat: "Y-m-d",
            altInput: true,
            altFormat: "d/m/Y",
            locale: "vn",
            allowInput: true
        });
        // Ensure hidden scope values are coherent after async initEditState.
        if (roleSelect.value) {
            initEditState().then(() => syncScopeData());
        } else {
            syncScopeData();
        }
    });
</script>
