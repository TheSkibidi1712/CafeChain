@model CafeChain.ViewModels.Admin.Staffs.StaffEditVM
@using CafeChain.Application.Constants.Cloudinaries
@using Microsoft.Extensions.Localization
@using System.Text.Json
@inject IStringLocalizer<StaffResource> L
@{
    var provinces = ViewBag.Provinces as List<CafeChain.Models.Locations.Province> ?? new();
    ViewData["Title"] = L["Staff.Edit.Title"].Value;
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-white-orange-forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/Staff/staff.css" asp-append-version="true" />
}

<div class="admin-wo-page staff-edit-page">
    <header class="page-header staff-edit-header cc-admin-heading">
        <div class="cc-admin-heading__copy">
            <div class="cc-admin-heading__eyebrow">@L["Staff.Edit.Eyebrow"]</div>
            <div class="cc-admin-heading__row">
                <span class="staff-edit-heading-icon cc-admin-heading__icon" aria-hidden="true"><i class="fas fa-user-pen"></i></span>
                <div class="cc-admin-heading__text">
                    <h1>@L["Staff.Edit.Title"]</h1>
                    <p>@L["Staff.Edit.Subtitle"]</p>
                </div>
            </div>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>@L["Staff.Edit.Back"]</a>
    </header>
    <form asp-action="Edit" method="post" enctype="multipart/form-data" id="editStaffForm" class="card admin-wo-card staff-edit-card">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="StaffId" />
        <input type="hidden" asp-for="AccountId" />
        <input type="hidden" asp-for="SelectedRoleId" />
        <input type="hidden" asp-for="ScopeTypeId" />
        <input type="hidden" asp-for="ScopeRefId" />
        <input type="hidden" asp-for="StoreId" />
        <input type="hidden" asp-for="CurrentAvatarUrl" />
        <input type="hidden" asp-for="Active" />
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="staff-form-validation text-danger mb-3"></div>
            <section class="staff-form-section">
                <div class="staff-edit-section-title"><span><i class="fas fa-id-card"></i></span><div><strong>@L["Staff.Edit.InfoSection"]</strong><small>@L["Staff.Edit.InfoHint"]</small></div></div>
                <div class="row g-3">
                <div class="col-md-6"><label asp-for="FullName" class="form-label">@L["Staff.Edit.FullName"]</label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger"></span></div>
                <div class="col-md-6"><label asp-for="Email" class="form-label">@L["Staff.Edit.Email"]</label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="CCCD" class="form-label">@L["Staff.Edit.Cccd"]</label><input asp-for="CCCD" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="Gender" class="form-label">@L["Staff.Edit.Gender"]</label><select asp-for="Gender" class="form-select"><option value="0">@L["Staff.Create.Gender.Female"]</option><option value="1">@L["Staff.Create.Gender.Male"]</option><option value="2">@L["Staff.Create.Gender.Other"]</option></select></div>
                <div class="col-md-4"><label asp-for="DateOfBirth" class="form-label">@L["Staff.Edit.Dob"]</label><input asp-for="DateOfBirth" type="date" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="StartDate" class="form-label">@L["Staff.Edit.StartDate"]</label><input asp-for="StartDate" type="date" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="EmployeeStatus" class="form-label">@L["Staff.Edit.EmployeeStatus"]</label><select asp-for="EmployeeStatus" class="form-select"><option value="1">@L["Staff.Create.Status.Probation"]</option><option value="2">@L["Staff.Create.Status.Official"]</option><option value="3">@L["Staff.Edit.Status.Resigned"]</option></select></div>
                <div class="col-md-4"><label class="form-label">@L["Staff.Edit.Phone"]</label><input name="Phones[0]" value="@(Model.Phones.FirstOrDefault())" class="form-control" /></div>
                    <div class="col-12">
                        <label class="form-label">@L["Staff.Edit.Avatar"]</label>
                        <div class="staff-edit-avatar d-flex gap-3 align-items-center">
                            <img id="staffAvatarPreview" src="@(string.IsNullOrWhiteSpace(Model.CurrentAvatarUrl) ? DefaultImages.StaffAvatarUrl : Model.CurrentAvatarUrl)" width="64" height="64" class="rounded-circle" onerror="this.src='@DefaultImages.StaffAvatarUrl'" />
                            <input asp-for="AvatarFile" id="editAvatarInput" type="file" class="d-none" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                            <div class="avatar-actions d-flex flex-wrap align-items-center gap-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="chooseEditAvatar"><i class="fas fa-upload me-1"></i>@L["Staff.Edit.ChoosePhoto"]</button>
                                <button type="button" class="btn btn-sm btn-outline-danger d-none" id="removeEditAvatar"><i class="fas fa-trash me-1"></i>@L["Staff.Edit.UnselectPhoto"]</button>
                                <small class="text-muted ms-1">@L["Staff.Edit.AvatarHint"]</small>
                            </div>
                        </div>
                        <span asp-validation-for="AvatarFile" class="text-danger small"></span>
                    </div>
                </div>
            </section>

            <section class="staff-form-section">
                <div class="staff-edit-section-title"><span><i class="fas fa-location-dot"></i></span><div><strong>@L["Staff.Edit.AddressSection"]</strong><small>@L["Staff.Edit.AddressHint"]</small></div></div>
                <div class="row g-3">
                <div class="col-md-6"><label asp-for="ProvinceId" class="form-label">@L["Staff.Edit.Province"]</label><select asp-for="ProvinceId" id="editProvince" class="form-select"><option value="">@L["Staff.Create.SelectProvince"]</option>@foreach (var p in provinces) { <option value="@p.ProvinceId">@p.Name</option> }</select></div>
                <div class="col-md-6"><label asp-for="WardId" class="form-label">@L["Staff.Edit.Ward"]</label><select asp-for="WardId" id="editWard" class="form-select"><option value="">@L["Staff.Create.SelectWard"]</option></select></div>
                <div class="col-12"><label asp-for="Address" class="form-label">@L["Staff.Edit.Address"]</label><input asp-for="Address" class="form-control" placeholder="@L["Staff.Create.AddressPlaceholder"]" /><span asp-validation-for="Address" class="text-danger"></span></div>
                </div>
            </section>
        </div>
        <div class="card-footer staff-form-actions"><span class="staff-form-actions__hint"><i class="fas fa-circle-info"></i> @L["Staff.Edit.RequiredHint"]</span><div><a asp-action="Index" class="btn btn-outline-secondary">@L["Staff.Edit.Cancel"]</a><button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk me-1"></i>@L["Staff.Edit.Save"]</button></div></div>
    </form>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script type="application/json" id="staff-edit-ui-catalog">@Html.Raw(JsonSerializer.Serialize(L.GetAllStrings().Where(x => x.Name.StartsWith("Staff.Edit.Js.")).ToDictionary(x => x.Name, x => x.Value)))</script>
<script>
(() => {
    const catalog = CafeChainUiCatalog.read('staff-edit-ui-catalog');
    const t = (key, values) => CafeChainUiCatalog.text(catalog, key, values);
    const avatarInput = document.getElementById('editAvatarInput');
    const avatarPreview = document.getElementById('staffAvatarPreview');
    const chooseAvatarBtn = document.getElementById('chooseEditAvatar');
    const removeAvatarBtn = document.getElementById('removeEditAvatar');
    const initialAvatarUrl = '@(string.IsNullOrWhiteSpace(Model.CurrentAvatarUrl) ? DefaultImages.StaffAvatarUrl : Model.CurrentAvatarUrl)';

    if (avatarInput && avatarPreview) {
        chooseAvatarBtn?.addEventListener('click', () => avatarInput.click());

        avatarInput.addEventListener('change', () => {
            const file = avatarInput.files?.[0];
            if (!file) return;
            if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type) || file.size > 2 * 1024 * 1024) {
                avatarInput.value = '';
                alert(t('Staff.Edit.Js.AvatarInvalid'));
                return;
            }
            const reader = new FileReader();
            reader.onload = e => {
                avatarPreview.src = e.target.result;
                removeAvatarBtn?.classList.remove('d-none');
            };
            reader.readAsDataURL(file);
        });

        removeAvatarBtn?.addEventListener('click', () => {
            avatarInput.value = '';
            avatarPreview.src = initialAvatarUrl;
            removeAvatarBtn.classList.add('d-none');
        });
    }

    const province = document.getElementById('editProvince'), ward = document.getElementById('editWard');
    const initialWard = '@Model.WardId';
    const wardsEndpoint = '@Url.Action("GetWards", "AdminStaff", new { area = "Admin" })';
    let wardRequestVersion = 0;
    const reset = (select, placeholder) => {
        select.disabled = true; select.innerHTML = `<option value="">${placeholder}</option>`;
    };
    const load = async (select, url, parameter, parent, placeholder, selected, isCurrent) => {
        reset(select, t('Staff.Edit.Js.Loading'));
        if (!parent) { reset(select, placeholder); return []; }
        try {
            const response = await fetch(`${url}?${parameter}=${encodeURIComponent(parent)}`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            if (!response.ok) throw new Error();
            const rows = await response.json();
            if (!isCurrent()) return [];
            reset(select, placeholder);
            rows.forEach(x => select.add(new Option(x.name, x.id, false, String(x.id) === String(selected))));
            select.disabled = rows.length === 0;
            return rows;
        } catch {
            if (isCurrent()) reset(select, t('Staff.Edit.Js.LoadFailed'));
            return [];
        }
    };
    province.addEventListener('change', async () => {
        const parentProvinceId = province.value;
        const version = ++wardRequestVersion;
        reset(ward, t('Staff.Edit.Js.SelectWard'));
        if (parentProvinceId) await load(ward, wardsEndpoint, 'provinceId', parentProvinceId, t('Staff.Edit.Js.SelectWard'), '', () => version === wardRequestVersion && province.value === parentProvinceId);
    });
    (async () => {
        const provinceId = province.value;
        const wardVersion = ++wardRequestVersion;
        await load(ward, wardsEndpoint, 'provinceId', provinceId, t('Staff.Edit.Js.SelectWard'), initialWard, () => wardVersion === wardRequestVersion && province.value === provinceId);
    })();

    const editForm = document.getElementById('editStaffForm');
    const editCccdField = document.getElementById('CCCD');
    const editDobField = document.getElementById('DateOfBirth');

    editCccdField?.addEventListener('input', e => e.target.setCustomValidity(''));
    editDobField?.addEventListener('input', e => e.target.setCustomValidity(''));

    editForm?.addEventListener('submit', e => {
        if (editCccdField) {
            const val = editCccdField.value.trim();
            if (!val) {
                editCccdField.setCustomValidity(t('Staff.Edit.Js.CccdRequired'));
            } else if (!/^\d{12}$/.test(val)) {
                editCccdField.setCustomValidity(t('Staff.Edit.Js.CccdInvalid'));
            } else {
                editCccdField.setCustomValidity('');
            }
        }

        if (editDobField) {
            const val = editDobField.value;
            if (!val) {
                editDobField.setCustomValidity(t('Staff.Edit.Js.DobRequired'));
            } else {
                editDobField.setCustomValidity('');
            }
        }

        if (!editForm.checkValidity()) {
            e.preventDefault();
            editForm.reportValidity();
        }
    });

})();
</script>
}
