@model CafeChain.ViewModels.Admin.Staffs.StaffCreateVM
@using CafeChain.Application.Constants
@{
    var roles = ViewBag.Roles as List<CafeChain.Models.Permissions.Role> ?? new();
    var stores = ViewBag.Stores as List<CafeChain.Models.Stores.Store> ?? new();
    var scopeTypes = ViewBag.ScopeTypes as List<CafeChain.ViewModels.Admin.Staffs.StaffScopeTypeOptionVM> ?? new();
    var provinces = ViewBag.Provinces as List<CafeChain.Models.Locations.Province> ?? new();
    var isStoreManager = ViewBag.IsStoreManager is true;
    var currentStoreId = ViewBag.CurrentStoreId is int id ? id : 0;
    string ScopeMode(string roleName) => roleName switch
    {
        RoleConstants.BusinessOwner or RoleConstants.SystemAdmin => "country",
        RoleConstants.AreaManager => "flexible",
        _ => "store"
    };
}

<style>
    .staff-modal .modal-content { border: 0; border-radius: 16px; overflow: hidden; }
    .staff-modal .modal-header { border-bottom: 1px solid #eee7df; padding: 18px 22px; }
    .staff-modal .form-label { font-weight: 800; font-size: 13px; color: #334155; margin-bottom: 6px; }
    .staff-modal .form-control, .staff-modal .form-select { border-radius: 8px; border: 1px solid #dbe3ef; font-size: 14px; padding: 10px 12px; }
    .staff-modal .form-control:focus, .staff-modal .form-select:focus { border-color: #c67a45; box-shadow: 0 0 0 3px rgba(198,122,69,.14); }
    .staff-modal .nav-tabs { border-bottom: 1px solid #eee7df; }
    .staff-modal .nav-link { color: #64748b; font-weight: 800; font-size: 12px; text-transform: uppercase; letter-spacing: .35px; border: 0; border-bottom: 3px solid transparent; padding: 11px 18px; }
    .staff-modal .nav-link.active { color: #8b512d; border-color: #c67a45; background: transparent; }
    .staff-modal .tab-pane { min-height: 330px; }
    .staff-modal .section-title { color: #8b512d; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .45px; margin-bottom: 16px; }
    .staff-modal #createStaffSubmit {
        color: #fff;
        background: #6f4e37;
        border-color: #6f4e37;
        box-shadow: 0 6px 16px rgba(111, 78, 55, .22);
    }
    .staff-modal #createStaffSubmit:hover,
    .staff-modal #createStaffSubmit:focus-visible {
        color: #fff;
        background: #5c3f2b;
        border-color: #5c3f2b;
        box-shadow: 0 8px 20px rgba(92, 63, 43, .28);
    }
    .staff-modal #createStaffSubmit:disabled {
        color: #fff;
        background: #9c806c;
        border-color: #9c806c;
        opacity: .72;
    }
    .staff-modal #createStaffSubmit i { color: inherit; }
    .avatar-upload-box { position: relative; width: 190px; height: 190px; border: 2px dashed #dbc4a9; border-radius: 14px; background: #f8f2eb; display: flex; align-items: center; justify-content: center; overflow: hidden; cursor: pointer; text-align: center; }
    .avatar-upload-box:hover { border-color: #c67a45; background: #f5ede3; }
    .avatar-upload-box img { width: 100%; height: 100%; object-fit: cover; display: none; }
    .avatar-upload-placeholder i { display: block; color: #c67a45; font-size: 34px; margin-bottom: 8px; }
    .avatar-upload-placeholder span { color: #64748b; font-size: 12px; }
    .avatar-actions { display: flex; justify-content: center; gap: 8px; margin-top: 10px; }
    .staff-scope-help { background: #fff7ed; border: 1px solid #fed7aa; color: #7c2d12; border-radius: 10px; padding: 12px 14px; font-size: 13px; }
    .staff-modal .modal-content { box-shadow: 0 28px 80px rgba(45,29,20,.28); }
    .staff-modal .modal-header { background: linear-gradient(135deg, #fffdfb, #f7f3ee); }
    .staff-modal-heading-icon { width: 44px; height: 44px; border: 1px solid #d7c3b3; border-radius: 13px; color: #fff; background: linear-gradient(145deg,#6f4e37,#8b6b55); box-shadow: 0 8px 18px rgba(111,78,55,.2); }
    .staff-modal .modal-body { background: #faf7f4; }
    .staff-modal .nav-tabs { margin: -16px -8px 20px; padding: 0 8px; background: #fffdfb; border-radius: 12px 12px 0 0; }
    .staff-modal .tab-pane { border: 1px solid #e7dcd3; border-radius: 15px; padding: 20px; background: #fff; box-shadow: 0 10px 26px rgba(71,50,35,.06); }
    .staff-modal .section-title { display: flex; align-items: center; gap: 7px; padding-bottom: 9px; border-bottom: 1px solid #eee4dc; color: #6f4e37; }
    .staff-modal .form-control:hover, .staff-modal .form-select:hover { border-color: #b8957d; }
    .staff-modal .form-control:focus, .staff-modal .form-select:focus { border-color: #6f4e37; box-shadow: 0 0 0 3px rgba(111,78,55,.12); }
    .staff-modal .modal-footer { border-top: 1px solid #e7dcd3; background: #fffdfb; box-shadow: 0 -8px 20px rgba(71,50,35,.04); }
    @@media (max-width: 767.98px) { .avatar-upload-box { width: 140px; height: 140px; } .staff-modal .nav-link { padding: 10px 8px; font-size: 10px; } }
</style>

<div class="modal fade staff-modal" id="createStaffModal" tabindex="-1" aria-labelledby="createStaffTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content admin-wo-card shadow">
            <form asp-action="Create" asp-controller="AdminStaff" asp-area="Admin" method="post" class="staff-create-form"
                  enctype="multipart/form-data" id="createStaffForm" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-3">
                        <span class="staff-modal-heading-icon d-flex align-items-center justify-content-center">
                            <i class="fas fa-user-plus"></i>
                        </span>
                        <div><h4 class="modal-title fw-bold mb-0" id="createStaffTitle">Thêm nhân viên mới</h4><small class="text-muted">Tạo hồ sơ, tài khoản và phạm vi làm việc trong một giao dịch.</small></div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>

                <div class="modal-body px-4 pt-3">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 d-none" id="createStaffValidationSummary"></div>
                    <ul class="nav nav-tabs mb-4" id="createStaffTabs" role="tablist">
                        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#create-general" type="button">Thông tin chung</button></li>
                        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#create-scope" type="button">Vai trò & phạm vi</button></li>
                        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#create-account" type="button">Công việc & tài khoản</button></li>
                    </ul>

                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="create-general">
                            <div class="row g-4">
                                <div class="col-lg-3 d-flex flex-column align-items-center">
                                    <label class="form-label align-self-start">Ảnh đại diện</label>
                                    <div class="avatar-upload-box" id="createAvatarBox" role="button" tabindex="0">
                                        <div class="avatar-upload-placeholder" id="createAvatarPlaceholder"><i class="fas fa-cloud-upload-alt"></i><span>Click để chọn ảnh<br />JPG, PNG, WebP · tối đa 2 MB</span></div>
                                        <img id="createAvatarPreview" alt="Ảnh đại diện xem trước" />
                                    </div>
                                    <input asp-for="AvatarFile" id="createAvatarInput" type="file" class="d-none" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                                    <div class="avatar-actions"><button type="button" class="btn btn-sm btn-outline-secondary" id="chooseCreateAvatar">Chọn ảnh</button><button type="button" class="btn btn-sm btn-outline-danger d-none" id="removeCreateAvatar">Bỏ ảnh</button></div>
                                    <span asp-validation-for="AvatarFile" class="text-danger small"></span>
                                </div>
                                <div class="col-lg-9">
                                    <div class="section-title"><i class="fas fa-id-card me-1"></i> Thông tin cá nhân</div>
                                    <div class="row g-3">
                                        <div class="col-md-6"><label asp-for="FullName" class="form-label">Họ và tên <span class="text-danger">*</span></label><input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" /><span asp-validation-for="FullName" class="text-danger small"></span></div>
                                        <div class="col-md-6"><label asp-for="CCCD" class="form-label">Căn cước công dân</label><input asp-for="CCCD" class="form-control" inputmode="numeric" maxlength="12" placeholder="12 chữ số" /><span asp-validation-for="CCCD" class="text-danger small"></span></div>
                                        <div class="col-md-4"><label asp-for="Gender" class="form-label">Giới tính</label><select asp-for="Gender" class="form-select"><option value="0">Nữ</option><option value="1">Nam</option><option value="2">Khác</option></select></div>
                                        <div class="col-md-4"><label asp-for="DateOfBirth" class="form-label">Ngày sinh</label><input asp-for="DateOfBirth" type="date" class="form-control" /></div>
                                        <div class="col-md-4"><label class="form-label" for="createPhone">Số điện thoại</label><input name="Phones[0]" id="createPhone" class="form-control" autocomplete="tel" placeholder="09xx xxx xxx" /></div>
                                    </div>
                                    <div class="section-title mt-4"><i class="fas fa-map-marker-alt me-1"></i> Địa chỉ thường trú</div>
                                    <div class="row g-3">
                                        <div class="col-md-4"><label asp-for="ProvinceId" class="form-label">Tỉnh/Thành phố <span class="text-danger">*</span></label><select asp-for="ProvinceId" id="createProvince" class="form-select"><option value="">-- Chọn Tỉnh/Thành phố --</option>@foreach (var p in provinces) { <option value="@p.ProvinceId">@p.Name</option> }</select><span asp-validation-for="ProvinceId" class="text-danger small"></span></div>
                                        <div class="col-md-4"><label asp-for="DistrictId" class="form-label">Quận/Huyện <span class="text-danger">*</span></label><select asp-for="DistrictId" id="createDistrict" class="form-select" disabled><option value="">-- Chọn Quận/Huyện --</option></select><span asp-validation-for="DistrictId" class="text-danger small"></span></div>
                                        <div class="col-md-4"><label asp-for="WardId" class="form-label">Phường/Xã <span class="text-danger">*</span></label><select asp-for="WardId" id="createWard" class="form-select" disabled><option value="">-- Chọn Phường/Xã --</option></select><span asp-validation-for="WardId" class="text-danger small"></span></div>
                                        <div class="col-12"><label asp-for="Address" class="form-label">Địa chỉ chi tiết <span class="text-danger">*</span></label><input asp-for="Address" class="form-control" maxlength="500" placeholder="Số nhà, tên đường..." /><span asp-validation-for="Address" class="text-danger small"></span></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="tab-pane fade" id="create-scope">
                            <div class="section-title"><i class="fas fa-user-shield me-1"></i> Vai trò và phạm vi dữ liệu</div>
                            <div class="staff-scope-help mb-4"><i class="fas fa-info-circle me-1"></i> Chọn vai trò trước, sau đó cấp phạm vi dữ liệu. Cửa hàng chính là nơi làm việc hằng ngày và bắt buộc phải nằm trong phạm vi vừa cấp.</div>
                            <div class="row g-3">
                                <div class="col-md-4"><label asp-for="SelectedRoleId" class="form-label">Vai trò <span class="text-danger">*</span></label><select asp-for="SelectedRoleId" id="createRole" class="form-select"><option value="">-- Chọn vai trò --</option>@foreach (var r in roles) { <option value="@r.RoleId" data-scope-mode="@ScopeMode(r.Name)">@r.Name</option> }</select><span asp-validation-for="SelectedRoleId" class="text-danger small"></span></div>
                                <div class="col-md-4"><label asp-for="ScopeTypeId" class="form-label">Loại phạm vi <span class="text-danger">*</span></label><select asp-for="ScopeTypeId" id="createScopeType" class="form-select" disabled><option value="">-- Chọn vai trò trước --</option>@foreach (var s in scopeTypes) { <option value="@s.ScopeTypeId" data-code="@s.Code">@s.DisplayName</option> }</select><span asp-validation-for="ScopeTypeId" class="text-danger small"></span></div>
                                <div class="col-md-4"><label asp-for="ScopeRefId" class="form-label">Phạm vi được cấp <span class="text-danger">*</span></label><select asp-for="ScopeRefId" id="createScopeRef" class="form-select" disabled><option value="">-- Chọn loại phạm vi trước --</option></select><span asp-validation-for="ScopeRefId" class="text-danger small"></span></div>
                            </div>
                            <div class="row g-3 mt-1 d-none" id="createScopeCascade">
                                <div class="col-md-6 d-none" id="createScopeProvinceWrap"><label class="form-label" for="createScopeProvince">Tỉnh/Thành phố của phạm vi</label><select id="createScopeProvince" class="form-select" disabled><option value="">-- Chọn Tỉnh/Thành phố --</option></select></div>
                                <div class="col-md-6 d-none" id="createScopeDistrictWrap"><label class="form-label" for="createScopeDistrict">Quận/Huyện của phạm vi</label><select id="createScopeDistrict" class="form-select" disabled><option value="">-- Chọn Quận/Huyện --</option></select></div>
                            </div>
                            <div class="row g-3 mt-2">
                                <div class="col-md-6">
                                    <label asp-for="StoreId" class="form-label">Cửa hàng chính <span class="text-danger">*</span></label>
                                    @if (isStoreManager)
                                    {
                                        <input asp-for="StoreId" type="hidden" value="@currentStoreId" />
                                        <input class="form-control" value="@ViewBag.CurrentStoreName" disabled />
                                    }
                                    else
                                    {
                                        <select asp-for="StoreId" id="createStore" class="form-select" disabled>
                                            <option value="">-- Chọn phạm vi trước --</option>
                                            @foreach (var s in stores)
                                            {
                                                <option value="@s.StoreId" data-province-id="@s.ProvinceId" data-district-id="@s.DistrictId" data-ward-id="@s.WardId">@s.Name</option>
                                            }
                                        </select>
                                    }
                                    <span asp-validation-for="StoreId" class="text-danger small"></span>
                                    <small class="text-muted">Nơi công tác chính để xếp lịch và vận hành POS; không thay thế phạm vi dữ liệu.</small>
                                </div>
                            </div>
                        </div>

                        <div class="tab-pane fade" id="create-account">
                            <div class="section-title"><i class="fas fa-briefcase me-1"></i> Công việc và tài khoản đăng nhập</div>
                            <div class="row g-3">
                                <div class="col-md-6"><label asp-for="Email" class="form-label">Email đăng nhập <span class="text-danger">*</span></label><input asp-for="Email" class="form-control" autocomplete="off" placeholder="staff@cafechain.vn" /><span asp-validation-for="Email" class="text-danger small"></span></div>
                                <div class="col-md-6"><label asp-for="Password" class="form-label">Mật khẩu ban đầu <span class="text-danger">*</span></label><div class="input-group"><input asp-for="Password" id="createPassword" type="password" class="form-control" autocomplete="new-password" /><button type="button" class="btn btn-outline-secondary" id="toggleCreatePassword" aria-label="Hiện hoặc ẩn mật khẩu"><i class="fas fa-eye"></i></button></div><span asp-validation-for="Password" class="text-danger small"></span><small class="text-muted">Nhân viên có thể chủ động đổi mật khẩu sau khi đăng nhập.</small></div>
                                <div class="col-md-4"><label asp-for="StartDate" class="form-label">Ngày bắt đầu</label><input asp-for="StartDate" type="date" class="form-control" /></div>
                                <div class="col-md-4"><label asp-for="EmployeeStatus" class="form-label">Trạng thái nhân sự</label><select asp-for="EmployeeStatus" class="form-select"><option value="1">Thử việc</option><option value="2">Chính thức</option><option value="3">Đã nghỉ việc</option></select></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer px-4 py-3"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button><button type="submit" class="btn btn-primary" id="createStaffSubmit"><i class="fas fa-user-plus me-1"></i> Tạo nhân viên</button></div>
            </form>
        </div>
    </div>
</div>

<script>
(() => {
    const form = document.getElementById('createStaffForm');
    if (!form) return;
    const scopeEndpoint = '@Url.Action("GetScopeReferences", "AdminStaff", new { area = "Admin" })';
    const districtsEndpoint = '@Url.Action("GetDistricts", "AdminStaff", new { area = "Admin" })';
    const wardsEndpoint = '@Url.Action("GetWards", "AdminStaff", new { area = "Admin" })';
    const province = document.getElementById('createProvince');
    const district = document.getElementById('createDistrict');
    const ward = document.getElementById('createWard');
    const role = document.getElementById('createRole');
    const scopeType = document.getElementById('createScopeType');
    const scopeRef = document.getElementById('createScopeRef');
    const scopeCascade = document.getElementById('createScopeCascade');
    const scopeProvinceWrap = document.getElementById('createScopeProvinceWrap');
    const scopeDistrictWrap = document.getElementById('createScopeDistrictWrap');
    const scopeProvince = document.getElementById('createScopeProvince');
    const scopeDistrict = document.getElementById('createScopeDistrict');
    const primaryStore = document.getElementById('createStore');
    const avatarInput = document.getElementById('createAvatarInput');
    const avatarPreview = document.getElementById('createAvatarPreview');
    const avatarPlaceholder = document.getElementById('createAvatarPlaceholder');
    const removeAvatar = document.getElementById('removeCreateAvatar');
    let districtRequestVersion = 0;
    let wardRequestVersion = 0;

    const scopeTypeCatalog = [...scopeType.options]
        .filter(x => x.value)
        .map(x => ({ value: x.value, code: x.dataset.code, text: x.textContent }));
    const storeCatalog = primaryStore ? [...primaryStore.options]
        .filter(x => x.value)
        .map(x => ({
            value: x.value,
            text: x.textContent,
            provinceId: x.dataset.provinceId || '',
            districtId: x.dataset.districtId || '',
            wardId: x.dataset.wardId || ''
        })) : [];

    const resetSelect = (select, placeholder) => {
        if (!select) return;
        select.innerHTML = `<option value="">${placeholder}</option>`;
        select.disabled = true;
    };
    const loadScopeOptions = async (select, scopeTypeId, parentId, placeholder) => {
        resetSelect(select, 'Đang tải...');
        try {
            const suffix = parentId ? `&parentId=${encodeURIComponent(parentId)}` : '';
            const response = await fetch(`${scopeEndpoint}?scopeTypeId=${scopeTypeId}${suffix}`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            if (!response.ok) throw new Error();
            const rows = await response.json();
            resetSelect(select, placeholder);
            rows.forEach(x => select.add(new Option(x.name, x.id)));
            select.disabled = rows.length === 0;
            return rows;
        } catch { resetSelect(select, 'Không tải được dữ liệu'); return []; }
    };
    const loadLocationOptions = async (select, url, parameterName, parentId, placeholder, requestVersion) => {
        resetSelect(select, 'Đang tải...');
        try {
            const response = await fetch(`${url}?${parameterName}=${encodeURIComponent(parentId)}`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            if (!response.ok) throw new Error();
            const rows = await response.json();
            if (!requestVersion()) return [];
            resetSelect(select, placeholder);
            rows.forEach(x => select.add(new Option(x.name, x.id)));
            select.disabled = rows.length === 0;
            return rows;
        } catch {
            if (requestVersion()) resetSelect(select, 'Không tải được dữ liệu');
            return [];
        }
    };
    const filterPrimaryStores = () => {
        if (!primaryStore) return;
        const previousValue = primaryStore.value;
        const type = scopeType.value;
        const reference = scopeRef.value;
        const matches = !type || !reference ? [] : storeCatalog.filter(store => {
            if (type === '1') return true;
            if (type === '2') return store.provinceId === reference;
            if (type === '3') return store.districtId === reference;
            if (type === '4') return store.wardId === reference;
            if (type === '5') return store.value === reference;
            return false;
        });
        resetSelect(primaryStore, matches.length ? '-- Chọn cửa hàng chính --' : '-- Phạm vi không có cửa hàng phù hợp --');
        matches.forEach(store => primaryStore.add(new Option(store.text, store.value)));
        primaryStore.disabled = matches.length === 0;
        if (matches.some(store => store.value === previousValue)) primaryStore.value = previousValue;
        else if (type === '5' && matches.length === 1) primaryStore.value = matches[0].value;
    };
    const renderScopeTypesForRole = async () => {
        const mode = role.selectedOptions[0]?.dataset.scopeMode;
        resetSelect(scopeType, mode ? '-- Chọn loại phạm vi --' : '-- Chọn vai trò trước --');
        resetSelect(scopeRef, '-- Chọn loại phạm vi trước --');
        resetSelect(primaryStore, '-- Chọn phạm vi trước --');
        scopeCascade.classList.add('d-none');
        if (!mode) return;
        const allowedIds = mode === 'country' ? ['1'] : mode === 'store' ? ['5'] : ['2', '3', '4', '5'];
        scopeTypeCatalog.filter(x => allowedIds.includes(x.value)).forEach(x => {
            const option = new Option(x.text, x.value);
            option.dataset.code = x.code;
            scopeType.add(option);
        });
        scopeType.disabled = false;
        if (allowedIds.length === 1) {
            scopeType.value = allowedIds[0];
            await handleScopeTypeChange();
        }
    };

    province?.addEventListener('change', async () => {
        const requestVersion = ++districtRequestVersion;
        ++wardRequestVersion;
        resetSelect(district, '-- Chọn Quận/Huyện --'); resetSelect(ward, '-- Chọn Phường/Xã --');
        if (province.value) await loadLocationOptions(
            district,
            districtsEndpoint,
            'provinceId',
            province.value,
            '-- Chọn Quận/Huyện --',
            () => requestVersion === districtRequestVersion && province.value !== '');
    });
    district?.addEventListener('change', async () => {
        const parentDistrictId = district.value;
        const requestVersion = ++wardRequestVersion;
        resetSelect(ward, '-- Chọn Phường/Xã --');
        if (parentDistrictId) await loadLocationOptions(
            ward,
            wardsEndpoint,
            'districtId',
            parentDistrictId,
            '-- Chọn Phường/Xã --',
            () => requestVersion === wardRequestVersion && district.value === parentDistrictId);
    });
    const handleScopeTypeChange = async () => {
        resetSelect(scopeRef, '-- Chọn phạm vi --');
        resetSelect(primaryStore, '-- Chọn phạm vi trước --');
        scopeCascade.classList.add('d-none'); scopeProvinceWrap.classList.add('d-none'); scopeDistrictWrap.classList.add('d-none');
        resetSelect(scopeDistrict, '-- Chọn Quận/Huyện --');
        resetSelect(scopeProvince, '-- Chọn Tỉnh/Thành phố --');
        if (!scopeType.value) return;
        if (scopeType.value === '3' || scopeType.value === '4') {
            scopeCascade.classList.remove('d-none'); scopeProvinceWrap.classList.remove('d-none');
            if (scopeType.value === '4') scopeDistrictWrap.classList.remove('d-none');
            resetSelect(scopeRef, scopeType.value === '3' ? '-- Chọn Tỉnh trước --' : '-- Chọn Quận/Huyện trước --');
            await loadScopeOptions(scopeProvince, 2, null, '-- Chọn Tỉnh/Thành phố --');
            return;
        }
        const rows = await loadScopeOptions(scopeRef, scopeType.value, null, '-- Chọn phạm vi --');
        if ((scopeType.value === '1' || rows.length === 1) && scopeRef.options.length > 1) {
            scopeRef.selectedIndex = 1;
            filterPrimaryStores();
        }
    };
    role?.addEventListener('change', renderScopeTypesForRole);
    scopeType?.addEventListener('change', handleScopeTypeChange);
    scopeRef?.addEventListener('change', filterPrimaryStores);
    scopeProvince?.addEventListener('change', async () => {
        resetSelect(scopeDistrict, '-- Chọn Quận/Huyện --'); resetSelect(scopeRef, '-- Chọn phạm vi --'); resetSelect(primaryStore, '-- Chọn phạm vi trước --');
        if (!scopeProvince.value) return;
        if (scopeType.value === '3') await loadScopeOptions(scopeRef, 3, scopeProvince.value, '-- Chọn Quận/Huyện --');
        if (scopeType.value === '4') await loadScopeOptions(scopeDistrict, 3, scopeProvince.value, '-- Chọn Quận/Huyện --');
    });
    scopeDistrict?.addEventListener('change', async () => {
        resetSelect(scopeRef, '-- Chọn Phường/Xã --'); resetSelect(primaryStore, '-- Chọn phạm vi trước --');
        if (scopeType.value === '4' && scopeDistrict.value) await loadScopeOptions(scopeRef, 4, scopeDistrict.value, '-- Chọn Phường/Xã --');
    });

    const openAvatarPicker = () => avatarInput?.click();
    document.getElementById('createAvatarBox')?.addEventListener('click', openAvatarPicker);
    document.getElementById('chooseCreateAvatar')?.addEventListener('click', openAvatarPicker);
    document.getElementById('createAvatarBox')?.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openAvatarPicker(); } });
    avatarInput?.addEventListener('change', () => {
        const file = avatarInput.files?.[0];
        if (!file) return;
        if (!['image/jpeg','image/png','image/webp'].includes(file.type) || file.size > 2 * 1024 * 1024) {
            avatarInput.value = ''; alert('Ảnh phải là JPG, PNG hoặc WebP và không vượt quá 2 MB.'); return;
        }
        const reader = new FileReader();
        reader.onload = e => { avatarPreview.src = e.target.result; avatarPreview.style.display = 'block'; avatarPlaceholder.style.display = 'none'; removeAvatar.classList.remove('d-none'); };
        reader.readAsDataURL(file);
    });
    removeAvatar?.addEventListener('click', () => { avatarInput.value = ''; avatarPreview.removeAttribute('src'); avatarPreview.style.display = 'none'; avatarPlaceholder.style.display = ''; removeAvatar.classList.add('d-none'); });
    document.getElementById('toggleCreatePassword')?.addEventListener('click', e => { const input = document.getElementById('createPassword'); input.type = input.type === 'password' ? 'text' : 'password'; e.currentTarget.querySelector('i').classList.toggle('fa-eye'); e.currentTarget.querySelector('i').classList.toggle('fa-eye-slash'); });

    form.addEventListener('submit', async e => {
        e.preventDefault();
        e.stopPropagation();
        if (!form.checkValidity()) {
            form.classList.add('was-validated');
            const invalid = form.querySelector(':invalid');
            const pane = invalid?.closest('.tab-pane');
            if (pane) bootstrap.Tab.getOrCreateInstance(document.querySelector(`[data-bs-target="#${pane.id}"]`)).show();
            requestAnimationFrame(() => invalid?.focus());
            return;
        }

        const submitButton = document.getElementById('createStaffSubmit');
        submitButton.disabled = true;
        try {
            const response = await fetch(form.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: new FormData(form)
            });
            const payload = await response.json().catch(() => null);
            if (!response.ok || !payload?.success) {
                const details = Array.isArray(payload?.errors) && payload.errors.length
                    ? `\n${payload.errors.join('\n')}`
                    : '';
                await Swal.fire({
                    title: response.status === 403 ? 'Không có quyền' : 'Không thể tạo nhân viên',
                    text: `${payload?.message || 'Yêu cầu không thể xử lý.'}${details}`,
                    icon: 'error'
                });
                return;
            }

            window.location.assign(payload.redirectUrl || '@Url.Action("Index", "AdminStaff", new { area = "Admin" })');
        } catch {
            await Swal.fire('Lỗi kết nối', 'Không thể kết nối máy chủ. Dữ liệu bạn đã nhập vẫn được giữ lại.', 'error');
        } finally {
            submitButton.disabled = false;
        }
    });
})();
</script>
