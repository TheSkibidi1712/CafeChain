@using Microsoft.Extensions.Localization
@using System.Text.Json
@inject IStringLocalizer<AIImportResource> L
@{
    ViewData["Title"] = L["Page.Title"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/AIImport/ai-import.css" asp-append-version="true" />
}

<main class="ai-import-page" id="aiImportApp">
    <form id="antiForgeryForm" class="d-none">@Html.AntiForgeryToken()</form>
    <header class="ai-import-header">
        <div>
            <p class="ai-import-eyebrow">@L["Hero.Eyebrow"]</p>
            <h1><i class="fa-solid fa-wand-magic-sparkles"></i> @L["Page.Title"]</h1>
            <p>@L["Hero.Description"]</p>
        </div>
        <button type="button" class="btn-ai ghost" id="refreshHistoryButton"><i class="fa-solid fa-clock-rotate-left"></i> @L["Action.History"]</button>
    </header>

    <section class="ai-import-card upload-card" id="uploadPanel">
        <div class="drop-zone" id="dropZone">
            <input type="file" id="excelFile" multiple accept=".xlsx,.docx,.pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/pdf" hidden />
            <i class="fa-solid fa-file-arrow-up"></i>
            <strong>@L["Upload.Drop"]</strong>
            <span>@L["Upload.Limits"]</span>
            <button type="button" class="btn-ai" id="chooseFileButton">@L["Upload.Choose"]</button>
            <div id="selectedFileName" class="selected-files"></div>
        </div>
        <div class="upload-actions">
            <label>@L["Upload.EntityHint"]
                <select id="entityHint">
                    <option value="">@L["Upload.Auto"]</option><option value="Category">@L["Entity.Category"]</option><option value="Drink">@L["Entity.Drink"]</option><option value="Size">@L["Entity.Size"]</option><option value="Ingredient">@L["Entity.Ingredient"]</option><option value="Supplier">@L["Entity.Supplier"]</option>
                </select>
            </label>
            <label class="ocr-import-toggle" title="@L["Ocr.Checking"]"><input type="checkbox" id="useOcr" aria-label="@L["Ocr.Aria"]" disabled /> @L["Ocr.Label"]</label>
            <button type="button" class="btn-ai primary" id="analyzeButton" disabled><i class="fa-solid fa-magnifying-glass-chart"></i> @L["Action.Analyze"]</button>
        </div>
        <div class="ai-import-alert error upload-errors" id="uploadErrors" hidden></div>
    </section>

    <div class="ai-import-loading" id="loadingPanel" hidden><span></span><p>@L["State.Processing"]</p></div>

    <section id="workspace" hidden>
        <div class="session-bar">
            <div><span id="sessionFile"></span><small id="sessionMeta"></small></div>
            <span class="status-pill" id="sessionStatus"></span>
            <div class="session-actions">
                <button type="button" class="btn-ai ghost" id="closeSessionButton" title="@L["Session.CloseTitle"]">@L["Session.Close"]</button>
                <button type="button" class="btn-ai ghost" id="reanalyzeButton">@L["Session.Reanalyze"]</button>
                <button type="button" class="btn-ai danger" id="cancelButton">@L["Session.Cancel"]</button>
                <button type="button" class="btn-ai primary" id="confirmButton">@L["Session.Confirm"]</button>
            </div>
        </div>

        <div class="summary-grid" id="summaryGrid"></div>
        <div class="source-documents" id="sourceDocuments"></div>
        <div class="ai-import-alert warning" id="analysisWarnings" hidden></div>
        <div class="ai-import-alert error" id="confirmBlockers" hidden></div>
        <div class="workspace-grid">
            <aside class="ai-import-card group-list">
                <div class="card-title"><strong>@L["Preview.SourceRegion"]</strong><span id="groupCount"></span></div>
                <div id="groupTabs"></div>
            </aside>
            <div class="ai-import-card preview-card">
                <div class="preview-toolbar">
                    <div><strong id="activeGroupTitle">@L["Preview.Title"]</strong><small id="activeGroupMeta"></small></div>
                    <div>
                        <label>@L["Preview.SourceFile"] <select id="sourceFilter"><option value="">@L["Common.All"]</option></select></label>
                        <label>@L["Preview.DataType"] <select id="entityFilter"><option value="">@L["Common.All"]</option><option value="Category">@L["Entity.Category"]</option><option value="Drink">@L["Entity.Drink"]</option><option value="Size">@L["Entity.Size"]</option><option value="Ingredient">@L["Entity.Ingredient"]</option><option value="Supplier">@L["Entity.Supplier"]</option></select></label>
                        <label>@L["Common.Status"] <select id="statusFilter"><option value="">@L["Common.All"]</option><option value="VALID">@L["Status.Valid"]</option><option value="WARNING">@L["Status.Warning"]</option><option value="ERROR">@L["Status.Error"]</option><option value="REVIEW_REQUIRED">@L["Status.Review"]</option><option value="SKIPPED">@L["Status.Skipped"]</option><option value="IMPORTED">@L["Status.Imported"]</option></select></label>
                    </div>
                </div>
                <details class="mapping-panel" open>
                    <summary>@L["Mapping.Title"]</summary>
                    <div class="mapping-head"><label><span>@L["Preview.DataType"]</span><select id="groupEntity"><option value="Category">@L["Entity.Category"]</option><option value="Drink">@L["Entity.Drink"]</option><option value="Size">@L["Entity.Size"]</option><option value="Ingredient">@L["Entity.Ingredient"]</option><option value="Supplier">@L["Entity.Supplier"]</option></select></label><button type="button" class="btn-ai small" id="saveMappingButton">@L["Mapping.Save"]</button></div>
                    <div class="mapping-column-head" aria-hidden="true"><span>@L["Mapping.SourceColumn"]</span><span>@L["Mapping.Sample"]</span><span>@L["Common.Status"]</span><span>@L["Mapping.Target"]</span></div>
                    <div id="mappingFields" class="mapping-fields"></div>
                </details>
                <div class="table-wrap"><table class="preview-table"><colgroup><col class="preview-col-row" /><col class="preview-col-status" /><col class="preview-col-data" /><col class="preview-col-issues" /><col class="preview-col-actions" /></colgroup><thead><tr><th>@L["Table.SourcePosition"]</th><th>@L["Common.Status"]</th><th>@L["Table.BusinessData"]</th><th>@L["Table.Issues"]</th><th>@L["Common.Actions"]</th></tr></thead><tbody id="previewRows"></tbody></table></div>
                <div class="pagination"><button type="button" id="previousPage">‹</button><span id="pageInfo"></span><button type="button" id="nextPage">›</button></div>
            </div>
        </div>
    </section>

    <section class="ai-import-card history-card" id="historyPanel" hidden>
        <div class="card-title"><strong>@L["History.Title"]</strong><button type="button" class="icon-button" id="closeHistoryButton" aria-label="@L["Common.Close"]">×</button></div>
        <div id="historyRows"></div>
    </section>

    <dialog id="editDialog" class="edit-dialog">
        <form method="dialog" id="editItemForm" novalidate>
            <header><div><p class="edit-eyebrow" id="editEntityName"></p><strong>@L["Edit.Title"] <span id="editRowNumber"></span></strong><small>@L["Edit.Description"]</small></div><button value="cancel" class="icon-button" aria-label="@L["Common.Close"]">×</button></header>
            <div class="edit-dialog-body" id="editDialogBody">
                <div class="edit-form-alert" id="editFormAlert" hidden></div>
                <div id="editFields" class="edit-fields"></div>
                <label class="check-row manual-review-row" id="manualReviewRow" hidden><input type="checkbox" id="manualReviewConfirmed" /> @L["Edit.ManualReview"]</label>
                <details class="edit-source-details"><summary>@L["Edit.SourceData"]</summary><div id="editSourceData"></div></details>
                <section class="edit-warning-section" id="warningSection">
                    <div class="edit-warning-messages" id="editWarningMessages"></div>
                    <label class="check-row"><input type="checkbox" id="acknowledgeWarnings" /> @L["Edit.Acknowledge"]</label>
                    <label id="overrideReasonGroup"><span>@L["Edit.OverrideReason"] <em>*</em></span><textarea id="overrideReason" maxlength="500" rows="3" placeholder="@L["Edit.OverridePlaceholder"]"></textarea><small class="field-error" data-field-error="DuplicateOverrideReason"></small></label>
                </section>
            </div>
            <footer><button value="cancel" class="btn-ai ghost">@L["Common.Close"]</button><button type="button" class="btn-ai danger" id="skipItemButton">@L["Edit.Skip"]</button><button type="button" class="btn-ai primary" id="saveItemButton">@L["Edit.Save"]</button></footer>
        </form>
    </dialog>
</main>

@section Scripts {
    <script id="aiImportUiCatalog" type="application/json">@Html.Raw(JsonSerializer.Serialize(L.GetAllStrings(includeParentCultures: false).ToDictionary(x => x.Name, x => x.Value)))</script>
    <script src="~/js/Admin/AIImport/ai-import-interactions.js" asp-append-version="true"></script>
    <script src="~/js/Admin/AIImport/ai-import.js" asp-append-version="true"></script>
}
