@model CafeChain.Application.DTOs.POS.StaffNotificationListDto
@using CafeChain.Application.Interfaces.Systems
@using CafeChain.Application.Tools
@inject IBusinessDateService BusinessDateService
@{
    ViewData["Title"] = "Thông báo";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int currentPage = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 20;
    int total = ViewBag.Total ?? 0;
    int unread = ViewBag.UnreadCount ?? 0;
    int totalPages = Math.Max(1, (int)Math.Ceiling(total / (double)pageSize));
    var successMessage = Convert.ToString(TempData["SuccessMessage"]);
    var isLoginSuccessMessage = string.Equals(
        successMessage?.Trim().TrimEnd('!'),
        "Đăng nhập thành công",
        StringComparison.OrdinalIgnoreCase);
    DateTime VietnamTime(DateTime utc) => TimeZoneInfo.ConvertTimeFromUtc(
        UtcDateTime.Normalize(utc), BusinessDateService.TimeZone);
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/Notifications/admin-notifications.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/verification-code-input.css" asp-append-version="true" />
}

<main class="notification-page cc-page cc-warehouse-page">
    <header class="notification-header cc-page-header cc-warehouse-header">
        <div class="notification-heading-copy">
            <p class="cc-page-kicker">Kho &amp; Cung ứng / Trung tâm thông báo</p>
            <div class="notification-title-row">
                <span class="notification-title-icon" aria-hidden="true"><i class="fas fa-bell"></i></span>
                <div>
                    <h1 class="cc-page-title">Thông báo</h1>
                    <p class="notification-meta cc-page-description">
                        Theo dõi cảnh báo kho, vận hành, POS và OTP thuộc phạm vi của bạn.
                    </p>
                </div>
            </div>
        </div>
        <form asp-area="Admin" asp-controller="AdminNotifications" asp-action="MarkAllRead" method="post" class="m-0 cc-warehouse-actions">
            @Html.AntiForgeryToken()
            <button type="submit" class="cc-button notification-mark-all" @(unread == 0 ? "disabled" : null)>
                <i class="fas fa-check-double" aria-hidden="true"></i>
                Đánh dấu tất cả đã đọc
            </button>
        </form>
    </header>

    @if (!string.IsNullOrWhiteSpace(successMessage) && !isLoginSuccessMessage)
    {
        <div class="ops-notice ops-notice-success" role="status">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="ops-notice ops-notice-error" role="alert">@TempData["ErrorMessage"]</div>
    }

    <section class="notification-summary" aria-label="Tổng quan thông báo">
        <div class="notification-summary-card">
            <span class="notification-summary-icon is-total" aria-hidden="true"><i class="fas fa-bell"></i></span>
            <div><strong data-notification-total>@total</strong><span>Tổng thông báo</span></div>
        </div>
        <div class="notification-summary-card @(unread > 0 ? "has-unread" : "")">
            <span class="notification-summary-icon is-unread" aria-hidden="true"><i class="fas fa-bell"></i></span>
            <div><strong data-notification-unread>@unread</strong><span>Chưa đọc</span></div>
        </div>
        <div class="notification-summary-card">
            <span class="notification-summary-icon is-read" aria-hidden="true"><i class="fas fa-check"></i></span>
            <div><strong data-notification-read>@Math.Max(0, total - unread)</strong><span>Đã đọc</span></div>
        </div>
    </section>

    <div data-admin-notification-list class="notification-content">
        @if (Model.Items == null || Model.Items.Count == 0)
        {
            <div class="cc-empty-state cc-warehouse-empty" role="status">
                <span class="notification-empty-icon" aria-hidden="true"><i class="far fa-bell-slash"></i></span>
                <h2>Chưa có thông báo</h2>
                <p>Các yêu cầu phê duyệt và cập nhật vận hành phù hợp với phạm vi của bạn sẽ xuất hiện tại đây.</p>
            </div>
        }
        else
        {
            <section class="notification-list cc-warehouse-panel" aria-label="Danh sách thông báo">
                @foreach (var item in Model.Items)
                {
                    <article id="notification-@item.NotificationId" class="notification-item @(item.IsRead ? "" : "is-unread")">
                        <span class="notification-item-icon" aria-hidden="true">
                            <i class="fas @(item.IsRead ? "fa-check" : "fa-bell")"></i>
                        </span>
                        <div class="notification-item-layout">
                            <div class="notification-item-main">
                                <div class="notification-item-heading">
                                    <strong class="notification-title">@item.Title</strong>
                                    @if (!item.IsRead)
                                    {
                                        <span class="cc-status-badge notification-unread-badge">Chưa đọc</span>
                                    }
                                </div>
                                <div class="notification-body">@item.Body</div>
                                @if (item.OperationalOtp != null)
                                {
                                    var otp = item.OperationalOtp;
                                    <div class="notification-otp-card"
                                         data-operational-otp
                                         data-server-now="@otp.ServerNowUtc.ToString("O")"
                                         data-expires-at="@otp.ExpiresAtUtc.ToString("O")">
                                        <div><strong>Terminal:</strong> @otp.TerminalName</div>
                                        <div><strong>Chi nhánh:</strong> @otp.StoreName</div>
                                        <div><strong>Người gửi:</strong> @otp.RequestedByName</div>
                                        <div><strong>Người xác nhận:</strong> @(otp.ConfirmedByName ?? otp.ApproverName)</div>
                                        <div><strong>Gửi lúc:</strong> @VietnamTime(otp.SentAtUtc).ToString("HH:mm:ss dd/MM/yyyy")</div>
                                        <div><strong>Hết hạn:</strong> @VietnamTime(otp.ExpiresAtUtc).ToString("HH:mm:ss dd/MM/yyyy")</div>
                                        <div><strong>Trạng thái:</strong> <span data-otp-status>@otp.Status</span></div>
                                        @if (otp.Status == "Waiting")
                                        {
                                            <small data-otp-countdown></small>
                                            @if (otp.CanRevealOtp)
                                            {
                                                <div class="notification-item-footer">
                                                    <button type="button"
                                                            class="cc-button"
                                                            data-reveal-operational-otp
                                                            data-notification-id="@item.NotificationId">
                                                        Xem OTP
                                                    </button>
                                                </div>
                                            }
                                            @if (otp.CanContinueTerminalConfirmation)
                                            {
                                                <form asp-area="Admin" asp-controller="AdminNotifications" asp-action="ConfirmTerminal" method="post" class="notification-terminal-confirm-form" data-validation-feedback="inline" novalidate>
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.NotificationId" />
                                                    <input type="hidden" name="RequestKey" value="@Guid.NewGuid().ToString("N")" />
                                                    <label>
                                                        <span>Nhập OTP để xác nhận Terminal</span>
                                                        <input name="OtpCode" maxlength="6" autocomplete="one-time-code" data-verification-code-input required />
                                                    </label>
                                                    <button type="submit" class="cc-button" data-submit-once>Xác nhận Terminal</button>
                                                    <small data-terminal-confirm-feedback aria-live="polite"></small>
                                                </form>
                                            }
                                            @if (otp.CanRejectTerminalRegistration)
                                            {
                                                <form asp-area="Admin" asp-controller="AdminNotifications" asp-action="RejectTerminal" method="post" class="notification-terminal-reject-form" data-validation-feedback="inline" novalidate>
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.NotificationId" />
                                                    <input type="hidden" name="RequestKey" value="@Guid.NewGuid().ToString("N")" />
                                                    <label for="terminalRejectReason-@item.NotificationId">Lý do từ chối đăng ký Terminal</label>
                                                    <textarea id="terminalRejectReason-@item.NotificationId"
                                                              name="Reason"
                                                              minlength="10"
                                                              maxlength="500"
                                                              rows="3"
                                                              placeholder="Nhập lý do cụ thể (10–500 ký tự)"></textarea>
                                                    <div class="notification-terminal-reject-meta">
                                                        <small data-terminal-reject-counter>0 / 500</small>
                                                        <small data-terminal-reject-feedback aria-live="polite"></small>
                                                    </div>
                                                    <button type="submit" class="cc-button notification-terminal-reject-button" data-reject-submit-once>Từ chối đăng ký Terminal</button>
                                                </form>
                                            }
                                        }
                                        else if (otp.Status == "Expired")
                                        {
                                            <small>OTP đã hết hạn. Vui lòng gửi yêu cầu mới.</small>
                                        }
                                        else if (otp.Status == "Rejected")
                                        {
                                            <small>Yêu cầu đăng ký Terminal đã bị từ chối.</small>
                                        }
                                    </div>
                                }
                                <div class="notification-item-footer">
                                    <span class="notification-time"><i class="far fa-clock" aria-hidden="true"></i>@VietnamTime(item.CreatedAt).ToString("HH:mm · dd/MM/yyyy")</span>
                                    @if (item.EmailAttempted && !item.EmailSent)
                                    {
                                        <span class="notification-email-warning"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i>Email chưa gửi được</span>
                                    }
                                    @if (!string.IsNullOrEmpty(item.TargetUrl))
                                    {
                                        <a class="notification-link" href="@item.TargetUrl">@(item.TargetActionLabel ?? "Xem chi tiết") <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                                    }
                                </div>
                            </div>
                            @if (!item.IsRead)
                            {
                                <form asp-area="Admin" asp-controller="AdminNotifications" asp-action="MarkRead" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.NotificationId" />
                                    <button type="submit" class="cc-button notification-read-button" title="Đánh dấu đã đọc">
                                        <i class="fas fa-check" aria-hidden="true"></i>
                                        <span>Đánh dấu đã đọc</span>
                                    </button>
                                </form>
                            }
                        </div>
                    </article>
                }
            </section>

            <nav class="notification-pagination" aria-label="Phân trang thông báo">
                <small>Trang <strong>@currentPage</strong> / @totalPages · Tổng @total thông báo</small>
                <div class="notification-page-actions">
                    @if (currentPage > 1)
                    {
                        <a class="cc-button"
                           asp-area="Admin" asp-controller="AdminNotifications" asp-action="Index"
                           asp-route-page="@(currentPage - 1)"><i class="fas fa-chevron-left" aria-hidden="true"></i>Trước</a>
                    }
                    @if (currentPage < totalPages)
                    {
                        <a class="cc-button"
                           asp-area="Admin" asp-controller="AdminNotifications" asp-action="Index"
                           asp-route-page="@(currentPage + 1)">Sau<i class="fas fa-chevron-right" aria-hidden="true"></i></a>
                    }
                </div>
            </nav>
        }
    </div>
</main>

@section Scripts {
    <script src="~/js/shared/verification-code-input.js" asp-append-version="true"></script>
    <script src="~/js/Admin/Notifications/admin-notification-list.js" asp-append-version="true"></script>
}
