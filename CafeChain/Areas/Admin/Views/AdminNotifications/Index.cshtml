@model CafeChain.Application.DTOs.POS.StaffNotificationListDto
@{
    ViewData["Title"] = "Thông báo";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 20;
    int total = ViewBag.Total ?? 0;
    int unread = ViewBag.UnreadCount ?? 0;
    int totalPages = Math.Max(1, (int)Math.Ceiling(total / (double)pageSize));
}

<main class="notification-page cc-page">
    <header class="notification-header cc-page-header">
        <div>
            <p class="cc-page-kicker">Kho &amp; Cung ứng</p>
            <h1 class="cc-page-title">Thông báo kho</h1>
            <p class="notification-meta cc-page-description">
                Thông báo kho chi nhánh gửi đến bạn
                @if (unread > 0)
                {
                    <span class="cc-status-badge cc-status-warning ms-1">@unread chưa đọc</span>
                }
            </p>
        </div>
        <form asp-area="Admin" asp-controller="AdminNotifications" asp-action="MarkAllRead" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="cc-button" @(unread == 0 ? "disabled" : null)>
                Đánh dấu tất cả đã đọc
            </button>
        </form>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="ops-notice ops-notice-success" role="status">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="ops-notice ops-notice-error" role="alert">@TempData["ErrorMessage"]</div>
    }

    <div data-admin-notification-list>
        @if (Model.Items == null || Model.Items.Count == 0)
        {
            <div class="cc-empty-state">
                <h2>Chưa có thông báo kho</h2>
                <p>Các cảnh báo tồn kho và cập nhật vận hành phù hợp với phạm vi của bạn sẽ xuất hiện tại đây.</p>
            </div>
        }
        else
        {
            <section class="notification-list" aria-label="Danh sách thông báo kho">
                @foreach (var item in Model.Items)
                {
                    <article class="notification-item @(item.IsRead ? "" : "is-unread")">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <strong class="notification-title">@item.Title</strong>
                                    @if (!item.IsRead)
                                    {
                                        <span class="cc-status-badge cc-status-warning">Chưa đọc</span>
                                    }
                                </div>
                                <div class="notification-body small mb-2">@item.Body</div>
                                <div class="notification-meta small">
                                    @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    @if (item.EmailAttempted && !item.EmailSent)
                                    {
                                        <span class="ms-2 text-warning">
                                            · Email chưa gửi được, nhưng thông báo đã được ghi nhận trong hệ thống.
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(item.TargetUrl))
                                    {
                                        <a class="ms-2" href="@item.TargetUrl">Xem cảnh báo →</a>
                                    }
                                </div>
                            </div>
                            @if (!item.IsRead)
                            {
                                <form asp-area="Admin" asp-controller="AdminNotifications" asp-action="MarkRead" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.NotificationId" />
                                    <button type="submit" class="cc-button">Đánh dấu đã đọc</button>
                                </form>
                            }
                        }
                    </article>
                }
            </section>

            <div class="d-flex justify-content-between align-items-center mt-3">
                <small class="text-muted">Trang @(page) / @totalPages · Tổng @total</small>
                <div class="btn-group">
                    @if (page > 1)
                    {
                        <a class="cc-button"
                           asp-area="Admin" asp-controller="AdminNotifications" asp-action="Index"
                           asp-route-page="@(page - 1)">Trước</a>
                    }
                    @if (page < totalPages)
                    {
                        <a class="cc-button"
                           asp-area="Admin" asp-controller="AdminNotifications" asp-action="Index"
                           asp-route-page="@(page + 1)">Sau</a>
                    }
                </div>
            </div>
        }
    </div>
</main>

@section Scripts {
    <script src="~/js/Admin/Notifications/admin-notification-list.js" asp-append-version="true"></script>
}
