@model CafeChain.ViewModels.Admin.Sizes.AdminSizeIndexVM
@using Microsoft.Extensions.Localization
@using System.Text.Json
@inject IStringLocalizer<CafeChain.ProductResource> ProductText
@using System.Security.Claims
@using CafeChain.Application.Constants
@using CafeChain.Application.Interfaces.Admin.Permissions
@inject IAdminPermissionService PermissionService
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var sizes = Model.Sizes.Items;
    var canCreate = false; var canUpdate = false; var canToggle = false; var canAssign = false; var canViewTopping = false;
    if (int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var accountId))
    {
        canCreate = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.SizeCreate)).Data?.Allowed == true;
        canUpdate = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.SizeUpdate)).Data?.Allowed == true;
        canToggle = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.SizeToggleStatus)).Data?.Allowed == true;
        canAssign = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.SizeAssignDrink)).Data?.Allowed == true;
        canViewTopping = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.ToppingView)).Data?.Allowed == true;
    }
    var sizeJsKeys = new[]
    {
        "Size.Cup", "Size.Volume", "Common.Cancel", "Size.Js.Unknown", "Size.Js.NoDrinkData",
        "Size.Js.Incompatible", "Size.Js.Other", "Size.Js.Profitability", "Size.Js.Price",
        "Size.Js.DisableHint", "Size.Js.EnableHint", "Size.Js.Disable", "Size.Js.Enable", "Size.Js.Assign",
        "Size.Js.Invalid", "Size.Js.NoAssigned", "Size.Js.AllAssigned", "Size.Js.ManageTitle", "Size.Js.LoadError",
        "Size.Js.InvalidPrice", "Size.Js.AssignSuccess", "Size.Js.AssignError", "Size.Js.ConfirmTitle",
        "Size.Js.DrinkStatusConfirm", "Size.Js.SizeStatusConfirm", "Size.Js.Confirm", "Size.Js.StatusSuccess",
        "Size.Js.UpdateError", "Size.Js.CodeRequired", "Size.Js.CodeMax", "Size.Js.NameRequired", "Size.Js.NameMax",
        "Size.Js.InvalidResponse", "Size.Js.ActionFailed", "Size.Js.NotFound", "Size.Js.UpdateSuccess",
        "Size.Js.AiNameRequired", "Size.Js.AiLoading", "Size.Js.AiFailed", "Size.Js.AiOverwriteCode",
        "Size.Js.AiCodeApplied", "Size.Js.AiTitle", "Size.Js.AiChooseValid", "Size.Js.AiInvalidType",
        "Size.Js.AiOverwrite", "Size.Js.AiApplied", "Size.Js.TypeRequired", "Size.Js.CreateSuccess"
    };
    var sizeJsCatalog = JsonSerializer.Serialize(sizeJsKeys.ToDictionary(key => key, key => ProductText[key].Value));
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/Catalog/catalog-list-toolbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/Size/size.css" asp-append-version="true" />
}

<main class="size-admin-page ops-shell cc-warehouse-page">
    @Html.AntiForgeryToken()

    <header class="size-page-heading ops-header cc-warehouse-header">
        <div>
            <div class="ops-eyebrow">
                <i class="fas fa-layer-group me-1"></i> @ProductText["Common.MenuStructure"]
            </div>
            <h1 class="ops-title"><i class="fa-solid fa-ruler-horizontal me-2 text-warning" aria-hidden="true"></i>@ProductText["Size.Title"]</h1>
            <p class="ops-subtitle">@ProductText["Size.Description"]</p>
        </div>
        <div class="ops-actions">
            @if (canCreate)
            {
                <button class="btn btn-orange px-3"
                        data-bs-toggle="modal"
                        data-bs-target="#createModal">
                    <i class="fas fa-plus me-2"></i> @ProductText["Common.Add"]
                </button>
            }
        </div>
    </header>


    <div class="catalog-list-toolbar">
        <div class="catalog-filter-tabs" aria-label="@ProductText["Size.FilterAria"]">
            <a asp-action="Index"
               asp-route-keyword="@Model.Keyword"
               asp-route-pageSize="@Model.PageSize"
               class="catalog-filter-tab @(!Model.Active.HasValue ? "active" : null)"
               aria-current="@(!Model.Active.HasValue ? "page" : null)">@ProductText["Common.AllWithCount", Model.AllCount]</a>
            <a asp-action="Index"
               asp-route-keyword="@Model.Keyword"
               asp-route-active="true"
               asp-route-pageSize="@Model.PageSize"
               class="catalog-filter-tab @(Model.Active == true ? "active" : null)"
               aria-current="@(Model.Active == true ? "page" : null)">@ProductText["Common.ActiveWithCount", Model.ActiveCount]</a>
            <a asp-action="Index"
               asp-route-keyword="@Model.Keyword"
               asp-route-active="false"
               asp-route-pageSize="@Model.PageSize"
               class="catalog-filter-tab @(Model.Active == false ? "active" : null)"
               aria-current="@(Model.Active == false ? "page" : null)">@ProductText["Common.InactiveWithCount", Model.InactiveCount]</a>
        </div>

        <form asp-action="Index" method="get" class="catalog-list-tools" id="sizeFilterForm" role="search">
            <input type="hidden" name="page" value="1" />
            @if (Model.Active.HasValue)
            {
                <input type="hidden" name="active" value="@(Model.Active.Value ? "true" : "false")" />
            }

            <div class="catalog-search-box">
                <button type="submit" class="catalog-search-button" title="@ProductText["Common.Search"]" aria-label="@ProductText["Size.SearchAria"]">
                    <i class="fas fa-search" aria-hidden="true"></i>
                </button>
                <label for="sizeKeyword" class="visually-hidden">@ProductText["Size.SearchAria"]</label>
                <input id="sizeKeyword"
                       type="search"
                       name="keyword"
                       value="@Model.Keyword"
                       placeholder="@ProductText["Size.SearchPlaceholder"]"
                       autocomplete="off" />
                @if (!string.IsNullOrWhiteSpace(Model.Keyword))
                {
                    <a asp-action="Index"
                       asp-route-active="@Model.Active"
                       asp-route-pageSize="@Model.PageSize"
                       class="catalog-search-clear"
                       title="@ProductText["Common.ClearFilters"]"
                       aria-label="@ProductText["Common.ClearFilters"]">
                        <i class="fas fa-times" aria-hidden="true"></i>
                    </a>
                }
            </div>

            <label class="catalog-page-size">
                <span>@ProductText["Common.Display"]</span>
                <select name="pageSize" aria-label="@ProductText["Common.DisplayRows"]" onchange="this.form.submit()">
                    <option value="10" selected="@(Model.PageSize == 10)">10</option>
                    <option value="25" selected="@(Model.PageSize == 25)">25</option>
                    <option value="50" selected="@(Model.PageSize == 50)">50</option>
                </select>
            </label>
        </form>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- Card -->
    <div class="main-card shadow-sm p-3">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">@ProductText["Size.List"]</h5>
        </div>

        <!-- Table -->
        <div class="size-table-wrap">
        <table class="table table-borderless align-middle">
            <thead class="text-muted">
                <tr>
                    <th class="text-center" style="width: 12%;">@ProductText["Size.Code"]</th>
                    <th style="width: 18%;">@ProductText["Size.Name"]</th>
                    <th style="width: 30%;">@ProductText["Size.DescriptionLabel"]</th>
                    <th class="text-center" style="width: 12%;">@ProductText["Size.Type"]</th>
                    <th class="text-center" style="width: 14%;">@ProductText["Common.Status"]</th>
                    <th class="text-center" style="width: 14%;">@ProductText["Common.Actions"]</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in sizes)
                {
                    <tr class="border-top">
                        <td class="text-center">
                            <span class="size-code-badge">
                                @item.SizeCode
                            </span>
                        </td>

                        <td class="size-name-cell">
                            <div class="d-flex align-items-center">
                                <div class="size-badge" title="@item.Name">
                                    @item.Name
                                </div>
                            </div>
                        </td>

                        <td>@item.Description</td>

                        <td class="text-center">
                            <span class="size-type-badge @(item.SizeType == CafeChain.Models.Enums.Drink.SizeTypeEnum.Volume ? "size-type-volume" : "size-type-cup")">
                                @(item.SizeType == CafeChain.Models.Enums.Drink.SizeTypeEnum.Volume ? ProductText["Size.Volume"] : ProductText["Size.Cup"])
                            </span>
                        </td>

                        <td class="text-center">
                            @if (item.Active)
                            {
                                <span class="status-active">@ProductText["Common.Active"]</span>
                            }
                            else
                            {
                                <span class="status-inactive">@ProductText["Common.Inactive"]</span>
                            }
                        </td>

                        <td class="text-center">
                            <div class="d-inline-flex align-items-center justify-content-center gap-1">
                                <!-- ASSIGN DRINK-->
                                @if (canAssign)
                                {
                                <button class="size-action-btn is-assign"
                                        title="@ProductText["Size.AssignDrinks"]"
                                        onclick="openDrinkModal(@item.SizeId, '@item.Name')">
                                    <i class="fas fa-link"></i>
                                </button>
                                }

                                <!-- EDIT -->
                                @if (canUpdate)
                                {
                                <button class="size-action-btn is-edit"
                                        title="@ProductText["Common.Edit"]"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editModal"
                                        onclick="openEditModal(
                                    @item.SizeId,
                                    '@Html.Raw(item.SizeCode?.Replace("'", "\\'"))',
                                    '@Html.Raw(item.Name?.Replace("'", "\\'"))',
                                    '@Html.Raw(item.Description?.Replace("'", "\\'"))',
                                    @((int)item.SizeType)
                                    )">
                                    <i class="fas fa-pen"></i>
                                </button>
                                }

                                <!-- TOGGLE -->
                                @if (canToggle)
                                {
                                <button class="size-action-btn @(item.Active ? "is-lock" : "is-unlock")"
                                        title="@(item.Active ? ProductText["Common.Lock"] : ProductText["Common.Unlock"])"
                                        onclick="toggleSize(@item.SizeId)">
                                    <i class="fas @(item.Active ? "fa-lock" : "fa-unlock")"></i>
                                </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (sizes.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">@ProductText["Size.Empty"]</td></tr>
                }
            </tbody>
        </table>
        </div>

        <partial name="_CatalogPagination"
                 model="new CafeChain.ViewModels.Admin.Shared.AdminCatalogPaginationVM {
                     Keyword = Model.Keyword,
                     Active = Model.Active,
                     PageSize = Model.PageSize,
                     PageIndex = Model.Sizes.PageIndex,
                     TotalPages = Model.Sizes.TotalPages,
                     TotalCount = Model.Sizes.TotalCount,
                     CurrentItemCount = sizes.Count
                 }" />

    </div>
</main>

<!-- ================= CREATE MODAL ================= -->
<div class="modal fade size-module-modal" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered size-modal-dialog">
        <div class="modal-content size-modal">

            <!-- Header -->
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-3">
                    <div class="size-modal-icon">
                        <i class="fas fa-mug-hot"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">@ProductText["Size.CreateTitle"]</h6>
                        <small class="text-muted text-uppercase" style="font-size:11px;">
                            @ProductText["Size.Configure"]
                        </small>
                    </div>
                </div>

                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Form -->
            <form id="createSizeForm">
                <div class="modal-body">

                    <div class="row g-3 size-primary-fields">
                        <!-- Mã Size -->
                        <div class="col-md-3 size-code-field">
                            <label class="form-label fw-semibold">
                                @ProductText["Size.CodeLabel"] <span class="text-danger">*</span>
                            </label>
                            <input id="create-code"
                                   name="SizeCode"
                                   class="form-control"
                                   placeholder="M"
                                   maxlength="20"
                                   required />
                        </div>

                        <!-- Tên Size -->
                        <div class="col-md-4 size-name-field">
                            <label class="form-label fw-semibold">
                                @ProductText["Size.NameLabel"] <span class="text-danger">*</span>
                            </label>
                            <input id="create-name"
                                   name="Name"
                                   class="form-control"
                                   placeholder="@ProductText["Size.NamePlaceholder"]"
                                   maxlength="50"
                                   required />
                        </div>

                        <div class="col-md-5 size-type-field">
                            <label class="form-label fw-semibold">
                                @ProductText["Size.TypeLabel"] <span class="text-danger">*</span>
                            </label>
                            <select id="create-size-type"
                                    name="SizeType"
                                    class="form-select"
                                    required>
                                <option value="" selected>@ProductText["Size.TypeChoose"]</option>
                                <option value="1">Ly</option>
                                <option value="2">@ProductText["Size.Volume"]</option>
                            </select>
                        </div>

                        <!-- Mô Tả Size -->
                        <div class="col-12 size-description-field">
                            <label class="form-label fw-semibold">
                                @ProductText["Size.DescriptionForm"]
                            </label>
                            <input id="create-description"
                                   name="Description"
                                   class="form-control bg-light"
                                   placeholder="@ProductText["Size.DescriptionPlaceholder"]"
                                   maxlength="300" />
                        </div>

                        <div class="col-12 size-ai-section d-none">
                            <label for="sizeAiIdea" class="form-label fw-semibold">@ProductText["Size.AiIdea"] <span class="text-muted fw-normal">@ProductText["Size.Optional"]</span></label>
                            <select id="sizeAiGenerationMode" class="form-select mb-2" aria-label="@ProductText["Size.AiMode"]">
                                <option value="0">@ProductText["Size.AiNew"]</option>
                                <option value="1">@ProductText["Size.AiDevelop"]</option>
                                <option value="2">@ProductText["Size.AiVariant"]</option>
                            </select>
                            <input id="sizeAiIdea" class="form-control mb-2" maxlength="200" placeholder="@ProductText["Size.AiPlaceholder"]" autocomplete="off" />
                            <button type="button" id="btnSizeAiSuggestion" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-wand-magic-sparkles me-1"></i> @ProductText["Size.AiSuggest"]
                            </button>
                            <div id="sizeAiSuggestionPanel" class="ai-suggestion-panel mt-2 d-none">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong>@ProductText["Size.AiChoose"]</strong>
                                    <span id="sizeAiSource" class="badge bg-secondary"></span>
                                </div>
                                <div id="sizeAiOptionList" class="ai-option-grid"></div>
                                <div id="sizeAiWarnings" class="small text-warning mt-2"></div>
                                <div class="d-flex gap-2 mt-2">
                                    <button type="button" id="btnApplySizeAi" class="btn btn-primary btn-sm" disabled>@ProductText["Size.Apply"]</button>
                                    <button type="button" id="btnDismissSizeAi" class="btn btn-light btn-sm">@ProductText["Size.Dismiss"]</button>
                                </div>
                            </div>
                        </div>

                    </div>

                    <p class="text-muted small mt-3 mb-0">
                        @ProductText["Size.CodeHint"]
                    </p>

                </div>

                <!-- Footer -->
                <div class="modal-footer border-0 pt-2">
                    <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal">
                        @ProductText["Common.Cancel"]
                    </button>

                    <button type="submit" class="btn btn-orange px-4">
                        <i class="fas fa-save me-2"></i> @ProductText["Size.Save"]
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>
<!-- ================= EDIT MODAL ================= -->
<div class="modal fade size-module-modal" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered size-modal-dialog">
        <div class="modal-content size-modal">

            <!-- Header -->
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-3">
                    <div class="size-modal-icon is-edit">
                        <i class="fas fa-pen"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">@ProductText["Size.EditTitle"]</h6>
                        <small class="text-muted text-uppercase" style="font-size:11px;">
                            @ProductText["Size.EditHint"]
                        </small>
                    </div>
                </div>

                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Form -->
            <form id="editSizeForm">
                <input type="hidden" id="edit-id" name="SizeId" />

                <div class="modal-body">

                    <div class="row g-3 size-primary-fields">

                        <!-- Mã -->
                        <div class="col-md-3 size-code-field">
                            <label class="form-label fw-semibold">
                                @ProductText["Size.CodeLabel"] <span class="text-danger">*</span>
                            </label>
                            <input id="edit-code"
                                   name="SizeCode"
                                   class="form-control"
                                   maxlength="20"
                                   required />
                        </div>

                        <!-- Tên -->
                        <div class="col-md-4 size-name-field">
                            <label class="form-label fw-semibold">
                                @ProductText["Size.NameLabel"] <span class="text-danger">*</span>
                            </label>
                            <input id="edit-name"
                                   name="Name"
                                   class="form-control"
                                   maxlength="50"
                                   required />
                        </div>

                        <div class="col-md-5 size-type-field">
                            <label class="form-label fw-semibold">
                                @ProductText["Size.TypeLabel"] <span class="text-danger">*</span>
                            </label>
                            <select id="edit-size-type"
                                    name="SizeType"
                                    class="form-select"
                                    required>
                                <option value="1">Ly</option>
                                <option value="2">@ProductText["Size.Volume"]</option>
                            </select>
                        </div>

                        <!-- Mô tả -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">
                                @ProductText["Size.DescriptionForm"]
                            </label>
                            <input id="edit-description"
                                   name="Description"
                                   class="form-control bg-light"
                                   maxlength="300" />
                        </div>

                    </div>

                </div>

                <!-- Footer -->
                <div class="modal-footer border-0 pt-2">
                    <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal">
                        @ProductText["Common.Cancel"]
                    </button>

                    <button type="submit" class="btn btn-orange px-4">
                        <i class="fas fa-check me-2"></i> @ProductText["Common.Update"]
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<!-- ================= DRINK MODAL ================= -->
<div class="modal fade size-module-modal" id="drinkModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">

            <!-- HEADER -->
            <div class="modal-header border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <div class="size-modal-icon">
                        <i class="fas fa-glass-martini-alt"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-dark" id="drinkModalTitle">@ProductText["Size.ManageDrinks"]</h5>
                        <small class="text-muted">@ProductText["Size.ManageDrinksHint"]</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body p-4">
                <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
                    <span class="badge bg-brown px-3 py-2 fs-6 rounded-pill" id="currentSizeBadge">Size</span>
                    <span class="small text-muted"><i class="fas fa-info-circle me-1"></i>@ProductText["Size.AssignHint"]</span>
                </div>

                <div class="row g-4">
                    <!-- UNASSIGNED -->
                    <div class="col-md-6">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="fw-bold mb-0 text-secondary"><i class="fas fa-plus-circle me-1 text-primary"></i> @ProductText["Size.Unassigned"]</h6>
                        </div>
                        <div id="unassignedList" class="d-flex flex-column gap-2"></div>
                    </div>

                    <!-- ASSIGNED -->
                    <div class="col-md-6">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="fw-bold mb-0 text-secondary"><i class="fas fa-check-circle me-1 text-success"></i> @ProductText["Size.Assigned"]</h6>
                        </div>
                        <div id="assignedList" class="d-flex flex-column gap-2"></div>
                    </div>
                </div>
            </div>

            <!-- FOOTER -->
            <div class="modal-footer border-top bg-light">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">@ProductText["Common.Close"]</button>
            </div>

        </div>
    </div>
</div>

<!-- ================= PREMIUM PRICE MODAL ================= -->
<div class="modal fade size-module-modal" id="priceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content price-modal-card">

            <div class="modal-header price-modal-header border-0">
                <div class="d-flex align-items-center gap-3">
                    <div class="price-modal-icon">
                        <i class="fas fa-tags"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0">@ProductText["Size.PriceTitle"]</h5>
                        <small class="text-white-50" style="font-size:12px;">
                            @ProductText["Size.PriceHint"]
                        </small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <div class="mb-3">
                    <label for="priceInput" class="form-label fw-bold text-dark">@ProductText["Size.PriceLabel"] <span class="text-danger">*</span></label>

                    <div class="mb-3">
                        <input type="number"
                               id="priceInput"
                               class="form-control"
                               placeholder="VD: 35000"
                               min="0"
                               step="500"
                               autocomplete="off" />
                    </div>

                    <!-- Quick price presets -->
                    <div class="d-flex align-items-center gap-1.5 flex-wrap mt-2 mb-3">
                        <span class="small text-muted me-1 fw-semibold" style="font-size:11px;">@ProductText["Size.PriceQuick"]</span>
                        <button type="button" class="price-preset-chip" onclick="selectPresetPrice(25000)">@((25000m).ToString("N0")) ₫</button>
                        <button type="button" class="price-preset-chip" onclick="selectPresetPrice(30000)">@((30000m).ToString("N0")) ₫</button>
                        <button type="button" class="price-preset-chip" onclick="selectPresetPrice(35000)">@((35000m).ToString("N0")) ₫</button>
                        <button type="button" class="price-preset-chip" onclick="selectPresetPrice(40000)">@((40000m).ToString("N0")) ₫</button>
                        <button type="button" class="price-preset-chip" onclick="selectPresetPrice(45000)">@((45000m).ToString("N0")) ₫</button>
                    </div>

                    <!-- Dynamic preview badge -->
                    <div class="price-preview-badge">
                        <span class="small text-muted fw-semibold">@ProductText["Size.PricePreview"]</span>
                        <span id="priceFormattedPreview" class="fw-bold text-primary fs-6">0 ₫</span>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-top bg-light p-3">
                <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal">@ProductText["Common.Cancel"]</button>
                <button type="button" class="btn btn-orange px-4" onclick="confirmAssign()">
                    <i class="fas fa-check-circle me-1"></i> @ProductText["Size.PriceConfirm"]
                </button>
            </div>

        </div>
    </div>
</div>




