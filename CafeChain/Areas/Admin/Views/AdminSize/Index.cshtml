@model IEnumerable<CafeChain.ViewModels.Admin.Sizes.AdminSizeVM>
@using System.Security.Claims
@using CafeChain.Application.Constants
@using CafeChain.Application.Interfaces.Admin.Permissions
@inject IAdminPermissionService PermissionService
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var canCreate = false; var canUpdate = false; var canToggle = false; var canAssign = false; var canViewTopping = false;
    if (int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var accountId))
    {
        canCreate = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.SizeCreate)).Data?.Allowed == true;
        canUpdate = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.SizeUpdate)).Data?.Allowed == true;
        canToggle = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.SizeToggleStatus)).Data?.Allowed == true;
        canAssign = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.SizeAssignDrink)).Data?.Allowed == true;
        canViewTopping = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.ToppingView)).Data?.Allowed == true;
    }
}

<link rel="stylesheet" href="~/css/Admin/Size/size.css" />

<div class="container-fluid p-4">
    @Html.AntiForgeryToken()

    <!-- Tabs -->
    <div class="d-flex mb-3 border-bottom">
        <a asp-area="Admin"
               asp-controller="AdminSize"
               asp-action="Index"
               class="me-4 pb-2 text-decoration-none fw-semibold
            @(currentController == "AdminSize" ? "text-danger border-bottom border-danger" : "text-muted")">
            Quản lý Size
        </a>

        @if (canViewTopping)
        {
        <a asp-area="Admin"
               asp-controller="AdminTopping"
               asp-action="Index"
               class="pb-2 text-decoration-none fw-semibold
            @(currentController == "AdminTopping" ? "text-danger border-bottom border-danger" : "text-muted")">
            Quản lý Topping
        </a>
        }
    </div>
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- Card -->
    <div class="main-card shadow-sm p-3">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">Danh sách Size</h5>

            @if (canCreate)
            {
            <button class="btn btn-orange px-3"
                    data-bs-toggle="modal"
                    data-bs-target="#createModal">
                <i class="fas fa-plus me-2"></i> Thêm mới
            </button>
            }
        </div>

        <!-- Table -->
        <table class="table table-borderless">
            <thead class="text-muted">
                <tr>
                    <th>MÃ SIZE</th>
                    <th>TÊN SIZE</th>
                    <th>MÔ TẢ</th>
                    <th>LOẠI SIZE</th>
                    <th>TRẠNG THÁI</th>
                    <th class="text-end">HÀNH ĐỘNG</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="border-top">
                        <td>
                            <span class="size-code-badge">
                                @item.SizeCode
                            </span>
                        </td>

                        <td>
                            <div class="d-flex align-items-center">
                                <div class="size-badge me-3">
                                    @item.Name
                                </div>
                            </div>
                        </td>

                        <td>@item.Description</td>

                        <td>
                            <span class="size-type-badge @(item.SizeType == CafeChain.Models.Enums.Drink.SizeTypeEnum.Volume ? "size-type-volume" : "size-type-cup")">
                                @(item.SizeType == CafeChain.Models.Enums.Drink.SizeTypeEnum.Volume ? "Dung tích" : "Ly")
                            </span>
                        </td>

                        <td>
                            @if (item.Active)
                            {
                                <span class="status-active">Hoạt động</span>
                            }
                            else
                            {
                                <span class="status-inactive">Ngừng</span>
                            }
                        </td>

                        <td class="text-end">
                            <!-- ASSIGN DRINK-->
                            @if (canAssign)
                            {
                            <button class="btn btn-sm btn-warning me-2"
                                    onclick="openDrinkModal(@item.SizeId, '@item.Name')">
                                <i class="fas fa-link"></i>
                            </button>
                            }

                            <!-- EDIT -->
                            @if (canUpdate)
                            {
                            <button class="btn btn-sm btn-light me-2"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editModal"
                                    onclick="openEditModal(
                                @item.SizeId,
                                '@Html.Raw(item.SizeCode?.Replace("'", "\\'"))',
                                '@Html.Raw(item.Name?.Replace("'", "\\'"))',
                                '@Html.Raw(item.Description?.Replace("'", "\\'"))',
                                @((int)item.SizeType)
                                )">
                                <i class="fas fa-pen text-primary"></i>
                            </button>
                            }

                            <!-- TOGGLE -->
                            @if (canToggle)
                            {
                            <button class="btn btn-sm btn-light"
                                    onclick="toggleSize(@item.SizeId)">
                                <i class="fas @(item.Active ? "fa-lock text-danger" : "fa-unlock text-success")"></i>
                            </button>
                            }

                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>

<!-- ================= CREATE MODAL ================= -->
<div class="modal fade" id="createModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-3">

            <!-- Header -->
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-start gap-2">
                    <div class="p-2 rounded-3" style="background:#FBE9E7;">
                        <i class="fas fa-box text-danger"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Thêm mới Size đồ uống</h6>
                        <small class="text-muted text-uppercase" style="font-size:11px;">
                            Cấu hình thực đơn
                        </small>
                    </div>
                </div>

                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Form -->
            <form id="createSizeForm">
                <div class="modal-body">

                    <div class="row g-3">
                        <!-- Mã Size -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">
                                Mã Size <span class="text-danger">*</span>
                            </label>
                            <input id="create-code"
                                   name="SizeCode"
                                   class="form-control bg-light text-center"
                                   placeholder="M"
                                   maxlength="20"
                                   required />
                        </div>

                        <!-- Tên Size -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">
                                Tên Size <span class="text-danger">*</span>
                            </label>
                            <input id="create-name"
                                   name="Name"
                                   class="form-control bg-light text-center"
                                   placeholder="Size vừa"
                                   maxlength="50"
                                   required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">
                                Loại Size <span class="text-danger">*</span>
                            </label>
                            <select id="create-size-type"
                                    name="SizeType"
                                    class="form-select bg-light"
                                    required>
                                <option value="" selected>-- Chọn loại size --</option>
                                <option value="1">Ly</option>
                                <option value="2">Dung tích</option>
                            </select>
                        </div>

                        <!-- Mô Tả Size -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">
                                Mô Tả Size
                            </label>
                            <input id="create-description"
                                   name="Description"
                                   class="form-control bg-light"
                                   placeholder="Ví dụ: Size vừa"
                                   maxlength="300" />
                        </div>

                        <div class="col-12">
                            <label for="sizeAiIdea" class="form-label fw-semibold">Ý tưởng cho AI <span class="text-muted fw-normal">(không bắt buộc)</span></label>
                            <input id="sizeAiIdea" class="form-control mb-2" maxlength="200" placeholder="Ví dụ: chai 330ml" autocomplete="off" />
                            <button type="button" id="btnSizeAiSuggestion" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-wand-magic-sparkles me-1"></i> AI gợi ý
                            </button>
                            <div id="sizeAiSuggestionPanel" class="ai-suggestion-panel mt-2 d-none">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong>Chọn một gợi ý</strong>
                                    <span id="sizeAiSource" class="badge bg-secondary"></span>
                                </div>
                                <div id="sizeAiOptionList" class="ai-option-grid"></div>
                                <div id="sizeAiWarnings" class="small text-warning mt-2"></div>
                                <div class="d-flex gap-2 mt-2">
                                    <button type="button" id="btnApplySizeAi" class="btn btn-primary btn-sm" disabled>Áp dụng</button>
                                    <button type="button" id="btnDismissSizeAi" class="btn btn-light btn-sm">Bỏ qua</button>
                                </div>
                            </div>
                        </div>

                    </div>

                    <p class="text-muted small mt-3 mb-0">
                        Sử dụng mã ngắn (S, M, L) để hiển thị nhanh trên hóa đơn.
                    </p>

                </div>

                <!-- Footer -->
                <div class="modal-footer border-0 pt-2">
                    <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal">
                        Hủy bỏ
                    </button>

                    <button type="submit" class="btn btn-orange px-4">
                        <i class="fas fa-save me-2"></i> Lưu thông tin
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>
<!-- ================= EDIT MODAL ================= -->
<div class="modal fade" id="editModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-3">

            <!-- Header -->
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-start gap-2">
                    <div class="p-2 rounded-3" style="background:#E3F2FD;">
                        <i class="fas fa-pen text-primary"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Chỉnh sửa Size</h6>
                        <small class="text-muted text-uppercase" style="font-size:11px;">
                            Cập nhật thông tin
                        </small>
                    </div>
                </div>

                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Form -->
            <form id="editSizeForm">
                <input type="hidden" id="edit-id" name="SizeId" />

                <div class="modal-body">

                    <div class="row g-3">

                        <!-- Mã -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">
                                Mã Size <span class="text-danger">*</span>
                            </label>
                            <input id="edit-code"
                                   name="SizeCode"
                                   class="form-control bg-light text-center"
                                   maxlength="20"
                                   required />
                        </div>

                        <!-- Tên -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">
                                Tên Size <span class="text-danger">*</span>
                            </label>
                            <input id="edit-name"
                                   name="Name"
                                   class="form-control bg-light text-center"
                                   maxlength="50"
                                   required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">
                                Loại Size <span class="text-danger">*</span>
                            </label>
                            <select id="edit-size-type"
                                    name="SizeType"
                                    class="form-select bg-light"
                                    required>
                                <option value="1">Ly</option>
                                <option value="2">Dung tích</option>
                            </select>
                        </div>

                        <!-- Mô tả -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">
                                Mô Tả Size
                            </label>
                            <input id="edit-description"
                                   name="Description"
                                   class="form-control bg-light"
                                   maxlength="300" />
                        </div>

                    </div>

                </div>

                <!-- Footer -->
                <div class="modal-footer border-0 pt-2">
                    <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal">
                        Hủy bỏ
                    </button>

                    <button type="submit" class="btn btn-orange px-4">
                        <i class="fas fa-check me-2"></i> Cập nhật
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<!-- ================= DRINK MODAL ================= -->
<div class="modal fade" id="drinkModal">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content p-3">

            <!-- HEADER -->
            <div class="modal-header border-0">
                <h5 class="fw-bold mb-0" id="drinkModalTitle"></h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body">
                <div class="row">

                    <!-- UNASSIGNED -->
                    <div class="mb-3">
                        <span class="badge bg-danger fs-6" id="currentSizeBadge"></span>
                    </div>
                    <div class="col-6">
                        <h6 class="fw-bold text-muted mb-3">Chưa gán</h6>
                        <div id="unassignedList" class="row g-2"></div>
                    </div>

                    <!-- ASSIGNED -->
                    <div class="col-6">
                        <h6 class="fw-bold text-muted mb-3">Đã gán</h6>
                        <div id="assignedList" class="row g-2"></div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>


<div class="modal fade" id="priceModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-3">

            <div class="modal-header border-0">
                <h6 class="fw-bold">Nhập giá</h6>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="number" id="priceInput" class="form-control" placeholder="Nhập giá..." />
            </div>

            <div class="modal-footer border-0">
                <button class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-orange" onclick="confirmAssign()">Xác nhận</button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/Admin/DrinkSize/drinksize.js" asp-append-version="true"></script>
}
