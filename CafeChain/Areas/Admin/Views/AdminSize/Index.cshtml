@model IEnumerable<CafeChain.ViewModels.Admin.Sizes.AdminSizeVM>
@using System.Security.Claims
@using CafeChain.Application.Constants
@using CafeChain.Application.Interfaces.Admin.Permissions
@inject IAdminPermissionService PermissionService
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var canCreate = false; var canUpdate = false; var canToggle = false; var canAssign = false; var canViewTopping = false;
    if (int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var accountId))
    {
        canCreate = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.SizeCreate)).Data?.Allowed == true;
        canUpdate = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.SizeUpdate)).Data?.Allowed == true;
        canToggle = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.SizeToggleStatus)).Data?.Allowed == true;
        canAssign = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.SizeAssignDrink)).Data?.Allowed == true;
        canViewTopping = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.ToppingView)).Data?.Allowed == true;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/Size/size.css" asp-append-version="true" />
}

<div class="container-fluid p-4 size-admin-page">
    @Html.AntiForgeryToken()

    <div class="size-page-heading">
        <div class="size-page-heading-content">
            <div class="size-page-heading-icon"><i class="fas fa-ruler-combined"></i></div>
            <div>
                <span class="size-page-kicker"><i class="fas fa-layer-group me-1"></i> CẤU TRÚC THỰC ĐƠN</span>
                <h1>Quản lý Size đồ uống</h1>
                <p>Thiết lập mã hiển thị, tên gọi và loại kích thước sử dụng trên thực đơn.</p>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <div class="size-page-tabs d-flex mb-3">
        <a asp-area="Admin"
           asp-controller="AdminSize"
           asp-action="Index"
           class="text-decoration-none fw-semibold @(currentController == "AdminSize" ? "active" : "")">
            Quản lý Size
        </a>

        @if (canViewTopping)
        {
            <a asp-area="Admin"
               asp-controller="AdminTopping"
               asp-action="Index"
               class="text-decoration-none fw-semibold @(currentController == "AdminTopping" ? "active" : "")">
                Quản lý Topping
            </a>
        }
    </div>
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- Card -->
    <div class="main-card shadow-sm p-3">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">Danh sách Size</h5>

            @if (canCreate)
            {
            <button class="btn btn-orange px-3"
                    data-bs-toggle="modal"
                    data-bs-target="#createModal">
                <i class="fas fa-plus me-2"></i> Thêm mới
            </button>
            }
        </div>

        <!-- Table -->
        <div class="size-table-wrap">
        <table class="table table-borderless align-middle">
            <thead class="text-muted">
                <tr>
                    <th class="text-center" style="width: 12%;">MÃ SIZE</th>
                    <th style="width: 18%;">TÊN SIZE</th>
                    <th style="width: 30%;">MÔ TẢ</th>
                    <th class="text-center" style="width: 12%;">LOẠI SIZE</th>
                    <th class="text-center" style="width: 14%;">TRẠNG THÁI</th>
                    <th class="text-center" style="width: 14%;">HÀNH ĐỘNG</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="border-top">
                        <td class="text-center">
                            <span class="size-code-badge">
                                @item.SizeCode
                            </span>
                        </td>

                        <td>
                            <div class="d-flex align-items-center">
                                <div class="size-badge me-3">
                                    @item.Name
                                </div>
                            </div>
                        </td>

                        <td>@item.Description</td>

                        <td class="text-center">
                            <span class="size-type-badge @(item.SizeType == CafeChain.Models.Enums.Drink.SizeTypeEnum.Volume ? "size-type-volume" : "size-type-cup")">
                                @(item.SizeType == CafeChain.Models.Enums.Drink.SizeTypeEnum.Volume ? "Dung tích" : "Ly")
                            </span>
                        </td>

                        <td class="text-center">
                            @if (item.Active)
                            {
                                <span class="status-active">Hoạt động</span>
                            }
                            else
                            {
                                <span class="status-inactive">Ngừng</span>
                            }
                        </td>

                        <td class="text-center">
                            <div class="d-inline-flex align-items-center justify-content-center gap-1">
                                <!-- ASSIGN DRINK-->
                                @if (canAssign)
                                {
                                <button class="size-action-btn is-assign"
                                        title="Gán đồ uống"
                                        onclick="openDrinkModal(@item.SizeId, '@item.Name')">
                                    <i class="fas fa-link"></i>
                                </button>
                                }

                                <!-- EDIT -->
                                @if (canUpdate)
                                {
                                <button class="size-action-btn is-edit"
                                        title="Chỉnh sửa"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editModal"
                                        onclick="openEditModal(
                                    @item.SizeId,
                                    '@Html.Raw(item.SizeCode?.Replace("'", "\\'"))',
                                    '@Html.Raw(item.Name?.Replace("'", "\\'"))',
                                    '@Html.Raw(item.Description?.Replace("'", "\\'"))',
                                    @((int)item.SizeType)
                                    )">
                                    <i class="fas fa-pen"></i>
                                </button>
                                }

                                <!-- TOGGLE -->
                                @if (canToggle)
                                {
                                <button class="size-action-btn @(item.Active ? "is-lock" : "is-unlock")"
                                        title="@(item.Active ? "Khóa" : "Mở khóa")"
                                        onclick="toggleSize(@item.SizeId)">
                                    <i class="fas @(item.Active ? "fa-lock" : "fa-unlock")"></i>
                                </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>

    </div>
</div>

<!-- ================= CREATE MODAL ================= -->
<div class="modal fade size-module-modal" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered size-modal-dialog">
        <div class="modal-content p-3 size-modal">

            <!-- Header -->
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-start gap-2">
                    <div class="size-modal-icon">
                        <i class="fas fa-mug-hot"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Thêm mới Size đồ uống</h6>
                        <small class="text-muted text-uppercase" style="font-size:11px;">
                            Cấu hình thực đơn
                        </small>
                    </div>
                </div>

                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Form -->
            <form id="createSizeForm">
                <div class="modal-body">

                    <div class="row g-3 size-primary-fields">
                        <!-- Mã Size -->
                        <div class="col-md-3 size-code-field">
                            <label class="form-label fw-semibold">
                                Mã Size <span class="text-danger">*</span>
                            </label>
                            <input id="create-code"
                                   name="SizeCode"
                                   class="form-control bg-light text-center"
                                   placeholder="M"
                                   maxlength="20"
                                   required />
                        </div>

                        <!-- Tên Size -->
                        <div class="col-md-4 size-name-field">
                            <label class="form-label fw-semibold">
                                Tên Size <span class="text-danger">*</span>
                            </label>
                            <input id="create-name"
                                   name="Name"
                                   class="form-control bg-light text-center"
                                   placeholder="Size vừa"
                                   maxlength="50"
                                   required />
                        </div>

                        <div class="col-md-5 size-type-field">
                            <label class="form-label fw-semibold">
                                Loại Size <span class="text-danger">*</span>
                            </label>
                            <select id="create-size-type"
                                    name="SizeType"
                                    class="form-select bg-light"
                                    required>
                                <option value="" selected>-- Chọn loại size --</option>
                                <option value="1">Ly</option>
                                <option value="2">Dung tích</option>
                            </select>
                        </div>

                        <!-- Mô Tả Size -->
                        <div class="col-12 size-description-field">
                            <label class="form-label fw-semibold">
                                Mô Tả Size
                            </label>
                            <input id="create-description"
                                   name="Description"
                                   class="form-control bg-light"
                                   placeholder="Ví dụ: Size vừa"
                                   maxlength="300" />
                        </div>

                        <div class="col-12 size-ai-section d-none">
                            <label for="sizeAiIdea" class="form-label fw-semibold">Ý tưởng cho AI <span class="text-muted fw-normal">(không bắt buộc)</span></label>
                            <select id="sizeAiGenerationMode" class="form-select mb-2" aria-label="Chế độ gợi ý size">
                                <option value="0">Tạo mới</option>
                                <option value="1">Phát triển dữ liệu đang nhập</option>
                                <option value="2">Tạo biến thể</option>
                            </select>
                            <input id="sizeAiIdea" class="form-control mb-2" maxlength="200" placeholder="Ví dụ: chai 330ml" autocomplete="off" />
                            <button type="button" id="btnSizeAiSuggestion" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-wand-magic-sparkles me-1"></i> AI gợi ý
                            </button>
                            <div id="sizeAiSuggestionPanel" class="ai-suggestion-panel mt-2 d-none">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong>Chọn một gợi ý</strong>
                                    <span id="sizeAiSource" class="badge bg-secondary"></span>
                                </div>
                                <div id="sizeAiOptionList" class="ai-option-grid"></div>
                                <div id="sizeAiWarnings" class="small text-warning mt-2"></div>
                                <div class="d-flex gap-2 mt-2">
                                    <button type="button" id="btnApplySizeAi" class="btn btn-primary btn-sm" disabled>Áp dụng</button>
                                    <button type="button" id="btnDismissSizeAi" class="btn btn-light btn-sm">Bỏ qua</button>
                                </div>
                            </div>
                        </div>

                    </div>

                    <p class="text-muted small mt-3 mb-0">
                        Sử dụng mã ngắn (S, M, L) để hiển thị nhanh trên hóa đơn.
                    </p>

                </div>

                <!-- Footer -->
                <div class="modal-footer border-0 pt-2">
                    <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal">
                        Hủy bỏ
                    </button>

                    <button type="submit" class="btn btn-orange px-4">
                        <i class="fas fa-save me-2"></i> Lưu thông tin
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>
<!-- ================= EDIT MODAL ================= -->
<div class="modal fade size-module-modal" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered size-modal-dialog">
        <div class="modal-content p-3 size-modal">

            <!-- Header -->
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-start gap-2">
                    <div class="size-modal-icon is-edit">
                        <i class="fas fa-pen"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Chỉnh sửa Size</h6>
                        <small class="text-muted text-uppercase" style="font-size:11px;">
                            Cập nhật thông tin
                        </small>
                    </div>
                </div>

                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Form -->
            <form id="editSizeForm">
                <input type="hidden" id="edit-id" name="SizeId" />

                <div class="modal-body">

                    <div class="row g-3 size-primary-fields">

                        <!-- Mã -->
                        <div class="col-md-3 size-code-field">
                            <label class="form-label fw-semibold">
                                Mã Size <span class="text-danger">*</span>
                            </label>
                            <input id="edit-code"
                                   name="SizeCode"
                                   class="form-control bg-light text-center"
                                   maxlength="20"
                                   required />
                        </div>

                        <!-- Tên -->
                        <div class="col-md-4 size-name-field">
                            <label class="form-label fw-semibold">
                                Tên Size <span class="text-danger">*</span>
                            </label>
                            <input id="edit-name"
                                   name="Name"
                                   class="form-control bg-light text-center"
                                   maxlength="50"
                                   required />
                        </div>

                        <div class="col-md-5 size-type-field">
                            <label class="form-label fw-semibold">
                                Loại Size <span class="text-danger">*</span>
                            </label>
                            <select id="edit-size-type"
                                    name="SizeType"
                                    class="form-select bg-light"
                                    required>
                                <option value="1">Ly</option>
                                <option value="2">Dung tích</option>
                            </select>
                        </div>

                        <!-- Mô tả -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">
                                Mô Tả Size
                            </label>
                            <input id="edit-description"
                                   name="Description"
                                   class="form-control bg-light"
                                   maxlength="300" />
                        </div>

                    </div>

                </div>

                <!-- Footer -->
                <div class="modal-footer border-0 pt-2">
                    <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal">
                        Hủy bỏ
                    </button>

                    <button type="submit" class="btn btn-orange px-4">
                        <i class="fas fa-check me-2"></i> Cập nhật
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<!-- ================= DRINK MODAL ================= -->
<div class="modal fade size-module-modal" id="drinkModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">

            <!-- HEADER -->
            <div class="modal-header border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <div class="size-modal-icon">
                        <i class="fas fa-glass-martini-alt"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-dark" id="drinkModalTitle">Quản lý đồ uống theo Size</h5>
                        <small class="text-muted">Gán hoặc ngắt kết nối đồ uống với kích thước này</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body p-4">
                <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
                    <span class="badge bg-brown px-3 py-2 fs-6 rounded-pill" id="currentSizeBadge">Size</span>
                    <span class="small text-muted"><i class="fas fa-info-circle me-1"></i>Bấm Gán để thêm đồ uống vào Size, hoặc Tắt để ngừng bán Size này</span>
                </div>

                <div class="row g-4">
                    <!-- UNASSIGNED -->
                    <div class="col-md-6">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="fw-bold mb-0 text-secondary"><i class="fas fa-plus-circle me-1 text-primary"></i> Chưa gán</h6>
                        </div>
                        <div id="unassignedList" class="d-flex flex-column gap-2"></div>
                    </div>

                    <!-- ASSIGNED -->
                    <div class="col-md-6">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="fw-bold mb-0 text-secondary"><i class="fas fa-check-circle me-1 text-success"></i> Đã gán</h6>
                        </div>
                        <div id="assignedList" class="d-flex flex-column gap-2"></div>
                    </div>
                </div>
            </div>

            <!-- FOOTER -->
            <div class="modal-footer border-top bg-light">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Đóng</button>
            </div>

        </div>
    </div>
</div>


<div class="modal fade size-module-modal" id="priceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">

            <div class="modal-header border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <div class="size-modal-icon is-edit" style="width: 32px; height: 32px; flex: 0 0 32px; font-size: 14px;">
                        <i class="fas fa-tag"></i>
                    </div>
                    <h6 class="fw-bold mb-0 text-dark">Nhập giá bán</h6>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-3">
                <label for="priceInput" class="form-label small text-muted">Giá bán (VNĐ)</label>
                <div class="input-group">
                    <input type="number" id="priceInput" class="form-control" placeholder="Ví dụ: 35000" min="1000" step="1000" />
                    <span class="input-group-text bg-light text-muted">đ</span>
                </div>
            </div>

            <div class="modal-footer border-top bg-light p-2">
                <button type="button" class="btn btn-light btn-sm px-3" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-orange btn-sm px-3" onclick="confirmAssign()"><i class="fas fa-check me-1"></i>Xác nhận</button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/Admin/DrinkSize/drinksize.js" asp-append-version="true"></script>
}
