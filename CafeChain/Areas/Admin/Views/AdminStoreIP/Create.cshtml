@model CafeChain.Models.Stores.StoreIP
@{
    ViewData["Title"] = "Thêm IP chấm công";
    var stores = ViewBag.Stores as List<CafeChain.Models.Stores.Store>;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/Store/store-admin.css" asp-append-version="true" />
}

<div class="store-admin-page">
    <header class="store-admin-header">
        <div>
            <span class="store-admin-kicker">IP chấm công</span>
            <h1 class="store-admin-title">Thêm IP mới</h1>
            <p class="store-admin-subtitle">
                Cấu hình IP hoặc dải IP được phép dùng cho kiosk chấm công.
            </p>
        </div>

        <a asp-action="Index" class="store-admin-btn store-admin-btn-ghost">
            <i class="fas fa-arrow-left"></i>
            Quay lại danh sách
        </a>
    </header>

    <div class="store-admin-form-shell">
    <section class="store-admin-card store-admin-form-card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Cửa hàng <span class="text-danger">*</span></label>
                <select asp-for="StoreId" class="form-select">
                    <option value="">-- Chọn cửa hàng --</option>
                    @if (stores != null)
                    {
                        foreach (var s in stores)
                        {
                            <option value="@s.StoreId">@s.Name</option>
                        }
                    }
                </select>
                <span asp-validation-for="StoreId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Địa chỉ IP <span class="text-danger">*</span></label>
                <input asp-for="IPAddress" class="form-control" placeholder="VD: 192.168.1.* hoặc 113.161.2.45" />
                <div class="form-text">Hỗ trợ IP cố định hoặc dải IP dùng dấu * cho subnet.</div>
                <span asp-validation-for="IPAddress" class="text-danger small"></span>
            </div>

            <div class="store-admin-setting-panel">
                <div>
                    <span class="store-admin-setting-title">Thiết lập</span>
                    <p>Phân loại mạng và trạng thái sử dụng cho địa chỉ IP này.</p>
                </div>

                <div class="form-check form-switch">
                    <input asp-for="IsPublicNetwork" class="form-check-input" type="checkbox" />
                    <label class="form-check-label">Đây là IP công cộng</label>
                </div>

                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                    <label class="form-check-label">Kích hoạt ngay</label>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label">Ghi chú</label>
                <textarea asp-for="Notes" class="form-control" rows="3" placeholder="VD: WiFi tầng 2, router chính..."></textarea>
            </div>

            <button type="submit" class="store-admin-btn store-admin-btn-primary w-100">
                <i class="fas fa-plus"></i>
                Thêm địa chỉ IP
            </button>
        </form>
    </section>
    </div>
</div>
