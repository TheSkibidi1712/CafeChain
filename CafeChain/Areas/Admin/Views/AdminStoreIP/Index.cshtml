@model List<CafeChain.Models.Stores.StoreIP>
@{
    ViewData["Title"] = "Quản lý IP chấm công";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/Store/store-admin.css" asp-append-version="true" />
}

<div class="store-admin-page">
    <header class="store-admin-header">
        <div>
            <span class="store-admin-kicker">Nhân sự & vận hành</span>
            <h1 class="store-admin-title">IP chấm công</h1>
            <p class="store-admin-subtitle">
                Quản lý dải IP được phép dùng cho kiosk chấm công tại từng cửa hàng.
            </p>
        </div>

        <a asp-action="Create" class="store-admin-btn store-admin-btn-primary" aria-label="Thêm IP chấm công mới">
            <i class="fas fa-plus"></i>
            Thêm IP mới
        </a>
    </header>

    <section class="store-admin-stat-grid">
        <div class="store-admin-card store-admin-stat">
            <div>
                <span>Tổng IP đã cấp</span>
                <strong>@Model.Count</strong>
            </div>
            <div class="store-admin-stat-icon">
                <i class="fas fa-network-wired"></i>
            </div>
        </div>

        <div class="store-admin-card store-admin-stat">
            <div>
                <span>Đang hoạt động</span>
                <strong>@Model.Count(x => x.IsActive)</strong>
            </div>
            <div class="store-admin-stat-icon">
                <i class="fas fa-check-circle"></i>
            </div>
        </div>

        <div class="store-admin-card store-admin-stat">
            <div>
                <span>Vô hiệu hóa</span>
                <strong>@Model.Count(x => !x.IsActive)</strong>
            </div>
            <div class="store-admin-stat-icon">
                <i class="fas fa-ban"></i>
            </div>
        </div>
    </section>

    <section class="store-admin-card">
        <div class="store-admin-table-wrap">
            <table class="table table-hover align-middle store-admin-table">
                <thead>
                    <tr>
                        <th>Cửa hàng / vị trí</th>
                        <th>Địa chỉ IP</th>
                        <th>Ngày tạo</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@((item.Store?.Name) ?? "N/A")</div>
                                <div class="text-muted small">@(item.IsPublicNetwork ? "IP công cộng" : "Mạng nội bộ")</div>
                            </td>
                            <td>
                                <code class="store-admin-code">@item.IPAddress</code>
                                @if ((item.IPAddress ?? "").Contains('*'))
                                {
                                    <span class="store-admin-badge is-muted ms-2">Dải mạng</span>
                                }
                            </td>
                            <td class="text-muted">@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="store-admin-badge is-active">
                                        <i class="fas fa-circle-check"></i>
                                        Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="store-admin-badge is-inactive">
                                        <i class="fas fa-circle-xmark"></i>
                                        Vô hiệu hóa
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="store-admin-actions">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="store-admin-icon-btn"
                                       title="Chỉnh sửa IP chấm công"
                                       aria-label="Chỉnh sửa IP @item.IPAddress">
                                        <i class="fas fa-pen"></i>
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc muốn xóa IP này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="store-admin-icon-btn store-admin-btn-danger"
                                                title="Xóa địa chỉ IP"
                                                aria-label="Xóa địa chỉ IP @item.IPAddress">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="store-admin-empty">
                                <i class="fas fa-database me-2"></i>
                                Chưa có địa chỉ IP nào được cấu hình.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
