@using CafeChain.Application.DTOs.Admin.StoreScope
@using Microsoft.Extensions.Localization
@using System.Text.Json
@inject IStringLocalizer<OrderResource> L
@{
    ViewData["Title"] = L["Order.History.Title"].Value;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var stores = ViewBag.StoreOptions as IReadOnlyList<AdminStoreOptionDto>
        ?? Array.Empty<AdminStoreOptionDto>();
    var selectedStoreId = ViewBag.SelectedStoreId as int?;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/Order/orderhistory.css" asp-append-version="true" />
}

<main class="sales-history-page ops-shell cc-warehouse-page">

    <!-- Header Banner -->
    <header class="sales-history-header ops-header cc-warehouse-header">
        <div>
            <div class="sales-eyebrow ops-eyebrow">@L["Order.History.Eyebrow"]</div>
            <h1 class="sales-history-title ops-title"><i class="fa-solid fa-clock-rotate-left me-2 text-warning" aria-hidden="true"></i> @L["Order.History.Title"]</h1>
            <p class="sales-history-subtitle ops-subtitle">@L["Order.History.Subtitle"]</p>
        </div>
        <div class="sales-history-actions ops-actions">
            <button class="btn btn-export-csv" id="btnExportCsv">
                <i class="fas fa-file-csv" aria-hidden="true"></i> @L["Order.History.ExportCsv"]
            </button>
        </div>
    </header>

    <!-- KPI Cards Grid -->
    <section class="history-kpis-grid" aria-label="@L["Order.History.KpiAria"]">
        <div class="history-kpi-card">
            <div class="history-kpi-icon">
                <i class="fas fa-shopping-bag" aria-hidden="true"></i>
            </div>
            <div class="history-kpi-content">
                <strong class="history-kpi-value" id="paidOrders">-</strong>
                <span class="history-kpi-label">@L["Order.History.Kpi.PaidOrders"]</span>
            </div>
        </div>

        <div class="history-kpi-card history-kpi-card--revenue">
            <div class="history-kpi-icon">
                <i class="fas fa-coins" aria-hidden="true"></i>
            </div>
            <div class="history-kpi-content">
                <strong class="history-kpi-value" id="paidRevenue">-</strong>
                <span class="history-kpi-label">@L["Order.History.Kpi.Revenue"]</span>
            </div>
        </div>

        <div class="history-kpi-card history-kpi-card--refund">
            <div class="history-kpi-icon">
                <i class="fas fa-undo" aria-hidden="true"></i>
            </div>
            <div class="history-kpi-content">
                <strong class="history-kpi-value" id="refundedOrders">-</strong>
                <span class="history-kpi-label">@L["Order.History.Kpi.Refunded"]</span>
            </div>
        </div>

        <div class="history-kpi-card history-kpi-card--refund-value">
            <div class="history-kpi-icon">
                <i class="fas fa-hand-holding-usd" aria-hidden="true"></i>
            </div>
            <div class="history-kpi-content">
                <strong class="history-kpi-value" id="refundedAmount">-</strong>
                <span class="history-kpi-label">@L["Order.History.Kpi.RefundValue"]</span>
            </div>
        </div>
    </section>

    <!-- Main Module Panel -->
    <section class="history-panel">
        <div class="history-filter-toolbar">
            <div class="history-filter-grid">
            <div class="history-field">
                <label for="filterStore">@L["Order.History.Filter.Store"]</label>
                <select class="form-select" id="filterStore">
                    @if (stores.Count > 1)
                    {
                        <option value="">@L["Order.History.Filter.AllStores"]</option>
                    }
                    @foreach (var store in stores)
                    {
                        <option value="@store.StoreId"
                                selected="@(stores.Count == 1 || (stores.Count > 1 && selectedStoreId == store.StoreId))">
                            @store.StoreName
                        </option>
                    }
                </select>
            </div>

            <div class="history-field">
                <label for="filterSearch">@L["Order.History.Filter.Search"]</label>
                <input class="form-control" id="filterSearch" placeholder="@L["Order.History.Filter.SearchPlaceholder"]" autocomplete="off" />
            </div>

            <div class="history-field">
                <label for="filterDateFrom">@L["Order.History.Filter.FromDate"]</label>
                <input type="date" class="form-control" id="filterDateFrom" />
            </div>

            <div class="history-field">
                <label for="filterDateTo">@L["Order.History.Filter.ToDate"]</label>
                <input type="date" class="form-control" id="filterDateTo" />
            </div>

            <div class="history-field">
                <label for="filterStatus">@L["Order.History.Filter.Finance"]</label>
                <select class="form-select" id="filterStatus">
                    <option value="">@L["Order.History.Filter.AllStatuses"]</option>
                    <option value="2">@L["Order.History.Filter.Paid"]</option>
                    <option value="3">@L["Order.History.Filter.Refunded"]</option>
                </select>
            </div>

            <div class="history-field">
                <label for="filterPayment">@L["Order.History.Filter.Payment"]</label>
                <select class="form-select" id="filterPayment">
                    <option value="">@L["Order.History.Filter.AllPayments"]</option>
                    <option value="1">@L["Order.History.Filter.Cash"]</option>
                    <option value="2">@L["Order.History.Filter.VietQR"]</option>
                    <option value="3">@L["Order.History.Filter.WalletLegacy"]</option>
                </select>
            </div>

            <button class="btn btn-reset-filter" id="btnReset" title="@L["Order.History.Filter.ResetTitle"]">
                <i class="fas fa-rotate-left" aria-hidden="true"></i> @L["Order.History.Filter.Reset"]
            </button>
        </div>
        </div>

        <div class="history-table-wrap">
            <table class="table history-table">
                <thead>
                    <tr>
                        <th class="text-center">@L["Order.History.Col.Code"]</th>
                        <th class="text-center">@L["Order.History.Col.PaidAt"]</th>
                        <th>@L["Order.History.Col.Store"]</th>
                        <th>@L["Order.History.Col.Cashier"]</th>
                        <th class="text-center">@L["Order.History.Col.OrderType"]</th>
                        <th class="text-end">@L["Order.History.Col.Total"]</th>
                        <th class="text-center">@L["Order.History.Col.Payment"]</th>
                        <th class="text-center">@L["Order.History.Col.Finance"]</th>
                        <th class="text-center">@L["Order.History.Col.Sync"]</th>
                        <th class="text-center">@L["Order.History.Col.Receipt"]</th>
                        <th class="text-center">@L["Order.History.Col.Label"]</th>
                        <th class="text-center">@L["Order.History.Col.Inventory"]</th>
                        <th class="text-center">@L["Order.History.Col.Actions"]</th>
                    </tr>
                </thead>
                <tbody id="historyBody"></tbody>
            </table>
        </div>
        <div class="history-pagination-bar">
            <span id="paginationInfo">@L["Order.History.Loading"]</span>
            <div class="history-pagination__buttons" id="paginationButtons"></div>
        </div>
    </section>

</main>

<aside class="offcanvas offcanvas-end history-drawer" tabindex="-1" id="orderDetailDrawer">
    <div class="offcanvas-header">
        <div>
            <div class="text-muted small">@L["Order.History.Drawer.Kicker"]</div>
            <h5 class="offcanvas-title fw-bold" id="drawerTitle">@L["Order.History.Drawer.Title"]</h5>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="@L["Order.History.Drawer.Close"]"></button>
    </div>
    <div class="offcanvas-body p-0" id="drawerBody"></div>
</aside>

@section Scripts {
<script type="application/json" id="order-history-ui-catalog">@Html.Raw(JsonSerializer.Serialize(L.GetAllStrings().Where(x => x.Name.StartsWith("Order.History.Js.")).ToDictionary(x => x.Name, x => x.Value)))</script>
<script>
(() => {
    const catalog = CafeChainUiCatalog.read('order-history-ui-catalog');
    const t = (key, values) => CafeChainUiCatalog.text(catalog, key, values);
    const state = { page: 1, pageSize: 20, totalPages: 0, loading: false };
    const body = document.getElementById('historyBody');
    const drawerElement = document.getElementById('orderDetailDrawer');
    const drawer = bootstrap.Offcanvas.getOrCreateInstance(drawerElement);
    const money = value => `${new Intl.NumberFormat('vi-VN').format(Number(value || 0))}đ`;
    const dateTime = value => value
        ? new Date(value).toLocaleString('vi-VN', { hour:'2-digit', minute:'2-digit', day:'2-digit', month:'2-digit', year:'numeric' })
        : t('Order.History.Js.Unknown');
    const escapeHtml = value => String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    const pill = (value, tone = 'neutral') =>
        `<span class="history-pill history-pill--${tone}">${escapeHtml(value || t('Order.History.Js.Unknown'))}</span>`;

    function currentFilter() {
        const storeValue = document.getElementById('filterStore').value;
        return {
            keyword: document.getElementById('filterSearch').value.trim(),
            fromDate: document.getElementById('filterDateFrom').value,
            toDate: document.getElementById('filterDateTo').value,
            statusId: document.getElementById('filterStatus').value,
            paymentId: document.getElementById('filterPayment').value,
            storeId: storeValue,
            allWithinScope: storeValue === '',
            page: state.page,
            pageSize: state.pageSize
        };
    }

    function queryString(includePage = true) {
        const filter = currentFilter();
        if (!includePage) {
            delete filter.page;
            delete filter.pageSize;
        }
        const params = new URLSearchParams();
        Object.entries(filter).forEach(([key, value]) => {
            if (value !== '' && value !== null && value !== undefined) {
                params.set(key, value);
            }
        });
        return params.toString();
    }

    async function loadHistory() {
        if (state.loading) return;
        state.loading = true;
        body.innerHTML = `<tr><td colspan="13" class="history-empty"><span class="spinner-border spinner-border-sm me-2"></span>${escapeHtml(t('Order.History.Js.Loading'))}</td></tr>`;
        try {
            const response = await fetch(`/api/AdminOrder/GetOrderHistoryData?${queryString()}`, {
                headers: { Accept: 'application/json' }
            });
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            const data = await response.json();
            state.page = data.page || 1;
            state.totalPages = data.totalPages || 0;
            renderStats(data.stats || {});
            renderRows(data.data || []);
            renderPagination(data);
        } catch (error) {
            console.error('[SalesHistory] Load failed', error);
            body.innerHTML = `<tr><td colspan="13" class="history-error">
                <div class="fw-bold">${escapeHtml(t('Order.History.Js.LoadFailed'))}</div>
                <button class="btn btn-sm btn-outline-danger mt-2" id="retryHistory">${escapeHtml(t('Order.History.Js.Retry'))}</button>
            </td></tr>`;
            document.getElementById('retryHistory')?.addEventListener('click', loadHistory);
            document.getElementById('paginationInfo').textContent = t('Order.History.Js.LoadFailedShort');
            document.getElementById('paginationButtons').innerHTML = '';
        } finally {
            state.loading = false;
        }
    }

    function renderStats(stats) {
        document.getElementById('paidOrders').textContent = Number(stats.paidOrders || 0).toLocaleString('vi-VN');
        document.getElementById('paidRevenue').textContent = money(stats.paidRevenue);
        document.getElementById('refundedOrders').textContent = Number(stats.refundedOrders || 0).toLocaleString('vi-VN');
        document.getElementById('refundedAmount').textContent = money(stats.refundedAmount);
    }

    function renderRows(rows) {
        if (!rows.length) {
            body.innerHTML = `<tr><td colspan="13" class="history-empty">
                <i class="fas fa-receipt history-empty-icon" aria-hidden="true"></i>
                <div>${escapeHtml(t('Order.History.Js.Empty'))}</div>
            </td></tr>`;
            return;
        }
        body.innerHTML = rows.map(row => `
            <tr>
                <td class="text-center"><span class="history-code">#CC${String(row.orderId).padStart(5, '0')}</span></td>
                <td class="text-center">${escapeHtml(row.createdAtDisplay || t('Order.History.Js.Unknown'))}</td>
                <td>${escapeHtml(row.storeName)}</td>
                <td>${escapeHtml(row.staffName)}</td>
                <td class="text-center">${escapeHtml(row.orderTypeName)}</td>
                <td class="text-end"><span class="history-money">${money(row.total)}</span></td>
                <td class="text-center">${escapeHtml(row.paymentMethodName)}</td>
                <td class="text-center">${pill(row.orderStatusName, row.orderStatusId === 3 ? 'refund' : 'paid')}</td>
                <td class="text-center">${pill(row.syncState)}</td>
                <td class="text-center">${pill(row.receiptState)}</td>
                <td class="text-center">${pill(row.drinkLabelState)}</td>
                <td class="text-center">${pill(row.inventoryPostingState)}</td>
                <td class="text-center">
                    <button class="btn btn-sm btn-outline-secondary js-detail"
                            data-order-id="${row.orderId}"
                            data-store-id="${row.storeId}"
                            title="${escapeHtml(t('Order.History.Js.ViewDetail'))}">
                        <i class="fas fa-eye"></i>
                    </button>
                </td>
            </tr>`).join('');
    }

    function renderPagination(data) {
        const total = Number(data.totalItems || 0);
        const start = total === 0 ? 0 : ((data.page - 1) * data.pageSize) + 1;
        const end = Math.min(total, data.page * data.pageSize);
        document.getElementById('paginationInfo').textContent =
            total === 0 ? t('Order.History.Js.ZeroTransactions') : t('Order.History.Js.PageRange', { start, end, total });

        const pages = [];
        const from = Math.max(1, data.page - 2);
        const to = Math.min(data.totalPages, data.page + 2);
        pages.push(`<button class="history-page-btn" data-page="${data.page - 1}" ${data.page <= 1 ? 'disabled' : ''} aria-label="${escapeHtml(t('Order.History.Js.PrevPage'))}">‹</button>`);
        for (let page = from; page <= to; page++) {
            pages.push(`<button class="history-page-btn ${page === data.page ? 'is-active' : ''}" data-page="${page}">${page}</button>`);
        }
        pages.push(`<button class="history-page-btn" data-page="${data.page + 1}" ${data.page >= data.totalPages ? 'disabled' : ''} aria-label="${escapeHtml(t('Order.History.Js.NextPage'))}">›</button>`);
        document.getElementById('paginationButtons').innerHTML = pages.join('');
    }

    async function openDetail(orderId, storeId) {
        const code = `#CC${String(orderId).padStart(5, '0')}`;
        document.getElementById('drawerTitle').textContent = t('Order.History.Js.OrderTitle', { code });
        document.getElementById('drawerBody').innerHTML =
            '<div class="p-5 text-center"><span class="spinner-border"></span></div>';
        drawer.show();
        try {
            const response = await fetch(`/api/AdminOrder/GetOrderHistoryDetail/${orderId}?storeId=${storeId}`, {
                headers: { Accept: 'application/json' }
            });
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            renderDetail(await response.json());
        } catch (error) {
            console.error('[SalesHistory] Detail failed', error);
            document.getElementById('drawerBody').innerHTML =
                `<div class="p-4 text-danger">${escapeHtml(t('Order.History.Js.DetailFailed'))}</div>`;
        }
    }

    function renderDetail(detail) {
        const payments = (detail.payments || []).map(payment => `
            <div class="drawer-line">
                <div>
                    <div class="drawer-line__title">${escapeHtml(payment.paymentMethodName)}</div>
                    <div class="drawer-line__meta">${escapeHtml(payment.paidAtDisplay || t('Order.History.Js.Unknown'))}</div>
                    ${payment.transactionCode ? `<div class="drawer-line__meta">${escapeHtml(t('Order.History.Js.TxnCode', { code: payment.transactionCode }))}</div>` : ''}
                    ${payment.receivedAmount != null ? `<div class="drawer-line__meta">${escapeHtml(t('Order.History.Js.Received', { received: money(payment.receivedAmount), change: money(payment.changeAmount) }))}</div>` : ''}
                </div>
                <div class="drawer-line__amount">${money(payment.amount)}</div>
            </div>`).join('');
        const items = (detail.items || []).map(item => `
            <div class="drawer-line">
                <div>
                    <div class="drawer-line__title">${item.quantity}× ${escapeHtml(item.drinkName)} ${item.sizeName ? `(${escapeHtml(item.sizeName)})` : ''}</div>
                    ${(item.toppings || []).map(topping => `<div class="drawer-line__meta">+ ${escapeHtml(topping.name)} (${money(topping.price)})</div>`).join('')}
                    ${item.note ? `<div class="drawer-line__meta">${escapeHtml(t('Order.History.Js.Note', { note: item.note }))}</div>` : ''}
                </div>
                <div class="drawer-line__amount">${money(item.price * item.quantity)}</div>
            </div>`).join('');
        const refund = detail.refund ? `
            <section class="drawer-section">
                <h3 class="drawer-section__title">${escapeHtml(t('Order.History.Js.Refund'))}</h3>
                <div class="drawer-grid">
                    ${field(t('Order.History.Js.RefundId'), `#${detail.refund.orderRefundId}`)}
                    ${field(t('Order.History.Js.Status'), refundStatus(detail.refund.status))}
                    ${field(t('Order.History.Js.Amount'), money(detail.refund.amount))}
                    ${field(t('Order.History.Js.CompletedAt'), dateTime(detail.refund.completedAtUtc))}
                </div>
                <div class="mt-3">${field(t('Order.History.Js.Reason'), detail.refund.reason)}</div>
            </section>` : '';

        document.getElementById('drawerBody').innerHTML = `
            <section class="drawer-section">
                <h3 class="drawer-section__title">${escapeHtml(t('Order.History.Js.TxnInfo'))}</h3>
                <div class="drawer-grid">
                    ${field(t('Order.History.Js.Store'), detail.storeName)}
                    ${field(t('Order.History.Js.Cashier'), detail.staffName)}
                    ${field(t('Order.History.Js.WorkShift'), detail.workShiftId ? `#${detail.workShiftId}` : t('Order.History.Js.Unknown'))}
                    ${field(t('Order.History.Js.OrderType'), detail.orderTypeName || t('Order.History.Js.Unknown'))}
                    ${field(t('Order.History.Js.PaidAt'), detail.createdAtDisplay || t('Order.History.Js.Unknown'))}
                    ${field(t('Order.History.Js.ClientOrderId'), detail.clientOrderId || t('Order.History.Js.None'))}
                </div>
            </section>
            <section class="drawer-section">
                <h3 class="drawer-section__title">${escapeHtml(t('Order.History.Js.State'))}</h3>
                <div class="drawer-grid">
                    ${field(t('Order.History.Js.Finance'), detail.orderStatusName)}
                    ${field(t('Order.History.Js.Sync'), detail.syncState)}
                    ${field(t('Order.History.Js.Receipt'), detail.receiptState)}
                    ${field(t('Order.History.Js.Label'), detail.drinkLabelState)}
                    ${field(t('Order.History.Js.Inventory'), detail.inventoryPostingState)}
                </div>
            </section>
            <section class="drawer-section">
                <h3 class="drawer-section__title">${escapeHtml(t('Order.History.Js.Payment'))}</h3>
                ${payments || `<div class="text-muted">${escapeHtml(t('Order.History.Js.NoPayment'))}</div>`}
            </section>
            <section class="drawer-section">
                <h3 class="drawer-section__title">${escapeHtml(t('Order.History.Js.SoldItems'))}</h3>
                ${items || `<div class="text-muted">${escapeHtml(t('Order.History.Js.NoItems'))}</div>`}
            </section>
            ${refund}
            <section class="drawer-section">
                <div class="drawer-line"><span>${escapeHtml(t('Order.History.Js.Subtotal'))}</span><strong>${money(detail.subTotal)}</strong></div>
                ${detail.discountTotal > 0 ? `<div class="drawer-line"><span>${escapeHtml(t('Order.History.Js.Discount'))}</span><strong>-${money(detail.discountTotal)}</strong></div>` : ''}
                <div class="drawer-line"><span>${escapeHtml(t('Order.History.Js.Tax'))}</span><strong>${escapeHtml(t('Order.History.Js.VatIncluded'))}</strong></div>
                <div class="drawer-total"><span>${escapeHtml(t('Order.History.Js.GrandTotal'))}</span><span>${money(detail.total)}</span></div>
            </section>`;
    }

    const field = (label, value) => `
        <div class="drawer-field">
            <div class="drawer-field__label">${escapeHtml(label)}</div>
            <div class="drawer-field__value">${escapeHtml(value ?? t('Order.History.Js.Unknown'))}</div>
        </div>`;
    const refundStatus = status => ({
        Requested: t('Order.History.Js.RefundRequested'),
        Processing: t('Order.History.Js.RefundProcessing'),
        Completed: t('Order.History.Js.RefundCompleted'),
        Failed: t('Order.History.Js.RefundFailed')
    })[status] || t('Order.History.Js.Unknown');

    let searchTimer;
    document.getElementById('filterSearch').addEventListener('input', () => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => { state.page = 1; loadHistory(); }, 350);
    });
    ['filterStore','filterDateFrom','filterDateTo','filterStatus','filterPayment'].forEach(id => {
        document.getElementById(id).addEventListener('change', () => {
            state.page = 1;
            loadHistory();
        });
    });
    document.getElementById('btnReset').addEventListener('click', () => {
        ['filterSearch','filterDateFrom','filterDateTo','filterStatus','filterPayment']
            .forEach(id => document.getElementById(id).value = '');
        state.page = 1;
        loadHistory();
    });
    document.getElementById('btnExportCsv').addEventListener('click', () => {
        window.location.href = `/api/AdminOrder/ExportCSV?${queryString(false)}`;
    });
    document.getElementById('paginationButtons').addEventListener('click', event => {
        const button = event.target.closest('[data-page]');
        if (!button || button.disabled) return;
        state.page = Number(button.dataset.page);
        loadHistory();
    });
    body.addEventListener('click', event => {
        const button = event.target.closest('.js-detail');
        if (!button) return;
        openDetail(Number(button.dataset.orderId), Number(button.dataset.storeId));
    });

    loadHistory();
})();
</script>
}
