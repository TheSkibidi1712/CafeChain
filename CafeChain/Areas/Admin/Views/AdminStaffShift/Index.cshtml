@model CafeChain.ViewModels.Admin.Staffs.StaffShiftManagementVM
@using System.Globalization
@using System.Text.Json
@using CafeChain.Application.Constants.Cloudinaries
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<OperationsResource> L
@{
    ViewData["Title"] = L["Shift.Index.Title"].Value;
    var days = Enumerable.Range(0, 7).Select(i => Model.StartDate.AddDays(i)).ToList();
    var schedules = Model.StaffRows.SelectMany(x => x.Schedules).ToList();
    var scheduledCount = schedules.Count(x => x.StatusCode == "SCHEDULED");
    var cancelledCount = schedules.Count(x => x.StatusCode == "CANCELLED");
    var activeTemplateCount = Model.Templates.Count(x => x.Active);
    var today = DateTime.Today;
    var todayOffset = (7 + today.DayOfWeek - DayOfWeek.Monday) % 7;
    var currentWeekStart = today.AddDays(-todayOffset);
    string DayName(DateTime date) => date.ToString("dddd", new CultureInfo("vi-VN"));
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />
    <link rel="stylesheet" href="~/css/Admin/StaffShift/admin-staff-shift.css" asp-append-version="true" />
}

<main id="staffShiftApp"
     class="shift-page shift-schedule-page ops-shell cc-warehouse-page"
     data-store-id="@Model.StoreId"
     data-week-start="@Model.StartDate.ToString("yyyy-MM-dd")"
     data-can-create="@Model.CanCreate.ToString().ToLowerInvariant()"
     data-index-url="@Url.Action("Index")"
     data-assign-url="@Url.Action("AssignShift")"
     data-update-schedule-url="@Url.Action("UpdateStaffShift")"
     data-cancel-schedule-url="@Url.Action("CancelStaffShift")"
     data-create-template-url="@Url.Action("CreateShift")"
     data-update-template-url="@Url.Action("UpdateShift")"
     data-toggle-template-url="@Url.Action("ToggleShift")">
    @Html.AntiForgeryToken()

    <header class="shift-page-header ops-header cc-warehouse-header">
        <div>
            <div class="shift-eyebrow">@L["Shift.Index.Eyebrow"]</div>
            <h1><i class="fa-solid fa-calendar-days me-2 text-warning" aria-hidden="true"></i> @L["Shift.Index.Title"]</h1>
            <p class="shift-subtitle-text text-muted mb-0" style="font-size: 13.5px; margin-top: 6px;">
                @L["Shift.Index.Subtitle", Model.StartDate.ToString("dd/MM/yyyy"), Model.StartDate.AddDays(6).ToString("dd/MM/yyyy")]
            </p>
        </div>

        <div class="shift-header-actions d-flex align-items-center gap-3 flex-wrap">
            @if (Model.Stores.Count > 1)
            {
                <select id="storeSelector" class="form-select form-select-sm shift-store-selector" aria-label="@L["Shift.Index.StoreSelectorAria"]" style="margin-top: 0 !important; height: 38px !important; min-width: 220px !important;">
                    @foreach (var store in Model.Stores)
                    {
                        <option value="@store.StoreId" selected="@(store.StoreId == Model.StoreId ? "selected" : null)">@store.StoreName</option>
                    }
                </select>
            }

            <nav class="week-nav" aria-label="@L["Shift.Index.WeekNavAria"]" style="display: inline-flex !important; align-items: center !important;">
                <a class="btn-nav" asp-action="Index" asp-route-targetStoreId="@Model.StoreId" asp-route-startDate="@Model.StartDate.AddDays(-7).ToString("yyyy-MM-dd")">
                    <i class="fa-solid fa-chevron-left"></i><span>@L["Shift.Index.PrevWeek"]</span>
                </a>
                <div class="week-label">@Model.StartDate.ToString("dd/MM") — @Model.StartDate.AddDays(6).ToString("dd/MM/yyyy")</div>
                <a class="btn-nav btn-today @(Model.StartDate == currentWeekStart ? "is-current" : "")"
                   asp-action="Index"
                   asp-route-targetStoreId="@Model.StoreId"
                   asp-route-startDate="@currentWeekStart.ToString("yyyy-MM-dd")"
                   aria-current="@(Model.StartDate == currentWeekStart ? "date" : null)">
                    <i class="fa-solid fa-calendar-day" aria-hidden="true"></i><span>@L["Shift.Index.CurrentWeek"]</span>
                </a>
                <a class="btn-nav" asp-action="Index" asp-route-targetStoreId="@Model.StoreId" asp-route-startDate="@Model.StartDate.AddDays(7).ToString("yyyy-MM-dd")">
                    <span>@L["Shift.Index.NextWeek"]</span><i class="fa-solid fa-chevron-right"></i>
                </a>
            </nav>
        </div>
    </header>

    <section class="shift-summary" aria-label="@L["Shift.Index.SummaryAria"]">
        <article class="summary-card summary-card-staff">
            <span class="summary-icon"><i class="fa-solid fa-users" aria-hidden="true"></i></span>
            <span><strong>@Model.StaffRows.Count</strong><small>@L["Shift.Index.Staff"]</small></span>
        </article>
        <article class="summary-card summary-card-scheduled">
            <span class="summary-icon"><i class="fa-solid fa-calendar-check" aria-hidden="true"></i></span>
            <span><strong>@scheduledCount</strong><small>@L["Shift.Index.ScheduledCount"]</small></span>
        </article>
        <article class="summary-card summary-card-cancelled">
            <span class="summary-icon"><i class="fa-solid fa-calendar-xmark" aria-hidden="true"></i></span>
            <span><strong>@cancelledCount</strong><small>@L["Shift.Index.CancelledCount"]</small></span>
        </article>
        <article class="summary-card summary-card-template">
            <span class="summary-icon"><i class="fa-solid fa-layer-group" aria-hidden="true"></i></span>
            <span><strong>@activeTemplateCount</strong><small>@L["Shift.Index.TemplateCount"]</small></span>
        </article>
    </section>

    <section class="template-library mb-4" aria-labelledby="templateLibraryTitle">
        <div class="template-library-header">
            <button class="template-library-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#templateLibraryBody" aria-expanded="true" aria-controls="templateLibraryBody">
                <span><i class="fa-solid fa-layer-group"></i> <strong id="templateLibraryTitle">@L["Shift.Index.TemplateLibrary"]</strong></span>
                <span class="template-library-hint">
                    @if (Model.CanCreate)
                    {
                        <span>@L["Shift.Index.TemplateLibraryHint"]</span>
                    }
                    <i class="fa-solid fa-chevron-down"></i>
                </span>
            </button>
            @if (Model.CanCreate)
            {
                <button class="btn btn-primary btn-sm" type="button" data-template-mode="create">
                    <i class="fa-solid fa-plus me-1"></i>@L["Shift.Index.CreateTemplate"]
                </button>
            }
        </div>

        <div id="templateLibraryBody" class="collapse show">
            <div class="template-library-body">
                <div class="template-palette" aria-label="@L["Shift.Index.ActiveTemplatesAria"]">
                    @foreach (var template in Model.Templates.Where(x => x.Active))
                    {
                        <article class="template-chip @(Model.CanCreate ? "draggable-template" : "")"
                                 draggable="@(Model.CanCreate ? "true" : "false")"
                                 tabindex="@(Model.CanCreate ? "0" : "-1")"
                                 data-template-id="@template.ShiftId"
                                 data-template-name="@template.Name"
                                 data-template-start="@template.StartTime.ToString(@"hh\:mm")"
                                 data-template-end="@template.EndTime.ToString(@"hh\:mm")"
                                 aria-label="@L["Shift.Index.TemplateAria", template.Name, template.StartTime.ToString(@"hh\:mm"), template.EndTime.ToString(@"hh\:mm")]">
                            <span class="template-chip-handle"><i class="fa-solid fa-grip-vertical"></i></span>
                            <span>
                                <strong>@template.Name</strong>
                                <small>@template.StartTime.ToString(@"hh\:mm") – @template.EndTime.ToString(@"hh\:mm") @(template.IsOvernight ? L["Shift.Index.PlusOneDay"].Value : "")</small>
                            </span>
                        </article>
                    }
                    @if (!Model.Templates.Any(x => x.Active))
                    {
                        <div class="template-empty">@L["Shift.Index.NoActiveTemplates"]</div>
                    }
                </div>

                <div class="table-responsive template-management">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr><th class="text-center">@L["Shift.Index.Col.Name"]</th><th class="text-center">@L["Shift.Index.Col.Time"]</th><th class="text-center">@L["Shift.Index.Col.Notes"]</th><th class="text-center">@L["Shift.Index.Col.Status"]</th><th class="text-center">@L["Shift.Index.Col.Actions"]</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var template in Model.Templates)
                        {
                            <tr class="@(template.Active ? "" : "template-inactive")">
                                <td class="fw-semibold text-center">@template.Name</td>
                                <td class="text-center">@template.StartTime.ToString(@"hh\:mm") – @template.EndTime.ToString(@"hh\:mm") @(template.IsOvernight ? L["Shift.Index.PlusOneDay"].Value : "")</td>
                                <td class="text-center">@template.Notes</td>
                                <td class="text-center"><span class="badge @(template.Active ? "bg-success" : "bg-secondary")">@(template.Active ? L["Shift.Index.Using"].Value : L["Shift.Index.Stopped"].Value)</span></td>
                                <td class="text-center">
                                    @if (Model.CanUpdate)
                                    {
                                        <div class="shift-template-actions">
                                            <button type="button" class="shift-action-btn shift-action-edit edit-template"
                                                    data-id="@template.ShiftId" data-name="@template.Name"
                                                    data-start="@template.StartTime.ToString(@"hh\:mm")" data-end="@template.EndTime.ToString(@"hh\:mm")"
                                                    data-notes="@template.Notes" data-version="@template.RowVersion"
                                                    title="@L["Shift.Index.EditTemplateTitle"]">
                                                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                                                <span>@L["Shift.Index.Edit"]</span>
                                            </button>
                                            <button type="button" class="shift-action-btn @(template.Active ? "shift-action-toggle-active" : "shift-action-toggle-inactive") toggle-template"
                                                    data-id="@template.ShiftId" data-version="@template.RowVersion"
                                                    title="@(template.Active ? L["Shift.Index.StopTemplateTitle"].Value : L["Shift.Index.ActivateTemplateTitle"].Value)">
                                                <i class="fa-solid @(template.Active ? "fa-ban" : "fa-circle-check")" aria-hidden="true"></i>
                                                <span>@(template.Active ? L["Shift.Index.Stop"].Value : L["Shift.Index.Activate"].Value)</span>
                                            </button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.Templates.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-3">@L["Shift.Index.NoTemplates"]</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>

    <section class="roster-section" aria-labelledby="weeklyRosterTitle">
        <div class="roster-toolbar">
            <div class="roster-toolbar-heading">
                <div>
                    <span class="section-eyebrow">@L["Shift.Index.RosterEyebrow"]</span>
                    <h3 id="weeklyRosterTitle">@L["Shift.Index.RosterTitle"]</h3>
                </div>
                <div class="schedule-legend" aria-label="@L["Shift.Index.LegendAria"]">
                    <span><i class="legend-dot legend-scheduled"></i> @L["Shift.Index.LegendScheduled"]</span>
                    <span><i class="legend-dot legend-cancelled"></i> @L["Shift.Index.LegendCancelled"]</span>
                </div>
            </div>
            <div class="roster-filters" role="search">
                <div class="roster-filter-field roster-filter-field--search">
                    <label class="filter-label" for="staffSearch">@L["Shift.Index.SearchStaff"]</label>
                    <div class="filter-control filter-search">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        <input id="staffSearch" type="search" autocomplete="off" placeholder="@L["Shift.Index.SearchStaffPlaceholder"]" />
                    </div>
                </div>
                <div class="roster-filter-field">
                    <label class="filter-label" for="scheduleStatusFilter">@L["Shift.Index.ScheduleStatus"]</label>
                    <div class="filter-control filter-select">
                        <select id="scheduleStatusFilter">
                            <option value="all">@L["Shift.Index.AllStatuses"]</option>
                            <option value="scheduled">@L["Shift.Index.HasSchedule"]</option>
                            <option value="unscheduled">@L["Shift.Index.NoSchedule"]</option>
                            <option value="cancelled">@L["Shift.Index.HasCancelledSchedule"]</option>
                        </select>
                    </div>
                </div>
                <button id="resetRosterFilters" class="filter-reset" type="button" hidden>
                    <i class="fa-solid fa-rotate-left" aria-hidden="true"></i> @L["Shift.Index.Reset"]
                </button>
            </div>
        </div>

        <div class="roster-meta">
            <span id="visibleStaffCount">@L["Shift.Index.Showing", Model.StaffRows.Count, Model.StaffRows.Count]</span>
            <span class="roster-scroll-hint"><i class="fa-solid fa-arrows-left-right" aria-hidden="true"></i> @L["Shift.Index.ScrollHint"]</span>
        </div>

        <div class="roster-container">
        <table class="roster-table">
            <thead>
                <tr>
                    <th class="staff-col">@L["Shift.Index.Col.Staff"]</th>
                    @foreach (var day in days)
                    {
                        var isToday = day.Date == DateTime.Today;
                        <th class="@(isToday ? "today-col" : "")">
                            <span class="text-capitalize">@DayName(day)</span><br />
                            <strong>@day.ToString("dd/MM")</strong>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
            @foreach (var staff in Model.StaffRows)
            {
                var staffScheduledCount = staff.Schedules.Count(x => x.StatusCode == "SCHEDULED");
                var staffCancelledCount = staff.Schedules.Count(x => x.StatusCode == "CANCELLED");
                <tr data-staff-row
                    data-staff-search="@($"{staff.StaffName} {staff.RoleNames}".ToLowerInvariant())"
                    data-scheduled-count="@staffScheduledCount"
                    data-cancelled-count="@staffCancelledCount">
                    <td class="staff-col">
                        <div class="staff-info">
                            <img src="@(string.IsNullOrWhiteSpace(staff.AvatarUrl) ? DefaultImages.StaffAvatarUrl : staff.AvatarUrl)"
                                 alt="@L["Shift.Index.StaffAvatar", staff.StaffName]" onerror="this.src='@DefaultImages.StaffAvatarUrl'" />
                            <div>
                                <div class="staff-name">@staff.StaffName</div>
                                <div class="staff-role">@staff.RoleNames</div>
                                <div class="staff-hours"><i class="fa-regular fa-clock" aria-hidden="true"></i> @L["Shift.Index.ShiftsInWeek", staffScheduledCount]</div>
                            </div>
                        </div>
                    </td>
                    @foreach (var day in days)
                    {
                        <td class="day-cell @(Model.CanCreate ? "schedule-drop-zone" : "")"
                            data-staff-id="@staff.StaffId"
                            data-staff-name="@staff.StaffName"
                            data-work-date="@day.ToString("yyyy-MM-dd")">
                            <div class="drop-indicator"><i class="fa-solid fa-arrow-down"></i> @L["Shift.Index.DropTemplateHere"]</div>
                            @foreach (var schedule in staff.Schedules.Where(x => x.WorkDate.Date == day.Date))
                            {
                                var cancelled = schedule.StatusCode == "CANCELLED";
                                <article class="schedule-card @(cancelled ? "cancelled" : "scheduled")">
                                    <div class="schedule-card-header">
                                        <div class="schedule-card-title">@schedule.ShiftName</div>
                                        <span class="schedule-status-dot" title="@(cancelled ? L["Shift.Index.LegendCancelled"].Value : L["Shift.Index.LegendScheduled"].Value)"></span>
                                    </div>
                                    <div class="schedule-card-time">
                                        <i class="fa-regular fa-clock" aria-hidden="true"></i>
                                        @schedule.EffectiveStart.ToString(@"hh\:mm") – @schedule.EffectiveEnd.ToString(@"hh\:mm")
                                        @if (schedule.IsOvernight) { <span class="overnight-badge">@L["Shift.Index.PlusOneDayBadge"]</span> }
                                    </div>
                                    @if (cancelled)
                                    {
                                        <span class="badge bg-secondary mt-1">@L["Shift.Index.LegendCancelled"]</span>
                                    }
                                    else
                                    {
                                        <div class="schedule-actions">
                                            @if (Model.CanUpdate)
                                            {
                                                <button type="button" class="edit-schedule" title="@L["Shift.Index.EditScheduleTitle", staff.StaffName]" aria-label="@L["Shift.Index.EditScheduleAria", schedule.ShiftName, staff.StaffName]"
                                                        data-id="@schedule.StaffShiftId" data-staff="@staff.StaffId" data-name="@staff.StaffName"
                                                        data-shift="@schedule.ShiftId" data-date="@day.ToString("yyyy-MM-dd")"
                                                        data-custom-start="@schedule.CustomStartTime?.ToString(@"hh\:mm")"
                                                        data-custom-end="@schedule.CustomEndTime?.ToString(@"hh\:mm")"
                                                        data-version="@schedule.RowVersion"><i class="fa-solid fa-pen" aria-hidden="true"></i><span>@L["Shift.Index.Edit"]</span></button>
                                            }
                                            @if (Model.CanCancel)
                                            {
                                                <button type="button" class="cancel-schedule" title="@L["Shift.Index.CancelScheduleTitle", staff.StaffName]" aria-label="@L["Shift.Index.CancelScheduleAria", schedule.ShiftName, staff.StaffName]"
                                                        data-id="@schedule.StaffShiftId" data-version="@schedule.RowVersion"><i class="fa-solid fa-xmark" aria-hidden="true"></i><span>@L["Shift.Index.Cancel"]</span></button>
                                            }
                                        </div>
                                    }
                                </article>
                            }
                            @if (Model.CanCreate)
                            {
                                <button type="button" class="empty-slot assign-schedule"
                                        data-staff="@staff.StaffId" data-name="@staff.StaffName" data-date="@day.ToString("yyyy-MM-dd")">
                                    <span><i class="fa-solid fa-plus"></i> @L["Shift.Index.Assign"]</span>
                                </button>
                            }
                        </td>
                    }
                </tr>
            }
            @if (!Model.StaffRows.Any())
            {
                <tr><td colspan="8"><div class="empty-state"><i class="fa-solid fa-folder-open"></i><strong>@L["Shift.Index.NoStaffInStore"]</strong></div></td></tr>
            }
            </tbody>
        </table>
        </div>
        <div id="rosterFilterEmpty" class="filter-empty" role="status" hidden>
            <span><i class="fa-solid fa-user-clock" aria-hidden="true"></i></span>
            <strong>@L["Shift.Index.FilterEmptyTitle"]</strong>
            <p>@L["Shift.Index.FilterEmptyText"]</p>
        </div>
    </section>
</main>

<div class="modal fade" id="scheduleModal" tabindex="-1" aria-labelledby="scheduleModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down">
        <div class="modal-content">
            <form id="scheduleForm">
                <div class="modal-header accent">
                    <div><span class="modal-kicker">@L["Shift.ScheduleModal.Kicker"]</span><h5 class="modal-title" id="scheduleModalTitle">@L["Shift.ScheduleModal.AssignTitle"]</h5></div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="@L["Shift.ScheduleModal.CloseAria"]"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" name="StaffShiftId" id="staffShiftId" />
                    <input type="hidden" name="StaffId" id="scheduleStaffId" />
                    <input type="hidden" name="WorkDate" id="scheduleDate" />
                    <input type="hidden" name="RowVersion" id="scheduleVersion" />

                    <div class="schedule-context mb-3">
                        <i class="fa-regular fa-calendar-check"></i>
                        <span id="scheduleContext"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="scheduleShift">@L["Shift.ScheduleModal.ShiftTemplate"] <span class="text-danger">*</span></label>
                        <select class="form-select" name="ShiftId" id="scheduleShift" required>
                            <option value="">@L["Shift.ScheduleModal.SelectTemplate"]</option>
                            @foreach (var template in Model.Templates.Where(x => x.Active))
                            {
                                <option value="@template.ShiftId">@template.Name (@template.StartTime.ToString(@"hh\:mm")–@template.EndTime.ToString(@"hh\:mm"))</option>
                            }
                        </select>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" name="UseCustomTime" value="true" id="useCustomTime" />
                        <label class="form-check-label" for="useCustomTime">@L["Shift.ScheduleModal.UseCustomTime"]</label>
                    </div>
                    <div class="row g-3">
                        <div class="col-6"><label class="form-label" for="customStart">@L["Shift.ScheduleModal.Start"]</label><input type="time" class="form-control custom-time" name="CustomStartTime" id="customStart" disabled /></div>
                        <div class="col-6"><label class="form-label" for="customEnd">@L["Shift.ScheduleModal.End"]</label><input type="time" class="form-control custom-time" name="CustomEndTime" id="customEnd" disabled /></div>
                    </div>
                    <div class="form-text mt-2">@L["Shift.ScheduleModal.CustomTimeHint"]</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["Shift.ScheduleModal.Close"]</button>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i>@L["Shift.ScheduleModal.Save"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="templateModal" tabindex="-1" aria-labelledby="templateModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down">
        <div class="modal-content">
            <form id="templateForm">
                <div class="modal-header accent"><div><span class="modal-kicker">@L["Shift.TemplateModal.Kicker"]</span><h5 class="modal-title" id="templateModalTitle">@L["Shift.TemplateModal.Title"]</h5></div><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="@L["Shift.TemplateModal.CloseAria"]"></button></div>
                <div class="modal-body p-4">
                    <input type="hidden" name="ShiftId" id="templateId" />
                    <input type="hidden" name="RowVersion" id="templateVersion" />
                    <div class="mb-3"><label class="form-label" for="templateName">@L["Shift.TemplateModal.Name"] <span class="text-danger">*</span></label><input class="form-control" name="Name" id="templateName" maxlength="100" required /></div>
                    <div class="row g-3">
                        <div class="col-6"><label class="form-label" for="templateStart">@L["Shift.TemplateModal.Start"] <span class="text-danger">*</span></label><input type="time" class="form-control" name="StartTime" id="templateStart" required /></div>
                        <div class="col-6"><label class="form-label" for="templateEnd">@L["Shift.TemplateModal.End"] <span class="text-danger">*</span></label><input type="time" class="form-control" name="EndTime" id="templateEnd" required /></div>
                    </div>
                    <div class="mt-3"><label class="form-label" for="templateNotes">@L["Shift.TemplateModal.Notes"]</label><textarea class="form-control" name="Notes" id="templateNotes" maxlength="500"></textarea></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["Shift.TemplateModal.Close"]</button><button type="submit" class="btn btn-primary">@L["Shift.TemplateModal.Save"]</button></div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script type="application/json" id="staff-shift-ui-catalog">@Html.Raw(JsonSerializer.Serialize(L.GetAllStrings().Where(x => x.Name.StartsWith("Shift.Js.")).ToDictionary(x => x.Name, x => x.Value)))</script>
    <script src="~/js/Admin/StaffShift/admin-staff-shift.js" asp-append-version="true"></script>
}
