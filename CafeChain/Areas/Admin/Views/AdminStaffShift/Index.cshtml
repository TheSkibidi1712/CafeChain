@model CafeChain.ViewModels.Admin.Staffs.StaffShiftManagementVM
@using System.Globalization
@using CafeChain.Application.Constants.Cloudinaries
@{
    ViewData["Title"] = "Quản lý lịch làm việc";
    var days = Enumerable.Range(0, 7).Select(i => Model.StartDate.AddDays(i)).ToList();
    var schedules = Model.StaffRows.SelectMany(x => x.Schedules).ToList();
    var scheduledCount = schedules.Count(x => x.StatusCode == "SCHEDULED");
    var cancelledCount = schedules.Count(x => x.StatusCode == "CANCELLED");
    var activeTemplateCount = Model.Templates.Count(x => x.Active);
    var today = DateTime.Today;
    var todayOffset = (7 + today.DayOfWeek - DayOfWeek.Monday) % 7;
    var currentWeekStart = today.AddDays(-todayOffset);
    string DayName(DateTime date) => date.ToString("dddd", new CultureInfo("vi-VN"));
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/StaffShift/admin-staff-shift.css" asp-append-version="true" />
}

<div id="staffShiftApp"
     class="container-fluid py-3 shift-page"
     data-store-id="@Model.StoreId"
     data-week-start="@Model.StartDate.ToString("yyyy-MM-dd")"
     data-can-create="@Model.CanCreate.ToString().ToLowerInvariant()"
     data-index-url="@Url.Action("Index")"
     data-assign-url="@Url.Action("AssignShift")"
     data-update-schedule-url="@Url.Action("UpdateStaffShift")"
     data-cancel-schedule-url="@Url.Action("CancelStaffShift")"
     data-create-template-url="@Url.Action("CreateShift")"
     data-update-template-url="@Url.Action("UpdateShift")"
     data-toggle-template-url="@Url.Action("ToggleShift")">
    @Html.AntiForgeryToken()

    <header class="shift-page-header">
        <div class="shift-heading-group">
            <span class="shift-page-kicker"><i class="fa-solid fa-people-group" aria-hidden="true"></i> Điều phối nhân sự</span>
            <h2>Quản lý lịch &amp; ca làm việc</h2>
            <div class="shift-page-subtitle">
                <span><i class="fa-solid fa-store" aria-hidden="true"></i> @Model.StoreName</span>
                <span><i class="fa-regular fa-calendar" aria-hidden="true"></i> @Model.StartDate.ToString("dd/MM/yyyy") – @Model.StartDate.AddDays(6).ToString("dd/MM/yyyy")</span>
            </div>

            @if (Model.Stores.Count > 1)
            {
                <select id="storeSelector" class="form-select form-select-sm shift-store-selector" aria-label="Chọn cửa hàng">
                    @foreach (var store in Model.Stores)
                    {
                        <option value="@store.StoreId" selected="@(store.StoreId == Model.StoreId ? "selected" : null)">@store.StoreName</option>
                    }
                </select>
            }
        </div>

        <nav class="week-nav" aria-label="Điều hướng tuần">
            <a class="btn-nav" asp-controller="AdminShiftOptimization" asp-action="Index" asp-route-targetStoreId="@Model.StoreId">
                <i class="fa-solid fa-sliders"></i><span>Cấu hình dữ liệu lịch</span>
            </a>
            <a class="btn-nav" asp-action="Index" asp-route-targetStoreId="@Model.StoreId" asp-route-startDate="@Model.StartDate.AddDays(-7).ToString("yyyy-MM-dd")">
                <i class="fa-solid fa-chevron-left"></i><span>Tuần trước</span>
            </a>
            <div class="week-label">@Model.StartDate.ToString("dd/MM") — @Model.StartDate.AddDays(6).ToString("dd/MM/yyyy")</div>
            <a class="btn-nav btn-today @(Model.StartDate == currentWeekStart ? "is-current" : "")"
               asp-action="Index"
               asp-route-targetStoreId="@Model.StoreId"
               asp-route-startDate="@currentWeekStart.ToString("yyyy-MM-dd")"
               aria-current="@(Model.StartDate == currentWeekStart ? "date" : null)">
                <i class="fa-solid fa-calendar-day" aria-hidden="true"></i><span>Tuần hiện tại</span>
            </a>
            <a class="btn-nav" asp-action="Index" asp-route-targetStoreId="@Model.StoreId" asp-route-startDate="@Model.StartDate.AddDays(7).ToString("yyyy-MM-dd")">
                <span>Tuần sau</span><i class="fa-solid fa-chevron-right"></i>
            </a>
        </nav>
    </header>

    <section class="shift-summary" aria-label="Tổng quan lịch làm việc trong tuần">
        <article class="summary-card summary-card-staff">
            <span class="summary-icon"><i class="fa-solid fa-users" aria-hidden="true"></i></span>
            <span><strong>@Model.StaffRows.Count</strong><small>Nhân viên</small></span>
        </article>
        <article class="summary-card summary-card-scheduled">
            <span class="summary-icon"><i class="fa-solid fa-calendar-check" aria-hidden="true"></i></span>
            <span><strong>@scheduledCount</strong><small>Lịch đang hoạt động</small></span>
        </article>
        <article class="summary-card summary-card-cancelled">
            <span class="summary-icon"><i class="fa-solid fa-calendar-xmark" aria-hidden="true"></i></span>
            <span><strong>@cancelledCount</strong><small>Lịch đã hủy</small></span>
        </article>
        <article class="summary-card summary-card-template">
            <span class="summary-icon"><i class="fa-solid fa-layer-group" aria-hidden="true"></i></span>
            <span><strong>@activeTemplateCount</strong><small>Mẫu ca đang dùng</small></span>
        </article>
    </section>

    <section class="template-library mb-4" aria-labelledby="templateLibraryTitle">
        <div class="template-library-header">
            <button class="template-library-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#templateLibraryBody" aria-expanded="true" aria-controls="templateLibraryBody">
                <span><i class="fa-solid fa-layer-group"></i> <strong id="templateLibraryTitle">Thư viện mẫu ca</strong></span>
                <span class="template-library-hint">
                    @if (Model.CanCreate)
                    {
                        <span>Kéo mẫu ca vào ô lịch hoặc click “Phân ca”</span>
                    }
                    <i class="fa-solid fa-chevron-down"></i>
                </span>
            </button>
            @if (Model.CanCreate)
            {
                <button class="btn btn-primary btn-sm" type="button" data-template-mode="create">
                    <i class="fa-solid fa-plus me-1"></i>Tạo mẫu ca
                </button>
            }
        </div>

        <div id="templateLibraryBody" class="collapse show">
            <div class="template-library-body">
                <div class="template-palette" aria-label="Các mẫu ca đang hoạt động">
                    @foreach (var template in Model.Templates.Where(x => x.Active))
                    {
                        <article class="template-chip @(Model.CanCreate ? "draggable-template" : "")"
                                 draggable="@(Model.CanCreate ? "true" : "false")"
                                 tabindex="@(Model.CanCreate ? "0" : "-1")"
                                 data-template-id="@template.ShiftId"
                                 data-template-name="@template.Name"
                                 data-template-start="@template.StartTime.ToString(@"hh\:mm")"
                                 data-template-end="@template.EndTime.ToString(@"hh\:mm")"
                                 aria-label="Mẫu ca @template.Name, @template.StartTime.ToString(@"hh\:mm") đến @template.EndTime.ToString(@"hh\:mm")">
                            <span class="template-chip-handle"><i class="fa-solid fa-grip-vertical"></i></span>
                            <span>
                                <strong>@template.Name</strong>
                                <small>@template.StartTime.ToString(@"hh\:mm") – @template.EndTime.ToString(@"hh\:mm") @(template.IsOvernight ? "(+1 ngày)" : "")</small>
                            </span>
                        </article>
                    }
                    @if (!Model.Templates.Any(x => x.Active))
                    {
                        <div class="template-empty">Chưa có mẫu ca đang hoạt động để phân lịch.</div>
                    }
                </div>

                <div class="table-responsive template-management">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr><th>Tên ca</th><th>Thời gian</th><th>Ghi chú</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var template in Model.Templates)
                        {
                            <tr class="@(template.Active ? "" : "template-inactive")">
                                <td class="fw-semibold">@template.Name</td>
                                <td>@template.StartTime.ToString(@"hh\:mm") – @template.EndTime.ToString(@"hh\:mm") @(template.IsOvernight ? "(+1 ngày)" : "")</td>
                                <td>@template.Notes</td>
                                <td><span class="badge @(template.Active ? "bg-success" : "bg-secondary")">@(template.Active ? "Đang dùng" : "Đã ngưng")</span></td>
                                <td class="text-end">
                                    @if (Model.CanUpdate)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary edit-template"
                                                data-id="@template.ShiftId" data-name="@template.Name"
                                                data-start="@template.StartTime.ToString(@"hh\:mm")" data-end="@template.EndTime.ToString(@"hh\:mm")"
                                                data-notes="@template.Notes" data-version="@template.RowVersion">Sửa</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary toggle-template"
                                                data-id="@template.ShiftId" data-version="@template.RowVersion">@(template.Active ? "Ngưng" : "Kích hoạt")</button>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.Templates.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-3">Chưa có mẫu ca.</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>

    <section class="roster-section" aria-labelledby="weeklyRosterTitle">
        <div class="roster-toolbar">
            <div class="roster-toolbar-heading">
                <div>
                    <span class="section-eyebrow">LỊCH TUẦN</span>
                    <h3 id="weeklyRosterTitle">Lịch làm việc nhân viên</h3>
                </div>
                <div class="schedule-legend" aria-label="Chú thích trạng thái">
                    <span><i class="legend-dot legend-scheduled"></i> Đang hoạt động</span>
                    <span><i class="legend-dot legend-cancelled"></i> Đã hủy</span>
                </div>
            </div>
            <div class="roster-filters" role="search">
                <label class="filter-control filter-search" for="staffSearch">
                    <span class="visually-hidden">Tìm nhân viên theo tên hoặc vai trò</span>
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                    <input id="staffSearch" type="search" autocomplete="off" placeholder="Tìm tên hoặc vai trò..." />
                </label>
                <label class="filter-control" for="scheduleStatusFilter">
                    <i class="fa-solid fa-filter" aria-hidden="true"></i>
                    <span class="visually-hidden">Lọc trạng thái lịch</span>
                    <select id="scheduleStatusFilter">
                        <option value="all">Tất cả trạng thái</option>
                        <option value="scheduled">Có lịch</option>
                        <option value="unscheduled">Chưa có lịch</option>
                        <option value="cancelled">Có lịch đã hủy</option>
                    </select>
                </label>
                <button id="resetRosterFilters" class="filter-reset" type="button" hidden>
                    <i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Đặt lại
                </button>
            </div>
        </div>

        <div class="roster-meta">
            <span id="visibleStaffCount">Hiển thị @Model.StaffRows.Count/@Model.StaffRows.Count nhân viên</span>
            <span class="roster-scroll-hint"><i class="fa-solid fa-arrows-left-right" aria-hidden="true"></i> Cuộn ngang để xem đủ 7 ngày</span>
        </div>

        <div class="roster-container">
        <table class="roster-table">
            <thead>
                <tr>
                    <th class="staff-col">Nhân viên</th>
                    @foreach (var day in days)
                    {
                        var isToday = day.Date == DateTime.Today;
                        <th class="@(isToday ? "today-col" : "")">
                            <span class="text-capitalize">@DayName(day)</span><br />
                            <strong>@day.ToString("dd/MM")</strong>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
            @foreach (var staff in Model.StaffRows)
            {
                var staffScheduledCount = staff.Schedules.Count(x => x.StatusCode == "SCHEDULED");
                var staffCancelledCount = staff.Schedules.Count(x => x.StatusCode == "CANCELLED");
                <tr data-staff-row
                    data-staff-search="@($"{staff.StaffName} {staff.RoleNames}".ToLowerInvariant())"
                    data-scheduled-count="@staffScheduledCount"
                    data-cancelled-count="@staffCancelledCount">
                    <td class="staff-col">
                        <div class="staff-info">
                            <img src="@(string.IsNullOrWhiteSpace(staff.AvatarUrl) ? DefaultImages.StaffAvatarUrl : staff.AvatarUrl)"
                                 alt="Ảnh của @staff.StaffName" onerror="this.src='@DefaultImages.StaffAvatarUrl'" />
                            <div>
                                <div class="staff-name">@staff.StaffName</div>
                                <div class="staff-role">@staff.RoleNames</div>
                                <div class="staff-hours"><i class="fa-regular fa-clock" aria-hidden="true"></i> @staffScheduledCount ca trong tuần</div>
                            </div>
                        </div>
                    </td>
                    @foreach (var day in days)
                    {
                        <td class="day-cell @(Model.CanCreate ? "schedule-drop-zone" : "")"
                            data-staff-id="@staff.StaffId"
                            data-staff-name="@staff.StaffName"
                            data-work-date="@day.ToString("yyyy-MM-dd")">
                            <div class="drop-indicator"><i class="fa-solid fa-arrow-down"></i> Thả mẫu ca tại đây</div>
                            @foreach (var schedule in staff.Schedules.Where(x => x.WorkDate.Date == day.Date))
                            {
                                var cancelled = schedule.StatusCode == "CANCELLED";
                                <article class="schedule-card @(cancelled ? "cancelled" : "scheduled")">
                                    <div class="schedule-card-header">
                                        <div class="schedule-card-title">@schedule.ShiftName</div>
                                        <span class="schedule-status-dot" title="@(cancelled ? "Đã hủy" : "Đang hoạt động")"></span>
                                    </div>
                                    <div class="schedule-card-time">
                                        <i class="fa-regular fa-clock" aria-hidden="true"></i>
                                        @schedule.EffectiveStart.ToString(@"hh\:mm") – @schedule.EffectiveEnd.ToString(@"hh\:mm")
                                        @if (schedule.IsOvernight) { <span class="overnight-badge">+1 ngày</span> }
                                    </div>
                                    @if (cancelled)
                                    {
                                        <span class="badge bg-secondary mt-1">Đã hủy</span>
                                    }
                                    else
                                    {
                                        <div class="schedule-actions">
                                            @if (Model.CanUpdate)
                                            {
                                                <button type="button" class="edit-schedule" title="Sửa lịch của @staff.StaffName" aria-label="Sửa lịch @schedule.ShiftName của @staff.StaffName"
                                                        data-id="@schedule.StaffShiftId" data-staff="@staff.StaffId" data-name="@staff.StaffName"
                                                        data-shift="@schedule.ShiftId" data-date="@day.ToString("yyyy-MM-dd")"
                                                        data-custom-start="@schedule.CustomStartTime?.ToString(@"hh\:mm")"
                                                        data-custom-end="@schedule.CustomEndTime?.ToString(@"hh\:mm")"
                                                        data-version="@schedule.RowVersion"><i class="fa-solid fa-pen" aria-hidden="true"></i><span>Sửa</span></button>
                                            }
                                            @if (Model.CanCancel)
                                            {
                                                <button type="button" class="cancel-schedule" title="Hủy lịch của @staff.StaffName" aria-label="Hủy lịch @schedule.ShiftName của @staff.StaffName"
                                                        data-id="@schedule.StaffShiftId" data-version="@schedule.RowVersion"><i class="fa-solid fa-xmark" aria-hidden="true"></i><span>Hủy</span></button>
                                            }
                                        </div>
                                    }
                                </article>
                            }
                            @if (Model.CanCreate)
                            {
                                <button type="button" class="empty-slot assign-schedule"
                                        data-staff="@staff.StaffId" data-name="@staff.StaffName" data-date="@day.ToString("yyyy-MM-dd")">
                                    <span><i class="fa-solid fa-plus"></i> Phân ca</span>
                                </button>
                            }
                        </td>
                    }
                </tr>
            }
            @if (!Model.StaffRows.Any())
            {
                <tr><td colspan="8"><div class="empty-state"><i class="fa-solid fa-folder-open"></i><strong>Không có nhân viên trong cửa hàng này.</strong></div></td></tr>
            }
            </tbody>
        </table>
        </div>
        <div id="rosterFilterEmpty" class="filter-empty" role="status" hidden>
            <span><i class="fa-solid fa-user-clock" aria-hidden="true"></i></span>
            <strong>Không tìm thấy nhân viên phù hợp</strong>
            <p>Hãy thử từ khóa khác hoặc đặt lại bộ lọc.</p>
        </div>
    </section>
</div>

<div class="modal fade" id="scheduleModal" tabindex="-1" aria-labelledby="scheduleModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down">
        <div class="modal-content">
            <form id="scheduleForm">
                <div class="modal-header accent">
                    <div><span class="modal-kicker">LỊCH NHÂN VIÊN</span><h5 class="modal-title" id="scheduleModalTitle">Phân lịch làm việc</h5></div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" name="StaffShiftId" id="staffShiftId" />
                    <input type="hidden" name="StaffId" id="scheduleStaffId" />
                    <input type="hidden" name="WorkDate" id="scheduleDate" />
                    <input type="hidden" name="RowVersion" id="scheduleVersion" />

                    <div class="schedule-context mb-3">
                        <i class="fa-regular fa-calendar-check"></i>
                        <span id="scheduleContext"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="scheduleShift">Mẫu ca <span class="text-danger">*</span></label>
                        <select class="form-select" name="ShiftId" id="scheduleShift" required>
                            <option value="">-- Chọn mẫu ca --</option>
                            @foreach (var template in Model.Templates.Where(x => x.Active))
                            {
                                <option value="@template.ShiftId">@template.Name (@template.StartTime.ToString(@"hh\:mm")–@template.EndTime.ToString(@"hh\:mm"))</option>
                            }
                        </select>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" name="UseCustomTime" value="true" id="useCustomTime" />
                        <label class="form-check-label" for="useCustomTime">Dùng giờ riêng cho lịch này</label>
                    </div>
                    <div class="row g-3">
                        <div class="col-6"><label class="form-label" for="customStart">Bắt đầu</label><input type="time" class="form-control custom-time" name="CustomStartTime" id="customStart" disabled /></div>
                        <div class="col-6"><label class="form-label" for="customEnd">Kết thúc</label><input type="time" class="form-control custom-time" name="CustomEndTime" id="customEnd" disabled /></div>
                    </div>
                    <div class="form-text mt-2">Nếu không dùng giờ riêng, lịch sẽ tự động theo giờ của mẫu ca.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i>Lưu lịch</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="templateModal" tabindex="-1" aria-labelledby="templateModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down">
        <div class="modal-content">
            <form id="templateForm">
                <div class="modal-header accent"><div><span class="modal-kicker">THƯ VIỆN CA</span><h5 class="modal-title" id="templateModalTitle">Mẫu ca</h5></div><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
                <div class="modal-body p-4">
                    <input type="hidden" name="ShiftId" id="templateId" />
                    <input type="hidden" name="RowVersion" id="templateVersion" />
                    <div class="mb-3"><label class="form-label" for="templateName">Tên mẫu ca <span class="text-danger">*</span></label><input class="form-control" name="Name" id="templateName" maxlength="100" required /></div>
                    <div class="row g-3">
                        <div class="col-6"><label class="form-label" for="templateStart">Bắt đầu <span class="text-danger">*</span></label><input type="time" class="form-control" name="StartTime" id="templateStart" required /></div>
                        <div class="col-6"><label class="form-label" for="templateEnd">Kết thúc <span class="text-danger">*</span></label><input type="time" class="form-control" name="EndTime" id="templateEnd" required /></div>
                    </div>
                    <div class="mt-3"><label class="form-label" for="templateNotes">Ghi chú</label><textarea class="form-control" name="Notes" id="templateNotes" maxlength="500"></textarea></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button><button type="submit" class="btn btn-primary">Lưu mẫu ca</button></div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Admin/StaffShift/admin-staff-shift.js" asp-append-version="true"></script>
}
