@model IReadOnlyList<CafeChain.Application.DTOs.POS.PosAccessSessionDto>
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<CafeChain.SharedResource> SharedText
@{
    ViewData["Title"] = SharedText["PosSessions.Title"];
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<main class="cc-page">
    <header class="cc-page-header"><div><h1 class="cc-page-title">@SharedText["PosSessions.Title"]</h1><p class="cc-page-description">@SharedText["PosSessions.Description"]</p></div></header>
    @if (TempData["SuccessMessage"] != null) { <div class="ops-notice ops-notice-success">@TempData["SuccessMessage"]</div> }
    @if (TempData["ErrorMessage"] != null) { <div class="ops-notice ops-notice-error">@TempData["ErrorMessage"]</div> }
    <section class="cc-warehouse-panel">
        @foreach (var item in Model)
        {
            <article class="notification-item">
                <div><strong>@item.TerminalId</strong><p>@SharedText["PosSessions.Staff"] #@item.StaffId · @SharedText["PosSessions.WorkShift"] #@(item.WorkShiftId?.ToString() ?? "—")</p><p>@SharedText["PosSessions.Expires"]: @item.ExpiresAtUtc.ToLocalTime().ToString("g")</p></div>
                <form asp-action="End" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@item.SessionId" />
                    <input name="reason" maxlength="500" placeholder="@SharedText["PosSessions.EndReason"]" />
                    <button class="cc-button" type="submit">@SharedText["PosSessions.End"]</button>
                </form>
            </article>
        }
    </section>
</main>
<script>
document.addEventListener('DOMContentLoaded', function () {
if (window.signalR?.HubConnectionBuilder) {
    const sessionConnection = new signalR.HubConnectionBuilder()
        .withUrl('/hubs/workshifts')
        .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
        .build();
    sessionConnection.on('PosAccessSessionChanged', function () { window.location.reload(); });
    sessionConnection.onreconnected(function () { window.location.reload(); });
    sessionConnection.start().catch(function (error) {
        console.warn('[pos-access-sessions] Realtime unavailable; manual refresh remains available.', error);
    });
    window.addEventListener('pagehide', function () { void sessionConnection.stop(); }, { once: true });
}
}, { once: true });
</script>
