@model CafeChain.Application.DTOs.Admin.RestockRequests.RestockRequestWorkflowDetailDto
@{
    ViewData["Title"] = "Chi tiết yêu cầu nhập hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var canWarehouse = ViewBag.CanWarehouse as bool? ?? false;
    var canCreateReceipt = ViewBag.CanCreateReceipt as bool? ?? false;
    var canCancel = ViewBag.CanCancel as bool? ?? false;
    var target = Model.TargetQuantity > 0 ? Model.TargetQuantity : Model.RequestedQuantity;
    var progress = target <= 0 ? 0m : Math.Min(100m, Math.Max(0m, Model.ReceivedQuantity / target * 100m));
    string StatusLabel(string value) => value switch
    {
        "SUBMITTED" => "Chờ tiếp nhận", "PROCESSING" => "Đang xử lý", "PARTIALLY_RECEIVED" => "Đã nhận một phần",
        "COMPLETED" => "Hoàn tất", "REJECTED" => "Đã từ chối", "CANCELLED" => "Đã hủy", _ => value
    };
    string StatusClass(string value) => value switch
    {
        "SUBMITTED" => "ops-badge-warning", "PROCESSING" => "ops-badge-info", "PARTIALLY_RECEIVED" => "ops-badge-warning",
        "COMPLETED" => "ops-badge-success", _ => "ops-badge-neutral"
    };
    string PriorityLabel(string value) => value switch { "URGENT" => "Khẩn cấp", "HIGH" => "Cao", _ => "Bình thường" };
}

<link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />

<main class="ops-shell">
    <header class="ops-header">
        <div>
            <div class="ops-eyebrow">Yêu cầu nhập #@Model.RestockRequestId · Cửa hàng @(Model.StoreName ?? $"#{Model.StoreId}")</div>
            <h1 class="ops-title">@Model.ItemName</h1>
            <p class="ops-subtitle">@Model.ItemTypeLabel · Tạo bởi @(Model.CreatedByName ?? $"Nhân viên #{Model.CreatedByStaffId}") lúc @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <div class="ops-actions">
            <a class="ops-btn" asp-area="Admin" asp-controller="AdminRestockRequests" asp-action="Index" asp-route-storeId="@Model.StoreId"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Danh sách</a>
            <a class="ops-btn" asp-area="Admin" asp-controller="AdminStockAlerts" asp-action="Details" asp-route-id="@Model.StockAlertId" asp-route-storeId="@Model.StoreId"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> Cảnh báo gốc</a>
            @if (canCreateReceipt && Model.Status is "SUBMITTED" or "PROCESSING" or "PARTIALLY_RECEIVED")
            {
                <a class="ops-btn ops-btn-primary" asp-area="Admin" asp-controller="AdminBranchReceipts" asp-action="Create" asp-route-restockRequestId="@Model.RestockRequestId" asp-route-storeId="@Model.StoreId"><i class="fa-solid fa-box-open" aria-hidden="true"></i> Tạo phiếu nhận</a>
            }
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null) { <div class="ops-notice ops-notice-success" role="status">@TempData["SuccessMessage"]</div> }
    @if (TempData["ErrorMessage"] != null) { <div class="ops-notice ops-notice-error" role="alert">@TempData["ErrorMessage"]</div> }
    @if (Model.StockRecoveredExternally)
    {
        <div class="ops-notice ops-notice-warning" role="status">
            <strong>STOCK_RECOVERED_EXTERNALLY</strong><br />Tồn kho đã phục hồi từ chứng từ không gắn với yêu cầu này. Yêu cầu vẫn đang mở để bộ phận kho quyết định tiếp tục hoặc hủy; hệ thống không tự ghi nhận hoàn tất.
        </div>
    }

    <section class="ops-metrics" aria-label="Tiến độ yêu cầu">
        <div class="ops-metric"><span class="ops-metric-label">Mục tiêu</span><strong class="ops-metric-value">@target.ToString("N3")</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Đã fulfillment</span><strong class="ops-metric-value success">@Model.ReceivedQuantity.ToString("N3")</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Còn phải nhận</span><strong class="ops-metric-value @(Model.RemainingQuantity > 0 ? "warning" : "success")">@Model.RemainingQuantity.ToString("N3")</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Tiến độ</span><strong class="ops-metric-value">@progress.ToString("N0")%</strong><div class="ops-progress mt-2"><div class="ops-progress-bar" style="width:@progress.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div></div></div>
    </section>

    <div class="ops-detail-grid">
        <div>
            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">Thông tin yêu cầu</h2></div>
                <div class="ops-panel-body">
                    <div class="ops-inline-actions mb-3">
                        <span class="ops-badge @StatusClass(Model.Status)">@StatusLabel(Model.Status)</span>
                        <span class="ops-badge @(Model.Priority == "URGENT" ? "ops-badge-danger" : Model.Priority == "HIGH" ? "ops-badge-warning" : "ops-badge-neutral")">Ưu tiên @PriorityLabel(Model.Priority).ToLowerInvariant()</span>
                    </div>
                    <div class="ops-data-grid">
                        <div><span class="ops-data-label">Gợi ý hệ thống</span><span class="ops-data-value">@(Model.SuggestedQuantity?.ToString("N3") ?? "Chưa đủ dữ liệu")</span></div>
                        <div><span class="ops-data-label">Cập nhật gần nhất</span><span class="ops-data-value">@Model.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></div>
                        <div><span class="ops-data-label">Cảnh báo nguồn</span><span class="ops-data-value">#@Model.StockAlertId · @(Model.AlertType == "OUT_OF_STOCK" ? "Hết hàng" : "Sắp hết")</span></div>
                        <div><span class="ops-data-label">Trạng thái cảnh báo</span><span class="ops-data-value">@Model.AlertStatus</span></div>
                    </div>
                    <div class="mt-3"><span class="ops-data-label">Ghi chú</span><div class="ops-notice mt-1 mb-0">@(Model.Note ?? "Không có ghi chú")</div></div>
                    <div class="ops-help mt-3"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> Yêu cầu nhập không trực tiếp thay đổi tồn. Chỉ phiếu nhận hoặc điều chuyển được xác nhận mới tạo biến động kho.</div>
                </div>
            </section>

            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">Lịch sử chuyển trạng thái</h2></div>
                <div class="ops-panel-body">
                    @if (Model.Timeline.Count == 0) { <div class="ops-secondary">Chưa có lịch sử chuyển trạng thái.</div> }
                    else
                    {
                        <ol class="ops-timeline">
                            @foreach (var transition in Model.Timeline)
                            {
                                <li>
                                    <strong>@StatusLabel(transition.NewStatus)</strong>
                                    <div class="ops-secondary">@transition.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @(transition.ActorName ?? $"Nhân viên #{transition.ActorStaffId}")</div>
                                    @if (!string.IsNullOrWhiteSpace(transition.Reason)) { <div>@transition.Reason</div> }
                                    @if (transition.BranchReceiptId.HasValue) { <div>Phiếu nhận <a asp-area="Admin" asp-controller="AdminBranchReceipts" asp-action="Details" asp-route-id="@transition.BranchReceiptId">#@transition.BranchReceiptId</a>@(transition.QuantityAfter.HasValue ? $" · đã nhận {transition.QuantityAfter.Value:N3}" : "")</div> }
                                    @if (transition.InventoryTransferId.HasValue) { <div>Điều chuyển <a asp-area="Admin" asp-controller="AdminInventoryTransfer" asp-action="Detail" asp-route-id="@transition.InventoryTransferId">#@transition.InventoryTransferId</a>@(transition.QuantityAfter.HasValue ? $" · lũy kế {transition.QuantityAfter.Value:N3}" : "")</div> }
                                </li>
                            }
                        </ol>
                    }
                </div>
            </section>

            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">Fulfillment postings</h2></div>
                <div class="ops-panel-body p-0">
                    @if (Model.FulfillmentPostings.Count == 0) { <div class="p-3 ops-secondary">Chưa có lượng thực nhận từ chứng từ đã hoàn tất.</div> }
                    else
                    {
                        <div class="ops-table-scroll"><table class="ops-table" style="min-width:620px"><thead><tr><th>Nguồn</th><th>Dòng chứng từ</th><th class="number">Số lượng</th><th>Thời gian</th></tr></thead><tbody>
                        @foreach (var posting in Model.FulfillmentPostings)
                        {
                            <tr><td><strong>@posting.SourceDocumentType</strong> #@posting.SourceDocumentId</td><td>#@posting.SourceDocumentLineId</td><td class="number">@posting.Quantity.ToString("N3") @(posting.BaseUnitName ?? $"Unit #{posting.BaseUnitId}")</td><td>@posting.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr>
                        }
                        </tbody></table></div>
                    }
                </div>
            </section>

            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">Chứng từ nhận hàng</h2></div>
                <div class="ops-panel-body p-0">
                    @if (Model.Receipts.Count == 0) { <div class="p-3 ops-secondary">Chưa có phiếu nhận liên quan.</div> }
                    else
                    {
                        <div class="ops-table-scroll"><table class="ops-table" style="min-width:620px"><thead><tr><th>Phiếu</th><th>Trạng thái</th><th class="number">Lượng nhận</th><th class="number">Giá trị</th><th></th></tr></thead><tbody>
                        @foreach (var receipt in Model.Receipts)
                        {
                            <tr><td><strong>@receipt.ReceiptCode</strong><div class="ops-secondary">@receipt.ReceivedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div></td><td><span class="ops-badge @(receipt.Status == "CONFIRMED" ? "ops-badge-success" : "ops-badge-neutral")">@(receipt.Status == "CONFIRMED" ? "Đã xác nhận" : "Bản nháp")</span></td><td class="number">@receipt.TotalBaseQuantity.ToString("N3")</td><td class="number">@receipt.TotalLineCost.ToString("N0") đ</td><td><a class="ops-btn" asp-area="Admin" asp-controller="AdminBranchReceipts" asp-action="Details" asp-route-id="@receipt.BranchReceiptId">Xem phiếu</a></td></tr>
                        }
                        </tbody></table></div>
                    }
                </div>
            </section>
        </div>

        <aside>
            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">Thao tác tiếp theo</h2></div>
                <div class="ops-panel-body">
                    @if (canWarehouse && Model.Status == "SUBMITTED")
                    {
                        <form method="post" asp-action="StartProcessing" asp-route-id="@Model.RestockRequestId" class="mb-3">@Html.AntiForgeryToken()<button type="submit" class="ops-btn ops-btn-primary w-100"><i class="fa-solid fa-play" aria-hidden="true"></i> Tiếp nhận xử lý</button></form>
                    }
                    @if (canWarehouse && Model.Status is "SUBMITTED" or "PROCESSING")
                    {
                        <form method="post" asp-action="Reject" asp-route-id="@Model.RestockRequestId" class="mb-3">
                            @Html.AntiForgeryToken()
                            <label class="ops-form-label" for="rejectReason">Từ chối yêu cầu</label>
                            <textarea id="rejectReason" name="reason" class="ops-textarea" required placeholder="Lý do từ chối..."></textarea>
                            <button type="submit" class="ops-btn ops-btn-danger w-100 mt-2">Từ chối yêu cầu</button>
                        </form>
                    }
                    @if (canCancel && Model.Status is "SUBMITTED" or "PROCESSING")
                    {
                        <form method="post" asp-action="Cancel" asp-route-id="@Model.RestockRequestId">
                            @Html.AntiForgeryToken()
                            <label class="ops-form-label" for="cancelReason">Hủy yêu cầu</label>
                            <input id="cancelReason" name="reason" class="ops-input w-100" placeholder="Lý do hủy" />
                            <button type="submit" class="ops-btn w-100 mt-2">Hủy yêu cầu</button>
                        </form>
                    }
                    @if ((!canWarehouse || Model.Status is not ("SUBMITTED" or "PROCESSING")) && !(canCancel && Model.Status is "SUBMITTED" or "PROCESSING"))
                    {
                        <div class="ops-secondary">Không có thao tác chuyển trạng thái phù hợp ở bước hiện tại.</div>
                    }
                </div>
            </section>

            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">Nguồn thực hiện</h2></div>
                <div class="ops-panel-body">
                    @if (Model.Fulfillments.Count == 0) { <div class="ops-secondary">Chưa gắn nguồn thực hiện.</div> }
                    else
                    {
                        @foreach (var fulfillment in Model.Fulfillments)
                        {
                            <div class="ops-notice mb-2"><strong>@fulfillment.SourceType</strong> · @fulfillment.Status<div class="ops-secondary">Dự kiến @fulfillment.PlannedBaseQuantity.ToString("N3") · @fulfillment.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div></div>
                        }
                    }
                    @if (canWarehouse && Model.Status is "SUBMITTED" or "PROCESSING" or "PARTIALLY_RECEIVED")
                    {
                        <form method="post" asp-action="LinkFulfillment" asp-route-id="@Model.RestockRequestId" class="mt-3">
                            @Html.AntiForgeryToken()
                            <label class="ops-form-label" for="sourceType">Gắn nguồn xử lý (không đổi tồn)</label>
                            <select id="sourceType" name="SourceType" class="ops-select w-100 mb-2"><option value="SUPPLIER">Nhà cung cấp</option><option value="MANUAL">Xử lý thủ công</option></select>
                            <input name="PlannedBaseQuantity" type="number" step="0.001" min="0.001" class="ops-input w-100 mb-2" placeholder="Số lượng dự kiến" required />
                            <input name="Notes" class="ops-input w-100 mb-2" placeholder="Ghi chú" />
                            <button type="submit" class="ops-btn w-100">Gắn nguồn xử lý</button>
                        </form>
                    }
                </div>
            </section>
        </aside>
    </div>
</main>
