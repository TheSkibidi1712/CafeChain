@model CafeChain.Application.DTOs.Admin.RestockRequests.RestockRequestWorkflowDetailDto
@using CafeChain.Application.Constants
@using CafeChain.Application.DTOs.Admin.Production
@using CafeChain.Application.DTOs.Admin.Replenishment
@using CafeChain.Application.DTOs.Admin.RestockRequests
@using CafeChain.ViewModels.Admin.Shared
@using Microsoft.Extensions.Localization
@using System.Text.Json
@inject IStringLocalizer<ProcurementResource> L
@{
    var isPreparedItemDemand = Model.PreparedItemId.HasValue;
    var demandLabel = isPreparedItemDemand ? L["Restock.Details.AdditionalDemand"].Value : L["Restock.Details.RestockRequest"].Value;
    ViewData["Title"] = L["Restock.Details.PageTitle", demandLabel];
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var canWarehouse = ViewBag.CanWarehouse as bool? ?? false;
    var canStartProcessing = ViewBag.CanStartProcessing as bool? ?? false;
    var canCancel = ViewBag.CanCancel as bool? ?? false;
    var canSubmit = ViewBag.CanSubmit as bool? ?? false;
    var canAddDemand = ViewBag.CanAddDemand as bool? ?? false;
    var canViewStockAlerts = ViewBag.CanViewStockAlerts as bool? ?? false;
    var canViewProduction = ViewBag.CanViewProduction as bool? ?? false;
    var preparedItemReplenishment = ViewBag.PreparedItemReplenishment as PreparedItemReplenishmentDto;
    var preparedItemAdditionalDemandBase = ViewBag.PreparedItemAdditionalDemandBase as decimal?;
    var productionEligibility = ViewBag.ProductionEligibility as ProductionSourceEligibilityDto;
    var purchaseEligibility = ViewBag.PurchaseEligibility as PurchaseSourceEligibilityDto;
    var canOfferPurchase = purchaseEligibility?.Eligible == true
        || (purchaseEligibility == null && Model.IngredientId.HasValue);
    var hasPendingPurchaseAllocation = Model.SourcingAllocations.Any(x =>
        x.DecisionType == RestockSourcingDecisionTypes.Purchase
        && x.Status == RestockSourcingAllocationStatuses.PendingPurchaseAdvice
        && !x.PurchaseAdviceLineId.HasValue
        && !x.PurchaseOrderLineId.HasValue);
    var productionAllocations = Model.SourcingAllocations
        .Where(x => x.DecisionType == RestockSourcingDecisionTypes.Production)
        .OrderByDescending(x => x.CreatedAtUtc)
        .ToList();
    var orphanTransferAllocations = Model.SourcingAllocations
        .Where(x => x.DecisionType == RestockSourcingDecisionTypes.Transfer
            && x.Status == RestockSourcingAllocationStatuses.Active
            && (!x.InventoryTransferId.HasValue || !x.SourceDocumentId.HasValue))
        .ToList();
    var usesPurchaseBranch = Model.SourcingAllocations.Any(x =>
            x.DecisionType == RestockSourcingDecisionTypes.Purchase)
        || Model.PurchaseAdvices.Count > 0
        || Model.PurchaseOrders.Count > 0
        || Model.Receipts.Count > 0;
    var visibleProductionAllocations = productionAllocations.Take(8).ToList();
    var canCreatePurchaseAdvice = canWarehouse
        && Model.IngredientId.HasValue
        && Model.Status is ("PROCESSING" or "PARTIALLY_RECEIVED")
        && (string.Equals(Model.SourceType, RestockRequestSourceTypes.Legacy, StringComparison.OrdinalIgnoreCase)
            || hasPendingPurchaseAllocation);
    var usesProcurement = Model.RequestedProcurementQuantity.HasValue
        && Model.RequestedProcurementQuantity.Value > 0
        && Model.ProcurementUnitId.HasValue;
    var requestUnitName = usesProcurement
        ? Model.ProcurementUnitName ?? L["Restock.DemandUnit"].Value
        : Model.BaseUnitName;
    var target = usesProcurement
        ? Model.RequestedProcurementQuantity!.Value
        : Model.TargetQuantity > 0 ? Model.TargetQuantity : Model.RequestedQuantity;
    var fulfilled = usesProcurement
        ? Model.FulfilledProcurementQuantity.GetValueOrDefault()
        : Model.ReceivedQuantity;
    var transferAllocated = usesProcurement
        ? Model.TransferAllocatedProcurementQuantity.GetValueOrDefault()
        : Model.TransferAllocatedQuantity;
    var purchaseAllocated = usesProcurement
        ? Model.PurchaseAllocatedProcurementQuantity.GetValueOrDefault()
        : Model.PurchaseAllocatedQuantity;
    var productionAllocated = Model.ProductionAllocatedProcurementQuantity.GetValueOrDefault();
    var rejectedAllocated = Model.RejectedProcurementQuantity.GetValueOrDefault();
    var remainingSource = usesProcurement
        ? Model.RemainingUnallocatedProcurementQuantity.GetValueOrDefault()
        : Model.RemainingUnallocatedQuantity;
    var remainingToReceive = usesProcurement
        ? Model.RemainingToReceiveProcurementQuantity.GetValueOrDefault()
        : Model.RemainingToReceiveQuantity;
    var hasAllocationDetail = transferAllocated > 0
        || purchaseAllocated > 0
        || productionAllocated > 0
        || rejectedAllocated > 0;
    var progress = target <= 0 ? 0m : Math.Min(100m, Math.Max(0m, fulfilled / target * 100m));
}

<link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" asp-append-version="true" />
<style>
    .restock-detail-page .ops-detail-grid {
        grid-template-columns: minmax(0, 1.8fr) minmax(260px, 0.5fr) !important;
    }
    .restock-detail-page .ops-source-options {
        display: flex !important;
        gap: 16px !important;
        margin-top: 16px !important;
    }
    .restock-detail-page .ops-source-option {
        flex: 1 1 0 !important;
        min-height: 48px !important;
        height: 48px !important;
        padding: 0 16px !important;
        border: 1px solid var(--cc-border, #E9DED4) !important;
        border-radius: var(--cc-radius-control, 10px) !important;
        background: var(--cc-surface, #FFFDFB) !important;
        color: var(--cc-text-primary, #201812) !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 8px !important;
        cursor: pointer !important;
        font-size: 0.95rem !important;
        font-weight: 600 !important;
        transition: border-color .2s ease, background-color .2s ease, box-shadow .2s ease !important;
    }
    .restock-detail-page .ops-source-option:hover {
        border-color: var(--cc-accent, #A97750) !important;
        background: var(--cc-surface-hover, #FDFBF7) !important;
    }
    .restock-detail-page .ops-source-option.is-active,
    .restock-detail-page .ops-source-option[aria-pressed="true"] {
        border-color: var(--cc-brown-600, #70482F) !important;
        background: var(--cc-surface-active, #F4E9DF) !important;
        color: var(--cc-brown-800, #3D2418) !important;
        box-shadow: var(--cc-focus-ring) !important;
        font-weight: 700 !important;
    }
    .restock-detail-page .ops-source-options.has-selection .ops-source-option {
        max-width: 50% !important;
    }
    .restock-detail-page .ops-source-options.has-selection .ops-source-option:not(.is-active) {
        display: none !important;
    }
    .restock-detail-page .ops-source-option i {
        font-size: 1.1rem !important;
        color: var(--cc-accent, #A97750) !important;
    }
    .restock-detail-page .ops-source-option.is-active i,
    .restock-detail-page .ops-source-option[aria-pressed="true"] i {
        color: var(--cc-brown-600, #70482F) !important;
    }
    .restock-detail-page .ops-source-option strong {
        margin: 0 !important;
    }
    .restock-detail-page .ops-source-notes {
        margin-top: 12px !important;
        padding: 12px 16px !important;
        background: var(--cc-surface-muted, #FBF7F2) !important;
        border: 1px solid var(--cc-border-soft, #F5ECE4) !important;
        border-radius: var(--cc-radius-control, 10px) !important;
        display: flex !important;
        flex-direction: column !important;
        gap: 8px !important;
    }
    .restock-detail-page .ops-source-note-item {
        display: flex !important;
        align-items: start !important;
        gap: 10px !important;
        font-size: 0.8rem !important;
        line-height: 1.45 !important;
        color: var(--cc-text-secondary, #605045) !important;
    }
    .restock-detail-page .ops-source-note-item i {
        color: var(--cc-accent, #A97750) !important;
        font-size: 0.95rem !important;
        margin-top: 2px !important;
        width: 16px !important;
        text-align: center !important;
        flex-shrink: 0 !important;
    }
    .restock-detail-page .ops-source-note-item strong {
        color: var(--cc-text, #201812) !important;
        font-weight: 650 !important;
    }
</style>

<main class="restock-page restock-detail-page ops-shell cc-warehouse-page">
<header class="ops-header cc-warehouse-header cc-warehouse-header--compact cc-warehouse-header--detail">
        <div>
            <div class="ops-eyebrow">@demandLabel @Model.ReferenceCode · @L["Common.Branch"] @(Model.StoreName ?? $"#{Model.StoreId}")</div>
            <h1 class="ops-title">@Model.ItemName</h1>
            <p class="ops-subtitle">@Model.ItemTypeLabel · @L["Restock.Details.CreatedByAt", Model.CreatedByName ?? L["Restock.Details.UnknownCreator"].Value, Model.CreatedAt.ToLocalTime()]</p>
        </div>
        <div class="ops-actions restock-header-actions">
            <span class="ops-badge @AdminStatusDisplay.RestockRequest(Model.Status).CssClass restock-header-status">@AdminStatusDisplay.RestockRequest(Model.Status).Label</span>
            <a class="ops-btn" asp-area="Admin" asp-controller="AdminRestockRequests" asp-action="Index" asp-route-storeId="@Model.StoreId"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> @L["Common.List"]</a>
            @if (canViewStockAlerts && Model.StockAlertId.HasValue)
            {
                <a class="ops-btn" asp-area="Admin" asp-controller="AdminStockAlerts" asp-action="Details" asp-route-id="@Model.StockAlertId" asp-route-storeId="@Model.StoreId"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> @L["Restock.Details.SourceAlert"]</a>
            }
            @if (canCreatePurchaseAdvice)
            {
                <a class="ops-btn ops-btn-primary" asp-area="Admin" asp-controller="AdminPurchaseAdvices" asp-action="Create" asp-route-restockRequestId="@Model.RestockRequestId" asp-route-storeId="@Model.StoreId"><i class="fa-solid fa-clipboard-list" aria-hidden="true"></i> @L["Restock.Details.CreatePurchaseAdvice"]</a>
            }
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null) { <div class="ops-notice ops-notice-success" role="status">@TempData["SuccessMessage"]</div> }
    @if (TempData["ErrorMessage"] != null) { <div class="ops-notice ops-notice-error" role="alert">@TempData["ErrorMessage"]</div> }
    @if (Model.StockRecoveredExternally)
    {
        <div class="ops-notice ops-notice-warning" role="status">
            <strong>@L["Restock.Details.ExternalRecoveryTitle"]</strong><br />@L["Restock.Details.ExternalRecoveryCopy"]
        </div>
    }

    <section class="ops-panel" aria-label="@L["Restock.Details.ProgressAria"]">
        <div class="ops-panel-header"><h2 class="ops-panel-title">@L["Restock.Details.ProgressTitle"]</h2></div>
        <div class="ops-panel-body">
            <div class="ops-workflow" role="list" aria-label="@L["Restock.Details.WorkflowAria"]">
                @for (var stepIndex = 0; stepIndex < Model.WorkflowSteps.Count; stepIndex++)
                {
                    var step = Model.WorkflowSteps[stepIndex];
                    var stepClass = step.Status switch { "COMPLETED" => "is-completed", "ACTIVE" => "is-active", "REJECTED" => "is-rejected", _ => "is-pending" };
                    <div class="ops-workflow-step @stepClass" role="listitem" aria-current="@(step.Status == "ACTIVE" ? "step" : null)">
                        <span class="ops-workflow-index" aria-hidden="true">@(step.Status == "COMPLETED" ? "✓" : (stepIndex + 1).ToString())</span>
                        <strong>@step.Label</strong><div class="ops-secondary">@step.Description</div>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="ops-metrics ops-summary-metrics" aria-label="@L["Restock.Details.SummaryAria"]">
        <div class="ops-metric"><span class="ops-metric-label">@L["Restock.Details.RequestedQuantity"]</span><strong class="ops-metric-value">@AdminStatusDisplay.Quantity(target) @requestUnitName</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">@L["Restock.Details.Unallocated"]</span><strong class="ops-metric-value @(remainingSource > 0 ? "warning" : "success")">@AdminStatusDisplay.Quantity(remainingSource) @requestUnitName</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">@L["Restock.Details.RemainingDemand"]</span><strong class="ops-metric-value @(remainingToReceive > 0 ? "warning" : "success")">@AdminStatusDisplay.Quantity(remainingToReceive) @requestUnitName</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">@L["Restock.Details.Received"]</span><strong class="ops-metric-value success">@AdminStatusDisplay.Quantity(fulfilled) @requestUnitName</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">@L["Restock.Details.Progress"]</span><strong class="ops-metric-value">@progress.ToString("N0")%</strong><progress class="ops-progress-native" value="@progress" max="100" aria-label="@L["Restock.Details.ProgressPercent", progress.ToString("N0")]">@progress.ToString("N0")%</progress></div>
    </section>

    @if (hasAllocationDetail)
    {
        <section class="ops-panel ops-allocation-panel" aria-labelledby="allocationSummaryTitle">
            <div class="ops-panel-header"><h2 id="allocationSummaryTitle" class="ops-panel-title">@L["Restock.Details.AllocatedSources"]</h2></div>
            <div class="ops-panel-body">
                <div class="ops-allocation-summary">
                    @if (transferAllocated > 0) { <div class="ops-allocation-item"><span>@L["Restock.Details.Source.Transfer"]</span><strong>@AdminStatusDisplay.Quantity(transferAllocated) @requestUnitName</strong></div> }
                    @if (purchaseAllocated > 0) { <div class="ops-allocation-item"><span>@L["Restock.Details.Source.Purchase"]</span><strong>@AdminStatusDisplay.Quantity(purchaseAllocated) @requestUnitName</strong></div> }
                    @if (productionAllocated > 0) { <div class="ops-allocation-item"><span>@L["Restock.Details.Source.Production"]</span><strong>@AdminStatusDisplay.Quantity(productionAllocated) @requestUnitName</strong></div> }
                    @if (rejectedAllocated > 0) { <div class="ops-allocation-item"><span>@L["Restock.Details.Rejected"]</span><strong>@AdminStatusDisplay.Quantity(rejectedAllocated) @requestUnitName</strong></div> }
                </div>
                <details class="ops-disclosure">
                    <summary>@L["Restock.Details.ViewAllocation"]</summary>
                    <div class="ops-allocation-summary mt-3">
                        <div class="ops-allocation-item"><span>@L["Restock.Details.Source.Transfer"]</span><strong>@AdminStatusDisplay.Quantity(transferAllocated) @requestUnitName</strong></div>
                        <div class="ops-allocation-item"><span>@L["Restock.Details.Source.Purchase"]</span><strong>@AdminStatusDisplay.Quantity(purchaseAllocated) @requestUnitName</strong></div>
                        <div class="ops-allocation-item"><span>@L["Restock.Details.Source.Production"]</span><strong>@AdminStatusDisplay.Quantity(productionAllocated) @requestUnitName</strong></div>
                        <div class="ops-allocation-item"><span>@L["Restock.Details.Rejected"]</span><strong>@AdminStatusDisplay.Quantity(rejectedAllocated) @requestUnitName</strong></div>
                    </div>
                </details>
            </div>
        </section>
    }

    @if (productionAllocations.Count > 0)
    {
        <section class="ops-panel" aria-labelledby="productionTraceTitle">
            <div class="ops-panel-header">
                <h2 id="productionTraceTitle" class="ops-panel-title">@L["Restock.Details.ProductionSource"]</h2>
                <span class="ops-secondary">@L["Restock.Details.RecentAllocations", visibleProductionAllocations.Count, productionAllocations.Count]</span>
            </div>
            <div class="ops-panel-body">
                <div class="ops-allocation-summary">
                    @foreach (var allocation in visibleProductionAllocations)
                    {
                        var allocationStatus = AdminStatusDisplay.SourcingAllocation(allocation.Status);
                        <article class="ops-allocation-item">
                            <span>
                                <strong>@AdminStatusDisplay.Quantity(allocation.ProcurementQuantity) @requestUnitName</strong>
                                <span class="ops-badge @allocationStatus.CssClass">@allocationStatus.Label</span>
                            </span>
                            @if (canViewProduction && allocation.ProductionRunId.HasValue)
                            {
                                <a class="ops-btn" asp-area="Admin" asp-controller="AdminProductionOrder" asp-action="Details" asp-route-id="@allocation.ProductionRunId">
                                    @L["Restock.Details.ViewProductionOrder", allocation.ProductionRunId]
                                </a>
                            }
                            else
                            {
                                <small class="ops-secondary">@(allocation.ProductionRunId.HasValue ? L["Restock.Details.ProductionLinked"].Value : L["Restock.Details.ProductionNotLinked"].Value)</small>
                            }
                        </article>
                    }
                </div>
            </div>
        </section>
    }

    <div class="ops-detail-grid">
        <div>
            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">@L["Restock.Details.RequestInformation"]</h2></div>
                <div class="ops-panel-body">
                    <div class="ops-inline-actions mb-3">
                        <span class="ops-badge @AdminStatusDisplay.RestockRequest(Model.Status).CssClass">@AdminStatusDisplay.RestockRequest(Model.Status).Label</span>
                        <span class="ops-badge @AdminStatusDisplay.RestockRequestPriority(Model.Priority).CssClass">@L["Restock.Details.Priority", AdminStatusDisplay.RestockRequestPriority(Model.Priority).Label.ToLowerInvariant()]</span>
                    </div>
                    <div class="ops-data-grid">
                        <div><span class="ops-data-label">@L["Restock.Details.SystemSuggestion"]</span><span class="ops-data-value">@(Model.SuggestedQuantity.HasValue ? $"{AdminStatusDisplay.Quantity(Model.SuggestedQuantity.Value)} {Model.BaseUnitName}" : L["Common.InsufficientData"].Value)</span></div>
                        <div><span class="ops-data-label">@L["Restock.Details.LastUpdated"]</span><span class="ops-data-value">@AdminStatusDisplay.DateTime(Model.UpdatedAt.ToLocalTime())</span></div>
                        <div><span class="ops-data-label">@L["Restock.Details.FulfillmentChannel"]</span><span class="ops-data-value">@L[$"Restock.Details.Channel.{Model.FulfillmentChannel ?? "UNDECIDED"}"]</span></div>
                        <div><span class="ops-data-label">@L["Restock.Details.SourcingDecision"]</span><span class="ops-data-value">@L[$"Restock.Details.Decision.{Model.SourcingDecision ?? "UNDECIDED"}"]</span></div>
                        <div><span class="ops-data-label">@L["Restock.Details.DemandSource"]</span><span class="ops-data-value">@(Model.StockAlertId.HasValue ? $"#{Model.StockAlertId} · {AdminStatusDisplay.StockAlertType(Model.AlertType)}" : AdminStatusDisplay.RestockSource(Model.SourceType))</span></div>
                        <div><span class="ops-data-label">@L["Restock.Details.BusinessReference"]</span><span class="ops-data-value">@(string.IsNullOrWhiteSpace(Model.SourceReferenceId) ? "—" : Model.SourceReferenceId)</span></div>
                        <div><span class="ops-data-label">@L["Restock.Details.AcceptedBy"]</span><span class="ops-data-value">@(Model.AcceptedByName ?? L["Restock.Details.NotAccepted"].Value)</span></div>
                        <div><span class="ops-data-label">@L["Restock.Details.AcceptedAt"]</span><span class="ops-data-value">@(Model.AcceptedAtUtc.HasValue ? AdminStatusDisplay.DateTime(Model.AcceptedAtUtc.Value.ToLocalTime()) : "—")</span></div>
                    </div>
                    <div class="mt-3"><span class="ops-data-label">@L["Common.Notes"]</span><div class="ops-notice mt-1 mb-0">@(Model.Note ?? L["Common.NoNotes"].Value)</div></div>
                    @if (!string.IsNullOrWhiteSpace(Model.ProcessingNote)) { <div class="mt-3"><span class="ops-data-label">@L["Restock.Details.ProcessingNote"]</span><div class="ops-notice mt-1 mb-0">@Model.ProcessingNote</div></div> }
                    @if ((usesProcurement ? Model.ClosedProcurementQuantity.GetValueOrDefault() : Model.ClosedRemainingQuantity) > 0) { <div class="ops-notice ops-notice-warning mt-3">@L["Restock.Details.ClosedRemainingNotice", AdminStatusDisplay.Quantity(usesProcurement ? Model.ClosedProcurementQuantity.GetValueOrDefault() : Model.ClosedRemainingQuantity), requestUnitName, Model.RemainingCloseReason]</div> }
                    <div class="ops-help mt-3"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> @L["Restock.Details.InventoryImpactHelp", demandLabel]</div>
                </div>
            </section>

            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">@L["Restock.Details.SourceReview"]</h2></div>
                <div class="ops-panel-body">
                    @if (Model.Status is "SUBMITTED" or "PROCESSING" or "PARTIALLY_RECEIVED")
                    {
                        @if (orphanTransferAllocations.Count > 0)
                        {
                            <div class="ops-notice ops-notice-warning mb-3"><strong>@L["Restock.Details.InvalidTransferTitle"]</strong><br />@L["Restock.Details.InvalidTransferCopy"]</div>
                        }
                        @if (remainingSource <= 0)
                        {
                            <div class="ops-notice ops-notice-success mb-0"><strong>@L["Restock.Details.SourceAssignedTitle"]</strong><br />@L["Restock.Details.SourceAssignedCopy"]</div>
                        }
                        else if (!canWarehouse)
                        {
                            <div class="ops-notice ops-notice-warning mb-0">@L["Restock.Details.SourceForbidden"]</div>
                        }
                        else if (Model.Status == "SUBMITTED")
                        {
                            <div class="ops-notice mb-0">@L["Restock.Details.AcceptBeforeAllocate"]</div>
                        }
                        else
                        {
                            <div class="ops-notice ops-notice-info"><strong>@L["Restock.Details.UnassignedAmount", AdminStatusDisplay.Quantity(remainingSource), requestUnitName]</strong><br />@L["Restock.Details.ChooseSourceCopy"]</div>
                            <div class="ops-source-options" role="group" aria-label="@L["Restock.Details.ChooseSourceAria"]">
                                <div class="ops-source-option" data-source-option="TRANSFER" tabindex="0" aria-pressed="false">
                                    <i class="fa-solid fa-arrow-right-arrow-left" aria-hidden="true"></i><strong>@L["Restock.Details.Source.Transfer"]</strong>
                                </div>
                                @if (canOfferPurchase)
                                {
                                    <div class="ops-source-option" data-source-option="PURCHASE" tabindex="0" aria-pressed="false">
                                        <i class="fa-solid fa-basket-shopping" aria-hidden="true"></i><strong>@L["Restock.Details.Source.Purchase"]</strong>
                                    </div>
                                }
                                @if (productionEligibility?.Eligible == true)
                                {
                                    <div class="ops-source-option" data-source-option="PRODUCTION" tabindex="0" aria-pressed="false">
                                        <i class="fa-solid fa-flask" aria-hidden="true"></i><strong>@L["Restock.Details.Source.Production"]</strong>
                                    </div>
                                }
                            </div>
                            
                            <div class="ops-source-notes">
                                <div class="ops-source-note-item">
                                    <i class="fa-solid fa-arrow-right-arrow-left" aria-hidden="true"></i>
                                    <span><strong>@L["Restock.Details.Source.Transfer"]:</strong> @L["Restock.Details.Source.TransferHelp"]</span>
                                </div>
                                @if (canOfferPurchase)
                                {
                                    <div class="ops-source-note-item">
                                        <i class="fa-solid fa-basket-shopping" aria-hidden="true"></i>
                                        <span><strong>@L["Restock.Details.Source.Purchase"]:</strong> @L["Restock.Details.Source.PurchaseHelp"]</span>
                                    </div>
                                }
                                @if (productionEligibility?.Eligible == true)
                                {
                                    <div class="ops-source-note-item">
                                        <i class="fa-solid fa-flask" aria-hidden="true"></i>
                                        <span><strong>@L["Restock.Details.Source.Production"]:</strong> @L["Restock.Details.Source.ProductionHelp"]</span>
                                    </div>
                                }
                            </div>
                            <form method="post" asp-action="SetSourcingDecision" class="ops-source-form" data-source-form hidden>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="RestockRequestId" value="@Model.RestockRequestId" />
                                <input type="hidden" name="ProcurementUnitId" value="@Model.ProcurementUnitId" />
                                <input type="hidden" name="RequestKey" value="@Guid.NewGuid()" />
                                <input type="hidden" name="RowVersion" value="@Model.RowVersion" />
                                <input id="sourceDecision" name="DecisionType" type="hidden" required />
                                <div class="ops-inline-actions ops-source-change"><strong data-source-title></strong><button type="button" class="ops-btn" data-change-source>@L["Restock.Details.ChangeSource"]</button></div>
                                <div class="ops-source-form-grid">
                                    <div><label class="ops-form-label" for="sourceQuantity">@L["Restock.Details.AllocationQuantity", requestUnitName]</label><input id="sourceQuantity" name="ProcurementQuantity" type="number" class="ops-input w-100" min="0.001" max="@remainingSource.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.001" required /></div>
                                    <div><label class="ops-form-label" for="sourceReason">@L["Common.Notes"]</label><input id="sourceReason" name="Reason" class="ops-input w-100" maxlength="500" placeholder="@L["Restock.Details.SourceReasonPlaceholder"]" /></div>
                                    <button type="submit" class="ops-btn ops-btn-primary">@L["Restock.Details.SaveSource"]</button>
                                </div>
                            </form>
                            <details class="ops-danger-disclosure">
                                <summary>@L["Restock.Details.RejectRemaining"]</summary>
                                <div class="ops-danger-content">
                                    <form method="post" asp-action="SetSourcingDecision" class="ops-source-form-grid">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="RestockRequestId" value="@Model.RestockRequestId" />
                                        <input type="hidden" name="ProcurementUnitId" value="@Model.ProcurementUnitId" />
                                        <input type="hidden" name="RowVersion" value="@Model.RowVersion" />
                                        <input type="hidden" name="DecisionType" value="REJECT" />
                                        <div><label class="ops-form-label" for="rejectSourceQuantity">@L["Restock.Details.RejectedQuantity", requestUnitName]</label><input id="rejectSourceQuantity" name="ProcurementQuantity" type="number" class="ops-input w-100" min="0.001" max="@remainingSource.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.001" required /></div>
                                        <div><label class="ops-form-label" for="rejectSourceReason">@L["Restock.Details.RejectReason"]</label><input id="rejectSourceReason" name="Reason" class="ops-input w-100" maxlength="500" required /></div>
                                        <button type="submit" class="ops-btn ops-btn-danger">@L["Restock.Details.ConfirmReject"]</button>
                                    </form>
                                </div>
                            </details>
                        }
                    }
                    else
                    {
                        <div class="ops-secondary">@L["Restock.Details.SourceReviewUnavailable"]</div>
                    }
                </div>
            </section>

            @if (canAddDemand && usesProcurement)
            {
                <section id="add-demand" class="ops-panel">
                    <div class="ops-panel-header"><h2 class="ops-panel-title">@L["Restock.Details.AddDemandTitle"]</h2></div>
                    <div class="ops-panel-body">
                        @if (isPreparedItemDemand)
                        {
                            <p class="ops-secondary">@L["Restock.Details.AddPreparedDemandHelp"]</p>
                            <div class="ops-notice mb-3">
                                @L["Restock.Details.NetNeed"]: <strong>@(preparedItemReplenishment?.NetNeedBase.HasValue == true ? $"{AdminStatusDisplay.Quantity(preparedItemReplenishment.NetNeedBase.Value)} {requestUnitName}" : L["Common.NotCalculated"].Value)</strong>
                                · @L["Restock.Details.UnallocatedInRequest"]: <strong>@AdminStatusDisplay.Quantity(Model.RemainingUnallocatedQuantity) @requestUnitName</strong>
                                · @L["Restock.Details.AdjustmentToConfirm"]: <strong>@(preparedItemAdditionalDemandBase.HasValue ? $"{AdminStatusDisplay.Quantity(preparedItemAdditionalDemandBase.Value)} {requestUnitName}" : L["Common.NotCalculated"].Value)</strong>
                            </div>
                        }
                        else
                        {
                            <p class="ops-secondary">@L["Restock.Details.AddIngredientDemandHelp"]</p>
                        }
                        <form method="post" asp-action="AddDemand" data-single-submit>
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="RestockRequestId" value="@Model.RestockRequestId" />
                            <input type="hidden" name="ProcurementUnitId" value="@Model.ProcurementUnitId" />
                            <input type="hidden" name="RowVersion" value="@Model.RowVersion" />
                            <input type="hidden" name="RequestKey" value="@Guid.NewGuid().ToString("N")" />
                            <div class="ops-data-grid">
                                <div><label class="ops-form-label" for="adjustmentQuantity">@L["Restock.Details.AdditionalQuantity", requestUnitName]</label><input id="adjustmentQuantity" name="AdjustmentProcurementQuantity" class="ops-input" type="number" min="0.001" step="0.001" value="@(isPreparedItemDemand ? preparedItemAdditionalDemandBase?.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) : null)" readonly="@(isPreparedItemDemand ? "readonly" : null)" required /></div>
                                <div><label class="ops-form-label" for="adjustmentNeedBy">@L["Restock.Details.NewNeedBy"]</label><input id="adjustmentNeedBy" name="NeedByDate" class="ops-input" type="date" value="@Model.NeedByDate?.ToString("yyyy-MM-dd")" /></div>
                            </div>
                            <div class="mt-3"><label class="ops-form-label" for="adjustmentReason">@L["Restock.Details.AddDemandReason"]</label><textarea id="adjustmentReason" name="Reason" class="ops-textarea" maxlength="500" required placeholder="@L["Restock.Details.AddDemandReasonPlaceholder"]"></textarea></div>
                            <button type="submit" class="ops-btn ops-btn-primary mt-3" data-submit-button disabled="@(isPreparedItemDemand && preparedItemAdditionalDemandBase is not > 0 ? "disabled" : null)">@L["Restock.Details.AddDemandAction"]</button>
                        </form>
                    </div>
                </section>
            }

            @if (usesPurchaseBranch)
            {
            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">@L["Restock.Details.LinkedAdvices"]</h2></div>
                <div class="ops-panel-body">
                    @if (Model.PurchaseAdvices.Count == 0)
                    {
                        <div class="ops-secondary">@L["Restock.Details.NoLinkedAdvices"]</div>
                    }
                    else
                    {
                        @foreach (var advice in Model.PurchaseAdvices)
                        {
                            <div class="ops-notice mb-2"><strong>@advice.AdviceNumber</strong> · @AdminStatusDisplay.Quantity(advice.ProcurementQuantity) @(advice.ProcurementUnitName ?? requestUnitName)<div class="ops-secondary">@L["Common.Status"]: @AdminStatusDisplay.PurchaseAdvice(advice.Status).Label · @L["Common.Supplier"]: @(advice.SupplierName ?? L["Common.NotSelected"].Value)</div><a class="ops-btn mt-2" asp-area="Admin" asp-controller="AdminPurchaseAdvices" asp-action="Details" asp-route-id="@advice.PurchaseAdviceId">@L["Restock.Details.ViewAdvice"]</a></div>
                        }
                    }
                    @if (hasPendingPurchaseAllocation && canCreatePurchaseAdvice)
                    {
                        <div class="ops-inline-actions mt-3"><a class="ops-btn ops-btn-primary" asp-area="Admin" asp-controller="AdminPurchaseAdvices" asp-action="Create" asp-route-restockRequestId="@Model.RestockRequestId" asp-route-storeId="@Model.StoreId">@L["Restock.Details.CreateNewAdvice"]</a></div>
                        @if (Model.DraftPurchaseAdvices.Count > 0)
                        {
                            <form method="post" asp-area="Admin" asp-controller="AdminPurchaseAdvices" asp-action="AddRestockRequestToDraft" class="ops-inline-actions mt-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="RestockRequestId" value="@Model.RestockRequestId" /><input type="hidden" name="RestockRowVersion" value="@Model.RowVersion" />
                                <select name="PurchaseAdviceId" class="ops-select" required onchange="this.form.PurchaseAdviceRowVersion.value=this.selectedOptions[0].dataset.version"><option value="">@L["Restock.Details.SelectDraftAdvice"]</option>@foreach (var draft in Model.DraftPurchaseAdvices) { <option value="@draft.PurchaseAdviceId" data-version="@draft.RowVersion">@draft.AdviceNumber · @L["Restock.Details.NeededBy", AdminStatusDisplay.Date(draft.NeededByDate)]</option> }</select>
                                <input type="hidden" name="PurchaseAdviceRowVersion" value="" />
                                <button class="ops-btn" type="submit">@L["Restock.Details.AddToDraftAdvice"]</button>
                            </form>
                        }
                    }
                    @if (Model.HasOrphanPurchaseAllocation) { <div class="ops-notice ops-notice-error mt-3">@L["Restock.Details.OrphanPurchaseAllocation"]</div> }
                </div>
            </section>
            }

            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">@L["Restock.Details.StatusHistory"]</h2></div>
                <div class="ops-panel-body">
                    @if (canSubmit && Model.Status == "DRAFT")
                    {
                        <form method="post" asp-action="Submit" asp-route-id="@Model.RestockRequestId" class="mb-3">@Html.AntiForgeryToken()<input type="hidden" name="rowVersion" value="@Model.RowVersion" /><button type="submit" class="ops-btn ops-btn-primary w-100"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i> @L["Restock.Details.SubmitDemand", demandLabel.ToLowerInvariant()]</button></form>
                    }
                    @if (Model.Timeline.Count == 0) { <div class="ops-secondary">@L["Restock.Details.NoStatusHistory"]</div> }
                    else
                    {
                        <ol class="ops-timeline">
                            @foreach (var transition in Model.Timeline)
                            {
                                <li>
                                    <strong>@(transition.IsDemandAdjustment ? L["Restock.Details.DemandAdded"].Value : AdminStatusDisplay.RestockRequest(transition.NewStatus).Label)</strong>
                                    <div class="ops-secondary">@AdminStatusDisplay.DateTime(transition.OccurredAtUtc.ToLocalTime()) · @(transition.ActorName ?? L["Common.System"].Value)</div>
                                    @if (transition.IsDemandAdjustment && transition.QuantityBefore.HasValue && transition.QuantityAfter.HasValue)
                                    {
                                        <div><strong>+@AdminStatusDisplay.Quantity(transition.QuantityAfter.Value - transition.QuantityBefore.Value) @requestUnitName</strong> · @L["Restock.Details.QuantityChanged", AdminStatusDisplay.Quantity(transition.QuantityBefore.Value), AdminStatusDisplay.Quantity(transition.QuantityAfter.Value), requestUnitName]</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(transition.Reason)) { <div>@(transition.IsDemandAdjustment ? transition.Reason : AdminStatusDisplay.SystemGeneratedMessage(transition.Reason))</div> }
                                    @if (transition.BranchReceiptId.HasValue) { <div>@L["Restock.Details.Receipt"] <a asp-area="Admin" asp-controller="AdminBranchReceipts" asp-action="Details" asp-route-id="@transition.BranchReceiptId">#@transition.BranchReceiptId</a>@(transition.QuantityAfter.HasValue ? L["Restock.Details.ReceivedSuffix", AdminStatusDisplay.Quantity(transition.QuantityAfter.Value)].Value : "")</div> }
                                    @if (transition.InventoryTransferId.HasValue) { <div>@L["Restock.Details.Transfer"] <a asp-area="Admin" asp-controller="AdminInventoryTransfer" asp-action="Detail" asp-route-id="@transition.InventoryTransferId">#@transition.InventoryTransferId</a>@(transition.QuantityAfter.HasValue ? L["Restock.Details.CumulativeSuffix", AdminStatusDisplay.Quantity(transition.QuantityAfter.Value)].Value : "")</div> }
                                </li>
                            }
                        </ol>
                    }
                </div>
            </section>

            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">@L["Restock.Details.ReceivedPostingsTitle"]</h2></div>
                <div class="ops-panel-body p-0">
                    @if (Model.FulfillmentPostings.Count == 0) { <div class="p-3 ops-secondary">@L["Restock.Details.NoReceivedPostings"]</div> }
                    else
                    {
                        <div class="ops-table-scroll"><table class="ops-table ops-table-min-620"><thead><tr><th>@L["Common.Source"]</th><th>@L["Common.DocumentLine"]</th><th class="number">@L["Common.Quantity"]</th><th>@L["Common.Time"]</th></tr></thead><tbody>
                        @foreach (var posting in Model.FulfillmentPostings)
                        {
                            <tr><td><strong>@AdminStatusDisplay.RestockFulfillmentDocumentType(posting.SourceDocumentType)</strong> #@posting.SourceDocumentId</td><td>#@posting.SourceDocumentLineId</td><td class="number">@AdminStatusDisplay.Quantity(posting.Quantity) @(posting.BaseUnitName ?? L["Restock.Details.BaseUnitNumber", posting.BaseUnitId].Value)</td><td>@AdminStatusDisplay.DateTime(posting.CreatedAtUtc.ToLocalTime())</td></tr>
                        }
                        </tbody></table></div>
                    }
                </div>
            </section>

            @if (usesPurchaseBranch)
            {
            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">@L["Restock.Details.LinkedPurchaseOrders"]</h2></div>
                <div class="ops-panel-body p-0">
                    @if (Model.PurchaseOrders.Count == 0) { <div class="p-3 ops-secondary">@L["Restock.Details.NoLinkedPurchaseOrders"]</div> }
                    else
                    {
                        <div class="ops-table-scroll"><table class="ops-table ops-table-min-680"><thead><tr><th>@L["Restock.Details.PurchaseOrder"]</th><th>@L["Common.Supplier"]</th><th>@L["Restock.Details.OrderStatus"]</th><th>@L["Common.OrderDate"]</th><th class="number">@L["Common.Value"]</th><th class="text-end">@L["Common.Actions"]</th></tr></thead><tbody>
                        @foreach (var order in Model.PurchaseOrders)
                        {
                            <tr>
                                <td><strong>@order.Code</strong></td>
                                <td>@order.SupplierName</td>
                                <td><span class="ops-badge @AdminStatusDisplay.PurchaseOrder(order.Status).CssClass">@AdminStatusDisplay.PurchaseOrder(order.Status).Label</span></td>
                                <td>@AdminStatusDisplay.DateTime(order.OrderDate.ToLocalTime())</td>
                                <td class="number">@AdminStatusDisplay.Currency(order.TotalAmount)</td>
                                <td class="text-end"><a class="ops-btn" asp-area="Admin" asp-controller="AdminPurchaseOrders" asp-action="Details" asp-route-id="@order.PurchaseOrderId">@L["Restock.Details.ViewOrder"]</a></td>
                            </tr>
                        }
                        </tbody></table></div>
                    }
                </div>
            </section>
            }

            @if (usesPurchaseBranch)
            {
            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">@L["Restock.Details.SupplierIssues"]</h2></div>
                <div class="ops-panel-body p-0">
                    @if (Model.SupplierIssues.Count == 0) { <div class="p-3 ops-secondary">@L["Restock.Details.NoSupplierIssues"]</div> }
                    else
                    {
                        <div class="ops-table-scroll"><table class="ops-table ops-table-min-720"><thead><tr><th>@L["Common.Supplier"]</th><th>@L["Restock.Details.Issue"]</th><th>@L["Common.Status"]</th><th class="number">@L["Restock.Details.Impact"]</th><th>@L["Restock.Details.Document"]</th></tr></thead><tbody>
                        @foreach (var issue in Model.SupplierIssues)
                        {
                            <tr><td>@issue.SupplierName</td><td><strong>@AdminStatusDisplay.SupplierReceiptIssueType(issue.IssueType)</strong><div class="ops-secondary">@issue.Description</div></td><td><span class="ops-badge @AdminStatusDisplay.SupplierReceiptIssue(issue.Status).CssClass">@AdminStatusDisplay.SupplierReceiptIssue(issue.Status).Label</span></td><td class="number">@AdminStatusDisplay.Quantity(issue.AffectedBaseQuantity)</td><td><a asp-area="Admin" asp-controller="AdminSupplierQuality" asp-action="Index" asp-route-storeId="@issue.StoreId" asp-route-supplierId="@issue.SupplierId">@issue.BranchReceiptCode</a></td></tr>
                        }
                        </tbody></table></div>
                    }
                </div>
            </section>
            }

            @if (usesPurchaseBranch)
            {
            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">@L["Restock.Details.ReceiptDocuments"]</h2></div>
                <div class="ops-panel-body p-0">
                    @if (Model.Receipts.Count == 0) { <div class="p-3 ops-secondary">@L["Restock.Details.NoReceiptDocuments"]</div> }
                    else
                    {
                        <div class="ops-table-scroll"><table class="ops-table ops-table-min-620"><thead><tr><th>@L["Restock.Details.ReceiptCode"]</th><th>@L["Common.Status"]</th><th class="number">@L["Restock.Details.ReceivedQty"]</th><th class="number">@L["Common.Value"]</th><th class="text-end">@L["Common.Actions"]</th></tr></thead><tbody>
                        @foreach (var receipt in Model.Receipts)
                        {
                            <tr><td><strong>@receipt.ReceiptCode</strong><div class="ops-secondary">@AdminStatusDisplay.DateTime(receipt.ReceivedAt.ToLocalTime())</div></td><td><span class="ops-badge @AdminStatusDisplay.BranchReceipt(receipt.Status).CssClass">@AdminStatusDisplay.BranchReceipt(receipt.Status).Label</span></td><td class="number">@AdminStatusDisplay.Quantity(receipt.TotalBaseQuantity)</td><td class="number">@AdminStatusDisplay.Currency(receipt.TotalLineCost)</td><td class="text-end"><a class="ops-btn" asp-area="Admin" asp-controller="AdminBranchReceipts" asp-action="Details" asp-route-id="@receipt.BranchReceiptId">@L["Restock.Details.ViewReceipt"]</a></td></tr>
                        }
                        </tbody></table></div>
                    }
                </div>
            </section>
            }
        </div>

        <aside>
            <section class="ops-panel ops-next-action">
                <div class="ops-panel-header"><h2 class="ops-panel-title">@L["Restock.Details.NextActions"]</h2></div>
                <div class="ops-panel-body">
                    @if (canStartProcessing && Model.Status == "SUBMITTED")
                    {
                        <form method="post" asp-action="StartProcessing" asp-route-id="@Model.RestockRequestId" class="mb-3">@Html.AntiForgeryToken()<input type="hidden" name="rowVersion" value="@Model.RowVersion" /><button type="submit" class="ops-btn ops-btn-primary w-100"><i class="fa-solid fa-play" aria-hidden="true"></i> @L["Restock.Details.StartProcessing"]</button></form>
                    }
                    @if (canAddDemand && usesProcurement)
                    {
                        <a class="ops-btn w-100 mb-3 text-center" href="#add-demand"><i class="fa-solid fa-plus" aria-hidden="true"></i> @L["Restock.Details.AddDemandAction"]</a>
                    }
                    @if ((canWarehouse && Model.Status == "SUBMITTED") || (canCancel && Model.Status is ("DRAFT" or "SUBMITTED")))
                    {
                        <details class="ops-danger-disclosure">
                            <summary>@L["Restock.Details.CancelOrReject"]</summary>
                            <div class="ops-danger-content">
                                @if (canWarehouse && Model.Status == "SUBMITTED")
                                {
                                    <form method="post" asp-action="Reject" asp-route-id="@Model.RestockRequestId" class="mb-3">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                                        <label class="ops-form-label" for="rejectReason">@L["Restock.Details.RejectReason"]</label>
                                        <textarea id="rejectReason" name="reason" class="ops-textarea" required placeholder="@L["Restock.Details.RejectReasonPlaceholder"]"></textarea>
                                        <button type="submit" class="ops-btn ops-btn-danger w-100 mt-2">@L["Restock.Details.RejectRequest"]</button>
                                    </form>
                                }
                                @if (canCancel && Model.Status is "DRAFT" or "SUBMITTED")
                                {
                                    <form method="post" asp-action="Cancel" asp-route-id="@Model.RestockRequestId">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                                        <label class="ops-form-label" for="cancelReason">@L["Restock.Details.CancelReason"]</label>
                                        <input id="cancelReason" name="reason" class="ops-input w-100" required placeholder="@L["Restock.Details.CancelReasonPlaceholder"]" />
                                        <button type="submit" class="ops-btn ops-btn-danger w-100 mt-2">@L["Restock.Details.CancelRequest"]</button>
                                    </form>
                                }
                            </div>
                        </details>
                    }
                    @if (canWarehouse
                        && Model.Status is ("PROCESSING" or "PARTIALLY_RECEIVED")
                        && (usesProcurement
                            ? Model.RemainingToReceiveProcurementQuantity.GetValueOrDefault() > 0
                            : Model.RemainingToReceiveQuantity > 0))
                    {
                        <a class="ops-btn w-100 mb-3" asp-area="Admin" asp-controller="AdminInventoryTransfer" asp-action="Create" asp-route-restockRequestId="@Model.RestockRequestId" asp-route-toStoreId="@Model.StoreId"><i class="fa-solid fa-truck-ramp-box" aria-hidden="true"></i> @L["Restock.Details.CreateRemainingTransfer"]</a>
                        <form method="post" asp-action="CloseRemaining" asp-route-id="@Model.RestockRequestId" class="mt-3 pt-3 border-top">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                            <div class="mb-3">
                                <label class="ops-form-label fw-bold mb-2" for="closeRemainingReason" style="display: block; font-size: 13px !important; color: #5C3F2B !important; height: auto !important; line-height: 1.5 !important;">@L["Restock.Details.CloseRemainingReason"]</label>
                                <textarea id="closeRemainingReason" name="reason" class="ops-textarea" required
                                          placeholder="@L["Restock.Details.CloseRemainingPlaceholder"]"
                                          style="min-height: 80px !important; height: 80px !important; font-size: 13px !important; padding: 10px !important; width: 100% !important; border-radius: 8px !important; border: 1px solid #D8C5B6 !important; background-color: #FFFDFB !important; resize: none !important;"></textarea>
                            </div>
                            <button type="submit" class="ops-btn w-100" style="background-color: #C65A43 !important; color: white !important; font-weight: 700 !important; border: none !important; height: 40px !important; min-height: 40px !important; border-radius: 8px !important; display: flex !important; align-items: center !important; justify-content: center !important;">@L["Restock.Details.CloseRemaining"]</button>
                        </form>
                    }
                    @if ((!canWarehouse || Model.Status is not ("SUBMITTED" or "PROCESSING" or "PARTIALLY_RECEIVED")) && !(canCancel && Model.Status is "DRAFT" or "SUBMITTED") && !(canSubmit && Model.Status == "DRAFT"))
                    {
                        <div class="ops-secondary">@L["Restock.Details.NoStatusAction"]</div>
                    }
                </div>
            </section>

            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">@L["Restock.Details.ExecutionSources"]</h2></div>
                <div class="ops-panel-body">
                    @if (orphanTransferAllocations.Count > 0)
                    {
                        <div class="ops-notice ops-notice-warning mb-2">
                            <strong>@L["Restock.Details.OrphanTransferTitle"]</strong>
                            <div class="ops-secondary">@L["Restock.Details.OrphanTransferCopy"]</div>
                        </div>
                    }
                    else if (productionAllocations.Count > 0)
                    {
                        <div class="ops-notice mb-2">
                            <strong>@L["Restock.Details.Source.Production"]</strong>
                            <div class="ops-secondary">@L["Restock.Details.ProductionAllocated", AdminStatusDisplay.Quantity(productionAllocated), requestUnitName]</div>
                            @if (canViewProduction && productionAllocations.FirstOrDefault(x => x.ProductionRunId.HasValue)?.ProductionRunId is int productionRunId)
                            {
                                <a class="ops-btn mt-2" asp-area="Admin" asp-controller="AdminProductionOrder" asp-action="Details" asp-route-id="@productionRunId">@L["Restock.Details.OpenProductionOrder"]</a>
                            }
                        </div>
                    }
                    else if (Model.Fulfillments.Count == 0) { <div class="ops-secondary">@L["Restock.Details.NoExecutionDocuments"]</div> }
                    else if (orphanTransferAllocations.Count == 0)
                    {
                        @foreach (var fulfillment in Model.Fulfillments)
                        {
                            <div class="ops-notice mb-2"><strong>@AdminStatusDisplay.RestockFulfillmentSource(fulfillment.SourceType)</strong> · @AdminStatusDisplay.RestockFulfillmentStatus(fulfillment.Status)<div class="ops-secondary">@L["Restock.Details.Planned", AdminStatusDisplay.Quantity(fulfillment.PlannedBaseQuantity)] · @AdminStatusDisplay.DateTime(fulfillment.CreatedAt.ToLocalTime())</div></div>
                        }
                    }
                    @if (productionAllocations.Count > 0)
                    {
                        <div class="ops-help mt-3">@L["Restock.Details.ProductionSourceHelp"]</div>
                    }
                    else
                    {
                        <div class="ops-help mt-3">@L["Restock.Details.PurchaseSourceHelp"]</div>
                    }
                </div>
            </section>
        </aside>
    </div>
</main>

<script type="application/json" id="restock-detail-ui-catalog">
@Html.Raw(JsonSerializer.Serialize(new Dictionary<string, string>
{
    ["Source.Transfer"] = L["Restock.Details.Source.Transfer"].Value,
    ["Source.Purchase"] = L["Restock.Details.Source.Purchase"].Value,
    ["Source.Production"] = L["Restock.Details.Source.Production"].Value,
    ["Submitting"] = L["Restock.Details.Submitting"].Value
}))
</script>
<script>
const restockDetailCatalog = CafeChainUiCatalog.read('restock-detail-ui-catalog');
const restockDetailText = (key, values = {}) => CafeChainUiCatalog.text(restockDetailCatalog, key, values);
const sourceOptions = [...document.querySelectorAll('[data-source-option]')];
const sourceForm = document.querySelector('[data-source-form]');
const sourceDecision = document.getElementById('sourceDecision');
const sourceTitle = document.querySelector('[data-source-title]');
const sourceOptionGroup = document.querySelector('.ops-source-options');
const sourceLabels = {
    TRANSFER: restockDetailText('Source.Transfer'),
    PURCHASE: restockDetailText('Source.Purchase'),
    PRODUCTION: restockDetailText('Source.Production')
};

const resetSourceSelection = () => {
    sourceOptions.forEach(option => {
        option.classList.remove('is-active');
        option.setAttribute('aria-pressed', 'false');
    });
    sourceOptionGroup?.classList.remove('has-selection');
    if (sourceForm) sourceForm.hidden = true;
    if (sourceDecision) sourceDecision.value = '';
};

sourceOptions.forEach(option => {
    option.addEventListener('click', () => {
        const decision = option.dataset.sourceOption;
        if (!decision || !sourceForm || !sourceDecision || !sourceTitle) return;
        sourceOptions.forEach(candidate => {
            const active = candidate === option;
            candidate.classList.toggle('is-active', active);
            candidate.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        sourceOptionGroup?.classList.add('has-selection');
        sourceDecision.value = decision;
        sourceTitle.textContent = sourceLabels[decision] ?? '';
        sourceForm.hidden = false;
        sourceForm.querySelector('input:not([type="hidden"])')?.focus();
    });
});

document.querySelector('[data-change-source]')?.addEventListener('click', resetSourceSelection);

document.querySelectorAll('[data-single-submit]').forEach(form => {
    form.addEventListener('submit', () => {
        const button = form.querySelector('[data-submit-button]');
        if (!button) return;
        button.disabled = true;
        button.textContent = restockDetailText('Submitting');
    });
});
</script>
