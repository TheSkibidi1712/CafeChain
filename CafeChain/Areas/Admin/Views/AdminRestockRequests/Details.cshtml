@model CafeChain.Application.DTOs.Admin.RestockRequests.RestockRequestWorkflowDetailDto
@using CafeChain.Application.Constants
@using CafeChain.ViewModels.Admin.Shared
@{
    ViewData["Title"] = "Chi tiết yêu cầu nhập hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var canWarehouse = ViewBag.CanWarehouse as bool? ?? false;
    var canCreateReceipt = ViewBag.CanCreateReceipt as bool? ?? false;
    var canCancel = ViewBag.CanCancel as bool? ?? false;
    var canSubmit = ViewBag.CanSubmit as bool? ?? false;
    var hasPendingPurchaseAllocation = Model.SourcingAllocations.Any(x =>
        x.DecisionType == RestockSourcingDecisionTypes.Purchase
        && x.Status == RestockSourcingAllocationStatuses.PendingPurchaseAdvice
        && !x.PurchaseAdviceLineId.HasValue
        && !x.PurchaseOrderLineId.HasValue);
    var canCreatePurchaseAdvice = User.IsInRole(CafeChain.Application.Constants.RoleConstants.StoreManager)
        && Model.IngredientId.HasValue
        && Model.Status is ("PROCESSING" or "PARTIALLY_RECEIVED")
        && (string.Equals(Model.SourceType, RestockRequestSourceTypes.Legacy, StringComparison.OrdinalIgnoreCase)
            || hasPendingPurchaseAllocation);
    var usesProcurement = Model.RequestedProcurementQuantity.HasValue
        && Model.RequestedProcurementQuantity.Value > 0
        && Model.ProcurementUnitId.HasValue;
    var requestUnitName = usesProcurement
        ? Model.ProcurementUnitName ?? "đơn vị mua hàng"
        : Model.BaseUnitName;
    var target = usesProcurement
        ? Model.RequestedProcurementQuantity!.Value
        : Model.TargetQuantity > 0 ? Model.TargetQuantity : Model.RequestedQuantity;
    var fulfilled = usesProcurement
        ? Model.FulfilledProcurementQuantity.GetValueOrDefault()
        : Model.ReceivedQuantity;
    var progress = target <= 0 ? 0m : Math.Min(100m, Math.Max(0m, fulfilled / target * 100m));
}

<link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />

<main class="ops-shell">
    <header class="ops-header">
        <div>
            <div class="ops-eyebrow">Yêu cầu nhập hàng #@Model.RestockRequestId · Chi nhánh @(Model.StoreName ?? $"#{Model.StoreId}")</div>
            <h1 class="ops-title">@Model.ItemName</h1>
            <p class="ops-subtitle">@Model.ItemTypeLabel · Tạo bởi @(Model.CreatedByName ?? $"Nhân viên #{Model.CreatedByStaffId}") lúc @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <div class="ops-actions">
            <a class="ops-btn" asp-area="Admin" asp-controller="AdminRestockRequests" asp-action="Index" asp-route-storeId="@Model.StoreId"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Danh sách</a>
            @if (Model.StockAlertId.HasValue)
            {
                <a class="ops-btn" asp-area="Admin" asp-controller="AdminStockAlerts" asp-action="Details" asp-route-id="@Model.StockAlertId" asp-route-storeId="@Model.StoreId"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> Cảnh báo gốc</a>
            }
            @if (canCreateReceipt && Model.Status is "PROCESSING" or "PARTIALLY_RECEIVED")
            {
                <a class="ops-btn ops-btn-primary" asp-area="Admin" asp-controller="AdminBranchReceipts" asp-action="Create" asp-route-restockRequestId="@Model.RestockRequestId" asp-route-storeId="@Model.StoreId"><i class="fa-solid fa-box-open" aria-hidden="true"></i> Tạo phiếu nhận</a>
            }
            @if (canCreatePurchaseAdvice)
            {
                <a class="ops-btn ops-btn-primary" asp-area="Admin" asp-controller="AdminPurchaseAdvices" asp-action="Create" asp-route-restockRequestId="@Model.RestockRequestId" asp-route-storeId="@Model.StoreId"><i class="fa-solid fa-clipboard-list" aria-hidden="true"></i> Tạo đề nghị mua</a>
            }
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null) { <div class="ops-notice ops-notice-success" role="status">@TempData["SuccessMessage"]</div> }
    @if (TempData["ErrorMessage"] != null) { <div class="ops-notice ops-notice-error" role="alert">@TempData["ErrorMessage"]</div> }
    @if (Model.StockRecoveredExternally)
    {
        <div class="ops-notice ops-notice-warning" role="status">
            <strong>Tồn kho đã được bổ sung từ nguồn khác.</strong><br />Chứng từ bổ sung không gắn với yêu cầu này. Yêu cầu vẫn đang mở để bộ phận kho quyết định tiếp tục hoặc hủy; hệ thống không tự ghi nhận hoàn tất.
        </div>
    }

    <section class="ops-metrics" aria-label="Tiến độ yêu cầu">
        <div class="ops-metric"><span class="ops-metric-label">Số lượng yêu cầu</span><strong class="ops-metric-value">@AdminStatusDisplay.Quantity(target) @requestUnitName</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Phân bổ điều chuyển</span><strong class="ops-metric-value">@AdminStatusDisplay.Quantity(usesProcurement ? Model.TransferAllocatedProcurementQuantity.GetValueOrDefault() : Model.TransferAllocatedQuantity) @requestUnitName</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Phân bổ mua ngoài</span><strong class="ops-metric-value">@AdminStatusDisplay.Quantity(usesProcurement ? Model.PurchaseAllocatedProcurementQuantity.GetValueOrDefault() : Model.PurchaseAllocatedQuantity) @requestUnitName</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Phân bổ sản xuất</span><strong class="ops-metric-value">@AdminStatusDisplay.Quantity(Model.ProductionAllocatedProcurementQuantity.GetValueOrDefault()) @(usesProcurement ? requestUnitName : string.Empty)</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Đã từ chối</span><strong class="ops-metric-value">@AdminStatusDisplay.Quantity(Model.RejectedProcurementQuantity.GetValueOrDefault()) @(usesProcurement ? requestUnitName : string.Empty)</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Đã nhận thực tế</span><strong class="ops-metric-value success">@AdminStatusDisplay.Quantity(fulfilled) @requestUnitName</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Chưa xác định nguồn cung</span><strong class="ops-metric-value @((usesProcurement ? Model.RemainingUnallocatedProcurementQuantity.GetValueOrDefault() : Model.RemainingUnallocatedQuantity) > 0 ? "warning" : "success")">@AdminStatusDisplay.Quantity(usesProcurement ? Model.RemainingUnallocatedProcurementQuantity.GetValueOrDefault() : Model.RemainingUnallocatedQuantity) @requestUnitName</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Còn thiếu theo nhu cầu</span><strong class="ops-metric-value @((usesProcurement ? Model.RemainingToReceiveProcurementQuantity.GetValueOrDefault() : Model.RemainingToReceiveQuantity) > 0 ? "warning" : "success")">@AdminStatusDisplay.Quantity(usesProcurement ? Model.RemainingToReceiveProcurementQuantity.GetValueOrDefault() : Model.RemainingToReceiveQuantity) @requestUnitName</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Tiến độ</span><strong class="ops-metric-value">@progress.ToString("N0")%</strong><div class="ops-progress mt-2"><div class="ops-progress-bar" style="width:@progress.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div></div></div>
    </section>

    <div class="ops-detail-grid">
        <div>
            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">Thông tin yêu cầu</h2></div>
                <div class="ops-panel-body">
                    <div class="ops-inline-actions mb-3">
                        <span class="ops-badge @AdminStatusDisplay.RestockRequest(Model.Status).CssClass">@AdminStatusDisplay.RestockRequest(Model.Status).Label</span>
                        <span class="ops-badge @AdminStatusDisplay.RestockRequestPriority(Model.Priority).CssClass">Ưu tiên @AdminStatusDisplay.RestockRequestPriority(Model.Priority).Label.ToLowerInvariant()</span>
                    </div>
                    <div class="ops-data-grid">
                        <div><span class="ops-data-label">Gợi ý hệ thống</span><span class="ops-data-value">@(Model.SuggestedQuantity.HasValue ? $"{AdminStatusDisplay.Quantity(Model.SuggestedQuantity.Value)} {Model.BaseUnitName}" : "Chưa đủ dữ liệu")</span></div>
                        <div><span class="ops-data-label">Cập nhật gần nhất</span><span class="ops-data-value">@Model.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></div>
                        <div><span class="ops-data-label">Kênh thực hiện</span><span class="ops-data-value">@(Model.FulfillmentChannel switch { "TRANSFER" => "Điều chuyển", "EXTERNAL_PURCHASE" => "Mua ngoài", "MIXED" => "Kết hợp", _ => "Chưa quyết định" })</span></div>
                        <div><span class="ops-data-label">Quyết định nguồn cung</span><span class="ops-data-value">@(Model.SourcingDecision switch { RestockSourcingDecisionTypes.Transfer => "Điều chuyển", RestockSourcingDecisionTypes.Purchase => "Mua ngoài", RestockSourcingDecisionTypes.Production => "Sản xuất", RestockSourcingDecisionTypes.Reject => "Từ chối", _ => "Chưa quyết định" })</span></div>
                        <div><span class="ops-data-label">Nguồn nhu cầu</span><span class="ops-data-value">@(Model.StockAlertId.HasValue ? $"#{Model.StockAlertId} · {AdminStatusDisplay.StockAlertType(Model.AlertType)}" : AdminStatusDisplay.RestockSource(Model.SourceType))</span></div>
                        <div><span class="ops-data-label">Mã tham chiếu nguồn</span><span class="ops-data-value">@(string.IsNullOrWhiteSpace(Model.SourceReferenceId) ? "—" : Model.SourceReferenceId)</span></div>
                        <div><span class="ops-data-label">Người tiếp nhận</span><span class="ops-data-value">@(Model.AcceptedByName ?? (Model.AcceptedByStaffId.HasValue ? $"Nhân viên #{Model.AcceptedByStaffId}" : "Chưa tiếp nhận"))</span></div>
                        <div><span class="ops-data-label">Thời gian tiếp nhận</span><span class="ops-data-value">@(Model.AcceptedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</span></div>
                    </div>
                    <div class="mt-3"><span class="ops-data-label">Ghi chú</span><div class="ops-notice mt-1 mb-0">@(Model.Note ?? "Không có ghi chú")</div></div>
                    @if (!string.IsNullOrWhiteSpace(Model.ProcessingNote)) { <div class="mt-3"><span class="ops-data-label">Ghi chú xử lý</span><div class="ops-notice mt-1 mb-0">@Model.ProcessingNote</div></div> }
                    @if ((usesProcurement ? Model.ClosedProcurementQuantity.GetValueOrDefault() : Model.ClosedRemainingQuantity) > 0) { <div class="ops-notice ops-notice-warning mt-3">Đã đóng @AdminStatusDisplay.Quantity(usesProcurement ? Model.ClosedProcurementQuantity.GetValueOrDefault() : Model.ClosedRemainingQuantity) @requestUnitName còn lại. Lý do: @Model.RemainingCloseReason</div> }
                    <div class="ops-help mt-3"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> Yêu cầu nhập không trực tiếp thay đổi tồn. Chỉ phiếu nhận hoặc điều chuyển được xác nhận mới tạo biến động kho.</div>
                </div>
            </section>

            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">Lịch sử chuyển trạng thái</h2></div>
                <div class="ops-panel-body">
                    @if (canSubmit && Model.Status == "DRAFT")
                    {
                        <form method="post" asp-action="Submit" asp-route-id="@Model.RestockRequestId" class="mb-3">@Html.AntiForgeryToken()<input type="hidden" name="rowVersion" value="@Model.RowVersion" /><button type="submit" class="ops-btn ops-btn-primary w-100"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Gửi yêu cầu nhập</button></form>
                    }
                    @if (Model.Timeline.Count == 0) { <div class="ops-secondary">Chưa có lịch sử chuyển trạng thái.</div> }
                    else
                    {
                        <ol class="ops-timeline">
                            @foreach (var transition in Model.Timeline)
                            {
                                <li>
                                    <strong>@AdminStatusDisplay.RestockRequest(transition.NewStatus).Label</strong>
                                    <div class="ops-secondary">@transition.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @(transition.ActorName ?? $"Nhân viên #{transition.ActorStaffId}")</div>
                                    @if (!string.IsNullOrWhiteSpace(transition.Reason)) { <div>@AdminStatusDisplay.SystemGeneratedMessage(transition.Reason)</div> }
                                    @if (transition.BranchReceiptId.HasValue) { <div>Phiếu nhận <a asp-area="Admin" asp-controller="AdminBranchReceipts" asp-action="Details" asp-route-id="@transition.BranchReceiptId">#@transition.BranchReceiptId</a>@(transition.QuantityAfter.HasValue ? $" · đã nhận {AdminStatusDisplay.Quantity(transition.QuantityAfter.Value)}" : "")</div> }
                                    @if (transition.InventoryTransferId.HasValue) { <div>Điều chuyển <a asp-area="Admin" asp-controller="AdminInventoryTransfer" asp-action="Detail" asp-route-id="@transition.InventoryTransferId">#@transition.InventoryTransferId</a>@(transition.QuantityAfter.HasValue ? $" · lũy kế {AdminStatusDisplay.Quantity(transition.QuantityAfter.Value)}" : "")</div> }
                                </li>
                            }
                        </ol>
                    }
                </div>
            </section>

            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">Ghi nhận số lượng đã nhận</h2></div>
                <div class="ops-panel-body p-0">
                    @if (Model.FulfillmentPostings.Count == 0) { <div class="p-3 ops-secondary">Chưa có lượng thực nhận từ chứng từ đã hoàn tất.</div> }
                    else
                    {
                        <div class="ops-table-scroll"><table class="ops-table" style="min-width:620px"><thead><tr><th>Nguồn</th><th>Dòng chứng từ</th><th class="number">Số lượng</th><th>Thời gian</th></tr></thead><tbody>
                        @foreach (var posting in Model.FulfillmentPostings)
                        {
                            <tr><td><strong>@AdminStatusDisplay.RestockFulfillmentDocumentType(posting.SourceDocumentType)</strong> #@posting.SourceDocumentId</td><td>#@posting.SourceDocumentLineId</td><td class="number">@AdminStatusDisplay.Quantity(posting.Quantity) @(posting.BaseUnitName ?? $"Đơn vị #{posting.BaseUnitId}")</td><td>@AdminStatusDisplay.DateTime(posting.CreatedAtUtc.ToLocalTime())</td></tr>
                        }
                        </tbody></table></div>
                    }
                </div>
            </section>

            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">Đơn đặt hàng liên kết</h2></div>
                <div class="ops-panel-body p-0">
                    @if (Model.PurchaseOrders.Count == 0) { <div class="p-3 ops-secondary">Chưa có đơn đặt hàng liên quan.</div> }
                    else
                    {
                        <div class="ops-table-scroll"><table class="ops-table" style="min-width:680px"><thead><tr><th>Đơn đặt hàng</th><th>Nhà cung cấp</th><th>Trạng thái đơn</th><th>Ngày đặt</th><th class="number">Giá trị</th><th></th></tr></thead><tbody>
                        @foreach (var order in Model.PurchaseOrders)
                        {
                            <tr>
                                <td><strong>@order.Code</strong></td>
                                <td>@order.SupplierName</td>
                                <td><span class="ops-badge @AdminStatusDisplay.PurchaseOrder(order.Status).CssClass">@AdminStatusDisplay.PurchaseOrder(order.Status).Label</span></td>
                                <td>@AdminStatusDisplay.DateTime(order.OrderDate.ToLocalTime())</td>
                                <td class="number">@AdminStatusDisplay.Currency(order.TotalAmount)</td>
                                <td><a class="ops-btn" asp-area="Admin" asp-controller="AdminPurchaseOrders" asp-action="Details" asp-route-id="@order.PurchaseOrderId">Xem đơn</a></td>
                            </tr>
                        }
                        </tbody></table></div>
                    }
                </div>
            </section>

            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">Sự cố nhà cung cấp</h2></div>
                <div class="ops-panel-body p-0">
                    @if (Model.SupplierIssues.Count == 0) { <div class="p-3 ops-secondary">Chưa có sự cố nhà cung cấp liên quan.</div> }
                    else
                    {
                        <div class="ops-table-scroll"><table class="ops-table" style="min-width:720px"><thead><tr><th>Nhà cung cấp</th><th>Sự cố</th><th>Trạng thái</th><th class="number">Ảnh hưởng</th><th>Chứng từ</th></tr></thead><tbody>
                        @foreach (var issue in Model.SupplierIssues)
                        {
                            <tr><td>@issue.SupplierName</td><td><strong>@AdminStatusDisplay.SupplierReceiptIssueType(issue.IssueType)</strong><div class="ops-secondary">@issue.Description</div></td><td><span class="ops-badge @AdminStatusDisplay.SupplierReceiptIssue(issue.Status).CssClass">@AdminStatusDisplay.SupplierReceiptIssue(issue.Status).Label</span></td><td class="number">@AdminStatusDisplay.Quantity(issue.AffectedBaseQuantity)</td><td><a asp-area="Admin" asp-controller="AdminSupplierQuality" asp-action="Index" asp-route-storeId="@issue.StoreId" asp-route-supplierId="@issue.SupplierId">@issue.BranchReceiptCode</a></td></tr>
                        }
                        </tbody></table></div>
                    }
                </div>
            </section>

            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">Chứng từ nhận hàng</h2></div>
                <div class="ops-panel-body p-0">
                    @if (Model.Receipts.Count == 0) { <div class="p-3 ops-secondary">Chưa có phiếu nhận liên quan.</div> }
                    else
                    {
                        <div class="ops-table-scroll"><table class="ops-table" style="min-width:620px"><thead><tr><th>Phiếu</th><th>Trạng thái</th><th class="number">Lượng nhận</th><th class="number">Giá trị</th><th></th></tr></thead><tbody>
                        @foreach (var receipt in Model.Receipts)
                        {
                            <tr><td><strong>@receipt.ReceiptCode</strong><div class="ops-secondary">@AdminStatusDisplay.DateTime(receipt.ReceivedAt.ToLocalTime())</div></td><td><span class="ops-badge @AdminStatusDisplay.BranchReceipt(receipt.Status).CssClass">@AdminStatusDisplay.BranchReceipt(receipt.Status).Label</span></td><td class="number">@AdminStatusDisplay.Quantity(receipt.TotalBaseQuantity)</td><td class="number">@AdminStatusDisplay.Currency(receipt.TotalLineCost)</td><td><a class="ops-btn" asp-area="Admin" asp-controller="AdminBranchReceipts" asp-action="Details" asp-route-id="@receipt.BranchReceiptId">Xem phiếu</a></td></tr>
                        }
                        </tbody></table></div>
                    }
                </div>
            </section>
        </div>

        <aside>
            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">Thao tác tiếp theo</h2></div>
                <div class="ops-panel-body">
                    @if (canWarehouse && Model.Status == "SUBMITTED")
                    {
                        <form method="post" asp-action="StartProcessing" asp-route-id="@Model.RestockRequestId" class="mb-3">@Html.AntiForgeryToken()<input type="hidden" name="rowVersion" value="@Model.RowVersion" /><button type="submit" class="ops-btn ops-btn-primary w-100"><i class="fa-solid fa-play" aria-hidden="true"></i> Tiếp nhận xử lý</button></form>
                    }
                    @if (canWarehouse && Model.Status == "SUBMITTED")
                    {
                        <form method="post" asp-action="Reject" asp-route-id="@Model.RestockRequestId" class="mb-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                            <label class="ops-form-label" for="rejectReason">Từ chối yêu cầu</label>
                            <textarea id="rejectReason" name="reason" class="ops-textarea" required placeholder="Lý do từ chối..."></textarea>
                            <button type="submit" class="ops-btn ops-btn-danger w-100 mt-2">Từ chối yêu cầu</button>
                        </form>
                    }
                    @if (canCancel && Model.Status is "DRAFT" or "SUBMITTED")
                    {
                        <form method="post" asp-action="Cancel" asp-route-id="@Model.RestockRequestId">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                            <label class="ops-form-label" for="cancelReason">Hủy yêu cầu</label>
                            <input id="cancelReason" name="reason" class="ops-input w-100" placeholder="Lý do hủy" />
                            <button type="submit" class="ops-btn w-100 mt-2">Hủy yêu cầu</button>
                        </form>
                    }
                    @if (canWarehouse
                        && Model.Status is ("PROCESSING" or "PARTIALLY_RECEIVED")
                        && (usesProcurement
                            ? Model.RemainingToReceiveProcurementQuantity.GetValueOrDefault() > 0
                            : Model.RemainingToReceiveQuantity > 0))
                    {
                        @if (string.Equals(Model.SourceType, RestockRequestSourceTypes.Legacy, StringComparison.OrdinalIgnoreCase)
                            || string.Equals(Model.SourcingDecision, RestockSourcingDecisionTypes.Purchase, StringComparison.OrdinalIgnoreCase))
                        {
                            <a class="ops-btn ops-btn-primary w-100 mb-2" asp-area="Admin" asp-controller="AdminPurchaseOrders" asp-action="Create" asp-route-restockRequestId="@Model.RestockRequestId"><i class="fa-solid fa-cart-flatbed" aria-hidden="true"></i> Tạo đơn đặt hàng cho phần còn lại</a>
                        }
                        <a class="ops-btn w-100 mb-3" asp-area="Admin" asp-controller="AdminInventoryTransfer" asp-action="Create" asp-route-restockRequestId="@Model.RestockRequestId" asp-route-toStoreId="@Model.StoreId"><i class="fa-solid fa-truck-ramp-box" aria-hidden="true"></i> Tạo điều chuyển phần còn lại</a>
                        <form method="post" asp-action="CloseRemaining" asp-route-id="@Model.RestockRequestId">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                            <label class="ops-form-label" for="closeRemainingReason">Đóng phần còn lại</label>
                            <textarea id="closeRemainingReason" name="reason" class="ops-textarea" required placeholder="Lý do không tiếp tục nhận phần còn lại..."></textarea>
                            <button type="submit" class="ops-btn w-100 mt-2">Đóng phần còn lại</button>
                        </form>
                    }
                    @if ((!canWarehouse || Model.Status is not ("SUBMITTED" or "PROCESSING" or "PARTIALLY_RECEIVED")) && !(canCancel && Model.Status is "DRAFT" or "SUBMITTED") && !(canSubmit && Model.Status == "DRAFT"))
                    {
                        <div class="ops-secondary">Không có thao tác chuyển trạng thái phù hợp ở bước hiện tại.</div>
                    }
                </div>
            </section>

            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">Nguồn thực hiện</h2></div>
                <div class="ops-panel-body">
                    @if (Model.Fulfillments.Count == 0) { <div class="ops-secondary">Chưa gắn nguồn thực hiện.</div> }
                    else
                    {
                        @foreach (var fulfillment in Model.Fulfillments)
                        {
                            <div class="ops-notice mb-2"><strong>@AdminStatusDisplay.RestockFulfillmentSource(fulfillment.SourceType)</strong> · @AdminStatusDisplay.RestockFulfillmentStatus(fulfillment.Status)<div class="ops-secondary">Dự kiến @AdminStatusDisplay.Quantity(fulfillment.PlannedBaseQuantity) · @AdminStatusDisplay.DateTime(fulfillment.CreatedAt.ToLocalTime())</div></div>
                        }
                    }
                    <div class="ops-help mt-3">Nguồn mua ngoài chỉ được ghi nhận khi có dòng đơn đặt hàng liên kết. Không dùng ghi chú thủ công để thay thế chứng từ mua.</div>
                </div>
            </section>
        </aside>
    </div>
</main>
