@model CafeChain.Models.Stores.Store
@{
    ViewData["Title"] = "Cập nhật cửa hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/Store/store-admin.css" asp-append-version="true" />
}

<div class="store-admin-page">
<div class="store-admin-header">
    <div>
        <span class="store-admin-kicker">Quản lý cửa hàng</span>
        <h1 class="store-admin-title">Cập nhật cửa hàng</h1>
        <p class="store-admin-subtitle">Chỉnh sửa thông tin chi nhánh và cập nhật vị trí GPS trên bản đồ.</p>
    </div>
    <a asp-action="Index" class="store-admin-btn store-admin-btn-ghost"><i class="fas fa-arrow-left"></i> Quay lại danh sách</a>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<style>
    #admin-map {
        height: 480px;
        width: 100%;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
    }
    /* Google-style Floating Action Button */
    .leaflet-control-locate {
        background: #fff;
        border: none;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        cursor: pointer;
        box-shadow: 0 1px 5px rgba(0,0,0,0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }
    .leaflet-control-locate:hover {
        background: #f4f4f4;
    }
    .leaflet-control-locate i {
        font-size: 1.3rem; 
        color: #f97316;
    }
    /* Red Dot Pulse Animation */
    .user-location-dot {
        width: 14px;
        height: 14px;
        background-color: #ff4d4d;
        border: 2px solid #fff;
        border-radius: 50%;
        box-shadow: 0 0 5px rgba(0,0,0,0.3);
    }
    .user-location-dot::after {
        content: "";
        position: absolute;
        top: -10px; left: -10px; right: -10px; bottom: -10px;
        border: 4px solid #ff4d4d;
        border-radius: 50%;
        animation: pulse 1.8s infinite;
        opacity: 0;
    }
    @@keyframes pulse {
        0% { transform: scale(0.5); opacity: 0; }
        50% { opacity: 0.4; }
        100% { transform: scale(1.5); opacity: 0; }
    }
</style>

<div class="store-admin-form-grid">
        <form asp-action="Edit" class="store-admin-card store-admin-form-card">
            <input type="hidden" asp-for="StoreId" />
            <input type="hidden" asp-for="CreatedAt" />
            <input type="hidden" id="Latitude" name="Latitude" value="@Model.Latitude" />
            <input type="hidden" id="Longitude" name="Longitude" value="@Model.Longitude" />

            <div class="form-group mb-3">
                <label asp-for="Name">Tên cửa hàng</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            
            <div class="row mb-3">
                <div class="col-4">
                    <label asp-for="ProvinceId">Tỉnh/TP</label>
                    <select asp-for="ProvinceId" id="ProvinceId" class="form-control" asp-items="ViewBag.Provinces" required>
                        <option value="">-- Tỉnh/TP --</option>
                    </select>
                </div>
                <div class="col-4">
                    <label asp-for="DistrictId">Quận/Huyện</label>
                    <select asp-for="DistrictId" id="DistrictId" class="form-control" required>
                        <option value="">-- Quận/Huyện --</option>
                    </select>
                </div>
                <div class="col-4">
                    <label asp-for="WardId">Phường/Xã</label>
                    <select asp-for="WardId" id="WardId" class="form-control" required>
                        <option value="">-- Phường/Xã --</option>
                    </select>
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Address">Địa chỉ chi tiết</label>
                <input asp-for="Address" id="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <button type="button" id="btnGeocode" class="store-admin-btn store-admin-btn-outline w-100 mb-3">
                <i class="fas fa-location-dot"></i>
                Tìm vị trí trên bản đồ
            </button>

            <div class="row mb-3">
                <div class="col-6">
                    <label title="Latitude">Vĩ độ</label>
                    <input id="DisplayLatitude" value="@Model.Latitude" class="form-control store-admin-readonly-control" readonly />
                </div>
                <div class="col-6">
                    <label title="Longitude">Kinh độ</label>
                    <input id="DisplayLongitude" value="@Model.Longitude" class="form-control store-admin-readonly-control" readonly />
                </div>
                <div class="col-12">
                    <small class="store-admin-readonly-help">
                        <i class="fas fa-lock"></i>
                        Tự động cập nhật theo vị trí ghim trên bản đồ.
                    </small>
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Phone">Điện thoại</label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="Active" class="form-check-input" type="checkbox" />
                <label class="form-check-label" asp-for="Active">Hoạt động</label>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="store-admin-btn store-admin-btn-primary">
                    <i class="fas fa-save"></i>
                    Lưu cửa hàng
                </button>
                <a asp-action="Index" class="store-admin-btn store-admin-btn-ghost">Quay lại</a>
            </div>
        </form>
    
    <section class="store-admin-card store-admin-map-card">
        <h5><i class="fas fa-map-location-dot text-warning"></i> Bản đồ cửa hàng</h5>
        <div class="store-admin-map-hint">
            Click hoặc kéo ghim trên bản đồ để chọn tọa độ chính xác.
        </div>
        <div id="admin-map"></div>
    </section>
</div>
</div>

<!-- Truyền sẵn Model values vào JS để load default dropdowns -->
<input type="hidden" id="SelectedProvinceId" value="@Model.ProvinceId" />
<input type="hidden" id="SelectedDistrictId" value="@Model.DistrictId" />
<input type="hidden" id="SelectedWardId" value="@Model.WardId" />

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        $(document).ready(function() {
            var selectedProvince = $('#SelectedProvinceId').val();
            var selectedDistrict = $('#SelectedDistrictId').val();
            var selectedWard = $('#SelectedWardId').val();

            // ===============================================
            // 1. UTILITY: FUZZY DROPDOWN SELECTION & PREFIX STRIPPING
            // ===============================================
            function cleanVNName(str) {
                if (!str) return "";
                var prefixes = ["Tỉnh ", "Thành phố ", "TP ", "Quận ", "Huyện ", "Thị xã ", "Phường ", "Xã ", "Thị trấn "];
                var cleaned = str;
                prefixes.forEach(p => {
                    if (cleaned.startsWith(p)) cleaned = cleaned.replace(p, "");
                });
                return cleaned.trim().toLowerCase();
            }

            function fuzzySelect($select, targetName) {
                if (!targetName) return null;
                var cleanedTarget = cleanVNName(targetName);
                var foundId = null;

                $select.find('option').each(function() {
                    var optionText = $(this).text();
                    var cleanedOption = cleanVNName(optionText);
                    
                    if (cleanedOption.includes(cleanedTarget) || cleanedTarget.includes(cleanedOption)) {
                        foundId = $(this).val();
                        return false; 
                    }
                });

                if (foundId) {
                    $select.val(foundId).trigger('change');
                }
                return foundId;
            }

            // ===============================================
            // 2. AJAX CASCADING DROPDOWNS (Promise-based)
            // ===============================================
            function apiLoadDistricts(provinceId, distIdToSelect) {
                var dfd = $.Deferred();
                var $district = $('#DistrictId');
                $district.empty().append('<option value="">-- Quận/Huyện --</option>').prop('disabled', false);

                $.get('/Customer/GetDistricts', { provinceId: provinceId }, function(data) {
                    $.each(data, function(index, item) {
                        var option = $('<option/>', { value: item.code, text: item.name });
                        if (distIdToSelect && item.code == distIdToSelect) option.prop('selected', true);
                        $district.append(option);
                    });
                    
                    if (distIdToSelect) {
                        apiLoadWards(distIdToSelect, selectedWard).then(() => dfd.resolve());
                    } else {
                        dfd.resolve();
                    }
                }).fail(() => dfd.reject());
                return dfd.promise();
            }

            function apiLoadWards(districtId, wardIdToSelect) {
                var dfd = $.Deferred();
                var $ward = $('#WardId');
                $ward.empty().append('<option value="">-- Phường/Xã --</option>').prop('disabled', false);

                $.get('/Customer/GetWards', { districtId: districtId }, function(data) {
                    $.each(data, function(index, item) {
                        var option = $('<option/>', { value: item.code, text: item.name });
                        if (wardIdToSelect && item.code == wardIdToSelect) option.prop('selected', true);
                        $ward.append(option);
                    });
                    dfd.resolve();
                }).fail(() => dfd.reject());
                return dfd.promise();
            }

            // Kích hoạt auto-load cho Edit (Dữ liệu ban đầu từ DB)
            if (selectedProvince) {
                apiLoadDistricts(selectedProvince, selectedDistrict);
            }

            // Events cho Admin thao tác tay
            $('#ProvinceId').change(function() {
                var pId = $(this).val();
                if (pId && !window._isMapAutoLoading) {
                    apiLoadDistricts(pId, null);
                } else if (!pId) {
                    $('#DistrictId').empty().append('<option value="">-- Quận/Huyện --</option>').prop('disabled', true);
                    $('#WardId').empty().append('<option value="">-- Phường/Xã --</option>').prop('disabled', true);
                }
            });

            $('#DistrictId').change(function() {
                var dId = $(this).val();
                if (dId && !window._isMapAutoLoading) {
                    apiLoadWards(dId, null);
                } else if (!dId) {
                    $('#WardId').empty().append('<option value="">-- Phường/Xã --</option>').prop('disabled', true);
                }
            });

            // ==========================================
            // 2. LEAFLET DIAGNOSTIC MAP & MODERN HYBRID LAYERS
            // ==========================================
            var currentLat = $('#Latitude').val();
            var currentLng = $('#Longitude').val();
            
            var lat = (currentLat && parseFloat(currentLat) != 0) ? parseFloat(currentLat) : 10.8231;
            var lng = (currentLng && parseFloat(currentLng) != 0) ? parseFloat(currentLng) : 106.6297;

            // Nâng cấp lớp bản đồ Google (2D & Vệ tinh) - Bypass API Key
            var googleStreets = L.tileLayer('http://mt0.google.com/vt/lyrs=m&hl=vi&x={x}&y={y}&z={z}', {
                maxZoom: 20,
                attribution: '&copy; Google Maps'
            });

            var googleSat = L.tileLayer('http://mt0.google.com/vt/lyrs=s&hl=vi&x={x}&y={y}&z={z}', {
                maxZoom: 20,
                attribution: '&copy; Google Maps Satellite'
            });

            var map = L.map('admin-map', {
                center: [lat, lng],
                zoom: 15,
                layers: [googleStreets] // Mặc định mở bản đồ 2D của Google
            });

            var baseMaps = {
                "🗺️ Bản đồ Đường xá (Google)": googleStreets,
                "🌍 Ảnh vệ tinh (Google)": googleSat
            };
            L.control.layers(baseMaps).addTo(map);

            var cafeIcon = L.icon({
                iconUrl: 'https://cdn-icons-png.flaticon.com/512/5695/5695648.png',
                iconSize: [45, 45],
                iconAnchor: [22, 45],
                popupAnchor: [0, -45]
            });

            var marker = L.marker([lat, lng], { icon: cafeIcon, draggable: true }).addTo(map);

            // ==========================================
            // 2.1 CUSTOM CONTROL: NÚT ĐỊNH VỊ (LOCATE)
            // ==========================================
            var userLocationMarker = null;

            L.Control.Locate = L.Control.extend({
                onAdd: function(map) {
                    var container = L.DomUtil.create('div', 'leaflet-bar leaflet-control');
                    var button = L.DomUtil.create('a', 'leaflet-control-locate', container);
                    button.innerHTML = '<i class="bi bi-crosshair"></i>';
                    button.title = "Định vị vị trí của tôi";

                    L.DomEvent.on(button, 'click', function(e) {
                        L.DomEvent.stopPropagation(e);
                        L.DomEvent.preventDefault(e);
                        
                        if (!navigator.geolocation) {
                            alert("Trình duyệt không hỗ trợ định vị.");
                            return;
                        }

                        $(button).html('<span class="spinner-border spinner-border-sm" role="status"></span>');
                        
                        navigator.geolocation.getCurrentPosition(function(pos) {
                            var lt = pos.coords.latitude;
                            var lg = pos.coords.longitude;

                            map.flyTo([lt, lg], 18);
                            
                            // Cắm 'Red Dot' chuẩn Google
                            var redDotIcon = L.divIcon({
                                className: 'user-location-dot-container',
                                html: '<div class="user-location-dot"></div>',
                                iconSize: [14, 14],
                                iconAnchor: [7, 7]
                            });

                            if (userLocationMarker) {
                                userLocationMarker.setLatLng([lt, lg]);
                            } else {
                                userLocationMarker = L.marker([lt, lg], { icon: redDotIcon }).addTo(map);
                            }

                            $(button).html('<i class="bi bi-crosshair"></i>');
                        }, function() {
                            alert("⚠️ Bạn chưa cấp quyền vị trí cho trình duyệt. Vui lòng bật trong cài đặt!");
                            $(button).html('<i class="bi bi-crosshair"></i>');
                        }, { enableHighAccuracy: true });
                    });

                    return container;
                }
            });

            new L.Control.Locate({ position: 'bottomright' }).addTo(map);

            // --- HÀM HELPER: REVERSE GEOCODING (Lấy địa chỉ & Tự động dropdown) ---
            function performReverseGeocoding(lat, lng) {
                var MAPBOX_TOKEN = 'pk.eyJ1Ijoibmd1eWVucGh1YzA1MDQiLCJhIjoiY21ubzF3bjJxMjBtOTJwcTJtZW9hOHhlcCJ9.0v8s3Xy-6HKnOrvz9pa48w';
                var url = `https://api.mapbox.com/geocoding/v5/mapbox.places/${lng},${lat}.json?access_token=${MAPBOX_TOKEN}&language=vi&limit=1`;

                $('#Address').val('... Đang quét vị trí ...').addClass('text-info');
                window._isMapAutoLoading = true; 

                $.ajax({
                    url: url,
                    type: 'GET',
                    success: function(data) {
                        if (data && data.features && data.features.length > 0) {
                            var feature = data.features[0];
                            
                            // 1. Cập nhật Địa chỉ chi tiết
                            var fullPlace = feature.place_name;
                            var shortAddress = fullPlace.split(',')[0].trim();
                            $('#Address').val(shortAddress).removeClass('text-info');

                            // 2. Phân tích context
                            var province = null, district = null, ward = null;
                            if (feature.context) {
                                feature.context.forEach(ctx => {
                                    if (ctx.id.startsWith('region')) province = ctx.text;
                                    if (ctx.id.startsWith('district') || ctx.id.startsWith('place')) district = ctx.text;
                                    if (ctx.id.startsWith('locality') || ctx.id.startsWith('neighborhood')) ward = ctx.text;
                                });
                            }

                            // 3. Chuỗi Promise automation
                            var pIdSelected = fuzzySelect($('#ProvinceId'), province);
                            if (pIdSelected) {
                                apiLoadDistricts(pIdSelected, null).then(function() {
                                    var dIdSelected = fuzzySelect($('#DistrictId'), district);
                                    if (dIdSelected) {
                                        apiLoadWards(dIdSelected, null).then(function() {
                                            fuzzySelect($('#WardId'), ward);
                                            window._isMapAutoLoading = false;
                                        });
                                    } else {
                                        window._isMapAutoLoading = false;
                                    }
                                });
                            } else {
                                window._isMapAutoLoading = false;
                            }
                        } else {
                            $('#Address').val('').removeClass('text-info');
                            window._isMapAutoLoading = false;
                        }
                    },
                    error: function() {
                        $('#Address').val('').removeClass('text-info');
                        window._isMapAutoLoading = false;
                    }
                });
            }

            marker.on('dragend', function(e) {
                var pos = marker.getLatLng();
                document.getElementById('Latitude').value = pos.lat;
                document.getElementById('Longitude').value = pos.lng;
                $('#DisplayLatitude').val(pos.lat.toFixed(6));
                $('#DisplayLongitude').val(pos.lng.toFixed(6));

                // Tự động lấy lại địa chỉ khi kéo thả xong
                performReverseGeocoding(pos.lat, pos.lng);
            });

            map.on('click', function(e) {
                marker.setLatLng(e.latlng);
                document.getElementById('Latitude').value = e.latlng.lat;
                document.getElementById('Longitude').value = e.latlng.lng;
                $('#DisplayLatitude').val(e.latlng.lat.toFixed(6));
                $('#DisplayLongitude').val(e.latlng.lng.toFixed(6));

                // Tự động lấy địa chỉ khi click
                performReverseGeocoding(e.latlng.lat, e.latlng.lng);
            });

            // ==========================================
            // 3. FULL SMART FALLBACK GEOCODING
            // ==========================================
            $('#btnGeocode').click(function() {
                var detail = $('#Address').val() || '';
                var wardName = $('#WardId option:selected').text();
                var districtName = $('#DistrictId option:selected').text();
                var provinceName = $('#ProvinceId option:selected').text();
                
                if (wardName.includes('--')) wardName = '';
                if (districtName.includes('--')) districtName = '';
                if (provinceName.includes('--')) provinceName = '';

                var fullAddress = [detail, wardName, districtName, provinceName].filter(Boolean).join(', ');
                var fallbackAddress = [wardName, districtName, provinceName].filter(Boolean).join(', ');
                
                if (!fallbackAddress) {
                    alert('Vui lòng nhập/chọn địa chỉ đầy đủ (Ít nhất Phường, Quận, Tỉnh) trước khi tìm kiếm!');
                    return;
                }

                var $btn = $(this);
                $btn.prop('disabled', true).text('Đang tìm kiếm...');

                function doGeocode(searchQuery) {
                    var MAPBOX_TOKEN = 'pk.eyJ1Ijoibmd1eWVucGh1YzA1MDQiLCJhIjoiY21ubzF3bjJxMjBtOTJwcTJtZW9hOHhlcCJ9.0v8s3Xy-6HKnOrvz9pa48w'; // Token chính thức từ bác Tech Lead
                    
                    var url = 'https://api.mapbox.com/geocoding/v5/mapbox.places/' + encodeURIComponent(searchQuery) + '.json?access_token=' + MAPBOX_TOKEN + '&country=vn&limit=1';

                    $.ajax({
                        url: url,
                        type: 'GET',
                        success: function(data) {
                            if (data && data.features && data.features.length > 0) {
                                var feature = data.features[0];
                                var lonFound = feature.center[0];
                                var latFound = feature.center[1];
                                
                                document.getElementById('Latitude').value = latFound;
                                document.getElementById('Longitude').value = lonFound;
                                $('#DisplayLatitude').val(latFound.toFixed(6));
                                $('#DisplayLongitude').val(lonFound.toFixed(6));
                                
                                map.flyTo([latFound, lonFound], 18, { duration: 1.5 });
                                setTimeout(function() {
                                    marker.setLatLng([latFound, lonFound]);
                                }, 1500);
                                
                                $btn.prop('disabled', false).html('📍 Tìm vị trí trên bản đồ');
                            } else {
                                alert('Mapbox không tìm thấy vị trí chính xác. Vui lòng di chuyển ghim thủ công!');
                                $btn.prop('disabled', false).html('📍 Tìm vị trí trên bản đồ');
                            }
                        },
                        error: function() {
                            alert('Lỗi kết nối tới Mapbox Geocoding.');
                            $btn.prop('disabled', false).html('📍 Tìm vị trí trên bản đồ');
                        }
                    });
                }
                
                doGeocode(fullAddress);
            });
        });
    </script>
}
