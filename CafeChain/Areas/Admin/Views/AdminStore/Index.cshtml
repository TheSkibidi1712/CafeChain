@model IReadOnlyList<CafeChain.ViewModels.Admin.Stores.AdminStoreIndexItemVM>
@using System.Security.Claims
@using CafeChain.Application.Constants
@using CafeChain.Application.Interfaces.Admin.Permissions
@inject IAdminPermissionService StorePermissionService
@{
    ViewData["Title"] = "Quản lý cửa hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var stores = Model?.ToList() ?? new List<CafeChain.ViewModels.Admin.Stores.AdminStoreIndexItemVM>();
    var accountId = int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var parsedAccountId)
        ? parsedAccountId : 0;
    var permissions = (await StorePermissionService.GetEffectivePermissionCodesAsync(accountId)).Data
        ?? new HashSet<string>(StringComparer.Ordinal);
    var canCreate = permissions.Contains(PermissionConstants.StoreCreate);
    var canUpdate = permissions.Contains(PermissionConstants.StoreUpdate);
    var canToggle = permissions.Contains(PermissionConstants.StoreToggleStatus);

    string FormatPhone(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone))
        {
            return "-";
        }

        var digits = new string(phone.Where(char.IsDigit).ToArray());

        return digits.Length == 10
            ? $"{digits[..4]} {digits.Substring(4, 3)} {digits.Substring(7)}"
            : phone;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />
    <link rel="stylesheet" href="~/css/Admin/Store/store-admin.css" asp-append-version="true" />
}

<main class="store-admin-page ops-shell cc-warehouse-page">
    <header class="store-admin-header ops-header cc-warehouse-header">
        <div>
            <div class="store-eyebrow">Nhân sự & vận hành</div>
            <h1>Quản lý cửa hàng</h1>
            <p class="store-subtitle">
                Theo dõi thông tin chi nhánh, trạng thái hoạt động và vị trí GPS của từng cửa hàng.
            </p>
        </div>
        <div class="store-header-actions">
            @if (canCreate)
            {
                <a asp-action="Create" class="store-admin-btn store-admin-btn-primary">
                    <i class="fas fa-plus"></i> Thêm cửa hàng mới
                </a>
            }
        </div>
    </header>

    <section class="store-admin-stat-grid">
        <div class="store-admin-card store-admin-stat">
            <div>
                <span>Tổng cửa hàng</span>
                <strong>@stores.Count</strong>
            </div>
            <div class="store-admin-stat-icon">
                <i class="fas fa-store"></i>
            </div>
        </div>

        <div class="store-admin-card store-admin-stat">
            <div>
                <span>Đang hoạt động</span>
                <strong>@stores.Count(x => x.Active)</strong>
            </div>
            <div class="store-admin-stat-icon">
                <i class="fas fa-circle-check"></i>
            </div>
        </div>

        <div class="store-admin-card store-admin-stat">
            <div>
                <span>Tạm ngưng</span>
                <strong>@stores.Count(x => !x.Active)</strong>
            </div>
            <div class="store-admin-stat-icon">
                <i class="fas fa-circle-pause"></i>
            </div>
        </div>
    </section>

    <section class="store-admin-card">
        <div class="store-admin-table-wrap">
            <table class="table table-hover align-middle store-admin-table" id="storesTable">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 56px;">#</th>
                        <th>Tên cửa hàng</th>
                        <th>Địa chỉ</th>
                        <th>Số điện thoại</th>
                        <th class="text-center">GPS</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (stores.Any())
                    {
                        var index = 1;
                        foreach (var item in stores)
                        {
                            <tr>
                                <td class="text-center fw-bold text-muted">@index</td>
                                <td>
                                    <div class="fw-bold">@item.Name</div>
                                    <div class="text-muted small">Tạo @item.CreatedAt.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td>
                                    <div style="max-width: 320px;">
                                        @item.Address
                                        @if (!string.IsNullOrWhiteSpace(item.WardName)
                                            && !string.IsNullOrWhiteSpace(item.ProvinceName))
                                        {
                                            <div class="text-muted small">@item.WardName, @item.ProvinceName</div>
                                        }
                                    </div>
                                </td>
                                <td>@FormatPhone(item.Phone)</td>
                                <td class="text-center">
                                    @if (item.Latitude != 0 && item.Longitude != 0)
                                    {
                                        <a href="https://www.openstreetmap.org/?mlat=@item.Latitude&mlon=@item.Longitude#map=18/@item.Latitude/@item.Longitude"
                                           target="_blank"
                                           class="store-admin-badge is-muted text-decoration-none"
                                           title="Xem trên OpenStreetMap"
                                           aria-label="Xem bản đồ cửa hàng @item.Name">
                                            <i class="fas fa-location-dot"></i>
                                            Xem bản đồ
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="store-admin-badge is-muted">
                                            <i class="fas fa-location-crosshairs"></i>
                                            Chưa có
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.Active)
                                    {
                                        <span class="store-admin-badge is-active">
                                            <i class="fas fa-circle-check"></i>
                                            Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="store-admin-badge is-inactive">
                                            <i class="fas fa-circle-xmark"></i>
                                            Tạm ngưng
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="store-admin-actions">
                                       @if (canUpdate)
                                       {
                                       <a asp-action="Edit"
                                           asp-route-id="@item.StoreId"
                                           class="store-admin-icon-btn"
                                           title="Chỉnh sửa cửa hàng"
                                           aria-label="Chỉnh sửa cửa hàng @item.Name">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                       }

                                       @if (canToggle)
                                       {
                                        <form asp-action="ToggleStatus" asp-route-id="@item.StoreId" method="post" class="d-inline">
                                            @if (item.Active)
                                            {
                                                <button type="submit"
                                                        class="store-admin-icon-btn"
                                                        onclick="return confirm('Bạn có chắc muốn tạm ngưng cửa hàng này?');"
                                                        title="Tạm ngưng cửa hàng"
                                                        aria-label="Tạm ngưng cửa hàng @item.Name">
                                                    <i class="fas fa-pause"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="store-admin-icon-btn"
                                                        onclick="return confirm('Bạn có chắc muốn mở hoạt động lại cửa hàng này?');"
                                                        title="Mở hoạt động cửa hàng"
                                                        aria-label="Mở hoạt động cửa hàng @item.Name">
                                                    <i class="fas fa-power-off"></i>
                                                </button>
                                            }
                                        </form>
                                       }
                                    </div>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="store-admin-empty">
                                <i class="fas fa-inbox me-2"></i>
                                Chưa có cửa hàng nào trong hệ thống.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</main>
