@model CafeChain.Application.DTOs.Admin.Staffs.ShiftOptimizationSetupDto
@{ ViewData["Title"] = "Tối ưu lịch làm việc"; }
<main class="container-fluid py-4" id="shiftOptimizationRoot"
      data-generate="@Url.Action("Generate")" data-apply="@Url.Action("Apply")"
      data-availability="@Url.Action("SaveAvailability")" data-constraint="@Url.Action("SaveConstraint")"
      data-requirement="@Url.Action("SaveRequirement")" data-timeoff="@Url.Action("SaveTimeOff")">
    <form id="shiftOptimizationToken" hidden>@Html.AntiForgeryToken()</form>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h1 class="h3 mb-1">Tối ưu lịch — @ViewBag.StoreName</h1><p class="text-muted mb-0">Heuristic chỉ tạo đề xuất; quản lý phải review trước khi áp dụng.</p></div>
        <a class="btn btn-outline-secondary" asp-controller="AdminStaffShift" asp-action="Index" asp-route-targetStoreId="@Model.StoreId">Quay lại lịch</a>
    </div>
    <ul class="nav nav-tabs">
        @foreach (var tab in new[] { ("availability","Khả dụng"), ("constraint","Giới hạn giờ"), ("requirement","Định mức"), ("timeoff","Nghỉ phép"), ("proposal","Đề xuất") })
        { <li class="nav-item"><button class="nav-link @(tab.Item1 == "availability" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#@tab.Item1" type="button">@tab.Item2</button></li> }
    </ul>
    <div class="tab-content border border-top-0 rounded-bottom p-3 bg-white">
        <section class="tab-pane fade show active" id="availability"><form data-kind="availability" class="row g-2">
            <div class="col-md-3"><select class="form-select" name="staffId">@foreach(var s in Model.Staffs){<option value="@s.Id">@s.Name</option>}</select></div>
            <div class="col-md-2"><select class="form-select" name="dayOfWeek">@foreach(DayOfWeek d in Enum.GetValues<DayOfWeek>()){<option value="@((int)d)">@d</option>}</select></div>
            <div class="col-md-2"><input class="form-control" type="time" name="startTime" required /></div><div class="col-md-2"><input class="form-control" type="time" name="endTime" required /></div>
            <div class="col-md-2"><input class="form-control" type="date" name="effectiveFrom" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div><div class="col-md-1"><button class="btn btn-primary">Lưu</button></div>
        </form></section>
        <section class="tab-pane fade" id="constraint"><form data-kind="constraint" class="row g-2"><div class="col-md-3"><select class="form-select" name="staffId">@foreach(var s in Model.Staffs){<option value="@s.Id">@s.Name</option>}</select></div><div class="col"><input class="form-control" type="number" name="targetWeeklyHours" value="40" /></div><div class="col"><input class="form-control" type="number" name="maxWeeklyHours" value="48" /></div><div class="col"><input class="form-control" type="number" name="maxDailyHours" value="8" /></div><div class="col"><input class="form-control" type="number" name="minimumRestMinutes" value="480" /></div><input type="hidden" name="effectiveFrom" value="@DateTime.Today.ToString("yyyy-MM-dd")" /><div class="col"><button class="btn btn-primary">Lưu</button></div></form></section>
        <section class="tab-pane fade" id="requirement"><form data-kind="requirement" class="row g-2"><input type="hidden" name="storeId" value="@Model.StoreId" /><div class="col-md-3"><select class="form-select" name="shiftId">@foreach(var s in Model.Shifts){<option value="@s.Id">@s.Name</option>}</select></div><div class="col-md-2"><select class="form-select" name="dayOfWeek">@foreach(DayOfWeek d in Enum.GetValues<DayOfWeek>()){<option value="@((int)d)">@d</option>}</select></div><div class="col"><input class="form-control" type="number" name="minimumStaff" value="1" /></div><div class="col"><input class="form-control" type="number" name="targetStaff" value="2" /></div><div class="col"><input class="form-control" type="number" name="maximumStaff" value="3" /></div><input type="hidden" name="effectiveFrom" value="@DateTime.Today.ToString("yyyy-MM-dd")" /><div class="col"><button class="btn btn-primary">Lưu</button></div></form></section>
        <section class="tab-pane fade" id="timeoff"><form data-kind="timeoff" class="row g-2"><div class="col-md-3"><select class="form-select" name="staffId">@foreach(var s in Model.Staffs){<option value="@s.Id">@s.Name</option>}</select></div><div class="col"><input class="form-control" type="datetime-local" name="fromUtc" required /></div><div class="col"><input class="form-control" type="datetime-local" name="toUtc" required /></div><div class="col"><input class="form-control" name="reason" placeholder="Lý do" required /></div><div class="col-auto"><button class="btn btn-primary">Lưu</button></div></form></section>
        <section class="tab-pane fade" id="proposal"><form data-kind="proposal" class="row g-2 mb-3"><input type="hidden" name="storeId" value="@Model.StoreId" /><div class="col"><input class="form-control" type="date" name="fromDate" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" /></div><div class="col"><input class="form-control" type="date" name="toDate" value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" /></div><div class="col-auto"><button class="btn btn-primary">Tạo đề xuất</button></div></form><div id="shiftProposalResult"></div></section>
    </div>
    <div id="shiftOptimizationNotice" class="alert mt-3" hidden></div>
</main>
@section Scripts { <script src="~/js/Admin/StaffShift/shift-optimization.js" asp-append-version="true"></script> }
