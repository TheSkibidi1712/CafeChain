@model CafeChain.ViewModels.Profile.MyProfileVM
@using CafeChain.Application.Constants.Cloudinaries
@using CafeChain.Application.Constants
@using Microsoft.Extensions.Localization
@using System.Text.Json
@inject IStringLocalizer<CafeChain.SharedResource> SharedText
@{
    ViewData["Title"] = SharedText["Profile.Title"];

    string statusText = Model.EmployeeStatus switch {
        1 => SharedText["Profile.Status.Probation"],
        2 => SharedText["Profile.Status.Official"],
        3 => SharedText["Profile.Status.Resigned"],
        _ => SharedText["Profile.Status.Unknown"]
    };
    string statusColor = Model.EmployeeStatus switch {
        1 => "#f59e0b",
        2 => "#22c55e",
        3 => "#ef4444",
        _ => "#94a3b8"
    };
    string genderText = Model.Gender switch {
        0 => SharedText["Profile.Gender.Female"],
        1 => SharedText["Profile.Gender.Male"],
        2 => SharedText["Profile.Gender.Other"],
        _ => "—"
    };
    string roleText = Model.RoleName switch {
        RoleConstants.BusinessOwner => SharedText["Role.BusinessOwner"],
        RoleConstants.AreaManager => SharedText["Role.AreaManager"],
        RoleConstants.StoreManager => SharedText["Role.StoreManager"],
        RoleConstants.ShiftSupervisor => SharedText["Role.ShiftSupervisor"],
        RoleConstants.SalesStaff => SharedText["Role.SalesStaff"],
        RoleConstants.AccountantWarehouse => SharedText["Role.AccountantWarehouse"],
        RoleConstants.SystemAdmin => SharedText["Role.SystemAdmin"],
        RoleConstants.Customer => SharedText["Role.Customer"],
        _ => Model.RoleName
    };
    var profileJsCatalog = JsonSerializer.Serialize(SharedText.GetAllStrings()
        .Where(message => message.Name.StartsWith("Profile.Js.", StringComparison.Ordinal))
        .ToDictionary(message => message.Name, message => message.Value));
}

@section Styles {
    <style>
        :root { --accent: var(--cc-primary, #70482f); --accent-light: var(--cc-brown-50, #faf6f2); }

        .profile-page { max-width: 900px; margin: 0 auto; }

        .profile-header {
            background: linear-gradient(135deg, var(--cc-primary, #70482f) 0%, var(--cc-primary-hover, #3d2418) 100%);
            border-radius: 16px;
            padding: 36px 32px;
            color: white;
            display: flex;
            align-items: center;
            gap: 28px;
            margin-bottom: 24px;
            box-shadow: 0 8px 32px rgba(112, 72, 47, 0.2);
        }
        .profile-header .avatar-wrap {
            position: relative;
            flex-shrink: 0;
        }
        .profile-header .avatar-wrap img {
            width: 100px;
            height: 100px;
            border-radius: 20px;
            object-fit: cover;
            border: 3px solid rgba(255,255,255,0.5);
            box-shadow: 0 4px 16px rgba(0,0,0,0.15);
        }
        .profile-header .avatar-wrap .btn-change-avatar {
            position: absolute;
            bottom: -4px;
            right: -4px;
            background: white;
            color: var(--accent);
            border: none;
            border-radius: 50%;
            width: 32px;
            height: 32px;
            font-size: 13px;
            cursor: pointer;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }
        .profile-header .avatar-wrap .btn-change-avatar:hover { transform: scale(1.1); }
        .profile-header .info h3 { margin: 0 0 4px; font-weight: 800; font-size: 22px; }
        .profile-header .info .role-badge {
            background: rgba(255,255,255,0.2);
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            display: inline-block;
        }

        .section-card {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.04);
            padding: 24px 28px;
            margin-bottom: 16px;
        }
        .section-title {
            font-weight: 700;
            font-size: 14px;
            color: #1e293b;
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .section-title i { color: var(--accent); }

        .field-row {
            display: flex;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid #f1f5f9;
        }
        .field-row:last-child { border-bottom: none; }
        .field-label {
            width: 180px;
            flex-shrink: 0;
            font-size: 13px;
            color: #64748b;
            font-weight: 500;
        }
        .field-value {
            flex: 1;
            font-size: 13px;
            color: #1e293b;
            font-weight: 600;
        }
        .field-value .badge-status {
            padding: 3px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            color: white;
        }

        .editable-field {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .editable-field input {
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 6px 12px;
            font-size: 13px;
            flex: 1;
            max-width: 250px;
            transition: border-color 0.2s;
        }
        .editable-field input:focus { border-color: var(--accent); outline: none; }

        .btn-accent {
            background: var(--accent);
            color: white;
            border: none;
            border-radius: 10px;
            padding: 8px 20px;
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-accent:hover { background: var(--cc-primary-hover, #3d2418); color: white; }

        .btn-outline-accent {
            background: var(--accent-light);
            color: var(--accent);
            border: 1px solid var(--accent);
            border-radius: 10px;
            padding: 8px 20px;
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-outline-accent:hover { background: var(--accent); color: white; }

        /* Modal */
        .modal-header.accent { background: var(--accent); color: white; border-radius: 14px 14px 0 0; border: none; }
        .modal-content { border-radius: 14px; border: none; box-shadow: 0 20px 60px rgba(0,0,0,0.15); }
    </style>
    <link rel="stylesheet" href="~/css/Admin/Profile/admin-profile.css" asp-append-version="true" />
}

<div class="profile-page admin-profile-page">
    <!-- ==================== HEADER ==================== -->
    <div class="profile-header">
        <div class="avatar-wrap">
            <img id="profileAvatar"
                 src="@(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? DefaultImages.StaffAvatarUrl : Model.AvatarUrl)"
                 onerror="this.onerror=null; this.src='@DefaultImages.StaffAvatarUrl';"
                 alt="@SharedText["Profile.AvatarAlt", Model.FullName]" />
            <button type="button" class="btn-change-avatar" onclick="document.getElementById('avatarInput').click();">
                <i class="fas fa-camera"></i>
            </button>
            <input type="file" id="avatarInput" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" style="display: none;" onchange="uploadAvatar(this)" />
        </div>
        <div class="info">
            <div class="profile-eyebrow"><i class="fas fa-user-shield"></i> @SharedText["Profile.Eyebrow"]</div>
            <h3>@Model.FullName</h3>
            <span class="role-badge"><i class="fas fa-shield-alt me-1"></i> @roleText</span>
            <p class="profile-summary">@SharedText["Profile.Summary"]</p>
        </div>
    </div>

    @Html.AntiForgeryToken()

    <!-- ==================== THÔNG TIN CÁ NHÂN (Read-only) ==================== -->
    <div class="section-card profile-personal">
        <div class="section-title"><i class="fas fa-id-card"></i> @SharedText["Profile.Personal"]</div>
        <div class="field-row">
            <div class="field-label">@SharedText["Profile.FullName"]</div>
            <div class="field-value">@Model.FullName</div>
        </div>
        <div class="field-row">
            <div class="field-label">Email</div>
            <div class="field-value">@Model.Email</div>
        </div>
        <div class="field-row">
            <div class="field-label">CCCD</div>
            <div class="field-value">@(Model.CCCD ?? "—")</div>
        </div>
        <div class="field-row">
            <div class="field-label">@SharedText["Profile.BirthDate"]</div>
            <div class="field-value">@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "—")</div>
        </div>
        <div class="field-row">
            <div class="field-label">@SharedText["Profile.Gender"]</div>
            <div class="field-value">@genderText</div>
        </div>
    </div>

    <!-- ==================== CÔNG VIỆC (Read-only) ==================== -->
    <div class="section-card profile-work">
        <div class="section-title"><i class="fas fa-briefcase"></i> @SharedText["Profile.Work"]</div>
        <div class="field-row">
            <div class="field-label">@SharedText["Profile.Role"]</div>
            <div class="field-value">@roleText</div>
        </div>
        <div class="field-row">
            <div class="field-label">@SharedText["Profile.Store"]</div>
            <div class="field-value">@Model.StoreName</div>
        </div>
        <div class="field-row">
            <div class="field-label">@SharedText["Profile.Status"]</div>
            <div class="field-value">
                <span class="badge-status" style="background: @statusColor;">@statusText</span>
            </div>
        </div>
        <div class="field-row">
            <div class="field-label">@SharedText["Profile.StartDate"]</div>
            <div class="field-value">@(Model.StartDate?.ToString("dd/MM/yyyy") ?? "—")</div>
        </div>
    </div>

    <!-- ==================== LIÊN HỆ (Editable) ==================== -->
    <div class="section-card profile-contact">
        <div class="section-title"><i class="fas fa-phone-alt"></i> @SharedText["Profile.Contact"]</div>
        <div class="field-row">
            <div class="field-label">@SharedText["Profile.Phone"]</div>
            <div class="field-value">
                <div class="editable-field">
                    <input type="tel" id="phoneInput" value="@Model.PhoneNumber" placeholder="@SharedText["Profile.PhonePlaceholder"]" maxlength="10" />
                    <button class="btn-accent" onclick="updatePhone()"><i class="fas fa-save me-1"></i> @SharedText["Profile.Save"]</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== BẢO MẬT ==================== -->
    <div class="section-card profile-security">
        <div class="section-title"><i class="fas fa-lock"></i> @SharedText["Profile.Security"]</div>
        <div class="field-row">
            <div class="field-label">@SharedText["Profile.Password"]</div>
            <div class="field-value">
                <button class="btn-outline-accent" data-bs-toggle="modal" data-bs-target="#changePasswordModal">
                    <i class="fas fa-key me-1"></i> @SharedText["Profile.ChangePassword"]
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== CHANGE PASSWORD MODAL ==================== -->
<div class="modal fade" id="changePasswordModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header accent">
                <h5 class="modal-title"><i class="fas fa-key me-2"></i> @SharedText["Profile.ChangePassword"]</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-bold" style="font-size: 13px;">@SharedText["Profile.CurrentPassword"]</label>
                    <input type="password" id="oldPassword" class="form-control" style="border-radius: 10px;" placeholder="@SharedText["Profile.CurrentPasswordPlaceholder"]" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold" style="font-size: 13px;">@SharedText["Profile.NewPassword"]</label>
                    <input type="password" id="newPassword" class="form-control" style="border-radius: 10px;" placeholder="@SharedText["Profile.NewPasswordPlaceholder"]" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold" style="font-size: 13px;">@SharedText["Profile.ConfirmPassword"]</label>
                    <input type="password" id="confirmNewPassword" class="form-control" style="border-radius: 10px;" placeholder="@SharedText["Profile.ConfirmPasswordPlaceholder"]" />
                </div>
            </div>
            <div class="modal-footer border-0 d-flex justify-content-between px-4 pb-4">
                <button type="button" class="btn btn-light px-4" style="border-radius: 10px;" data-bs-dismiss="modal">@SharedText["Common.Cancel"]</button>
                <button type="button" class="btn px-4" style="background: var(--accent); color: white; border-radius: 10px; font-weight: 600;" onclick="changePassword()">
                    <i class="fas fa-check me-1"></i> @SharedText["Profile.ConfirmChange"]
                </button>
            </div>
        </div>
    </div>
</div>

<!-- SweetAlert2 CDN -->
@section Scripts {
    <script id="profileUiCatalog" type="application/json">@Html.Raw(profileJsCatalog)</script>
    <script>
        const profileCatalog = window.CafeChainUiCatalog?.read('profileUiCatalog') ?? {};
        const profileText = key => window.CafeChainUiCatalog?.text(profileCatalog, key) ?? profileCatalog[key] ?? key;
        const updateProfileUrl = '@Url.Action("UpdateMyProfile", "AdminProfile", new { area = "Admin" })';
        const changePasswordUrl = '@Url.Action("ChangePassword", "AdminProfile", new { area = "Admin" })';

        function getToken() {
            return $("input[name='__RequestVerificationToken']").val();
        }

        // ===== Upload Avatar =====
        function uploadAvatar(input) {
            if (!input.files || !input.files[0]) return;

            const file = input.files[0];
            const allowedTypes = ['image/jpeg', 'image/png', 'image/webp'];
            if (!allowedTypes.includes(file.type)) {
                input.value = '';
                Swal.fire({ icon: 'warning', title: profileText('Profile.Js.Invalid'), text: profileText('Profile.Js.ImageType') });
                return;
            }
            if (file.size > 2 * 1024 * 1024) {
                input.value = '';
                Swal.fire({ icon: 'warning', title: profileText('Profile.Js.ImageLarge'), text: profileText('Profile.Js.ImageSize') });
                return;
            }

            var formData = new FormData();
            formData.append('AvatarFile', file);

            $.ajax({
                url: updateProfileUrl,
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                headers: { "RequestVerificationToken": getToken() },
                success: function (res) {
                    if (res.success) {
                        var avatarUrl = res.avatarUrl || '@DefaultImages.StaffAvatarUrl';
                        $('#profileAvatar, #adminTopbarAvatar').attr('src', avatarUrl);
                        Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: res.message, showConfirmButton: false, timer: 2000 });
                    } else {
                        Swal.fire({ icon: 'error', title: profileText('Profile.Js.Error'), text: res.message });
                    }
                },
                error: function () {
                    Swal.fire({ icon: 'error', title: profileText('Profile.Js.Error'), text: profileText('Profile.Js.AvatarError') });
                },
                complete: function () {
                    input.value = '';
                }
            });
        }

        // ===== Update Phone =====
        function updatePhone() {
            var phone = $('#phoneInput').val().trim();
            if (!phone) {
                Swal.fire({ icon: 'warning', title: profileText('Profile.Js.Missing'), text: profileText('Profile.Js.PhoneRequired') });
                return;
            }
            // Validate format: 0[3-9]xxxxxxxx
            if (!/^(0[3-9])\d{8}$/.test(phone)) {
                Swal.fire({ icon: 'warning', title: profileText('Profile.Js.Invalid'), text: profileText('Profile.Js.PhoneInvalid') });
                return;
            }

            $.ajax({
                url: updateProfileUrl,
                type: 'POST',
                data: { PhoneNumber: phone },
                headers: { "RequestVerificationToken": getToken() },
                success: function (res) {
                    if (res.success) {
                        Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: res.message, showConfirmButton: false, timer: 2000 });
                    } else {
                        Swal.fire({ icon: 'error', title: profileText('Profile.Js.Error'), text: res.message });
                    }
                },
                error: function () {
                    Swal.fire({ icon: 'error', title: profileText('Profile.Js.Error'), text: profileText('Profile.Js.PhoneError') });
                }
            });
        }

        // ===== Change Password =====
        function changePassword() {
            var oldPw = $('#oldPassword').val();
            var newPw = $('#newPassword').val();
            var confirmPw = $('#confirmNewPassword').val();

            if (!oldPw || !newPw || !confirmPw) {
                Swal.fire({ icon: 'warning', title: profileText('Profile.Js.Missing'), text: profileText('Profile.Js.FieldsRequired') });
                return;
            }
            if (newPw.length < 6) {
                Swal.fire({ icon: 'warning', title: profileText('Profile.Js.Invalid'), text: profileText('Profile.Js.PasswordLength') });
                return;
            }
            if (newPw !== confirmPw) {
                Swal.fire({ icon: 'warning', title: profileText('Profile.Js.Mismatch'), text: profileText('Profile.Js.PasswordMismatch') });
                return;
            }

            $.ajax({
                url: changePasswordUrl,
                type: 'POST',
                data: { OldPassword: oldPw, NewPassword: newPw, ConfirmNewPassword: confirmPw },
                headers: { "RequestVerificationToken": getToken() },
                success: function (res) {
                    if (res.success) {
                        $('#changePasswordModal').modal('hide');
                        $('#oldPassword, #newPassword, #confirmNewPassword').val('');
                        Swal.fire({ icon: 'success', title: profileText('Profile.Js.Success'), text: res.message });
                    } else {
                        Swal.fire({ icon: 'error', title: profileText('Profile.Js.Error'), text: res.message });
                    }
                },
                error: function () {
                    Swal.fire({ icon: 'error', title: profileText('Profile.Js.SystemError'), text: profileText('Profile.Js.PasswordError') });
                }
            });
        }
    </script>
}
