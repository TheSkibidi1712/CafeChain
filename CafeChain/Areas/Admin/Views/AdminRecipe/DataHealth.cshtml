@model CafeChain.ViewModels.Admin.Recipes.BomDataHealthPageVM
@{
    ViewData["Title"] = "Tình trạng dữ liệu BOM";
}

<link rel="stylesheet" href="~/css/recipe-builder.css" asp-append-version="true" />

<div class="rb-page">
    <div class="container-fluid px-4 pt-4 pb-5">
        <div class="rb-page-header bom-depth-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div class="admin-module-heading-copy">
                <nav class="rb-breadcrumb" aria-label="breadcrumb">
                    <a asp-action="Index" class="btn-rb-back">Công thức BOM</a> &gt; <span>Tình trạng dữ liệu BOM</span>
                </nav>
                <div class="admin-module-title-row">
                    <span class="admin-module-title-icon" aria-hidden="true"><i class="fas fa-clipboard-check"></i></span>
                    <div>
                        <h1 class="rb-page-title mb-1">Tình trạng dữ liệu BOM</h1>
                        <p class="text-muted mb-0">
                            Kiểm tra cấu hình công thức và dữ liệu giá vốn toàn hệ thống. Trạng thái cửa hàng được đánh giá riêng.
                        </p>
                    </div>
                </div>
            </div>
            <div class="admin-module-header-actions">
                <a asp-action="Index" class="btn btn-rb-save">
                    <i class="fas fa-list" aria-hidden="true"></i>Danh sách công thức
                </a>
            </div>
        </div>

        <section class="rb-health-summary mb-4" aria-label="Tổng hợp tình trạng dữ liệu BOM">
            <div class="rb-health-metric rb-health-ok">
                <div class="rb-health-metric-icon">
                    <i class="fas fa-circle-check" aria-hidden="true"></i>
                </div>
                <div class="rb-health-metric-info">
                    <span class="rb-health-metric-label">Hoàn chỉnh</span>
                    <strong class="rb-health-metric-value">@Model.CompleteCount</strong>
                </div>
            </div>
            <div class="rb-health-metric rb-health-warning">
                <div class="rb-health-metric-icon">
                    <i class="fas fa-tags" aria-hidden="true"></i>
                </div>
                <div class="rb-health-metric-info">
                    <span class="rb-health-metric-label">Thiếu giá</span>
                    <strong class="rb-health-metric-value">@Model.MissingQuoteCount</strong>
                </div>
            </div>
            <div class="rb-health-metric rb-health-info">
                <div class="rb-health-metric-icon">
                    <i class="fas fa-calculator" aria-hidden="true"></i>
                </div>
                <div class="rb-health-metric-info">
                    <span class="rb-health-metric-label">Thiếu quy đổi</span>
                    <strong class="rb-health-metric-value">@Model.MissingConversionCount</strong>
                </div>
            </div>
            <div class="rb-health-metric rb-health-yield">
                <div class="rb-health-metric-icon">
                    <i class="fas fa-boxes-stacked" aria-hidden="true"></i>
                </div>
                <div class="rb-health-metric-info">
                    <span class="rb-health-metric-label">Thiếu đầu ra</span>
                    <strong class="rb-health-metric-value">@Model.MissingOutputCount</strong>
                </div>
            </div>
            <div class="rb-health-metric rb-health-danger">
                <div class="rb-health-metric-icon">
                    <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
                </div>
                <div class="rb-health-metric-info">
                    <span class="rb-health-metric-label">Liên kết lỗi</span>
                    <strong class="rb-health-metric-value">@Model.MappingErrorCount</strong>
                </div>
            </div>
        </section>

        <div class="rb-card rb-health-table-wrap">
            <div class="table-responsive">
                <table class="table rb-table rb-health-table mb-0" aria-label="Chi tiết tình trạng dữ liệu BOM">
                    <thead>
                        <tr>
                            <th>Công thức</th>
                            <th>Cấu hình</th>
                            <th>Dữ liệu giá vốn</th>
                            <th>Lý do và xử lý</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                Chưa có công thức để đánh giá.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var row in Model.Items)
                        {
                            var configClass = row.Configuration.IsComplete
                                ? "rb-status-complete"
                                : row.Configuration.Code == "INACTIVE" ? "rb-status-inactive" : "rb-status-incomplete";
                            var costClass = row.Costing.IsComplete ? "rb-status-complete" : "rb-status-error";
                            var reasons = row.Configuration.Reasons.Concat(row.Costing.Reasons).ToList();
                            <tr>
                                <td class="rb-health-identity">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="rb-status-badge rb-status-inactive">@row.TypeLabel</span>
                                        <span class="font-monospace text-muted">#@row.RecipeId</span>
                                    </div>
                                    <div class="fw-semibold text-break">@row.IdentityDisplay</div>
                                    @if (!string.IsNullOrWhiteSpace(row.RecipeCode))
                                    {
                                        <div class="small text-muted font-monospace text-break">@row.RecipeCode</div>
                                    }
                                </td>
                                <td>
                                    <span class="rb-status-badge @configClass">@row.Configuration.Label</span>
                                </td>
                                <td>
                                    <span class="rb-status-badge @costClass">@row.Costing.Label</span>
                                    @if (row.Costing.IsComplete && row.EstimatedCost.HasValue)
                                    {
                                        <div class="small text-muted font-monospace mt-1">@row.EstimatedCost.Value.ToString("N0") VND</div>
                                    }
                                </td>
                                <td class="rb-health-reasons">
                                    @if (reasons.Count == 0)
                                    {
                                        <span class="text-muted">Không có lỗi dữ liệu.</span>
                                    }
                                    else
                                    {
                                        foreach (var reason in reasons)
                                        {
                                            <div class="rb-health-reason">
                                                <div>
                                                    <code>@(reason.Code == "INACTIVE" ? "NGỪNG HOẠT ĐỘNG" : reason.Code)</code>
                                                    <span>@reason.Message</span>
                                                </div>
                                            </div>
                                        }
                                    }
                                </td>
                                <td class="rb-health-actions">
                                    @if (reasons.Count == 0)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                        <div class="dropdown rb-health-action-menu">
                                            <button class="btn rb-health-action-trigger dropdown-toggle" type="button"
                                                    data-bs-toggle="dropdown" aria-expanded="false"
                                                    aria-label="Mở @reasons.Count phương án xử lý">
                                                <i class="fas fa-screwdriver-wrench" aria-hidden="true"></i>
                                                <span>Xử lý</span>
                                                <span class="rb-health-action-count">@reasons.Count</span>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                @foreach (var reason in reasons)
                                                {
                                                    var ctaUrl = reason.CtaId.HasValue
                                                        ? Url.Action(reason.CtaAction, reason.CtaController, new { id = reason.CtaId.Value })
                                                        : Url.Action(reason.CtaAction, reason.CtaController);
                                                    <li>
                                                        <a class="dropdown-item rb-health-action-item" href="@ctaUrl">
                                                            <span class="rb-health-action-item-icon"><i class="fas fa-pen" aria-hidden="true"></i></span>
                                                            <span class="rb-health-action-copy">
                                                                <strong>@reason.CtaLabel</strong>
                                                                <small>@(reason.Code == "INACTIVE" ? "NGỪNG HOẠT ĐỘNG" : reason.Code)</small>
                                                            </span>
                                                            <i class="fas fa-chevron-right rb-health-action-arrow" aria-hidden="true"></i>
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
