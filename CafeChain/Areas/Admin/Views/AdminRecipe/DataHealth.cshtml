@model CafeChain.ViewModels.Admin.Recipes.BomDataHealthPageVM
@using CafeChain.ViewModels.Admin.Shared
@using CafeChain.ViewModels.Admin.Recipes
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<CafeChain.ProductResource> ProductText
@{
    ViewData["Title"] = ProductText["Recipe.Health.PageTitle"];
    var hero = new AdminPageHeroVM
    {
        Eyebrow = ProductText["Recipe.Eyebrow"],
        Title = ProductText["Recipe.Health.PageTitle"],
        Description = ProductText["Recipe.Health.Description"],
        IconClass = "fas fa-clipboard-check",
        Breadcrumbs =
        [
            new() { Label = ProductText["Recipe.Index.Title"], Url = Url.Action("Index") },
            new() { Label = ProductText["Recipe.Health.Breadcrumb"] }
        ],
        Actions =
        [
            new() { Label = ProductText["Recipe.Health.Back"], Url = Url.Action("Index") ?? "#", IconClass = "fas fa-arrow-left" }
        ]
    };
    string HealthLabel(string code, string fallback) => ProductText[$"Recipe.Health.{code}"].ResourceNotFound
        ? fallback
        : ProductText[$"Recipe.Health.{code}"];
    string CurrentMessage(string code, string fallback) => ProductText[$"Recipe.Health.Current.{code}.Message"].ResourceNotFound
        ? fallback
        : ProductText[$"Recipe.Health.Current.{code}.Message"];
    string ReasonMessage(BomHealthReasonVM reason)
    {
        var exact = ProductText[$"Recipe.Health.Reason.{reason.Code}"];
        if (!exact.ResourceNotFound) return exact;
        var grouped = ProductText[$"Recipe.Health.ReasonGroup.{reason.GroupCode}"];
        return grouped.ResourceNotFound ? reason.Message : grouped;
    }
    string ReasonAction(BomHealthReasonVM reason) => ProductText[$"Recipe.Health.Action.{reason.GroupCode}"].ResourceNotFound
        ? ProductText["Recipe.Health.Resolve"]
        : ProductText[$"Recipe.Health.Action.{reason.GroupCode}"];
}

<link rel="stylesheet" href="~/css/recipe-builder.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Admin/production-bom-ui.css" asp-append-version="true" />

<div class="rb-page production-bom-page production-bom-shell bom-health-page">
    <div class="container-fluid px-0">
        <partial name="_PageHero" model="hero" />

        <section class="bom-health-intro" aria-labelledby="health-intro-title">
            <span class="bom-health-intro__icon"><i class="fas fa-circle-info" aria-hidden="true"></i></span>
            <div>
                <h2 id="health-intro-title">@ProductText["Recipe.Health.IntroTitle"]</h2>
                <p>@ProductText["Recipe.Health.IntroHint"]</p>
            </div>
            <strong>@ProductText["Recipe.Health.TotalFiltered", Model.TotalCount]</strong>
        </section>

        <form method="get" class="rb-list-filters production-filter-card mb-3" role="search">
            <label class="visually-hidden" for="healthSearch">@ProductText["Recipe.Health.SearchLabel"]</label>
            <input id="healthSearch"
                   class="form-control"
                   type="search"
                   name="search"
                   value="@Model.Search"
                   placeholder="@ProductText["Recipe.Health.SearchPlaceholder"]" />
            <label class="visually-hidden" for="healthType">@ProductText["Recipe.Health.TypeLabel"]</label>
            <select id="healthType" class="form-select" name="typeFilter">
                <option value="ALL" selected="@(Model.TypeFilter == "ALL" ? "selected" : null)">@ProductText["Recipe.Health.AllTypes"]</option>
                <option value="POS" selected="@(Model.TypeFilter == "POS" ? "selected" : null)">@ProductText["Recipe.Type.Pos"]</option>
                <option value="TOPPING" selected="@(Model.TypeFilter == "TOPPING" ? "selected" : null)">Topping</option>
                <option value="SUBRECIPE" selected="@(Model.TypeFilter == "SUBRECIPE" ? "selected" : null)">@ProductText["Recipe.Type.Subrecipe"]</option>
            </select>
            <label class="visually-hidden" for="healthPageSize">@ProductText["Recipe.Health.PageSizeLabel"]</label>
            <select id="healthPageSize" class="form-select" name="pageSize">
                <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">@ProductText["Recipe.Health.Rows", 10]</option>
                <option value="20" selected="@(Model.PageSize == 20 ? "selected" : null)">@ProductText["Recipe.Health.Rows", 20]</option>
                <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">@ProductText["Recipe.Health.Rows", 50]</option>
            </select>
            <button class="btn btn-rb-save" type="submit">
                <i class="fas fa-search me-2" aria-hidden="true"></i>@ProductText["Common.Filter"]
            </button>
            <a class="btn btn-rb-ghost production-filter-reset"
               asp-action="DataHealth"
               aria-label="@ProductText["Common.ResetFilters"]"
               title="@ProductText["Common.ResetFilters"]">
                <i class="fas fa-rotate-left" aria-hidden="true"></i>
            </a>
        </form>

        <section class="rb-health-summary bom-health-summary mb-3" aria-label="@ProductText["Recipe.Health.SummaryAria"]">
            <div class="rb-health-metric rb-health-ok">
                <span>@ProductText["Recipe.Health.CompleteMetric"]</span>
                <strong>@Model.CompleteCount</strong>
            </div>
            <div class="rb-health-metric">
                <span>@ProductText["Recipe.Health.MissingQuoteMetric"]</span>
                <strong>@Model.MissingQuoteCount</strong>
            </div>
            <div class="rb-health-metric">
                <span>@ProductText["Recipe.Health.MissingConversionMetric"]</span>
                <strong>@Model.MissingConversionCount</strong>
            </div>
            <div class="rb-health-metric">
                <span>@ProductText["Recipe.Health.MissingOutputMetric"]</span>
                <strong>@Model.MissingOutputCount</strong>
            </div>
            <div class="rb-health-metric">
                <span>@ProductText["Recipe.Health.VersionIssueMetric"]</span>
                <strong>@Model.CurrentRecipeIssueCount</strong>
            </div>
            <div class="rb-health-metric">
                <span>@ProductText["Recipe.Health.MappingErrorMetric"]</span>
                <strong>@Model.MappingErrorCount</strong>
            </div>
        </section>

        <div class="rb-card rb-health-table-wrap bom-health-list">
            <header class="bom-section-heading">
                <div>
                    <span class="bom-section-heading__icon"><i class="fas fa-list-check" aria-hidden="true"></i></span>
                    <div><h2>@ProductText["Recipe.Health.DetailTitle"]</h2><p>@ProductText["Recipe.Health.DetailHint"]</p></div>
                </div>
                <span class="bom-list-count">@ProductText["Recipe.Health.ListCount", Model.CurrentPageCount, Model.TotalCount]</span>
            </header>
            <div class="table-responsive">
                <table class="table rb-table rb-health-table production-data-table mb-0" aria-label="@ProductText["Recipe.Health.DetailAria"]">
                    <thead>
                        <tr>
                            <th>@ProductText["Recipe.Health.Column.Recipe"]</th>
                            <th>@ProductText["Recipe.Health.Column.Version"]</th>
                            <th>@ProductText["Recipe.Health.Column.Configuration"]</th>
                            <th>@ProductText["Recipe.Health.Column.Costing"]</th>
                            <th>@ProductText["Recipe.Health.Column.Reason"]</th>
                            <th>@ProductText["Common.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                @ProductText["Recipe.Health.Empty"]
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var row in Model.Items)
                        {
                            var configClass = row.Configuration.IsComplete
                                ? "rb-status-complete"
                                : row.Configuration.Code == "INACTIVE" ? "rb-status-inactive" : "rb-status-incomplete";
                            var currentClass = row.CurrentRecipe.IsBlocking
                                ? "rb-status-incomplete"
                                : row.CurrentRecipe.Code == BomCurrentRecipeHealthCodes.Current
                                    ? "rb-status-complete"
                                    : "rb-status-inactive";
                            var costClass = row.Costing.IsComplete ? "rb-status-complete" : "rb-status-error";
                            var reasons = row.Configuration.Reasons.Concat(row.Costing.Reasons).ToList();
                            var hasIssues = row.CurrentRecipe.IsBlocking || reasons.Count > 0;
                            <tr>
                                <td class="rb-health-identity">
                                    <span class="bom-row-kicker">@HealthLabel($"TYPE_{row.TypeCode}", row.TypeLabel)</span>
                                    <div class="fw-semibold text-break">@row.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(row.RecipeCode))
                                    {
                                        <div class="small text-muted font-monospace text-break">@row.RecipeCode</div>
                                    }
                                </td>
                                <td>
                                    <span class="rb-status-badge @currentClass">@HealthLabel(row.CurrentRecipe.Code, row.CurrentRecipe.Label)</span>
                                    <div class="small text-muted mt-1">@CurrentMessage(row.CurrentRecipe.Code, row.CurrentRecipe.Message)</div>
                                </td>
                                <td>
                                    <span class="rb-status-badge @configClass">@HealthLabel(row.Configuration.Code, row.Configuration.Label)</span>
                                </td>
                                <td>
                                    <span class="rb-status-badge @costClass">@HealthLabel(row.Costing.Code, row.Costing.Label)</span>
                                    @if (row.Costing.IsComplete && row.EstimatedCost.HasValue)
                                    {
                                        <div class="small text-muted font-monospace mt-1">@row.EstimatedCost.Value.ToString("N0") ₫</div>
                                    }
                                </td>
                                <td class="rb-health-reasons">
                                    @if (!hasIssues)
                                    {
                                        <span class="bom-health-clear"><i class="fas fa-check" aria-hidden="true"></i> @ProductText["Recipe.Health.NoIssues"]</span>
                                    }
                                    else
                                    {
                                        <ul class="bom-health-reason-list">
                                            @if (row.CurrentRecipe.IsBlocking)
                                            {
                                                <li>@CurrentMessage(row.CurrentRecipe.Code, row.CurrentRecipe.Message)</li>
                                            }
                                            @foreach (var reason in reasons)
                                            {
                                                <li>@ReasonMessage(reason)</li>
                                            }
                                        </ul>
                                    }
                                </td>
                                <td class="rb-health-actions">
                                    @if (reasons.Count == 0)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                        <div class="dropdown rb-health-action-menu">
                                            <button class="btn rb-health-action-trigger dropdown-toggle" type="button"
                                                    data-bs-toggle="dropdown" aria-expanded="false"
                                                    aria-label="@ProductText["Recipe.Health.OpenActionsAria", reasons.Count]">
                                                <i class="fas fa-screwdriver-wrench" aria-hidden="true"></i>
                                                <span>@ProductText["Recipe.Health.Resolve"]</span>
                                                <span class="rb-health-action-count">@reasons.Count</span>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                @foreach (var reason in reasons)
                                                {
                                                    var ctaUrl = reason.CtaId.HasValue
                                                        ? Url.Action(reason.CtaAction, reason.CtaController, new { id = reason.CtaId.Value })
                                                        : Url.Action(reason.CtaAction, reason.CtaController);
                                                    <li>
                                                        <a class="dropdown-item rb-health-action-item" href="@ctaUrl">
                                                            <span class="rb-health-action-item-icon"><i class="fas fa-pen" aria-hidden="true"></i></span>
                                                            <span class="rb-health-action-copy">
                                                                <strong>@ReasonAction(reason)</strong>
                                                                <small>@ProductText["Recipe.Health.GoToRelated"]</small>
                                                            </span>
                                                            <i class="fas fa-chevron-right rb-health-action-arrow" aria-hidden="true"></i>
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model.TotalPages > 1)
        {
            <nav class="production-pagination mt-3" aria-label="@ProductText["Recipe.Health.PaginationAria"]">
                <span class="production-pagination__summary">@ProductText["Common.PageSummary", Model.Page, Model.TotalPages]</span>
                <div class="production-pagination__links">
                    @if (Model.Page > 1)
                    {
                        <a class="production-page-link is-nav" asp-action="DataHealth"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-search="@Model.Search"
                           asp-route-typeFilter="@Model.TypeFilter"><i class="fas fa-arrow-left" aria-hidden="true"></i> @ProductText["Common.PreviousPage"]</a>
                    }
                    @if (Model.Page < Model.TotalPages)
                    {
                        <a class="production-page-link is-nav" asp-action="DataHealth"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-search="@Model.Search"
                           asp-route-typeFilter="@Model.TypeFilter">@ProductText["Common.NextPage"] <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                    }
                </div>
            </nav>
        }
    </div>
</div>
