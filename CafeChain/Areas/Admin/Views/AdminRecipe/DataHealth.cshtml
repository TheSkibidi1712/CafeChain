@model CafeChain.ViewModels.Admin.Recipes.BomDataHealthPageVM
@using CafeChain.ViewModels.Admin.Shared
@using CafeChain.ViewModels.Admin.Recipes
@{
    ViewData["Title"] = "Tình trạng dữ liệu BOM";
    var hero = new AdminPageHeroVM
    {
        Eyebrow = "Sản xuất / BOM",
        Title = "Tình trạng dữ liệu BOM",
        Description = "Xác định công thức nào đã sẵn sàng, công thức nào cần bổ sung cấu hình, quy đổi đơn vị hoặc dữ liệu giá vốn.",
        IconClass = "fas fa-clipboard-check",
        Breadcrumbs =
        [
            new() { Label = "Công thức", Url = Url.Action("Index") },
            new() { Label = "Tình trạng dữ liệu" }
        ],
        Actions =
        [
            new() { Label = "Quay lại công thức", Url = Url.Action("Index") ?? "#", IconClass = "fas fa-arrow-left" }
        ]
    };
}

<link rel="stylesheet" href="~/css/recipe-builder.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Admin/production-bom-ui.css" asp-append-version="true" />

<div class="rb-page production-bom-page production-bom-shell bom-health-page">
    <div class="container-fluid px-0">
        <partial name="_PageHero" model="hero" />

        <section class="bom-health-intro" aria-labelledby="health-intro-title">
            <span class="bom-health-intro__icon"><i class="fas fa-circle-info" aria-hidden="true"></i></span>
            <div>
                <h2 id="health-intro-title">Ưu tiên xử lý dữ liệu chưa hoàn chỉnh</h2>
                <p>Mỗi dòng cho biết nguyên nhân và dẫn thẳng tới màn hình cần cập nhật. Tổng kết quả và số dòng trên trang được tách riêng để tránh hiểu nhầm.</p>
            </div>
            <strong>Tổng kết quả lọc: @Model.TotalCount</strong>
        </section>

        <form method="get" class="rb-list-filters production-filter-card mb-3" role="search">
            <label class="visually-hidden" for="healthSearch">Tìm công thức cần kiểm tra</label>
            <input id="healthSearch"
                   class="form-control"
                   type="search"
                   name="search"
                   value="@Model.Search"
                   placeholder="Tìm tên, mã công thức hoặc mã bán thành phẩm..." />
            <label class="visually-hidden" for="healthType">Loại đối tượng công thức</label>
            <select id="healthType" class="form-select" name="typeFilter">
                <option value="ALL" selected="@(Model.TypeFilter == "ALL" ? "selected" : null)">Tất cả loại</option>
                <option value="POS" selected="@(Model.TypeFilter == "POS" ? "selected" : null)">Món bán</option>
                <option value="TOPPING" selected="@(Model.TypeFilter == "TOPPING" ? "selected" : null)">Topping</option>
                <option value="SUBRECIPE" selected="@(Model.TypeFilter == "SUBRECIPE" ? "selected" : null)">Bán thành phẩm</option>
            </select>
            <label class="visually-hidden" for="healthPageSize">Số dòng trên mỗi trang</label>
            <select id="healthPageSize" class="form-select" name="pageSize">
                <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10 dòng</option>
                <option value="20" selected="@(Model.PageSize == 20 ? "selected" : null)">20 dòng</option>
                <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50 dòng</option>
            </select>
            <button class="btn btn-rb-save" type="submit">
                <i class="fas fa-search me-2" aria-hidden="true"></i>Lọc
            </button>
            <a class="btn btn-rb-ghost production-filter-reset"
               asp-action="DataHealth"
               aria-label="Đặt lại bộ lọc"
               title="Đặt lại bộ lọc">
                <i class="fas fa-rotate-left" aria-hidden="true"></i>
            </a>
        </form>

        <section class="rb-health-summary bom-health-summary mb-3" aria-label="Tổng hợp tình trạng dữ liệu công thức trên trang hiện tại">
            <div class="rb-health-metric rb-health-ok">
                <span>Đủ dữ liệu · Trên trang này</span>
                <strong>@Model.CompleteCount</strong>
            </div>
            <div class="rb-health-metric">
                <span>Thiếu dữ liệu giá · Trên trang này</span>
                <strong>@Model.MissingQuoteCount</strong>
            </div>
            <div class="rb-health-metric">
                <span>Thiếu quy đổi · Trên trang này</span>
                <strong>@Model.MissingConversionCount</strong>
            </div>
            <div class="rb-health-metric">
                <span>Thiếu đầu ra · Trên trang này</span>
                <strong>@Model.MissingOutputCount</strong>
            </div>
            <div class="rb-health-metric">
                <span>Phiên bản cần kiểm tra · Trên trang này</span>
                <strong>@Model.CurrentRecipeIssueCount</strong>
            </div>
            <div class="rb-health-metric">
                <span>Lỗi liên kết · Trên trang này</span>
                <strong>@Model.MappingErrorCount</strong>
            </div>
        </section>

        <div class="rb-card rb-health-table-wrap bom-health-list">
            <header class="bom-section-heading">
                <div>
                    <span class="bom-section-heading__icon"><i class="fas fa-list-check" aria-hidden="true"></i></span>
                    <div><h2>Chi tiết cần xử lý</h2><p>Trạng thái cấu hình và giá vốn của từng công thức trên trang hiện tại.</p></div>
                </div>
                <span class="bom-list-count">Trên trang này: @Model.CurrentPageCount · Tổng kết quả lọc: @Model.TotalCount</span>
            </header>
            <div class="table-responsive">
                <table class="table rb-table rb-health-table production-data-table mb-0" aria-label="Chi tiết tình trạng dữ liệu BOM">
                    <thead>
                        <tr>
                            <th>Công thức</th>
                            <th>Phiên bản áp dụng</th>
                            <th>Cấu hình</th>
                            <th>Dữ liệu giá vốn</th>
                            <th>Lý do và xử lý</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                Chưa có công thức để đánh giá.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var row in Model.Items)
                        {
                            var configClass = row.Configuration.IsComplete
                                ? "rb-status-complete"
                                : row.Configuration.Code == "INACTIVE" ? "rb-status-inactive" : "rb-status-incomplete";
                            var currentClass = row.CurrentRecipe.IsBlocking
                                ? "rb-status-incomplete"
                                : row.CurrentRecipe.Code == BomCurrentRecipeHealthCodes.Current
                                    ? "rb-status-complete"
                                    : "rb-status-inactive";
                            var costClass = row.Costing.IsComplete ? "rb-status-complete" : "rb-status-error";
                            var reasons = row.Configuration.Reasons.Concat(row.Costing.Reasons).ToList();
                            var hasIssues = row.CurrentRecipe.IsBlocking || reasons.Count > 0;
                            <tr>
                                <td class="rb-health-identity">
                                    <span class="bom-row-kicker">@row.TypeLabel</span>
                                    <div class="fw-semibold text-break">@row.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(row.RecipeCode))
                                    {
                                        <div class="small text-muted font-monospace text-break">@row.RecipeCode</div>
                                    }
                                </td>
                                <td>
                                    <span class="rb-status-badge @currentClass">@row.CurrentRecipe.Label</span>
                                    <div class="small text-muted mt-1">@row.CurrentRecipe.Message</div>
                                </td>
                                <td>
                                    <span class="rb-status-badge @configClass">@row.Configuration.Label</span>
                                </td>
                                <td>
                                    <span class="rb-status-badge @costClass">@row.Costing.Label</span>
                                    @if (row.Costing.IsComplete && row.EstimatedCost.HasValue)
                                    {
                                        <div class="small text-muted font-monospace mt-1">@row.EstimatedCost.Value.ToString("N0") ₫</div>
                                    }
                                </td>
                                <td class="rb-health-reasons">
                                    @if (!hasIssues)
                                    {
                                        <span class="bom-health-clear"><i class="fas fa-check" aria-hidden="true"></i> Không có dữ liệu cần xử lý</span>
                                    }
                                    else
                                    {
                                        <ul class="bom-health-reason-list">
                                            @if (row.CurrentRecipe.IsBlocking)
                                            {
                                                <li>@row.CurrentRecipe.Message</li>
                                            }
                                            @foreach (var reason in reasons)
                                            {
                                                <li>@reason.Message</li>
                                            }
                                        </ul>
                                    }
                                </td>
                                <td class="rb-health-actions">
                                    @if (reasons.Count == 0)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                        <div class="dropdown rb-health-action-menu">
                                            <button class="btn rb-health-action-trigger dropdown-toggle" type="button"
                                                    data-bs-toggle="dropdown" aria-expanded="false"
                                                    aria-label="Mở @reasons.Count phương án xử lý">
                                                <i class="fas fa-screwdriver-wrench" aria-hidden="true"></i>
                                                <span>Xử lý</span>
                                                <span class="rb-health-action-count">@reasons.Count</span>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                @foreach (var reason in reasons)
                                                {
                                                    var ctaUrl = reason.CtaId.HasValue
                                                        ? Url.Action(reason.CtaAction, reason.CtaController, new { id = reason.CtaId.Value })
                                                        : Url.Action(reason.CtaAction, reason.CtaController);
                                                    <li>
                                                        <a class="dropdown-item rb-health-action-item" href="@ctaUrl">
                                                            <span class="rb-health-action-item-icon"><i class="fas fa-pen" aria-hidden="true"></i></span>
                                                            <span class="rb-health-action-copy">
                                                                <strong>@reason.CtaLabel</strong>
                                                                <small>Đi tới dữ liệu liên quan</small>
                                                            </span>
                                                            <i class="fas fa-chevron-right rb-health-action-arrow" aria-hidden="true"></i>
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model.TotalPages > 1)
        {
            <nav class="production-pagination mt-3" aria-label="Phân trang tình trạng dữ liệu công thức">
                <span class="production-pagination__summary">Trang @Model.Page / @Model.TotalPages</span>
                <div class="production-pagination__links">
                    @if (Model.Page > 1)
                    {
                        <a class="production-page-link is-nav" asp-action="DataHealth"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-search="@Model.Search"
                           asp-route-typeFilter="@Model.TypeFilter"><i class="fas fa-arrow-left" aria-hidden="true"></i> Trang trước</a>
                    }
                    @if (Model.Page < Model.TotalPages)
                    {
                        <a class="production-page-link is-nav" asp-action="DataHealth"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-search="@Model.Search"
                           asp-route-typeFilter="@Model.TypeFilter">Trang sau <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                    }
                </div>
            </nav>
        }
    </div>
</div>
