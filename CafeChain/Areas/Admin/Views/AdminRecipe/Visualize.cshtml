@model CafeChain.ViewModels.Admin.Recipes.AdminRecipeVisualizePageVM
@using CafeChain.ViewModels.Admin.Shared
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<CafeChain.ProductResource> ProductText
@inject CafeChain.Application.Interfaces.Systems.IBusinessDateService BusinessDateService
@{
    ViewData["Title"] = ProductText["Recipe.Visualize.PageTitle", Model.BusinessName];
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var targetLabel = Model.RecipeTypeKey switch
    {
        "POS" => ProductText["Recipe.Visualize.Target.Pos", Model.SizeName ?? ""],
        "TOPPING" => ProductText["Recipe.Visualize.Target.Topping"],
        "SUBRECIPE" => ProductText["Recipe.Visualize.Target.PreparedItem"],
        _ => ProductText["Recipe.Visualize.Target.Recipe"]
    };
    var appliedStateLabel = Model.IsCurrentVersion
        ? ProductText["Recipe.Visualize.State.Current"]
        : ProductText["Recipe.Visualize.State.Historical"];
    var outputHeading = Model.RecipeTypeKey switch
    {
        "TOPPING" => ProductText["Recipe.Visualize.Output.Scope"],
        "SUBRECIPE" => ProductText["Recipe.Visualize.Output.StandardBatch"],
        _ => ProductText["Recipe.Visualize.Output.Title"]
    };
    var outputDisplay = Model.RecipeTypeKey switch
    {
        "POS" => ProductText["Recipe.Visualize.Output.PosDisplay", Model.BusinessName, Model.SizeName ?? ProductText["Recipe.Visualize.Unknown"]],
        "TOPPING" => ProductText["Recipe.Visualize.Output.ToppingDisplay", Model.BusinessName],
        "SUBRECIPE" => ProductText["Recipe.Visualize.Output.BatchDisplay", Model.OutputQuantity?.ToString("0.####") ?? ProductText["Recipe.Visualize.NotConfigured"], Model.OutputUnitCode ?? Model.OutputUnitName ?? ProductText["Recipe.Visualize.Unit"]],
        _ => ProductText["Recipe.Visualize.Unknown"]
    };
    var outputContext = Model.RecipeTypeKey switch
    {
        "POS" => ProductText["Recipe.Visualize.Output.PosContext"],
        "TOPPING" => ProductText["Recipe.Visualize.Output.ToppingContext"],
        "SUBRECIPE" => ProductText["Recipe.Visualize.Output.BatchContext"],
        _ => ProductText["Recipe.Visualize.Output.UnknownContext"]
    };
    string RelationTypeLabel(string code) => code switch
    {
        "MENU_ITEM_SIZE" => ProductText["Recipe.Visualize.Relation.MenuItemSize"],
        "TOPPING" => ProductText["Recipe.Visualize.Relation.Topping"],
        "PREPARED_ITEM" => ProductText["Recipe.Visualize.Relation.PreparedItem"],
        "POINT_OF_SALE" => ProductText["Recipe.Visualize.Relation.PointOfSale"],
        _ => ProductText["Recipe.Visualize.Relation.Recipe"]
    };
    string EvidenceStateLabel(string state) => state switch
    {
        "AVAILABLE" => ProductText["Recipe.Visualize.Evidence.Available"],
        "INCOMPLETE" => ProductText["Recipe.Visualize.Evidence.Incomplete"],
        "NOT_APPLICABLE" => ProductText["Recipe.Visualize.Evidence.NotApplicable"],
        _ => ProductText["Recipe.Visualize.Evidence.Unavailable"]
    };
    string FacetLabel(string code) => ProductText[$"Recipe.Visualize.Facet.{code}"];
    string FacetMessage(string code, string state) => (code, state) switch
    {
        ("CONFIGURATION", "AVAILABLE") => ProductText["Recipe.Visualize.Facet.CONFIGURATION.AVAILABLE"],
        ("CONFIGURATION", "INCOMPLETE") => ProductText["Recipe.Visualize.Facet.CONFIGURATION.INCOMPLETE"],
        ("CONFIGURATION", "UNAVAILABLE") => ProductText["Recipe.Visualize.Facet.CONFIGURATION.UNAVAILABLE"],
        ("PRICING", "AVAILABLE") => ProductText["Recipe.Visualize.Facet.PRICING.AVAILABLE"],
        ("PRICING", "INCOMPLETE") => ProductText["Recipe.Visualize.Facet.PRICING.INCOMPLETE"],
        ("PRICING", "UNAVAILABLE") => ProductText["Recipe.Visualize.Facet.PRICING.UNAVAILABLE"],
        ("POINT_OF_SALE", "AVAILABLE") => ProductText["Recipe.Visualize.Facet.POINT_OF_SALE.AVAILABLE"],
        ("POINT_OF_SALE", "INCOMPLETE") => ProductText["Recipe.Visualize.Facet.POINT_OF_SALE.INCOMPLETE"],
        ("POINT_OF_SALE", "NOT_APPLICABLE") => ProductText["Recipe.Visualize.Facet.POINT_OF_SALE.NOT_APPLICABLE"],
        ("PREPARED_INPUTS", "AVAILABLE") => ProductText["Recipe.Visualize.Facet.PREPARED_INPUTS.AVAILABLE"],
        ("PREPARED_INPUTS", "INCOMPLETE") => ProductText["Recipe.Visualize.Facet.PREPARED_INPUTS.INCOMPLETE"],
        ("PREPARED_INPUTS", "NOT_APPLICABLE") => ProductText["Recipe.Visualize.Facet.PREPARED_INPUTS.NOT_APPLICABLE"],
        ("STORE_FIFO_EVIDENCE", "AVAILABLE") => ProductText["Recipe.Visualize.Facet.STORE_FIFO_EVIDENCE.AVAILABLE"],
        ("STORE_FIFO_EVIDENCE", "UNAVAILABLE") => ProductText["Recipe.Visualize.Facet.STORE_FIFO_EVIDENCE.UNAVAILABLE"],
        ("STORE_OPERATIONS", "AVAILABLE") => ProductText["Recipe.Visualize.Facet.STORE_OPERATIONS.AVAILABLE"],
        ("STORE_OPERATIONS", "INCOMPLETE") => ProductText["Recipe.Visualize.Facet.STORE_OPERATIONS.INCOMPLETE"],
        ("STORE_OPERATIONS", "UNAVAILABLE") => ProductText["Recipe.Visualize.Facet.STORE_OPERATIONS.UNAVAILABLE"],
        _ => EvidenceStateLabel(state)
    };

    var heroActions = new List<AdminPageHeroActionVM>
    {
        new() { Label = ProductText["Recipe.Visualize.Back"], Url = Model.BackUrl, IconClass = "fas fa-arrow-left" },
        new() { Label = ProductText["Recipe.Visualize.CheckData"], Url = Url.Action("DataHealth") ?? "#", IconClass = "fas fa-clipboard-check" }
    };
    if (Model.CanWrite)
    {
        heroActions.Add(new AdminPageHeroActionVM
        {
            Label = ProductText["Recipe.Visualize.NewVersion"],
            Url = Url.Action("Edit", new { id = Model.RecipeId }) ?? "#",
            IconClass = "fas fa-code-branch",
            IsPrimary = true
        });
    }

    var hero = new AdminPageHeroVM
    {
        Eyebrow = ProductText["Recipe.Eyebrow"],
        Title = Model.BusinessName,
        Description = ProductText["Recipe.Visualize.Description", targetLabel],
        IconClass = "fas fa-diagram-project",
        StatusLabel = appliedStateLabel,
        StatusCssClass = Model.AppliedStateCssClass,
        Breadcrumbs =
        [
            new() { Label = ProductText["Recipe.Index.Title"], Url = Model.BackUrl },
            new() { Label = Model.BusinessName }
        ],
        Actions = heroActions
    };
}

<link rel="stylesheet" href="~/css/Admin/production-bom-ui.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Admin/Recipe/recipe-workspace.css" asp-append-version="true" />
<style>
    /* Fix recipe hero card height to scale dynamically and avoid clipping the eyebrow badge */
    body.admin-premium-shell .production-bom-page .cc-page-hero,
    .production-bom-page .cc-page-hero {
        height: auto !important;
        min-height: 140px !important;
        padding-top: 26px !important;
        padding-bottom: 26px !important;
    }

    /* Keep breadcrumbs inline, aligned horizontally, preventing name from wrapping */
    .production-bom-page .cc-page-hero__breadcrumbs {
        flex-wrap: nowrap !important;
        white-space: nowrap !important;
    }
</style>

<main class="production-bom-page production-bom-shell bom-detail-page recipe-workspace-page">
    <div class="container-fluid px-0">
        <partial name="_PageHero" model="hero" />

        <section class="recipe-workspace__identity bom-overview-grid" aria-labelledby="recipe-identity-title">
            <div class="recipe-workspace__identity-main">
                <span class="recipe-workspace__eyebrow">@targetLabel</span>
                <h2 id="recipe-identity-title">@Model.BusinessName</h2>
                <p class="recipe-workspace__technical-code">
                    @ProductText["Recipe.Visualize.RecipeCode"]: @Model.RecipeCode
                    @if (!string.IsNullOrWhiteSpace(Model.BusinessCode))
                    {
                        <span>· @ProductText["Recipe.Visualize.TargetCode"]: @Model.BusinessCode</span>
                    }
                </p>
            </div>
            <div class="recipe-workspace__version">
                <span class="rb-status-badge @Model.AppliedStateCssClass">@appliedStateLabel</span>
                <strong>@ProductText["Recipe.Visualize.VersionNumber", Model.RecipeId]</strong>
                <small>@ProductText[Model.ParentVersionId.HasValue ? "Recipe.Visualize.InheritedVersion" : "Recipe.Visualize.OriginalVersion"]</small>
            </div>
            <div class="recipe-workspace__output-summary">
                <span><i class="fas fa-box-open" aria-hidden="true"></i> @outputHeading</span>
                <strong>@outputDisplay</strong>
                <small>@outputContext</small>
            </div>
        </section>

        <nav class="production-section-nav" aria-label="@ProductText["Recipe.Visualize.SectionsAria"]">
            <a href="#bom-components">@ProductText["Recipe.Visualize.OutputAndBom"]</a>
            <a href="#recipe-where-used">@ProductText["Recipe.Visualize.WhereUsed"]</a>
            <a href="#recipe-history">@ProductText["Recipe.Visualize.History"]</a>
            <a href="#recipe-context">@ProductText["Recipe.Visualize.Context"]</a>
            @if (Model.IsPreparedItemRecipe) { <a href="#recipe-operations">@ProductText["Recipe.Visualize.RecentProduction"]</a> }
        </nav>

        <section class="recipe-workspace__summary bom-health-board" aria-label="@ProductText["Recipe.Visualize.SummaryAria"]">
            <article>
                <span>@ProductText["Recipe.Visualize.BomLines"]</span>
                <strong>@Model.Components.Count</strong>
                <small>@ProductText["Recipe.Visualize.BomLinesHint"]</small>
            </article>
            <article>
                <span>@ProductText["Recipe.Compare.DesignCost"]</span>
                <strong>@(Model.DesignCost.IsAvailable ? $"{Model.DesignCost.Amount:N0} ₫" : ProductText["Recipe.Compare.InsufficientData"])</strong>
                <small>@Model.DesignCost.UnitLabel</small>
            </article>
            <article>
                <span>@ProductText["Recipe.Visualize.StoreFifoCost"]</span>
                <strong>@(Model.StoreFifoCost.IsAvailable ? $"{Model.StoreFifoCost.Amount:N0} ₫" : ProductText["Recipe.Compare.NoData"])</strong>
                <small>@(Model.StoreFifoCost.ContextLabel ?? ProductText["Recipe.Visualize.NoStore"])</small>
            </article>
            <article>
                <span>@ProductText["Recipe.Visualize.Readiness"]</span>
                <strong>@ProductText["Recipe.Visualize.ReadinessSummary", Model.GlobalReadiness.PassedCount, Model.GlobalReadiness.ApplicableCount]</strong>
                <small>@ProductText["Recipe.Visualize.Scope.Global"]</small>
            </article>
        </section>

        <div class="recipe-workspace__layout">
            <div class="recipe-workspace__main">
                <section id="bom-components" class="recipe-workspace__surface recipe-workspace__flow" aria-labelledby="recipe-flow-title">
                    <header class="recipe-workspace__section-heading bom-section-heading">
                        <span class="recipe-workspace__section-icon"><i class="fas fa-route" aria-hidden="true"></i></span>
                        <div>
                            <h2 id="recipe-flow-title">@ProductText["Recipe.Visualize.FlowTitle"]</h2>
                            <p>@ProductText["Recipe.Visualize.FlowHint"]</p>
                        </div>
                    </header>

                    <div class="recipe-workspace__output-node">
                        <span>@outputHeading</span>
                        <strong>@outputDisplay</strong>
                        <small>@outputContext</small>
                    </div>
                    <div class="recipe-workspace__flow-arrow" aria-hidden="true">
                        <i class="fas fa-arrow-down"></i>
                    </div>

                    <div class="recipe-workspace__input-groups">
                        <section class="recipe-workspace__input-group is-prepared" aria-labelledby="prepared-inputs-title">
                            <header>
                                <span class="recipe-workspace__type-badge is-prepared">@ProductText["PreparedItem.Title"]</span>
                                <div>
                                    <h3 id="prepared-inputs-title">@ProductText["Recipe.Visualize.PreparedInputs"]</h3>
                                    <p>@ProductText["Recipe.Visualize.PreparedInputsHint"]</p>
                                </div>
                            </header>
                            @if (Model.PreparedInputs.Count == 0)
                            {
                                <div class="recipe-workspace__empty">@ProductText["Recipe.Visualize.NoPreparedInputs"]</div>
                            }
                            else
                            {
                                <div class="recipe-workspace__input-list">
                                    @foreach (var component in Model.PreparedInputs)
                                    {
                                        <article>
                                            <div class="recipe-workspace__input-identity">
                                                <span>@ProductText[component.IsPreparedInput ? "Recipe.Visualize.Input.Prepared" : "Recipe.Visualize.Input.Direct"]</span>
                                                <strong>@component.ItemName</strong>
                                                <small>@ProductText["Recipe.Compare.Code"]: @component.ItemCode</small>
                                            </div>
                                            <div class="recipe-workspace__measure">
                                                <span>@ProductText["Recipe.Visualize.Quantity"]</span>
                                                <strong>@component.Quantity.ToString("0.####") @component.UnitCode</strong>
                                                @if (component.NormalizedQuantity.HasValue)
                                                {
                                                    <small>@ProductText["Recipe.Visualize.Normalized"]: @component.NormalizedQuantity.Value.ToString("0.####") @component.BaseUnitCode</small>
                                                }
                                                else
                                                {
                                                    <small>@ProductText["Recipe.Visualize.NoConversion"]</small>
                                                }
                                                <small class="recipe-workspace__line-cost">
                                                    @ProductText["Recipe.Compare.DesignCost"]:
                                                    @(component.EstimatedLineCost.HasValue ? $"{component.EstimatedLineCost:N0} ₫" : ProductText["Recipe.Compare.InsufficientData"])
                                                    @if (component.CostContributionPercent.HasValue)
                                                    {
                                                        <span>· @ProductText["Recipe.Visualize.CostContribution"]: @component.CostContributionPercent.Value.ToString("0.#")%</span>
                                                    }
                                                </small>
                                            </div>
                                            <a class="recipe-workspace__source-link bom-source-link" asp-action="Visualize"
                                               asp-route-recipeId="@component.ChildRecipeId"
                                               asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">
                                                <span>@ProductText["Recipe.Visualize.SourceRecipe"]</span>
                                                <strong>@ProductText["Recipe.Visualize.VersionNumber", component.ChildRecipeId!.Value]</strong>
                                                <small>@component.ChildRecipeCode</small>
                                                <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                            </a>
                                        </article>
                                    }
                                </div>
                            }
                        </section>

                        <section class="recipe-workspace__input-group is-direct" aria-labelledby="direct-inputs-title">
                            <header>
                                <span class="recipe-workspace__type-badge is-direct">@ProductText["Recipe.Visualize.Ingredients"]</span>
                                <div>
                                    <h3 id="direct-inputs-title">@ProductText["Recipe.Visualize.DirectIngredients"]</h3>
                                    <p>@ProductText["Recipe.Visualize.DirectIngredientsHint"]</p>
                                </div>
                            </header>
                            @if (Model.DirectIngredients.Count == 0)
                            {
                                <div class="recipe-workspace__empty">@ProductText["Recipe.Visualize.NoDirectIngredients"]</div>
                            }
                            else
                            {
                                <div class="recipe-workspace__input-list">
                                    @foreach (var component in Model.DirectIngredients)
                                    {
                                        <article>
                                            <div class="recipe-workspace__input-identity">
                                                <span>@ProductText[component.IsPreparedInput ? "Recipe.Visualize.Input.Prepared" : "Recipe.Visualize.Input.Direct"]</span>
                                                <strong>@component.ItemName</strong>
                                                <small>@ProductText["Recipe.Compare.Code"]: @component.ItemCode</small>
                                            </div>
                                            <div class="recipe-workspace__measure">
                                                <span>@ProductText["Recipe.Visualize.Quantity"]</span>
                                                <strong>@component.Quantity.ToString("0.####") @component.UnitCode</strong>
                                                @if (component.NormalizedQuantity.HasValue)
                                                {
                                                    <small>@ProductText["Recipe.Visualize.Normalized"]: @component.NormalizedQuantity.Value.ToString("0.####") @component.BaseUnitCode</small>
                                                }
                                                else
                                                {
                                                    <small>@ProductText["Recipe.Visualize.NoConversion"]</small>
                                                }
                                                <small class="recipe-workspace__line-cost">
                                                    @ProductText["Recipe.Compare.DesignCost"]:
                                                    @(component.EstimatedLineCost.HasValue ? $"{component.EstimatedLineCost:N0} ₫" : ProductText["Recipe.Compare.InsufficientData"])
                                                    @if (component.CostContributionPercent.HasValue)
                                                    {
                                                        <span>· @ProductText["Recipe.Visualize.CostContribution"]: @component.CostContributionPercent.Value.ToString("0.#")%</span>
                                                    }
                                                </small>
                                            </div>
                                        </article>
                                    }
                                </div>
                            }
                        </section>
                    </div>
                </section>

                <section id="recipe-where-used" class="recipe-workspace__surface recipe-workspace__where-used" aria-labelledby="where-used-title">
                    <header class="recipe-workspace__section-heading bom-section-heading">
                        <span class="recipe-workspace__section-icon"><i class="fas fa-share-nodes" aria-hidden="true"></i></span>
                        <div>
                            <h2 id="where-used-title">@ProductText["Recipe.Visualize.WhereUsedTitle"]</h2>
                            <p>@ProductText["Recipe.Visualize.WhereUsedHint"]</p>
                        </div>
                    </header>
                    @if (Model.WhereUsed.IsEmpty)
                    {
                        <div class="recipe-workspace__where-used-empty">
                            <i class="fas fa-circle-info" aria-hidden="true"></i>
                            <span>@ProductText["Recipe.Visualize.NoWhereUsed"]</span>
                        </div>
                    }
                    else
                    {
                        @if (Model.WhereUsed.CurrentParents.Count > 0)
                        {
                            <div class="recipe-workspace__where-used-group">
                                <div class="recipe-workspace__where-used-group-heading">
                                    <strong>@ProductText["Recipe.Visualize.CurrentParents"]</strong>
                                    <span>@ProductText["Recipe.Visualize.ResultCount", Model.WhereUsed.CurrentParents.Count]</span>
                                </div>
                                <div class="recipe-workspace__where-used-list">
                                    @foreach (var usage in Model.WhereUsed.CurrentParents)
                                    {
                                        <a class="recipe-workspace__where-used-item"
                                           asp-action="Visualize"
                                           asp-route-recipeId="@usage.ParentRecipeId"
                                           asp-route-storeId="@Model.SelectedStoreId"
                                           asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">
                                            <span class="recipe-workspace__type-badge">@RelationTypeLabel(usage.RelationType)</span>
                                            <span class="recipe-workspace__where-used-identity">
                                                <strong>@usage.BusinessName</strong>
                                                @if (!string.IsNullOrWhiteSpace(usage.ContextLabel))
                                                {
                                                    <small>@usage.ContextLabel</small>
                                                }
                                                <small class="recipe-workspace__where-used-technical">
                                                    @if (!string.IsNullOrWhiteSpace(usage.TechnicalCode))
                                                    {
                                                        <span>@ProductText["Recipe.Visualize.RecipeCodeValue", usage.TechnicalCode]</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(usage.PinnedVersionLabel))
                                                    {
                                                        <span>@ProductText["Recipe.Visualize.PinnedVersion", usage.PinnedChildRecipeId!.Value]</span>
                                                    }
                                                </small>
                                            </span>
                                            <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                        </a>
                                    }
                                </div>
                                @if (Model.WhereUsed.ParentResultsTruncated)
                                {
                                    <p class="recipe-workspace__where-used-limit">
                                        @ProductText["Recipe.Visualize.ParentResultsTruncated", Model.WhereUsed.CurrentParents.Count]
                                    </p>
                                }
                            </div>
                        }

                        @if (Model.WhereUsed.PointOfSaleLocations.Count > 0)
                        {
                            <div class="recipe-workspace__where-used-group">
                                <div class="recipe-workspace__where-used-group-heading">
                                    <strong>@ProductText["Recipe.Visualize.CurrentLocations"]</strong>
                                    <span>@ProductText["Recipe.Visualize.BranchCount", Model.WhereUsed.PointOfSaleLocations.Count]</span>
                                </div>
                                <div class="recipe-workspace__where-used-list">
                                    @foreach (var usage in Model.WhereUsed.PointOfSaleLocations)
                                    {
                                        <article class="recipe-workspace__where-used-item is-location">
                                            <span class="recipe-workspace__type-badge is-direct">@RelationTypeLabel(usage.RelationType)</span>
                                            <span class="recipe-workspace__where-used-identity">
                                                <strong>@usage.BusinessName</strong>
                                                <small>@usage.ContextLabel</small>
                                            </span>
                                            <i class="fas fa-store" aria-hidden="true"></i>
                                        </article>
                                    }
                                </div>
                                @if (Model.WhereUsed.PointOfSaleResultsTruncated)
                                {
                                    <p class="recipe-workspace__where-used-limit">
                                        @ProductText["Recipe.Visualize.LocationResultsTruncated", Model.WhereUsed.PointOfSaleLocations.Count]
                                    </p>
                                }
                            </div>
                        }
                    }
                </section>

                <section id="recipe-history" class="recipe-workspace__surface recipe-workspace__history" aria-labelledby="recipe-history-title">
                    <header class="recipe-workspace__section-heading bom-section-heading">
                        <span class="recipe-workspace__section-icon"><i class="fas fa-clock-rotate-left" aria-hidden="true"></i></span>
                        <div>
                            <h2 id="recipe-history-title">@ProductText["Recipe.Visualize.HistoryTitle"]</h2>
                            <p>@ProductText["Recipe.Visualize.HistoryHint"]</p>
                        </div>
                    </header>
                    @if (Model.VersionHistory.Items.Count == 0)
                    {
                        <div class="recipe-workspace__history-empty">@ProductText["Recipe.Visualize.NoHistory"]</div>
                    }
                    else
                    {
                        <div class="recipe-workspace__history-list">
                            @foreach (var version in Model.VersionHistory.Items)
                            {
                                <article class="@(version.IsCurrent ? "is-current" : null)">
                                    <div>
                                        <span class="rb-status-badge @(version.IsCurrent ? "rb-status-active" : "rb-status-inactive")">@(version.IsCurrent ? ProductText["Recipe.Visualize.State.Current"] : ProductText["Recipe.Visualize.State.Historical"])</span>
                                        <strong>@ProductText["Recipe.Visualize.VersionNumber", version.RecipeId]</strong>
                                        <small>@(version.IsCurrent ? ProductText["Recipe.Visualize.Relationship.Current"] : version.ParentVersionId.HasValue ? ProductText["Recipe.Visualize.Relationship.Derived"] : ProductText["Recipe.Visualize.Relationship.Original"])</small>
                                        <small>@ProductText["Recipe.Visualize.AppliedAt", version.AppliedAt.HasValue ? BusinessDateService.ToBusinessTime(version.AppliedAt.Value).ToString("g") : ProductText["Recipe.Visualize.OnRelease"]]</small>
                                    </div>
                                    <div class="recipe-workspace__history-actions">
                                        @if (version.RecipeId != Model.RecipeId)
                                        {
                                            <a asp-action="CompareVersions"
                                               asp-route-fromRecipeId="@version.RecipeId"
                                               asp-route-toRecipeId="@Model.RecipeId">
                                                <i class="fas fa-code-compare" aria-hidden="true"></i>
                                                @ProductText["Recipe.Visualize.CompareCurrent"]
                                            </a>
                                        }
                                        <a asp-action="Visualize" asp-route-recipeId="@version.RecipeId" asp-route-storeId="@Model.SelectedStoreId">
                                            @ProductText["Recipe.Visualize.ViewVersion"]
                                            <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                </article>
                            }
                        </div>
                        @if (Model.VersionHistory.IsTruncated)
                        {
                            <p class="recipe-workspace__history-limit">@ProductText["Recipe.Visualize.HistoryTruncated", Model.VersionHistory.Items.Count, Model.VersionHistory.TotalCount]</p>
                        }
                    }
                </section>

                @if (Model.IsPreparedItemRecipe)
                {
                    <section id="recipe-operations" class="recipe-workspace__surface recipe-workspace__operations" aria-labelledby="operations-title">
                        <header class="recipe-workspace__section-heading bom-section-heading">
                            <span class="recipe-workspace__section-icon"><i class="fas fa-store" aria-hidden="true"></i></span>
                            <div>
                                <h2 id="operations-title">@ProductText["Recipe.Visualize.OperationsTitle"]</h2>
                                <p>@ProductText["Recipe.Visualize.OperationsHint"]</p>
                            </div>
                        </header>
                        @if (!Model.SelectedStoreId.HasValue)
                        {
                            <p class="recipe-workspace__notice">@ProductText["Recipe.Visualize.SelectStoreForOperations"]</p>
                        }
                        else if (Model.Operational == null)
                        {
                            <p class="recipe-workspace__notice">@(!string.IsNullOrWhiteSpace(Model.OperationalError) ? Model.OperationalError : ProductText["Recipe.Visualize.OperationsUnavailable"])</p>
                        }
                        else if (Model.Operational != null)
                        {
                            var operational = Model.Operational;
                            @if (Model.Replenishment != null)
                            {
                                var replenishment = Model.Replenishment;
                                <div class="recipe-workspace__replenishment-grid" aria-label="@ProductText["Recipe.Visualize.ReplenishmentAria"]">
                                    <article>
                                        <span>@ProductText["Recipe.Visualize.UsableStock"]</span>
                                        <strong>@replenishment.UsableBase.ToString("0.###") @replenishment.BaseUnitCode</strong>
                                        <small>@ProductText["Recipe.Visualize.StockBreakdown", replenishment.OnHandBase.ToString("0.###"), replenishment.ReservedBase.ToString("0.###")]</small>
                                    </article>
                                    <article>
                                        <span>@ProductText["Recipe.Visualize.LowStockThreshold"]</span>
                                        <strong>@(replenishment.LowThresholdBase.HasValue ? $"{replenishment.LowThresholdBase.Value:0.###} {replenishment.BaseUnitCode}" : ProductText["Recipe.Visualize.NotConfigured"])</strong>
                                        <small>@(!replenishment.LowThresholdBase.HasValue
                                            ? ProductText["Recipe.Visualize.ConfigureThreshold"]
                                            : replenishment.IsLow
                                                ? ProductText["Recipe.Visualize.BelowThreshold"]
                                                : ProductText["Recipe.Visualize.AboveThreshold"])</small>
                                    </article>
                                    <article>
                                        <span>@ProductText["Recipe.Visualize.TargetStock"]</span>
                                        <strong>@(replenishment.TargetStockBase.HasValue ? $"{replenishment.TargetStockBase.Value:0.###} {replenishment.BaseUnitCode}" : ProductText["Recipe.Visualize.NotConfigured"])</strong>
                                        <small>@replenishment.BusinessMessageVi</small>
                                    </article>
                                    <article>
                                        <span>@ProductText["Recipe.Visualize.OpenProduction"]</span>
                                        <strong>@(replenishment.OpenProductionCoverageBase.HasValue ? $"{replenishment.OpenProductionCoverageBase.Value:0.###} {replenishment.BaseUnitCode}" : ProductText["Recipe.Visualize.NotConvertible"])</strong>
                                        <small>@ProductText["Recipe.Visualize.OpenProductionHint"]</small>
                                    </article>
                                    <article>
                                        <span>@ProductText["Recipe.Visualize.NetNeed"]</span>
                                        <strong>@(replenishment.NetNeedBase.HasValue ? $"{replenishment.NetNeedBase.Value:0.###} {replenishment.BaseUnitCode}" : ProductText["Recipe.Visualize.NotCalculated"])</strong>
                                        <small>@(replenishment.NetNeedBase.HasValue ? ProductText["Recipe.Visualize.NetNeedReady"] : ProductText["Recipe.Visualize.NetNeedUnavailable"])</small>
                                    </article>
                                </div>
                                <div class="recipe-workspace__replenishment-links" aria-label="@ProductText["Recipe.Visualize.ReplenishmentLinksAria"]">
                                    @if (Model.CanViewStockAlerts && replenishment.ActiveAlert != null)
                                    {
                                        <a asp-controller="AdminStockAlerts" asp-action="Details" asp-route-id="@replenishment.ActiveAlert.StockAlertId" asp-route-storeId="@replenishment.StoreId">
                                            <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
                                            @ProductText["Recipe.Visualize.StockAlert"] · @AdminStatusDisplay.StockAlert(replenishment.ActiveAlert.StatusCode).Label
                                        </a>
                                    }
                                    @if (Model.CanViewRestockRequests && replenishment.ActiveRestockRequest != null)
                                    {
                                        <a asp-controller="AdminRestockRequests" asp-action="Details" asp-route-id="@replenishment.ActiveRestockRequest.RestockRequestId">
                                            <i class="fas fa-clipboard-list" aria-hidden="true"></i>
                                            @ProductText["Recipe.Visualize.RestockRequest"] · @AdminStatusDisplay.RestockRequest(replenishment.ActiveRestockRequest.StatusCode).Label
                                        </a>
                                    }
                                    @if (Model.CanViewProduction && replenishment.OpenProductionRuns.Count > 0)
                                    {
                                        @foreach (var openRun in replenishment.OpenProductionRuns)
                                        {
                                            <a asp-controller="AdminProductionOrder" asp-action="Details" asp-route-id="@openRun.ProductionRunId">
                                                <i class="fas fa-industry" aria-hidden="true"></i>
                                                @ProductText["Recipe.Visualize.ProductionOrderNumber", openRun.ProductionRunId] · @openRun.StatusLabel
                                            </a>
                                        }
                                    }
                                </div>
                                @if (replenishment.HasMoreOpenProductionRuns)
                                {
                                    <p class="recipe-workspace__replenishment-limit">@ProductText["Recipe.Visualize.OpenProductionTruncated", replenishment.OpenProductionRuns.Count, replenishment.OpenProductionRunTotal]</p>
                                }
                            }
                            else
                            {
                                <p class="recipe-workspace__notice">@(!string.IsNullOrWhiteSpace(Model.ReplenishmentError) ? Model.ReplenishmentError : ProductText["Recipe.Visualize.NoReplenishment"])</p>
                            }
                            <div class="recipe-workspace__operations-grid">
                                <article>
                                    <span>@ProductText["Recipe.Visualize.RecentProduction"]</span>
                                    <strong>@ProductText["Recipe.Visualize.OrderCount", operational.RecentRuns.Count]</strong>
                                    <small>@(operational.RecentRuns.Count == 0 ? ProductText["Recipe.Visualize.NoProductionEvidence"] : ProductText["Recipe.Visualize.RecentProductionHint"])</small>
                                </article>
                                <article>
                                    <span>@ProductText["Recipe.Visualize.EvidenceVersion"]</span>
                                    <strong>@ProductText["Recipe.Visualize.VersionNumber", Model.RecipeId]</strong>
                                    <small>@ProductText["Recipe.Visualize.EvidenceVersionHint"]</small>
                                </article>
                            </div>
                            @if (operational.RecentRuns.Count > 0)
                            {
                                <div class="recipe-workspace__production-list" aria-label="@ProductText["Recipe.Visualize.RecentProductionAria"]">
                                    @foreach (var run in operational.RecentRuns)
                                    {
                                        <article>
                                            <div>
                                                <span class="recipe-workspace__eyebrow">@ProductText["Recipe.Visualize.OrderCode", run.BusinessCode]</span>
                                                <strong>@(Model.PreparedItemName ?? Model.BusinessName)</strong>
                                                <small>@run.Status</small>
                                            </div>
                                            <dl>
                                                <div>
                                                    <dt>@ProductText["Recipe.Visualize.AcceptedOutput"]</dt>
                                                    <dd>
                                                        @(run.AcceptedOutputQuantity.HasValue
                                                            ? $"{run.AcceptedOutputQuantity.Value:0.####} {run.OutputUnitCode}"
                                                            : ProductText["Recipe.Visualize.NoAcceptanceEvidence"])
                                                    </dd>
                                                </div>
                                                <div>
                                                    <dt>@ProductText["Recipe.Visualize.Completed"]</dt>
                                                    <dd>@(run.CompletedAt.HasValue ? BusinessDateService.ToBusinessTime(run.CompletedAt.Value).ToString("g") : ProductText["Recipe.Visualize.NotCompleted"])</dd>
                                                </div>
                                            </dl>
                                            @if (Model.CanViewProduction)
                                            {
                                                <a asp-controller="AdminProductionOrder" asp-action="Details" asp-route-id="@run.ProductionRunId">
                                                    @ProductText["Recipe.Visualize.ViewProductionOrder"]
                                                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                                </a>
                                            }
                                        </article>
                                    }
                                </div>
                            }
                        }
                    </section>
                }
            </div>

            <aside id="recipe-context" class="recipe-workspace__rail" aria-label="@ProductText["Recipe.Visualize.ContextAria"]">
                <header>
                    <i class="fas fa-table-columns" aria-hidden="true"></i>
                    <div>
                        <strong>@ProductText["Recipe.Visualize.ContextTitle"]</strong>
                        <small>@ProductText["Recipe.Visualize.ContextHint"]</small>
                    </div>
                </header>
                <section>
                    <span class="recipe-workspace__eyebrow">@ProductText["Recipe.Visualize.RecipeVersion"]</span>
                    <h2>@ProductText["Recipe.Visualize.VersionNumber", Model.RecipeId]</h2>
                    <span class="rb-status-badge @Model.AppliedStateCssClass">@appliedStateLabel</span>
                    <dl>
                        <div><dt>@ProductText["Recipe.Visualize.Target"]</dt><dd>@targetLabel</dd></div>
                        <div><dt>@ProductText["Recipe.Visualize.EffectiveDate"]</dt><dd>@(Model.EffectiveDate?.ToString("d") ?? ProductText["Recipe.Visualize.EffectiveImmediately"])</dd></div>
                        <div><dt>@ProductText["Recipe.Visualize.VersionSource"]</dt><dd>@(Model.ParentVersionId.HasValue ? ProductText["Recipe.Visualize.VersionNumber", Model.ParentVersionId.Value] : ProductText["Recipe.Visualize.OriginalVersion"])</dd></div>
                    </dl>
                </section>
                <section>
                    <span class="recipe-workspace__eyebrow">@ProductText["Recipe.Visualize.CostBasis"]</span>
                    <div class="recipe-workspace__evidence-list">
                        <article class="@(Model.DesignCost.IsAvailable ? "is-ready" : "is-warning")">
                            <span>@ProductText["Recipe.Visualize.DesignCost"]</span>
                            <strong>@(Model.DesignCost.IsAvailable ? $"{Model.DesignCost.Amount:N0} ₫" : ProductText["Recipe.Visualize.InsufficientData"])</strong>
                            <small>@Model.DesignCost.Message</small>
                        </article>
                        <article class="@(Model.StoreFifoCost.IsAvailable ? "is-ready" : "is-muted")">
                            <span>@ProductText["Recipe.Visualize.StoreFifoCostFull"]</span>
                            <strong>@(Model.StoreFifoCost.IsAvailable ? $"{Model.StoreFifoCost.Amount:N0} ₫" : ProductText["Recipe.Visualize.NoData"])</strong>
                            <small>@Model.StoreFifoCost.Message</small>
                            @if (!string.IsNullOrWhiteSpace(Model.StoreFifoCost.ContextLabel))
                            {
                                <small>@ProductText["Recipe.Visualize.BranchValue", Model.StoreFifoCost.ContextLabel]</small>
                            }
                            @if (Model.StoreFifoCost.EvidenceAtUtc.HasValue)
                            {
                                <small>@ProductText["Recipe.Visualize.EvidenceUpdated", BusinessDateService.ToBusinessTime(Model.StoreFifoCost.EvidenceAtUtc.Value).ToString("g")]</small>
                            }
                        </article>
                    </div>
                    <form method="get" asp-action="Visualize" class="recipe-workspace__store-selector is-rail">
                        <input type="hidden" name="recipeId" value="@Model.RecipeId" />
                        <input type="hidden" name="returnUrl" value="@Model.BackUrl" />
                        <div>
                            <label for="storeId">@ProductText["Recipe.Visualize.AllowedStore"]</label>
                            <select id="storeId" name="storeId">
                                <option value="">@ProductText["Recipe.Visualize.SelectStore"]</option>
                                @foreach (var store in Model.Stores)
                                {
                                    <option value="@store.StoreId" selected="@(Model.SelectedStoreId == store.StoreId ? "selected" : null)">@store.StoreName</option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-rb-save"><i class="fas fa-eye" aria-hidden="true"></i> @ProductText["Recipe.Visualize.View"]</button>
                    </form>
                </section>
                <section>
                    <span class="recipe-workspace__eyebrow">@ProductText["Recipe.Visualize.Readiness"]</span>
                    <h2>@ProductText["Recipe.Visualize.ReadinessSummary", Model.GlobalReadiness.PassedCount, Model.GlobalReadiness.ApplicableCount]</h2>
                    <small>@ProductText["Recipe.Visualize.Scope.Global"]</small>
                    <div class="recipe-workspace__facet-list">
                        @foreach (var facet in Model.GlobalReadiness.Facets)
                        {
                            <article class="@(facet.IsPassed ? "is-ready" : facet.IsApplicable ? "is-warning" : "is-muted")">
                                <div><strong>@FacetLabel(facet.Code)</strong><span>@EvidenceStateLabel(facet.State)</span></div>
                                <small>@FacetMessage(facet.Code, facet.State)</small>
                            </article>
                        }
                    </div>
                    @if (Model.SelectedStoreId.HasValue)
                    {
                        <h2 class="recipe-workspace__store-readiness-title">@ProductText["Recipe.Visualize.ReadinessSummary", Model.StoreReadiness.PassedCount, Model.StoreReadiness.ApplicableCount]</h2>
                        <small>@ProductText["Recipe.Visualize.Scope.Store"]</small>
                        <div class="recipe-workspace__facet-list">
                            @foreach (var facet in Model.StoreReadiness.Facets)
                            {
                                <article class="@(facet.IsPassed ? "is-ready" : facet.IsApplicable ? "is-warning" : "is-muted")">
                                    <div><strong>@FacetLabel(facet.Code)</strong><span>@EvidenceStateLabel(facet.State)</span></div>
                                    <small>@FacetMessage(facet.Code, facet.State)</small>
                                </article>
                            }
                        </div>
                    }
                </section>
                <section>
                    <span class="recipe-workspace__eyebrow">@ProductText["Recipe.Visualize.OutputDefinition"]</span>
                    <h2>@outputHeading</h2>
                    <p>@outputDisplay</p>
                    <small>@outputContext</small>
                </section>
                <section>
                    <span class="recipe-workspace__eyebrow">@ProductText["Recipe.Visualize.TechnicalTrace"]</span>
                    <dl>
                        <div><dt>@ProductText["Recipe.Visualize.RecipeCode"]</dt><dd>@Model.RecipeCode</dd></div>
                        @if (!string.IsNullOrWhiteSpace(Model.BusinessCode))
                        {
                            <div><dt>@ProductText["Recipe.Visualize.TargetCode"]</dt><dd>@Model.BusinessCode</dd></div>
                        }
                    </dl>
                </section>
            </aside>
        </div>
    </div>
</main>
