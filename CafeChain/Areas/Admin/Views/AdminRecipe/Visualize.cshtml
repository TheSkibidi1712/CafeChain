@model CafeChain.ViewModels.Admin.Recipes.AdminRecipeVisualizePageVM
@using CafeChain.ViewModels.Admin.Shared
@{
    ViewData["Title"] = "Xem cấu trúc BOM - " + Model.Name;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var statusBadge = AdminStatusDescriptor.Of(Model.Status, Model.Status, "rb-status-active");
}

<link rel="stylesheet" href="~/css/recipe-builder.css" asp-append-version="true" />

<div class="rb-page">
<div class="container-fluid px-4 pt-4 pb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div>
            <nav class="rb-breadcrumb">
                <a asp-action="Index">Công thức BOM</a> &gt; <span>Xem cấu trúc BOM</span>
            </nav>
            <h1 class="rb-page-title mb-1">Xem cấu trúc BOM</h1>
            <p class="text-muted mb-0">@Model.Name · #@Model.RecipeId · @Model.TypeLabel</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-rb-ghost">Quay lại</a>
            <a asp-action="Edit" asp-route-id="@Model.RecipeId" class="btn btn-rb-save">Tạo phiên bản mới</a>
        </div>
    </div>

    <div class="rb-card mb-3">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                <partial name="_StatusBadge" model="statusBadge" />
                @if (Model.PreparedItemId.HasValue)
                {
                    <span class="rb-badge-sub">[@Model.PreparedItemCode] @Model.PreparedItemName</span>
                }
                @if (Model.OutputQuantity.HasValue)
                {
                    <span class="rb-status-badge rb-status-complete">
                        Sản lượng mẻ: @Model.OutputQuantity.Value.ToString("0.####")
                        @(Model.OutputUnitCode ?? Model.OutputUnitName)
                    </span>
                }
            </div>
            <div class="small text-muted">
                Chú giải:
                <span class="rb-badge-raw ms-1">Nguyên liệu thô</span>
                <span class="rb-badge-sub ms-1">Bán thành phẩm con (pin Recipe version)</span>
            </div>
        </div>
    </div>

    @if (Model.ToppingConsumptionSource != null)
    {
        var source = Model.ToppingConsumptionSource;
        <div class="rb-card mb-3">
            <div class="card-body p-3">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                    <div>
                        <div class="small text-uppercase text-muted fw-semibold">Nguồn tiêu hao topping</div>
                        <span class="rb-source-badge @(source.MappingValid ? "is-valid" : "is-warning")">
                            @source.SourceLabel
                        </span>
                    </div>
                    <div class="text-end small">
                        <div>Giá bán: <strong>từ Topping.Price</strong></div>
                        @if (source.EstimatedCostPerPortion.HasValue)
                        {
                            <div>Giá vốn BOM ước tính: <strong>@source.EstimatedCostPerPortion.Value.ToString("N0") đ/phần</strong></div>
                        }
                        else
                        {
                            <div class="text-warning">@source.CostStatus</div>
                        }
                        <div class="text-muted">Giá vốn thực tế: FIFO khi bán</div>
                    </div>
                </div>
                <p class="small text-muted mb-2">@source.Reason</p>
                @foreach (var component in source.Components)
                {
                    <div class="rb-source-line rb-source-line-detail">
                        <span class="font-monospace">@component.IdentityDisplay</span>
                        <span>@component.QuantityDisplay/phần</span>
                        @if (component.ChildRecipeId.HasValue)
                        {
                            <span>· pin Recipe #@component.ChildRecipeId (@component.ChildRecipeCode)</span>
                            <span>· đơn vị tồn kho BTP: @(component.PreparedItemBaseUnitCode ?? "chưa cấu hình")</span>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <div class="rb-card">
        <div class="card-body">
            @if (Model.FirstLevelNodes == null || !Model.FirstLevelNodes.Any())
            {
                <p class="text-muted mb-0">Công thức chưa có thành phần BOM.</p>
            }
            else
            {
                <ul class="list-group list-group-flush">
                @foreach (var detail in Model.FirstLevelNodes)
                {
                    bool isIng = detail.Kind == CafeChain.ViewModels.Admin.Recipes.RecipeBomTreeNodeKind.Ingredient;
                    string code = isIng
                        ? $"ING_{detail.IngredientId}"
                        : $"REC_{detail.ChildRecipeId}";
                    string badge = isIng ? "rb-badge-raw" : "rb-badge-sub";
                    string kind = isIng ? "Nguyên liệu thô" : "Bán thành phẩm con";
                    <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div>
                            <span class="@badge">@kind</span>
                            <span class="fw-semibold ms-2">@detail.DisplayName</span>
                            <div class="small text-muted">
                                <code>@code</code>
                                @if (!isIng && detail.ChildRecipeId.HasValue)
                                {
                                    <span>· Phiên bản Recipe #@detail.ChildRecipeId (pin, không auto latest)</span>
                                }
                            </div>
                        </div>
                        <span class="badge bg-light text-dark border font-monospace" aria-label="Số lượng thành phần">
                            @detail.Quantity.ToString("0.####") @detail.UnitName
                        </span>
                    </li>
                }
                </ul>
            }
        </div>
    </div>
</div>
</div>
