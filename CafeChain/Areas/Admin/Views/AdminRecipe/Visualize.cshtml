@model CafeChain.ViewModels.Admin.Recipes.AdminRecipeVisualizePageVM
@using CafeChain.ViewModels.Admin.Shared
@inject CafeChain.Application.Interfaces.Systems.IBusinessDateService BusinessDateService
@{
    ViewData["Title"] = "Không gian công thức - " + Model.BusinessName;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var heroActions = new List<AdminPageHeroActionVM>
    {
        new() { Label = "Quay lại danh sách", Url = Model.BackUrl, IconClass = "fas fa-arrow-left" },
        new() { Label = "Kiểm tra dữ liệu", Url = Url.Action("DataHealth") ?? "#", IconClass = "fas fa-clipboard-check" }
    };
    if (Model.CanWrite)
    {
        heroActions.Add(new AdminPageHeroActionVM
        {
            Label = "Tạo phiên bản mới",
            Url = Url.Action("Edit", new { id = Model.RecipeId }) ?? "#",
            IconClass = "fas fa-code-branch",
            IsPrimary = true
        });
    }

    var hero = new AdminPageHeroVM
    {
        Eyebrow = "Sản xuất / BOM",
        Title = Model.BusinessName,
        Description = $"{Model.TargetLabel}. Xem đầu ra, định mức đầu vào và bằng chứng phiên bản trong một bố cục thống nhất.",
        IconClass = "fas fa-diagram-project",
        StatusLabel = Model.AppliedStateLabel,
        StatusCssClass = Model.AppliedStateCssClass,
        Breadcrumbs =
        [
            new() { Label = "Công thức và định mức", Url = Model.BackUrl },
            new() { Label = Model.BusinessName }
        ],
        Actions = heroActions
    };
}

<link rel="stylesheet" href="~/css/Admin/production-bom-ui.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Admin/Recipe/recipe-workspace.css" asp-append-version="true" />

<main class="production-bom-page production-bom-shell bom-detail-page recipe-workspace-page">
    <div class="container-fluid px-0">
        <partial name="_PageHero" model="hero" />

        <section class="recipe-workspace__identity bom-overview-grid" aria-labelledby="recipe-identity-title">
            <div class="recipe-workspace__identity-main">
                <span class="recipe-workspace__eyebrow">@Model.TargetLabel</span>
                <h2 id="recipe-identity-title">@Model.BusinessName</h2>
                <p class="recipe-workspace__technical-code">
                    Mã công thức: @Model.RecipeCode
                    @if (!string.IsNullOrWhiteSpace(Model.BusinessCode))
                    {
                        <span>· Mã đối tượng: @Model.BusinessCode</span>
                    }
                </p>
            </div>
            <div class="recipe-workspace__version">
                <span class="rb-status-badge @Model.AppliedStateCssClass">@Model.AppliedStateLabel</span>
                <strong>@Model.VersionLabel</strong>
                <small>@(Model.ParentVersionId.HasValue ? "Kế thừa phiên bản trước" : "Phiên bản gốc")</small>
            </div>
            <div class="recipe-workspace__output-summary">
                <span><i class="fas fa-box-open" aria-hidden="true"></i> @Model.OutputHeading</span>
                <strong>@Model.OutputDisplay</strong>
                <small>@Model.OutputContext</small>
            </div>
        </section>

        <nav class="production-section-nav" aria-label="Các phần của công thức">
            <a href="#bom-components">Đầu ra và định mức</a>
            <a href="#recipe-where-used">Được sử dụng ở đâu</a>
            <a href="#recipe-history">Lịch sử phiên bản</a>
            <a href="#recipe-context">Ngữ cảnh phiên bản</a>
            @if (Model.IsPreparedItemRecipe) { <a href="#recipe-operations">Sản xuất gần đây</a> }
        </nav>

        <section class="recipe-workspace__summary bom-health-board" aria-label="Tóm tắt công thức">
            <article>
                <span>Dòng định mức</span>
                <strong>@Model.Components.Count</strong>
                <small>Tổng số đầu vào của phiên bản này</small>
            </article>
            <article>
                <span>Giá vốn thiết kế</span>
                <strong>@(Model.DesignCost.IsAvailable ? $"{Model.DesignCost.Amount:N0} đ" : "Chưa đủ dữ liệu")</strong>
                <small>@Model.DesignCost.UnitLabel</small>
            </article>
            <article>
                <span>Giá vốn theo nhập trước - xuất trước (FIFO) tại chi nhánh</span>
                <strong>@(Model.StoreFifoCost.IsAvailable ? $"{Model.StoreFifoCost.Amount:N0} đ" : "Chưa có dữ liệu")</strong>
                <small>@(Model.StoreFifoCost.ContextLabel ?? "Chưa chọn chi nhánh")</small>
            </article>
            <article>
                <span>Mức sẵn sàng</span>
                <strong>@Model.GlobalReadiness.SummaryLabel</strong>
                <small>@Model.GlobalReadiness.ScopeLabel</small>
            </article>
        </section>

        <div class="recipe-workspace__layout">
            <div class="recipe-workspace__main">
                <section id="bom-components" class="recipe-workspace__surface recipe-workspace__flow" aria-labelledby="recipe-flow-title">
                    <header class="recipe-workspace__section-heading bom-section-heading">
                        <span class="recipe-workspace__section-icon"><i class="fas fa-route" aria-hidden="true"></i></span>
                        <div>
                            <h2 id="recipe-flow-title">Đầu ra và định mức đầu vào</h2>
                            <p>Đọc từ kết quả cần tạo xuống từng thành phần được sử dụng.</p>
                        </div>
                    </header>

                    <div class="recipe-workspace__output-node">
                        <span>@Model.OutputHeading</span>
                        <strong>@Model.OutputDisplay</strong>
                        <small>@Model.OutputContext</small>
                    </div>
                    <div class="recipe-workspace__flow-arrow" aria-hidden="true">
                        <i class="fas fa-arrow-down"></i>
                    </div>

                    <div class="recipe-workspace__input-groups">
                        <section class="recipe-workspace__input-group is-prepared" aria-labelledby="prepared-inputs-title">
                            <header>
                                <span class="recipe-workspace__type-badge is-prepared">Bán thành phẩm</span>
                                <div>
                                    <h3 id="prepared-inputs-title">Bán thành phẩm đầu vào</h3>
                                    <p>Được tạo từ một phiên bản công thức nguồn đã chọn.</p>
                                </div>
                            </header>
                            @if (Model.PreparedInputs.Count == 0)
                            {
                                <div class="recipe-workspace__empty">Phiên bản này không sử dụng bán thành phẩm đầu vào.</div>
                            }
                            else
                            {
                                <div class="recipe-workspace__input-list">
                                    @foreach (var component in Model.PreparedInputs)
                                    {
                                        <article>
                                            <div class="recipe-workspace__input-identity">
                                                <span>@component.InputTypeLabel</span>
                                                <strong>@component.ItemName</strong>
                                                <small>Mã: @component.ItemCode</small>
                                            </div>
                                            <div class="recipe-workspace__measure">
                                                <span>Định lượng</span>
                                                <strong>@component.Quantity.ToString("0.####") @component.UnitCode</strong>
                                                @if (component.NormalizedQuantity.HasValue)
                                                {
                                                    <small>Chuẩn hóa: @component.NormalizedQuantity.Value.ToString("0.####") @component.BaseUnitCode</small>
                                                }
                                                else
                                                {
                                                    <small>Chưa có quy đổi về đơn vị tồn kho</small>
                                                }
                                                <small class="recipe-workspace__line-cost">
                                                    Giá vốn thiết kế:
                                                    @(component.EstimatedLineCost.HasValue ? $"{component.EstimatedLineCost:N0} đ" : "chưa đủ dữ liệu")
                                                    @if (component.CostContributionPercent.HasValue)
                                                    {
                                                        <span>· Tỷ trọng giá vốn: @component.CostContributionPercent.Value.ToString("0.#")%</span>
                                                    }
                                                </small>
                                            </div>
                                            <a class="recipe-workspace__source-link bom-source-link" asp-action="Visualize"
                                               asp-route-recipeId="@component.ChildRecipeId"
                                               asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">
                                                <span>Công thức nguồn</span>
                                                <strong>@component.SourceVersionLabel</strong>
                                                <small>@component.ChildRecipeCode</small>
                                                <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                            </a>
                                        </article>
                                    }
                                </div>
                            }
                        </section>

                        <section class="recipe-workspace__input-group is-direct" aria-labelledby="direct-inputs-title">
                            <header>
                                <span class="recipe-workspace__type-badge is-direct">Nguyên liệu</span>
                                <div>
                                    <h3 id="direct-inputs-title">Nguyên liệu trực tiếp</h3>
                                    <p>Được lấy trực tiếp từ tồn kho khi thực hiện công thức.</p>
                                </div>
                            </header>
                            @if (Model.DirectIngredients.Count == 0)
                            {
                                <div class="recipe-workspace__empty">Phiên bản này không có nguyên liệu trực tiếp.</div>
                            }
                            else
                            {
                                <div class="recipe-workspace__input-list">
                                    @foreach (var component in Model.DirectIngredients)
                                    {
                                        <article>
                                            <div class="recipe-workspace__input-identity">
                                                <span>@component.InputTypeLabel</span>
                                                <strong>@component.ItemName</strong>
                                                <small>Mã: @component.ItemCode</small>
                                            </div>
                                            <div class="recipe-workspace__measure">
                                                <span>Định lượng</span>
                                                <strong>@component.Quantity.ToString("0.####") @component.UnitCode</strong>
                                                @if (component.NormalizedQuantity.HasValue)
                                                {
                                                    <small>Chuẩn hóa: @component.NormalizedQuantity.Value.ToString("0.####") @component.BaseUnitCode</small>
                                                }
                                                else
                                                {
                                                    <small>Chưa có quy đổi về đơn vị tồn kho</small>
                                                }
                                                <small class="recipe-workspace__line-cost">
                                                    Giá vốn thiết kế:
                                                    @(component.EstimatedLineCost.HasValue ? $"{component.EstimatedLineCost:N0} đ" : "chưa đủ dữ liệu")
                                                    @if (component.CostContributionPercent.HasValue)
                                                    {
                                                        <span>· Tỷ trọng giá vốn: @component.CostContributionPercent.Value.ToString("0.#")%</span>
                                                    }
                                                </small>
                                            </div>
                                        </article>
                                    }
                                </div>
                            }
                        </section>
                    </div>
                </section>

                <section id="recipe-where-used" class="recipe-workspace__surface recipe-workspace__where-used" aria-labelledby="where-used-title">
                    <header class="recipe-workspace__section-heading bom-section-heading">
                        <span class="recipe-workspace__section-icon"><i class="fas fa-share-nodes" aria-hidden="true"></i></span>
                        <div>
                            <h2 id="where-used-title">Được sử dụng ở đâu</h2>
                            <p>Các công thức cha hiện hành và điểm bán đang sử dụng đúng đối tượng công thức này.</p>
                        </div>
                    </header>
                    @if (Model.WhereUsed.IsEmpty)
                    {
                        <div class="recipe-workspace__where-used-empty">
                            <i class="fas fa-circle-info" aria-hidden="true"></i>
                            <span>Chưa ghi nhận nơi sử dụng hiện hành.</span>
                        </div>
                    }
                    else
                    {
                        @if (Model.WhereUsed.CurrentParents.Count > 0)
                        {
                            <div class="recipe-workspace__where-used-group">
                                <div class="recipe-workspace__where-used-group-heading">
                                    <strong>Công thức cha hiện hành</strong>
                                    <span>@Model.WhereUsed.CurrentParents.Count kết quả</span>
                                </div>
                                <div class="recipe-workspace__where-used-list">
                                    @foreach (var usage in Model.WhereUsed.CurrentParents)
                                    {
                                        <a class="recipe-workspace__where-used-item"
                                           asp-action="Visualize"
                                           asp-route-recipeId="@usage.ParentRecipeId"
                                           asp-route-storeId="@Model.SelectedStoreId"
                                           asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">
                                            <span class="recipe-workspace__type-badge">@usage.TypeLabel</span>
                                            <span class="recipe-workspace__where-used-identity">
                                                <strong>@usage.BusinessName</strong>
                                                @if (!string.IsNullOrWhiteSpace(usage.ContextLabel))
                                                {
                                                    <small>@usage.ContextLabel</small>
                                                }
                                                <small class="recipe-workspace__where-used-technical">
                                                    @if (!string.IsNullOrWhiteSpace(usage.TechnicalCode))
                                                    {
                                                        <span>Mã công thức: @usage.TechnicalCode</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(usage.PinnedVersionLabel))
                                                    {
                                                        <span>@usage.PinnedVersionLabel</span>
                                                    }
                                                </small>
                                            </span>
                                            <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                        </a>
                                    }
                                </div>
                                @if (Model.WhereUsed.ParentResultsTruncated)
                                {
                                    <p class="recipe-workspace__where-used-limit">
                                        Đang hiển thị @Model.WhereUsed.CurrentParents.Count kết quả đầu tiên; còn nơi sử dụng khác chưa hiển thị.
                                    </p>
                                }
                            </div>
                        }

                        @if (Model.WhereUsed.PointOfSaleLocations.Count > 0)
                        {
                            <div class="recipe-workspace__where-used-group">
                                <div class="recipe-workspace__where-used-group-heading">
                                    <strong>Điểm bán hiện hành trong phạm vi được phép xem</strong>
                                    <span>@Model.WhereUsed.PointOfSaleLocations.Count chi nhánh</span>
                                </div>
                                <div class="recipe-workspace__where-used-list">
                                    @foreach (var usage in Model.WhereUsed.PointOfSaleLocations)
                                    {
                                        <article class="recipe-workspace__where-used-item is-location">
                                            <span class="recipe-workspace__type-badge is-direct">@usage.TypeLabel</span>
                                            <span class="recipe-workspace__where-used-identity">
                                                <strong>@usage.BusinessName</strong>
                                                <small>@usage.ContextLabel</small>
                                            </span>
                                            <i class="fas fa-store" aria-hidden="true"></i>
                                        </article>
                                    }
                                </div>
                                @if (Model.WhereUsed.PointOfSaleResultsTruncated)
                                {
                                    <p class="recipe-workspace__where-used-limit">
                                        Đang hiển thị @Model.WhereUsed.PointOfSaleLocations.Count chi nhánh đầu tiên; còn chi nhánh khác chưa hiển thị.
                                    </p>
                                }
                            </div>
                        }
                    }
                </section>

                <section id="recipe-history" class="recipe-workspace__surface recipe-workspace__history" aria-labelledby="recipe-history-title">
                    <header class="recipe-workspace__section-heading bom-section-heading">
                        <span class="recipe-workspace__section-icon"><i class="fas fa-clock-rotate-left" aria-hidden="true"></i></span>
                        <div>
                            <h2 id="recipe-history-title">Lịch sử phiên bản</h2>
                            <p>Các phiên bản của cùng đối tượng công thức; không trộn với lịch sử tồn kho hay nhật ký kỹ thuật.</p>
                        </div>
                    </header>
                    @if (Model.VersionHistory.Items.Count == 0)
                    {
                        <div class="recipe-workspace__history-empty">Chưa ghi nhận phiên bản liên quan.</div>
                    }
                    else
                    {
                        <div class="recipe-workspace__history-list">
                            @foreach (var version in Model.VersionHistory.Items)
                            {
                                <article class="@(version.IsCurrent ? "is-current" : null)">
                                    <div>
                                        <span class="rb-status-badge @(version.IsCurrent ? "rb-status-active" : "rb-status-inactive")">@version.StateLabel</span>
                                        <strong>@version.VersionLabel</strong>
                                        <small>@version.RelationshipLabel</small>
                                        <small>Áp dụng: @(version.AppliedAt.HasValue ? BusinessDateService.ToBusinessTime(version.AppliedAt.Value).ToString("dd/MM/yyyy HH:mm") : "ngay khi phát hành")</small>
                                    </div>
                                    <div class="recipe-workspace__history-actions">
                                        @if (version.RecipeId != Model.RecipeId)
                                        {
                                            <a asp-action="CompareVersions"
                                               asp-route-fromRecipeId="@version.RecipeId"
                                               asp-route-toRecipeId="@Model.RecipeId">
                                                <i class="fas fa-code-compare" aria-hidden="true"></i>
                                                So sánh với phiên bản đang xem
                                            </a>
                                        }
                                        <a asp-action="Visualize" asp-route-recipeId="@version.RecipeId" asp-route-storeId="@Model.SelectedStoreId">
                                            Xem phiên bản
                                            <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                </article>
                            }
                        </div>
                        @if (Model.VersionHistory.IsTruncated)
                        {
                            <p class="recipe-workspace__history-limit">Hiển thị @Model.VersionHistory.Items.Count/@Model.VersionHistory.TotalCount phiên bản gần nhất.</p>
                        }
                    }
                </section>

                @if (Model.IsPreparedItemRecipe)
                {
                    <section id="recipe-operations" class="recipe-workspace__surface recipe-workspace__operations" aria-labelledby="operations-title">
                        <header class="recipe-workspace__section-heading bom-section-heading">
                            <span class="recipe-workspace__section-icon"><i class="fas fa-store" aria-hidden="true"></i></span>
                            <div>
                                <h2 id="operations-title">Sản xuất gần đây</h2>
                                <p>Bằng chứng vận hành của đúng phiên bản công thức tại chi nhánh đã chọn.</p>
                            </div>
                        </header>
                        @if (!Model.SelectedStoreId.HasValue)
                        {
                            <p class="recipe-workspace__notice">Chọn chi nhánh trong phần cơ sở tính giá vốn để xem dữ liệu vận hành.</p>
                        }
                        else if (Model.Operational == null)
                        {
                            <p class="recipe-workspace__notice">@(!string.IsNullOrWhiteSpace(Model.OperationalError) ? Model.OperationalError : "Chưa tải được dữ liệu của chi nhánh đã chọn.")</p>
                        }
                        else if (Model.Operational != null)
                        {
                            var operational = Model.Operational;
                            <div class="recipe-workspace__operations-grid">
                                <article>
                                    <span>Tồn bán thành phẩm</span>
                                    @if (operational.OutputStock == null)
                                    {
                                        <strong>Chưa có dữ liệu tồn chuẩn</strong>
                                        <small>Cần kiểm tra liên kết tồn kho của bán thành phẩm.</small>
                                    }
                                    else
                                    {
                                        <strong>@operational.OutputStock.UsableQuantity.ToString("0.###") @operational.OutputStock.BaseUnitCode khả dụng</strong>
                                        <small>Hiện có @operational.OutputStock.CurrentQuantity.ToString("0.###") · Đã giữ @operational.OutputStock.ReservedQuantity.ToString("0.###")</small>
                                    }
                                </article>
                                <article>
                                    <span>Lệnh sản xuất</span>
                                    <strong>@operational.RecentRuns.Count lần gần đây</strong>
                                    <small>@(operational.RecentRuns.Count == 0 ? "Chưa có dữ liệu cho đúng phiên bản này." : "Tối đa 5 lệnh gần nhất của phiên bản đang xem.")</small>
                                </article>
                            </div>
                            @if (operational.RecentRuns.Count > 0)
                            {
                                <div class="recipe-workspace__production-list" aria-label="Danh sách sản xuất gần đây">
                                    @foreach (var run in operational.RecentRuns)
                                    {
                                        <article>
                                            <div>
                                                <span class="recipe-workspace__eyebrow">Lệnh @run.BusinessCode</span>
                                                <strong>@(Model.PreparedItemName ?? Model.BusinessName)</strong>
                                                <small>@run.Status</small>
                                            </div>
                                            <dl>
                                                <div>
                                                    <dt>Đầu ra được chấp nhận</dt>
                                                    <dd>
                                                        @(run.AcceptedOutputQuantity.HasValue
                                                            ? $"{run.AcceptedOutputQuantity.Value:0.####} {run.OutputUnitCode}"
                                                            : "Chưa có bằng chứng nghiệm thu")
                                                    </dd>
                                                </div>
                                                <div>
                                                    <dt>Hoàn tất</dt>
                                                    <dd>@(run.CompletedAt.HasValue ? BusinessDateService.ToBusinessTime(run.CompletedAt.Value).ToString("dd/MM/yyyy HH:mm") : "Chưa hoàn tất")</dd>
                                                </div>
                                            </dl>
                                            @if (Model.CanViewProduction)
                                            {
                                                <a asp-controller="AdminProductionOrder" asp-action="Details" asp-route-id="@run.ProductionRunId">
                                                    Xem lệnh sản xuất
                                                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                                </a>
                                            }
                                        </article>
                                    }
                                </div>
                            }
                        }
                    </section>
                }
            </div>

            <aside id="recipe-context" class="recipe-workspace__rail" aria-label="Ngữ cảnh công thức">
                <header>
                    <i class="fas fa-table-columns" aria-hidden="true"></i>
                    <div>
                        <strong>Ngữ cảnh công thức</strong>
                        <small>Phiên bản, trạng thái và đối tượng đang xem.</small>
                    </div>
                </header>
                <section>
                    <span class="recipe-workspace__eyebrow">Phiên bản công thức</span>
                    <h2>@Model.VersionLabel</h2>
                    <span class="rb-status-badge @Model.AppliedStateCssClass">@Model.AppliedStateLabel</span>
                    <dl>
                        <div><dt>Đối tượng</dt><dd>@Model.TargetLabel</dd></div>
                        <div><dt>Ngày áp dụng</dt><dd>@(Model.EffectiveDate?.ToString("dd/MM/yyyy") ?? "Áp dụng ngay")</dd></div>
                        <div><dt>Nguồn phiên bản</dt><dd>@(Model.ParentVersionId.HasValue ? $"Phiên bản {Model.ParentVersionId.Value}" : "Phiên bản gốc")</dd></div>
                    </dl>
                </section>
                <section>
                    <span class="recipe-workspace__eyebrow">Cơ sở tính giá vốn</span>
                    <div class="recipe-workspace__evidence-list">
                        <article class="@(Model.DesignCost.IsAvailable ? "is-ready" : "is-warning")">
                            <span>Giá vốn ước tính theo thiết kế</span>
                            <strong>@(Model.DesignCost.IsAvailable ? $"{Model.DesignCost.Amount:N0} đ" : "Chưa đủ dữ liệu")</strong>
                            <small>@Model.DesignCost.Message</small>
                        </article>
                        <article class="@(Model.StoreFifoCost.IsAvailable ? "is-ready" : "is-muted")">
                            <span>Giá vốn theo nhập trước - xuất trước (FIFO) tại chi nhánh</span>
                            <strong>@(Model.StoreFifoCost.IsAvailable ? $"{Model.StoreFifoCost.Amount:N0} đ" : "Chưa có dữ liệu")</strong>
                            <small>@Model.StoreFifoCost.Message</small>
                            @if (!string.IsNullOrWhiteSpace(Model.StoreFifoCost.ContextLabel))
                            {
                                <small>Chi nhánh: @Model.StoreFifoCost.ContextLabel</small>
                            }
                            @if (Model.StoreFifoCost.EvidenceAtUtc.HasValue)
                            {
                                <small>Bằng chứng cập nhật: @BusinessDateService.ToBusinessTime(Model.StoreFifoCost.EvidenceAtUtc.Value).ToString("dd/MM/yyyy HH:mm")</small>
                            }
                        </article>
                    </div>
                    <form method="get" asp-action="Visualize" class="recipe-workspace__store-selector is-rail">
                        <input type="hidden" name="recipeId" value="@Model.RecipeId" />
                        <input type="hidden" name="returnUrl" value="@Model.BackUrl" />
                        <div>
                            <label for="storeId">Chi nhánh được phép xem</label>
                            <select id="storeId" name="storeId">
                                <option value="">Chọn chi nhánh</option>
                                @foreach (var store in Model.Stores)
                                {
                                    <option value="@store.StoreId" selected="@(Model.SelectedStoreId == store.StoreId ? "selected" : null)">@store.StoreName</option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-rb-save"><i class="fas fa-eye" aria-hidden="true"></i> Xem</button>
                    </form>
                </section>
                <section>
                    <span class="recipe-workspace__eyebrow">Mức sẵn sàng</span>
                    <h2>@Model.GlobalReadiness.SummaryLabel</h2>
                    <small>@Model.GlobalReadiness.ScopeLabel</small>
                    <div class="recipe-workspace__facet-list">
                        @foreach (var facet in Model.GlobalReadiness.Facets)
                        {
                            <article class="@(facet.IsPassed ? "is-ready" : facet.IsApplicable ? "is-warning" : "is-muted")">
                                <div><strong>@facet.Label</strong><span>@facet.StateLabel</span></div>
                                <small>@facet.Message</small>
                            </article>
                        }
                    </div>
                    @if (Model.SelectedStoreId.HasValue)
                    {
                        <h2 class="recipe-workspace__store-readiness-title">@Model.StoreReadiness.SummaryLabel</h2>
                        <small>@Model.StoreReadiness.ScopeLabel</small>
                        <div class="recipe-workspace__facet-list">
                            @foreach (var facet in Model.StoreReadiness.Facets)
                            {
                                <article class="@(facet.IsPassed ? "is-ready" : facet.IsApplicable ? "is-warning" : "is-muted")">
                                    <div><strong>@facet.Label</strong><span>@facet.StateLabel</span></div>
                                    <small>@facet.Message</small>
                                </article>
                            }
                        </div>
                    }
                </section>
                <section>
                    <span class="recipe-workspace__eyebrow">Định nghĩa đầu ra</span>
                    <h2>@Model.OutputHeading</h2>
                    <p>@Model.OutputDisplay</p>
                    <small>@Model.OutputContext</small>
                </section>
                <section>
                    <span class="recipe-workspace__eyebrow">Dấu vết kỹ thuật</span>
                    <dl>
                        <div><dt>Mã công thức</dt><dd>@Model.RecipeCode</dd></div>
                        @if (!string.IsNullOrWhiteSpace(Model.BusinessCode))
                        {
                            <div><dt>Mã đối tượng</dt><dd>@Model.BusinessCode</dd></div>
                        }
                    </dl>
                </section>
            </aside>
        </div>
    </div>
</main>
