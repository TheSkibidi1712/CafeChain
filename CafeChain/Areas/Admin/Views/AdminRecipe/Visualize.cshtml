@model CafeChain.ViewModels.Admin.Recipes.AdminRecipeVisualizePageVM
@using CafeChain.ViewModels.Admin.Shared
@{
    ViewData["Title"] = "Chi tiết BOM - " + Model.Name;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var statusBadge = AdminStatusDescriptor.Of(
        Model.Active && Model.Status == "Active" ? "ACTIVE" : "INACTIVE",
        Model.Active && Model.Status == "Active" ? "Đang hoạt động" : "Ngừng hoạt động",
        Model.Active && Model.Status == "Active" ? "rb-status-active" : "rb-status-inactive");
    var configClass = Model.ConfigurationHealth.IsComplete ? "rb-status-complete" : "rb-status-error";
    var costClass = Model.CostingHealth.IsComplete ? "rb-status-complete" : "rb-status-incomplete";
}

<link rel="stylesheet" href="~/css/recipe-builder.css" asp-append-version="true" />

<main class="rb-page rb-detail-page">
    <div class="container-fluid px-3 px-lg-4 pt-4 pb-5">
        <header class="rb-detail-header mb-3">
            <div class="min-w-0">
                <nav class="rb-breadcrumb" aria-label="Điều hướng BOM">
                    <a href="@Model.BackUrl">Công thức BOM</a> &gt; <span>Chi tiết</span>
                </nav>
                <h1 class="rb-page-title mb-1">@Model.Name</h1>
                <p class="rb-list-meta mb-0">
                    <code>@Model.RecipeCode</code> · Công thức #@Model.RecipeId · @Model.TypeLabel
                </p>
            </div>
            <div class="rb-detail-actions">
                <a href="@Model.BackUrl" class="btn-rb-back">Quay lại danh sách</a>
                <a href="#bom-components" class="btn btn-rb-ghost btn-sm">
                    <i class="fas fa-list-ul me-1" aria-hidden="true"></i>Xem cấu trúc
                </a>
                @if (Model.CanWrite)
                {
                    <a asp-action="Edit" asp-route-id="@Model.RecipeId" class="btn btn-rb-save">
                        <i class="fas fa-pen me-1" aria-hidden="true"></i>Sửa BOM
                    </a>
                }
            </div>
        </header>

        <section class="rb-card mb-3" aria-labelledby="overview-title">
            <div class="rb-card-header" id="overview-title">Tổng quan công thức</div>
            <div class="rb-detail-overview">
                <div><span>Loại</span><strong>@Model.TypeLabel</strong></div>
                <div><span>Định danh</span><strong>@Model.IdentityDisplay</strong></div>
                <div><span>Phiên bản</span><strong>Công thức #@Model.RecipeId</strong></div>
                <div><span>Phiên bản trước</span><strong>@(Model.ParentVersionId.HasValue ? $"Công thức #{Model.ParentVersionId}" : "Phiên bản gốc")</strong></div>
                <div><span>Ngày hiệu lực</span><strong>@(Model.EffectiveDate?.ToString("dd/MM/yyyy") ?? "Chưa đặt")</strong></div>
                <div><span>Trạng thái</span><partial name="_StatusBadge" model="statusBadge" /></div>
            </div>
        </section>

        <div class="rb-detail-grid mb-3">
            <section class="rb-card" aria-labelledby="config-health-title">
                <div class="rb-card-header" id="config-health-title">Tình trạng cấu hình</div>
                <div class="card-body p-3">
                    <span class="rb-status-badge @configClass">@Model.ConfigurationHealth.Label</span>
                    @if (Model.ConfigurationHealth.Reasons.Count == 0)
                    {
                        <p class="small text-muted mt-2 mb-0">Thông tin định danh và định nghĩa BOM đã đầy đủ.</p>
                    }
                    else
                    {
                        <div class="rb-detail-reasons mt-2">
                            @foreach (var reason in Model.ConfigurationHealth.Reasons)
                            {
                                <div class="rb-detail-reason">
                                    <div><code>@reason.Code</code><span>@reason.Message</span></div>
                                    <a asp-area="Admin" asp-controller="@reason.CtaController" asp-action="@reason.CtaAction"
                                       asp-route-id="@reason.CtaId" class="btn btn-sm btn-outline-secondary">@reason.CtaLabel</a>
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>

            <section class="rb-card" aria-labelledby="cost-health-title">
                <div class="rb-card-header" id="cost-health-title">Tình trạng giá vốn thiết kế</div>
                <div class="card-body p-3">
                    <span class="rb-status-badge @costClass">@Model.CostingHealth.Label</span>
                    <p class="small text-muted mt-2 mb-2">Đây là giá vốn BOM ước tính, không phải giá FIFO thực tế tại cửa hàng.</p>
                    @if (Model.CostingHealth.Reasons.Count > 0)
                    {
                        <div class="rb-detail-reasons">
                            @foreach (var reason in Model.CostingHealth.Reasons)
                            {
                                <div class="rb-detail-reason">
                                    <div><code>@reason.Code</code><span>@reason.Message</span></div>
                                    <a asp-area="Admin" asp-controller="@reason.CtaController" asp-action="@reason.CtaAction"
                                       asp-route-id="@reason.CtaId" class="btn btn-sm btn-outline-secondary">@reason.CtaLabel</a>
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>
        </div>

        @if (Model.ShowBatchOutput)
        {
            <section class="rb-card mb-3" aria-labelledby="output-title">
                <div class="rb-card-header" id="output-title">Đầu ra bán thành phẩm</div>
                <div class="rb-output-contract">
                    <div>
                        <span>Bán thành phẩm ổn định</span>
                        <strong>[@Model.PreparedItemCode] @Model.PreparedItemName</strong>
                        @if (Model.PreparedItemId.HasValue)
                        {
                            <a asp-controller="AdminPreparedItem" asp-action="Index" asp-route-search="@Model.PreparedItemCode">Mở danh mục BTP</a>
                        }
                    </div>
                    <div><span>Sản lượng khai báo/mẻ</span><strong>@(Model.OutputQuantity?.ToString("0.####") ?? "—") @(Model.OutputUnitCode ?? Model.OutputUnitName)</strong></div>
                    <div><span>Sản lượng chuẩn hóa/mẻ</span><strong>@(Model.NormalizedOutputQuantity?.ToString("0.####") ?? "Chưa quy đổi được") @Model.OutputBaseUnitCode</strong></div>
                    <div><span>Đơn vị tồn kho BTP</span><strong>@(Model.OutputBaseUnitCode ?? "Chưa cấu hình")</strong></div>
                </div>
            </section>
        }

        @if (Model.ToppingConsumptionSource != null)
        {
            var source = Model.ToppingConsumptionSource;
            <section class="rb-card mb-3" aria-labelledby="topping-source-title">
                <div class="rb-card-header" id="topping-source-title">Nguồn tiêu hao topping</div>
                <div class="card-body p-3">
                    <span class="rb-source-badge @(source.MappingValid ? "is-valid" : "is-warning")">@source.SourceLabel</span>
                    <p class="small text-muted mt-2 mb-0">@source.Reason</p>
                </div>
            </section>
        }

        <section class="rb-card mb-3" id="bom-components" aria-labelledby="components-title">
            <div class="rb-card-header" id="components-title">Thành phần BOM</div>
            @if (Model.Components.Count == 0)
            {
                <div class="rb-detail-empty">Công thức chưa có thành phần BOM.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table rb-table rb-detail-table mb-0">
                        <thead>
                            <tr>
                                <th>Thành phần</th>
                                <th>Định lượng</th>
                                <th>Chuẩn hóa</th>
                                <th>Công thức nguồn</th>
                                <th>Giá vốn ước tính</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var component in Model.Components)
                        {
                            <tr>
                                <td>
                                    <span class="@(component.IngredientId.HasValue ? "rb-badge-raw" : "rb-badge-sub")">@component.ComponentType</span>
                                    <strong class="d-block mt-2">@component.ItemName</strong>
                                    <code>@component.ItemCode</code>
                                </td>
                                <td class="rb-qty-unit">@component.Quantity.ToString("0.####") @component.UnitCode</td>
                                <td>
                                    @if (component.NormalizedQuantity.HasValue)
                                    {
                                        <strong>@component.NormalizedQuantity.Value.ToString("0.####") @component.BaseUnitCode</strong>
                                    }
                                    else
                                    {
                                        <span class="text-warning">Chưa quy đổi được</span>
                                    }
                                </td>
                                <td>
                                    @if (component.ChildRecipeId.HasValue)
                                    {
                                        <a asp-action="Visualize" asp-route-recipeId="@component.ChildRecipeId" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">
                                            Công thức #@component.ChildRecipeId
                                        </a>
                                        <div class="small text-muted">Cố định Công thức #@component.ChildRecipeId (@component.ChildRecipeCode)</div>
                                        <div class="small">Bán thành phẩm: @component.PreparedItemCode</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Không áp dụng</span>
                                    }
                                </td>
                                <td>
                                    @if (component.EstimatedLineCost.HasValue)
                                    {
                                        <strong>@component.EstimatedLineCost.Value.ToString("N0") đ</strong>
                                        <div class="small text-muted">Ước tính theo thiết kế BOM</div>
                                    }
                                    else
                                    {
                                        <span class="rb-status-badge rb-status-incomplete">@component.CostStatus</span>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="rb-card mb-3" aria-labelledby="estimated-cost-title">
            <div class="rb-card-header" id="estimated-cost-title">Giá vốn BOM ước tính</div>
            <div class="rb-cost-metrics">
                @if (Model.IsPreparedItemRecipe)
                {
                    <div><span>Ước tính/mẻ</span><strong>@(Model.EstimatedBatchCost?.ToString("N0") ?? "Chưa đủ dữ liệu") @(Model.EstimatedBatchCost.HasValue ? "đ" : "")</strong></div>
                    <div><span>Ước tính/đơn vị BTP</span><strong>@(Model.EstimatedUnitCost?.ToString("N2") ?? "Chưa đủ dữ liệu") @(Model.EstimatedUnitCost.HasValue ? $"đ/{Model.OutputBaseUnitCode}" : "")</strong></div>
                }
                else
                {
                    <div><span>Ước tính/phần bán</span><strong>@(Model.EstimatedPortionCost?.ToString("N0") ?? "Chưa đủ dữ liệu") @(Model.EstimatedPortionCost.HasValue ? "đ" : "")</strong></div>
                }
                <p>Giá vốn thực tế được ghi nhận theo FIFO tại thời điểm vận hành và không thay thế con số ước tính này.</p>
            </div>
        </section>

        <section class="rb-card" aria-labelledby="operations-title">
            <div class="rb-card-header" id="operations-title">Vận hành theo cửa hàng</div>
            <div class="card-body p-3">
                <form method="get" asp-action="Visualize" class="rb-store-selector mb-3">
                    <input type="hidden" name="recipeId" value="@Model.RecipeId" />
                    <input type="hidden" name="returnUrl" value="@Model.BackUrl" />
                    <div>
                        <label class="form-label" for="storeId">Cửa hàng</label>
                        <select class="form-select" id="storeId" name="storeId">
                            <option value="">-- Chọn cửa hàng để xem mức độ sẵn sàng --</option>
                            @foreach (var store in Model.Stores)
                            {
                                <option value="@store.StoreId" selected="@(Model.SelectedStoreId == store.StoreId ? "selected" : null)">@store.StoreName</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-rb-save">Xem vận hành</button>
                </form>

                @if (!Model.IsPreparedItemRecipe)
                {
                    <div class="rb-detail-empty">Mức độ sẵn sàng sản xuất và tồn BTP chỉ áp dụng cho công thức bán thành phẩm.</div>
                }
                else if (!Model.SelectedStoreId.HasValue)
                {
                    <div class="rb-detail-empty">Chọn cửa hàng để tải chế độ ghi kho, mức độ sẵn sàng, tồn BTP và lệnh sơ chế gần đây.</div>
                }
                else if (Model.Operational == null)
                {
                    <div class="alert alert-warning mb-0">@(!string.IsNullOrWhiteSpace(Model.OperationalError) ? Model.OperationalError : "Không tải được dữ liệu vận hành cho cửa hàng đã chọn.")</div>
                }
                else
                {
                    var operational = Model.Operational;
                    var readiness = operational.Readiness;
                    <div class="rb-operational-actions mb-3">
                        <a asp-controller="AdminProductionOrder" asp-action="Create"
                           asp-route-storeId="@operational.StoreId" asp-route-recipeId="@Model.RecipeId"
                           class="btn btn-rb-save">Tạo lệnh sơ chế</a>
                        <a asp-controller="AdminStoreInventory" asp-action="Index"
                           asp-route-storeId="@operational.StoreId" asp-route-inventoryType="prepared-items"
                           asp-route-search="@Model.PreparedItemCode" class="btn btn-rb-ghost">Xem tồn kho BTP</a>
                        <a asp-action="DataHealth" class="btn btn-rb-ghost">Đi tới tình trạng dữ liệu</a>
                    </div>

                    @if (readiness != null)
                    {
                        <div class="rb-readiness-strip @(readiness.IsReady ? "is-ready" : "is-blocked")">
                            <div><span>Mức độ sẵn sàng</span><strong>@(readiness.IsReady ? "Sẵn sàng" : "Chưa sẵn sàng")</strong></div>
                            <div><span>Chế độ ghi kho</span><strong>@(readiness.WriterMode == "PreparedItem" ? "Bán thành phẩm" : readiness.WriterMode == "LegacyRecipe" ? "Công thức cũ" : readiness.WriterMode)</strong></div>
                            <div><span>Số mẻ tối đa</span><strong>@readiness.MaxSupportedRunCount.ToString("0.####")</strong></div>
                        </div>
                        @if (readiness.Reasons.Count > 0)
                        {
                            <ul class="rb-operational-reasons">
                                @foreach (var reason in readiness.Reasons)
                                {
                                    <li><code>@reason.Code</code> @reason.Message</li>
                                }
                            </ul>
                        }
                    }

                    <div class="rb-detail-grid mt-3">
                        <div class="rb-subpanel">
                            <h2>Tồn BTP hiện tại</h2>
                            @if (operational.OutputStock == null)
                            {
                                <p class="text-warning mb-0">Chưa có đúng một dòng tồn chuẩn hoặc còn xung đột dữ liệu cũ.</p>
                            }
                            else
                            {
                                var stock = operational.OutputStock;
                                <dl class="rb-stock-grid">
                                    <div><dt>Hiện có</dt><dd>@stock.CurrentQuantity.ToString("0.###") @stock.BaseUnitCode</dd></div>
                                    <div><dt>Đã giữ</dt><dd>@stock.ReservedQuantity.ToString("0.###") @stock.BaseUnitCode</dd></div>
                                    <div><dt>Khả dụng</dt><dd>@stock.UsableQuantity.ToString("0.###") @stock.BaseUnitCode</dd></div>
                                </dl>
                                <div class="rb-actual-cost-box">
                                    <span>Lớp giá FIFO đầu ra thực tế gần nhất</span>
                                    @if (stock.ActualUnitCost.HasValue)
                                    {
                                        <strong>@stock.ActualUnitCost.Value.ToString("N2") đ/@stock.BaseUnitCode</strong>
                                        <small>Lớp giá #@stock.LatestCostLayerId · Lệnh sơ chế #@stock.SourceProductionRunId · @stock.ActualLayerCreatedAt?.ToString("dd/MM/yyyy HH:mm")</small>
                                    }
                                    else
                                    {
                                        <strong>Chưa có lớp giá thực tế</strong>
                                    }
                                </div>
                            }
                        </div>

                        <div class="rb-subpanel">
                            <h2>Lệnh sơ chế gần đây</h2>
                            @if (operational.RecentRuns.Count == 0)
                            {
                                <p class="text-muted mb-0">Chưa có lệnh sơ chế cho đúng phiên bản công thức tại cửa hàng này.</p>
                            }
                            else
                            {
                                <div class="rb-run-list">
                                    @foreach (var run in operational.RecentRuns)
                                    {
                                        <article>
                                            <div>
                                                <strong>Lệnh #@run.ProductionRunId</strong>
                                                <span>@(run.Status == "Completed" ? "Đã hoàn tất" : run.Status == "Confirmed" ? "Đã xác nhận" : run.Status)</span>
                                            </div>
                                            <p>@run.RequestedRunCount.ToString("0.####") mẻ · @run.ConfirmedAt.ToString("dd/MM/yyyy HH:mm") · @(run.ActorName ?? "Không rõ người tạo")</p>
                                            @if (run.ActualOutputUnitCost.HasValue)
                                            {
                                                <small>FIFO thực tế: @run.ActualTotalInputCost?.ToString("N0") đ tổng · @run.ActualOutputUnitCost.Value.ToString("N2") đ/@Model.OutputBaseUnitCode</small>
                                            }
                                        </article>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>
    </div>
</main>
