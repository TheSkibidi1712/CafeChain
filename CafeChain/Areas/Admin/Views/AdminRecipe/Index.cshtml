@model CafeChain.ViewModels.Admin.Recipes.AdminRecipeListPageVM
@using CafeChain.ViewModels.Admin.Shared
@{
    ViewData["Title"] = "Công thức BOM";
    var type = Model.TypeFilter ?? "POS";
    var items = Model.Items;
    var typeLabel = type switch
    {
        "TOPPING" => "Topping",
        "SUBRECIPE" => "Bán thành phẩm",
        _ => "Món bán"
    };
    var heroActions = new List<AdminPageHeroActionVM>
    {
        new()
        {
            Label = "Kiểm tra dữ liệu",
            Url = Url.Action("DataHealth") ?? "#",
            IconClass = "fas fa-clipboard-check"
        }
    };
    if (Model.CanWrite)
    {
        heroActions.Add(new AdminPageHeroActionVM
        {
            Label = "Tạo công thức",
            Url = Url.Action("Create") ?? "#",
            IconClass = "fas fa-plus",
            IsPrimary = true
        });
    }
    var hero = new AdminPageHeroVM
    {
        Eyebrow = "Sản xuất / BOM",
        Title = "Công thức và định mức nguyên liệu",
        Description = "Quản lý định mức đầu vào, sản lượng dự kiến và các phiên bản công thức cho món bán, topping và bán thành phẩm.",
        IconClass = "fas fa-diagram-project",
        Breadcrumbs = [new() { Label = "Sản xuất / BOM" }, new() { Label = "Công thức" }],
        Actions = heroActions
    };
}

<link rel="stylesheet" href="~/css/recipe-builder.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Admin/production-bom-ui.css" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="rb-page production-bom-page production-bom-shell bom-list-page">
    <div class="container-fluid px-0">
        <partial name="_PageHero" model="hero" />

        <nav class="rb-recipe-tabs production-tabs" aria-label="Loại công thức">
            <a class="rb-recipe-tab @(type == "POS" ? "active" : "")"
               aria-current="@(type == "POS" ? "page" : null)"
               href="@Url.Action("Index", new { type = "POS", search = Model.Search, status = Model.StatusFilter, page = 1 })">
                Món bán
            </a>
            <a class="rb-recipe-tab @(type == "TOPPING" ? "active" : "")"
               aria-current="@(type == "TOPPING" ? "page" : null)"
               href="@Url.Action("Index", new { type = "TOPPING", search = Model.Search, status = Model.StatusFilter, page = 1 })">
                Topping
            </a>
            <a class="rb-recipe-tab @(type == "SUBRECIPE" ? "active" : "")"
               aria-current="@(type == "SUBRECIPE" ? "page" : null)"
               href="@Url.Action("Index", new { type = "SUBRECIPE", search = Model.Search, status = Model.StatusFilter, page = 1 })">
                Bán thành phẩm
            </a>
        </nav>

        <form method="get" class="rb-list-filters production-filter-card" role="search">
            <input type="hidden" name="type" value="@type" />
            <label class="visually-hidden" for="recipeSearch">Tìm công thức</label>
            <input id="recipeSearch"
                   class="form-control"
                   type="search"
                   name="search"
                   value="@Model.Search"
                   placeholder="Tìm tên, mã công thức hoặc mã BTP..." />
            <label class="visually-hidden" for="recipeStatus">Trạng thái</label>
            <select id="recipeStatus" class="form-select" name="status">
                <option value="ALL" selected="@(Model.StatusFilter == "ALL" ? "selected" : null)">Tất cả trạng thái</option>
                <option value="ACTIVE" selected="@(Model.StatusFilter == "ACTIVE" ? "selected" : null)">Đang hoạt động</option>
                <option value="INACTIVE" selected="@(Model.StatusFilter == "INACTIVE" ? "selected" : null)">Không hoạt động</option>
            </select>
            <button class="btn btn-rb-save" type="submit">
                <i class="fas fa-search me-2" aria-hidden="true"></i>Lọc
            </button>
            <a class="btn btn-rb-ghost production-filter-reset"
               href="@Url.Action("Index", new { type })"
               aria-label="Đặt lại bộ lọc"
               title="Đặt lại bộ lọc">
                <i class="fas fa-rotate-left" aria-hidden="true"></i>
            </a>
        </form>

        <section class="production-list-section" aria-labelledby="recipe-list-title">
            <header class="production-section-header">
                <div>
                    <h2 id="recipe-list-title">Danh sách công thức @typeLabel.ToLowerInvariant()</h2>
                    <p>Phiên bản đang áp dụng, tình trạng dữ liệu và giá vốn ước tính.</p>
                </div>
                <span class="production-section-header__count"><strong>@Model.TotalCount</strong> công thức</span>
            </header>

        <div class="rb-card production-table-panel">
            <div class="table-responsive">
                <table class="table rb-table rb-recipe-table production-data-table @(type == "SUBRECIPE" ? "is-subrecipe" : "is-standard") mb-0" aria-label="Danh sách công thức @typeLabel">
                    @if (type == "SUBRECIPE")
                    {
                        <colgroup>
                            <col class="rb-col-identity" />
                            <col class="rb-col-version" />
                            <col class="rb-col-output" />
                            <col class="rb-col-output" />
                            <col class="rb-col-cost" />
                            <col class="rb-col-cost" />
                            <col class="rb-col-status" />
                            <col class="rb-col-actions" />
                        </colgroup>
                    }
                    else if (type == "TOPPING")
                    {
                        <colgroup>
                            <col class="rb-col-identity" />
                            <col class="rb-col-source" />
                            <col class="rb-col-portion" />
                            <col class="rb-col-config" />
                            <col class="rb-col-cost" />
                            <col class="rb-col-status" />
                            <col class="rb-col-actions" />
                        </colgroup>
                    }
                    else
                    {
                        <colgroup>
                            <col class="rb-col-identity" />
                            <col class="rb-col-version" />
                            <col class="rb-col-portion" />
                            <col class="rb-col-config" />
                            <col class="rb-col-cost" />
                            <col class="rb-col-status" />
                            <col class="rb-col-actions" />
                        </colgroup>
                    }
                    <thead>
                        @if (type == "SUBRECIPE")
                        {
                            <tr>
                                <th>BTP</th>
                                <th>Phiên bản</th>
                                <th title="Sản lượng mỗi mẻ">Sản lượng/mẻ</th>
                                <th>Sản lượng quy đổi</th>
                                <th>Giá vốn/mẻ</th>
                                <th>Giá vốn/đơn vị</th>
                                <th>Trạng thái</th>
                                <th class="rb-actions-heading">Thao tác</th>
                            </tr>
                        }
                        else if (type == "TOPPING")
                        {
                            <tr>
                                <th>Topping</th>
                                <th>Nguồn tiêu hao</th>
                                <th>Định mức/phần</th>
                                <th>Cấu hình</th>
                                <th>Giá vốn/phần</th>
                                <th>Trạng thái</th>
                                <th class="rb-actions-heading">Thao tác</th>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <th>Định danh</th>
                                <th>Phiên bản</th>
                                <th>Định mức/phần</th>
                                <th>Cấu hình</th>
                                <th>Giá vốn/phần</th>
                                <th>Trạng thái</th>
                                <th class="rb-actions-heading">Thao tác</th>
                            </tr>
                        }
                    </thead>
                    <tbody>
                    @if (!items.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <div class="rb-empty-state">
                                    <h2 class="h6">Chưa có công thức @typeLabel.ToLowerInvariant()</h2>
                                    <p class="text-muted mb-3">Thử đổi từ khóa hoặc trạng thái lọc.</p>
                                    @if (Model.CanWrite)
                                    {
                                        <a asp-action="Create" class="btn btn-rb-save">Thêm công thức</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var recipe in items)
                        {
                            var activeDesc = AdminStatusDisplay.RecipeActive(recipe.Active);
                            var configClass = recipe.ConfigurationHealth.IsComplete ? "rb-status-complete" : "rb-status-incomplete";
                            var costClass = recipe.CostingHealth.IsComplete ? "rb-status-complete" : "rb-status-error";
                            var costReasons = string.Join(" | ", recipe.CostingHealth.Reasons.Select(x => x.Message));
                            <tr data-recipe-type="@recipe.RecipeType" data-recipe-id="@recipe.RecipeId">
                                <td>
                                    <div class="fw-semibold text-break">@recipe.IdentityDisplay</div>
                                    <div class="small text-muted font-monospace text-break">@recipe.RecipeCode</div>
                                </td>
                                @if (type == "SUBRECIPE")
                                {
                                    <td>
                                        <strong>@recipe.RecipeCode</strong>
                                        <div class="small text-muted">Phiên bản cho bán thành phẩm</div>
                                    </td>
                                    <td class="font-monospace">@recipe.OutputPerBatchDisplay</td>
                                    <td class="font-monospace">@recipe.NormalizedOutputDisplay</td>
                                    <td>
                                        @if (recipe.EstimatedCost.HasValue)
                                        {
                                            <span class="font-monospace">@recipe.EstimatedCost.Value.ToString("N0") đ/mẻ</span>
                                        }
                                        else
                                        {
                                            <span class="rb-status-badge @costClass" title="@costReasons">@recipe.CostingHealth.Label</span>
                                        }
                                    </td>
                                    <td>
                                        @if (recipe.EstimatedUnitCost.HasValue)
                                        {
                                            <span class="font-monospace">@recipe.EstimatedUnitCost.Value.ToString("N2") đ/@recipe.BaseUnitCode</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Chưa tính được</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="rb-status-badge @configClass">@recipe.ConfigurationHealth.Label</span>
                                        <div class="mt-1"><partial name="_StatusBadge" model="activeDesc" /></div>
                                    </td>
                                }
                                else
                                {
                                    @if (type == "TOPPING")
                                    {
                                        var source = recipe.ToppingConsumptionSource;
                                        <td class="rb-source-cell">
                                            <span class="rb-source-badge @(source?.MappingValid == true ? "is-valid" : "is-warning")">
                                                @(source?.SourceLabel ?? recipe.ConsumptionSourceDisplay)
                                            </span>
                                            @if (source != null)
                                            {
                                                <div class="small text-muted mt-1">@source.Reason</div>
                                                @foreach (var component in source.Components.Take(2))
                                                {
                                                    <div class="rb-source-line">
                                                        <span class="font-monospace">@component.IdentityDisplay</span>
                                                        <span>@component.QuantityDisplay/phần</span>
                                                        @if (component.ChildRecipeId.HasValue)
                                                        {
                                                            <span>· dùng phiên bản công thức đã chọn</span>
                                                        }
                                                    </div>
                                                }
                                            }
                                        </td>
                                    }
                                    else
                                    {
                                        <td>
                                            <strong>@recipe.RecipeCode</strong>
                                            <div class="small text-muted">Phiên bản đang áp dụng</div>
                                        </td>
                                    }
                                    <td>@recipe.PortionDefinitionDisplay</td>
                                    <td><span class="rb-status-badge @configClass">@recipe.ConfigurationHealth.Label</span></td>
                                    <td>
                                        @if (recipe.EstimatedCost.HasValue)
                                        {
                                            <span class="font-monospace">@recipe.EstimatedCost.Value.ToString("N0") đ/phần</span>
                                        }
                                        else
                                        {
                                            <span class="rb-status-badge @costClass" title="@costReasons">@recipe.CostingHealth.Label</span>
                                        }
                                    </td>
                                    <td><partial name="_StatusBadge" model="activeDesc" /></td>
                                }
                                <td class="rb-actions-cell">
                                    <div class="production-row-actions">
                                        <a class="btn btn-sm btn-outline-secondary rb-table-action"
                                           asp-action="Visualize"
                                           asp-route-recipeId="@recipe.RecipeId"
                                           title="Xem cấu trúc BOM"
                                           aria-label="Xem cấu trúc BOM của @recipe.Name"
                                           asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"><i class="fas fa-diagram-project" aria-hidden="true"></i><span>Xem cấu trúc</span></a>
                                        @if (Model.CanWrite)
                                        {
                                            <div class="dropdown production-row-menu">
                                                <button class="btn btn-sm production-row-menu__trigger" type="button"
                                                        data-bs-toggle="dropdown" aria-expanded="false"
                                                        title="Mở danh sách thao tác"
                                                        aria-label="Mở danh sách thao tác cho @recipe.Name">
                                                    <i class="fas fa-ellipsis-vertical" aria-hidden="true"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <li>
                                                        <a class="dropdown-item" asp-action="Edit" asp-route-id="@recipe.RecipeId">
                                                            <i class="fas fa-pen" aria-hidden="true"></i>
                                                            @(type == "SUBRECIPE" ? "Tạo phiên bản" : "Sửa công thức")
                                                        </a>
                                                    </li>
                                                    <li><hr class="dropdown-divider" /></li>
                                                    <li>
                                                        <button type="button" class="dropdown-item text-danger btn-delete-recipe"
                                                                data-id="@recipe.RecipeId" data-name="@recipe.Name">
                                                            <i class="fas fa-trash-can" aria-hidden="true"></i>Xóa công thức
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        @if (Model.TotalPages > 1)
        {
            <nav class="production-pagination" aria-label="Phân trang công thức">
                <span class="production-pagination__summary">Trang @Model.Page trên @Model.TotalPages</span>
                <div class="production-pagination__links">
                    @if (Model.Page > 1)
                    {
                        <a class="production-page-link is-nav" aria-label="Trang trước"
                           href="@Url.Action("Index", new { type, search = Model.Search, status = Model.StatusFilter, page = Model.Page - 1 })"><i class="fas fa-chevron-left" aria-hidden="true"></i></a>
                    }
                    @for (var number = 1; number <= Model.TotalPages; number++)
                    {
                    <a class="production-page-link @(number == Model.Page ? "is-current" : "")"
                       aria-current="@(number == Model.Page ? "page" : null)"
                       href="@Url.Action("Index", new { type, search = Model.Search, status = Model.StatusFilter, page = number })">
                        @number
                    </a>
                    }
                    @if (Model.Page < Model.TotalPages)
                    {
                        <a class="production-page-link is-nav" aria-label="Trang sau"
                           href="@Url.Action("Index", new { type, search = Model.Search, status = Model.StatusFilter, page = Model.Page + 1 })"><i class="fas fa-chevron-right" aria-hidden="true"></i></a>
                    }
                </div>
            </nav>
        }
        </div>
        </section>
    </div>
</div>

@section Scripts {
    @if (Model.CanWrite)
    {
    <script>
    (function () {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        document.querySelectorAll('.btn-delete-recipe').forEach(function (button) {
            button.addEventListener('click', async function () {
                const id = this.dataset.id;
                const name = this.dataset.name || '';
                const answer = await Swal.fire({
                    icon: 'warning',
                    title: 'Xóa công thức?',
                    text: '"' + name + '" (#' + id + ') sẽ bị xóa và không thể khôi phục.',
                    showCancelButton: true,
                    confirmButtonText: 'Xác nhận xóa',
                    cancelButtonText: 'Hủy',
                    reverseButtons: true,
                    customClass: { popup: 'rb-confirm-popup', confirmButton: 'rb-confirm-primary', cancelButton: 'rb-confirm-cancel' },
                    buttonsStyling: false
                });
                if (!answer.isConfirmed) return;

                fetch('@Url.Action("Delete", "AdminRecipe", new { area = "Admin" })?id=' + id, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token,
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => response.json())
                .then(result => {
                    if (result.success) location.reload();
                    else Swal.fire({ icon: 'error', title: 'Không thể xóa', text: result.message || 'Không thể xóa công thức.', confirmButtonColor: '#6f4e37' });
                })
                .catch(() => Swal.fire({ icon: 'error', title: 'Mất kết nối', text: 'Không thể kết nối máy chủ.', confirmButtonColor: '#6f4e37' }));
            });
        });
    })();
    </script>
    }
}
