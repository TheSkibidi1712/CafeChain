@model CafeChain.ViewModels.Admin.Recipes.AdminRecipeListPageVM
@{
    ViewData["Title"] = "Công thức BOM";
    var filter = Model?.TypeFilter ?? "ALL";
    var items = Model?.Items ?? new List<CafeChain.ViewModels.Admin.Recipes.AdminRecipeListItemVM>();
}

<link rel="stylesheet" href="~/css/recipe-builder.css" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="rb-page">
<div class="container-fluid px-4 pt-4 pb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
        <div>
            <nav class="rb-breadcrumb" aria-label="breadcrumb">
                <span>Sản xuất / BOM</span> &gt; <span>Công thức BOM</span>
            </nav>
            <h1 class="rb-page-title mb-1">Công thức BOM</h1>
            <p class="text-muted mb-0">Định mức nguyên liệu cho món bán, topping và bán thành phẩm.</p>
        </div>
        <a asp-action="Create" class="btn btn-rb-save">
            <i class="fas fa-plus me-2" aria-hidden="true"></i>Thêm công thức
        </a>
    </div>

    <div class="rb-filter-chips mb-3" role="tablist" aria-label="Lọc loại công thức">
        @{
            string Chip(string key, string label) =>
                $"<a class=\"rb-chip {(filter == key ? "active" : "")}\" href=\"{Url.Action("Index", new { type = key == "ALL" ? null : key })}\">{label}</a>";
        }
        @Html.Raw(Chip("ALL", "Tất cả"))
        @Html.Raw(Chip("POS", "Món bán"))
        @Html.Raw(Chip("TOPPING", "Topping"))
        @Html.Raw(Chip("SUBRECIPE", "Bán thành phẩm"))
    </div>

    <div class="rb-card">
        <div class="table-responsive">
            <table class="table rb-table mb-0" aria-label="Danh sách công thức">
                <thead>
                    <tr>
                        <th>Loại</th>
                        <th>Định danh</th>
                        <th>Phiên bản</th>
                        <th>Sản lượng mỗi mẻ</th>
                        <th>Sản lượng chuẩn hóa</th>
                        <th>Trạng thái</th>
                        <th>Giá vốn</th>
                        <th>Cập nhật</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (!items.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5">
                            <p class="fw-semibold mb-1">Chưa có công thức</p>
                            <p class="text-muted small mb-3">Tạo định mức đầu tiên cho món bán hoặc BTP.</p>
                            <a asp-action="Create" class="btn btn-rb-save">Thêm công thức</a>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var r in items)
                    {
                        var typeClass = r.RecipeType switch
                        {
                            "POS" => "rb-badge-raw",
                            "TOPPING" => "rb-badge-topping",
                            _ => "rb-badge-sub"
                        };
                        var costClass = r.CostComplete == true ? "rb-status-complete"
                            : r.CostComplete == false ? "rb-status-incomplete" : "rb-status-inactive";
                        <tr data-recipe-type="@r.RecipeType" data-recipe-id="@r.RecipeId">
                            <td><span class="@typeClass">@r.TypeLabel</span></td>
                            <td>
                                <div class="fw-semibold">@r.IdentityDisplay</div>
                                <div class="text-muted small">@r.Name</div>
                            </td>
                            <td>
                                <span class="font-monospace">#@r.RecipeId</span>
                                @if (!string.IsNullOrWhiteSpace(r.RecipeCode))
                                {
                                    <div class="text-muted small">@r.RecipeCode</div>
                                }
                            </td>
                            <td class="font-monospace">@r.OutputPerBatchDisplay</td>
                            <td class="font-monospace">@r.NormalizedOutputDisplay</td>
                            <td>
                                <span class="rb-status-badge @(r.Active ? "rb-status-active" : "rb-status-inactive")">
                                    @(r.Active ? "Hoạt động" : "Ngưng")
                                </span>
                            </td>
                            <td>
                                <span class="rb-status-badge @costClass">@r.CostStatus</span>
                                @if (r.CostComplete == true && r.EstimatedCost.HasValue)
                                {
                                    <div class="small text-muted font-monospace">
                                        @r.EstimatedCost.Value.ToString("N0") VND
                                    </div>
                                }
                            </td>
                            <td class="small text-muted">
                                @(r.EffectiveDate?.ToString("dd/MM/yyyy") ?? "—")
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-action="Edit" asp-route-id="@r.RecipeId">
                                        @(r.RecipeType == "SUBRECIPE" ? "Tạo phiên bản mới" : "Sửa")
                                    </a>
                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-action="Visualize" asp-route-recipeId="@r.RecipeId">
                                        Xem cấu trúc BOM
                                    </a>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger btn-delete-recipe"
                                            data-id="@r.RecipeId"
                                            data-name="@r.Name"
                                            aria-label="Xóa công thức @r.Name">
                                        Xóa
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
</div>

@section Scripts {
<script>
(function () {
    function token() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    }
    document.querySelectorAll('.btn-delete-recipe').forEach(function (btn) {
        btn.addEventListener('click', function () {
            const id = this.getAttribute('data-id');
            const name = this.getAttribute('data-name') || '';
            if (!confirm('Xóa công thức "' + name + '" (#' + id + ')? Thao tác có thể lưu trữ / gỡ theo rule backend.')) return;
            fetch('@Url.Action("Delete", "AdminRecipe", new { area = "Admin" })?id=' + id, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token(),
                    'Content-Type': 'application/json'
                }
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) location.reload();
                else alert(res.message || 'Không xóa được');
            })
            .catch(() => alert('Lỗi kết nối'));
        });
    });
})();
</script>
}
