@model CafeChain.ViewModels.Admin.Recipes.AdminRecipeFormPageVM
@using CafeChain.ViewModels.Admin.Shared
@{
    ViewData["Title"] = "Tạo phiên bản công thức";
    var form = Model.Form;
    var options = Model.Options;
    var recipeId = Model.SourceRecipeId ?? 0;
    var recipeName = Model.RecipeName ?? "";
    var previewUrl = Url.Action("PreviewNormalizedOutput", "AdminRecipe", new { area = "Admin" });
    var bomOptionsUrl = Url.Action("GetBomOptions", "AdminPreparedItem", new { area = "Admin" });
    var hero = new AdminPageHeroVM
    {
        Eyebrow = "Sản xuất / BOM",
        Title = "Tạo phiên bản công thức mới",
        Description = $"Tạo phiên bản kế tiếp cho {recipeName}. Phiên bản hiện tại vẫn được giữ trong lịch sử.",
        IconClass = "fas fa-code-branch",
        Breadcrumbs =
        [
            new() { Label = "Công thức", Url = Url.Action("Index") },
            new() { Label = recipeName },
            new() { Label = "Phiên bản mới" }
        ],
        Actions =
        [
            new() { Label = "Quay lại danh sách", Url = Url.Action("Index") ?? "#", IconClass = "fas fa-arrow-left" }
        ]
    };
}

<link rel="stylesheet" href="~/css/recipe-builder.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Admin/production-bom-ui.css" asp-append-version="true" />

<div class="rb-page rb-edit-theme production-bom-page production-bom-shell recipe-form-page" data-theme="light">
<div class="container-fluid px-0">
    <partial name="_PageHero" model="hero" />

    <form asp-action="Edit" asp-route-id="@recipeId" method="post" id="recipeForm" class="production-recipe-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="production-form-grid rb-builder-grid">
        <div class="production-form-main">
        <section class="rb-card production-form-section" aria-labelledby="editSecIdentity">
            <div class="rb-card-header"><h2 id="editSecIdentity" class="rb-section-title">Loại và đối tượng công thức</h2></div>
            <div class="card-body p-4">
                <div class="rb-toggle btn-group w-100 mb-3" role="group">
                    <input type="radio" class="btn-check" name="RecipeType" id="typePOS" value="POS" autocomplete="off" @(form.RecipeType == "POS" ? "checked" : "")>
                    <label class="btn py-2" for="typePOS">Món bán (POS)</label>
                    <input type="radio" class="btn-check" name="RecipeType" id="typeTOPPING" value="TOPPING" autocomplete="off" @(form.RecipeType == "TOPPING" ? "checked" : "")>
                    <label class="btn py-2" for="typeTOPPING">Topping</label>
                    <input type="radio" class="btn-check" name="RecipeType" id="typeSUBRECIPE" value="SUBRECIPE" autocomplete="off" @(form.RecipeType == "SUBRECIPE" ? "checked" : "")>
                    <label class="btn py-2" for="typeSUBRECIPE">Bán thành phẩm</label>
                </div>

                <div class="row g-3">
                    <div class="col-md-4 conditional-section" id="sectionPOS_Drink" style="@(form.RecipeType == "POS" ? "" : "display:none;")">
                        <label class="form-label fw-semibold" for="drinkSelect">Sản phẩm POS</label>
                        <select name="DrinkId" id="drinkSelect" class="form-select">
                            <option value="">-- Chọn --</option>
                            @foreach (var drink in options.Drinks)
                            {
                                var sel = form.DrinkId.HasValue && form.DrinkId.Value == drink.Id;
                                <option value="@drink.Id" selected="@sel">@drink.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2 conditional-section" id="sectionPOS_Size" style="display:none;">
                        <label class="form-label fw-semibold" for="sizeSelect">Size</label>
                        <select name="SizeId" id="sizeSelect" class="form-select"><option value="">-- Size --</option></select>
                    </div>
                    <div class="col-md-4 conditional-section" id="sectionTopping" style="@(form.RecipeType == "TOPPING" ? "" : "display:none;")">
                        <label class="form-label fw-semibold" for="toppingSelect">Topping</label>
                        <select name="ToppingId" id="toppingSelect" class="form-select">
                            <option value="">-- Chọn --</option>
                            @foreach (var topping in options.Toppings)
                            {
                                var sel = form.ToppingId.HasValue && form.ToppingId.Value == topping.Id;
                                <option value="@topping.Id" selected="@sel">@topping.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 conditional-section" id="sectionSub_Recipe" style="@(form.RecipeType == "SUBRECIPE" ? "" : "display:none;")">
                        <label class="form-label fw-semibold" for="preparedItemSelect">Bán thành phẩm đầu ra</label>
                        @if (form.IsLegacyUnmappedSubRecipe)
                        {
                            <div class="alert alert-warning py-2 small">Dữ liệu cũ chưa liên kết BTP — bắt buộc chọn BTP, sản lượng và đơn vị tính trước khi lưu phiên bản đang hoạt động.</div>
                        }
                        <select name="PreparedItemId" id="preparedItemSelect" class="form-select" @(form.PreparedItemLocked ? "disabled" : "")>
                            <option value="">-- Chọn BTP (mã + tên) --</option>
                            @foreach (var pi in options.PreparedItems)
                            {
                                var sel = form.PreparedItemId.HasValue && form.PreparedItemId.Value == pi.PreparedItemId;
                                <option value="@pi.PreparedItemId"
                                        data-code="@pi.Code"
                                        data-name="@pi.Name"
                                        data-baseunitcode="@pi.BaseUnitCode"
                                        data-baseunitname="@pi.BaseUnitName"
                                        data-activerecipeid="@(pi.ActiveRecipeId?.ToString() ?? "")"
                                        data-hasactive="@(pi.HasActiveRecipe ? "1" : "0")"
                                        selected="@sel">
                                    [@pi.Code] @pi.Name
                                </option>
                            }
                        </select>
                        @if (form.PreparedItemLocked && form.PreparedItemId.HasValue)
                        {
                            <input type="hidden" name="PreparedItemId" value="@form.PreparedItemId" />
                            <div class="form-text">BTP cố định trong chuỗi phiên bản (không đổi).</div>
                        }
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold" for="EffectiveDate">Ngày hiệu lực</label>
                        <input name="EffectiveDate" id="EffectiveDate" class="form-control" type="date"
                               value="@(form.EffectiveDate.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Trạng thái</label>
                        <div class="form-check form-switch mt-2">
                            <input name="Active" class="form-check-input" type="checkbox" id="Active" value="true" checked="@form.Active" />
                            <label class="form-check-label" for="Active">Kích hoạt</label>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="rb-card production-form-section conditional-section" id="sectionOutput" style="@(form.RecipeType == "SUBRECIPE" ? "" : "display:none;")" aria-labelledby="editSecOutput">
            <div class="rb-card-header"><h2 id="editSecOutput" class="rb-section-title">Sản lượng đầu ra</h2></div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold" for="expectedYieldInput">Sản lượng đầu ra của một mẻ <span class="text-danger">*</span></label>
                        <input name="ExpectedYield" id="expectedYieldInput" class="form-control" type="number" step="0.00001" min="0.00001"
                               value="@(form.ExpectedYield?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                        <div class="form-text">Đây là lượng BTP thực nhận sau chế biến. Hệ thống không nhân thêm tỷ lệ thu hồi.</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold" for="outputUnitSelect">Đơn vị đầu ra</label>
                        <select name="OutputUnitId" id="outputUnitSelect" class="form-select">
                            <option value="">-- ĐVT --</option>
                            @foreach (var unit in options.Units)
                            {
                                var sel = form.OutputUnitId.HasValue && form.OutputUnitId.Value == unit.UnitId;
                                <option value="@unit.UnitId" selected="@sel">@unit.Name (@unit.UnitCode)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Xem trước kết quả chuẩn hóa</label>
                        <div id="normalizedOutputPreview" class="rb-preview-box" aria-live="polite">
                            <div class="rb-preview-sub text-muted">—</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="rb-card production-form-section" aria-labelledby="editSecComponents">
            <div class="rb-card-header d-flex justify-content-between align-items-center">
                <h2 id="editSecComponents" class="rb-section-title">Thành phần định mức</h2>
                <button type="button" class="btn btn-rb-ghost" id="btnAddRow"><i class="fas fa-plus" aria-hidden="true"></i>Thêm thành phần</button>
            </div>
            <div class="table-responsive">
                <table class="table rb-table mb-0" id="bomTable">
                    <colgroup>
                        <col class="bom-col-index" />
                        <col class="bom-col-type" />
                        <col class="bom-col-component" />
                        <col class="bom-col-quantity" />
                        <col class="bom-col-unit" />
                        <col class="bom-col-cost" />
                        <col class="bom-col-status" />
                        <col class="bom-col-action" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="text-center">#</th>
                            <th>Loại</th>
                            <th>Thành phần</th>
                            <th class="text-end">Số lượng</th>
                            <th>Đơn vị</th>
                            <th class="text-center">Giá vốn dòng</th>
                            <th class="text-center">Trạng thái dữ liệu</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="bomTableBody"></tbody>
                </table>
            </div>
        </section>

        <section class="rb-card production-form-section" aria-labelledby="editSecInstructions">
            <div class="rb-card-header"><h2 id="editSecInstructions" class="rb-section-title">Hướng dẫn chế biến</h2></div>
            <div class="card-body">
                <label class="visually-hidden" for="Description">Hướng dẫn chế biến</label>
                <textarea name="Description" id="Description" class="form-control" rows="3">@form.Description</textarea>
            </div>
        </section>
        </div>

        <aside class="production-form-sidebar" aria-label="Kiểm tra và lưu phiên bản công thức">
        <section class="rb-card production-form-section production-review-summary" aria-labelledby="editSecReview">
            <div class="rb-card-header"><h2 id="editSecReview" class="rb-section-title">Kiểm tra và lưu</h2></div>
            <div class="card-body p-3">
                <div id="costPanel" class="rb-cost-panel incomplete">
                    <div class="small text-uppercase fw-bold text-muted">Giá vốn ước tính</div>
                    <div id="displayTotalCost" class="rb-cogs-value" style="font-size:1.4rem;">—</div>
                    <div id="displayCostStatus" class="small">Tính từ các dòng đủ dữ liệu gói</div>
                    <ul class="rb-cost-issues" id="displayCostIssues" style="display:none;"></ul>
                </div>
                <input type="hidden" name="TotalCost" id="hiddenTotalCost" value="0" />
                <p class="small text-muted mt-3 mb-0">Kiểm tra thành phần và dữ liệu giá vốn trước khi tạo phiên bản mới.</p>
                <div class="production-form-actions">
                    <a asp-action="Index" class="btn btn-rb-ghost">Hủy</a>
                    <button type="submit" class="btn btn-rb-save">Lưu phiên bản mới</button>
                </div>
            </div>
        </section>
        </aside>
        </div>
    </form>
</div>
</div>

<select id="itemTemplateSelect" class="d-none" aria-hidden="true">
    <option value="">-- Chọn --</option>
    <optgroup label="Nguyên liệu thô">
        @foreach (var item in options.Ingredients)
        {
            <option value="ING_@(item.Id)"
                    data-kind="ingredient"
                    data-basecost="@item.BaseCost"
                    data-costcomplete="@(item.CostComplete ? "1" : "0")"
                    data-costmessage="@(item.CostMessage ?? "")"
                    data-baseunitcode="@(item.BaseUnitCode ?? "")"
                    data-unitid="@item.UnitId"
                    data-unitname="@item.UnitName">[@(item.Id)] @item.Name</option>
        }
    </optgroup>
    <optgroup label="Bán thành phẩm con">
        @foreach (var item in options.SubRecipes)
        {
            <option value="REC_@(item.Id)"
                    data-kind="child_recipe"
                    data-recipeid="@item.Id"
                    data-picode="@(item.PreparedItemCode ?? "")"
                    data-piname="@(item.PreparedItemName ?? "")"
                    data-basecost="0"
                    data-costcomplete="0"
                    data-costmessage="@(item.CostMessage ?? "")"
                    data-unitid="@item.UnitId"
                    data-unitname="@item.UnitName">[REC#@item.Id] @item.Name</option>
        }
    </optgroup>
</select>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/Admin/shared/admin-ajax.js" asp-append-version="true"></script>
    <script src="~/js/Admin/Recipe/bom-builder.js" asp-append-version="true"></script>
    <script>
        (function () {
            const prefills = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                (form.Details ?? new List<CafeChain.ViewModels.Admin.Recipes.RecipeDetailVM>()).Select(d => new {
                    itemCode = d.ItemCode,
                    qty = d.Quantity,
                    unitId = d.UnitId,
                    unitName = d.UnitName
                })));

            window.CafeChainBomBuilder.initCreate({
                preparedCreateUrl: '@Url.Action("Index", "AdminPreparedItem", new { area = "Admin" })',
                bomOptionsUrl: '@bomOptionsUrl',
                previewUrl: '@previewUrl',
                createUrl: '',
                indexUrl: '@Url.Action("Index")',
                sizesUrl: '@Url.Action("GetSizesByDrink")',
                initialSizeId: @(form.SizeId?.ToString() ?? "null"),
                addInitialRow: false,
                editUrlTemplate: ''
            });

            $('#bomTableBody').empty();
            if (prefills && prefills.length) {
                prefills.forEach(function (p, idx) {
                    $('#btnAddRow').click();
                    var tr = $('#bomTableBody tr').eq(idx);
                    tr.find('.item-select').val(p.itemCode).trigger('change');
                    tr.find('.item-qty').val(p.qty);
                    if (p.unitId) tr.find('.item-unitid').val(p.unitId);
                    if (p.unitName) tr.find('.item-unitname').val(p.unitName);
                });
            } else {
                $('#btnAddRow').click();
            }

            $('#btnSaveRecipe').remove();
            $('input[name="RecipeType"]:checked').trigger('change');
            if ($('#drinkSelect').val()) {
                $('#drinkSelect').trigger('change');
            }
            $('#bomTableBody .item-qty').first().trigger('input');
            window.CafeChainBomBuilder.initEdit({ previewUrl: '@previewUrl' });
        })();
    </script>
}
