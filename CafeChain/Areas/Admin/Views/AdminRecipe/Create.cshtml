@model CafeChain.ViewModels.Admin.Recipes.AdminRecipeFormPageVM
@{
    ViewData["Title"] = "Tạo công thức BOM";
    var form = Model.Form;
    var options = Model.Options;
    var preparedCreateUrl = Url.Action("Index", "AdminPreparedItem", new { area = "Admin" });
    var bomOptionsUrl = Url.Action("GetBomOptions", "AdminPreparedItem", new { area = "Admin" });
    var previewUrl = Url.Action("PreviewNormalizedOutput", "AdminRecipe", new { area = "Admin" });
    var createUrl = Url.Action("Create", "AdminRecipe", new { area = "Admin" });
    var indexUrl = Url.Action("Index", "AdminRecipe", new { area = "Admin" });
    var sizesUrl = Url.Action("GetSizesByDrink", "AdminRecipe", new { area = "Admin" });
    var editUrlTemplate = Url.Action("Edit", "AdminRecipe", new { area = "Admin", id = 0 })!.Replace("/0", "/{id}");
}

<link rel="stylesheet" href="~/css/recipe-builder.css" asp-append-version="true" />

<div class="rb-page rb-create-theme" data-theme="light">
<div class="container-fluid px-4 pt-4">
    <header class="rb-builder-heading mb-4">
        <nav class="rb-breadcrumb" aria-label="breadcrumb">
            <a asp-action="Index" class="btn-rb-back">Công thức BOM</a> &gt; <span>Tạo công thức</span>
        </nav>
        <h1 class="rb-page-title mb-1">Tạo công thức</h1>
        <p class="text-muted mb-0">Thiết lập đối tượng áp dụng, thành phần định mức và giá vốn dự kiến.</p>
    </header>

    <form method="post" id="recipeForm" novalidate>
        @Html.AntiForgeryToken()
        <div id="formErrorSummary" class="alert alert-danger" style="display:none;" role="alert" aria-live="assertive" tabindex="-1"></div>

        <div class="row g-4 rb-builder-grid">
            <div class="col-xl-8">
                <!-- A. Loại và đối tượng -->
                <section class="rb-card mb-4" aria-labelledby="secA">
                    <div class="rb-card-header"><span id="secA" class="rb-section-title">A. Loại và đối tượng công thức</span></div>
                    <div class="card-body p-4">
                        <div class="rb-toggle btn-group w-100 mb-3" role="group" aria-label="Loại công thức">
                            <input type="radio" class="btn-check" name="RecipeType" id="typePOS" value="POS" autocomplete="off" checked>
                            <label class="btn py-2 px-3" for="typePOS">Món bán (POS)</label>
                            <input type="radio" class="btn-check" name="RecipeType" id="typeTOPPING" value="TOPPING" autocomplete="off">
                            <label class="btn py-2 px-3" for="typeTOPPING">Topping</label>
                            <input type="radio" class="btn-check" name="RecipeType" id="typeSUBRECIPE" value="SUBRECIPE" autocomplete="off">
                            <label class="btn py-2 px-3" for="typeSUBRECIPE">Bán thành phẩm</label>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6 conditional-section" id="sectionPOS_Drink">
                                <label class="form-label fw-semibold" for="drinkSelect">Thức uống áp dụng <span class="text-danger">*</span></label>
                                <select name="DrinkId" id="drinkSelect" class="form-select">
                                    <option value="">-- Chọn sản phẩm --</option>
                                    @foreach (var drink in options.Drinks)
                                    {
                                        <option value="@drink.Id">@drink.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3 conditional-section" id="sectionPOS_Size" style="display:none;">
                                <label class="form-label fw-semibold" for="sizeSelect">Size <span class="text-danger">*</span></label>
                                <select name="SizeId" id="sizeSelect" class="form-select">
                                    <option value="">-- Size --</option>
                                </select>
                                <small class="text-muted" id="sizePriceHint"></small>
                            </div>
                            <div class="col-md-6 conditional-section" id="sectionTopping" style="display:none;">
                                <label class="form-label fw-semibold" for="toppingSelect">Topping áp dụng <span class="text-danger">*</span></label>
                                <select name="ToppingId" id="toppingSelect" class="form-select">
                                    <option value="">-- Chọn topping --</option>
                                    @foreach (var topping in options.Toppings)
                                    {
                                        <option value="@topping.Id">@topping.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12 conditional-section" id="sectionSub_Recipe" style="display:none;">
                                <label class="form-label fw-semibold" for="preparedItemSelect">Bán thành phẩm đầu ra <span class="text-danger">*</span></label>
                                <div class="d-flex flex-wrap gap-2 align-items-start">
                                    <div class="flex-grow-1" style="min-width:220px;">
                                        <select name="PreparedItemId" id="preparedItemSelect" class="form-select" aria-describedby="piHelp piSummary">
                                            <option value="">-- Chọn BTP (mã + tên) --</option>
                                            @foreach (var pi in options.PreparedItems)
                                            {
                                                <option value="@pi.PreparedItemId"
                                                        data-code="@pi.Code"
                                                        data-name="@pi.Name"
                                                        data-baseunitcode="@pi.BaseUnitCode"
                                                        data-baseunitname="@pi.BaseUnitName"
                                                        data-activerecipeid="@(pi.ActiveRecipeId?.ToString() ?? "")"
                                                        data-activerecipecode="@(pi.ActiveRecipeCode ?? "")"
                                                        data-activerecipename="@(pi.ActiveRecipeName ?? "")"
                                                        data-versioncount="@pi.VersionCount"
                                                        data-hasactive="@(pi.HasActiveRecipe ? "1" : "0")">
                                                    [@pi.Code] @pi.Name
                                                </option>
                                            }
                                        </select>
                                    </div>
                                    <button type="button" class="btn btn-rb-ghost btn-sm" id="btnRefreshPreparedItems" title="Làm mới danh sách BTP">Làm mới danh sách</button>
                                </div>
                                <div id="piHelp" class="form-text">
                                    Danh tính ổn định từ danh mục BTP (không dùng tên tự do, không dùng mã công thức làm đầu ra).
                                    <a href="@preparedCreateUrl" target="_blank" rel="noopener" id="linkCreatePreparedItem">Không tìm thấy BTP? Tạo bán thành phẩm</a>
                                </div>
                                <div id="piSummary" class="rb-summary-card" style="display:none;" aria-live="polite"></div>
                                <div id="piActiveConflict" class="alert alert-warning mt-2 py-2 small" style="display:none;" role="alert"></div>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-semibold" for="EffectiveDate">Ngày hiệu lực <span class="text-danger">*</span></label>
                                <input name="EffectiveDate" id="EffectiveDate" class="form-control" type="date"
                                       value="@(form.EffectiveDate.ToString("yyyy-MM-dd"))" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Trạng thái</label>
                                <div class="form-check form-switch mt-2">
                                    <input name="Active" class="form-check-input" type="checkbox" id="Active" value="true" checked="@form.Active">
                                    <label class="form-check-label" for="Active">Kích hoạt</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- B. Sản lượng đầu ra -->
                <section class="rb-card mb-4 conditional-section" id="sectionOutput" style="display:none;" aria-labelledby="secB">
                    <div class="rb-card-header"><span id="secB" class="rb-section-title">B. Sản lượng đầu ra</span></div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-4" id="sectionSub_Yield">
                                <label class="form-label fw-semibold" for="expectedYieldInput">Sản lượng đầu ra của một mẻ <span class="text-danger">*</span></label>
                                <input name="ExpectedYield" id="expectedYieldInput" class="form-control text-end" type="number" step="0.00001" min="0.00001"
                                       value="@(form.ExpectedYield?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                       aria-describedby="yieldHelp normalizedOutputPreview" />
                                <div id="yieldHelp" class="form-text">Đây là lượng BTP thực nhận sau chế biến. Hệ thống không nhân thêm tỷ lệ thu hồi.</div>
                            </div>
                            <div class="col-md-4" id="sectionSub_Unit">
                                <label class="form-label fw-semibold" for="outputUnitSelect">Đơn vị đầu ra <span class="text-danger">*</span></label>
                                <select name="OutputUnitId" id="outputUnitSelect" class="form-select" aria-describedby="normalizedOutputPreview">
                                    <option value="">-- ĐVT --</option>
                                    @foreach (var unit in options.Units)
                                    {
                                        <option value="@unit.UnitId">@unit.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Xem trước kết quả chuẩn hóa</label>
                                <div id="normalizedOutputPreview" class="rb-preview-box" aria-live="polite">
                                    <div class="rb-preview-main text-muted">—</div>
                                    <div class="rb-preview-sub">Nhập số lượng và đơn vị để xem quy đổi tồn kho.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- C. Thành phần BOM -->
                <section class="rb-card mb-4" aria-labelledby="secC">
                    <div class="rb-card-header"><span id="secC" class="rb-section-title">C. Thành phần BOM</span></div>
                    <div class="table-responsive">
                        <table class="table rb-table" id="bomTable">
                            <thead>
                                <tr>
                                    <th scope="col" class="text-center" width="4%">#</th>
                                    <th scope="col" width="12%">Loại</th>
                                    <th scope="col" width="28%">Thành phần</th>
                                    <th scope="col" class="text-end" width="12%">Số lượng</th>
                                    <th scope="col" width="12%">Đơn vị</th>
                                    <th scope="col" class="text-end" width="14%">Giá vốn dòng</th>
                                    <th scope="col" width="10%">Trạng thái dữ liệu</th>
                                    <th scope="col" class="text-center" width="8%">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody id="bomTableBody"></tbody>
                        </table>
                    </div>
                    <button type="button" class="rb-add-row" id="btnAddRow">Thêm thành phần</button>
                </section>

                <!-- Notes -->
                <section class="rb-card mb-4">
                    <div class="rb-card-header"><span class="rb-section-title">Lưu ý kỹ thuật</span></div>
                    <div class="card-body p-3">
                        <label class="visually-hidden" for="Description">Mô tả</label>
                        <textarea name="Description" id="Description" class="form-control border-0" rows="3"
                                  placeholder="VD: Pha đá trước khi cho sữa...">@form.Description</textarea>
                    </div>
                </section>
            </div>

            <!-- D. Kiểm tra và lưu (cost panel) -->
            <div class="col-xl-4">
                <section class="rb-card mb-4 sticky-top" style="top:1rem;" aria-labelledby="secD">
                    <div class="rb-card-header"><span id="secD" class="rb-section-title">D. Kiểm tra và lưu</span></div>
                    <div class="card-body p-3">
                        <div id="costPanel" class="rb-cost-panel incomplete" aria-live="polite">
                            <div class="small text-uppercase fw-bold text-muted mb-1">Giá vốn ước tính</div>
                            <div class="rb-cogs-value" id="displayTotalCost" style="font-size:1.5rem;">—</div>
                            <div class="small" id="displayCostStatus">Chưa chọn thành phần</div>
                            <ul class="rb-cost-issues" id="displayCostIssues" style="display:none;"></ul>
                            <div class="d-flex flex-wrap gap-2 mt-2" id="costCtas"></div>
                        </div>
                        <input type="hidden" name="TotalCost" id="hiddenTotalCost" value="0" />
                        <p class="small text-muted mt-3 mb-0">
                            Giá vốn chưa đầy đủ không chặn lưu nếu máy chủ cho phép. Hệ thống không hiển thị giá trị 0 không chính xác.
                        </p>
                    </div>
                </section>
            </div>
        </div>
    </form>
</div>
</div>

<div class="rb-footer-bar">
    <div class="d-flex gap-4 flex-wrap">
        <div class="rb-footer-metric">
            <span class="rb-footer-metric-label">Tổng giá vốn</span>
            <span class="rb-footer-metric-value" id="footerTotalCost">—</span>
        </div>
        <div class="rb-footer-metric">
            <span class="rb-footer-metric-label">Tỷ lệ giá vốn</span>
            <span class="rb-footer-pct" id="footerFoodCostPct">—</span>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-rb-ghost" href="@indexUrl">Hủy</a>
        <button type="button" class="btn btn-rb-save" id="btnSaveRecipe" aria-busy="false">Lưu công thức</button>
    </div>
</div>

<select id="itemTemplateSelect" class="d-none" aria-hidden="true">
    <option value="">-- Chọn thành phần --</option>
    <optgroup label="Nguyên liệu thô">
        @foreach (var item in options.Ingredients)
        {
            <option value="ING_@(item.Id)"
                    data-kind="ingredient"
                    data-label="[@(item.Id)] @(item.Name)"
                    data-basecost="@(item.BaseCost)"
                    data-costcomplete="@(item.CostComplete ? "1" : "0")"
                    data-packageprice="@(item.PackagePrice ?? 0)"
                    data-packageqty="@(item.PackageQuantity ?? 0)"
                    data-packageunit="@(item.PackageUnitCode ?? "")"
                    data-baseunitcode="@(item.BaseUnitCode ?? "")"
                    data-costmessage="@(item.CostMessage ?? "")"
                    data-unitid="@(item.UnitId)"
                    data-unitname="@(item.UnitName)">[@(item.Id)] @(item.Name)</option>
        }
    </optgroup>
    <optgroup label="Bán thành phẩm con (cố định phiên bản công thức)">
        @foreach (var item in options.SubRecipes)
        {
            var piPart = item.PreparedItemCode != null
                ? $"BTP: [{item.PreparedItemCode}] {item.PreparedItemName}"
                : "BTP: (chưa map)";
            <option value="REC_@(item.Id)"
                    data-kind="child_recipe"
                    data-label="[REC@(item.Id)] @(item.Name) · phiên bản #@(item.Id)"
                    data-recipeid="@(item.Id)"
                    data-recipecode="@(item.RecipeCode ?? "")"
                    data-picode="@(item.PreparedItemCode ?? "")"
                    data-piname="@(item.PreparedItemName ?? "")"
                    data-basecost="0"
                    data-costcomplete="0"
                    data-costmessage="@(item.CostMessage ?? "")"
                    data-unitid="@(item.UnitId)"
                    data-unitname="@(item.UnitName)"
                    data-baseunitcode="@(item.OutputUnitCode ?? "")">
                [REC#@(item.Id)] @(item.Name) · @piPart
            </option>
        }
    </optgroup>
</select>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/Admin/shared/admin-ajax.js" asp-append-version="true"></script>
    <script src="~/js/Admin/Recipe/bom-builder.js" asp-append-version="true"></script>
    <script>
        window.CafeChainBomBuilder.initCreate({
            preparedCreateUrl: '@preparedCreateUrl',
            bomOptionsUrl: '@bomOptionsUrl',
            previewUrl: '@previewUrl',
            createUrl: '@createUrl',
            indexUrl: '@indexUrl',
            sizesUrl: '@sizesUrl',
            editUrlTemplate: '@editUrlTemplate'
        });
    </script>
}
