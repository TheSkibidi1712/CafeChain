@model CafeChain.ViewModels.Admin.Recipes.AdminRecipeFormPageVM
@using CafeChain.ViewModels.Admin.Shared
@using Microsoft.Extensions.Localization
@using System.Text.Json
@inject IStringLocalizer<CafeChain.ProductResource> ProductText
@{
    ViewData["Title"] = ProductText["Recipe.Create.PageTitle"];
    var form = Model.Form;
    var options = Model.Options;
    var preparedCreateUrl = Url.Action("Index", "AdminPreparedItem", new { area = "Admin" });
    var bomOptionsUrl = Url.Action("GetBomOptions", "AdminPreparedItem", new { area = "Admin" });
    var previewUrl = Url.Action("PreviewNormalizedOutput", "AdminRecipe", new { area = "Admin" });
    var createUrl = Url.Action("Create", "AdminRecipe", new { area = "Admin" });
    var indexUrl = Url.Action("Index", "AdminRecipe", new { area = "Admin" });
    var sizesUrl = Url.Action("GetSizesByDrink", "AdminRecipe", new { area = "Admin" });
    var editUrlTemplate = Url.Action("Edit", "AdminRecipe", new { area = "Admin", id = 0 })!.Replace("/0", "/{id}");
    var recipeJsCatalog = JsonSerializer.Serialize(ProductText.GetAllStrings()
        .Where(message => message.Name.StartsWith("Recipe.", StringComparison.Ordinal))
        .ToDictionary(message => message.Name, message => message.Value));
    var hero = new AdminPageHeroVM
    {
        Eyebrow = ProductText["Recipe.Eyebrow"],
        Title = ProductText["Recipe.Create.Title"],
        Description = ProductText["Recipe.Create.Description"],
        IconClass = "fas fa-flask",
        Breadcrumbs =
        [
            new() { Label = ProductText["Recipe.List"], Url = indexUrl },
            new() { Label = ProductText["Recipe.CreateNew"] }
        ],
        Actions =
        [
            new() { Label = ProductText["Recipe.Back"], Url = indexUrl ?? "#", IconClass = "fas fa-arrow-left" }
        ]
    };
}

<link rel="stylesheet" href="~/css/recipe-builder.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Admin/production-bom-ui.css" asp-append-version="true" />

<div class="rb-page rb-create-theme production-bom-page production-bom-shell recipe-form-page">
<div class="container-fluid px-0">
    <partial name="_PageHero" model="hero" />

    <form method="post" id="recipeForm" class="production-recipe-form" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" name="Active" value="true" />
        <div id="formErrorSummary" class="alert alert-danger" style="display:none;" role="alert" aria-live="assertive" tabindex="-1"></div>

        <div class="production-form-grid rb-builder-grid">
            <div class="production-form-main">
                <!-- A. Loại và đối tượng -->
                <section class="rb-card production-form-section" aria-labelledby="secA">
                    <div class="rb-card-header"><h2 id="secA" class="rb-section-title">@ProductText["Recipe.Identity"]</h2></div>
                    <div class="card-body p-4">
                        <div class="rb-toggle btn-group w-100 mb-3" role="group" aria-label="@ProductText["Recipe.Type"]">
                            <input type="radio" class="btn-check" name="RecipeType" id="typePOS" value="POS" autocomplete="off" checked>
                            <label class="btn py-2 px-3" for="typePOS">@ProductText["Recipe.Type.Pos"]</label>
                            <input type="radio" class="btn-check" name="RecipeType" id="typeTOPPING" value="TOPPING" autocomplete="off">
                            <label class="btn py-2 px-3" for="typeTOPPING">Topping</label>
                            <input type="radio" class="btn-check" name="RecipeType" id="typeSUBRECIPE" value="SUBRECIPE" autocomplete="off">
                            <label class="btn py-2 px-3" for="typeSUBRECIPE">@ProductText["Recipe.Type.Subrecipe"]</label>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6 conditional-section" id="sectionPOS_Drink">
                                <label class="form-label fw-semibold" for="drinkSelect">@ProductText["Recipe.Drink"] <span class="text-danger">*</span></label>
                                <select name="DrinkId" id="drinkSelect" class="form-select">
                                    <option value="">@ProductText["Recipe.SelectProduct"]</option>
                                    @foreach (var drink in options.Drinks)
                                    {
                                        <option value="@drink.Id">@drink.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3 conditional-section" id="sectionPOS_Size" style="display:none;">
                                <label class="form-label fw-semibold" for="sizeSelect">Size <span class="text-danger">*</span></label>
                                <select name="SizeId" id="sizeSelect" class="form-select">
                                    <option value="">-- Size --</option>
                                </select>
                                <small class="text-muted" id="sizePriceHint"></small>
                            </div>
                            <div class="col-md-6 conditional-section" id="sectionTopping" style="display:none;">
                                <label class="form-label fw-semibold" for="toppingSelect">@ProductText["Recipe.Topping"] <span class="text-danger">*</span></label>
                                <select name="ToppingId" id="toppingSelect" class="form-select">
                                    <option value="">@ProductText["Recipe.SelectTopping"]</option>
                                    @foreach (var topping in options.Toppings)
                                    {
                                        <option value="@topping.Id">@topping.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12 conditional-section" id="sectionSub_Recipe" style="display:none;">
                                <label class="form-label fw-semibold" for="preparedItemSelect">@ProductText["Recipe.PreparedItem"] <span class="text-danger">*</span></label>
                                <div class="production-field-with-action">
                                    <div>
                                        <select name="PreparedItemId" id="preparedItemSelect" class="form-select" aria-describedby="piHelp piSummary">
                                            <option value="">@ProductText["Recipe.SelectPrepared"]</option>
                                            @foreach (var pi in options.PreparedItems)
                                            {
                                                <option value="@pi.PreparedItemId"
                                                        data-code="@pi.Code"
                                                        data-name="@pi.Name"
                                                        data-baseunitcode="@pi.BaseUnitCode"
                                                        data-baseunitname="@pi.BaseUnitName"
                                                        data-activerecipeid="@(pi.ActiveRecipeId?.ToString() ?? "")"
                                                        data-activerecipecode="@(pi.ActiveRecipeCode ?? "")"
                                                        data-activerecipename="@(pi.ActiveRecipeName ?? "")"
                                                        data-versioncount="@pi.VersionCount"
                                                        data-hasactive="@(pi.HasActiveRecipe ? "1" : "0")">
                                                    [@pi.Code] @pi.Name
                                                </option>
                                            }
                                        </select>
                                    </div>
                                    <button type="button" class="btn btn-rb-ghost" id="btnRefreshPreparedItems" title="@ProductText["Recipe.RefreshPrepared"]">
                                        <i class="fas fa-rotate" aria-hidden="true"></i><span>@ProductText["Recipe.Refresh"]</span>
                                    </button>
                                </div>
                                <div id="piHelp" class="form-text">
                                    @ProductText["Recipe.PreparedIdentityHint"]
                                    <a href="@preparedCreateUrl" target="_blank" rel="noopener" id="linkCreatePreparedItem">@ProductText["Recipe.CreatePrepared"]</a>
                                </div>
                                <div id="piSummary" class="rb-summary-card" style="display:none;" aria-live="polite"></div>
                                <div id="piActiveConflict" class="alert alert-warning mt-2 py-2 small" style="display:none;" role="alert"></div>
                            </div>

                        </div>
                    </div>
                </section>

                <!-- B. Sản lượng đầu ra -->
                <section class="rb-card production-form-section conditional-section" id="sectionOutput" style="display:none;" aria-labelledby="secB">
                    <div class="rb-card-header"><h2 id="secB" class="rb-section-title">@ProductText["Recipe.Output"]</h2></div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-4" id="sectionSub_Yield">
                                <label class="form-label fw-semibold" for="expectedYieldInput">@ProductText["Recipe.ExpectedYield"] <span class="text-danger">*</span></label>
                                <input name="ExpectedYield" id="expectedYieldInput" class="form-control text-end" type="number" step="0.00001" min="0.00001"
                                       value="@(form.ExpectedYield?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                       aria-describedby="yieldHelp normalizedOutputPreview" />
                                <div id="yieldHelp" class="form-text">@ProductText["Recipe.YieldHint"]</div>
                            </div>
                            <div class="col-md-4" id="sectionSub_Unit">
                                <label class="form-label fw-semibold" for="outputUnitSelect">@ProductText["Recipe.OutputUnit"] <span class="text-danger">*</span></label>
                                <select name="OutputUnitId" id="outputUnitSelect" class="form-select" aria-describedby="normalizedOutputPreview">
                                    <option value="">@ProductText["Recipe.SelectUnit"]</option>
                                    @foreach (var unit in options.Units)
                                    {
                                        <option value="@unit.UnitId">@unit.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">@ProductText["Recipe.NormalizedPreview"]</label>
                                <div id="normalizedOutputPreview" class="rb-preview-box" aria-live="polite">
                                    <div class="rb-preview-main text-muted">—</div>
                                    <div class="rb-preview-sub">@ProductText["Recipe.NormalizedHint"]</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- C. Thành phần BOM -->
                <section class="rb-card production-form-section" aria-labelledby="secC">
                    <div class="rb-card-header"><h2 id="secC" class="rb-section-title">@ProductText["Recipe.Components"]</h2></div>
                    <div class="table-responsive">
                        <table class="table rb-table" id="bomTable">
                            <colgroup>
                                <col class="bom-col-index" />
                                <col class="bom-col-type" />
                                <col class="bom-col-component" />
                                <col class="bom-col-quantity" />
                                <col class="bom-col-unit" />
                                <col class="bom-col-cost" />
                                <col class="bom-col-status" />
                                <col class="bom-col-action" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th scope="col" class="text-center">#</th>
                                    <th scope="col">@ProductText["Recipe.Column.Type"]</th>
                                    <th scope="col">@ProductText["Recipe.Column.Component"]</th>
                                    <th scope="col" class="text-end">@ProductText["Recipe.Column.Quantity"]</th>
                                    <th scope="col">@ProductText["Recipe.Column.Unit"]</th>
                                    <th scope="col" class="text-end">@ProductText["Recipe.Column.LineCost"]</th>
                                    <th scope="col">@ProductText["Recipe.Column.DataStatus"]</th>
                                    <th scope="col" class="text-end">@ProductText["Recipe.Column.Actions"]</th>
                                </tr>
                            </thead>
                            <tbody id="bomTableBody"></tbody>
                        </table>
                    </div>
                    <button type="button" class="rb-add-row" id="btnAddRow"><i class="fas fa-plus" aria-hidden="true"></i>@ProductText["Recipe.AddComponent"]</button>
                </section>

                <!-- Notes -->
                <section class="rb-card production-form-section">
                    <div class="rb-card-header"><h2 class="rb-section-title">@ProductText["Recipe.Instructions"]</h2></div>
                    <div class="card-body p-3">
                        <label class="visually-hidden" for="Description">@ProductText["Recipe.DescriptionLabel"]</label>
                        <textarea name="Description" id="Description" class="form-control border-0" rows="3"
                                  placeholder="@ProductText["Recipe.DescriptionPlaceholder"]">@form.Description</textarea>
                    </div>
                </section>
            </div>

            <!-- D. Kiểm tra và lưu (cost panel) -->
            <aside class="production-form-sidebar" aria-label="@ProductText["Recipe.ReviewAria"]">
                <section class="rb-card production-form-section production-review-summary" aria-labelledby="secD">
                    <div class="rb-card-header"><h2 id="secD" class="rb-section-title">@ProductText["Recipe.Review"]</h2></div>
                    <div class="card-body p-3">
                        <div class="production-publication-review" aria-live="polite">
                            <div class="small text-uppercase fw-bold text-muted">@ProductText["Recipe.PublishNow"]</div>
                            <dl class="production-publication-review-list">
                                <div><dt>@ProductText["Recipe.Target"]</dt><dd id="publicationTarget">@ProductText["Recipe.NotSelected"]</dd></div>
                                <div><dt>@ProductText["Recipe.Output"]</dt><dd id="publicationOutput">@ProductText["Recipe.Unknown"]</dd></div>
                                <div><dt>@ProductText["Recipe.Bom"]</dt><dd id="publicationBomSummary">@ProductText["Recipe.NoComponents"]</dd></div>
                            </dl>
                            <div id="publicationChangeSummary" class="production-publication-changes">
                                @ProductText["Recipe.AppliedImmediately"]
                            </div>
                        </div>
                        <div id="costPanel" class="rb-cost-panel incomplete" aria-live="polite">
                            <div class="small text-uppercase fw-bold text-muted mb-1">@ProductText["Recipe.EstimatedCost"]</div>
                            <div class="rb-cogs-value" id="displayTotalCost" style="font-size:1.5rem;">—</div>
                            <div class="small" id="displayCostStatus">@ProductText["Recipe.NoComponentSelected"]</div>
                            <ul class="rb-cost-issues" id="displayCostIssues" style="display:none;"></ul>
                            <div class="d-flex flex-wrap gap-2 mt-2" id="costCtas"></div>
                        </div>
                        <input type="hidden" name="TotalCost" id="hiddenTotalCost" value="0" />
                        <p class="small text-muted mt-3 mb-0">
                            @ProductText["Recipe.CostWarning"]
                        </p>
                        <div class="production-review-metrics" aria-label="@ProductText["Recipe.CostSummaryAria"]">
                            <div class="production-review-metric">
                                <span>@ProductText["Recipe.TotalCost"]</span>
                                <span id="footerTotalCost">—</span>
                            </div>
                            <div class="production-review-metric">
                                <span>@ProductText["Recipe.CostRatio"]</span>
                                <span id="footerFoodCostPct">—</span>
                            </div>
                        </div>
                        <div class="production-form-actions">
                            <a class="btn btn-rb-ghost" href="@indexUrl">@ProductText["Common.Cancel"]</a>
                            <button type="button" class="btn btn-rb-save" id="btnSaveRecipe" aria-busy="false">@ProductText["Recipe.SaveApply"]</button>
                        </div>
                    </div>
                </section>
            </aside>
        </div>
    </form>
</div>
</div>

<select id="itemTemplateSelect" class="d-none" aria-hidden="true">
    <option value="">@ProductText["Recipe.SelectComponent"]</option>
    <optgroup label="@ProductText["Recipe.RawIngredients"]">
        @foreach (var item in options.Ingredients)
        {
            <option value="ING_@(item.Id)"
                    data-kind="ingredient"
                    data-label="[@(item.Id)] @(item.Name)"
                    data-basecost="@(item.BaseCost)"
                    data-costcomplete="@(item.CostComplete ? "1" : "0")"
                    data-packageprice="@(item.PackagePrice ?? 0)"
                    data-packageqty="@(item.PackageQuantity ?? 0)"
                    data-packageunit="@(item.PackageUnitCode ?? "")"
                    data-baseunitcode="@(item.BaseUnitCode ?? "")"
                    data-costmessage="@(item.CostMessage ?? "")"
                    data-unitid="@(item.UnitId)"
                    data-unitname="@(item.UnitName)">[@(item.Id)] @(item.Name)</option>
        }
    </optgroup>
    <optgroup label="@ProductText["Recipe.ChildPreparedVersion"]">
        @foreach (var item in options.SubRecipes)
        {
            var piPart = item.PreparedItemCode != null
                ? $"BTP: [{item.PreparedItemCode}] {item.PreparedItemName}"
                : ProductText["Recipe.UnmappedPrepared"].Value;
            <option value="REC_@(item.Id)"
                    data-kind="child_recipe"
                    data-label="[REC@(item.Id)] @(item.Name) · @ProductText["Recipe.Version", item.Id]"
                    data-recipeid="@(item.Id)"
                    data-recipecode="@(item.RecipeCode ?? "")"
                    data-picode="@(item.PreparedItemCode ?? "")"
                    data-piname="@(item.PreparedItemName ?? "")"
                    data-basecost="@item.BaseCost"
                    data-costcomplete="@(item.CostComplete ? "1" : "0")"
                    data-costmessage="@(item.CostMessage ?? "")"
                    data-unitid="@(item.UnitId)"
                    data-unitname="@(item.UnitName)"
                    data-baseunitcode="@item.UnitName">
                [REC#@(item.Id)] @(item.Name) · @piPart
            </option>
        }
    </optgroup>
</select>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script id="recipeUiCatalog" type="application/json">@Html.Raw(recipeJsCatalog)</script>
    <script src="~/js/Admin/shared/admin-ajax.js" asp-append-version="true"></script>
    <script src="~/js/Admin/Recipe/bom-builder.js" asp-append-version="true"></script>
    <script>
        window.CafeChainBomBuilder.initCreate({
            preparedCreateUrl: '@preparedCreateUrl',
            bomOptionsUrl: '@bomOptionsUrl',
            previewUrl: '@previewUrl',
            createUrl: '@createUrl',
            indexUrl: '@indexUrl',
            sizesUrl: '@sizesUrl',
            editUrlTemplate: '@editUrlTemplate',
            sourceLines: [],
            isNewVersion: false
        });
    </script>
}
