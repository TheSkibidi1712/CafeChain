@model CafeChain.ViewModels.Admin.Recipes.RecipeVersionCompareVM
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<CafeChain.ProductResource> ProductText
@{
    ViewData["Title"] = ProductText["Recipe.Compare.PageTitle", Model.BusinessName];
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="~/css/Admin/production-bom-ui.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Admin/Recipe/recipe-workspace.css" asp-append-version="true" />

<main class="production-bom-page production-bom-shell recipe-workspace-page recipe-compare-page">
    <div class="container-fluid px-0">
        <header class="recipe-compare__header">
            <div>
                <span class="recipe-workspace__eyebrow">@Model.TargetLabel</span>
                <h1>@ProductText["Recipe.Compare.Title"] · @Model.BusinessName</h1>
                <p>@ProductText["Recipe.Compare.Description"]</p>
            </div>
            <a asp-action="Visualize" asp-route-recipeId="@Model.To.RecipeId" class="btn btn-rb-outline">
                <i class="fas fa-arrow-left" aria-hidden="true"></i>
                @ProductText["Recipe.Compare.Back"]
            </a>
        </header>

        <section class="recipe-compare__versions" aria-label="@ProductText["Recipe.Compare.VersionsAria"]">
            <article>
                <span>@ProductText["Recipe.Compare.BeforeVersion"]</span>
                <strong>@ProductText["Recipe.Compare.Version", Model.From.RecipeId]</strong>
                <small>@ProductText[Model.From.IsCurrent ? "Recipe.Health.CURRENT" : "Recipe.Health.HISTORICAL"]</small>
                <dl>
                    <div><dt>@ProductText["Recipe.Compare.Output"]</dt><dd>@Model.From.OutputDisplay</dd></div>
                    <div><dt>@ProductText["Recipe.Compare.DesignCost"]</dt><dd>@(Model.From.DesignCost.HasValue ? $"{Model.From.DesignCost:N0} ₫" : ProductText["Recipe.Compare.InsufficientData"])</dd></div>
                    <div><dt>@ProductText["Recipe.Compare.CostData"]</dt><dd>@ProductText[Model.From.CostComplete ? "Recipe.Compare.CostComplete" : "Recipe.Compare.CostIncomplete"]</dd></div>
                </dl>
            </article>
            <div class="recipe-compare__direction" aria-hidden="true"><i class="fas fa-arrow-right"></i></div>
            <article>
                <span>@ProductText["Recipe.Compare.AfterVersion"]</span>
                <strong>@ProductText["Recipe.Compare.Version", Model.To.RecipeId]</strong>
                <small>@ProductText[Model.To.IsCurrent ? "Recipe.Health.CURRENT" : "Recipe.Health.HISTORICAL"]</small>
                <dl>
                    <div><dt>@ProductText["Recipe.Compare.Output"]</dt><dd>@Model.To.OutputDisplay</dd></div>
                    <div><dt>@ProductText["Recipe.Compare.DesignCost"]</dt><dd>@(Model.To.DesignCost.HasValue ? $"{Model.To.DesignCost:N0} ₫" : ProductText["Recipe.Compare.InsufficientData"])</dd></div>
                    <div><dt>@ProductText["Recipe.Compare.CostData"]</dt><dd>@ProductText[Model.To.CostComplete ? "Recipe.Compare.CostComplete" : "Recipe.Compare.CostIncomplete"]</dd></div>
                </dl>
            </article>
        </section>

        <section class="recipe-workspace__surface recipe-compare__summary" aria-labelledby="compare-summary-title">
            <header class="recipe-workspace__section-heading bom-section-heading">
                <span class="recipe-workspace__section-icon"><i class="fas fa-scale-balanced" aria-hidden="true"></i></span>
                <div>
                    <h2 id="compare-summary-title">@ProductText["Recipe.Compare.SummaryTitle"]</h2>
                    <p>@ProductText["Recipe.Compare.SummaryHint"]</p>
                </div>
            </header>
            <div class="recipe-compare__summary-grid">
                <article><span>@ProductText["Recipe.Compare.Output"]</span><strong>@(Model.OutputChanged ? $"{Model.From.OutputDisplay} → {Model.To.OutputDisplay}" : ProductText["Recipe.Compare.Unchanged"])</strong></article>
                <article><span>@ProductText["Recipe.Compare.CostData"]</span><strong>@ProductText[Model.From.CostComplete == Model.To.CostComplete ? (Model.To.CostComplete ? "Recipe.Compare.CostComplete" : "Recipe.Compare.CostIncomplete") : "Recipe.Compare.CostChanged"]</strong></article>
                <article>
                    <span>@ProductText["Recipe.Compare.DesignCostDelta"]</span>
                    <strong>@(Model.DesignCostDelta.HasValue ? $"{Model.DesignCostDelta.Value:+#,##0;-#,##0;0} ₫" : ProductText["Recipe.Compare.Indeterminate"])</strong>
                </article>
            </div>
        </section>

        <section class="recipe-workspace__surface recipe-compare__lines" aria-labelledby="compare-lines-title">
            <header class="recipe-workspace__section-heading bom-section-heading">
                <span class="recipe-workspace__section-icon"><i class="fas fa-list-check" aria-hidden="true"></i></span>
                <div>
                    <h2 id="compare-lines-title">@ProductText["Recipe.Compare.LineChanges"]</h2>
                    <p>@ProductText["Recipe.Compare.LineChangesHint"]</p>
                </div>
            </header>
            @if (!Model.HasLineChanges)
            {
                <div class="recipe-workspace__history-empty">@ProductText["Recipe.Compare.NoLineChanges"]</div>
            }
            else
            {
                var groups = new[]
                {
                    (Title: ProductText["Recipe.Compare.AddedLines"].Value, Css: "is-added", Items: Model.AddedLines),
                    (Title: ProductText["Recipe.Compare.RemovedLines"].Value, Css: "is-removed", Items: Model.RemovedLines),
                    (Title: ProductText["Recipe.Compare.ChangedLines"].Value, Css: "is-changed", Items: Model.ChangedLines)
                };
                <div class="recipe-compare__change-groups">
                    @foreach (var group in groups.Where(x => x.Items.Count > 0))
                    {
                        <section class="recipe-compare__change-group @group.Css">
                            <h3>@group.Title <span>@group.Items.Count</span></h3>
                            @foreach (var line in group.Items)
                            {
                                <article>
                                    <div>
                                        <span>@ProductText[$"Recipe.Compare.InputType.{line.InputTypeCode}"]</span>
                                        <strong>@line.BusinessName</strong>
                                        @if (!string.IsNullOrWhiteSpace(line.TechnicalCode))
                                        {
                                            <small>@ProductText["Recipe.Compare.Code"]: @line.TechnicalCode</small>
                                        }
                                    </div>
                                    <dl>
                                        <div><dt>@ProductText["Recipe.Compare.Before"]</dt><dd>@(line.BeforeQuantity ?? ProductText["Common.None"])</dd></div>
                                        <div><dt>@ProductText["Recipe.Compare.After"]</dt><dd>@(line.AfterQuantity ?? ProductText["Common.None"])</dd></div>
                                        <div><dt>@ProductText["Recipe.Compare.NormalizedBefore"]</dt><dd>@(line.BeforeNormalizedQuantity ?? ProductText["Recipe.Compare.NoData"])</dd></div>
                                        <div><dt>@ProductText["Recipe.Compare.NormalizedAfter"]</dt><dd>@(line.AfterNormalizedQuantity ?? ProductText["Recipe.Compare.NoData"])</dd></div>
                                    </dl>
                                    <p>@string.Join(", ", line.ChangeCodes.Select(code => ProductText[$"Recipe.Compare.Change.{code}"].Value))</p>
                                </article>
                            }
                        </section>
                    }
                </div>
            }
        </section>
    </div>
</main>
