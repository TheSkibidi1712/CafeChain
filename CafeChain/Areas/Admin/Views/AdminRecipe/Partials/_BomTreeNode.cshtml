@model CafeChain.ViewModels.Admin.Recipes.RecipeBomTreeNodeVM
@using CafeChain.ViewModels.Admin.Recipes

@if (Model.Kind == RecipeBomTreeNodeKind.DepthLimit)
{
    <li class="list-group-item text-danger">
        <i class="fas fa-exclamation-triangle me-2" aria-hidden="true"></i>@Model.Message
    </li>
}
else if (Model.Kind == RecipeBomTreeNodeKind.CycleDetected)
{
    <li class="list-group-item text-danger">
        <i class="fas fa-sync-alt me-2" aria-hidden="true"></i>@Model.Message
    </li>
}
else if (Model.Kind == RecipeBomTreeNodeKind.Ingredient)
{
    <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-3 py-2 border-bottom-dashed">
        <div><i class="fas fa-leaf text-success me-2" aria-hidden="true"></i> @Model.DisplayName</div>
        <span class="badge bg-light text-dark border">@Model.Quantity @Model.UnitName</span>
    </li>
}
else if (Model.Kind == RecipeBomTreeNodeKind.ChildRecipe)
{
    <li class="list-group-item bg-transparent px-3 py-2 border-bottom-dashed">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="fw-bold text-primary">
                <i class="fas fa-flask text-warning me-2" aria-hidden="true"></i> @Model.DisplayName
            </div>
            <span class="badge bg-warning text-dark">@Model.Quantity @Model.UnitName</span>
        </div>
        @if (Model.Children != null && Model.Children.Count > 0)
        {
            <div class="ms-4 ps-2 border-start border-warning">
                <ul class="list-group list-group-flush mb-0">
                    @foreach (var child in Model.Children)
                    {
                        <partial name="Partials/_BomTreeNode" model="child" />
                    }
                </ul>
            </div>
        }
    </li>
}
