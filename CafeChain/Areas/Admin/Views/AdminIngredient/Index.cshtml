@model List<CafeChain.Application.DTOs.Admin.Ingredients.AdminIngredientDTO>
@using System.Security.Claims
@using CafeChain.Application.Constants
@using CafeChain.Application.Interfaces.Admin.Permissions
@inject IAdminPermissionService IngredientPermissionService
@{
    var accountId = int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var parsedAccountId)
        ? parsedAccountId : 0;
    var permissions = (await IngredientPermissionService.GetEffectivePermissionCodesAsync(accountId)).Data
        ?? new HashSet<string>(StringComparer.Ordinal);
    var canCreate = permissions.Contains(PermissionConstants.IngredientCreate);
    var canUpdate = permissions.Contains(PermissionConstants.IngredientUpdate);
    var canToggle = permissions.Contains(PermissionConstants.IngredientToggleStatus);
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-white-orange-forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/Ingredient/ingredient.css" asp-append-version="true" />
}

<main class="ingredient-page cc-warehouse-page">
    <form id="ingredientAntiForgeryForm" class="d-none">@Html.AntiForgeryToken()</form>

    <header class="ingredient-page-header cc-warehouse-header">
        <div class="ingredient-page-header-copy">
            <p class="ingredient-eyebrow">Kho &amp; Cung ứng / Nguyên liệu</p>
            <h1><i class="fa-solid fa-mortar-pestle me-2 text-warning" aria-hidden="true"></i>Quản lý nguyên liệu</h1>
            <p class="ingredient-subtitle">Danh mục nguyên liệu, đơn vị gốc và quản lý liên kết quy đổi của hệ thống CafeChain.</p>
        </div>
        @if (canCreate)
        {
            <button type="button" class="ingredient-btn ingredient-btn-primary" id="btnCreate">
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
                Thêm nguyên liệu
            </button>
        }
    </header>

    <div class="ingredient-toolbar cc-warehouse-filter" aria-label="Bộ lọc nguyên liệu">
        <div class="ingredient-filter-heading">
            <div>
                <span>Phạm vi dữ liệu</span>
                <strong>Bộ lọc nguyên liệu</strong>
            </div>
            <span class="ingredient-filter-scope"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i>Theo quyền truy cập</span>
        </div>
        <div class="ingredient-filter-grid">
            <label class="ingredient-search">
                <span>Tìm kiếm nguyên liệu</span>
                <span class="ingredient-search-control">
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                    <input id="searchBox" value="@ViewBag.Search" type="search" placeholder="Nhập mã hoặc tên nguyên liệu..." autocomplete="off" />
                </span>
            </label>
            <label class="ingredient-filter-field">
                <span>Trạng thái</span>
                <select id="statusFilter">
                    <option value="" selected="@(string.IsNullOrEmpty(ViewBag.Status?.ToString()))">Tất cả trạng thái</option>
                    <option value="true" selected="@(ViewBag.Status?.ToString() == "True")">Hoạt động</option>
                    <option value="false" selected="@(ViewBag.Status?.ToString() == "False")">Ngưng hoạt động</option>
                </select>
            </label>
            <div class="ingredient-filter-actions">
                <button type="button" class="ingredient-btn ingredient-btn-light" id="btnReset">Đặt lại</button>
                <button type="button" class="ingredient-btn ingredient-btn-primary" id="btnFilter">
                    <i class="fa-solid fa-filter" aria-hidden="true"></i>
                    Lọc
                </button>
            </div>
        </div>
        <div class="ingredient-filter-result">
            <span class="ingredient-result-count">
                Hiển thị <strong>@Model.Count</strong> nguyên liệu
                @if (!string.IsNullOrEmpty(ViewBag.Search?.ToString()))
                {
                    <span> cho "<em>@ViewBag.Search</em>"</span>
                }
            </span>
        </div>
    </div>

    <div class="ingredient-workspace">
        <section class="ingredient-list-panel" aria-label="Danh sách nguyên liệu">
            <div class="ingredient-list-heading">
                <div class="ingredient-list-heading-main">
                    <span class="ingredient-list-heading-icon" aria-hidden="true">
                        <i class="fa-solid fa-flask"></i>
                    </span>
                    <div class="ingredient-list-heading-copy">
                        <span class="ingredient-list-kicker">Danh mục vật lý</span>
                        <h2>Nguyên liệu trong hệ thống</h2>
                    </div>
                </div>
                <span class="ingredient-list-total" aria-label="Tổng cộng @Model.Count nguyên liệu">
                    <strong>@Model.Count</strong>
                    <span>Nguyên liệu</span>
                </span>
            </div>

            <div class="ingredient-table-scroll cc-warehouse-table-shell">
                <table class="ingredient-table">
                    <colgroup>
                        <col class="ingredient-col-code" />
                        <col class="ingredient-col-name" />
                        <col class="ingredient-col-unit" />
                        <col class="ingredient-col-status" />
                        <col class="ingredient-col-action" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Mã NL</th>
                            <th>Tên nguyên liệu</th>
                            <th>Đơn vị gốc</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="ingredientTable">
                        @foreach (var item in Model)
                        {
                            <tr data-id="@item.IngredientId">
                                <td>
                                    <span class="ing-code">@item.Code</span>
                                </td>
                                <td>
                                    <div class="ingredient-name-cell">
                                        <span class="ingredient-row-icon"><i class="fa-solid fa-leaf" aria-hidden="true"></i></span>
                                        <strong>@item.Name</strong>
                                    </div>
                                </td>
                                <td>
                                    <span class="unit-badge">@item.BaseUnitName</span>
                                </td>
                                <td class="text-center">
                                    <span class="ingredient-status @(item.Active ? "is-active" : "is-inactive")">
                                        <i class="fa-solid fa-circle ingredient-status-dot" aria-hidden="true"></i> @(item.Active ? "Hoạt động" : "Ngưng")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="ingredient-table-actions">
                                        @if (canUpdate)
                                        {
                                            <button type="button" class="ingredient-btn ingredient-btn-light edit-btn"
                                                    data-id="@item.IngredientId"
                                                    title="Chỉnh sửa nguyên liệu @item.Name"
                                                    aria-label="Chỉnh sửa @item.Name">
                                                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i> Sửa
                                            </button>
                                        }
                                        @if (canToggle)
                                        {
                                            <button type="button" class="ingredient-btn @(item.Active ? "ingredient-btn-danger" : "ingredient-btn-success") toggle-btn"
                                                    data-id="@item.IngredientId"
                                                    title="@(item.Active ? "Ngưng hoạt động" : "Kích hoạt")"
                                                    aria-label="@(item.Active ? "Ngưng hoạt động" : "Kích hoạt") @item.Name">
                                                <i class="fa-solid @(item.Active ? "fa-ban" : "fa-circle-check")" aria-hidden="true"></i>
                                                @(item.Active ? "Ngưng" : "Kích hoạt")
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="ingredient-empty cc-warehouse-empty" role="status">
                                    <i class="fa-solid fa-box-open ingredient-empty-icon" aria-hidden="true"></i>
                                    <h2>Chưa có nguyên liệu</h2>
                                    <p>Thêm nguyên liệu đầu tiên để cấu hình đơn vị, nguồn cung và công thức.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (ViewBag.TotalPages > 1)
            {
                <nav class="ingredient-pagination" aria-label="Phân trang nguyên liệu">
                    @if (ViewBag.Page > 1)
                    {
                        <a class="ingredient-page-link" href="?search=@ViewBag.Search&status=@ViewBag.Status&page=@(ViewBag.Page - 1)" title="Trang trước">
                            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i> Trước
                        </a>
                    }
                    <span>Trang <strong>@ViewBag.Page</strong> / @ViewBag.TotalPages</span>
                    @if (ViewBag.Page < ViewBag.TotalPages)
                    {
                        <a class="ingredient-page-link" href="?search=@ViewBag.Search&status=@ViewBag.Status&page=@(ViewBag.Page + 1)" title="Trang sau">
                            Sau <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                        </a>
                    }
                </nav>
            }
        </section>
    </div>
</main>


<div id="ingredientModal" class="modal fade" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content modal-box">

        <div class="modal-header">
            <div class="d-flex align-items-center gap-2">
                <div class="ingredient-row-icon">
                    <i class="fas fa-flask" aria-hidden="true"></i>
                </div>
                <h5 id="modalTitle">Nguyên liệu</h5>
            </div>
            <button type="button" class="close-btn" id="btnClose" data-bs-dismiss="modal" aria-label="Đóng hộp thoại nguyên liệu">
                <i class="fas fa-times" aria-hidden="true"></i>
            </button>
        </div>

        <div class="modal-body admin-wo-page">
            <input type="hidden" id="ingredientId" />

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label">Mã nguyên liệu <span class="text-danger">*</span></label>
                    <input id="code" class="form-control" placeholder="VD: NL001" />
                </div>
                <div class="col-md-8">
                    <label class="form-label">Tên nguyên liệu <span class="text-danger">*</span></label>
                    <input id="name" class="form-control" placeholder="Nhập tên nguyên liệu..." />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Đơn vị gốc <span class="text-danger">*</span></label>
                <select id="baseUnitId" class="form-select">
                    <option value="">-- Chọn đơn vị --</option>
                </select>
                <div class="form-text"><i class="fas fa-info-circle me-1 text-warning"></i>Đây là đơn vị cơ sở để tính toán quy đổi.</div>
            </div>

            <div class="alert alert-light border mt-3 mb-0">
                Quy đổi đơn vị được quản lý riêng để tránh thay đổi ngoài ý muốn khi sửa nguyên liệu.
                <a asp-controller="AdminUnitConversion" asp-action="Index" class="alert-link ms-1">
                    Mở Đơn vị và quy đổi
                </a>
            </div>
        </div>

        <div class="modal-footer">
            <button id="btnClose2" type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                <i class="fas fa-times me-1"></i> Đóng
            </button>
            <button type="button" id="btnSave" class="btn btn-primary px-4">
                <i class="fas fa-save me-1"></i> Lưu nguyên liệu
            </button>
        </div>
    </div>
    </div>
</div>

@section Scripts {
    <script>
        // Ghi đè hàm toast toàn cục: Bắt tín hiệu có thông báo thành công và lưu vào sessionStorage trước khi trình duyệt kịp reload
        var _originalToast = window.toast;
        window.toast = function(message, type, options) {
            if (message && (message.includes('Đã cập nhật trạng thái') || type === 'success')) {
                sessionStorage.setItem('showSuccessToast', message);
            }
            if (typeof _originalToast === 'function') {
                _originalToast(message, type, options);
            }
        };

        document.addEventListener('DOMContentLoaded', function() {
            var msg = sessionStorage.getItem('showSuccessToast');
            if (msg) {
                sessionStorage.removeItem('showSuccessToast');
                // Gọi lại bản gốc để tránh đệ quy vòng lặp nếu window.toast đang trỏ vào hàm ghi đè
                if (typeof _originalToast === 'function') {
                    _originalToast(msg, 'success');
                } else if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        title: 'Thành công',
                        text: msg,
                        icon: 'success',
                        timer: 2000,
                        showConfirmButton: false
                    });
                }
            }
        });
    </script>
    <script src="~/js/Admin/Ingredient/ingredient.js" asp-append-version="true"></script>
}
