@model List<CafeChain.Application.DTOs.Admin.Ingredients.AdminIngredientDTO>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link rel="stylesheet" href="~/css/Admin/Ingredient/ingredient.css" />

<div class="container mt-4">

    <div class="d-flex justify-content-between mb-3">
        <h3>Quản lý nguyên liệu</h3>
        <button type="button" class="btn btn-primary" id="btnCreate">+ Thêm</button>
    </div>

    <!-- FILTER -->
    <div class="row mb-3">
        <div class="col-md-4">
            <input id="searchBox"
                   class="form-control"
                   placeholder="Tìm..."
                   value="@ViewBag.Search" />
        </div>

        <div class="col-md-3">
            <select id="statusFilter" class="form-select">
                <option value="">-- Trạng thái --</option>

                <option value="true"
                        selected="@(ViewBag.Status?.ToString() == "True")">
                    Hoạt động
                </option>

                <option value="false"
                        selected="@(ViewBag.Status?.ToString() == "False")">
                    Ngưng
                </option>
            </select>
        </div>

        <div class="col-md-2">
            <button class="btn btn-dark w-100" id="btnFilter">
                Lọc
            </button>
        </div>
    </div>

    <!-- TABLE -->
    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Mã</th>
                <th>Tên</th>
                <th>Đơn vị</th>
                <th>Trạng thái</th>
                <th width="120"></th>
            </tr>
        </thead>
        <tbody id="ingredientTable">
            @foreach (var item in Model)
            {
                <tr data-id="@item.IngredientId">
                    <td>@item.Code</td>
                    <td>@item.Name</td>
                    <td>@item.BaseUnitName</td>
                    <td>
                        <span class="badge @(item.Active ? "bg-success" : "bg-danger")">
                            @(item.Active ? "Hoạt động" : "Ngưng")
                        </span>
                    </td>
                    <td class="text-center">
                        <i class="fa fa-edit text-primary action-icon edit-btn"
                           data-id="@item.IngredientId"></i>

                        <i class="fa fa-lock text-warning action-icon toggle-btn"
                           data-id="@item.IngredientId"></i>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="pagination">

        @if (ViewBag.Page > 1)
        {
            <a class="page-btn"
                   href="?search=@ViewBag.Search&status=@ViewBag.Status&page=@(ViewBag.Page - 1)">
                ←
            </a>
        }

        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <a class="page-btn @(i == ViewBag.Page ? "active" : "")"
                   href="?search=@ViewBag.Search&status=@ViewBag.Status&page=@i">
                @i
            </a>
        }

        @if (ViewBag.Page < ViewBag.TotalPages)
        {
            <a class="page-btn"
                   href="?search=@ViewBag.Search&status=@ViewBag.Status&page=@(ViewBag.Page + 1)">
                →
            </a>
        }

    </div>
</div>

<!-- MODAL -->
<div id="ingredientModal" class="custom-modal">
    <div class="modal-box">

        <div class="modal-header">
            <h5 id="modalTitle"></h5>
            <span class="close-btn" id="btnClose">✖</span>
        </div>

        <div class="modal-body">

            <input type="hidden" id="ingredientId" />

            <label>Mã</label>
            <input id="code" class="form-control mb-2" />

            <label>Tên</label>
            <input id="name" class="form-control mb-2" />

            <label>Đơn vị gốc</label>
            <select id="baseUnitId" class="form-control mb-3"></select>

            <div class="d-flex justify-content-between">
                <b>Quy đổi</b>
                <button class="btn btn-sm btn-success" id="btnAddRow">+</button>
            </div>

            <table class="table mt-2">
                <thead>
                    <tr>
                        <th>From</th>
                        <th>SL</th>
                        <th>To</th>
                        <th>SL</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="conversionTable"></tbody>
            </table>
        </div>

        <div class="modal-footer">
            <button type="button" id="btnSave" class="btn btn-success">Lưu</button>
            <button id="btnClose2" class="btn btn-secondary">Đóng</button>
        </div>
    </div>
</div>



<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="~/js/Admin/Ingredient/ingredient.js"></script>