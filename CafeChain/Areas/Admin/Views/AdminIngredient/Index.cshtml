@model List<CafeChain.Application.DTOs.Admin.Ingredients.AdminIngredientDTO>
@using System.Security.Claims
@using CafeChain.Application.Constants
@using CafeChain.Application.Interfaces.Admin.Permissions
@using Microsoft.Extensions.Localization
@using System.Text.Json
@inject IAdminPermissionService IngredientPermissionService
@inject IStringLocalizer<InventoryResource> L
@{
    var accountId = int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var parsedAccountId)
        ? parsedAccountId : 0;
    var permissions = (await IngredientPermissionService.GetEffectivePermissionCodesAsync(accountId)).Data
        ?? new HashSet<string>(StringComparer.Ordinal);
    var canCreate = permissions.Contains(PermissionConstants.IngredientCreate);
    var canUpdate = permissions.Contains(PermissionConstants.IngredientUpdate);
    var canToggle = permissions.Contains(PermissionConstants.IngredientToggleStatus);
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-white-orange-forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/Ingredient/ingredient.css" asp-append-version="true" />
}

<main class="ingredient-page cc-warehouse-page">
    <form id="ingredientAntiForgeryForm" class="d-none">@Html.AntiForgeryToken()</form>

    <header class="ingredient-page-header cc-warehouse-header">
        <div class="ingredient-page-header-copy">
            <p class="ingredient-eyebrow">@L["Ingredient.Eyebrow"]</p>
            <h1><i class="fa-solid fa-mortar-pestle me-2 text-warning" aria-hidden="true"></i>@L["Ingredient.Title"]</h1>
            <p class="ingredient-subtitle">@L["Ingredient.Subtitle"]</p>
        </div>
        @if (canCreate)
        {
            <button type="button" class="ingredient-btn ingredient-btn-primary" id="btnCreate">
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
                @L["Ingredient.AddButton"]
            </button>
        }
    </header>

    <div class="ingredient-toolbar cc-warehouse-filter" aria-label="@L["Ingredient.FilterAria"]">
        <div class="ingredient-filter-heading">
            <div>
                <span>@L["Ingredient.DataScope"]</span>
                <strong>@L["Ingredient.FilterHeading"]</strong>
            </div>
            <span class="ingredient-filter-scope"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i>@L["Ingredient.Scope"]</span>
        </div>
        <div class="ingredient-filter-grid">
            <label class="ingredient-search">
                <span>@L["Ingredient.SearchLabel"]</span>
                <span class="ingredient-search-control">
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                    <input id="searchBox" value="@ViewBag.Search" type="search" placeholder="@L["Ingredient.SearchPlaceholder"]" autocomplete="off" />
                </span>
            </label>
            <label class="ingredient-filter-field">
                <span>@L["Common.Status"]</span>
                <select id="statusFilter">
                    <option value="" selected="@(string.IsNullOrEmpty(ViewBag.Status?.ToString()))">@L["Common.AllStatuses"]</option>
                    <option value="true" selected="@(ViewBag.Status?.ToString() == "True")">@L["Common.Active"]</option>
                    <option value="false" selected="@(ViewBag.Status?.ToString() == "False")">@L["Common.Inactive"]</option>
                </select>
            </label>
            <div class="ingredient-filter-actions">
                <button type="button" class="ingredient-btn ingredient-btn-light" id="btnReset">@L["Common.Reset"]</button>
                <button type="button" class="ingredient-btn ingredient-btn-primary" id="btnFilter">
                    <i class="fa-solid fa-filter" aria-hidden="true"></i>
                    @L["Common.Filter"]
                </button>
            </div>
        </div>
        <div class="ingredient-filter-result">
            <span class="ingredient-result-count">
                @Html.Raw(L["Ingredient.ResultCount", Model.Count].Value)
                @if (!string.IsNullOrEmpty(ViewBag.Search?.ToString()))
                {
                    <span>@L["Ingredient.ResultSearchSuffix"] "<em>@ViewBag.Search</em>"</span>
                }
            </span>
        </div>
    </div>

    <div class="ingredient-workspace">
        <section class="ingredient-list-panel" aria-label="@L["Ingredient.ListAria"]">
            <div class="ingredient-list-heading">
                <div class="ingredient-list-heading-main">
                    <span class="ingredient-list-heading-icon" aria-hidden="true">
                        <i class="fa-solid fa-flask"></i>
                    </span>
                    <div class="ingredient-list-heading-copy">
                        <span class="ingredient-list-kicker">@L["Ingredient.ListKicker"]</span>
                        <h2>@L["Ingredient.ListHeading"]</h2>
                    </div>
                </div>
                <span class="ingredient-list-total" aria-label="@L["Ingredient.TotalAria", Model.Count]">
                    <strong>@Model.Count</strong>
                    <span>@L["Ingredient.TotalLabel"]</span>
                </span>
            </div>

            <div class="ingredient-table-scroll cc-warehouse-table-shell">
                <table class="ingredient-table">
                    <colgroup>
                        <col class="ingredient-col-code" />
                        <col class="ingredient-col-name" />
                        <col class="ingredient-col-unit" />
                        <col class="ingredient-col-status" />
                        <col class="ingredient-col-action" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>@L["Ingredient.Col.Code"]</th><th>@L["Ingredient.Col.Name"]</th><th>@L["Ingredient.Col.Unit"]</th><th class="text-center">@L["Common.Status"]</th><th class="text-center">@L["Common.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody id="ingredientTable">
                        @foreach (var item in Model)
                        {
                            <tr data-id="@item.IngredientId">
                                <td>
                                    <span class="ing-code">@item.Code</span>
                                </td>
                                <td>
                                    <div class="ingredient-name-cell">
                                        <span class="ingredient-row-icon"><i class="fa-solid fa-leaf" aria-hidden="true"></i></span>
                                        <strong>@item.Name</strong>
                                    </div>
                                </td>
                                <td>
                                    <span class="unit-badge">@item.BaseUnitName</span>
                                </td>
                                <td class="text-center">
                                    <span class="ingredient-status @(item.Active ? "is-active" : "is-inactive")">
                                        <i class="fa-solid fa-circle ingredient-status-dot" aria-hidden="true"></i> @(item.Active ? L["Ingredient.RowStatus.Active"] : L["Ingredient.RowStatus.Inactive"])
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="ingredient-table-actions">
                                        @if (canUpdate)
                                        {
                                            <button type="button" class="ingredient-btn ingredient-btn-light edit-btn"
                                                    data-id="@item.IngredientId"
                                                    title="@L["Ingredient.EditTitle", item.Name]"
                                                    aria-label="@L["Ingredient.EditAria", item.Name]">
                                                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i> @L["Ingredient.Edit"]
                                            </button>
                                        }
                                        @if (canToggle)
                                        {
                                            <button type="button" class="ingredient-btn @(item.Active ? "ingredient-btn-danger" : "ingredient-btn-success") toggle-btn"
                                                    data-id="@item.IngredientId"
                                                    title="@(item.Active ? L["Ingredient.Toggle.Inactive"] : L["Ingredient.Toggle.Active"])"
                                                    aria-label="@L["Ingredient.ToggleAria", item.Active ? L["Ingredient.Toggle.Inactive"] : L["Ingredient.Toggle.Active"], item.Name]">
                                                <i class="fa-solid @(item.Active ? "fa-ban" : "fa-circle-check")" aria-hidden="true"></i>
                                                @(item.Active ? L["Ingredient.Toggle.Inactive"] : L["Ingredient.Toggle.Active"])
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="ingredient-empty cc-warehouse-empty" role="status">
                                    <i class="fa-solid fa-box-open ingredient-empty-icon" aria-hidden="true"></i>
                                    <h2>@L["Ingredient.EmptyTitle"]</h2><p>@L["Ingredient.EmptyCopy"]</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (ViewBag.TotalPages > 1)
            {
                <nav class="ingredient-pagination" aria-label="@L["Ingredient.PaginationAria"]">
                    @if (ViewBag.Page > 1)
                    {
                        <a class="ingredient-page-link" href="?search=@ViewBag.Search&status=@ViewBag.Status&page=@(ViewBag.Page - 1)" title="@L["Common.PreviousPage"]">
                            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i> @L["Common.Previous"]
                        </a>
                    }
                    <span>@Html.Raw(L["Ingredient.PageInfo", ViewBag.Page, ViewBag.TotalPages].Value)</span>
                    @if (ViewBag.Page < ViewBag.TotalPages)
                    {
                        <a class="ingredient-page-link" href="?search=@ViewBag.Search&status=@ViewBag.Status&page=@(ViewBag.Page + 1)" title="@L["Common.NextPage"]">
                            @L["Common.Next"] <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                        </a>
                    }
                </nav>
            }
        </section>
    </div>
</main>


<div id="ingredientModal" class="modal fade" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content modal-box">

        <div class="modal-header">
            <div class="d-flex align-items-center gap-2">
                <div class="ingredient-row-icon">
                    <i class="fas fa-flask" aria-hidden="true"></i>
                </div>
                <h5 id="modalTitle">@L["Ingredient.ModalTitle"]</h5>
            </div>
            <button type="button" class="close-btn" id="btnClose" data-bs-dismiss="modal" aria-label="@L["Ingredient.ModalCloseAria"]">
                <i class="fas fa-times" aria-hidden="true"></i>
            </button>
        </div>

        <div class="modal-body admin-wo-page">
            <input type="hidden" id="ingredientId" />

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label">@L["Ingredient.Col.Code"] <span class="text-danger">*</span></label>
                    <input id="code" class="form-control" placeholder="@L["Ingredient.CodePlaceholder"]" />
                </div>
                <div class="col-md-8">
                    <label class="form-label">@L["Ingredient.Col.Name"] <span class="text-danger">*</span></label>
                    <input id="name" class="form-control" placeholder="@L["Ingredient.NamePlaceholder"]" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">@L["Ingredient.Col.Unit"] <span class="text-danger">*</span></label>
                <select id="baseUnitId" class="form-select">
                    <option value="">@L["Ingredient.UnitSelectPlaceholder"]</option>
                </select>
                <div class="form-text"><i class="fas fa-info-circle me-1 text-warning"></i>@L["Ingredient.UnitHelp"]</div>
            </div>

            <div class="alert alert-light border mt-3 mb-0">
                @L["Ingredient.UnitManageNote"]
                <a asp-controller="AdminUnitConversion" asp-action="Index" class="alert-link ms-1">
                    @L["Ingredient.UnitManageLink"]
                </a>
            </div>
        </div>

        <div class="modal-footer">
            <button id="btnClose2" type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                <i class="fas fa-times me-1"></i> @L["Common.Cancel"]
            </button>
            <button type="button" id="btnSave" class="btn btn-primary px-4">
                <i class="fas fa-save me-1"></i> @L["Ingredient.SaveButton"]
            </button>
        </div>
    </div>
    </div>
</div>

@section Scripts {
    <script id="ingredient-ui-catalog" type="application/json">@Html.Raw(JsonSerializer.Serialize(L.GetAllStrings().Where(x => x.Name.StartsWith("Ingredient.Js.") || x.Name.StartsWith("Common.")).ToDictionary(x => x.Name, x => x.Value)))</script>
    <script>
        const ingredientCatalog = CafeChainUiCatalog.read('ingredient-ui-catalog');
        const ingredientText = (key, values) => CafeChainUiCatalog.text(ingredientCatalog, key, values);
        // Ghi đè hàm toast toàn cục: Bắt tín hiệu có thông báo thành công và lưu vào sessionStorage trước khi trình duyệt kịp reload
        var _originalToast = window.toast;
        window.toast = function(message, type, options) {
            if (message && type === 'success') {
                sessionStorage.setItem('showSuccessToast', message);
            }
            if (typeof _originalToast === 'function') {
                _originalToast(message, type, options);
            }
        };

        document.addEventListener('DOMContentLoaded', function() {
            var msg = sessionStorage.getItem('showSuccessToast');
            if (msg) {
                sessionStorage.removeItem('showSuccessToast');
                // Gọi lại bản gốc để tránh đệ quy vòng lặp nếu window.toast đang trỏ vào hàm ghi đè
                if (typeof _originalToast === 'function') {
                    _originalToast(msg, 'success');
                } else if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        title: ingredientText('Common.Success'),
                        text: msg,
                        icon: 'success',
                        timer: 2000,
                        showConfirmButton: false
                    });
                }
            }
        });
    </script>
    <script src="~/js/Admin/Ingredient/ingredient.js" asp-append-version="true"></script>
}
