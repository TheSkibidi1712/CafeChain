@using CafeChain.Application.Constants
@using CafeChain.Application.DTOs.Admin.Actor
@using CafeChain.Application.DTOs.Admin.Procurement
@using CafeChain.ViewModels.Admin.Shared
@model IReadOnlyList<PurchaseOrderBatchListItemDto>
@{
    ViewData["Title"] = "Đơn đặt hàng gộp";
    var actor = ViewBag.Actor as AdminActorContext ?? new AdminActorContext();
    var statusFilter = ViewBag.Status as string;
}
@section Styles { <link rel="stylesheet" href="~/css/Admin/PurchaseAdvice/purchase-advice.css" asp-append-version="true" /> }

<main class="pa-page">
    <header class="pa-header">
        <div><div class="pa-eyebrow">Kho &amp; Cung ứng / Đơn đặt hàng gộp</div><h1>Đơn đặt hàng gộp</h1><p class="pa-subtitle">Theo dõi đơn tổng hợp gửi Nhà cung cấp và tiến độ giao về từng chi nhánh.</p></div>
        <a class="pa-action pa-action-primary" asp-controller="AdminPurchaseAdviceConsolidation" asp-action="Index"><i class="fas fa-layer-group"></i> Tổng hợp đề nghị mua</a>
    </header>
    @if (TempData["Error"] is string error) { <div class="pa-alert" role="alert">@error</div> }
    @if (TempData["Success"] is string success) { <div class="pa-alert pa-alert-success" role="status">@success</div> }

    <form method="get" class="pa-band pa-actions pa-list-filter">
        <div class="pa-field pa-filter-status"><label for="status">Trạng thái</label><select id="status" name="status"><option value="">Tất cả</option>@foreach (var value in new[] { PurchaseOrderBatchStatuses.PendingApproval, PurchaseOrderBatchStatuses.Approved, PurchaseOrderBatchStatuses.PdfGenerated, PurchaseOrderBatchStatuses.SentToSupplier, PurchaseOrderBatchStatuses.PartiallyReceived, PurchaseOrderBatchStatuses.Completed, PurchaseOrderBatchStatuses.Cancelled }) { <option value="@value" selected="@(statusFilter == value)">@AdminStatusDisplay.PurchaseOrderBatch(value).Label</option> }</select></div>
        <button class="pa-action" type="submit"><i class="fas fa-filter"></i> Áp dụng</button>
    </form>

    <div class="pa-table-wrap">
        <table class="pa-table pa-batch-list-table">
            <thead><tr><th>Mã đơn gộp</th><th>Nhà cung cấp</th><th>Tiến độ</th><th>Chi nhánh</th><th>Khoảng giao</th><th class="pa-number">Giá trị</th><th></th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    @{ var batchStatus = AdminStatusDisplay.PurchaseOrderBatch(item.Status); }
                    <td><a class="pa-code" asp-action="Details" asp-route-id="@item.PurchaseOrderBatchId">@item.BatchNumber</a><div class="pa-muted">Tạo @AdminStatusDisplay.DateTime(item.CreatedAtUtc.ToLocalTime())</div></td>
                    <td><strong>@item.SupplierName</strong></td>
                    <td><span class="pa-badge @batchStatus.CssClass">@batchStatus.Label</span></td>
                    <td>@item.StoreCount chi nhánh</td>
                    <td>@AdminStatusDisplay.Date(item.ExpectedDeliveryFrom) - @AdminStatusDisplay.Date(item.ExpectedDeliveryTo)</td>
                    <td class="pa-number"><strong>@AdminStatusDisplay.Currency(item.TotalAmount)</strong></td>
                    <td><a class="pa-action pa-action-compact" asp-action="Details" asp-route-id="@item.PurchaseOrderBatchId">Xem chi tiết <i class="fas fa-arrow-right"></i></a></td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="7" class="pa-empty"><i class="fas fa-box-open"></i><strong>Chưa có đơn đặt hàng gộp phù hợp</strong><span>Tạo đơn đặt hàng gộp từ màn hình Tổng hợp đề nghị mua.</span></td></tr> }
            </tbody>
        </table>
    </div>
</main>
