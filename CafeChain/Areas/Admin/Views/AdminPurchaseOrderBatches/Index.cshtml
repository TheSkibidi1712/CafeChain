@using CafeChain.Application.Constants
@using CafeChain.Application.DTOs.Admin.Actor
@using CafeChain.Application.DTOs.Admin.Procurement
@using CafeChain.ViewModels.Admin.Shared
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ProcurementResource> L
@model IReadOnlyList<PurchaseOrderBatchListItemDto>
@{
    ViewData["Title"] = L["PurchaseOrderBatch.Title"];
    var actor = ViewBag.Actor as AdminActorContext ?? new AdminActorContext();
    var statusFilter = ViewBag.Status as string;
}
@section Styles { <link rel="stylesheet" href="~/css/Admin/PurchaseAdvice/purchase-advice.css" asp-append-version="true" /> }

<main class="pa-page pa-batch-index-page cc-warehouse-page">
    <header class="pa-header cc-warehouse-header">
        <div><div class="pa-eyebrow">@L["PurchaseOrderBatch.Eyebrow"]</div><h1><i class="fa-solid fa-cubes me-2 text-warning" aria-hidden="true"></i>@L["PurchaseOrderBatch.Title"]</h1><p class="pa-subtitle">@L["PurchaseOrderBatch.Subtitle"]</p></div>
        <a class="pa-action pa-action-primary" asp-controller="AdminPurchaseAdviceConsolidation" asp-action="Index"><i class="fas fa-layer-group"></i> @L["PurchaseOrderBatch.Consolidate"]</a>
    </header>
    @if (TempData["Error"] is string error) { <div class="pa-alert" role="alert">@error</div> }
    @if (TempData["Success"] is string success) { <div class="pa-alert pa-alert-success" role="status">@success</div> }

    <form method="get" class="pa-band pa-actions pa-list-filter cc-warehouse-filter">
        <div class="pa-field pa-filter-status"><label for="status">@L["Common.Status"]</label><select id="status" name="status"><option value="">@L["Common.All"]</option>@foreach (var value in new[] { PurchaseOrderBatchStatuses.PendingApproval, PurchaseOrderBatchStatuses.Approved, PurchaseOrderBatchStatuses.PdfGenerated, PurchaseOrderBatchStatuses.SentToSupplier, PurchaseOrderBatchStatuses.PartiallyReceived, PurchaseOrderBatchStatuses.Completed, PurchaseOrderBatchStatuses.Cancelled }) { <option value="@value" selected="@(statusFilter == value)">@L[$"Status.{value}"]</option> }</select></div>
        <div class="pa-field pa-field-button"><label class="pa-field-spacer">&nbsp;</label><button class="pa-action" type="submit"><i class="fas fa-filter"></i> @L["Common.Apply"]</button></div>
    </form>

    <div class="pa-table-wrap cc-warehouse-table-shell">
        <table class="pa-table pa-batch-list-table">
            <thead><tr><th>@L["PurchaseOrderBatch.Code"]</th><th>@L["Common.Supplier"]</th><th>@L["PurchaseOrderBatch.Progress"]</th><th>@L["Common.Branch"]</th><th>@L["PurchaseOrderBatch.DeliveryWindow"]</th><th class="pa-number">@L["Common.Value"]</th><th></th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    @{ var batchStatus = AdminStatusDisplay.PurchaseOrderBatch(item.Status); }
                    <td><a class="pa-code" asp-action="Details" asp-route-id="@item.PurchaseOrderBatchId">@item.BatchNumber</a><div class="pa-muted">@L["Common.CreatedAt", AdminStatusDisplay.DateTime(item.CreatedAtUtc.ToLocalTime())]</div></td>
                    <td><strong>@item.SupplierName</strong></td>
                    <td><span class="pa-badge @batchStatus.CssClass">@L[$"Status.{item.Status}"]</span></td>
                    <td>@L["PurchaseOrderBatch.BranchCount", item.StoreCount]</td>
                    <td>@AdminStatusDisplay.Date(item.ExpectedDeliveryFrom) - @AdminStatusDisplay.Date(item.ExpectedDeliveryTo)</td>
                    <td class="pa-number"><strong>@AdminStatusDisplay.Currency(item.TotalAmount)</strong></td>
                    <td><a class="pa-action pa-action-compact" asp-action="Details" asp-route-id="@item.PurchaseOrderBatchId">@L["Common.Details"] <i class="fas fa-arrow-right"></i></a></td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="7" class="pa-empty" role="status"><i class="fas fa-box-open"></i><strong>@L["PurchaseOrderBatch.EmptyTitle"]</strong><span>@L["PurchaseOrderBatch.EmptyCopy"]</span></td></tr> }
            </tbody>
        </table>
    </div>
</main>
