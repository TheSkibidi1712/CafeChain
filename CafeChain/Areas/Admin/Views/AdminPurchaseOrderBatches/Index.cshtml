@using CafeChain.Application.Constants
@using CafeChain.Application.DTOs.Admin.Actor
@using CafeChain.Application.DTOs.Admin.Procurement
@model IReadOnlyList<PurchaseOrderBatchListItemDto>
@{
    ViewData["Title"] = "Batch đơn mua";
    var actor = ViewBag.Actor as AdminActorContext ?? new AdminActorContext();
    var statusFilter = ViewBag.Status as string;
    string StatusLabel(string value) => value switch
    {
        PurchaseOrderBatchStatuses.PendingApproval => "Chờ duyệt",
        PurchaseOrderBatchStatuses.Approved => "Đã duyệt",
        PurchaseOrderBatchStatuses.PdfGenerated => "PDF đã tạo",
        PurchaseOrderBatchStatuses.SentToSupplier => "Đã gửi NCC",
        PurchaseOrderBatchStatuses.PartiallyReceived => "Đã nhận một phần",
        PurchaseOrderBatchStatuses.Completed => "Hoàn tất",
        PurchaseOrderBatchStatuses.Cancelled => "Đã hủy",
        _ => value
    };
}
@section Styles { <link rel="stylesheet" href="~/css/Admin/PurchaseAdvice/purchase-advice.css" asp-append-version="true" /> }

<main class="pa-page">
    <header class="pa-header">
        <div><div class="pa-eyebrow">Kho &amp; Cung ứng / Đơn mua gộp</div><h1>Batch đơn mua</h1><p class="pa-subtitle">Theo dõi một đơn đặt hàng nhà cung cấp và tiến độ giao về từng cửa hàng.</p></div>
        <a class="pa-action pa-action-primary" asp-controller="AdminPurchaseAdviceConsolidation" asp-action="Index"><i class="fas fa-layer-group"></i> Tổng hợp PA</a>
    </header>
    @if (TempData["Error"] is string error) { <div class="pa-alert" role="alert">@error</div> }
    @if (TempData["Success"] is string success) { <div class="pa-alert pa-alert-success" role="status">@success</div> }

    <form method="get" class="pa-band pa-actions pa-list-filter">
        <div class="pa-field pa-filter-status"><label for="status">Trạng thái</label><select id="status" name="status"><option value="">Tất cả</option>@foreach (var value in new[] { PurchaseOrderBatchStatuses.PendingApproval, PurchaseOrderBatchStatuses.Approved, PurchaseOrderBatchStatuses.PdfGenerated, PurchaseOrderBatchStatuses.SentToSupplier, PurchaseOrderBatchStatuses.PartiallyReceived, PurchaseOrderBatchStatuses.Completed, PurchaseOrderBatchStatuses.Cancelled }) { <option value="@value" selected="@(statusFilter == value)">@StatusLabel(value)</option> }</select></div>
        <button class="pa-action" type="submit"><i class="fas fa-filter"></i> Áp dụng</button>
    </form>

    <div class="pa-table-wrap">
        <table class="pa-table pa-batch-list-table">
            <thead><tr><th>Mã batch</th><th>Nhà cung cấp</th><th>Tiến độ</th><th>Chi nhánh</th><th>Khoảng giao</th><th class="pa-number">Giá trị</th><th></th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><a class="pa-code" asp-action="Details" asp-route-id="@item.PurchaseOrderBatchId">@item.BatchNumber</a><div class="pa-muted">Tạo @item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div></td>
                    <td><strong>@item.SupplierName</strong></td>
                    <td><span class="pa-badge pa-batch-status-@item.Status.ToLowerInvariant()">@StatusLabel(item.Status)</span></td>
                    <td>@item.StoreCount cửa hàng</td>
                    <td>@item.ExpectedDeliveryFrom.ToString("dd/MM") - @item.ExpectedDeliveryTo.ToString("dd/MM/yyyy")</td>
                    <td class="pa-number"><strong>@item.TotalAmount.ToString("N0") đ</strong></td>
                    <td><a class="pa-action pa-action-compact" asp-action="Details" asp-route-id="@item.PurchaseOrderBatchId">Xem chi tiết <i class="fas fa-arrow-right"></i></a></td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="7" class="pa-empty"><i class="fas fa-box-open"></i><strong>Chưa có batch phù hợp</strong><span>Tạo batch từ màn hình PA chờ tổng hợp.</span></td></tr> }
            </tbody>
        </table>
    </div>
</main>
