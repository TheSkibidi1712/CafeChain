@using CafeChain.Application.Constants
@using CafeChain.Application.DTOs.Admin.Procurement
@using CafeChain.ViewModels.Admin.Shared
@using Microsoft.Extensions.Localization
@using System.Text.Json
@inject IStringLocalizer<ProcurementResource> L
@model PurchaseOrderBatchDetailPageDto
@{
    ViewData["Title"] = L["PurchaseOrderBatch.Details.Title", Model.Batch.BatchNumber];
    var batch = Model.Batch;
    var canDocument = ViewBag.CanDocument is true;
    var canApprove = ViewBag.CanApprove is true
        && batch.CreatedByStaffId != Model.Actor.StaffId
        && batch.Status == PurchaseOrderBatchStatuses.PendingApproval;
    var canCancel = ViewBag.CanCancel is true && batch.Status is not PurchaseOrderBatchStatuses.Completed and not PurchaseOrderBatchStatuses.Cancelled;
    var canGenerate = canDocument && PurchaseOrderBatchStatuses.ApprovedOrLater.Contains(batch.Status);
    var latestRevision = Model.DocumentRevisions.OrderByDescending(x => x.RevisionNumber).FirstOrDefault();
    var sendableRevision = Model.DocumentRevisions.FirstOrDefault(x => x.Status == PurchaseOrderBatchDocumentStatuses.Generated);
}
@section Styles { <link rel="stylesheet" href="~/css/Admin/PurchaseAdvice/purchase-advice.css" asp-append-version="true" /> }

<main class="pa-page pa-batch-detail-page cc-warehouse-page">
<header class="pa-header cc-warehouse-header cc-warehouse-header--compact cc-warehouse-header--detail">
        <div><div class="pa-eyebrow">@batch.BatchNumber · @AdminStatusDisplay.PurchaseOrderBatch(batch.Status).Label</div><h1>@batch.SupplierName</h1><p class="pa-subtitle">@L["PurchaseOrderBatch.Details.Subtitle", AdminStatusDisplay.Date(batch.ExpectedDeliveryFrom), AdminStatusDisplay.Date(batch.ExpectedDeliveryTo), batch.StoreCount]</p></div>
        <div class="pa-actions">
            <a class="pa-action" asp-action="Index"><i class="fas fa-arrow-left"></i> @L["PurchaseOrderBatch.Details.BackList"]</a>
            @if (canApprove) { <form asp-action="Approve" asp-route-id="@batch.PurchaseOrderBatchId" method="post" data-loading-form>@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@batch.RowVersion" /><button class="pa-action pa-action-primary" type="submit" data-submit-label="@L["PurchaseOrderBatch.Details.Approving"]"><i class="fas fa-check"></i> @L["PurchaseOrderBatch.Details.Approve"]</button></form> }
        </div>
    </header>
    @if (TempData["Error"] is string error) { <div class="pa-alert" role="alert">@error <a href="" class="pa-alert-link">@L["Common.ReloadData"]</a></div> }
    @if (TempData["Success"] is string success) { <div class="pa-alert pa-alert-success" role="status">@success</div> }
    @if (batch.Status == PurchaseOrderBatchStatuses.SentToSupplier) { <div class="pa-info-band"><i class="fas fa-circle-info"></i><div><strong>@L["PurchaseOrderBatch.Details.SentNoticeTitle"]</strong><span>@L["PurchaseOrderBatch.Details.SentNoticeCopy"]</span></div></div> }

    <section class="pa-batch-metrics">
        <div><span>@L["PurchaseOrderBatch.Details.TotalValue"]</span><strong>@AdminStatusDisplay.Currency(batch.TotalAmount)</strong></div>
        <div><span>@L["PurchaseOrderBatch.Details.ChildOrders"]</span><strong>@batch.ChildPurchaseOrders.Count</strong></div>
        <div><span>@L["Common.Ingredient"]</span><strong>@batch.Lines.Count</strong></div>
        <div><span>@L["PurchaseOrderBatch.Details.PdfVersions"]</span><strong>@Model.DocumentRevisions.Count</strong></div>
    </section>

    <div class="pa-detail-grid">
        <div class="pa-detail-main">
            <section class="pa-band">
                <div class="pa-section-heading"><div><div class="pa-eyebrow">@L["PurchaseOrderBatch.Details.ProgressEyebrow"]</div><h2>@L["PurchaseOrderBatch.Details.ChildOrders"]</h2></div><span class="pa-muted">@L["PurchaseOrderBatch.Details.ProgressHelp"]</span></div>
                <div class="pa-table-wrap pa-table-flat cc-warehouse-table-shell"><table class="pa-table"><thead><tr><th>@L["PurchaseOrderBatch.Details.ColCode"]</th><th>@L["Common.Branch"]</th><th>@L["Common.Status"]</th><th class="pa-number">@L["PurchaseOrderBatch.Details.ColOrdered"]</th><th class="pa-number">@L["PurchaseOrderBatch.Details.ColAccepted"]</th><th class="pa-number">@L["PurchaseOrderBatch.Details.ColRemaining"]</th></tr></thead><tbody>
                @foreach (var child in batch.ChildPurchaseOrders.OrderBy(x => x.StoreName))
                {
                    var usesProcurement = child.OrderedProcurementQuantity.HasValue;
                    var completion = usesProcurement
                        ? (child.OrderedProcurementQuantity <= 0 ? 0 : Math.Min(100, child.AcceptedProcurementQuantity.GetValueOrDefault() / child.OrderedProcurementQuantity.Value * 100))
                        : (child.OrderedBaseQuantity <= 0 ? 0 : Math.Min(100, child.AcceptedBaseQuantity / child.OrderedBaseQuantity * 100));
                    var hasSingleBaseUnit = !string.IsNullOrWhiteSpace(child.BaseUnitName);
                    <tr><td><a class="pa-code" asp-controller="AdminPurchaseOrders" asp-action="Details" asp-route-id="@child.PurchaseOrderId">@child.Code</a></td><td><strong>@child.StoreName</strong><progress class="pa-progress-native" value="@completion" max="100" aria-label="@L["PurchaseOrderBatch.Details.ProgressAria", completion.ToString("0")]">@completion.ToString("0")%</progress></td><td><span class="pa-badge">@AdminStatusDisplay.PurchaseOrder(child.Status).Label</span></td><td class="pa-number">@(usesProcurement ? AdminStatusDisplay.Quantity(child.OrderedProcurementQuantity!.Value) + " " + AdminStatusDisplay.Unit(child.ProcurementUnitName) : hasSingleBaseUnit ? AdminStatusDisplay.Quantity(child.OrderedBaseQuantity) + " " + AdminStatusDisplay.Unit(child.BaseUnitName) : L["PurchaseOrderBatch.Details.ByLine"].Value)</td><td class="pa-number">@(usesProcurement ? AdminStatusDisplay.Quantity(child.AcceptedProcurementQuantity.GetValueOrDefault()) + " " + AdminStatusDisplay.Unit(child.ProcurementUnitName) : hasSingleBaseUnit ? AdminStatusDisplay.Quantity(child.AcceptedBaseQuantity) + " " + AdminStatusDisplay.Unit(child.BaseUnitName) : L["PurchaseOrderBatch.Details.ByLine"].Value)</td><td class="pa-number"><strong>@(usesProcurement ? AdminStatusDisplay.Quantity(child.RemainingProcurementQuantity.GetValueOrDefault()) + " " + AdminStatusDisplay.Unit(child.ProcurementUnitName) : hasSingleBaseUnit ? AdminStatusDisplay.Quantity(child.RemainingBaseQuantity) + " " + AdminStatusDisplay.Unit(child.BaseUnitName) : L["PurchaseOrderBatch.Details.SeeDetails"].Value)</strong></td></tr>
                }
                </tbody></table></div>
            </section>

            <section class="pa-band">
                <div class="pa-section-heading"><div><div class="pa-eyebrow">@L["PurchaseOrderBatch.Details.TraceEyebrow"]</div><h2>@L["PurchaseOrderBatch.Details.AllocTitle"]</h2></div><span class="pa-muted">@L["PurchaseOrderBatch.Details.AllocHelp"]</span></div>
                @foreach (var line in batch.Lines.OrderBy(x => x.IngredientName))
                {
                    <article class="pa-allocation-block">
                        <div class="pa-allocation-head"><div><strong>@line.IngredientName</strong>@if (line.PurchaseMode == CafeChain.Models.Enums.Inventory.PurchaseMode.Loose) { <span>@L["PurchaseOrderBatch.Details.LooseBy", AdminStatusDisplay.Unit(line.ProcurementUnitName)]</span> } else { <span>@L["PurchaseOrderBatch.Details.PackMeta", AdminStatusDisplay.Quantity(line.TotalPackageCount.GetValueOrDefault()), AdminStatusDisplay.Quantity(line.PackageQuantitySnapshot.GetValueOrDefault()), AdminStatusDisplay.Unit(line.PackageUnitName)]</span> }@if (line.TotalProcurementQuantity.HasValue) { <span>@L["PurchaseOrderBatch.Details.CoverMeta", AdminStatusDisplay.Quantity(line.TotalProcurementQuantity.Value), AdminStatusDisplay.Unit(line.ProcurementUnitName), AdminStatusDisplay.Quantity(line.DemandCoveredProcurementQuantity.GetValueOrDefault()), AdminStatusDisplay.Quantity(line.RoundingSurplusProcurementQuantity.GetValueOrDefault())]</span> } else { <span>@L["PurchaseOrderBatch.Details.CoverMeta", AdminStatusDisplay.Quantity(line.TotalBaseQuantity), AdminStatusDisplay.Unit(line.BaseUnitName), AdminStatusDisplay.Quantity(line.DemandCoveredBaseQuantity), AdminStatusDisplay.Quantity(line.RoundingSurplusBaseQuantity)]</span> }</div><div><strong>@AdminStatusDisplay.Currency(line.LineTotal)</strong><span>@(line.PurchaseMode == CafeChain.Models.Enums.Inventory.PurchaseMode.Loose ? $"{AdminStatusDisplay.Currency(line.UnitPricePerProcurementUnit.GetValueOrDefault())}/{AdminStatusDisplay.Unit(line.ProcurementUnitName)}" : L["PurchaseOrderBatch.Details.PerPack", AdminStatusDisplay.Currency(line.PackagePriceSnapshot.GetValueOrDefault())].Value)</span></div></div>
                        <div class="pa-allocation-rows">
                            @foreach (var allocation in line.Allocations.OrderBy(x => x.StoreName))
                            {
                                <div><span><a class="pa-code" asp-controller="AdminPurchaseAdvices" asp-action="Details" asp-route-id="@allocation.PurchaseAdviceId">@allocation.AdviceNumber</a> · @allocation.StoreName</span><strong>@if (allocation.PurchaseMode == CafeChain.Models.Enums.Inventory.PurchaseMode.Packaged) { <span>@L["PurchaseOrderBatch.Details.AllocPacks", AdminStatusDisplay.Quantity(allocation.AllocatedPackageQuantity.GetValueOrDefault())]</span> } @if (allocation.AllocatedProcurementQuantity.HasValue) { <span>@L["PurchaseOrderBatch.Details.AllocCover", AdminStatusDisplay.Quantity(allocation.AllocatedProcurementQuantity.Value), AdminStatusDisplay.Unit(allocation.ProcurementUnitName), AdminStatusDisplay.Quantity(allocation.DemandCoveredProcurementQuantity.GetValueOrDefault()), AdminStatusDisplay.Quantity(allocation.RoundingSurplusProcurementQuantity.GetValueOrDefault())]</span> } else { <span>@L["PurchaseOrderBatch.Details.AllocCover", AdminStatusDisplay.Quantity(allocation.AllocatedBaseQuantity), AdminStatusDisplay.Unit(line.BaseUnitName), AdminStatusDisplay.Quantity(allocation.DemandCoveredBaseQuantity), AdminStatusDisplay.Quantity(allocation.RoundingSurplusBaseQuantity)]</span> }</strong></div>
                            }
                        </div>
                    </article>
                }
            </section>
        </div>

        <aside class="pa-detail-side">
            <section class="pa-band">
                <div class="pa-section-heading"><div><div class="pa-eyebrow">@L["PurchaseOrderBatch.Details.DocEyebrow"]</div><h2>@L["PurchaseOrderBatch.Details.PdfTitle"]</h2></div></div>
                <div class="pa-document-actions">
                    @if (canGenerate) { <form asp-action="GeneratePdf" asp-route-id="@batch.PurchaseOrderBatchId" method="post" data-loading-form>@Html.AntiForgeryToken()<button class="pa-action pa-action-primary pa-action-block" type="submit" data-submit-label="@L["PurchaseOrderBatch.Details.GeneratingPdf"]"><i class="fas fa-file-pdf"></i> @L["PurchaseOrderBatch.Details.ExportPdf"]</button></form> }
                    @if (latestRevision != null)
                    {
                        <a class="pa-action pa-action-block" asp-action="DownloadRevision" asp-route-revisionId="@latestRevision.RevisionId"><i class="fas fa-download"></i> @L["PurchaseOrderBatch.Details.DownloadPdf", latestRevision.FileName]</a>
                        <a class="pa-action pa-action-block" asp-action="PrintRevision" asp-route-revisionId="@latestRevision.RevisionId" target="_blank" rel="noopener"><i class="fas fa-print"></i> @L["PurchaseOrderBatch.Details.PrintPdf"]</a>
                    }
                </div>
                @if (latestRevision == null) { <div class="pa-draft-empty pa-draft-empty-compact"><i class="fas fa-file-circle-xmark"></i><h2>@L["PurchaseOrderBatch.Details.NoPdfTitle"]</h2><p>@L["PurchaseOrderBatch.Details.NoPdfCopy"]</p></div> }
                else
                {
                    <div class="pa-field"><label for="zalo-message">@L["PurchaseOrderBatch.Details.ZaloContent"]</label><textarea id="zalo-message" rows="8" readonly>@Model.ZaloMessage</textarea></div>
                    <button class="pa-action pa-action-block" type="button" id="copy-zalo"><i class="fas fa-copy"></i> @L["PurchaseOrderBatch.Details.CopyZalo"]</button>
                    <div id="copy-feedback" class="pa-copy-feedback" role="status"></div>
                }
                @if (sendableRevision != null && canDocument)
                {
                    <form asp-action="MarkRevisionSent" asp-route-id="@batch.PurchaseOrderBatchId" asp-route-revisionId="@sendableRevision.RevisionId" method="post" class="pa-send-form" data-loading-form>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="RowVersion" value="@sendableRevision.RowVersion" />
                        <input type="hidden" name="IdempotencyKey" value="@Guid.NewGuid().ToString("N")" />
                        <div class="pa-field">
                            <label for="send-channel">@L["PurchaseOrderBatch.Details.SendChannel"]</label>
                            <select id="send-channel" name="Channel" required>
                                <option value="@PurchaseOrderBatchDocumentChannels.ZaloManual">@L["PurchaseOrderBatch.Details.Channel.Zalo"]</option>
                                <option value="@PurchaseOrderBatchDocumentChannels.EmailManual">@L["PurchaseOrderBatch.Details.Channel.Email"]</option>
                                <option value="@PurchaseOrderBatchDocumentChannels.OtherManual">@L["PurchaseOrderBatch.Details.Channel.Other"]</option>
                            </select>
                        </div>
                        <div class="pa-field"><label for="send-note">@L["PurchaseOrderBatch.Details.SendNote"]</label><input id="send-note" name="Note" maxlength="500" placeholder="@L["PurchaseOrderBatch.Details.SendNotePlaceholder"]" /></div>
                        <button class="pa-action pa-action-primary pa-action-block" type="submit" data-submit-label="@L["PurchaseOrderBatch.Details.MarkingSent"]"><i class="fas fa-paper-plane"></i> @L["PurchaseOrderBatch.Details.MarkSent"]</button>
                    </form>
                }
            </section>

            <section class="pa-band">
                <div class="pa-section-heading"><div><div class="pa-eyebrow">@L["PurchaseOrderBatch.Details.RevEyebrow"]</div><h2>@L["PurchaseOrderBatch.Details.RevTitle"]</h2></div></div>
                <div class="pa-revision-list">
                    @foreach (var revision in Model.DocumentRevisions.OrderByDescending(x => x.RevisionNumber))
                    {
                        <article class="pa-revision-item">
                            <div><strong>@L["PurchaseOrderBatch.Details.Revision", revision.RevisionNumber]</strong><span class="pa-badge @AdminStatusDisplay.PurchaseOrderBatchDocument(revision.Status).CssClass">@AdminStatusDisplay.PurchaseOrderBatchDocument(revision.Status).Label</span></div>
                            <p>@revision.FileName</p>
                            <small>@L["PurchaseOrderBatch.Details.GeneratedBy", revision.GeneratedByName, AdminStatusDisplay.DateTime(revision.GeneratedAtUtc.ToLocalTime())]</small>
                            @if (revision.SentAtUtc.HasValue) { <small class="pa-sent-meta">@L["PurchaseOrderBatch.Details.SentMeta", AdminStatusDisplay.PurchaseOrderBatchDocumentChannel(revision.SentChannel), revision.SentByName ?? L["Common.StaffNumber", revision.SentByStaffId].Value, AdminStatusDisplay.DateTime(revision.SentAtUtc.Value.ToLocalTime())]</small> }
                            @if (!string.IsNullOrWhiteSpace(revision.SentNote)) { <small>@L["Common.Notes"]: @revision.SentNote</small> }
                            <a asp-action="DownloadRevision" asp-route-revisionId="@revision.RevisionId">@L["PurchaseOrderBatch.Details.DownloadThis"]</a>
                            <a asp-action="PrintRevision" asp-route-revisionId="@revision.RevisionId" target="_blank" rel="noopener">@L["PurchaseOrderBatch.Details.PrintThis"]</a>
                        </article>
                    }
                    @if (Model.DocumentRevisions.Count == 0) { <p class="pa-muted">@L["PurchaseOrderBatch.Details.NoHistory"]</p> }
                </div>
            </section>

            @if (canCancel)
            {
                <section class="pa-band pa-danger-zone"><h2>@L["PurchaseOrderBatch.Details.CancelTitle"]</h2><p>@L["PurchaseOrderBatch.Details.CancelHelp"]</p><form asp-action="Cancel" asp-route-id="@batch.PurchaseOrderBatchId" method="post" data-loading-form>@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@batch.RowVersion" /><div class="pa-field"><label for="cancel-reason">@L["PurchaseOrderBatch.Details.CancelReason"]</label><textarea id="cancel-reason" name="Reason" maxlength="500" required rows="2"></textarea></div><button class="pa-action pa-action-danger pa-action-block" type="submit" data-submit-label="@L["PurchaseOrderBatch.Details.Cancelling"]" onclick="return confirm(@Html.Raw(JsonSerializer.Serialize(L["PurchaseOrderBatch.Details.CancelConfirm"].Value)));"><i class="fas fa-ban"></i> @L["PurchaseOrderBatch.Details.CancelTitle"]</button></form></section>
            }
        </aside>
    </div>
</main>

@section Scripts {
<script>
(() => {
    const copyButton = document.getElementById('copy-zalo');
    const message = document.getElementById('zalo-message');
    const feedback = document.getElementById('copy-feedback');
    const i18n = {
        copiedZalo: @Html.Raw(JsonSerializer.Serialize(L["PurchaseOrderBatch.Details.CopiedZalo"].Value)),
        copied: @Html.Raw(JsonSerializer.Serialize(L["PurchaseOrderBatch.Details.Copied"].Value)),
        processing: @Html.Raw(JsonSerializer.Serialize(L["PurchaseOrderBatch.Details.Processing"].Value))
    };
    copyButton?.addEventListener('click', async () => {
        try {
            await navigator.clipboard.writeText(message.value);
            feedback.textContent = i18n.copiedZalo;
        } catch {
            message.select();
            document.execCommand('copy');
            feedback.textContent = i18n.copied;
        }
    });
    document.querySelectorAll('[data-loading-form]').forEach(form => form.addEventListener('submit', () => {
        const button = form.querySelector('button[type="submit"]');
        if (!button || button.disabled) return;
        button.disabled = true;
        button.textContent = button.dataset.submitLabel || i18n.processing;
    }));
})();
</script>
}
