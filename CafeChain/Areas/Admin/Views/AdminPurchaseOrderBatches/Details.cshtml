@using CafeChain.Application.Constants
@using CafeChain.Application.DTOs.Admin.Procurement
@using CafeChain.ViewModels.Admin.Shared
@model PurchaseOrderBatchDetailPageDto
@{
    ViewData["Title"] = $"Đơn đặt hàng gộp {Model.Batch.BatchNumber}";
    var batch = Model.Batch;
    var canDocument = ViewBag.CanDocument is true;
    var canApprove = ViewBag.CanApprove is true
        && batch.CreatedByStaffId != Model.Actor.StaffId
        && batch.Status == PurchaseOrderBatchStatuses.PendingApproval;
    var canCancel = ViewBag.CanCancel is true && batch.Status is not PurchaseOrderBatchStatuses.Completed and not PurchaseOrderBatchStatuses.Cancelled;
    var canGenerate = canDocument && PurchaseOrderBatchStatuses.ApprovedOrLater.Contains(batch.Status);
    var latestRevision = Model.DocumentRevisions.OrderByDescending(x => x.RevisionNumber).FirstOrDefault();
    var sendableRevision = Model.DocumentRevisions.FirstOrDefault(x => x.Status == PurchaseOrderBatchDocumentStatuses.Generated);
}
@section Styles { <link rel="stylesheet" href="~/css/Admin/PurchaseAdvice/purchase-advice.css" asp-append-version="true" /> }

<main class="pa-page cc-warehouse-page">
<header class="pa-header cc-warehouse-header cc-warehouse-header--compact cc-warehouse-header--detail">
        <div><div class="pa-eyebrow">@batch.BatchNumber · @AdminStatusDisplay.PurchaseOrderBatch(batch.Status).Label</div><h1>@batch.SupplierName</h1><p class="pa-subtitle">Giao dự kiến @AdminStatusDisplay.Date(batch.ExpectedDeliveryFrom) - @AdminStatusDisplay.Date(batch.ExpectedDeliveryTo) · @batch.StoreCount chi nhánh.</p></div>
        <div class="pa-actions">
            <a class="pa-action" asp-action="Index"><i class="fas fa-arrow-left"></i> Danh sách đơn đặt hàng gộp</a>
            @if (canApprove) { <form asp-action="Approve" asp-route-id="@batch.PurchaseOrderBatchId" method="post" data-loading-form>@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@batch.RowVersion" /><button class="pa-action pa-action-primary" type="submit" data-submit-label="Đang duyệt..."><i class="fas fa-check"></i> Duyệt đơn đặt hàng gộp</button></form> }
        </div>
    </header>
    @if (TempData["Error"] is string error) { <div class="pa-alert" role="alert">@error <a href="" class="pa-alert-link">Tải lại dữ liệu</a></div> }
    @if (TempData["Success"] is string success) { <div class="pa-alert pa-alert-success" role="status">@success</div> }
    @if (batch.Status == PurchaseOrderBatchStatuses.SentToSupplier) { <div class="pa-info-band"><i class="fas fa-circle-info"></i><div><strong>Đã ghi nhận gửi tài liệu.</strong><span>Trạng thái này không đồng nghĩa nhà cung cấp đã xác nhận đơn hàng.</span></div></div> }

    <section class="pa-batch-metrics">
        <div><span>Tổng giá trị</span><strong>@AdminStatusDisplay.Currency(batch.TotalAmount)</strong></div>
        <div><span>Đơn đặt hàng chi nhánh</span><strong>@batch.ChildPurchaseOrders.Count</strong></div>
        <div><span>Nguyên liệu</span><strong>@batch.Lines.Count</strong></div>
        <div><span>Phiên bản PDF</span><strong>@Model.DocumentRevisions.Count</strong></div>
    </section>

    <div class="pa-detail-grid">
        <div class="pa-detail-main">
            <section class="pa-band">
                <div class="pa-section-heading"><div><div class="pa-eyebrow">Tiến độ giao theo chi nhánh</div><h2>Đơn đặt hàng chi nhánh</h2></div><span class="pa-muted">Số lượng đã nhận hợp lệ được tổng hợp từ phiếu nhận hàng tại chi nhánh.</span></div>
                <div class="pa-table-wrap pa-table-flat cc-warehouse-table-shell"><table class="pa-table"><thead><tr><th>Mã đơn</th><th>Chi nhánh</th><th>Trạng thái</th><th class="pa-number">Đã đặt</th><th class="pa-number">Đã nhận hợp lệ</th><th class="pa-number">Còn phải giao</th></tr></thead><tbody>
                @foreach (var child in batch.ChildPurchaseOrders.OrderBy(x => x.StoreName))
                {
                    var usesProcurement = child.OrderedProcurementQuantity.HasValue;
                    var completion = usesProcurement
                        ? (child.OrderedProcurementQuantity <= 0 ? 0 : Math.Min(100, child.AcceptedProcurementQuantity.GetValueOrDefault() / child.OrderedProcurementQuantity.Value * 100))
                        : (child.OrderedBaseQuantity <= 0 ? 0 : Math.Min(100, child.AcceptedBaseQuantity / child.OrderedBaseQuantity * 100));
                    <tr><td><a class="pa-code" asp-controller="AdminPurchaseOrders" asp-action="Details" asp-route-id="@child.PurchaseOrderId">@child.Code</a></td><td><strong>@child.StoreName</strong><progress class="pa-progress-native" value="@completion" max="100" aria-label="Tiến độ nhận hàng @completion.ToString("0") phần trăm">@completion.ToString("0")%</progress></td><td><span class="pa-badge">@AdminStatusDisplay.PurchaseOrder(child.Status).Label</span></td><td class="pa-number">@(usesProcurement ? AdminStatusDisplay.Quantity(child.OrderedProcurementQuantity!.Value) + " " + child.ProcurementUnitName : AdminStatusDisplay.Quantity(child.OrderedBaseQuantity))</td><td class="pa-number">@(usesProcurement ? AdminStatusDisplay.Quantity(child.AcceptedProcurementQuantity.GetValueOrDefault()) + " " + child.ProcurementUnitName : AdminStatusDisplay.Quantity(child.AcceptedBaseQuantity))</td><td class="pa-number"><strong>@(usesProcurement ? AdminStatusDisplay.Quantity(child.RemainingProcurementQuantity.GetValueOrDefault()) + " " + child.ProcurementUnitName : AdminStatusDisplay.Quantity(child.RemainingBaseQuantity))</strong></td></tr>
                }
                </tbody></table></div>
            </section>

            <section class="pa-band">
                <div class="pa-section-heading"><div><div class="pa-eyebrow">Truy vết nguồn nhu cầu</div><h2>Phân bổ nguyên liệu</h2></div><span class="pa-muted">Giá và quy cách được lưu tại thời điểm tạo đơn đặt hàng gộp.</span></div>
                @foreach (var line in batch.Lines.OrderBy(x => x.IngredientName))
                {
                    <article class="pa-allocation-block">
                        <div class="pa-allocation-head"><div><strong>@line.IngredientName</strong>@if (line.PurchaseMode == CafeChain.Models.Enums.Inventory.PurchaseMode.Loose) { <span>Mua rời theo @line.ProcurementUnitName</span> } else { <span>@AdminStatusDisplay.Quantity(line.TotalPackageCount.GetValueOrDefault()) kiện · 1 kiện = @AdminStatusDisplay.Quantity(line.PackageQuantitySnapshot.GetValueOrDefault()) @line.PackageUnitName</span> }@if (line.TotalProcurementQuantity.HasValue) { <span>Đặt @AdminStatusDisplay.Quantity(line.TotalProcurementQuantity.Value) @line.ProcurementUnitName · phủ @AdminStatusDisplay.Quantity(line.DemandCoveredProcurementQuantity.GetValueOrDefault()) @line.ProcurementUnitName · dư @AdminStatusDisplay.Quantity(line.RoundingSurplusProcurementQuantity.GetValueOrDefault()) @line.ProcurementUnitName</span> } else { <span>Đặt @AdminStatusDisplay.Quantity(line.TotalBaseQuantity) @line.BaseUnitName · phủ @AdminStatusDisplay.Quantity(line.DemandCoveredBaseQuantity) @line.BaseUnitName · dư @AdminStatusDisplay.Quantity(line.RoundingSurplusBaseQuantity) @line.BaseUnitName</span> }</div><div><strong>@AdminStatusDisplay.Currency(line.LineTotal)</strong><span>@(line.PurchaseMode == CafeChain.Models.Enums.Inventory.PurchaseMode.Loose ? $"{AdminStatusDisplay.Currency(line.UnitPricePerProcurementUnit.GetValueOrDefault())}/{line.ProcurementUnitName}" : $"{AdminStatusDisplay.Currency(line.PackagePriceSnapshot.GetValueOrDefault())}/kiện")</span></div></div>
                        <div class="pa-allocation-rows">
                            @foreach (var allocation in line.Allocations.OrderBy(x => x.StoreName))
                            {
                                <div><span><a class="pa-code" asp-controller="AdminPurchaseAdvices" asp-action="Details" asp-route-id="@allocation.PurchaseAdviceId">@allocation.AdviceNumber</a> · @allocation.StoreName</span><strong>@if (allocation.PurchaseMode == CafeChain.Models.Enums.Inventory.PurchaseMode.Packaged) { <span>@AdminStatusDisplay.Quantity(allocation.AllocatedPackageQuantity.GetValueOrDefault()) kiện</span> } @if (allocation.AllocatedProcurementQuantity.HasValue) { <span>· đặt @AdminStatusDisplay.Quantity(allocation.AllocatedProcurementQuantity.Value) @allocation.ProcurementUnitName · phủ @AdminStatusDisplay.Quantity(allocation.DemandCoveredProcurementQuantity.GetValueOrDefault()) @allocation.ProcurementUnitName · dư @AdminStatusDisplay.Quantity(allocation.RoundingSurplusProcurementQuantity.GetValueOrDefault()) @allocation.ProcurementUnitName</span> } else { <span>· đặt @AdminStatusDisplay.Quantity(allocation.AllocatedBaseQuantity) @line.BaseUnitName · phủ @AdminStatusDisplay.Quantity(allocation.DemandCoveredBaseQuantity) · dư @AdminStatusDisplay.Quantity(allocation.RoundingSurplusBaseQuantity)</span> }</strong></div>
                            }
                        </div>
                    </article>
                }
            </section>
        </div>

        <aside class="pa-detail-side">
            <section class="pa-band">
                <div class="pa-section-heading"><div><div class="pa-eyebrow">Tài liệu nhà cung cấp</div><h2>PDF &amp; gửi Nhà cung cấp</h2></div></div>
                <div class="pa-document-actions">
                    @if (canGenerate) { <form asp-action="GeneratePdf" asp-route-id="@batch.PurchaseOrderBatchId" method="post" data-loading-form>@Html.AntiForgeryToken()<button class="pa-action pa-action-primary pa-action-block" type="submit" data-submit-label="Đang tạo PDF..."><i class="fas fa-file-pdf"></i> Xuất PDF</button></form> }
                    @if (latestRevision != null)
                    {
                        <a class="pa-action pa-action-block" asp-action="DownloadRevision" asp-route-revisionId="@latestRevision.RevisionId"><i class="fas fa-download"></i> Tải PDF @latestRevision.FileName</a>
                        <a class="pa-action pa-action-block" asp-action="PrintRevision" asp-route-revisionId="@latestRevision.RevisionId" target="_blank" rel="noopener"><i class="fas fa-print"></i> Mở để in PDF</a>
                    }
                </div>
                @if (latestRevision == null) { <div class="pa-draft-empty pa-draft-empty-compact"><i class="fas fa-file-circle-xmark"></i><h2>Chưa có PDF</h2><p>Đơn đặt hàng gộp phải được duyệt trước khi xuất tài liệu.</p></div> }
                else
                {
                    <div class="pa-field"><label for="zalo-message">Nội dung gửi Zalo</label><textarea id="zalo-message" rows="8" readonly>@Model.ZaloMessage</textarea></div>
                    <button class="pa-action pa-action-block" type="button" id="copy-zalo"><i class="fas fa-copy"></i> Sao chép nội dung gửi Zalo</button>
                    <div id="copy-feedback" class="pa-copy-feedback" role="status"></div>
                }
                @if (sendableRevision != null && canDocument)
                {
                    <form asp-action="MarkRevisionSent" asp-route-id="@batch.PurchaseOrderBatchId" asp-route-revisionId="@sendableRevision.RevisionId" method="post" class="pa-send-form" data-loading-form>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="RowVersion" value="@sendableRevision.RowVersion" />
                        <input type="hidden" name="IdempotencyKey" value="@Guid.NewGuid().ToString("N")" />
                        <div class="pa-field">
                            <label for="send-channel">Kênh đã gửi</label>
                            <select id="send-channel" name="Channel" required>
                                <option value="@PurchaseOrderBatchDocumentChannels.ZaloManual">Zalo</option>
                                <option value="@PurchaseOrderBatchDocumentChannels.EmailManual">Email</option>
                                <option value="@PurchaseOrderBatchDocumentChannels.OtherManual">Khác</option>
                            </select>
                        </div>
                        <div class="pa-field"><label for="send-note">Ghi chú / bằng chứng gửi</label><input id="send-note" name="Note" maxlength="500" placeholder="Ví dụ: gửi nhóm Zalo Nhà cung cấp lúc 09:30" /></div>
                        <button class="pa-action pa-action-primary pa-action-block" type="submit" data-submit-label="Đang ghi nhận..."><i class="fas fa-paper-plane"></i> Đánh dấu đã gửi Nhà cung cấp</button>
                    </form>
                }
            </section>

            <section class="pa-band">
                <div class="pa-section-heading"><div><div class="pa-eyebrow">Phiên bản tài liệu</div><h2>Lịch sử PDF và gửi Nhà cung cấp</h2></div></div>
                <div class="pa-revision-list">
                    @foreach (var revision in Model.DocumentRevisions.OrderByDescending(x => x.RevisionNumber))
                    {
                        <article class="pa-revision-item">
                            <div><strong>Phiên bản R@revision.RevisionNumber</strong><span class="pa-badge @AdminStatusDisplay.PurchaseOrderBatchDocument(revision.Status).CssClass">@AdminStatusDisplay.PurchaseOrderBatchDocument(revision.Status).Label</span></div>
                            <p>@revision.FileName</p>
                            <small>Tạo bởi @revision.GeneratedByName · @AdminStatusDisplay.DateTime(revision.GeneratedAtUtc.ToLocalTime())</small>
                            @if (revision.SentAtUtc.HasValue) { <small class="pa-sent-meta">Gửi qua @AdminStatusDisplay.PurchaseOrderBatchDocumentChannel(revision.SentChannel) bởi @(revision.SentByName ?? $"Nhân viên #{revision.SentByStaffId}") · @AdminStatusDisplay.DateTime(revision.SentAtUtc.Value.ToLocalTime())</small> }
                            @if (!string.IsNullOrWhiteSpace(revision.SentNote)) { <small>Ghi chú: @revision.SentNote</small> }
                            <a asp-action="DownloadRevision" asp-route-revisionId="@revision.RevisionId">Tải phiên bản PDF này</a>
                            <a asp-action="PrintRevision" asp-route-revisionId="@revision.RevisionId" target="_blank" rel="noopener">Mở để in phiên bản này</a>
                        </article>
                    }
                    @if (Model.DocumentRevisions.Count == 0) { <p class="pa-muted">Lịch sử sẽ xuất hiện sau lần tạo PDF đầu tiên.</p> }
                </div>
            </section>

            @if (canCancel)
            {
                <section class="pa-band pa-danger-zone"><h2>Hủy đơn đặt hàng gộp</h2><p>Chỉ hủy khi chưa phát sinh nhận hàng. Số lượng phân bổ sẽ được trả lại đề nghị mua.</p><form asp-action="Cancel" asp-route-id="@batch.PurchaseOrderBatchId" method="post" data-loading-form>@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@batch.RowVersion" /><div class="pa-field"><label for="cancel-reason">Lý do hủy</label><textarea id="cancel-reason" name="Reason" maxlength="500" required rows="2"></textarea></div><button class="pa-action pa-action-danger pa-action-block" type="submit" data-submit-label="Đang hủy..." onclick="return confirm('Hủy đơn đặt hàng gộp và các đơn chi nhánh chưa nhận hàng?')"><i class="fas fa-ban"></i> Hủy đơn đặt hàng gộp</button></form></section>
            }
        </aside>
    </div>
</main>

@section Scripts {
<script>
(() => {
    const copyButton = document.getElementById('copy-zalo');
    const message = document.getElementById('zalo-message');
    const feedback = document.getElementById('copy-feedback');
    copyButton?.addEventListener('click', async () => {
        try {
            await navigator.clipboard.writeText(message.value);
            feedback.textContent = 'Đã sao chép. Hãy đính kèm đúng file PDF khi gửi Zalo.';
        } catch {
            message.select();
            document.execCommand('copy');
            feedback.textContent = 'Đã sao chép nội dung.';
        }
    });
    document.querySelectorAll('[data-loading-form]').forEach(form => form.addEventListener('submit', () => {
        const button = form.querySelector('button[type="submit"]');
        if (!button || button.disabled) return;
        button.disabled = true;
        button.textContent = button.dataset.submitLabel || 'Đang xử lý...';
    }));
})();
</script>
}
