@using CafeChain.Application.Constants
@using CafeChain.Application.DTOs.Admin.Procurement
@model PurchaseOrderBatchDetailPageDto
@{
    ViewData["Title"] = $"Batch {Model.Batch.BatchNumber}";
    var batch = Model.Batch;
    var isOwner = Model.Actor.RoleNames.Contains(RoleConstants.BusinessOwner);
    var canDocument = isOwner || Model.Actor.RoleNames.Contains(RoleConstants.AccountantWarehouse);
    var canApprove = isOwner && batch.Status == PurchaseOrderBatchStatuses.PendingApproval;
    var canCancel = isOwner && batch.Status is not PurchaseOrderBatchStatuses.Completed and not PurchaseOrderBatchStatuses.Cancelled;
    var canGenerate = canDocument && PurchaseOrderBatchStatuses.ApprovedOrLater.Contains(batch.Status);
    var latestRevision = Model.DocumentRevisions.OrderByDescending(x => x.RevisionNumber).FirstOrDefault();
    var sendableRevision = Model.DocumentRevisions.FirstOrDefault(x => x.Status == PurchaseOrderBatchDocumentStatuses.Generated);
    string StatusLabel(string value) => value switch
    {
        PurchaseOrderBatchStatuses.PendingApproval => "Chờ duyệt",
        PurchaseOrderBatchStatuses.Approved => "Đã duyệt",
        PurchaseOrderBatchStatuses.PdfGenerated => "PDF đã tạo",
        PurchaseOrderBatchStatuses.SentToSupplier => "Đã gửi NCC",
        PurchaseOrderBatchStatuses.PartiallyReceived => "Đã nhận một phần",
        PurchaseOrderBatchStatuses.Completed => "Hoàn tất",
        PurchaseOrderBatchStatuses.Cancelled => "Đã hủy",
        PurchaseOrderBatchDocumentStatuses.Generated => "Sẵn sàng gửi",
        PurchaseOrderBatchDocumentStatuses.Sent => "Đã gửi",
        PurchaseOrderBatchDocumentStatuses.Superseded => "Đã thay thế",
        "DRAFT" => "Bản nháp",
        "MARKED_AS_SENT" => "Đã gửi NCC",
        _ => value
    };
}
@section Styles { <link rel="stylesheet" href="~/css/Admin/PurchaseAdvice/purchase-advice.css" asp-append-version="true" /> }

<main class="pa-page">
    <header class="pa-header">
        <div><div class="pa-eyebrow">@batch.BatchNumber · @StatusLabel(batch.Status)</div><h1>@batch.SupplierName</h1><p class="pa-subtitle">Giao dự kiến @batch.ExpectedDeliveryFrom.ToString("dd/MM/yyyy") - @batch.ExpectedDeliveryTo.ToString("dd/MM/yyyy") · @batch.StoreCount cửa hàng.</p></div>
        <div class="pa-actions">
            <a class="pa-action" asp-action="Index"><i class="fas fa-arrow-left"></i> Danh sách batch</a>
            @if (canApprove) { <form asp-action="Approve" asp-route-id="@batch.PurchaseOrderBatchId" method="post" data-loading-form>@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@batch.RowVersion" /><button class="pa-action pa-action-primary" type="submit" data-submit-label="Đang duyệt..."><i class="fas fa-check"></i> Duyệt batch</button></form> }
        </div>
    </header>
    @if (TempData["Error"] is string error) { <div class="pa-alert" role="alert">@error <a href="" class="pa-alert-link">Tải lại dữ liệu</a></div> }
    @if (TempData["Success"] is string success) { <div class="pa-alert pa-alert-success" role="status">@success</div> }
    @if (batch.Status == PurchaseOrderBatchStatuses.SentToSupplier) { <div class="pa-info-band"><i class="fas fa-circle-info"></i><div><strong>Đã ghi nhận gửi tài liệu.</strong><span>Trạng thái này không đồng nghĩa nhà cung cấp đã xác nhận đơn hàng.</span></div></div> }

    <section class="pa-batch-metrics">
        <div><span>Tổng giá trị</span><strong>@batch.TotalAmount.ToString("N0") đ</strong></div>
        <div><span>PO cửa hàng</span><strong>@batch.ChildPurchaseOrders.Count</strong></div>
        <div><span>Nguyên liệu</span><strong>@batch.Lines.Count</strong></div>
        <div><span>Revision PDF</span><strong>@Model.DocumentRevisions.Count</strong></div>
    </section>

    <div class="pa-detail-grid">
        <div class="pa-detail-main">
            <section class="pa-band">
                <div class="pa-section-heading"><div><div class="pa-eyebrow">Tiến độ giao theo chi nhánh</div><h2>PO con</h2></div><span class="pa-muted">Accepted được tổng hợp từ phiếu nhận tại Store.</span></div>
                <div class="pa-table-wrap pa-table-flat"><table class="pa-table"><thead><tr><th>Mã PO</th><th>Cửa hàng</th><th>Trạng thái</th><th class="pa-number">Đặt</th><th class="pa-number">Đã nhận</th><th class="pa-number">Còn lại</th></tr></thead><tbody>
                @foreach (var child in batch.ChildPurchaseOrders.OrderBy(x => x.StoreName))
                {
                    var completion = child.OrderedBaseQuantity <= 0 ? 0 : Math.Min(100, child.AcceptedBaseQuantity / child.OrderedBaseQuantity * 100);
                    <tr><td><a class="pa-code" asp-controller="AdminPurchaseOrders" asp-action="Details" asp-route-id="@child.PurchaseOrderId">@child.Code</a></td><td><strong>@child.StoreName</strong><div class="pa-progress"><span style="width:@completion.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span></div></td><td><span class="pa-badge">@StatusLabel(child.Status)</span></td><td class="pa-number">@child.OrderedBaseQuantity.ToString("N3")</td><td class="pa-number">@child.AcceptedBaseQuantity.ToString("N3")</td><td class="pa-number"><strong>@child.RemainingBaseQuantity.ToString("N3")</strong></td></tr>
                }
                </tbody></table></div>
            </section>

            <section class="pa-band">
                <div class="pa-section-heading"><div><div class="pa-eyebrow">Truy vết nguồn nhu cầu</div><h2>Phân bổ nguyên liệu</h2></div><span class="pa-muted">Giá và quy cách là snapshot lúc tạo batch.</span></div>
                @foreach (var line in batch.Lines.OrderBy(x => x.IngredientName))
                {
                    <article class="pa-allocation-block">
                        <div class="pa-allocation-head"><div><strong>@line.IngredientName</strong><span>@line.TotalPackageCount.ToString("N3") kiện · @line.PackageQuantitySnapshot.ToString("N3") @line.PackageUnitName/kiện</span></div><div><strong>@line.LineTotal.ToString("N0") đ</strong><span>@line.PackagePriceSnapshot.ToString("N0") đ/kiện</span></div></div>
                        <div class="pa-allocation-rows">
                            @foreach (var allocation in line.Allocations.OrderBy(x => x.StoreName))
                            {
                                <div><span><a class="pa-code" asp-controller="AdminPurchaseAdvices" asp-action="Details" asp-route-id="@allocation.PurchaseAdviceId">@allocation.AdviceNumber</a> · @allocation.StoreName</span><strong>@allocation.AllocatedPackageQuantity.ToString("N3") kiện · @allocation.AllocatedBaseQuantity.ToString("N3")</strong></div>
                            }
                        </div>
                    </article>
                }
            </section>
        </div>

        <aside class="pa-detail-side">
            <section class="pa-band">
                <div class="pa-section-heading"><div><div class="pa-eyebrow">Tài liệu nhà cung cấp</div><h2>PDF &amp; Zalo</h2></div></div>
                <div class="pa-document-actions">
                    @if (canGenerate) { <form asp-action="GeneratePdf" asp-route-id="@batch.PurchaseOrderBatchId" method="post" data-loading-form>@Html.AntiForgeryToken()<button class="pa-action pa-action-primary pa-action-block" type="submit" data-submit-label="Đang tạo PDF..."><i class="fas fa-file-pdf"></i> Xuất revision PDF</button></form> }
                    @if (latestRevision != null) { <a class="pa-action pa-action-block" asp-action="DownloadRevision" asp-route-revisionId="@latestRevision.RevisionId"><i class="fas fa-download"></i> Tải @latestRevision.FileName</a> }
                </div>
                @if (latestRevision == null) { <div class="pa-draft-empty pa-draft-empty-compact"><i class="fas fa-file-circle-xmark"></i><h2>Chưa có PDF</h2><p>Batch phải được duyệt trước khi xuất tài liệu.</p></div> }
                else
                {
                    <div class="pa-field"><label for="zalo-message">Nội dung gửi Zalo</label><textarea id="zalo-message" rows="8" readonly>@Model.ZaloMessage</textarea></div>
                    <button class="pa-action pa-action-block" type="button" id="copy-zalo"><i class="fas fa-copy"></i> Sao chép nội dung Zalo</button>
                    <div id="copy-feedback" class="pa-copy-feedback" role="status"></div>
                }
                @if (sendableRevision != null && canDocument)
                {
                    <form asp-action="MarkRevisionSent" asp-route-id="@batch.PurchaseOrderBatchId" asp-route-revisionId="@sendableRevision.RevisionId" method="post" class="pa-send-form" data-loading-form>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Channel" value="@PurchaseOrderBatchDocumentChannels.ZaloManual" />
                        <input type="hidden" name="RowVersion" value="@sendableRevision.RowVersion" />
                        <input type="hidden" name="IdempotencyKey" value="@Guid.NewGuid().ToString("N")" />
                        <div class="pa-field"><label for="send-note">Ghi chú gửi (không bắt buộc)</label><input id="send-note" name="Note" maxlength="500" placeholder="Ví dụ: gửi nhóm Zalo NCC lúc 09:30" /></div>
                        <button class="pa-action pa-action-primary pa-action-block" type="submit" data-submit-label="Đang ghi nhận..."><i class="fas fa-paper-plane"></i> Đánh dấu đã gửi NCC qua Zalo</button>
                    </form>
                }
            </section>

            <section class="pa-band">
                <div class="pa-section-heading"><div><div class="pa-eyebrow">Phiên bản tài liệu</div><h2>Lịch sử revision</h2></div></div>
                <div class="pa-revision-list">
                    @foreach (var revision in Model.DocumentRevisions.OrderByDescending(x => x.RevisionNumber))
                    {
                        <article class="pa-revision-item">
                            <div><strong>R@revision.RevisionNumber</strong><span class="pa-badge">@StatusLabel(revision.Status)</span></div>
                            <p>@revision.FileName</p>
                            <small>Tạo bởi @revision.GeneratedByName · @revision.GeneratedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                            @if (revision.SentAtUtc.HasValue) { <small class="pa-sent-meta">Gửi @revision.SentChannel bởi @(revision.SentByName ?? $"Staff #{revision.SentByStaffId}") · @revision.SentAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small> }
                            @if (!string.IsNullOrWhiteSpace(revision.SentNote)) { <small>Ghi chú: @revision.SentNote</small> }
                            <a asp-action="DownloadRevision" asp-route-revisionId="@revision.RevisionId">Tải revision này</a>
                        </article>
                    }
                    @if (Model.DocumentRevisions.Count == 0) { <p class="pa-muted">Lịch sử sẽ xuất hiện sau lần tạo PDF đầu tiên.</p> }
                </div>
            </section>

            @if (canCancel)
            {
                <section class="pa-band pa-danger-zone"><h2>Hủy batch</h2><p>Chỉ hủy khi chưa phát sinh nhận hàng. Allocation sẽ được trả lại PA.</p><form asp-action="Cancel" asp-route-id="@batch.PurchaseOrderBatchId" method="post" data-loading-form>@Html.AntiForgeryToken()<input type="hidden" name="RowVersion" value="@batch.RowVersion" /><div class="pa-field"><label for="cancel-reason">Lý do hủy</label><textarea id="cancel-reason" name="Reason" maxlength="500" required rows="2"></textarea></div><button class="pa-action pa-action-danger pa-action-block" type="submit" data-submit-label="Đang hủy..." onclick="return confirm('Hủy batch và các PO con chưa nhận hàng?')"><i class="fas fa-ban"></i> Hủy batch</button></form></section>
            }
        </aside>
    </div>
</main>

@section Scripts {
<script>
(() => {
    const copyButton = document.getElementById('copy-zalo');
    const message = document.getElementById('zalo-message');
    const feedback = document.getElementById('copy-feedback');
    copyButton?.addEventListener('click', async () => {
        try {
            await navigator.clipboard.writeText(message.value);
            feedback.textContent = 'Đã sao chép. Hãy đính kèm đúng file PDF khi gửi Zalo.';
        } catch {
            message.select();
            document.execCommand('copy');
            feedback.textContent = 'Đã sao chép nội dung.';
        }
    });
    document.querySelectorAll('[data-loading-form]').forEach(form => form.addEventListener('submit', () => {
        const button = form.querySelector('button[type="submit"]');
        if (!button || button.disabled) return;
        button.disabled = true;
        button.textContent = button.dataset.submitLabel || 'Đang xử lý...';
    }));
})();
</script>
}
