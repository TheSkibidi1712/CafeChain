@model CafeChain.ViewModels.Admin.Toppings.AdminToppingIndexVM
@using Microsoft.Extensions.Localization
@using System.Text.Json
@inject IStringLocalizer<CafeChain.ProductResource> ProductText

@using System.Security.Claims
@using CafeChain.Application.Constants
@using CafeChain.Application.Interfaces.Admin.Permissions
@using CafeChain.Helpers
@using CafeChain.ViewModels.Admin.Recipes
@inject IAdminPermissionService PermissionService
@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();
    var toppings = Model.Toppings.Items;
    var canCreate = false; var canUpdate = false; var canToggle = false; var canAssign = false; var canViewSize = false;
    var canWriteRecipes = RoleHelper.CanWriteRecipes(User);
    if (int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var accountId))
    {
        canCreate = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.ToppingCreate)).Data?.Allowed == true;
        canUpdate = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.ToppingUpdate)).Data?.Allowed == true;
        canToggle = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.ToppingToggleStatus)).Data?.Allowed == true;
        canAssign = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.ToppingAssignDrink)).Data?.Allowed == true;
        canViewSize = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.SizeView)).Data?.Allowed == true;
    }
    var toppingJsCatalog = JsonSerializer.Serialize(ProductText.GetAllStrings()
        .Where(message => message.Name.StartsWith("Topping.Js.", StringComparison.Ordinal) || message.Name == "Common.Cancel")
        .ToDictionary(message => message.Name, message => message.Value));
}


@section Styles {
    <link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/Catalog/catalog-list-toolbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/Topping/topping.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/AI/ai-image-pipeline.css" asp-append-version="true" />
}

<main class="topping-admin-page ops-shell cc-warehouse-page">
    @Html.AntiForgeryToken()

    <header class="topping-page-heading ops-header cc-warehouse-header">
        <div>
            <div class="ops-eyebrow">
                <i class="fas fa-layer-group me-1"></i> @ProductText["Common.MenuStructure"]
            </div>
            <h1 class="ops-title"><i class="fa-solid fa-cookie-bite me-2 text-warning" aria-hidden="true"></i>@ProductText["Topping.Title"]</h1>
            <p class="ops-subtitle">@ProductText["Topping.Description"]</p>
        </div>

        <div class="ops-actions">
            @if (canCreate)
            {
                <button type="button"
                        class="btn btn-orange"
                        data-bs-toggle="modal"
                        data-bs-target="#createModal">
                    <i class="fas fa-plus me-2"></i>
                    @ProductText["Common.Add"]
                </button>
            }
        </div>
    </header>

    <div class="catalog-list-toolbar">
        <div class="catalog-filter-tabs" aria-label="@ProductText["Topping.FilterAria"]">
            <a asp-action="Index"
               asp-route-keyword="@Model.Keyword"
               asp-route-pageSize="@Model.PageSize"
               class="catalog-filter-tab @(!Model.Active.HasValue ? "active" : null)"
               aria-current="@(!Model.Active.HasValue ? "page" : null)">@ProductText["Common.AllWithCount", Model.AllCount]</a>
            <a asp-action="Index"
               asp-route-keyword="@Model.Keyword"
               asp-route-active="true"
               asp-route-pageSize="@Model.PageSize"
               class="catalog-filter-tab @(Model.Active == true ? "active" : null)"
               aria-current="@(Model.Active == true ? "page" : null)">@ProductText["Common.ActiveWithCount", Model.ActiveCount]</a>
            <a asp-action="Index"
               asp-route-keyword="@Model.Keyword"
               asp-route-active="false"
               asp-route-pageSize="@Model.PageSize"
               class="catalog-filter-tab @(Model.Active == false ? "active" : null)"
               aria-current="@(Model.Active == false ? "page" : null)">@ProductText["Common.InactiveWithCount", Model.InactiveCount]</a>
        </div>

        <form asp-action="Index" method="get" class="catalog-list-tools" id="toppingFilterForm" role="search">
            <input type="hidden" name="page" value="1" />
            @if (Model.Active.HasValue)
            {
                <input type="hidden" name="active" value="@(Model.Active.Value ? "true" : "false")" />
            }

            <div class="catalog-search-box">
                <button type="submit" class="catalog-search-button" title="@ProductText["Common.Search"]" aria-label="@ProductText["Topping.SearchAria"]">
                    <i class="fas fa-search" aria-hidden="true"></i>
                </button>
                <label for="toppingKeyword" class="visually-hidden">@ProductText["Topping.SearchAria"]</label>
                <input id="toppingKeyword"
                       type="search"
                       name="keyword"
                       value="@Model.Keyword"
                       placeholder="@ProductText["Topping.SearchPlaceholder"]"
                       autocomplete="off" />
                @if (!string.IsNullOrWhiteSpace(Model.Keyword))
                {
                    <a asp-action="Index"
                       asp-route-active="@Model.Active"
                       asp-route-pageSize="@Model.PageSize"
                       class="catalog-search-clear"
                       title="@ProductText["Common.ClearFilters"]"
                       aria-label="@ProductText["Common.ClearFilters"]">
                        <i class="fas fa-times" aria-hidden="true"></i>
                    </a>
                }
            </div>

            <label class="catalog-page-size">
                <span>@ProductText["Common.Display"]</span>
                <select name="pageSize" aria-label="@ProductText["Common.DisplayRows"]" onchange="this.form.submit()">
                    <option value="10" selected="@(Model.PageSize == 10)">10</option>
                    <option value="25" selected="@(Model.PageSize == 25)">25</option>
                    <option value="50" selected="@(Model.PageSize == 50)">50</option>
                </select>
            </label>
        </form>
    </div>

    <!-- ===================================================== -->
    <!-- CARD -->
    <!-- ===================================================== -->

    <div class="main-card shadow-sm p-3">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <h5 class="fw-bold mb-0">
                @ProductText["Topping.List"]
            </h5>

        </div>

        <!-- ===================================================== -->
        <!-- TABLE -->
        <!-- ===================================================== -->

        <div class="table-responsive">

            <table class="table table-borderless align-middle">
                <thead class="text-muted">
                    <tr>
                        <th style="width: 18%;">TOPPING</th>
                        <th class="text-center" style="width: 10%;">@ProductText["Topping.Code"]</th>
                        <th style="width: 12%;">@ProductText["Topping.Price"]</th>
                        <th style="width: 32%;">@ProductText["Topping.CostSource"]</th>
                        <th class="text-center" style="width: 14%;">@ProductText["Common.Status"]</th>
                        <th class="text-center" style="width: 14%;">@ProductText["Common.Actions"]</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in toppings)
                    {
                        <tr class="border-top">
                            <!-- TOPPING -->
                            <td>
                                <div class="d-flex align-items-center">
                                    @if (string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <span class="topping-img topping-image-placeholder me-3" aria-hidden="true">
                                            <i class="fa-solid fa-image"></i>
                                        </span>
                                    }
                                    else
                                    {
                                        <object data="@item.ImageUrl"
                                                class="topping-img topping-image-placeholder me-3"
                                                role="img"
                                                aria-label="@ProductText["Topping.ImageAria", item.Name]">
                                            <span class="topping-img topping-image-placeholder" aria-hidden="true">
                                                <i class="fa-solid fa-image"></i>
                                            </span>
                                        </object>
                                    }
                                    <div class="fw-semibold topping-name">
                                        @item.Name
                                    </div>
                                </div>
                            </td>

                            <!-- CODE -->
                            <td class="text-center">
                                <span class="topping-code-badge">
                                    @item.ToppingCode
                                </span>
                            </td>

                            <!-- PRICE -->
                            <td>
                                <div class="fw-semibold text-danger">+ @item.Price.ToString("N0") ₫</div>
                                <div class="small text-muted">@ProductText["Topping.PriceSource"]</div>
                            </td>

                            <!-- CONSUMPTION SOURCE -->
                            <td class="topping-source-cell text-start">
                                <span class="topping-source-badge @(item.ConsumptionSource.MappingValid ? "is-valid" : "is-warning")">
                                    @item.ConsumptionSource.SourceLabel
                                </span>
                                <div class="small text-muted mt-1">@item.ConsumptionSource.Reason</div>

                                @foreach (var component in item.ConsumptionSource.Components)
                                {
                                    <div class="topping-source-component">
                                        <div class="comp-header">
                                            <span class="comp-name">@(component.SourceKind == ToppingConsumptionSourceCodes.DirectIngredient ? component.IngredientName : component.PreparedItemName)</span>
                                            <span class="comp-qty">@component.QuantityDisplay / @ProductText["Topping.PerPortion"]</span>
                                        </div>
                                        <div class="comp-code">
                                            @(component.SourceKind == ToppingConsumptionSourceCodes.DirectIngredient ? component.IngredientCode : component.PreparedItemCode)
                                            @if (component.ChildRecipeId.HasValue)
                                            {
                                                <span class="text-info ms-1">· pin Recipe #@component.ChildRecipeId</span>
                                            }
                                        </div>
                                        @if (component.PreparedItemId.HasValue)
                                        {
                                            <div class="mt-1">
                                                <a asp-area="Admin"
                                                   asp-controller="AdminStoreInventory"
                                                   asp-action="Index"
                                                   asp-route-tab="prepared-items"
                                                   asp-route-search="@component.PreparedItemCode"
                                                   class="small text-decoration-none text-primary fw-semibold"><i class="fas fa-boxes me-1"></i>@ProductText["Topping.ViewPreparedStock"]</a>
                                            </div>
                                        }
                                    </div>
                                }

                                <div class="topping-cost-authority">
                                    @if (item.ConsumptionSource.EstimatedCostPerPortion.HasValue)
                                    {
                                        <div class="topping-cost-row">
                                            <span>@ProductText["Topping.EstimatedBomCost"]</span>
                                            <span class="topping-cost-val">@item.ConsumptionSource.EstimatedCostPerPortion.Value.ToString("N0") ₫ / @ProductText["Topping.PerPortion"]</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="topping-cost-row">
                                             <span>@ProductText["Topping.StatusLabel"]</span>
                                             <span class="text-warning small"><i class="fas fa-exclamation-triangle me-1"></i>@item.ConsumptionSource.CostStatus</span>
                                        </div>
                                    }
                                    <div class="topping-cost-row small text-muted">
                                        <span>@ProductText["Topping.ActualCost"]</span>
                                        <span>@ProductText["Topping.FifoAtSale"]</span>
                                    </div>
                                </div>

                                <div class="mt-2 d-flex flex-wrap gap-2 justify-content-start">
                                    @if (item.ConsumptionSource.ActiveRecipeId.HasValue)
                                    {
                                        <a asp-area="Admin"
                                           asp-controller="AdminRecipe"
                                           asp-action="Visualize"
                                           asp-route-recipeId="@item.ConsumptionSource.ActiveRecipeId"
                                           class="topping-bom-btn"><i class="fas fa-eye me-1"></i>Xem BOM</a>
                                        @if (canWriteRecipes)
                                        {
                                            <a asp-area="Admin"
                                               asp-controller="AdminRecipe"
                                               asp-action="Edit"
                                               asp-route-id="@item.ConsumptionSource.ActiveRecipeId"
                                               class="topping-bom-btn primary"><i class="fas fa-pen me-1"></i>@ProductText["Topping.EditBom"]</a>
                                        }
                                    }
                                    else if (canWriteRecipes)
                                    {
                                        <a asp-area="Admin"
                                           asp-controller="AdminRecipe"
                                           asp-action="Create"
                                           class="topping-bom-btn primary"><i class="fas fa-plus me-1"></i>@ProductText["Topping.CreateBom"]</a>
                                    }
                                </div>
                            </td>

                            <!-- STATUS -->
                            <td class="text-center">
                                @if (item.Active)
                                {
                                    <span class="status-active">
                                        @ProductText["Common.Active"]
                                    </span>
                                }
                                else
                                {
                                    <span class="status-inactive">
                                        @ProductText["Common.Inactive"]
                                    </span>
                                }
                            </td>

                            <!-- ACTIONS -->
                            <td class="text-center">
                                <div class="d-inline-flex align-items-center justify-content-center gap-1">
                                    <!-- ASSIGN -->
                                    @if (canAssign)
                                    {
                                    <button type="button"
                                            class="btn btn-sm btn-warning"
                                            title="@ProductText["Size.AssignDrinks"]"
                                            onclick="openDrinkModal(
                                        @item.ToppingId,
                                        '@Html.Raw(item.Name.Replace("'", "\\'"))')">
                                        <i class="fas fa-link"></i>
                                    </button>
                                    }

                                    <!-- EDIT -->
                                    @if (canUpdate)
                                    {
                                    <button type="button"
                                            class="btn btn-sm btn-light btn-edit-topping is-edit"
                                            title="@ProductText["Common.Edit"]"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editModal"
                                            data-id="@item.ToppingId"
                                            data-code="@item.ToppingCode"
                                            data-name="@item.Name"
                                            data-price="@item.Price"
                                            data-image="@item.ImageUrl">
                                        <i class="fas fa-pen text-primary"></i>
                                    </button>
                                    }

                                    <!-- TOGGLE -->
                                    @if (canToggle)
                                    {
                                    <button type="button"
                                            class="btn btn-sm js-toggle-topping @(item.Active ? "is-lock" : "is-unlock")"
                                            title="@(item.Active ? ProductText["Common.Lock"] : ProductText["Common.Unlock"])"
                                            onclick="toggleTopping(@item.ToppingId, '@Url.Action("ToggleStatus", "AdminTopping", new { area = "Admin", id = item.ToppingId })')"
                                            data-id="@item.ToppingId"
                                            data-url="@Url.Action("ToggleStatus", "AdminTopping", new { area = "Admin", id = item.ToppingId })">
                                        <i class="fas @(item.Active
                                                        ? "fa-lock text-danger"
                                                        : "fa-unlock text-success")"></i>
                                    </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (toppings.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">@ProductText["Topping.Empty"]</td></tr>
                    }

                </tbody>

            </table>

        </div>

        <partial name="_CatalogPagination"
                 model="new CafeChain.ViewModels.Admin.Shared.AdminCatalogPaginationVM {
                     Keyword = Model.Keyword,
                     Active = Model.Active,
                     PageSize = Model.PageSize,
                     PageIndex = Model.Toppings.PageIndex,
                     TotalPages = Model.Toppings.TotalPages,
                     TotalCount = Model.Toppings.TotalCount,
                     CurrentItemCount = toppings.Count
                 }" />

    </div>

</main>

<!-- ===================================================== -->
<!-- CREATE MODAL -->
<!-- ===================================================== -->

<div class="modal fade topping-module-modal"
     id="createModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered topping-create-dialog">

        <div class="modal-content topping-create-modal">

            <div class="modal-header">
                <div class="d-flex align-items-center gap-3">
                    <span class="topping-create-icon"><i class="fas fa-cookie-bite"></i></span>
                    <div>
                        <h6 class="fw-bold mb-0">@ProductText["Topping.CreateTitle"]</h6>
                        <small class="text-muted text-uppercase">@ProductText["Topping.Configure"]</small>
                    </div>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form id="createToppingForm"
                  asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div class="modal-body">
                    <div class="topping-create-fields">

                    <!-- CODE -->

                    <div class="mb-3 topping-code-field">

                        <label class="form-label">
                            @ProductText["Topping.CodeLabel"]
                        </label>

                        <input name="ToppingCode"
                               class="form-control bg-light"
                               maxlength="50"
                               placeholder="@ProductText["Topping.CodePlaceholder"]"
                               required />

                        <span class="text-danger"
                              data-valmsg-for="ToppingCode">
                        </span>

                    </div>

                    <!-- NAME -->

                    <div class="mb-3 topping-name-field">

                        <label class="form-label">
                            @ProductText["Topping.NameLabel"]
                        </label>

                        <input name="Name"
                               class="form-control bg-light"
                               maxlength="100"
                               required />

                        <span class="text-danger"
                              data-valmsg-for="Name">
                        </span>

                    </div>

                    <!-- PRICE -->

                    <div class="mb-3 topping-price-field">

                        <label class="form-label">
                            @ProductText["Topping.PriceLabel"]
                        </label>

                        <input name="Price"
                               type="number"
                               min="1000"
                               step="1"
                               placeholder="@ProductText["Topping.PricePlaceholder"]"
                               class="form-control bg-light"
                               required />

                        <span class="text-danger"
                              data-valmsg-for="Price">
                        </span>

                    </div>

                    <div class="mb-3 topping-ai-section d-none">
                        <label for="toppingAiIdea" class="form-label">@ProductText["Topping.AiIdea"] <span class="text-muted">@ProductText["Topping.Optional"]</span></label>
                        <select id="toppingAiGenerationMode" class="form-select mb-2" aria-label="@ProductText["Topping.AiModeAria"]">
                            <option value="0">@ProductText["Topping.AiNew"]</option>
                            <option value="1">@ProductText["Topping.AiDevelop"]</option>
                            <option value="2">@ProductText["Topping.AiVariant"]</option>
                        </select>
                        <input id="toppingAiIdea" class="form-control mb-2" maxlength="200" placeholder="@ProductText["Topping.AiPlaceholder"]" autocomplete="off" />
                        <button type="button" id="btnToppingAiSuggestion" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-wand-magic-sparkles me-1"></i> @ProductText["Topping.AiSuggest"]
                        </button>
                        <div id="toppingAiSuggestionPanel" class="ai-suggestion-panel mt-2 d-none">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong>@ProductText["Topping.AiChoose"]</strong>
                                <span id="toppingAiSource" class="badge bg-secondary"></span>
                            </div>
                            <div id="toppingAiOptionList" class="ai-option-grid"></div>
                            <div id="toppingAiStatus" class="ai-pipeline-status mt-2" aria-live="polite"></div>
                            <div class="mt-2"><small class="fw-semibold">@ProductText["Topping.AiReference"]</small></div>
                            <div id="toppingAiReferenceList" class="ai-image-grid"></div>
                            <div class="mt-2"><small class="fw-semibold">@ProductText["Topping.AiFinal"]</small></div>
                            <div id="toppingAiGeneratedList" class="ai-image-grid"></div>
                            <div id="toppingAiWarnings" class="small text-warning mt-1"></div>
                            <div class="d-flex gap-2 mt-2">
                                <button type="button" id="btnApplyToppingAi" class="btn btn-primary btn-sm" disabled>@ProductText["Topping.Apply"]</button>
                                <button type="button" id="btnUseToppingPexels" class="btn btn-outline-success btn-sm" disabled>@ProductText["Topping.UsePexels"]</button>
                                <button type="button" id="btnGenerateToppingAi" class="btn btn-outline-primary btn-sm" disabled>@ProductText["Topping.GenerateAgain"]</button>
                                <button type="button" id="btnGenerateToppingAiWithoutReference" class="btn btn-outline-warning btn-sm d-none">@ProductText["Topping.GenerateWithoutReference"]</button>
                                <button type="button" id="btnRetryToppingAiSearch" class="btn btn-outline-secondary btn-sm" disabled>@ProductText["Topping.SearchAgain"]</button>
                                <button type="button" id="btnDismissToppingAi" class="btn btn-light btn-sm">@ProductText["Topping.Dismiss"]</button>
                            </div>
                        </div>
                    </div>

                    <!-- CHỌN ẢNH TOPPING THEO MẪU -->
                    <div class="mb-3 topping-upload-section">
                        <div class="topping-upload-header mb-2">
                            <div class="topping-upload-title-wrap d-flex align-items-center">
                                <i class="fas fa-cloud-arrow-up topping-upload-title-icon me-2"></i>
                                <span class="fw-bold fs-14">@ProductText["Topping.ImageAdd"]</span>
                            </div>
                            <div class="text-muted fs-12 mt-1">
                                @ProductText["Topping.ImageHint"]
                            </div>
                        </div>

                        <div class="topping-upload-box" id="createToppingUploadBox">
                            <input type="file"
                                   id="create-image-input"
                                   name="ImageFile"
                                   class="d-none"
                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                            <button type="button"
                                    id="btn-trigger-choose-image"
                                    class="topping-pill-choose-btn"
                                    onclick="document.getElementById('create-image-input').click();">
                                <i class="fas fa-folder me-2"></i>@ProductText["Topping.ImageChoose"]
                            </button>

                            <div class="topping-file-status" id="create-file-status-text">
                                @ProductText["Topping.ImageNoFile"]
                            </div>

                            <!-- Preview thumbnail if file is chosen -->
                            <div class="topping-file-preview-wrap d-none" id="create-file-preview-container">
                                <img id="create-preview" src="" alt="@ProductText["Topping.ImagePreview"]" class="topping-file-preview-img" />
                                <button type="button" class="btn btn-sm btn-outline-danger mt-2" id="create-remove-btn" onclick="removeCreateImage(event)">
                                    <i class="fas fa-trash-alt me-1"></i>@ProductText["Topping.ImageRemove"]
                                </button>
                            </div>
                        </div>

                        <span class="text-danger" data-valmsg-for="ImageFile"></span>
                    </div>

                    </div>
                </div>

                <div class="modal-footer border-0">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        @ProductText["Common.Cancel"]

                    </button>

                    <button type="submit"
                            id="btnCreateTopping"
                            class="btn btn-orange">

                        <i class="fas fa-save me-2"></i>
                        @ProductText["Topping.Save"]

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
<!-- ===================================================== -->
<!-- EDIT MODAL -->
<!-- ===================================================== -->

<div class="modal fade topping-module-modal"
     id="editModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header" style="background:#6F4E37;">

                <h5 class="modal-title" style="color:#fff;">

                    <i class="fas fa-edit me-2"></i>
                    @ProductText["Topping.EditTitle"]

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form id="editForm"
                  asp-action="Edit"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="edit-id"
                       name="ToppingId" />

                <div class="modal-body">

                    <div class="row">

                        <div class="col-md-7">

                            <!-- CODE -->

                            <div class="mb-3">

                                <label class="form-label">
                                    @ProductText["Topping.CodeLabel"]
                                </label>

                                <input id="edit-code"
                                       name="ToppingCode"
                                       class="form-control"
                                       maxlength="50"
                                       required />

                            </div>

                            <div class="mb-3">

                                <label class="form-label">
                                    @ProductText["Topping.NameLabel"]
                                </label>

                                <input id="edit-name"
                                       name="Name"
                                       class="form-control"
                                       maxlength="100"
                                       required />

                            </div>

                            <!-- PRICE -->

                            <div class="mb-3">

                                <label class="form-label">
                                    @ProductText["Topping.PriceLabel"]
                                </label>

                                <input id="edit-price"
                                       name="Price"
                                       type="number"
                                       min="1000"
                                       placeholder="@ProductText["Topping.PricePlaceholder"]"
                                       step="1"
                                       class="form-control"
                                       required />

                            </div>

                        </div>

                        <div class="col-md-5">

                            <label class="form-label">
                                @ProductText["Topping.ImageLabel"]
                            </label>

                            <div class="text-center">

                                <img id="edit-preview"
                                     src="https://res.cloudinary.com/dzfizobk8/image/upload/v1779803296/no-image_vuuic6.jpg"
                                     class="img-thumbnail mb-2"
                                     style="width:220px;height:220px;object-fit:cover;" 
                                     alt="Preview"
                                />

                                <div class="topping-custom-file-input mt-2">
                                    <input id="edit-image-input"
                                           type="file"
                                           name="ImageFile"
                                           class="d-none"
                                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                           onchange="previewEditImage(event)" />
                                    <label for="edit-image-input" class="btn btn-brown-pill me-1">
                                        <i class="fas fa-folder-open me-1"></i> @ProductText["Topping.ImageChoose"]
                                    </label>
                                    <span id="edit-image-file-name" class="topping-file-name-text" title="@ProductText["Topping.ImageNoFile"]">@ProductText["Topping.ImageNoFile"]</span>
                                </div>

                                <button type="button"
                                        class="btn btn-outline-danger btn-sm mt-2"
                                        onclick="removeEditImage()">

                                    <i class="fas fa-trash me-1"></i>
                                    @ProductText["Topping.ImageRemove"]

                                </button>

                                <div class="form-text mt-2">

                                    @ProductText["Topping.ImageLeaveEmpty"]

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="submit"
                            id="btnEditTopping"
                            class="btn btn-warning">

                        <i class="fas fa-save me-2"></i>
                        @ProductText["Topping.SaveChanges"]

                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        @ProductText["Common.Close"]

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- ===================================================== -->
<!-- DRINK TOPPING MODAL -->
<!-- ===================================================== -->

<div class="modal fade topping-module-modal"
     id="drinkModal"
     tabindex="-1"
     aria-labelledby="drinkModalTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">

        <div class="modal-content border-0 shadow">

            <!-- HEADER -->
            <div class="modal-header border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <div class="topping-create-icon">
                        <i class="fas fa-cookie-bite"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-dark" id="drinkModalTitle">@ProductText["Topping.ManageTitle"]</h5>
                        <small class="text-muted">@ProductText["Topping.ManageHint"]</small>
                    </div>
                </div>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <!-- BODY -->
            <div class="modal-body p-4">

                @Html.AntiForgeryToken()

                <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
                    <span class="badge bg-brown px-3 py-2 fs-6 rounded-pill">Topping: <span id="currentToppingBadge"></span></span>
                    <span class="small text-muted"><i class="fas fa-info-circle me-1"></i>@ProductText["Topping.AssignHint"]</span>
                </div>

                <!-- LOADING -->
                <div id="drinkLoading"
                     class="text-center py-5 d-none">
                    <div class="spinner-border text-primary"></div>
                    <div class="mt-2 text-muted">@ProductText["Topping.Loading"]</div>
                </div>

                <!-- CONTENT -->
                <div id="drinkContent">
                    <div class="row g-4 pb-4">

                        <!-- ASSIGNED -->
                        <div class="col-md-6">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <h6 class="fw-bold mb-0 text-secondary"><i class="fas fa-check-circle me-1 text-success"></i> @ProductText["Topping.Assigned"]</h6>
                            </div>
                            <div id="assignedList" class="d-flex flex-column gap-2 pb-4">
                                <div class="text-center py-4 text-muted small">@ProductText["Topping.NoData"]</div>
                            </div>
                        </div>

                        <!-- UNASSIGNED -->
                        <div class="col-md-6">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <h6 class="fw-bold mb-0 text-secondary"><i class="fas fa-plus-circle me-1 text-primary"></i> @ProductText["Topping.Unassigned"]</h6>
                            </div>
                            <div id="unassignedList" class="d-flex flex-column gap-2 pb-4">
                                <div class="text-center py-4 text-muted small">@ProductText["Topping.NoData"]</div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>

            <!-- FOOTER -->
            <div class="modal-footer border-top bg-light">
                <button type="button"
                        class="btn btn-secondary px-4"
                        data-bs-dismiss="modal">
                    @ProductText["Common.Close"]
                </button>
            </div>

        </div>

    </div>

</div>

<!-- ===================================================== -->
<!-- TOAST CONTAINER -->
<!-- ===================================================== -->

<div id="toast-container"></div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script id="toppingUiCatalog" type="application/json">@Html.Raw(toppingJsCatalog)</script>
    <script src="~/js/Admin/AI/ai-image-pipeline.js" asp-append-version="true"></script>
    <script src="~/js/Admin/Topping/topping.js" asp-append-version="true"></script>
}
