@model IEnumerable<CafeChain.ViewModels.Admin.Toppings.AdminToppingVM>

@using System.Security.Claims
@using CafeChain.Application.Constants
@using CafeChain.Application.Interfaces.Admin.Permissions
@using CafeChain.Helpers
@using CafeChain.ViewModels.Admin.Recipes
@inject IAdminPermissionService PermissionService
@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();
    var canCreate = false; var canUpdate = false; var canToggle = false; var canAssign = false; var canViewSize = false;
    var canWriteRecipes = RoleHelper.CanWriteRecipes(User);
    if (int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var accountId))
    {
        canCreate = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.ToppingCreate)).Data?.Allowed == true;
        canUpdate = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.ToppingUpdate)).Data?.Allowed == true;
        canToggle = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.ToppingToggleStatus)).Data?.Allowed == true;
        canAssign = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.ToppingAssignDrink)).Data?.Allowed == true;
        canViewSize = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.SizeView)).Data?.Allowed == true;
    }

}


@section Styles {
    <link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/Topping/topping.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/AI/ai-image-pipeline.css" asp-append-version="true" />
}

<main class="topping-admin-page ops-shell cc-warehouse-page">
    @Html.AntiForgeryToken()

    <header class="topping-page-heading ops-header cc-warehouse-header">
        <div>
            <div class="ops-eyebrow">
                <i class="fas fa-layer-group me-1"></i> Cấu trúc thực đơn
            </div>
            <h1 class="ops-title">Quản lý Topping đồ uống</h1>
            <p class="ops-subtitle">Thiết lập topping, giá bán và nguồn nguyên liệu tiêu hao trên thực đơn.</p>
        </div>
        <div class="ops-actions">
            @if (canCreate)
            {
                <button type="button"
                        class="btn btn-orange"
                        data-bs-toggle="modal"
                        data-bs-target="#createModal">
                    <i class="fas fa-plus me-2"></i>
                    Thêm mới
                </button>
            }
        </div>
    </header>

    <!-- Tabs -->
    <div class="topping-page-tabs d-flex mb-3">
        @if (canViewSize)
        {
            <a asp-area="Admin"
               asp-controller="AdminSize"
               asp-action="Index"
               class="text-decoration-none fw-semibold @(currentController == "AdminSize" ? "active" : "")">
                Quản lý Size
            </a>
        }

        <a asp-area="Admin"
           asp-controller="AdminTopping"
           asp-action="Index"
           class="text-decoration-none fw-semibold @(currentController == "AdminTopping" ? "active" : "")">
            Quản lý Topping
        </a>
    </div>

    <!-- ===================================================== -->
    <!-- CARD -->
    <!-- ===================================================== -->

    <div class="main-card shadow-sm p-3">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <h5 class="fw-bold mb-0">
                Danh sách Topping
            </h5>

            @if (canCreate)
            {
            <button type="button"
                    class="btn btn-orange"
                    data-bs-toggle="modal"
                    data-bs-target="#createModal">

                <i class="fas fa-plus me-2"></i>
                Thêm mới

            </button>
            }

        </div>

        <!-- ===================================================== -->
        <!-- TABLE -->
        <!-- ===================================================== -->

        <div class="table-responsive">

            <table class="table table-borderless align-middle">
                <thead class="text-muted">
                    <tr>
                        <th style="width: 18%;">TOPPING</th>
                        <th class="text-center" style="width: 10%;">MÃ</th>
                        <th style="width: 12%;">GIÁ BÁN</th>
                        <th style="width: 32%;">NGUỒN TIÊU HAO / GIÁ VỐN</th>
                        <th class="text-center" style="width: 14%;">TRẠNG THÁI</th>
                        <th class="text-center" style="width: 14%;">HÀNH ĐỘNG</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="border-top">
                            <!-- TOPPING -->
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl)
                                                ? "/images/no-image.png"
                                                : item.ImageUrl)"
                                         class="topping-img me-3" />
                                    <div class="fw-semibold">
                                        @item.Name
                                    </div>
                                </div>
                            </td>

                            <!-- CODE -->
                            <td class="text-center">
                                <span class="topping-code-badge">
                                    @item.ToppingCode
                                </span>
                            </td>

                            <!-- PRICE -->
                            <td>
                                <div class="fw-semibold text-danger">+ @item.Price.ToString("N0") đ</div>
                                <div class="small text-muted">Giá bán từ Topping.Price</div>
                            </td>

                            <!-- CONSUMPTION SOURCE -->
                            <td class="topping-source-cell">
                                <span class="topping-source-badge @(item.ConsumptionSource.MappingValid ? "is-valid" : "is-warning")">
                                    @item.ConsumptionSource.SourceLabel
                                </span>
                                <div class="small text-muted mt-1">@item.ConsumptionSource.Reason</div>

                                @foreach (var component in item.ConsumptionSource.Components)
                                {
                                    <div class="topping-source-component">
                                        <div class="font-monospace text-break">@component.IdentityDisplay</div>
                                        <div>
                                            @component.QuantityDisplay/phần
                                            @if (component.ChildRecipeId.HasValue)
                                            {
                                                <span>· pin Recipe #@component.ChildRecipeId</span>
                                            }
                                        </div>
                                        @if (component.PreparedItemId.HasValue)
                                        {
                                            <a asp-area="Admin"
                                               asp-controller="AdminStoreInventory"
                                               asp-action="Index"
                                               asp-route-tab="prepared-items"
                                               asp-route-search="@component.PreparedItemCode"
                                               class="small text-decoration-none text-primary fw-semibold"><i class="fas fa-boxes me-1"></i>Xem tồn kho BTP</a>
                                        }
                                    </div>
                                }

                                <div class="topping-cost-authority">
                                    @if (item.ConsumptionSource.EstimatedCostPerPortion.HasValue)
                                    {
                                        <span>Giá vốn BOM ước tính: <strong>@item.ConsumptionSource.EstimatedCostPerPortion.Value.ToString("N0") đ/phần</strong></span>
                                    }
                                    else
                                    {
                                        <span>@item.ConsumptionSource.CostStatus</span>
                                    }
                                    <span>Giá vốn thực tế: FIFO khi bán</span>
                                </div>

                                <div class="mt-2 d-flex flex-wrap gap-2">
                                    @if (item.ConsumptionSource.ActiveRecipeId.HasValue)
                                    {
                                        <a asp-area="Admin"
                                           asp-controller="AdminRecipe"
                                           asp-action="Visualize"
                                           asp-route-recipeId="@item.ConsumptionSource.ActiveRecipeId"
                                           class="topping-bom-btn"><i class="fas fa-eye me-1"></i>Xem BOM</a>
                                        @if (canWriteRecipes)
                                        {
                                            <a asp-area="Admin"
                                               asp-controller="AdminRecipe"
                                               asp-action="Edit"
                                               asp-route-id="@item.ConsumptionSource.ActiveRecipeId"
                                               class="topping-bom-btn primary"><i class="fas fa-pen me-1"></i>Sửa BOM</a>
                                        }
                                    }
                                    else if (canWriteRecipes)
                                    {
                                        <a asp-area="Admin"
                                           asp-controller="AdminRecipe"
                                           asp-action="Create"
                                           class="topping-bom-btn primary"><i class="fas fa-plus me-1"></i>Tạo BOM</a>
                                    }
                                </div>
                            </td>

                            <!-- STATUS -->
                            <td class="text-center">
                                @if (item.Active)
                                {
                                    <span class="status-active">
                                        Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="status-inactive">
                                        Ngừng
                                    </span>
                                }
                            </td>

                            <!-- ACTIONS -->
                            <td class="text-center">
                                <div class="d-inline-flex align-items-center justify-content-center gap-1">
                                    <!-- ASSIGN -->
                                    @if (canAssign)
                                    {
                                    <button type="button"
                                            class="btn btn-sm btn-warning"
                                            title="Gán đồ uống"
                                            onclick="openDrinkModal(
                                        @item.ToppingId,
                                        '@Html.Raw(item.Name.Replace("'", "\\'"))')">
                                        <i class="fas fa-link"></i>
                                    </button>
                                    }

                                    <!-- EDIT -->
                                    @if (canUpdate)
                                    {
                                    <button type="button"
                                            class="btn btn-sm btn-light btn-edit-topping"
                                            title="Chỉnh sửa"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editModal"
                                            data-id="@item.ToppingId"
                                            data-code="@item.ToppingCode"
                                            data-name="@item.Name"
                                            data-price="@item.Price"
                                            data-image="@item.ImageUrl">
                                        <i class="fas fa-pen text-primary"></i>
                                    </button>
                                    }

                                    <!-- TOGGLE -->
                                    @if (canToggle)
                                    {
                                    <button type="button"
                                            class="btn btn-sm js-toggle-topping"
                                            title="@(item.Active ? "Khóa" : "Mở khóa")"
                                            onclick="toggleTopping(@item.ToppingId, '@Url.Action("ToggleStatus", "AdminTopping", new { area = "Admin", id = item.ToppingId })')"
                                            data-id="@item.ToppingId"
                                            data-url="@Url.Action("ToggleStatus", "AdminTopping", new { area = "Admin", id = item.ToppingId })">
                                        <i class="fas @(item.Active
                                                        ? "fa-lock text-danger"
                                                        : "fa-unlock text-success")"></i>
                                    </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</main>

<!-- ===================================================== -->
<!-- CREATE MODAL -->
<!-- ===================================================== -->

<div class="modal fade topping-module-modal"
     id="createModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered topping-create-dialog">

        <div class="modal-content topping-create-modal">

            <div class="modal-header">
                <div class="d-flex align-items-center gap-3">
                    <span class="topping-create-icon"><i class="fas fa-cookie-bite"></i></span>
                    <div>
                        <h6 class="fw-bold mb-0">Thêm Topping mới</h6>
                        <small class="text-muted text-uppercase">Cấu hình thực đơn</small>
                    </div>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form id="createToppingForm"
                  asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div class="modal-body">
                    <div class="topping-create-fields">

                    <!-- CODE -->

                    <div class="mb-3 topping-code-field">

                        <label class="form-label">
                            Mã topping
                        </label>

                        <input name="ToppingCode"
                               class="form-control bg-light"
                               maxlength="50"
                               placeholder="Ví dụ: TC_DEN"
                               required />

                        <span class="text-danger"
                              data-valmsg-for="ToppingCode">
                        </span>

                    </div>

                    <!-- NAME -->

                    <div class="mb-3 topping-name-field">

                        <label class="form-label">
                            Tên topping
                        </label>

                        <input name="Name"
                               class="form-control bg-light"
                               maxlength="100"
                               required />

                        <span class="text-danger"
                              data-valmsg-for="Name">
                        </span>

                    </div>

                    <!-- PRICE -->

                    <div class="mb-3 topping-price-field">

                        <label class="form-label">
                            Giá topping
                        </label>

                        <input name="Price"
                               type="number"
                               min="1000"
                               step="1"
                               placeholder="Ví dụ: 5000"
                               class="form-control bg-light"
                               required />

                        <span class="text-danger"
                              data-valmsg-for="Price">
                        </span>

                    </div>

                    <div class="mb-3 topping-ai-section d-none">
                        <label for="toppingAiIdea" class="form-label">Ý tưởng cho AI <span class="text-muted">(không bắt buộc)</span></label>
                        <select id="toppingAiGenerationMode" class="form-select mb-2" aria-label="Chế độ gợi ý topping">
                            <option value="0">Tạo mới</option>
                            <option value="1">Phát triển dữ liệu đang nhập</option>
                            <option value="2">Tạo biến thể</option>
                        </select>
                        <input id="toppingAiIdea" class="form-control mb-2" maxlength="200" placeholder="Ví dụ: trân châu hoàng kim" autocomplete="off" />
                        <button type="button" id="btnToppingAiSuggestion" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-wand-magic-sparkles me-1"></i> AI gợi ý
                        </button>
                        <div id="toppingAiSuggestionPanel" class="ai-suggestion-panel mt-2 d-none">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong>Chọn một gợi ý</strong>
                                <span id="toppingAiSource" class="badge bg-secondary"></span>
                            </div>
                            <div id="toppingAiOptionList" class="ai-option-grid"></div>
                            <div id="toppingAiStatus" class="ai-pipeline-status mt-2" aria-live="polite"></div>
                            <div class="mt-2"><small class="fw-semibold">1. Chọn ảnh tham chiếu Pexels</small></div>
                            <div id="toppingAiReferenceList" class="ai-image-grid"></div>
                            <div class="mt-2"><small class="fw-semibold">2. Chọn ảnh cuối từ Pexels hoặc ComfyUI</small></div>
                            <div id="toppingAiGeneratedList" class="ai-image-grid"></div>
                            <div id="toppingAiWarnings" class="small text-warning mt-1"></div>
                            <div class="d-flex gap-2 mt-2">
                                <button type="button" id="btnApplyToppingAi" class="btn btn-primary btn-sm" disabled>Áp dụng</button>
                                <button type="button" id="btnUseToppingPexels" class="btn btn-outline-success btn-sm" disabled>Dùng ảnh Pexels</button>
                                <button type="button" id="btnGenerateToppingAi" class="btn btn-outline-primary btn-sm" disabled>Tạo lại bằng ComfyUI</button>
                                <button type="button" id="btnGenerateToppingAiWithoutReference" class="btn btn-outline-warning btn-sm d-none">Tạo ảnh bằng ComfyUI không dùng Pexels</button>
                                <button type="button" id="btnRetryToppingAiSearch" class="btn btn-outline-secondary btn-sm" disabled>Tìm lại Pexels</button>
                                <button type="button" id="btnDismissToppingAi" class="btn btn-light btn-sm">Bỏ qua</button>
                            </div>
                        </div>
                    </div>

                    <!-- IMAGE -->

                    <div class="mb-3 topping-image-field">

                        <label class="form-label">
                            Ảnh topping
                        </label>

                        <input type="file"
                               id="create-image-input"
                               name="ImageFile"
                               required
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                               onchange="previewCreateImage(event)" />

                        <small class="text-muted d-block mt-1">

                            JPG, JPEG, PNG, WEBP - Tối đa 3MB

                        </small>

                        <div class="position-relative d-inline-block mt-3">

                            <img id="create-preview"
                                 src="https://res.cloudinary.com/dzfizobk8/image/upload/v1779803296/no-image_vuuic6.jpg"
                                 alt="Preview"
                                 class="rounded preview-img d-none" 
                            />

                            <button type="button"
                                    id="create-remove-btn"
                                    onclick="removeCreateImage()"
                                    class="btn btn-sm btn-danger position-absolute top-0 end-0 d-none">

                                <i class="fas fa-times"></i>

                            </button>

                        </div>

                        <span class="text-danger"
                              data-valmsg-for="ImageFile">
                        </span>

                    </div>
                    </div>

                </div>

                <div class="modal-footer border-0">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Hủy

                    </button>

                    <button type="submit"
                            id="btnCreateTopping"
                            class="btn btn-orange">

                        <i class="fas fa-save me-2"></i>
                        Lưu thông tin

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
<!-- ===================================================== -->
<!-- EDIT MODAL -->
<!-- ===================================================== -->

<div class="modal fade topping-module-modal"
     id="editModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header" style="background:#6F4E37;">

                <h5 class="modal-title" style="color:#fff;">

                    <i class="fas fa-edit me-2"></i>
                    Cập nhật Topping

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form id="editForm"
                  asp-action="Edit"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="edit-id"
                       name="ToppingId" />

                <div class="modal-body">

                    <div class="row">

                        <div class="col-md-7">

                            <!-- CODE -->

                            <div class="mb-3">

                                <label class="form-label">
                                    Mã topping
                                </label>

                                <input id="edit-code"
                                       name="ToppingCode"
                                       class="form-control"
                                       maxlength="50"
                                       required />

                            </div>

                            <div class="mb-3">

                                <label class="form-label">
                                    Tên topping
                                </label>

                                <input id="edit-name"
                                       name="Name"
                                       class="form-control"
                                       maxlength="100"
                                       required />

                            </div>

                            <!-- PRICE -->

                            <div class="mb-3">

                                <label class="form-label">
                                    Giá topping
                                </label>

                                <input id="edit-price"
                                       name="Price"
                                       type="number"
                                       min="1000"
                                       placeholder="Ví dụ: 5000"
                                       step="1"
                                       class="form-control"
                                       required />

                            </div>

                        </div>

                        <div class="col-md-5">

                            <label class="form-label">
                                Ảnh topping
                            </label>

                            <div class="text-center">

                                <img id="edit-preview"
                                     src="https://res.cloudinary.com/dzfizobk8/image/upload/v1779803296/no-image_vuuic6.jpg"
                                     class="img-thumbnail mb-2"
                                     style="width:220px;height:220px;object-fit:cover;" 
                                     alt="Preview"
                                />

                                <input id="edit-image-input"
                                       type="file"
                                       name="ImageFile"
                                       class="form-control"
                                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                       onchange="previewEditImage(event)" />

                                <button type="button"
                                        class="btn btn-outline-danger btn-sm mt-2"
                                        onclick="removeEditImage()">

                                    <i class="fas fa-trash me-1"></i>
                                    Xóa ảnh chọn

                                </button>

                                <div class="form-text mt-2">

                                    Bỏ trống nếu không muốn thay đổi ảnh.

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="submit"
                            id="btnEditTopping"
                            class="btn btn-warning">

                        <i class="fas fa-save me-2"></i>
                        Lưu thay đổi

                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Đóng

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- ===================================================== -->
<!-- DRINK TOPPING MODAL -->
<!-- ===================================================== -->

<div class="modal fade topping-module-modal"
     id="drinkModal"
     tabindex="-1"
     aria-labelledby="drinkModalTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">

        <div class="modal-content border-0 shadow">

            <!-- HEADER -->
            <div class="modal-header border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <div class="topping-create-icon">
                        <i class="fas fa-cookie-bite"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-dark" id="drinkModalTitle">Quản lý Đồ uống - Topping</h5>
                        <small class="text-muted">Gán hoặc ngắt kết nối đồ uống với Topping này</small>
                    </div>
                </div>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <!-- BODY -->
            <div class="modal-body p-4">

                @Html.AntiForgeryToken()

                <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
                    <span class="badge bg-brown px-3 py-2 fs-6 rounded-pill">Topping: <span id="currentToppingBadge"></span></span>
                    <span class="small text-muted"><i class="fas fa-info-circle me-1"></i>Bấm Gán để thêm đồ uống dùng Topping, hoặc Tắt/Bật để quản lý trạng thái</span>
                </div>

                <!-- LOADING -->
                <div id="drinkLoading"
                     class="text-center py-5 d-none">
                    <div class="spinner-border text-primary"></div>
                    <div class="mt-2 text-muted">Đang tải dữ liệu...</div>
                </div>

                <!-- CONTENT -->
                <div id="drinkContent">
                    <div class="row g-4 pb-4">

                        <!-- ASSIGNED -->
                        <div class="col-md-6">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <h6 class="fw-bold mb-0 text-secondary"><i class="fas fa-check-circle me-1 text-success"></i> Đã gán</h6>
                            </div>
                            <div id="assignedList" class="d-flex flex-column gap-2 pb-4">
                                <div class="text-center py-4 text-muted small">Chưa có dữ liệu</div>
                            </div>
                        </div>

                        <!-- UNASSIGNED -->
                        <div class="col-md-6">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <h6 class="fw-bold mb-0 text-secondary"><i class="fas fa-plus-circle me-1 text-primary"></i> Chưa gán</h6>
                            </div>
                            <div id="unassignedList" class="d-flex flex-column gap-2 pb-4">
                                <div class="text-center py-4 text-muted small">Chưa có dữ liệu</div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>

            <!-- FOOTER -->
            <div class="modal-footer border-top bg-light">
                <button type="button"
                        class="btn btn-secondary px-4"
                        data-bs-dismiss="modal">
                    Đóng
                </button>
            </div>

        </div>

    </div>

</div>

<!-- ===================================================== -->
<!-- TOAST CONTAINER -->
<!-- ===================================================== -->

<div id="toast-container"></div>

@section Scripts
