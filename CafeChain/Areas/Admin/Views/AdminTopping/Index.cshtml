@model IEnumerable<CafeChain.ViewModels.Admin.Toppings.AdminToppingVM>

@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();
}

<link rel="stylesheet" href="~/css/Admin/Topping/topping.css" />

<div class="container-fluid p-4">

    <!-- ===================================================== -->
    <!-- TABS -->
    <!-- ===================================================== -->

    <div class="d-flex mb-3 border-bottom">

        <a asp-area="Admin"
           asp-controller="AdminSize"
           asp-action="Index"
           class="me-4 pb-2 text-decoration-none fw-semibold
            @(currentController == "AdminSize"
                ? "text-danger border-bottom border-danger"
                : "text-muted")">

            Quản lý Size

        </a>

        <a asp-area="Admin"
           asp-controller="AdminTopping"
           asp-action="Index"
           class="pb-2 text-decoration-none fw-semibold
            @(currentController == "AdminTopping"
                ? "text-danger border-bottom border-danger"
                : "text-muted")">

            Quản lý Topping

        </a>

    </div>

    <!-- ===================================================== -->
    <!-- CARD -->
    <!-- ===================================================== -->

    <div class="main-card shadow-sm p-3">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <h5 class="fw-bold mb-0">
                Danh sách Topping
            </h5>

            <button type="button"
                    class="btn btn-orange"
                    data-bs-toggle="modal"
                    data-bs-target="#createModal">

                <i class="fas fa-plus me-2"></i>
                Thêm mới

            </button>

        </div>

        <!-- ===================================================== -->
        <!-- TABLE -->
        <!-- ===================================================== -->

        <div class="table-responsive">

            <table class="table table-borderless align-middle">

                <thead class="text-muted">

                    <tr>
                        <th>TOPPING</th>
                        <th>GIÁ</th>
                        <th>TRẠNG THÁI</th>
                        <th class="text-end">HÀNH ĐỘNG</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr class="border-top">

                            <!-- TOPPING -->
                            <td>

                                <div class="d-flex align-items-center">

                                    <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl)
                                                                                             ? "/images/no-image.png"
                                                                                             : item.ImageUrl)"
                                         class="topping-img me-3" />

                                    <div class="fw-semibold">
                                        @item.Name
                                    </div>

                                </div>

                            </td>

                            <!-- PRICE -->
                            <td class="fw-semibold text-danger">

                                + @item.Price.ToString("N0") đ

                            </td>

                            <!-- STATUS -->
                            <td>

                                @if (item.Active)
                                {
                                    <span class="status-active">
                                        Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="status-inactive">
                                        Ngừng
                                    </span>
                                }

                            </td>

                            <!-- ACTIONS -->
                            <td class="text-end">

                                <!-- ASSIGN -->
                                <button type="button"
                                        class="btn btn-sm btn-warning me-2"
                                        onclick="openDrinkModal(
                                    @item.ToppingId,
                                    '@Html.Raw(item.Name.Replace("'", "\\'"))')">

                                    <i class="fas fa-link"></i>

                                </button>

                                <!-- EDIT -->
                                <button type="button"
                                        class="btn btn-sm btn-light me-2 btn-edit-topping"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editModal"
                                        data-id="@item.ToppingId"
                                        data-name="@item.Name"
                                        data-price="@item.Price"
                                        data-image="@item.ImageUrl">

                                    <i class="fas fa-pen text-primary"></i>

                                </button>

                                <!-- TOGGLE -->
                                <button type="button"
                                        class="btn btn-sm"
                                        onclick="toggleTopping(@item.ToppingId)">

                                    <i class="fas @(item.Active
                                                                                   ? "fa-lock text-danger"
                                                                                   : "fa-unlock text-success")"></i>

                                </button>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<!-- ===================================================== -->
<!-- CREATE MODAL -->
<!-- ===================================================== -->

<div class="modal fade"
     id="createModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content p-3">

            <div class="modal-header border-0">

                <h6 class="fw-bold mb-0">
                    Thêm Topping
                </h6>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form id="createToppingForm"
                  asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <!-- NAME -->

                    <div class="mb-3">

                        <label class="form-label">
                            Tên topping
                        </label>

                        <input name="Name"
                               class="form-control bg-light"
                               maxlength="100"
                               required />

                        <span class="text-danger"
                              data-valmsg-for="Name">
                        </span>

                    </div>

                    <!-- PRICE -->

                    <div class="mb-3">

                        <label class="form-label">
                            Giá topping
                        </label>

                        <input name="Price"
                               type="number"
                               min="1000"
                               step="1"
                               placeholder="Ví dụ: 5000"
                               class="form-control bg-light"
                               required />

                        <span class="text-danger"
                              data-valmsg-for="Price">
                        </span>

                    </div>

                    <!-- IMAGE -->

                    <div class="mb-3">

                        <label class="form-label">
                            Ảnh topping
                        </label>

                        <input type="file"
                               id="create-image-input"
                               name="ImageFile"
                               required
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                               onchange="previewCreateImage(event)" />

                        <small class="text-muted d-block mt-1">

                            JPG, JPEG, PNG, WEBP - Tối đa 3MB

                        </small>

                        <div class="position-relative d-inline-block mt-3">

                            <img id="create-preview"
                                 src="https://res.cloudinary.com/dzfizobk8/image/upload/v1779803296/no-image_vuuic6.jpg"
                                 alt="Preview"
                                 class="rounded preview-img d-none" 
                            />

                            <button type="button"
                                    id="create-remove-btn"
                                    onclick="removeCreateImage()"
                                    class="btn btn-sm btn-danger position-absolute top-0 end-0 d-none">

                                <i class="fas fa-times"></i>

                            </button>

                        </div>

                        <span class="text-danger"
                              data-valmsg-for="ImageFile">
                        </span>

                    </div>

                </div>

                <div class="modal-footer border-0">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Hủy

                    </button>

                    <button type="submit"
                            id="btnCreateTopping"
                            class="btn btn-orange">

                        <i class="fas fa-save me-2"></i>
                        Lưu thông tin

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
<!-- ===================================================== -->
<!-- EDIT MODAL -->
<!-- ===================================================== -->

<div class="modal fade"
     id="editModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header bg-warning">

                <h5 class="modal-title">

                    <i class="fas fa-edit me-2"></i>
                    Cập nhật Topping

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form id="editForm"
                  asp-action="Edit"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="edit-id"
                       name="ToppingId" />

                <div class="modal-body">

                    <div class="row">

                        <div class="col-md-7">

                            <!-- NAME -->

                            <div class="mb-3">

                                <label class="form-label">
                                    Tên topping
                                </label>

                                <input id="edit-name"
                                       name="Name"
                                       class="form-control"
                                       maxlength="100"
                                       required />

                            </div>

                            <!-- PRICE -->

                            <div class="mb-3">

                                <label class="form-label">
                                    Giá topping
                                </label>

                                <input id="edit-price"
                                       name="Price"
                                       type="number"
                                       min="1000"
                                       placeholder="Ví dụ: 5000"
                                       step="1"
                                       class="form-control"
                                       required />

                            </div>

                        </div>

                        <div class="col-md-5">

                            <label class="form-label">
                                Ảnh topping
                            </label>

                            <div class="text-center">

                                <img id="edit-preview"
                                     src="https://res.cloudinary.com/dzfizobk8/image/upload/v1779803296/no-image_vuuic6.jpg"
                                     class="img-thumbnail mb-2"
                                     style="width:220px;height:220px;object-fit:cover;" 
                                     alt="Preview"
                                />

                                <input id="edit-image-input"
                                       type="file"
                                       name="ImageFile"
                                       class="form-control"
                                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                       onchange="previewEditImage(event)" />

                                <button type="button"
                                        class="btn btn-outline-danger btn-sm mt-2"
                                        onclick="removeEditImage()">

                                    <i class="fas fa-trash me-1"></i>
                                    Xóa ảnh chọn

                                </button>

                                <div class="form-text mt-2">

                                    Bỏ trống nếu không muốn thay đổi ảnh.

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="submit"
                            id="btnEditTopping"
                            class="btn btn-warning">

                        <i class="fas fa-save me-2"></i>
                        Lưu thay đổi

                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Đóng

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- ===================================================== -->
<!-- DRINK TOPPING MODAL -->
<!-- ===================================================== -->

<div class="modal fade"
     id="drinkModal"
     tabindex="-1"
     aria-labelledby="drinkModalTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">

        <div class="modal-content">

            <!-- HEADER -->

            <div class="modal-header bg-primary text-white">

                <h5 id="drinkModalTitle"
                    class="modal-title">

                    Quản lý Drink - Topping

                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <!-- BODY -->

            <div class="modal-body">

                @Html.AntiForgeryToken()

                <div class="alert alert-info mb-4">

                    <strong>Topping:</strong>

                    <span id="currentToppingBadge"></span>

                </div>

                <!-- LOADING -->

                <div id="drinkLoading"
                     class="text-center py-5 d-none">

                    <div class="spinner-border text-primary">
                    </div>

                    <div class="mt-2">

                        Đang tải dữ liệu...

                    </div>

                </div>

                <!-- CONTENT -->

                <div id="drinkContent">

                    <div class="row">

                        <!-- ASSIGNED -->

                        <div class="col-md-6">

                            <h5 class="text-success mb-3">

                                <i class="fas fa-check-circle me-2"></i>

                                Đã gán

                            </h5>

                            <div id="assignedList"
                                 class="row g-3">

                                <div class="col-12 text-muted">

                                    Chưa có dữ liệu

                                </div>

                            </div>

                        </div>

                        <!-- UNASSIGNED -->

                        <div class="col-md-6">

                            <h5 class="text-warning mb-3">

                                <i class="fas fa-plus-circle me-2"></i>

                                Chưa gán

                            </h5>

                            <div id="unassignedList"
                                 class="row g-3">

                                <div class="col-12 text-muted">

                                    Chưa có dữ liệu

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- FOOTER -->

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Đóng

                </button>

            </div>

        </div>

    </div>

</div>

<!-- ===================================================== -->
<!-- TOAST CONTAINER -->
<!-- ===================================================== -->

<div id="toast-container"></div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/Toast/toast.js"></script>

    <script src="~/js/Admin/Topping/topping.js"></script>
}