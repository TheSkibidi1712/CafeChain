@model List<CafeChain.Application.DTOs.Admin.Suppliers.AdminSupplierDTO>
@{
    ViewData["Title"] = "Nhà cung cấp & nguồn hàng";
    var canMutate = ViewBag.CanMutateSupplier is true;
    var activeCount = Model.Count(x => x.Active);
    var offerCount = Model.Sum(x => x.ActiveOfferCount);
    var storeCount = Model.Sum(x => x.ActiveStoreCount);
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/Supplier/supplier.css" asp-append-version="true" />
}

<main class="supplier-page cc-warehouse-page" data-can-mutate="@canMutate.ToString().ToLowerInvariant()">
    <header class="supplier-page-header cc-warehouse-header">
        <div>
            <p class="supplier-eyebrow">Mua hàng / Nguồn cung</p>
            <h1>Nhà cung cấp & nguồn hàng</h1>
            <p class="supplier-subtitle">Quản lý đầu mối, gói mua, lịch sử giá và phạm vi phục vụ cửa hàng.</p>
        </div>
        @if (canMutate)
        {
            <button type="button" class="supplier-btn supplier-btn-primary" id="createSupplierButton">
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
                Thêm nhà cung cấp
            </button>
        }
    </header>

    <section class="supplier-metrics cc-warehouse-summary-grid" aria-label="Tổng quan nguồn cung">
        <div><strong>@Model.Count</strong><span>Tổng nhà cung cấp</span></div>
        <div><strong>@activeCount</strong><span>Đang hoạt động</span></div>
        <div><strong>@offerCount</strong><span>Gói mua đang áp dụng</span></div>
        <div><strong>@storeCount</strong><span>Lượt gán cửa hàng</span></div>
    </section>

    <section class="supplier-toolbar cc-warehouse-filter" aria-label="Bộ lọc nhà cung cấp">
        <label class="supplier-search">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <input id="supplierSearch" type="search" placeholder="Tìm theo mã, tên, mã số thuế, số điện thoại" autocomplete="off" />
        </label>
        <select id="supplierStatusFilter" aria-label="Lọc trạng thái">
            <option value="all">Tất cả trạng thái</option>
            <option value="active">Đang hoạt động</option>
            <option value="inactive">Ngừng hoạt động</option>
        </select>
        <span class="supplier-result-count" id="supplierResultCount">@Model.Count kết quả</span>
    </section>

    <div class="supplier-workspace">
        <section class="supplier-list-panel" aria-label="Danh sách nhà cung cấp">
            <div class="supplier-table-scroll cc-warehouse-table-shell">
                <table class="supplier-table">
                    <thead>
                        <tr>
                            <th>Nhà cung cấp</th>
                            <th class="text-center">Mã số thuế</th>
                            <th>Đầu mối</th>
                            <th class="text-center">Gói mua</th>
                            <th class="text-center">Cửa hàng</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="supplierRows">
                        @foreach (var item in Model)
                        {
                            <tr data-supplier-id="@item.SupplierId"
                                data-status="@(item.Active ? "active" : "inactive")"
                                data-search="@($"{item.Code} {item.Name} {item.TaxCode} {item.PrimaryPhone} {item.PrimaryContactName} {item.PrimaryContactPhone}".ToLowerInvariant())">
                                <td>
                                    <span class="supplier-code">@item.Code</span>
                                    <strong>@item.Name</strong>
                                    <small>@(string.IsNullOrWhiteSpace(item.Address) ? "Chưa cập nhật địa chỉ" : item.Address)</small>
                                </td>
                                <td class="text-center"><span class="supplier-tax-code">@(string.IsNullOrWhiteSpace(item.TaxCode) ? "—" : item.TaxCode)</span></td>
                                <td>
                                    <span>@(item.PrimaryContactName ?? "Chưa có đầu mối")</span>
                                    <small>@(item.PrimaryContactPhone ?? item.PrimaryPhone ?? "Chưa có số điện thoại")</small>
                                </td>
                                <td class="text-center"><strong class="supplier-number">@item.ActiveOfferCount</strong><small>đang dùng</small></td>
                                <td class="text-center"><strong class="supplier-number">@item.ActiveStoreCount</strong><small>được gán</small></td>
                                <td class="text-center"><span class="supplier-status @(item.Active ? "is-active" : "is-inactive")">@(item.Active ? "Đang hoạt động" : "Ngừng hoạt động")</span></td>
                                <td class="text-center"><button type="button" class="supplier-btn supplier-btn-light open-supplier" data-id="@item.SupplierId">Xem chi tiết</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="supplier-empty cc-warehouse-empty @(Model.Count == 0 ? "" : "is-hidden")" id="supplierEmptyState" role="status">
                <i class="fa-solid fa-box-open" aria-hidden="true"></i>
                <strong>Không có nhà cung cấp phù hợp</strong>
                <span>Thay đổi từ khóa hoặc trạng thái để xem kết quả khác.</span>
            </div>
        </section>

        <aside class="supplier-detail" id="supplierDetail" aria-label="Chi tiết nhà cung cấp" aria-hidden="true">
            <div class="supplier-detail-placeholder" id="supplierDetailPlaceholder">
                <i class="fa-solid fa-truck-ramp-box" aria-hidden="true"></i>
                <strong>Chọn một nhà cung cấp</strong>
                <span>Thông tin vận hành sẽ hiển thị tại đây.</span>
            </div>

            <div class="supplier-detail-content is-hidden" id="supplierDetailContent">
                <header class="supplier-detail-header">
                    <div>
                        <span class="supplier-code" id="detailCode"></span>
                        <h2 id="detailName"></h2>
                        <p id="detailSummary"></p>
                    </div>
                    <button type="button" class="supplier-icon-button" id="closeSupplierDetail" title="Đóng chi tiết" aria-label="Đóng chi tiết">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                </header>

                <nav class="supplier-tabs" aria-label="Nội dung nhà cung cấp">
                    <button type="button" class="is-active" data-tab="overview">Tổng quan</button>
                    <button type="button" data-tab="contacts">Liên hệ</button>
                    <button type="button" data-tab="offers">Gói mua</button>
                    <button type="button" data-tab="pricing">Lịch sử giá</button>
                    <button type="button" data-tab="stores">Cửa hàng</button>
                    <button type="button" data-tab="audit">Theo dõi</button>
                </nav>

                <div class="supplier-tab-body">
                    <section class="supplier-tab is-active" data-tab-panel="overview">
                        <form id="supplierOverviewForm" class="supplier-form">
                            <input type="hidden" id="overviewSupplierId" />
                            <input type="hidden" id="overviewRowVersion" />
                            <div class="supplier-form-grid">
                                <label><span>Tên nhà cung cấp</span><input id="overviewName" required maxlength="200" /></label>
                                <label><span>Mã số thuế</span><input id="overviewTaxCode" maxlength="32" inputmode="numeric" placeholder="Ví dụ: 0312345679 hoặc 0312345679-001" aria-describedby="overviewTaxCodeError" /><small class="supplier-field-error is-hidden" id="overviewTaxCodeError"></small></label>
                                <label><span>Trạng thái</span><select id="overviewActive"><option value="true">Đang hoạt động</option><option value="false">Ngừng hoạt động</option></select></label>
                                <label class="is-wide"><span>Địa chỉ</span><input id="overviewAddress" maxlength="500" /></label>
                                <label class="is-wide"><span>Ghi chú</span><textarea id="overviewNote" rows="4" maxlength="1000"></textarea></label>
                            </div>
                            @if (canMutate)
                            {
                                <div class="supplier-form-actions"><button class="supplier-btn supplier-btn-primary" type="submit">Lưu thông tin</button></div>
                            }
                        </form>
                    </section>

                    <section class="supplier-tab" data-tab-panel="contacts">
                        <div class="supplier-section-heading"><div><h3>Số điện thoại</h3><p>Hotline và số liên hệ chung của nhà cung cấp.</p></div></div>
                        @if (canMutate)
                        {
                            <form class="supplier-inline-form" id="addPhoneForm"><input id="newPhone" placeholder="Số điện thoại mới" required maxlength="20" /><button class="supplier-btn supplier-btn-light" type="submit">Thêm số</button></form>
                        }
                        <div class="supplier-stack" id="phoneList"></div>

                        <div class="supplier-section-heading supplier-section-spaced"><div><h3>Người liên hệ</h3><p>Đầu mối nhận báo giá và xử lý giao hàng.</p></div></div>
                        @if (canMutate)
                        {
                            <form class="supplier-form supplier-subform" id="contactForm">
                                <input type="hidden" id="contactId" />
                                <div class="supplier-form-grid">
                                    <label><span>Họ tên</span><input id="contactName" required /></label>
                                    <label><span>Chức vụ</span><input id="contactPosition" /></label>
                                    <label><span>Điện thoại</span><input id="contactPhone" /></label>
                                    <label><span>Email</span><input id="contactEmail" type="email" /></label>
                                </div>
                                <div class="supplier-form-actions"><button type="button" class="supplier-btn supplier-btn-quiet is-hidden" id="cancelContactEdit">Hủy sửa</button><button class="supplier-btn supplier-btn-light" type="submit" id="saveContactButton">Thêm liên hệ</button></div>
                            </form>
                        }
                        <div class="supplier-stack" id="contactList"></div>
                    </section>

                    <section class="supplier-tab" data-tab-panel="offers">
                        <div class="supplier-section-heading"><div><h3>Quy cách mua nguyên liệu</h3><p>Duy trì giá theo gói và có thể cho phép mua lẻ trực tiếp theo kg, L hoặc cái.</p></div></div>
                        @if (canMutate)
                        {
                            <form class="supplier-form supplier-subform" id="offerForm">
                                <input type="hidden" id="offerId" />
                                <input type="hidden" id="offerRowVersion" />
                                <div class="supplier-form-grid supplier-form-grid-three">
                                    <label><span>Nguyên liệu</span><select id="offerIngredient" required></select></label>
                                    <label><span>Đơn vị nội dung</span><select id="offerUnit" required></select></label>
                                    <label><span>Lượng trong gói</span><input id="offerPackageQuantity" type="number" min="0.00001" step="0.00001" required /></label>
                                    <label><span>Giá một gói</span><input id="offerPrice" type="number" min="0" step="1" required /></label>
                                    <label><span>MOQ (số gói)</span><input id="offerMoq" type="number" min="1" step="1" /></label>
                                    <label><span>Lead time (ngày)</span><input id="offerLeadTime" type="number" min="0" step="1" /></label>
                                    <label class="supplier-check"><input id="offerPrimary" type="checkbox" /><span>Nguồn cung chính</span></label>
                                    <label class="supplier-check"><input id="offerActive" type="checkbox" checked /><span>Đang hoạt động</span></label>
                                    <label class="supplier-check"><input id="offerAllowsLoose" type="checkbox" /><span>Cho phép mua lẻ</span></label>
                                    <label data-loose-field class="is-hidden"><span>Đơn vị mua lẻ</span><select id="offerLooseUnit"></select></label>
                                    <label data-loose-field class="is-hidden"><span>Đơn giá mỗi kg/L/cái</span><input id="offerLoosePrice" type="number" min="0.01" step="1" /></label>
                                    <label class="is-wide"><span>Ghi chú</span><input id="offerNote" /></label>
                                </div>
                                <div class="supplier-form-actions"><button type="button" class="supplier-btn supplier-btn-quiet is-hidden" id="cancelOfferEdit">Hủy sửa</button><button class="supplier-btn supplier-btn-primary" type="submit" id="saveOfferButton">Thêm gói mua</button></div>
                            </form>
                        }
                        <div class="supplier-stack" id="offerList"></div>
                    </section>

                    <section class="supplier-tab" data-tab-panel="pricing">
                        <div class="supplier-section-heading"><div><h3>Thay đổi & lịch sử giá</h3><p>Mỗi thay đổi tạo một bản ghi giá mới và đóng bản ghi hiện hành trước đó.</p></div></div>
                        <div class="supplier-empty-inline" id="pricingEmpty">Chọn “Đổi giá” từ một gói mua để xem lịch sử.</div>
                        <div class="is-hidden" id="pricingWorkspace">
                            <div class="supplier-pricing-title"><strong id="pricingOfferName"></strong><span id="pricingCurrentValue"></span></div>
                            @if (canMutate)
                            {
                                <form class="supplier-form supplier-subform" id="priceChangeForm">
                                    <input type="hidden" id="priceOfferId" />
                                    <input type="hidden" id="priceRowVersion" />
                                    <div class="supplier-form-grid">
                                        <label><span>Giá gói mới</span><input id="newPackagePrice" type="number" min="0" step="1" required /></label>
                                        <label><span>Lượng trong gói</span><input id="newPackageQuantity" type="number" min="0.00001" step="0.00001" required /></label>
                                        <label><span>Đơn vị nội dung</span><select id="newPackageUnit" required></select></label>
                                        <label><span>Lý do thay đổi</span><input id="priceReason" maxlength="500" required /></label>
                                    </div>
                                    <div class="supplier-form-actions"><button class="supplier-btn supplier-btn-primary" type="submit">Xác nhận đổi giá</button></div>
                                </form>
                            }
                            <div class="supplier-history" id="priceHistoryList"></div>
                        </div>
                    </section>

                    <section class="supplier-tab" data-tab-panel="stores">
                        <div class="supplier-section-heading"><div><h3>Phạm vi cửa hàng</h3><p>Cửa hàng chỉ nhận hàng từ nhà cung cấp đã được gán và đang hoạt động.</p></div></div>
                        @if (canMutate)
                        {
                            <form class="supplier-form supplier-subform" id="storeAssignmentForm">
                                <input type="hidden" id="supplierStoreId" />
                                <input type="hidden" id="supplierStoreRowVersion" />
                                <div class="supplier-form-grid">
                                    <label><span>Cửa hàng</span><select id="assignmentStore" required></select></label>
                                    <label><span>Lead time riêng (ngày)</span><input id="assignmentLeadTime" type="number" min="0" step="1" /></label>
                                    <label><span>Lịch giao hàng</span><input id="assignmentSchedule" maxlength="300" /></label>
                                    <label class="supplier-check"><input id="assignmentActive" type="checkbox" checked /><span>Đang hoạt động</span></label>
                                    <label class="is-wide"><span>Ghi chú</span><input id="assignmentNote" maxlength="1000" /></label>
                                </div>
                                <div class="supplier-form-actions"><button type="button" class="supplier-btn supplier-btn-quiet is-hidden" id="cancelStoreEdit">Hủy sửa</button><button class="supplier-btn supplier-btn-primary" type="submit" id="saveStoreButton">Gán cửa hàng</button></div>
                            </form>
                        }
                        <div class="supplier-stack" id="storeList"></div>
                    </section>

                    <section class="supplier-tab" data-tab-panel="audit">
                        <div class="supplier-section-heading"><div><h3>Dấu vết cập nhật</h3><p>Mốc thời gian của hồ sơ nhà cung cấp.</p></div></div>
                        <dl class="supplier-audit-list"><div><dt>Khởi tạo</dt><dd id="auditCreatedAt"></dd></div><div><dt>Cập nhật gần nhất</dt><dd id="auditUpdatedAt"></dd></div><div><dt>Phiên bản dữ liệu</dt><dd id="auditVersion"></dd></div></dl>
                        <div class="supplier-history" id="supplierAuditEvents"></div>
                    </section>
                </div>
            </div>
        </aside>
    </div>
</main>

@if (canMutate)
{
    <div class="supplier-modal" id="createSupplierModal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="createSupplierTitle">
        <div class="supplier-modal-panel cc-modal">
            <header><div><p class="supplier-eyebrow">Hồ sơ nguồn cung</p><h2 id="createSupplierTitle">Thêm nhà cung cấp</h2></div><button type="button" class="supplier-icon-button" data-close-modal aria-label="Đóng"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></header>
            <form class="supplier-form" id="createSupplierForm">
                <div class="supplier-form-grid">
                    <label><span>Tên nhà cung cấp</span><input id="createName" required maxlength="200" /></label>
                    <label><span>Mã số thuế</span><input id="createTaxCode" maxlength="32" inputmode="numeric" placeholder="Ví dụ: 0312345679 hoặc 0312345679-001" aria-describedby="createTaxCodeError" /><small class="supplier-field-error is-hidden" id="createTaxCodeError"></small></label>
                    <label><span>Điện thoại chính</span><input id="createPhone" required maxlength="20" /></label>
                    <label><span>Người liên hệ chính</span><input id="createContactName" required maxlength="200" /></label>
                    <label><span>Điện thoại đầu mối</span><input id="createContactPhone" maxlength="20" /></label>
                    <label><span>Email đầu mối</span><input id="createContactEmail" type="email" maxlength="200" /></label>
                    <label><span>Chức vụ</span><input id="createContactPosition" maxlength="100" /></label>
                    <label class="is-wide"><span>Địa chỉ</span><input id="createAddress" maxlength="500" /></label>
                    <label class="is-wide"><span>Ghi chú</span><textarea id="createNote" rows="3" maxlength="1000"></textarea></label>
                </div>
                <section class="supplier-duplicate-panel is-hidden" id="supplierDuplicatePanel" aria-live="polite">
                    <div>
                        <strong id="duplicatePanelTitle"></strong>
                        <p id="duplicatePanelMessage"></p>
                    </div>
                    <div class="supplier-duplicate-list" id="duplicateSupplierList"></div>
                    <label class="is-hidden" id="duplicateReasonGroup"><span>Lý do vẫn tạo mới</span><textarea id="duplicateReason" maxlength="500" rows="2"></textarea><small class="supplier-field-error is-hidden" id="duplicateReasonError"></small></label>
                    <div class="supplier-form-actions">
                        <button type="button" class="supplier-btn supplier-btn-quiet" id="cancelDuplicateWarning">Hủy cảnh báo</button>
                        <button type="button" class="supplier-btn supplier-btn-light is-hidden" id="openDuplicateSupplier">Mở nhà cung cấp hiện có</button>
                        <button type="button" class="supplier-btn supplier-btn-light is-hidden" id="reactivateDuplicateSupplier">Kích hoạt lại</button>
                        <button type="button" class="supplier-btn supplier-btn-primary is-hidden" id="confirmDuplicateCreate">Xác nhận vẫn tạo mới</button>
                    </div>
                </section>
                <div class="supplier-form-actions"><button type="button" class="supplier-btn supplier-btn-quiet" data-close-modal>Hủy</button><button class="supplier-btn supplier-btn-primary" type="submit">Tạo nhà cung cấp</button></div>
            </form>
        </div>
    </div>
}

<div class="supplier-toast-region" id="supplierToasts" aria-live="polite"></div>

@section Scripts {
    <script src="~/js/Admin/Supplier/supplier.js" asp-append-version="true"></script>
}
