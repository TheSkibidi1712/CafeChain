@model CafeChain.Application.DTOs.Admin.Suppliers.AdminSupplierIndexPageDTO
@using Microsoft.Extensions.Localization
@using System.Text.Json
@inject IStringLocalizer<ProcurementResource> L
@{
    ViewData["Title"] = L["Supplier.Title"].Value;
    var canMutate = ViewBag.CanMutateSupplier is true;
    string J(string key) => JsonSerializer.Serialize(L[key].Value);
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/Supplier/supplier.css" asp-append-version="true" />
}

<main class="supplier-page cc-warehouse-page" data-can-mutate="@canMutate.ToString().ToLowerInvariant()">
    <header class="supplier-page-header cc-warehouse-header">
        <div class="supplier-page-header-copy">
            <p class="supplier-eyebrow">@L["Supplier.Eyebrow"]</p>
            <h1><i class="fa-solid fa-building-shield me-2 text-warning" aria-hidden="true"></i>@L["Supplier.Title"]</h1>
            <p class="supplier-subtitle">@L["Supplier.Subtitle"]</p>
        </div>
        @if (canMutate)
        {
            <button type="button" class="supplier-btn supplier-btn-primary" id="createSupplierButton">
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
                @L["Supplier.Add"]
            </button>
        }
    </header>

    <section class="supplier-metrics cc-warehouse-summary-grid" aria-label="@L["Supplier.Metrics.Aria"]">
        <div><span class="supplier-metric-icon" aria-hidden="true"><i class="fa-solid fa-building"></i></span><span class="supplier-metric-copy"><strong>@Model.SupplierCount</strong><span>@L["Supplier.Metrics.Total"]</span></span></div>
        <div><span class="supplier-metric-icon is-success" aria-hidden="true"><i class="fa-solid fa-circle-check"></i></span><span class="supplier-metric-copy"><strong>@Model.ActiveSupplierCount</strong><span>@L["Supplier.Metrics.Active"]</span></span></div>
        <div><span class="supplier-metric-icon" aria-hidden="true"><i class="fa-solid fa-boxes-stacked"></i></span><span class="supplier-metric-copy"><strong>@Model.ActiveOfferCount</strong><span>@L["Supplier.Metrics.Offers"]</span></span></div>
        <div><span class="supplier-metric-icon" aria-hidden="true"><i class="fa-solid fa-store"></i></span><span class="supplier-metric-copy"><strong>@Model.ActiveStoreCount</strong><span>@L["Supplier.Metrics.Stores"]</span></span></div>
    </section>

    <form method="get" class="supplier-toolbar cc-warehouse-filter" aria-label="@L["Supplier.Filter.Aria"]">
        <div class="supplier-filter-heading">
            <div>
                <span>@L["Supplier.Filter.ScopeLabel"]</span>
                <strong>@L["Supplier.Filter.ScopeTitle"]</strong>
            </div>
            <span class="supplier-filter-scope"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i>@L["Supplier.Filter.ScopeNote"]</span>
        </div>
        <div class="supplier-filter-grid">
            <label class="supplier-search">
                <span>@L["Supplier.Filter.SearchLabel"]</span>
                <span class="supplier-search-control">
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                    <input id="supplierSearch" name="search" value="@Model.Search" type="search" placeholder="@L["Supplier.Filter.SearchPlaceholder"]" autocomplete="off" />
                </span>
            </label>
            <label class="supplier-filter-field">
                <span>@L["Supplier.Filter.StatusLabel"]</span>
                <select id="supplierStatusFilter" name="status">
                    <option value="" selected="@(!Model.Status.HasValue)">@L["Supplier.Filter.AllStatuses"]</option>
                    <option value="true" selected="@(Model.Status == true)">@L["Supplier.Status.Active"]</option>
                    <option value="false" selected="@(Model.Status == false)">@L["Supplier.Status.Inactive"]</option>
                </select>
            </label>
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <div class="supplier-filter-actions">
                <a class="supplier-btn supplier-btn-light" href="@Url.Action("Index")">@L["Supplier.Reset"]</a>
                <button type="submit" class="supplier-btn supplier-btn-primary">
                    <i class="fa-solid fa-filter" aria-hidden="true"></i>
                    @L["Supplier.Apply"]
                </button>
            </div>
        </div>
        <div class="supplier-filter-result">
            <span class="supplier-result-count" id="supplierResultCount">
                @Html.Raw(L["Supplier.Filter.ResultCount", $"<strong>{Model.FirstItemNumber}", $"{Model.LastItemNumber}</strong>", $"<strong>{Model.TotalCount}</strong>"].Value)
            </span>
        </div>
    </form>

    <div class="supplier-workspace">
        <section class="supplier-list-panel" aria-label="@L["Supplier.List.Aria"]">
            <div class="supplier-list-heading">
                <div class="supplier-list-heading-main">
                    <span class="supplier-list-heading-icon" aria-hidden="true">
                        <i class="fa-solid fa-truck-field"></i>
                    </span>
                    <div class="supplier-list-heading-copy">
                        <span class="supplier-list-kicker">@L["Supplier.List.Kicker"]</span>
                        <h2>@L["Supplier.List.Title"]</h2>
                    </div>
                </div>
                <span class="supplier-list-total" aria-label="@L["Supplier.List.TotalAria", Model.TotalCount]">
                    <strong>@Model.TotalCount</strong>
                    <span>@L["Supplier.Col.Name"]</span>
                </span>
            </div>
            <div class="supplier-table-scroll cc-warehouse-table-shell">
                <table class="supplier-table">
                    <colgroup>
                        <col class="supplier-col-identity" />
                        <col class="supplier-col-tax" />
                        <col class="supplier-col-contact" />
                        <col class="supplier-col-count" />
                        <col class="supplier-col-count" />
                        <col class="supplier-col-status" />
                        <col class="supplier-col-action" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>@L["Supplier.Col.Name"]</th>
                            <th class="text-center">@L["Supplier.Col.TaxCode"]</th>
                            <th>@L["Supplier.Col.Contact"]</th>
                            <th class="text-center">@L["Supplier.Col.Offers"]</th>
                            <th class="text-center">@L["Supplier.Col.Stores"]</th>
                            <th class="text-center">@L["Supplier.Col.Status"]</th>
                            <th class="text-center">@L["Supplier.Col.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody id="supplierRows">
                        @foreach (var item in Model.Items)
                        {
                            <tr data-supplier-id="@item.SupplierId">
                                <td>
                                    <span class="supplier-code">@item.Code</span>
                                    <strong>@item.Name</strong>
                                    <small>@(string.IsNullOrWhiteSpace(item.Address) ? L["Supplier.Row.NoAddress"].Value : item.Address)</small>
                                </td>
                                <td class="text-center"><span class="supplier-tax-code">@(string.IsNullOrWhiteSpace(item.TaxCode) ? "—" : item.TaxCode)</span></td>
                                <td>
                                    <span>@(item.PrimaryContactName ?? L["Supplier.Row.NoContact"].Value)</span>
                                    <small>@(item.PrimaryContactPhone ?? item.PrimaryPhone ?? L["Supplier.Row.NoPhone"].Value)</small>
                                </td>
                                <td class="text-center"><strong class="supplier-number">@item.ActiveOfferCount</strong><small>@L["Supplier.Row.OfferSuffix"]</small></td>
                                <td class="text-center"><strong class="supplier-number">@item.ActiveStoreCount</strong><small>@L["Supplier.Row.StoreSuffix"]</small></td>
                                <td class="text-center"><span class="supplier-status @(item.Active ? "is-active" : "is-inactive")">@(item.Active ? L["Supplier.Status.Active"].Value : L["Supplier.Status.Inactive"].Value)</span></td>
                                <td class="text-center"><button type="button" class="supplier-btn supplier-btn-light open-supplier" data-id="@item.SupplierId" aria-label="@L["Supplier.Row.DetailAria", item.Name]">@L["Supplier.Row.Detail"]<i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="supplier-empty cc-warehouse-empty @(Model.Items.Count == 0 ? "" : "is-hidden")" id="supplierEmptyState" role="status">
                <i class="fa-solid fa-box-open" aria-hidden="true"></i>
                <strong>@L["Supplier.Empty.Title"]</strong>
                <span>@L["Supplier.Empty.Text"]</span>
            </div>
            @if (Model.TotalCount > 0 && Model.TotalPages > 1)
            {
                <nav class="supplier-pagination" aria-label="@L["Supplier.Pagination.Aria"]">
                    <a class="supplier-page-link @(Model.HasPreviousPage ? "" : "is-disabled")"
                       href="@(Model.HasPreviousPage ? Url.Action("Index", new { search = Model.Search, status = Model.Status, page = Model.PageIndex - 1, pageSize = Model.PageSize }) : null)"
                       aria-disabled="@(!Model.HasPreviousPage)">
                        <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                        @L["Supplier.Pagination.Previous"]
                    </a>
                    <span>@L["Supplier.Pagination.Page", Model.PageIndex, Model.TotalPages]</span>
                    <a class="supplier-page-link @(Model.HasNextPage ? "" : "is-disabled")"
                       href="@(Model.HasNextPage ? Url.Action("Index", new { search = Model.Search, status = Model.Status, page = Model.PageIndex + 1, pageSize = Model.PageSize }) : null)"
                       aria-disabled="@(!Model.HasNextPage)">
                        @L["Supplier.Pagination.Next"]
                        <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                    </a>
                </nav>
            }
        </section>

        <aside class="offcanvas offcanvas-end supplier-detail" id="supplierDetail" tabindex="-1" aria-label="@L["Supplier.Detail.Aria"]">
            <div class="supplier-detail-placeholder" id="supplierDetailPlaceholder">
                <i class="fa-solid fa-truck-ramp-box" aria-hidden="true"></i>
                <strong>@L["Supplier.Detail.PlaceholderTitle"]</strong>
                <span>@L["Supplier.Detail.PlaceholderText"]</span>
            </div>

            <div class="supplier-detail-content is-hidden" id="supplierDetailContent">
                <header class="supplier-detail-header">
                    <div class="supplier-detail-identity">
                        <span class="supplier-code" id="detailCode"></span>
                        <h2 id="detailName"></h2>
                        <p id="detailSummary"></p>
                        <span class="supplier-status" id="detailStatus"></span>
                    </div>
                    <button type="button" class="supplier-icon-button" id="closeSupplierDetail" data-bs-dismiss="offcanvas" title="@L["Supplier.Detail.Close"]" aria-label="@L["Supplier.Detail.Close"]">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                </header>

                <nav class="supplier-tabs" aria-label="@L["Supplier.Detail.TabsAria"]">
                    <button type="button" class="is-active" data-tab="overview">@L["Supplier.Tab.Overview"]</button>
                    <button type="button" data-tab="contacts">@L["Supplier.Tab.Contacts"]</button>
                    <button type="button" data-tab="offers">@L["Supplier.Tab.Offers"]</button>
                    <button type="button" data-tab="pricing">@L["Supplier.Tab.Pricing"]</button>
                    <button type="button" data-tab="stores">@L["Supplier.Tab.Stores"]</button>
                    <button type="button" data-tab="audit">@L["Supplier.Tab.Audit"]</button>
                </nav>

                <div class="supplier-tab-body">
                    <section class="supplier-tab is-active" data-tab-panel="overview">
                        <form id="supplierOverviewForm" class="supplier-form">
                            <input type="hidden" id="overviewSupplierId" />
                            <input type="hidden" id="overviewRowVersion" />
                            <div class="supplier-form-grid">
                                <label><span>@L["Supplier.Overview.Name"]</span><input id="overviewName" required maxlength="200" /></label>
                                <label><span>@L["Supplier.Overview.TaxCode"]</span><input id="overviewTaxCode" maxlength="32" inputmode="numeric" placeholder="@L["Supplier.Overview.TaxCodePlaceholder"]" aria-describedby="overviewTaxCodeError" /><small class="supplier-field-error is-hidden" id="overviewTaxCodeError"></small></label>
                                <label><span>@L["Supplier.Overview.Status"]</span><select id="overviewActive"><option value="true">@L["Supplier.Status.Active"]</option><option value="false">@L["Supplier.Status.Inactive"]</option></select></label>
                                <label class="is-wide"><span>@L["Supplier.Overview.Address"]</span><input id="overviewAddress" maxlength="500" /></label>
                                <label class="is-wide"><span>@L["Supplier.Overview.Note"]</span><textarea id="overviewNote" rows="4" maxlength="1000"></textarea></label>
                            </div>
                            @if (canMutate)
                            {
                                <div class="supplier-form-actions"><button class="supplier-btn supplier-btn-primary" type="submit">@L["Supplier.Overview.Save"]</button></div>
                            }
                        </form>
                    </section>

                    <section class="supplier-tab" data-tab-panel="contacts">
                        <div class="supplier-section-heading"><div><h3>@L["Supplier.Phones.Title"]</h3><p>@L["Supplier.Phones.Help"]</p></div></div>
                        @if (canMutate)
                        {
                            <form class="supplier-inline-form" id="addPhoneForm"><input id="newPhone" placeholder="@L["Supplier.Phones.NewPlaceholder"]" required maxlength="20" /><button class="supplier-btn supplier-btn-light" type="submit">@L["Supplier.Phones.Add"]</button></form>
                        }
                        <div class="supplier-stack" id="phoneList"></div>

                        <div class="supplier-section-heading supplier-section-spaced"><div><h3>@L["Supplier.Contacts.Title"]</h3><p>@L["Supplier.Contacts.Help"]</p></div></div>
                        @if (canMutate)
                        {
                            <form class="supplier-form supplier-subform" id="contactForm">
                                <input type="hidden" id="contactId" />
                                <div class="supplier-form-grid">
                                    <label><span>@L["Supplier.Contacts.Name"]</span><input id="contactName" required /></label>
                                    <label><span>@L["Supplier.Contacts.Position"]</span><input id="contactPosition" /></label>
                                    <label><span>@L["Supplier.Contacts.Phone"]</span><input id="contactPhone" /></label>
                                    <label><span>@L["Supplier.Contacts.Email"]</span><input id="contactEmail" type="email" /></label>
                                </div>
                                <div class="supplier-form-actions"><button type="button" class="supplier-btn supplier-btn-quiet is-hidden" id="cancelContactEdit">@L["Supplier.CancelEdit"]</button><button class="supplier-btn supplier-btn-light" type="submit" id="saveContactButton">@L["Supplier.Contacts.Add"]</button></div>
                            </form>
                        }
                        <div class="supplier-stack" id="contactList"></div>
                    </section>

                    <section class="supplier-tab" data-tab-panel="offers">
                        <div class="supplier-section-heading"><div><h3>@L["Supplier.Offers.FormTitle"]</h3><p>@L["Supplier.Offers.FormHelp"]</p></div></div>
                        @if (canMutate)
                        {
                            <form class="supplier-form supplier-subform" id="offerForm">
                                <input type="hidden" id="offerId" />
                                <input type="hidden" id="offerRowVersion" />
                                <div class="supplier-form-grid">
                                    <label><span>@L["Supplier.Offers.Ingredient"]</span><select id="offerIngredient" required></select></label>
                                    <label><span>@L["Supplier.Offers.ContentUnit"]</span><select id="offerUnit" required></select></label>
                                    <label><span>@L["Supplier.Offers.PackageQuantity"]</span><input id="offerPackageQuantity" type="number" min="0.00001" step="0.00001" required /></label>
                                    <label><span>@L["Supplier.Offers.PackagePrice"]</span><input id="offerPrice" type="number" min="0" step="1" required /></label>
                                    <label><span>@L["Supplier.Offers.Moq"]</span><input id="offerMoq" type="number" min="1" step="1" /></label>
                                    <label><span>@L["Supplier.Offers.LeadTime"]</span><input id="offerLeadTime" type="number" min="0" step="1" /></label>
                                    <label class="supplier-check"><input id="offerPrimary" type="checkbox" /><span>@L["Supplier.Offers.Primary"]</span></label>
                                    <label class="supplier-check"><input id="offerActive" type="checkbox" checked /><span>@L["Supplier.Offers.Active"]</span></label>
                                    <label class="supplier-check"><input id="offerAllowsLoose" type="checkbox" /><span>@L["Supplier.Offers.AllowLoose"]</span></label>
                                    <label data-loose-field class="is-hidden"><span>@L["Supplier.Offers.LooseUnit"]</span><select id="offerLooseUnit"></select></label>
                                    <label data-loose-field class="is-hidden"><span>@L["Supplier.Offers.LoosePriceMode"]</span><select id="offerLoosePriceMode"><option value="INDEPENDENT">@L["Supplier.Offers.LoosePriceModeIndependent"]</option><option value="DERIVED">@L["Supplier.Offers.LoosePriceModeDerived"]</option></select></label>
                                    <label data-loose-field class="is-hidden"><span id="offerLoosePriceLabel">@L["Supplier.Offers.LoosePrice", L["Supplier.Offers.LoosePriceDefaultUnit"].Value]</span><input id="offerLoosePrice" type="number" min="0.01" step="0.01" /></label>
                                    <label data-loose-field class="is-hidden"><span>@L["Supplier.Offers.LooseMoq"]</span><input id="offerLooseMoq" type="number" min="0" step="0.00001" /><small>@L["Supplier.Offers.LooseMoqHelp"]</small></label>
                                    <label data-loose-field class="is-hidden"><span>@L["Supplier.Offers.LooseStep"]</span><input id="offerLooseStep" type="number" min="0.00001" step="0.00001" /><small>@L["Supplier.Offers.LooseStepHelp"]</small></label>
                                    <label class="is-wide"><span>@L["Supplier.Offers.Note"]</span><input id="offerNote" /></label>
                                </div>
                                <div class="supplier-form-actions"><button type="button" class="supplier-btn supplier-btn-quiet is-hidden" id="cancelOfferEdit">@L["Supplier.CancelEdit"]</button><button class="supplier-btn supplier-btn-primary" type="submit" id="saveOfferButton">@L["Supplier.Offers.Add"]</button></div>
                            </form>
                        }
                        <div class="supplier-stack" id="offerList"></div>
                    </section>

                    <section class="supplier-tab" data-tab-panel="pricing">
                        <div class="supplier-section-heading"><div><h3>@L["Supplier.Pricing.Title"]</h3><p>@L["Supplier.Pricing.Help"]</p></div></div>
                        <div class="supplier-empty-inline" id="pricingEmpty">@L["Supplier.Pricing.Empty"]</div>
                        <div class="is-hidden" id="pricingWorkspace">
                            <div class="supplier-pricing-title"><strong id="pricingOfferName"></strong><span id="pricingCurrentValue"></span></div>
                            @if (canMutate)
                            {
                                <form class="supplier-form supplier-subform" id="priceChangeForm">
                                    <input type="hidden" id="priceOfferId" />
                                    <input type="hidden" id="priceRowVersion" />
                                    <div class="supplier-form-grid">
                                        <label><span>@L["Supplier.Pricing.NewPrice"]</span><input id="newPackagePrice" type="number" min="0" step="1" required /></label>
                                        <label><span>@L["Supplier.Offers.PackageQuantity"]</span><input id="newPackageQuantity" type="number" min="0.00001" step="0.00001" required /></label>
                                        <label><span>@L["Supplier.Offers.ContentUnit"]</span><select id="newPackageUnit" required></select></label>
                                        <label><span>@L["Supplier.Pricing.Reason"]</span><input id="priceReason" maxlength="500" required /></label>
                                    </div>
                                    <div class="supplier-form-actions"><button class="supplier-btn supplier-btn-primary" type="submit">@L["Supplier.Pricing.Confirm"]</button></div>
                                </form>
                            }
                            <div class="supplier-history" id="priceHistoryList"></div>
                        </div>
                    </section>

                    <section class="supplier-tab" data-tab-panel="stores">
                        <div class="supplier-section-heading"><div><h3>@L["Supplier.Stores.Title"]</h3><p>@L["Supplier.Stores.Help"]</p></div></div>
                        @if (canMutate)
                        {
                            <form class="supplier-form supplier-subform" id="storeAssignmentForm">
                                <input type="hidden" id="supplierStoreId" />
                                <input type="hidden" id="supplierStoreRowVersion" />
                                <div class="supplier-form-grid">
                                    <label><span>@L["Supplier.Stores.Store"]</span><select id="assignmentStore" required></select></label>
                                    <label><span>@L["Supplier.Stores.LeadTime"]</span><input id="assignmentLeadTime" type="number" min="0" step="1" /><small>@L["Supplier.Stores.LeadTimeHelp"]</small></label>
                                    <label><span>@L["Supplier.Stores.Schedule"]</span><input id="assignmentSchedule" maxlength="300" placeholder="@L["Supplier.Stores.SchedulePlaceholder"]" /></label>
                                    <label class="supplier-check"><input id="assignmentActive" type="checkbox" checked /><span>@L["Supplier.Stores.Active"]</span></label>
                                    <label class="is-wide"><span>@L["Supplier.Stores.Note"]</span><input id="assignmentNote" maxlength="1000" /></label>
                                </div>
                                <div class="supplier-form-actions"><button type="button" class="supplier-btn supplier-btn-quiet is-hidden" id="cancelStoreEdit">@L["Supplier.CancelEdit"]</button><button class="supplier-btn supplier-btn-primary" type="submit" id="saveStoreButton">@L["Supplier.Stores.Assign"]</button></div>
                            </form>
                        }
                        <div class="supplier-stack" id="storeList"></div>
                    </section>

                    <section class="supplier-tab" data-tab-panel="audit">
                        <div class="supplier-section-heading"><div><h3>@L["Supplier.Audit.Title"]</h3><p>@L["Supplier.Audit.Help"]</p></div></div>
                        <dl class="supplier-audit-list"><div><dt>@L["Supplier.Audit.Created"]</dt><dd id="auditCreatedAt"></dd></div><div><dt>@L["Supplier.Audit.Updated"]</dt><dd id="auditUpdatedAt"></dd></div></dl>
                        <div class="supplier-history" id="supplierAuditEvents"></div>
                    </section>
                </div>
            </div>
        </aside>
    </div>
</main>

@if (canMutate)
{
    <div class="modal fade supplier-modal" id="createSupplierModal" tabindex="-1" aria-hidden="true" aria-labelledby="createSupplierTitle" aria-describedby="createSupplierDescription">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content supplier-modal-panel cc-modal">
            <header>
                <div class="supplier-modal-title">
                    <span class="supplier-modal-icon" aria-hidden="true"><i class="fa-solid fa-building-circle-check"></i></span>
                    <div>
                        <p class="supplier-eyebrow">@L["Supplier.Create.Eyebrow"]</p>
                        <h2 id="createSupplierTitle">@L["Supplier.Create.Title"]</h2>
                        <p id="createSupplierDescription">@L["Supplier.Create.Description"]</p>
                    </div>
                </div>
                <button type="button" class="supplier-icon-button" data-bs-dismiss="modal" aria-label="@L["Supplier.Create.Close"]"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
            </header>
            <form class="supplier-form" id="createSupplierForm">
                <div class="modal-body supplier-modal-body">
                    <div class="supplier-create-grid">
                    <fieldset class="supplier-form-section">
                        <legend>@L["Supplier.Create.CompanyTitle"]</legend>
                        <p class="supplier-form-section-note">@L["Supplier.Create.CompanyNote"]</p>
                        <div class="supplier-form-grid">
                            <label><span>@L["Supplier.Create.Name"] <em>*</em></span><input id="createName" required maxlength="200" /></label>
                            <label><span>@L["Supplier.Overview.TaxCode"]</span><input id="createTaxCode" maxlength="32" inputmode="numeric" placeholder="@L["Supplier.Overview.TaxCodePlaceholder"]" aria-describedby="createTaxCodeError" /><small class="supplier-field-error is-hidden" id="createTaxCodeError"></small></label>
                            <label><span>@L["Supplier.Create.PrimaryPhone"] <em>*</em></span><input id="createPhone" required maxlength="20" /></label>
                            <label class="is-wide"><span>@L["Supplier.Overview.Address"]</span><input id="createAddress" maxlength="500" /></label>
                        </div>
                    </fieldset>

                    <fieldset class="supplier-form-section">
                        <legend>@L["Supplier.Create.MainContactTitle"]</legend>
                        <p class="supplier-form-section-note">@L["Supplier.Create.MainContactNote"]</p>
                        <div class="supplier-form-grid">
                            <label><span>@L["Supplier.Create.ContactName"] <em>*</em></span><input id="createContactName" required maxlength="200" /></label>
                            <label><span>@L["Supplier.Create.ContactPosition"]</span><input id="createContactPosition" maxlength="100" /></label>
                            <label><span>@L["Supplier.Create.ContactPhone"]</span><input id="createContactPhone" maxlength="20" /></label>
                            <label><span>@L["Supplier.Create.ContactEmail"]</span><input id="createContactEmail" type="email" maxlength="200" /></label>
                        </div>
                    </fieldset>

                    <fieldset class="supplier-form-section supplier-form-section-note-field is-wide">
                        <legend>@L["Supplier.Create.NoteTitle"]</legend>
                        <label><span>@L["Supplier.Create.NoteLabel"]</span><textarea id="createNote" rows="3" maxlength="1000" placeholder="@L["Supplier.Create.NotePlaceholder"]"></textarea></label>
                    </fieldset>
                    </div>

                    <section class="supplier-duplicate-panel is-hidden" id="supplierDuplicatePanel" aria-live="polite">
                        <div>
                            <strong id="duplicatePanelTitle"></strong>
                            <p id="duplicatePanelMessage"></p>
                        </div>
                        <div class="supplier-duplicate-list" id="duplicateSupplierList"></div>
                        <label class="is-hidden" id="duplicateReasonGroup"><span>@L["Supplier.Create.DuplicateReason"]</span><textarea id="duplicateReason" maxlength="500" rows="2"></textarea><small class="supplier-field-error is-hidden" id="duplicateReasonError"></small></label>
                        <div class="supplier-form-actions">
                            <button type="button" class="supplier-btn supplier-btn-quiet" id="cancelDuplicateWarning">@L["Supplier.Create.CancelDuplicate"]</button>
                            <button type="button" class="supplier-btn supplier-btn-light is-hidden" id="openDuplicateSupplier">@L["Supplier.Create.OpenExisting"]</button>
                            <button type="button" class="supplier-btn supplier-btn-light is-hidden" id="reactivateDuplicateSupplier">@L["Supplier.Create.Reactivate"]</button>
                            <button type="button" class="supplier-btn supplier-btn-primary is-hidden" id="confirmDuplicateCreate">@L["Supplier.Create.ConfirmDuplicate"]</button>
                        </div>
                    </section>
                </div>
                <footer class="supplier-modal-footer">
                    <span><em>*</em> @L["Supplier.Create.Required"]</span>
                    <div class="supplier-modal-actions">
                        <button type="button" class="supplier-btn supplier-btn-quiet" data-bs-dismiss="modal">@L["Supplier.Cancel"]</button>
                        <button class="supplier-btn supplier-btn-primary" type="submit"><i class="fa-solid fa-plus" aria-hidden="true"></i>@L["Supplier.Create.Submit"]</button>
                    </div>
                </footer>
            </form>
        </div>
        </div>
    </div>
}

