@model CafeChain.ViewModels.Admin.InventoryDocuments.Index.AdminInventoryDocumentIndexVM

@{
    ViewData["Title"] = "Quản lý phiếu kho";
}

<link rel="stylesheet"
      href="~/css/Admin/InventoryDocument/inventorydocument.css" />
<link rel="stylesheet"
      href="~/css/Admin/InventoryDocument/inventorydocumentcreate.css" />

<div class="inventory-page">

    <div class="inventory-header">
        <div>
            <h3>Phiếu Kho</h3>
            <p>
                Quản lý Nhập, Xuất, Kiểm kê và Hủy kho.
            </p>
        </div>

        <div class="inventory-actions">
            <button
                class="btn btn-primary inventory-action-primary"
                id="btnCreateInventory">

                <i class="fas fa-plus"></i>

                Tạo phiếu mới

            </button>

            <button type="button"
                    class="btn btn-outline-secondary inventory-action-secondary"
                    id="btnExportExcel"
                    title="Xuất Excel"
                    aria-label="Xuất Excel">
                <i class="fas fa-file-excel"></i>
                Xuất Excel
            </button>

            <button class="btn btn-outline-secondary inventory-action-secondary"
                    type="button"
                    title="Báo cáo"
                    aria-label="Báo cáo">
                <i class="fas fa-chart-bar"></i>
                Báo cáo
            </button>
        </div>
    </div>

    <partial name="Partials/Detail/_DashboardCards"
             model="Model" />

    <partial name="Partials/Detail/_FilterSection"
             model="Model" />

    <partial name="Partials/Detail/_DocumentTabs"
             model="Model.Filter" />

    <partial name="Partials/Detail/_DocumentTable"
             model="Model" />

</div>


<!-- Modal Detail-->
<div class="modal fade"
     id="inventoryDetailModal"
     tabindex="-1">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">

        <div class="modal-content"
             id="inventoryDetailContent">
        </div>

    </div>

</div>

<!-- Modal Create -->
<div class="modal fade"
     id="inventoryCreateModal"
     tabindex="-1">

    <div
        class="modal-dialog
               modal-fullscreen
               modal-dialog-scrollable">

        <div class="modal-content"
             id="inventoryCreateContent">

        </div>

    </div>

</div>

<script src="~/js/Admin/InventoryDocument/inventorydocument.js"
        asp-append-version="true"></script>
<script src="~/js/Admin/InventoryDocument/inventorydocumentcreate.js"
        asp-append-version="true"></script>
