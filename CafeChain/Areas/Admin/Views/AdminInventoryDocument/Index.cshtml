@model CafeChain.ViewModels.Admin.InventoryDocuments.Index.AdminInventoryDocumentIndexVM

@{
    ViewData["Title"] = "Quản lý phiếu kho";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />
    <link rel="stylesheet" href="~/css/Admin/InventoryDocument/inventorydocument.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/InventoryDocument/inventorydocumentcreate.css" asp-append-version="true" />
}

<main class="inventory-page ops-shell cc-warehouse-page"
     id="inventoryDocumentPage"
     data-detail-url="@Url.Action("DetailModal", "AdminInventoryDocument", new { area = "Admin" })"
     data-create-modal-url="@Url.Action("CreateModal", "AdminInventoryDocument", new { area = "Admin" })"
     data-active-ingredients-url="@Url.Action("ActiveIngredients", "AdminInventoryDocument", new { area = "Admin" })"
     data-store-inventory-ingredients-url="@Url.Action("StoreInventoryIngredients", "AdminInventoryDocument", new { area = "Admin" })"
     data-suppliers-url="@Url.Action("Suppliers", "AdminInventoryDocument", new { area = "Admin" })"
     data-supplier-ingredients-url="@Url.Action("SupplierIngredients", "AdminInventoryDocument", new { area = "Admin" })"
     data-calculate-url="@Url.Action("Calculate", "AdminInventoryDocument", new { area = "Admin" })"
     data-preflight-url="@Url.Action("Preflight", "AdminInventoryDocument", new { area = "Admin" })"
     data-save-draft-url="@Url.Action("SaveDraft", "AdminInventoryDocument", new { area = "Admin" })"
     data-submit-url="@Url.Action("Submit", "AdminInventoryDocument", new { area = "Admin" })"
     data-confirm-draft-url="@Url.Action("ConfirmDraft", "AdminInventoryDocument", new { area = "Admin" })"
     data-cancel-url="@Url.Action("CancelInventoryDocument", "AdminInventoryDocument", new { area = "Admin" })"
     data-export-excel-url="@Url.Action("ExportExcel", "AdminInventoryDocument", new { area = "Admin" })"
     data-export-file-url="@Url.Action("ExportFile", "AdminInventoryDocument", new { area = "Admin" })">

    @Html.AntiForgeryToken()

    <header class="inventory-header ops-header cc-warehouse-header">
        <div>
            <div class="inventory-eyebrow">Kho &amp; Cung ứng / Phiếu kho</div>
            <h1><i class="fa-solid fa-file-lines me-2 text-warning" aria-hidden="true"></i>Quản lý phiếu kho</h1>
            <p class="inventory-subtitle">Theo dõi xuất, kiểm kê và hủy kho trong một không gian rõ ràng, ưu tiên chứng từ cần xử lý.</p>
        </div>

        <div class="inventory-actions ops-actions">
            <button class="btn btn-primary inventory-action-primary" id="btnCreateInventory">
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
                Tạo phiếu mới
            </button>

            <button type="button" class="btn btn-outline-secondary inventory-action-secondary" id="btnExportExcel" title="Xuất Excel" aria-label="Xuất Excel">
                <i class="fa-solid fa-file-excel" aria-hidden="true"></i>
                Xuất Excel
            </button>
        </div>
    </header>

    <div class="inventory-main">
        <partial name="Partials/Detail/_DashboardCards"
                 model="Model" />

        <partial name="Partials/Detail/_FilterSection"
                 model="Model" />

        <section class="inventory-results-panel" aria-label="Danh sách phiếu kho">
            <partial name="Partials/Detail/_DocumentTabs"
                     model="Model.Filter" />

            <partial name="Partials/Detail/_DocumentTable"
                     model="Model" />
        </section>
    </div>
</main>


<!-- Modal Detail-->
<div class="modal fade"
     id="inventoryDetailModal"
     tabindex="-1">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">

        <div class="modal-content"
             id="inventoryDetailContent">
        </div>

    </div>

</div>

<!-- Modal Create -->
<div class="modal fade"
     id="inventoryCreateModal"
     tabindex="-1">

    <div
        class="modal-dialog
               modal-fullscreen
               modal-dialog-scrollable">

        <div class="modal-content"
             id="inventoryCreateContent">

        </div>

    </div>

</div>

@section Scripts {
    <script src="~/js/Admin/InventoryDocument/inventorydocument.js" asp-append-version="true"></script>
    <script src="~/js/Admin/InventoryDocument/inventorydocumentcreate.js" asp-append-version="true"></script>
}
