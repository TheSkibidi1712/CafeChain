@model CafeChain.ViewModels.Admin.InventoryDocuments.Index.AdminInventoryDocumentIndexVM
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<InventoryResource> L

<div class="inventory-cards">

    <div class="dashboard-card total">
        <div class="card-icon">
            <i class="fas fa-file-invoice"></i>
        </div>

        <div class="card-content">
            <div class="value">@Model.TotalDocuments</div>
            <div class="label">@L["InvDoc.Card.Total"]</div>
            <small>@L["InvDoc.Card.TotalHint"]</small>
        </div>
    </div>

    <div class="dashboard-card draft">
        <div class="card-icon">
            <i class="fas fa-edit"></i>
        </div>

        <div class="card-content">
            <div class="value">@Model.DraftDocuments</div>
            <div class="label">@L["InvDoc.Card.Draft"]</div>
            <small>@L["InvDoc.Card.DraftHint"]</small>
        </div>
    </div>

    <div class="dashboard-card confirmed">
        <div class="card-icon">
            <i class="fas fa-check-circle"></i>
        </div>

        <div class="card-content">
            <div class="value">@Model.ConfirmedDocuments</div>
            <div class="label">@L["InvDoc.Card.Confirmed"]</div>
            <small>@L["InvDoc.Card.ConfirmedHint"]</small>
        </div>
    </div>

    <div class="dashboard-card cancelled">
        <div class="card-icon">
            <i class="fas fa-times-circle"></i>
        </div>

        <div class="card-content">
            <div class="value">@Model.CancelledDocuments</div>
            <div class="label">@L["InvDoc.Card.Cancelled"]</div>
            <small>@L["InvDoc.Card.CancelledHint"]</small>
        </div>
    </div>

    <div class="dashboard-card month">
        <div class="card-icon">
            <i class="fas fa-calendar"></i>
        </div>

        <div class="card-content">
            <div class="value">@Model.ThisMonthDocuments</div>
            <div class="label">@L["InvDoc.Card.Month"]</div>
            <small>@L["InvDoc.Card.MonthHint"]</small>
        </div>
    </div>

</div>
