@model CafeChain.ViewModels.Admin.InventoryDocuments.Detail.AdminInventoryDocumentDetailVM
<link rel="stylesheet"
      href="~/css/Admin/InventoryDocument/inventorydocument.css" />

<div class="modal-header inventory-modal-header">

    <div class="document-header">

        <div class="document-icon">

            <i class="fas fa-arrow-down"></i>

        </div>

        <div class="document-header-copy">

            <span class="inventory-detail-eyebrow">Phiếu kho / Chi tiết chứng từ</span>

            <h4>@Model.Code</h4>

            <small>
                @Model.Type.ToVietnamese()
            </small>

        </div>

        <span class="status-badge @Model.Status.ToString().ToLower()">
            @Model.Status.ToVietnamese()
        </span>

    </div>

    <button type="button"
            class="btn-close"
            data-bs-dismiss="modal">
    </button>

</div>

<div class="modal-body">

    <ul class="nav nav-tabs">

        <li class="nav-item">
            <button class="nav-link active"
                    data-bs-toggle="tab"
                    data-bs-target="#general-tab">

                Thông Tin Chung

            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link"
                    data-bs-toggle="tab"
                    data-bs-target="#document-tab">

                Phiếu Chứng Từ

            </button>
        </li>

    </ul>

    <div class="tab-content mt-4">

        <div class="tab-pane fade show active"
             id="general-tab">

            @await Html.PartialAsync(
                "Partials/Detail/_DetailGeneral",
                Model)

        </div>

        <div class="tab-pane fade"
             id="document-tab">

            @await Html.PartialAsync(
                "Partials/Detail/_DetailDocument",
                Model)

        </div>

    </div>

</div>

@if (Model.NegativeApproval != null)
{
    <div class="modal-footer inventory-negative-approval-footer">
        <div class="inventory-negative-approval-summary">
            <i class="fas fa-shield-halved" aria-hidden="true"></i>
            <div>
                <strong>Phê duyệt xuất âm #@Model.NegativeApproval.ApprovalId</strong>
                <span>Trạng thái: @Model.NegativeApproval.Status</span>
            </div>
        </div>

        @if (Model.CanReviewNegativeApproval)
        {
            <div class="voucher-approval-actions" data-negative-approval-actions>
                <button type="button"
                        class="btn btn-outline-danger btn-reject-negative"
                        data-document-id="@Model.InventoryDocumentId"
                        data-url="@Url.Action("RejectNegative", "AdminInventoryDocument", new { area = "Admin", id = Model.InventoryDocumentId })">
                    <i class="fas fa-xmark"></i>
                    Từ chối
                </button>
                <button type="button"
                        class="btn btn-success btn-approve-negative"
                        data-document-id="@Model.InventoryDocumentId"
                        data-url="@Url.Action("ApproveNegative", "AdminInventoryDocument", new { area = "Admin", id = Model.InventoryDocumentId })">
                    <i class="fas fa-check"></i>
                    Duyệt xuất âm
                </button>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(Model.NegativeApprovalReviewMessage))
        {
            <div class="alert alert-info voucher-approval-message mb-0" role="status">
                <i class="fas fa-circle-info" aria-hidden="true"></i>
                <span>@Model.NegativeApprovalReviewMessage</span>
            </div>
        }
    </div>
}
