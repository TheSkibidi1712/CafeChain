@model CafeChain.ViewModels.Admin.InventoryDocuments.Index.AdminInventoryDocumentIndexVM

@using CafeChain.Models.Enums.Inventory

<div class="inventory-table-wrapper">

    <table class="table inventory-table">
        <thead>
            <tr>
                <th>Mã phiếu</th>
                <th>Loại</th>
                <th>Mục đích</th>
                <th>Cửa hàng</th>
                <th>Đối tác</th>
                <th>Ngày</th>
                <th>Giá trị chứng từ</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>

        <tbody>

            @if (!Model.Documents.Items.Any())
            {
                <tr>
                    <td colspan="9" class="text-center">
                        <div class="inventory-empty-state">
                            <strong>Chưa có phiếu kho</strong>
                            <span>Tạo phiếu đầu tiên hoặc thay đổi bộ lọc để xem dữ liệu.</span>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Documents.Items)
                {
                    <tr>

                        <td class="code">
                            @item.Code
                        </td>

                        <td>@item.Type.ToVietnamese()</td>

                        <td>@item.Purpose.ToVietnamese()</td>

                        <td>@item.StoreName</td>

                        <td>@item.PartnerName</td>

                        <td>
                            @item.DocumentDate.ToString("dd/MM/yyyy")
                        </td>

                        <td class="amount-cell"
                            data-amount="@(item.FinalAmount ?? 0)"
                            data-has-amount="@((item.FinalAmount.HasValue && item.FinalAmount.Value > 0).ToString().ToLowerInvariant())">
                        </td>

                        <td>

                            <span class="status-badge @item.Status.ToString().ToLower()">
                                @item.Status.ToVietnamese()
                            </span>

                            @if (item.NegativeApprovalStatus == "REQUESTED")
                            {
                                <span class="negative-approval-list-badge">
                                    <i class="fas fa-user-check" aria-hidden="true"></i>
                                    Chờ duyệt xuất âm
                                </span>

                                @if (!item.CanReviewNegativeApproval
                                    && !string.IsNullOrWhiteSpace(item.NegativeApprovalReviewMessage))
                                {
                                    <small class="negative-approval-list-message"
                                           title="@item.NegativeApprovalReviewMessage">
                                        @item.NegativeApprovalReviewMessage
                                    </small>
                                }
                            }

                        </td>

                        <td>

                            <div class="action-group">

                                <button type="button"
                                        class="table-action btn-detail"
                                        title="Xem chi tiết"
                                        data-id="@item.InventoryDocumentId">

                                    <i class="fas fa-eye"></i>

                                </button>

                                @if (item.CanReviewNegativeApproval)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-success btn-detail btn-open-negative-review"
                                            title="Mở chi tiết để duyệt xuất âm"
                                            data-id="@item.InventoryDocumentId">
                                        <i class="fas fa-user-check" aria-hidden="true"></i>
                                        Mở để duyệt
                                    </button>
                                }

                                @if (item.Status == InventoryDocumentStatus.DRAFT)
                                {
                                    <button type="button"
                                            class="table-action btn-draft-confirm"
                                            title="Xác nhận phiếu nháp"
                                            data-id="@item.InventoryDocumentId">

                                        <i class="fas fa-check"></i>

                                    </button>
                                }

                                <button type="button"
                                        class="table-action btn-export"
                                        title="Xuất file"
                                        data-id="@item.InventoryDocumentId">

                                    <i class="fas fa-print"></i>

                                </button>

                            </div>

                        </td>

                    </tr>
                }
            }

        </tbody>
    </table>

</div>

<div class="table-footer">

    <div class="table-info">
        @if (Model.Documents.TotalCount > 0)
        {
            <span>
                Hiển thị
                @((Model.Documents.PageIndex - 1) * Model.Filter.PageSize + 1)
                -
                @(Math.Min(Model.Documents.PageIndex * Model.Filter.PageSize,
                    Model.Documents.TotalCount))
                trong
                @Model.Documents.TotalCount phiếu
            </span>
        }
    </div>

    @await Html.PartialAsync("_Pagination", Model)

</div>


<div class="modal fade"
     id="exportModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Xuất chứng từ
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <input type="hidden"
                       id="exportDocumentId" />

                <div class="form-check mb-3">

                    <input class="form-check-input"
                           type="radio"
                           name="exportType"
                           value="1"
                           id="pdfExport"
                           checked>

                    <label class="form-check-label"
                           for="pdfExport">

                        PDF

                    </label>

                </div>

                <div class="form-check">

                    <input class="form-check-input"
                           type="radio"
                           name="exportType"
                           value="2"
                           id="wordExport">

                    <label class="form-check-label"
                           for="wordExport">

                        Word (.docx)

                    </label>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary inventory-action-secondary"
                        data-bs-dismiss="modal">

                    Hủy

                </button>

                <button type="button"
                        class="btn btn-primary inventory-action-primary"
                        id="btnConfirmExport">

                    Xuất File

                </button>

            </div>

        </div>

    </div>

</div>

