@model CafeChain.ViewModels.Admin.InventoryDocuments.Index.AdminInventoryDocumentIndexVM

@using CafeChain.Models.Enums.Inventory

<div class="inventory-table-wrapper">

    <div class="inventory-table-heading">
        <div>
            <span class="inventory-section-kicker">Kết quả</span>
            <h4>@Model.Documents.TotalCount phiếu kho</h4>
            <p>Phiếu mới nhất được hiển thị trước.</p>
        </div>
        <span class="inventory-scroll-hint">
            <i class="fas fa-arrows-left-right" aria-hidden="true"></i>
            Cuộn trong vùng bảng
        </span>
    </div>

    <div class="inventory-table-scroll"
         tabindex="0"
         aria-label="Danh sách phiếu kho có thể cuộn ngang">

    <table class="table inventory-table">
        <thead>
            <tr>
                <th>Mã phiếu</th>
                <th>Loại</th>
                <th>Mục đích</th>
                <th>Cửa hàng</th>
                <th>Đối tác</th>
                <th>Ngày</th>
                <th>Giá trị chứng từ</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>

        <tbody>

            @if (!Model.Documents.Items.Any())
            {
                <tr>
                    <td colspan="9" class="text-center">
                        <div class="inventory-empty-state">
                            <strong>Chưa có phiếu kho</strong>
                            <span>Tạo phiếu đầu tiên hoặc thay đổi bộ lọc để xem dữ liệu.</span>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Documents.Items)
                {
                    <tr>

                        <td class="code">
                            @item.Code
                        </td>

                        <td>@item.Type.ToVietnamese()</td>

                        <td>@item.Purpose.ToVietnamese()</td>

                        <td>@item.StoreName</td>

                        <td>@item.PartnerName</td>

                        <td>
                            @item.DocumentDate.ToString("dd/MM/yyyy")
                        </td>

                        <td class="amount-cell"
                            data-amount="@(item.FinalAmount ?? 0)"
                            data-has-amount="@((item.FinalAmount.HasValue && item.FinalAmount.Value > 0).ToString().ToLowerInvariant())">
                        </td>

                        <td>

                            <span class="status-badge @item.Status.ToString().ToLower()">
                                @item.Status.ToVietnamese()
                            </span>

                            @if (item.NegativeApprovalStatus == "REQUESTED")
                            {
                                <span class="negative-approval-list-badge">
                                    <i class="fas fa-user-check" aria-hidden="true"></i>
                                    Chờ duyệt xuất âm
                                </span>

                                @if (!item.CanReviewNegativeApproval
                                    && !string.IsNullOrWhiteSpace(item.NegativeApprovalReviewMessage))
                                {
                                    <small class="negative-approval-list-message"
                                           title="@item.NegativeApprovalReviewMessage">
                                        @item.NegativeApprovalReviewMessage
                                    </small>
                                }
                            }

                        </td>

                        <td>

                            <div class="action-group">

                                <button type="button"
                                        class="table-action btn-detail"
                                        title="Xem chi tiết"
                                        data-id="@item.InventoryDocumentId">

                                    <i class="fas fa-eye"></i>

                                </button>

                                @if (item.CanReviewNegativeApproval)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-success btn-detail btn-open-negative-review"
                                            title="Mở chi tiết để duyệt xuất âm"
                                            data-id="@item.InventoryDocumentId">
                                        <i class="fas fa-user-check" aria-hidden="true"></i>
                                        Mở để duyệt
                                    </button>
                                }

                                @if (item.Status == InventoryDocumentStatus.DRAFT)
                                {
                                    <button type="button"
                                            class="table-action btn-draft-confirm"
                                            title="Xác nhận phiếu nháp"
                                            data-id="@item.InventoryDocumentId">

                                        <i class="fas fa-check"></i>

                                    </button>
                                }

                                <button type="button"
                                        class="table-action btn-export"
                                        title="Xuất file"
                                        data-id="@item.InventoryDocumentId">

                                    <i class="fas fa-print"></i>

                                </button>

                            </div>

                        </td>

                    </tr>
                }
            }

        </tbody>
    </table>

    </div>

</div>

<div class="table-footer">

    <div class="table-info">
        @if (Model.Documents.TotalCount > 0)
        {
            <span>
                Hiển thị
                @((Model.Documents.PageIndex - 1) * Model.Filter.PageSize + 1)
                -
                @(Math.Min(Model.Documents.PageIndex * Model.Filter.PageSize,
                    Model.Documents.TotalCount))
                trong
                @Model.Documents.TotalCount phiếu
            </span>
        }
    </div>

    @await Html.PartialAsync("_Pagination", Model)

</div>


<div class="modal fade"
     id="exportModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header inventory-export-header">

                <div class="inventory-export-title">
                    <span><i class="fas fa-file-export" aria-hidden="true"></i></span>
                    <div>
                        <small>Phiếu kho / Xuất chứng từ</small>
                        <h5 class="modal-title">Chọn định dạng xuất</h5>
                    </div>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body inventory-export-body">

                <input type="hidden"
                       id="exportDocumentId" />

                <p class="inventory-export-lead">Tải chứng từ rõ ràng để lưu trữ, in hoặc gửi đối tác.</p>

                <div class="inventory-export-options">
                <label class="inventory-export-option" for="pdfExport">

                    <input class="form-check-input"
                           type="radio"
                           name="exportType"
                           value="1"
                           id="pdfExport"
                           checked>

                    <span class="inventory-export-option-icon"><i class="fas fa-file-pdf"></i></span>
                    <span class="inventory-export-option-copy">
                        <span class="inventory-export-option-heading">
                            <strong>PDF</strong>
                            <em>Khuyên dùng</em>
                        </span>
                        <small>Tối ưu để in, ký xác nhận và lưu trữ chính thức</small>
                    </span>
                    <span class="inventory-export-option-check" aria-hidden="true">
                        <i class="fas fa-check"></i>
                    </span>
                </label>

                <label class="inventory-export-option" for="wordExport">

                    <input class="form-check-input"
                           type="radio"
                           name="exportType"
                           value="2"
                           id="wordExport">

                    <span class="inventory-export-option-icon"><i class="fas fa-file-word"></i></span>
                    <span class="inventory-export-option-copy">
                        <span class="inventory-export-option-heading">
                            <strong>Word (.docx)</strong>
                            <em>Có thể chỉnh sửa</em>
                        </span>
                        <small>Phù hợp khi cần bổ sung hoặc hiệu chỉnh nội dung</small>
                    </span>
                    <span class="inventory-export-option-check" aria-hidden="true">
                        <i class="fas fa-check"></i>
                    </span>
                </label>
                </div>

                <div class="inventory-export-note" role="note">
                    <i class="fas fa-circle-info" aria-hidden="true"></i>
                    File xuất chỉ chứa dữ liệu chứng từ, không thay đổi tồn kho hệ thống.
                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary inventory-action-secondary"
                        data-bs-dismiss="modal">

                    <i class="fas fa-xmark" aria-hidden="true"></i>
                    Hủy

                </button>

                <button type="button"
                        class="btn btn-primary inventory-action-primary"
                        id="btnConfirmExport">

                    <i class="fas fa-download" aria-hidden="true"></i>
                    Xuất file

                </button>

            </div>

        </div>

    </div>

</div>

