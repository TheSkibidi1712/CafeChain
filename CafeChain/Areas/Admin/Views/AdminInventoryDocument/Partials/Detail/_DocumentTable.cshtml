@model CafeChain.ViewModels.Admin.InventoryDocuments.Index.AdminInventoryDocumentIndexVM

@using CafeChain.Models.Enums.Inventory

<div class="inventory-table-wrapper">

    <table class="table inventory-table">
        <thead>
            <tr>
                <th>Mã Phiếu</th>
                <th>Loại</th>
                <th>Mục Đích</th>
                <th>Cửa Hàng</th>
                <th>Đối Tác</th>
                <th>Ngày</th>
                <th>Giá Trị</th>
                <th>Trạng Thái</th>
                <th>Thao Tác</th>
            </tr>
        </thead>

        <tbody>

            @if (!Model.Documents.Items.Any())
            {
                <tr>
                    <td colspan="9" class="text-center">
                        Không có dữ liệu
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Documents.Items)
                {
                    <tr>

                        <td class="code">
                            @item.Code
                        </td>

                        <td>@item.Type.ToVietnamese()</td>

                        <td>@item.Purpose.ToVietnamese()</td>

                        <td>@item.StoreName</td>

                        <td>@item.PartnerName</td>

                        <td>
                            @item.DocumentDate.ToString("dd/MM/yyyy")
                        </td>

                        <td class="amount-cell"
                            data-amount="@(item.FinalAmount ?? 0)">
                        </td>

                        <td>

                            <span class="status-badge @item.Status.ToString().ToLower()">
                                @item.Status.ToVietnamese()
                            </span>

                        </td>

                        <td>

                            <div class="action-group">

                                <button type="button"
                                        class="table-action btn-detail"
                                        title="Xem chi tiết"
                                        data-id="@item.InventoryDocumentId">

                                    <i class="fas fa-eye"></i>

                                </button>

                                @if (item.Status == InventoryDocumentStatus.DRAFT)
                                {
                                    <button type="button"
                                            class="table-action btn-draft-confirm"
                                            title="Xác nhận phiếu nháp"
                                            data-id="@item.InventoryDocumentId">

                                        <i class="fas fa-check"></i>

                                    </button>
                                }

                                <button type="button"
                                        class="table-action btn-export"
                                        title="Xuất file"
                                        data-id="@item.InventoryDocumentId">

                                    <i class="fas fa-print"></i>

                                </button>

                            </div>

                        </td>

                    </tr>
                }
            }

        </tbody>
    </table>

</div>

<div class="table-footer">

    <div class="table-info">
        Hiển thị
        @((Model.Documents.PageIndex - 1) * Model.Filter.PageSize + 1)
        -
        @(Math.Min(Model.Documents.PageIndex * Model.Filter.PageSize,
            Model.Documents.TotalCount))
        trong
        @Model.Documents.TotalCount phiếu
    </div>

    @await Html.PartialAsync("_Pagination", Model)

</div>


<div class="modal fade"
     id="exportModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Xuất chứng từ
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <input type="hidden"
                       id="exportDocumentId" />

                <div class="form-check mb-3">

                    <input class="form-check-input"
                           type="radio"
                           name="exportType"
                           value="1"
                           id="pdfExport"
                           checked>

                    <label class="form-check-label"
                           for="pdfExport">

                        PDF

                    </label>

                </div>

                <div class="form-check">

                    <input class="form-check-input"
                           type="radio"
                           name="exportType"
                           value="2"
                           id="wordExport">

                    <label class="form-check-label"
                           for="wordExport">

                        Word (.docx)

                    </label>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Hủy

                </button>

                <button type="button"
                        class="btn btn-primary"
                        id="btnConfirmExport">

                    Xuất File

                </button>

            </div>

        </div>

    </div>

</div>

