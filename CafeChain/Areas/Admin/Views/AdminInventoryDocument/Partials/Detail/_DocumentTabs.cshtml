@model CafeChain.Application.DTOs.Admin.InventoryDocuments.Index.AdminInventoryDocumentFilterDTO
@using CafeChain.Models.Enums.Inventory
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<InventoryResource> L

@{
    string ActiveFor(InventoryDocumentType? type, InventoryDocumentPurpose? purpose = null)
    {
        return Model.Type == type && Model.Purpose == purpose ? "active" : "";
    }

    var allActive = !Model.Type.HasValue && !Model.Purpose.HasValue ? "active" : "";
}

<div class="inventory-tabs">

    <a asp-action="Index"
       class="tab-btn @allActive">
        @L["InvDoc.Tab.All"]
    </a>

    <a asp-action="Index"
       asp-route-Type="EXPORT"
       class="tab-btn @ActiveFor(InventoryDocumentType.EXPORT)">
        @L["InvDoc.Tab.Export"]
    </a>

    <a asp-action="Index"
       asp-route-Type="STOCK_TAKE"
       class="tab-btn @ActiveFor(InventoryDocumentType.STOCK_TAKE)">
        @L["InvDoc.Tab.StockTake"]
    </a>

    <a asp-action="Index"
       asp-route-Type="WASTE"
       class="tab-btn @ActiveFor(InventoryDocumentType.WASTE)">
        @L["InvDoc.Tab.Waste"]
    </a>

</div>
