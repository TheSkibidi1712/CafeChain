@model CafeChain.ViewModels.Admin.InventoryDocuments.Detail.AdminInventoryDocumentDetailVM
@using CafeChain.Models.Enums.Inventory

@{
    var documentTitle = Model.Type switch
    {
        InventoryDocumentType.IMPORT => "PHIẾU NHẬP KHO",
        InventoryDocumentType.EXPORT => "PHIẾU XUẤT KHO",
        InventoryDocumentType.STOCK_TAKE => "PHIẾU KIỂM KÊ",
        InventoryDocumentType.WASTE => "PHIẾU HỦY KHO",
        InventoryDocumentType.PRODUCTION_IN => "PHIẾU NHẬP SẢN XUẤT",
        InventoryDocumentType.PRODUCTION_OUT => "PHIẾU XUẤT SẢN XUẤT",
        InventoryDocumentType.SALES_DEDUCTION => "PHIẾU TRỪ TỒN BÁN HÀNG",
        _ => "PHIẾU KHO"
    };

    var isSupplierPurchase = Model.Type == InventoryDocumentType.IMPORT && Model.Purpose == InventoryDocumentPurpose.IMPORT_PURCHASE;
    var hideMoneyColumns =
        Model.Type == InventoryDocumentType.STOCK_TAKE
        || Model.Type == InventoryDocumentType.WASTE;
    var quantityLabel =
        Model.Type == InventoryDocumentType.STOCK_TAKE
            ? "SL thực tế"
            : Model.Type == InventoryDocumentType.WASTE
                ? "SL hủy"
                : "SL";
}

<link rel="stylesheet"
      href="~/css/Admin/InventoryDocument/inventorydocument.css" />

<div class="voucher-preview voucher-preview-readonly">

    <div class="voucher-title">

        <h2>CAFECHAIN</h2>

        <h5>@documentTitle</h5>

        <span class="voucher-readonly-badge">
            Chỉ xem
        </span>

    </div>

    <div class="voucher-info voucher-readonly-grid">

        <div class="voucher-readonly-field">
            <label>Số phiếu</label>
            <strong>@Model.Code</strong>
        </div>

        <div class="voucher-readonly-field">
            <label>Ngày chứng từ</label>
            <strong>@Model.DocumentDate.ToString("dd/MM/yyyy")</strong>
        </div>

        <div class="voucher-readonly-field">
            <label>Kho</label>
            <strong>@Model.StoreName</strong>
        </div>

        <div class="voucher-readonly-field">
            <label>Người lập</label>
            <strong>@Model.StaffName</strong>
        </div>

        <div class="voucher-readonly-field">
            <label>Nhà cung cấp</label>
            <strong>@(Model.SupplierName ?? "-")</strong>
        </div>

        @if (!isSupplierPurchase && !string.IsNullOrWhiteSpace(Model.PartnerName))
        {
            <div class="voucher-readonly-field">
                <label>Đối tác</label>
                <strong>@Model.PartnerName</strong>
            </div>
        }

        @if (Model.Type == InventoryDocumentType.EXPORT)
        {
            <div class="voucher-readonly-field">
                <label>Cho phép xuất âm</label>
                <strong>@(Model.AllowNegativeStock ? "Có" : "Không")</strong>
            </div>
        }

    </div>

    @if (Model.NegativeApproval != null)
    {
        <section class="voucher-approval-panel" aria-label="Lịch sử phê duyệt tồn âm">
            <h6>Phê duyệt tồn âm #@Model.NegativeApproval.ApprovalId</h6>
            <div class="voucher-readonly-grid">
                <div class="voucher-readonly-field"><label>Trạng thái</label><strong>@Model.NegativeApproval.Status</strong></div>
                <div class="voucher-readonly-field"><label>Người đề nghị</label><strong>@Model.NegativeApproval.RequesterName</strong></div>
                <div class="voucher-readonly-field"><label>Người duyệt</label><strong>@(Model.NegativeApproval.ApproverName ?? "-")</strong></div>
                <div class="voucher-readonly-field"><label>Policy</label><strong>@Model.NegativeApproval.PolicyVersion</strong></div>
                <div class="voucher-readonly-field"><label>Đề nghị lúc</label><strong>@Model.NegativeApproval.RequestedAt.ToString("dd/MM/yyyy HH:mm")</strong></div>
                <div class="voucher-readonly-field"><label>Duyệt lúc</label><strong>@(Model.NegativeApproval.ReviewedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</strong></div>
            </div>
            <p><strong>Lý do:</strong> @Model.NegativeApproval.Reason</p>
            @if (!string.IsNullOrWhiteSpace(Model.NegativeApproval.ReviewNote))
            {
                <p><strong>Ghi chú duyệt:</strong> @Model.NegativeApproval.ReviewNote</p>
            }
            <table class="voucher-table voucher-readonly-table">
                <thead><tr><th>Identity</th><th class="text-end">Before</th><th class="text-end">Issue</th><th class="text-end">After</th><th class="text-end">Limit</th></tr></thead>
                <tbody>
                @foreach (var line in Model.NegativeApproval.Lines)
                {
                    <tr>
                        <td>@(line.IngredientId.HasValue ? $"Ingredient #{line.IngredientId}" : $"PreparedItem #{line.PreparedItemId}")</td>
                        <td class="text-end">@line.BeforeQty.ToString("0.###")</td>
                        <td class="text-end">@line.IssueQty.ToString("0.###")</td>
                        <td class="text-end">@line.ProjectedAfterQty.ToString("0.###")</td>
                        <td class="text-end">@line.EffectiveMaxNegativeQty.ToString("0.###")</td>
                    </tr>
                }
                </tbody>
            </table>
        </section>
    }

    @if (Model.CostGaps.Count > 0)
    {
        <section class="voucher-approval-panel" aria-label="Trạng thái cost gap">
            <h6>Cost-gap</h6>
            <table class="voucher-table voucher-readonly-table">
                <thead><tr><th>Mã</th><th>Nguồn</th><th>Trạng thái</th><th class="text-end">Ban đầu</th><th class="text-end">Đã settle</th><th class="text-end">Còn lại</th></tr></thead>
                <tbody>
                @foreach (var gap in Model.CostGaps)
                {
                    <tr>
                        <td>#@gap.GapId</td><td>@gap.SourceType</td><td>@gap.Status</td>
                        <td class="text-end">@gap.OriginalQuantity.ToString("0.###")</td>
                        <td class="text-end">@gap.SettledQuantity.ToString("0.###")</td>
                        <td class="text-end">@gap.OutstandingQuantity.ToString("0.###")</td>
                    </tr>
                }
                </tbody>
            </table>
        </section>
    }

    <div class="voucher-table-wrap">

        <table class="voucher-table voucher-readonly-table">

            <thead>

                <tr>

                    <th>STT</th>
                    <th>Tên hàng</th>
                    <th class="text-center">
                        DVT
                    </th>
                    <th class="text-end">@quantityLabel</th>
                    @if (!hideMoneyColumns)
                    {
                        <th class="text-end">
                            Đơn giá vốn
                        </th>
                        <th class="text-end">Thành tiền</th>
                    }

                </tr>

            </thead>

            <tbody>

                @{
                    var stt = 1;
                }

                @foreach (var item in Model.Details)
                {
                    <tr>

                        <td>@stt</td>

                        <td>
                            <strong>@item.IngredientName</strong>
                        </td>

                        <td class="text-center">
                            <span class="readonly-pill">
                                @item.UnitName
                            </span>
                        </td>

                        <td class="text-end">
                            @item.Quantity.ToString("0.##")
                        </td>

                        @if (!hideMoneyColumns)
                        {
                            <td class="text-end">
                                <span class="readonly-pill">
                                    @(item.UnitPrice?.ToString("N0") ?? "0")
                                </span>
                            </td>

                            <td class="text-end item-total"
                                data-value="@(item.TotalAmount ?? 0)">
                                @(item.TotalAmount?.ToString("N0") ?? "0")
                            </td>
                        }

                    </tr>

                    stt++;
                }

            </tbody>

        </table>

    </div>

    @if (!hideMoneyColumns)
    {
        <div class="voucher-summary">

            <div>
                <span>Tổng tiền</span>
                <strong>@(Model.TotalAmount?.ToString("N0") ?? "0")</strong>
            </div>

            <div>
                <span>VAT</span>
                <strong>@(Model.VatAmount?.ToString("N0") ?? "0")</strong>
            </div>

            <div class="final">
                <span>Thành tiền</span>
                <strong>@(Model.FinalAmount?.ToString("N0") ?? "0")</strong>
            </div>

        </div>
    }

</div>
