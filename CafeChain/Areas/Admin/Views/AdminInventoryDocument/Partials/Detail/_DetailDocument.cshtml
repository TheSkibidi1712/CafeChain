@model CafeChain.ViewModels.Admin.InventoryDocuments.Detail.AdminInventoryDocumentDetailVM
@using CafeChain.Models.Enums.Inventory
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<InventoryResource> L

@{
    var documentTitle = Model.Type switch
    {
        InventoryDocumentType.IMPORT => L["InvDoc.Voucher.Import"].Value,
        InventoryDocumentType.EXPORT => L["InvDoc.Voucher.Export"].Value,
        InventoryDocumentType.STOCK_TAKE => L["InvDoc.Voucher.StockTake"].Value,
        InventoryDocumentType.WASTE => L["InvDoc.Voucher.Waste"].Value,
        InventoryDocumentType.PRODUCTION_IN => L["InvDoc.Voucher.ProdIn"].Value,
        InventoryDocumentType.PRODUCTION_OUT => L["InvDoc.Voucher.ProdOut"].Value,
        InventoryDocumentType.SALES_DEDUCTION => L["InvDoc.Voucher.SalesDeduction"].Value,
        _ => L["InvDoc.Voucher.Default"].Value
    };

    var isSupplierPurchase = Model.Type == InventoryDocumentType.IMPORT && Model.Purpose == InventoryDocumentPurpose.IMPORT_PURCHASE;
    var hideMoneyColumns =
        Model.Type == InventoryDocumentType.STOCK_TAKE
        || Model.Type == InventoryDocumentType.WASTE;
    var quantityLabel =
        Model.Type == InventoryDocumentType.STOCK_TAKE
            ? L["InvDoc.Qty.ActualShort"].Value
            : Model.Type == InventoryDocumentType.WASTE
                ? L["InvDoc.Qty.WasteShort"].Value
                : L["InvDoc.Qty.Short"].Value;
}

<link rel="stylesheet"
      href="~/css/Admin/InventoryDocument/inventorydocument.css" />

<div class="voucher-preview voucher-preview-readonly">

    <div class="voucher-title">

        <h2>CAFECHAIN</h2>

        <h5>@documentTitle</h5>

        <span class="voucher-readonly-badge">
            @L["InvDoc.Voucher.ReadOnly"]
        </span>

    </div>

    <div class="voucher-info voucher-readonly-grid">

        <div class="voucher-readonly-field">
            <label>@L["InvDoc.Voucher.Number"]</label>
            <strong>@Model.Code</strong>
        </div>

        <div class="voucher-readonly-field">
            <label>@L["InvDoc.General.Date"]</label>
            <strong>@Model.DocumentDate.ToString("dd/MM/yyyy")</strong>
        </div>

        <div class="voucher-readonly-field">
            <label>@L["InvDoc.Voucher.Warehouse"]</label>
            <strong>@Model.StoreName</strong>
        </div>

        <div class="voucher-readonly-field">
            <label>@L["InvDoc.General.Staff"]</label>
            <strong>@Model.StaffName</strong>
        </div>

        <div class="voucher-readonly-field">
            <label>@L["InvDoc.General.Supplier"]</label>
            <strong>@(Model.SupplierName ?? "-")</strong>
        </div>

        @if (!isSupplierPurchase && !string.IsNullOrWhiteSpace(Model.PartnerName))
        {
            <div class="voucher-readonly-field">
                <label>@L["InvDoc.General.Partner"]</label>
                <strong>@Model.PartnerName</strong>
            </div>
        }

        @if (Model.Type == InventoryDocumentType.EXPORT)
        {
            <div class="voucher-readonly-field">
                <label>@L["InvDoc.Voucher.StockMode"]</label>
                <strong>@(Model.AllowNegativeStock ? L["InvDoc.Voucher.NegativeMode"].Value : L["InvDoc.Voucher.NormalMode"].Value)</strong>
            </div>
        }

    </div>

    @if (Model.NegativeApproval != null)
    {
        <section class="voucher-approval-panel" aria-label="@L["InvDoc.Voucher.ApprovalAria"]">
            <h6>@L["InvDoc.Voucher.ApprovalTitle", Model.NegativeApproval.ApprovalId]</h6>
            <div class="voucher-readonly-grid">
                <div class="voucher-readonly-field"><label>@L["InvDoc.General.Status"]</label><strong>@Model.NegativeApproval.Status</strong></div>
                <div class="voucher-readonly-field"><label>@L["InvDoc.Voucher.Requester"]</label><strong>@Model.NegativeApproval.RequesterName</strong></div>
                <div class="voucher-readonly-field"><label>@L["InvDoc.Voucher.Approver"]</label><strong>@(Model.NegativeApproval.ApproverName ?? "-")</strong></div>
                <div class="voucher-readonly-field"><label>@L["InvDoc.Voucher.Policy"]</label><strong>@Model.NegativeApproval.PolicyVersion</strong></div>
                <div class="voucher-readonly-field"><label>@L["InvDoc.Voucher.RequestedAt"]</label><strong>@Model.NegativeApproval.RequestedAt.ToString("dd/MM/yyyy HH:mm")</strong></div>
                <div class="voucher-readonly-field"><label>@L["InvDoc.Voucher.ReviewedAt"]</label><strong>@(Model.NegativeApproval.ReviewedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</strong></div>
            </div>
            <p><strong>@L["InvDoc.Voucher.Reason"]</strong> @Model.NegativeApproval.Reason</p>
            @if (!string.IsNullOrWhiteSpace(Model.NegativeApproval.ReviewNote))
            {
                <p><strong>@L["InvDoc.Voucher.ReviewNote"]</strong> @Model.NegativeApproval.ReviewNote</p>
            }
            <table class="voucher-table voucher-readonly-table">
                <thead><tr><th>@L["InvDoc.Voucher.Identity"]</th><th class="text-end">@L["InvDoc.Voucher.Before"]</th><th class="text-end">@L["InvDoc.Voucher.Issue"]</th><th class="text-end">@L["InvDoc.Voucher.After"]</th><th class="text-end">@L["InvDoc.Voucher.Limit"]</th></tr></thead>
                <tbody>
                @foreach (var line in Model.NegativeApproval.Lines)
                {
                    <tr>
                        <td>@(line.IngredientId.HasValue ? L["InvDoc.Voucher.IngredientId", line.IngredientId].Value : L["InvDoc.Voucher.PreparedId", line.PreparedItemId].Value)</td>
                        <td class="text-end">@line.BeforeQty.ToString("0.###")</td>
                        <td class="text-end">@line.IssueQty.ToString("0.###")</td>
                        <td class="text-end">@line.ProjectedAfterQty.ToString("0.###")</td>
                        <td class="text-end">@line.EffectiveMaxNegativeQty.ToString("0.###")</td>
                    </tr>
                }
                </tbody>
            </table>
        </section>
    }

    @if (Model.CostGaps.Count > 0)
    {
        <section class="voucher-approval-panel" aria-label="@L["InvDoc.Voucher.CostGapAria"]">
            <h6>@L["InvDoc.Voucher.CostGap"]</h6>
            <table class="voucher-table voucher-readonly-table">
                <thead><tr><th>@L["InvDoc.Voucher.Code"]</th><th>@L["InvDoc.Voucher.Source"]</th><th>@L["InvDoc.General.Status"]</th><th class="text-end">@L["InvDoc.Voucher.Original"]</th><th class="text-end">@L["InvDoc.Voucher.Settled"]</th><th class="text-end">@L["InvDoc.Voucher.Remaining"]</th></tr></thead>
                <tbody>
                @foreach (var gap in Model.CostGaps)
                {
                    <tr>
                        <td>#@gap.GapId</td><td>@gap.SourceType</td><td>@gap.Status</td>
                        <td class="text-end">@gap.OriginalQuantity.ToString("0.###")</td>
                        <td class="text-end">@gap.SettledQuantity.ToString("0.###")</td>
                        <td class="text-end">@gap.OutstandingQuantity.ToString("0.###")</td>
                    </tr>
                }
                </tbody>
            </table>
        </section>
    }

    <div class="voucher-table-wrap">

        <table class="voucher-table voucher-readonly-table">

            <thead>

                <tr>

                    <th>@L["InvDoc.Voucher.No"]</th>
                    <th>@L["InvDoc.Voucher.ItemName"]</th>
                    <th class="text-center">
                        @L["InvDoc.General.Unit"]
                    </th>
                    <th class="text-end">@quantityLabel</th>
                    @if (!hideMoneyColumns)
                    {
                        <th class="text-end">
                            @L["InvDoc.Voucher.CostPrice"]
                        </th>
                        <th class="text-end">@L["InvDoc.Summary.Final"]</th>
                    }

                </tr>

            </thead>

            <tbody>

                @{
                    var stt = 1;
                }

                @foreach (var item in Model.Details)
                {
                    <tr>

                        <td>@stt</td>

                        <td>
                            <strong>@item.IngredientName</strong>
                        </td>

                        <td class="text-center">
                            <span class="readonly-pill">
                                @item.UnitName
                            </span>
                        </td>

                        <td class="text-end">
                            @item.Quantity.ToString("0.##")
                        </td>

                        @if (!hideMoneyColumns)
                        {
                            <td class="text-end">
                                <span class="readonly-pill">
                                    @(item.UnitPrice?.ToString("N0") ?? "0")
                                </span>
                            </td>

                            <td class="text-end item-total"
                                data-value="@(item.TotalAmount ?? 0)">
                                @(item.TotalAmount?.ToString("N0") ?? "0")
                            </td>
                        }

                    </tr>

                    stt++;
                }

            </tbody>

        </table>

    </div>

    @if (!hideMoneyColumns)
    {
        <div class="voucher-summary">

            <div>
                <span>@L["InvDoc.Summary.Total"]</span>
                <strong>@(Model.TotalAmount?.ToString("N0") ?? "0")</strong>
            </div>

            <div>
                <span>@L["InvDoc.Summary.Vat"]</span>
                <strong>@(Model.VatAmount?.ToString("N0") ?? "0")</strong>
            </div>

            <div class="final">
                <span>@L["InvDoc.Summary.Final"]</span>
                <strong>@(Model.FinalAmount?.ToString("N0") ?? "0")</strong>
            </div>

        </div>
    }

</div>
