@model CafeChain.ViewModels.Admin.InventoryDocuments.Detail.AdminInventoryDocumentDetailVM
@using CafeChain.Models.Enums.Inventory

@{
    var documentTitle = Model.Type switch
    {
        InventoryDocumentType.IMPORT => "PHIẾU NHẬP KHO",
        InventoryDocumentType.EXPORT => "PHIẾU XUẤT KHO",
        InventoryDocumentType.STOCK_TAKE => "PHIẾU KIỂM KÊ",
        InventoryDocumentType.WASTE => "PHIẾU HỦY HÀNG",
        InventoryDocumentType.PRODUCTION_IN => "PHIẾU NHẬP SẢN XUẤT",
        InventoryDocumentType.PRODUCTION_OUT => "PHIẾU XUẤT SẢN XUẤT",
        InventoryDocumentType.SALES_DEDUCTION => "PHIẾU TRỪ TỒN BÁN HÀNG",
        _ => "PHIẾU KHO"
    };

    var isSupplierPurchase = Model.Type == InventoryDocumentType.IMPORT && Model.Purpose == InventoryDocumentPurpose.IMPORT_PURCHASE;
    var hideMoneyColumns =
        Model.Type == InventoryDocumentType.STOCK_TAKE
        || Model.Type == InventoryDocumentType.WASTE;
    var quantityLabel =
        Model.Type == InventoryDocumentType.STOCK_TAKE
            ? "SL thực tế"
            : Model.Type == InventoryDocumentType.WASTE
                ? "SL hủy"
                : "SL";
}

<link rel="stylesheet"
      href="~/css/Admin/InventoryDocument/inventorydocument.css" />

<div class="voucher-preview voucher-preview-readonly">

    <div class="voucher-title">

        <h2>CAFECHAIN</h2>

        <h5>@documentTitle</h5>

        <span class="voucher-readonly-badge">
            Chỉ xem
        </span>

    </div>

    <div class="voucher-info voucher-readonly-grid">

        <div class="voucher-readonly-field">
            <label>Số phiếu</label>
            <strong>@Model.Code</strong>
        </div>

        <div class="voucher-readonly-field">
            <label>Ngày chứng từ</label>
            <strong>@Model.DocumentDate.ToString("dd/MM/yyyy")</strong>
        </div>

        <div class="voucher-readonly-field">
            <label>Kho</label>
            <strong>@Model.StoreName</strong>
        </div>

        <div class="voucher-readonly-field">
            <label>Người lập</label>
            <strong>@Model.StaffName</strong>
        </div>

        <div class="voucher-readonly-field">
            <label>Nhà cung cấp</label>
            <strong>@(Model.SupplierName ?? "-")</strong>
        </div>

        @if (!isSupplierPurchase && !string.IsNullOrWhiteSpace(Model.PartnerName))
        {
            <div class="voucher-readonly-field">
                <label>Đối tác</label>
                <strong>@Model.PartnerName</strong>
            </div>
        }

    </div>

    <div class="voucher-table-wrap">

        <table class="voucher-table voucher-readonly-table">

            <thead>

                <tr>

                    <th>STT</th>
                    <th>Tên hàng</th>
                    <th class="text-center">
                        DVT
                    </th>
                    <th class="text-end">@quantityLabel</th>
                    @if (!hideMoneyColumns)
                    {
                        <th class="text-end">
                            Đơn giá
                        </th>
                        <th class="text-end">Thành tiền</th>
                    }

                </tr>

            </thead>

            <tbody>

                @{
                    var stt = 1;
                }

                @foreach (var item in Model.Details)
                {
                    <tr>

                        <td>@stt</td>

                        <td>
                            <strong>@item.IngredientName</strong>
                        </td>

                        <td class="text-center">
                            <span class="readonly-pill">
                                @item.UnitName
                            </span>
                        </td>

                        <td class="text-end">
                            @item.Quantity.ToString("0.##")
                        </td>

                        @if (!hideMoneyColumns)
                        {
                            <td class="text-end">
                                <span class="readonly-pill">
                                    @(item.UnitPrice?.ToString("N0") ?? "0")
                                </span>
                            </td>

                            <td class="text-end item-total"
                                data-value="@(item.TotalAmount ?? 0)">
                                @(item.TotalAmount?.ToString("N0") ?? "0")
                            </td>
                        }

                    </tr>

                    stt++;
                }

            </tbody>

        </table>

    </div>

    @if (!hideMoneyColumns)
    {
        <div class="voucher-summary">

            <div>
                <span>Tổng tiền</span>
                <strong>@(Model.TotalAmount?.ToString("N0") ?? "0")</strong>
            </div>

            <div>
                <span>VAT</span>
                <strong>@(Model.VatAmount?.ToString("N0") ?? "0")</strong>
            </div>

            <div class="final">
                <span>Thành tiền</span>
                <strong>@(Model.FinalAmount?.ToString("N0") ?? "0")</strong>
            </div>

        </div>
    }

</div>
