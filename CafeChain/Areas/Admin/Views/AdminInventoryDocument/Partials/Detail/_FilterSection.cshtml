@model CafeChain.ViewModels.Admin.InventoryDocuments.Index.AdminInventoryDocumentIndexVM
@using CafeChain.Models.Enums.Inventory

@{
    var fromDateIso = Model.Filter.FromDate?.ToString("yyyy-MM-dd") ?? "";
    var fromDateDisplay = Model.Filter.FromDate?.ToString("dd/MM/yyyy") ?? "";
    var toDateIso = Model.Filter.ToDate?.ToString("yyyy-MM-dd") ?? "";
    var toDateDisplay = Model.Filter.ToDate?.ToString("dd/MM/yyyy") ?? "";
}

<form method="get"
      asp-action="Index"
      id="filterForm">

    <div class="filter-container">

        <div class="search-box">
            <input asp-for="Filter.Search"
                   class="form-control"
                   placeholder="Tìm mã phiếu, cửa hàng, đối tác, người lập..."
                   aria-label="Tìm kiếm phiếu kho" />
        </div>

        <div class="filter-row">

            <select asp-for="Filter.Type"
                    class="form-select">

                <option value="">Loại phiếu</option>

                @foreach (var item in new[]
                {
                    InventoryDocumentType.IMPORT,
                    InventoryDocumentType.EXPORT,
                    InventoryDocumentType.STOCK_TAKE,
                    InventoryDocumentType.WASTE,
                    InventoryDocumentType.PRODUCTION_IN,
                    InventoryDocumentType.PRODUCTION_OUT,
                    InventoryDocumentType.SALES_DEDUCTION
                })
                {
                    <option value="@item">@item.ToVietnamese()</option>
                }

            </select>

            <select asp-for="Filter.Status"
                    class="form-select">

                <option value="">Trạng thái</option>

                @foreach (var item in Enum.GetValues<InventoryDocumentStatus>())
                {
                    <option value="@item">@item.ToVietnamese()</option>
                }

            </select>

            <select asp-for="Filter.Purpose"
                    class="form-select">

                <option value="">Mục đích</option>

                @foreach (var item in new[]
                {
                    InventoryDocumentPurpose.IMPORT_PURCHASE,
                    InventoryDocumentPurpose.IMPORT_ADJUSTMENT,
                    InventoryDocumentPurpose.SALE,
                    InventoryDocumentPurpose.ADJUSTMENT_OUT,
                    InventoryDocumentPurpose.STOCK_TAKE,
                    InventoryDocumentPurpose.DAMAGED,
                    InventoryDocumentPurpose.EXPIRED,
                    InventoryDocumentPurpose.BROKEN,
                    InventoryDocumentPurpose.CONTAMINATED,
                    InventoryDocumentPurpose.LOST,
                    InventoryDocumentPurpose.DEBT
                })
                {
                    <option value="@item">@item.ToVietnamese()</option>
                }

            </select>

            <select asp-for="Filter.StoreId"
                    class="form-select">

                <option value="">Cửa hàng</option>

                @foreach (var store in Model.Stores)
                {
                    <option value="@store.StoreId">
                        @store.StoreName
                    </option>
                }

            </select>

            <div class="filter-date-field">
                <label asp-for="Filter.FromDate">Từ ngày</label>
                <input type="hidden"
                       id="Filter_FromDate"
                       name="Filter.FromDate"
                       value="@fromDateIso" />
                <input type="text"
                       class="form-control vn-date-input"
                       value="@fromDateDisplay"
                      placeholder="dd/mm/yyyy"
                       inputmode="numeric"
                       autocomplete="off"
                       data-date-hidden="Filter_FromDate"
                      aria-label="Từ ngày dạng dd/mm/yyyy" />
            </div>

            <div class="filter-date-field">
                <label asp-for="Filter.ToDate">Đến ngày</label>
                <input type="hidden"
                       id="Filter_ToDate"
                       name="Filter.ToDate"
                       value="@toDateIso" />
                <input type="text"
                       class="form-control vn-date-input"
                       value="@toDateDisplay"
                      placeholder="dd/mm/yyyy"
                       inputmode="numeric"
                       autocomplete="off"
                       data-date-hidden="Filter_ToDate"
                      aria-label="Đến ngày dạng dd/mm/yyyy" />
            </div>

            <div class="filter-actions">

                <a asp-action="Index"
                   class="btn btn-light inventory-action-secondary">
                    Đặt lại
                </a>

                <button type="submit"
                        class="btn btn-primary inventory-action-primary">
                    Áp dụng
                </button>

            </div>

        </div>

    </div>

</form>
