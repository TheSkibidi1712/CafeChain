@model CafeChain.ViewModels.Admin.InventoryDocuments.Index.AdminInventoryDocumentIndexVM
@using CafeChain.Models.Enums.Inventory
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<InventoryResource> L

<form method="get"
      asp-action="Index"
      id="filterForm">

    <div class="filter-container">

        <div class="inventory-section-heading">
            <div>
                <span class="inventory-section-kicker">@L["InvDoc.Filter.Kicker"]</span>
                <h4>@L["InvDoc.Filter.Title"]</h4>
                <p>@L["InvDoc.Filter.Hint"]</p>
            </div>
            <span class="inventory-section-pill">@L["InvDoc.Filter.Pill"]</span>
        </div>

        <div class="search-box">
            <button type="submit" class="search-btn" title="@L["InvDoc.Filter.Search"]" aria-label="@L["InvDoc.Filter.Search"]">
                <i class="fas fa-search" aria-hidden="true"></i>
            </button>
            <input asp-for="Filter.Search"
                   class="form-control"
                   placeholder="@L["InvDoc.Filter.SearchPlaceholder"]"
                   aria-label="@L["InvDoc.Filter.SearchAria"]" />
        </div>

        <div class="filter-row">

            <div class="filter-field">
                <label for="inventoryFilterType">@L["InvDoc.Filter.Type"]</label>
                <select asp-for="Filter.Type"
                        id="inventoryFilterType"
                        class="form-select">

                    <option value="">@L["InvDoc.Filter.AllTypes"]</option>

                    @foreach (var item in new[]
                    {
                        InventoryDocumentType.EXPORT,
                        InventoryDocumentType.STOCK_TAKE,
                        InventoryDocumentType.WASTE
                    })
                    {
                        <option value="@item">@item.ToVietnamese()</option>
                    }

                </select>
            </div>

            <div class="filter-field">
                <label for="Filter_Status">@L["InvDoc.Filter.Status"]</label>
                <select asp-for="Filter.Status"
                        class="form-select">

                    <option value="">@L["InvDoc.Filter.AllStatuses"]</option>

                    @foreach (var item in Enum.GetValues<InventoryDocumentStatus>())
                    {
                        <option value="@item">@item.ToVietnamese()</option>
                    }

                </select>
            </div>

            <div class="filter-field">
                <label for="inventoryFilterPurpose">@L["InvDoc.Filter.Purpose"]</label>
                <select asp-for="Filter.Purpose"
                        id="inventoryFilterPurpose"
                        class="form-select"
                        disabled="@(!Model.Filter.Type.HasValue)">

                    <option value="">@(Model.Filter.Type.HasValue ? L["InvDoc.Filter.AllPurposes"].Value : L["InvDoc.Filter.SelectTypeFirst"].Value)</option>

                    @foreach (var item in new[]
                    {
                        new { Purpose = InventoryDocumentPurpose.IMPORT_PURCHASE, Type = InventoryDocumentType.IMPORT, Label = InventoryDocumentPurpose.IMPORT_PURCHASE.ToVietnamese() },
                        new { Purpose = InventoryDocumentPurpose.IMPORT_ADJUSTMENT, Type = InventoryDocumentType.IMPORT, Label = L["InvDoc.Filter.HistorySuffix", InventoryDocumentPurpose.IMPORT_ADJUSTMENT.ToVietnamese()].Value },
                        new { Purpose = InventoryDocumentPurpose.SALE, Type = InventoryDocumentType.EXPORT, Label = InventoryDocumentPurpose.SALE.ToVietnamese() },
                        new { Purpose = InventoryDocumentPurpose.STOCK_TAKE, Type = InventoryDocumentType.STOCK_TAKE, Label = InventoryDocumentPurpose.STOCK_TAKE.ToVietnamese() },
                        new { Purpose = InventoryDocumentPurpose.DAMAGED, Type = InventoryDocumentType.WASTE, Label = InventoryDocumentPurpose.DAMAGED.ToVietnamese() },
                        new { Purpose = InventoryDocumentPurpose.EXPIRED, Type = InventoryDocumentType.WASTE, Label = InventoryDocumentPurpose.EXPIRED.ToVietnamese() },
                        new { Purpose = InventoryDocumentPurpose.BROKEN, Type = InventoryDocumentType.WASTE, Label = InventoryDocumentPurpose.BROKEN.ToVietnamese() },
                        new { Purpose = InventoryDocumentPurpose.CONTAMINATED, Type = InventoryDocumentType.WASTE, Label = InventoryDocumentPurpose.CONTAMINATED.ToVietnamese() },
                        new { Purpose = InventoryDocumentPurpose.LOST, Type = InventoryDocumentType.WASTE, Label = InventoryDocumentPurpose.LOST.ToVietnamese() }
                    })
                    {
                        <option value="@item.Purpose"
                                data-document-type="@item.Type">
                            @item.Label
                        </option>
                    }

                </select>
            </div>

            <div class="filter-field">
                <label for="Filter_StoreId">@L["InvDoc.Filter.Store"]</label>
                <select asp-for="Filter.StoreId"
                        class="form-select">

                    <option value="">@L["InvDoc.Filter.AllStores"]</option>

                    @foreach (var store in Model.Stores)
                    {
                        <option value="@store.StoreId">
                            @store.StoreName
                        </option>
                    }

                </select>
            </div>

            <div class="filter-field filter-date-field">
                <label asp-for="Filter.FromDate">@L["InvDoc.Filter.FromDate"]</label>
                <input asp-for="Filter.FromDate"
                       type="date"
                       class="form-control"
                       value="@(Model.Filter.FromDate?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="filter-field filter-date-field">
                <label asp-for="Filter.ToDate">@L["InvDoc.Filter.ToDate"]</label>
                <input asp-for="Filter.ToDate"
                       type="date"
                       class="form-control"
                       value="@(Model.Filter.ToDate?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="filter-actions">

                <a asp-action="Index"
                   class="btn btn-light inventory-action-secondary">
                    <i class="fas fa-rotate-left" aria-hidden="true"></i>
                    @L["InvDoc.Filter.Reset"]
                </a>

                <button type="submit"
                        class="btn btn-primary inventory-action-primary">
                    <i class="fas fa-filter" aria-hidden="true"></i>
                    @L["InvDoc.Filter.Apply"]
                </button>

            </div>

        </div>

    </div>

</form>
