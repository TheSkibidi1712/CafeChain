@model CafeChain.ViewModels.Admin.InventoryDocuments.Detail.AdminInventoryDocumentDetailVM
@using CafeChain.Models.Enums.Inventory
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<InventoryResource> L

@{
    var isSupplierPurchase = Model.Type == InventoryDocumentType.IMPORT
        && Model.Purpose == InventoryDocumentPurpose.IMPORT_PURCHASE;
    var showSupplier = !string.IsNullOrWhiteSpace(Model.SupplierName);
    var showPartner = !isSupplierPurchase && !string.IsNullOrWhiteSpace(Model.PartnerName);
    var hideMoneyColumns =
        Model.Type == InventoryDocumentType.STOCK_TAKE
        || Model.Type == InventoryDocumentType.WASTE;
    var quantityLabel =
        Model.Type == InventoryDocumentType.STOCK_TAKE
            ? L["InvDoc.Qty.Actual"].Value
            : Model.Type == InventoryDocumentType.WASTE
                ? L["InvDoc.Qty.Waste"].Value
                : L["InvDoc.Qty.Default"].Value;
}

<div class="detail-card">

    <div class="detail-card-heading">
        <span><i class="fas fa-circle-info"></i></span>
        <div><small>@L["InvDoc.General.InfoKicker"]</small><h6>@L["InvDoc.General.InfoTitle"]</h6></div>
    </div>

    <div class="detail-grid">

        <div>
            <span class="detail-label">@L["InvDoc.General.Code"]</span>
            <strong>@Model.Code</strong>
        </div>

        <div>
            <span class="detail-label">@L["InvDoc.General.Type"]</span>
            <strong>@Model.Type.ToVietnamese()</strong>
        </div>  

        <div>
            <span class="detail-label">@L["InvDoc.General.Status"]</span>

            <span class="status-badge @Model.Status.ToString().ToLower()">
                @Model.Status.ToVietnamese()
            </span>
        </div>

        <div>
            <span class="detail-label">@L["InvDoc.General.Purpose"]</span>
            <strong>@Model.Purpose.ToVietnamese()</strong>
        </div>

        <div>
            <span class="detail-label">@L["InvDoc.General.Date"]</span>
            <strong>
                @Model.DocumentDate.ToString("dd/MM/yyyy")
            </strong>
        </div>

        <div>
            <span class="detail-label">@L["InvDoc.General.RequestKey"]</span>
            <strong>
                @Model.RequestKey
            </strong>
        </div>

    </div>

</div>

<div class="detail-card">

    <div class="detail-card-heading">
        <span><i class="fas fa-warehouse"></i></span>
        <div><small>@L["InvDoc.General.ScopeKicker"]</small><h6>@L["InvDoc.General.ScopeTitle"]</h6></div>
    </div>

    <div class="detail-grid">

        <div>
            <span class="detail-label">@L["InvDoc.General.Store"]</span>
            <strong>@Model.StoreName</strong>
        </div>

        <div>
            <span class="detail-label">@L["InvDoc.General.Staff"]</span>
            <strong>@Model.StaffName</strong>
        </div>


        <div>
            <span class="detail-label">@L["InvDoc.General.Processing"]</span>

            <strong>
                @(Model.IsProcessing ? L["InvDoc.Yes"].Value : L["InvDoc.No"].Value)
            </strong>
        </div>

    </div>

</div>

<div class="detail-card">

    <div class="detail-card-heading">
        <span><i class="fas fa-users"></i></span>
        <div><small>@L["InvDoc.General.RelatedKicker"]</small><h6>@L["InvDoc.General.RelatedTitle"]</h6></div>
    </div>

    <div class="detail-grid">

        @if (showSupplier)
        {
            <div>
                <span class="detail-label">@L["InvDoc.General.Supplier"]</span>
                <strong>@Model.SupplierName</strong>
            </div>
        }

        @if (showPartner)
        {
            <div>
                <span class="detail-label">@L["InvDoc.General.Partner"]</span>
                <strong>@Model.PartnerName</strong>
            </div>
        }

        @if (!isSupplierPurchase && Model.PartnerType != InventoryPartnerType.NONE)
        {
            <div>
                <span class="detail-label">@L["InvDoc.General.PartnerType"]</span>
                <strong>@Model.PartnerType</strong>
            </div>
        }

        @if (!showSupplier && !showPartner && Model.PartnerType == InventoryPartnerType.NONE)
        {
            <div>
                <span class="detail-label">@L["InvDoc.General.Subject"]</span>
                <strong>-</strong>
            </div>
        }

    </div>

</div>

<div class="detail-card">

    <div class="detail-card-heading">
        <span><i class="fas fa-boxes-stacked"></i></span>
        <div><small>@L["InvDoc.General.LinesKicker"]</small><h6>@L["InvDoc.General.LinesTitle"]</h6></div>
    </div>

    <div class="table-responsive">

        <table class="table inventory-detail-table">

            <thead>
                <tr>

                    <th>@L["InvDoc.General.IngredientName"]</th>
                    <th>@L["InvDoc.General.Unit"]</th>
                    <th class="text-end">@quantityLabel</th>
                    <th class="text-end">@L["InvDoc.General.Conversion"]</th>
                    @if (!hideMoneyColumns)
                    {
                        <th class="text-end">@L["InvDoc.General.UnitPrice"]</th>
                        <th class="text-end">@L["InvDoc.General.LineTotal"]</th>
                    }

                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model.Details)
                {
                    <tr>

                        <td>
                            @item.IngredientName
                        </td>

                        <td>
                            @item.UnitName
                        </td>

                        <td class="text-end">
                            @item.Quantity.ToString("0.##")
                        </td>

                        <td class="text-end">
                            @item.BaseQuantity.ToString("0.##")
                        </td>

                        @if (!hideMoneyColumns)
                        {
                            <td class="text-end">

                                @(
                                    item.UnitPrice?.ToString("N0")
                                    ?? "0"
                                )

                            </td>

                            <td class="text-end item-total"
                                data-value="@(item.TotalAmount ?? 0)">

                                @(
                                    item.TotalAmount?.ToString("N0")
                                    ?? "0"
                                )

                            </td>
                        }

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

@if (!hideMoneyColumns)
{
    <div class="summary-box"
         data-total="@(Model.TotalAmount ?? 0)"
         data-vat="@(Model.VatAmount ?? 0)"
         data-final="@(Model.FinalAmount ?? 0)">

    <div class="summary-item">

        <span>@L["InvDoc.Summary.Total"]</span>

        <h4 id="totalAmount">
            @(Model.TotalAmount?.ToString("N0") ?? "0")
        </h4>

    </div>

    <div class="summary-item">

        <span>@L["InvDoc.Summary.Vat"]</span>

        <h4 id="vatAmount">
            @(Model.VatAmount?.ToString("N0") ?? "0")
        </h4>

    </div>

    <div class="summary-item final">

        <span>@L["InvDoc.Summary.Final"]</span>

        <h3 id="finalAmount">
            @(Model.FinalAmount?.ToString("N0") ?? "0")
        </h3>

    </div>

    </div>
}
