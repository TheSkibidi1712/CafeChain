@model CafeChain.ViewModels.Admin.InventoryDocuments.Create.AdminInventoryDocumentCreateVM
@using CafeChain.Models.Enums.Inventory;
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<InventoryResource> L

@{
    var effectiveType = Model.Type == InventoryDocumentType.ADJUSTMENT_IN
            ? InventoryDocumentType.IMPORT
            : Model.Type;
    var typeClass = effectiveType.ToString().ToLowerInvariant().Replace("_", "-");
    var title = effectiveType switch
    {
        InventoryDocumentType.IMPORT => L["InvDoc.Create.Import"].Value,
        InventoryDocumentType.EXPORT => L["InvDoc.Create.Export"].Value,
        InventoryDocumentType.STOCK_TAKE => L["InvDoc.Create.StockTake"].Value,
        InventoryDocumentType.WASTE => L["InvDoc.Create.Waste"].Value,
        InventoryDocumentType.ADJUSTMENT_IN => L["InvDoc.Create.Import"].Value,
        _ => L["InvDoc.Create.Default"].Value
    };

    var subtitle = effectiveType switch
    {
        InventoryDocumentType.IMPORT => L["InvDoc.Create.SubImport"].Value,
        InventoryDocumentType.EXPORT => L["InvDoc.Create.SubExport"].Value,
        InventoryDocumentType.STOCK_TAKE => L["InvDoc.Create.SubStockTake"].Value,
        InventoryDocumentType.WASTE => L["InvDoc.Create.SubWaste"].Value,
        _ => L["InvDoc.Create.SubDefault"].Value
    };

    var icon = effectiveType switch
    {
        InventoryDocumentType.IMPORT => "fa-arrow-down",
        InventoryDocumentType.EXPORT => "fa-arrow-up",
        InventoryDocumentType.STOCK_TAKE => "fa-clipboard-check",
        InventoryDocumentType.WASTE => "fa-trash-alt",
        _ => "fa-boxes"
    };

    var noticeIcon = effectiveType == InventoryDocumentType.WASTE
        ? "fa-triangle-exclamation"
        : "fa-circle-info";
    var notice = effectiveType switch
    {
        InventoryDocumentType.EXPORT => L["InvDoc.Create.NoticeExport"].Value,
        InventoryDocumentType.STOCK_TAKE => L["InvDoc.Create.NoticeStockTake"].Value,
        InventoryDocumentType.WASTE => L["InvDoc.Create.NoticeWaste"].Value,
        _ => L["InvDoc.Create.NoticeDefault"].Value
    };
}

<form id="inventoryCreateForm"
      class="inventory-create-form"
      data-document-type="@((int)effectiveType)"
      data-document-type-name="@effectiveType"
      novalidate>

    @Html.AntiForgeryToken()

    <input type="hidden"
           id="inventoryDocumentType"
           name="Type"
           value="@((int)effectiveType)" />

    <div class="modal-header inventory-create-header inventory-create-header-@typeClass">

        <div class="inventory-create-title">

            <span class="inventory-create-icon">
                <i id="inventoryCreateIcon"
                   class="fas @icon"></i>
            </span>

            <div>
                <div class="inventory-create-breadcrumb">
                    @L["InvDoc.Create.Breadcrumb"]
                </div>

                <h4 id="inventoryCreateTitle">@title</h4>

                <p id="inventoryCreateSubtitle">@subtitle</p>
            </div>

        </div>

        <div class="inventory-create-header-meta">

            <span class="inventory-create-code">
                @(string.IsNullOrWhiteSpace(Model.Code) ? L["InvDoc.Create.AutoCode"].Value : Model.Code)
            </span>

            <span class="inventory-create-status">
                @L["InvDoc.Create.Draft"]
            </span>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="@L["InvDoc.Create.Close"]">
            </button>

        </div>

    </div>

    <div class="modal-body inventory-create-body">

        <div class="inventory-create-workspace">

            <div class="inventory-create-notice inventory-create-notice-@typeClass" role="note">
                <i class="fas @noticeIcon" aria-hidden="true"></i>
                <span>@notice</span>
            </div>

            <div class="inventory-create-main">

                <partial name="Partials/Create/_DocumentInfo"
                         model="Model" />

                <partial name="Partials/Create/_DetailTable"
                         model="Model" />

                <partial name="Partials/Create/_Summary"
                         model="Model" />

            </div>

        </div>

    </div>

    <div class="modal-footer inventory-create-footer">

        <partial name="Partials/Create/_ActionBar"
                 model="Model" />

    </div>

</form>
