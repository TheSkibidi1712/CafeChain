@model CafeChain.ViewModels.Admin.InventoryDocuments.Create.AdminInventoryDocumentCreateVM
@using CafeChain.Models.Enums.Inventory;

@{
    var effectiveType = Model.Type == InventoryDocumentType.ADJUSTMENT_IN
            ? InventoryDocumentType.IMPORT
            : Model.Type;
    var typeClass = effectiveType.ToString().ToLowerInvariant().Replace("_", "-");
    var title = effectiveType switch
    {
        InventoryDocumentType.IMPORT => "Tạo Phiếu Nhập Kho",
        InventoryDocumentType.EXPORT => "Tạo Phiếu Xuất Kho",
        InventoryDocumentType.STOCK_TAKE => "Tạo Phiếu Kiểm Kê",
        InventoryDocumentType.WASTE => "Tạo Phiếu Hủy Kho",
        InventoryDocumentType.ADJUSTMENT_IN => "Tạo Phiếu Nhập Kho",
        _ => "Tạo Phiếu Kho"
    };

    var subtitle = effectiveType switch
    {
        InventoryDocumentType.IMPORT => "Chọn mục đích nhập để hệ thống đổi nghiệp vụ phù hợp",
        InventoryDocumentType.EXPORT => "Xuất bán hàng hoặc điều chỉnh giảm",
        InventoryDocumentType.STOCK_TAKE => "Ghi nhận số lượng kiểm kê thực tế",
        InventoryDocumentType.WASTE => "Ghi nhận hủy hàng hết hạn, hỏng hoặc thất thoát",
        _ => "Khởi tạo chứng từ kho"
    };

    var icon = effectiveType switch
    {
        InventoryDocumentType.IMPORT => "fa-arrow-down",
        InventoryDocumentType.EXPORT => "fa-arrow-up",
        InventoryDocumentType.STOCK_TAKE => "fa-clipboard-check",
        InventoryDocumentType.WASTE => "fa-trash-alt",
        _ => "fa-boxes"
    };
}

<form id="inventoryCreateForm"
      class="inventory-create-form"
      data-document-type="@((int)effectiveType)"
      data-document-type-name="@effectiveType"
      novalidate>

    @Html.AntiForgeryToken()

    <input type="hidden"
           id="inventoryDocumentType"
           name="Type"
           value="@((int)effectiveType)" />

    <div class="modal-header inventory-create-header inventory-create-header-@typeClass">

        <div class="inventory-create-title">

            <span class="inventory-create-icon">
                <i id="inventoryCreateIcon"
                   class="fas @icon"></i>
            </span>

            <div>
                <div class="inventory-create-breadcrumb">
                    Phiếu kho / Tạo phiếu mới
                </div>

                <h4 id="inventoryCreateTitle">@title</h4>

                <p id="inventoryCreateSubtitle">@subtitle</p>
            </div>

        </div>

        <div class="inventory-create-header-meta">

            <span class="inventory-create-code">
                @(string.IsNullOrWhiteSpace(Model.Code) ? "Tự động sinh khi lưu" : Model.Code)
            </span>

            <span class="inventory-create-status">
                Nháp
            </span>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Đóng">
            </button>

        </div>

    </div>

    <div class="modal-body inventory-create-body">

        <div class="inventory-create-workspace">

            <div class="inventory-create-main">

                <partial name="Partials/Create/_DocumentInfo"
                         model="Model" />

                <partial name="Partials/Create/_DetailTable"
                         model="Model" />

                <partial name="Partials/Create/_Summary"
                         model="Model" />

                <section id="aiInputSuggestionPanel" class="ai-supplier-panel d-none" aria-live="polite">
                    <div class="ai-supplier-panel-header">
                        <div>
                            <small>AIService · Số lượng do C# tính toán</small>
                            <h5>AI Gợi Ý Nhập Kho</h5>
                        </div>
                        <span id="aiInputSuggestionSource" class="create-section-badge">Rule-based</span>
                    </div>
                    <p id="aiInputSuggestionSummary"></p>
                    <p id="aiInputSuggestionReason" class="ai-supplier-reason"></p>
                    <div id="aiInputSuggestionWarnings" class="ai-supplier-warnings"></div>
                    <div id="aiInputSuggestionDetails" class="ai-supplier-comparisons d-none"></div>
                    <div class="ai-supplier-actions">
                        <button type="button" id="btnApplyInputSuggestion" class="create-action-btn create-action-confirm">Áp dụng gợi ý</button>
                        <button type="button" id="btnToggleInputSuggestion" class="create-action-btn create-action-secondary">Xem chi tiết</button>
                        <button type="button" id="btnDismissInputSuggestion" class="create-action-btn create-action-secondary">Bỏ qua</button>
                    </div>
                </section>

                <section id="aiSupplierPanel" class="ai-supplier-panel d-none" aria-live="polite">
                    <div class="ai-supplier-panel-header">
                        <div>
                            <small>AIService · Kết quả tính bằng C#</small>
                            <h5 id="aiSupplierTitle">Phân tích nhà cung cấp</h5>
                        </div>
                        <span id="aiSupplierRisk" class="ai-risk-badge">-</span>
                    </div>
                    <p id="aiSupplierSummary"></p>
                    <p id="aiSupplierReason" class="ai-supplier-reason"></p>
                    <div id="aiSupplierMetrics" class="ai-supplier-metrics"></div>
                    <div id="aiSupplierWarnings" class="ai-supplier-warnings"></div>
                    <div id="aiSupplierComparisons" class="ai-supplier-comparisons"></div>
                    <div class="ai-supplier-actions">
                        <button type="button" id="btnApplySupplierSuggestion" class="create-action-btn create-action-confirm">Áp dụng gợi ý</button>
                        <button type="button" id="btnToggleSupplierComparisons" class="create-action-btn create-action-secondary">Xem so sánh</button>
                        <button type="button" id="btnDismissSupplierSuggestion" class="create-action-btn create-action-secondary">Bỏ qua</button>
                    </div>
                </section>

            </div>

        </div>

    </div>

    <div class="modal-footer inventory-create-footer">

        <partial name="Partials/Create/_ActionBar"
                 model="Model" />

    </div>

</form>
