@model CafeChain.ViewModels.Admin.InventoryDocuments.Create.AdminInventoryDocumentCreateVM
@using CafeChain.Models.Enums.Inventory;
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<InventoryResource> L

@{
    var documentDate = Model.DocumentDate == default ? DateTime.Today : Model.DocumentDate;
    var isImport = Model.Type == InventoryDocumentType.IMPORT;
    var isExport = Model.Type == InventoryDocumentType.EXPORT;
    var negativeInventoryAvailable =
        Model.NegativeInventoryPolicyValid
        && Model.NegativeInventoryPolicyEnabled;
    var purposeTitle = Model.Type switch
    {
        InventoryDocumentType.IMPORT => L["InvDoc.Info.PurposeImport"].Value,
        InventoryDocumentType.EXPORT => L["InvDoc.Info.PurposeExport"].Value,
        InventoryDocumentType.STOCK_TAKE => L["InvDoc.Info.PurposeStockTake"].Value,
        InventoryDocumentType.WASTE => L["InvDoc.Info.PurposeWaste"].Value,
        _ => L["InvDoc.Info.PurposeDefault"].Value
    };

    var purposeOptions = Model.Type switch
    {
        InventoryDocumentType.IMPORT => new[]
        {
            new { Value = (int)InventoryDocumentPurpose.IMPORT_PURCHASE, Label = L["InvDoc.Info.Purchase"].Value, Description = L["InvDoc.Info.PurchaseDesc"].Value }
        },
        InventoryDocumentType.EXPORT => new[]
        {
            new { Value = (int)InventoryDocumentPurpose.SALE, Label = L["InvDoc.Info.Sale"].Value, Description = L["InvDoc.Info.SaleDesc"].Value }
        },
        InventoryDocumentType.STOCK_TAKE => new[]
        {
            new { Value = (int)InventoryDocumentPurpose.STOCK_TAKE, Label = L["InvDoc.Info.StockTake"].Value, Description = L["InvDoc.Info.StockTakeDesc"].Value }
        },
        InventoryDocumentType.WASTE => new[]
        {
            new { Value = (int)InventoryDocumentPurpose.DAMAGED, Label = L["InvDoc.Info.Damaged"].Value, Description = L["InvDoc.Info.DamagedDesc"].Value },
            new { Value = (int)InventoryDocumentPurpose.EXPIRED, Label = L["InvDoc.Info.Expired"].Value, Description = L["InvDoc.Info.ExpiredDesc"].Value },
            new { Value = (int)InventoryDocumentPurpose.BROKEN, Label = L["InvDoc.Info.Broken"].Value, Description = L["InvDoc.Info.BrokenDesc"].Value },
            new { Value = (int)InventoryDocumentPurpose.CONTAMINATED, Label = L["InvDoc.Info.Contaminated"].Value, Description = L["InvDoc.Info.ContaminatedDesc"].Value },
            new { Value = (int)InventoryDocumentPurpose.LOST, Label = L["InvDoc.Info.Lost"].Value, Description = L["InvDoc.Info.LostDesc"].Value }
        },
        _ => new[]
        {
            new { Value = (int)InventoryDocumentPurpose.NONE, Label = L["InvDoc.Info.None"].Value, Description = L["InvDoc.Info.NoneDesc"].Value }
        }
    };

    var selectedPurpose = Model.Purpose == InventoryDocumentPurpose.NONE
        ? purposeOptions[0].Value
        : (int)Model.Purpose;
}

<section class="create-section create-document-info">

    <div class="create-section-header">
        <div class="create-section-header-title-wrap">
            <span class="create-summary-icon">
                <i class="fas fa-file-invoice"></i>
            </span>
            <div>
                <span class="create-section-eyebrow">
                    @L["InvDoc.Info.Step1"]
                </span>
                <h5>@L["InvDoc.Info.Title"]</h5>
            </div>
        </div>

        <span class="create-section-badge">
            @L["InvDoc.Info.AutoBadge"]
        </span>
    </div>

    <div class="create-field-grid">

        <div class="create-field">
            <label for="Code">@L["InvDoc.Col.Code"]</label>
            <input id="Code"
                   name="Code"
                   class="form-control create-control"
                   value="@Model.Code"
                   placeholder="@L["InvDoc.Create.AutoCode"]"
                   readonly />
        </div>

        <div class="create-field">
            <label for="DocumentDateDisplay">@L["InvDoc.General.Date"]</label>
            <input id="DocumentDateDisplay"
                   type="text"
                   class="form-control create-control create-control-readonly"
                   value="@documentDate.ToString("dd/MM/yyyy")"
                   readonly
                   required />
            <input id="DocumentDate"
                   name="DocumentDate"
                   type="hidden"
                   value="@documentDate.ToString("yyyy-MM-dd")" />
        </div>

        <div class="create-field">
            <label for="storeSelect">@L["InvDoc.Filter.Store"]</label>
            <select id="storeSelect"
                    name="StoreId"
                    class="form-select create-control"
                    required>
                <option value="">@L["InvDoc.Info.SelectStore"]</option>
                @foreach (var item in Model.Stores)
                {
                    <option value="@item.StoreId"
                            selected="@(Model.StoreId == item.StoreId)">
                        @item.StoreName
                    </option>
                }
            </select>
        </div>

        @if (isImport)
        {
            <div class="create-field"
                 id="supplierField">
                <label for="supplierSelect">@L["InvDoc.General.Supplier"]</label>
                <select id="supplierSelect"
                        name="SupplierId"
                        class="form-select create-control">
                    <option value="">@L["InvDoc.Info.SelectSupplier"]</option>
                    @foreach (var item in Model.Suppliers)
                    {
                        <option value="@item.SupplierId"
                                selected="@(Model.SupplierId == item.SupplierId)">
                            @item.SupplierName
                        </option>
                    }
                </select>
                <small>
                    @L["InvDoc.Info.SupplierHelp"]
                </small>
            </div>

        }

    </div>

    <div class="create-purpose-block">

        <div class="create-section-subtitle">
            <i class="fas fa-bullseye"></i>
            @purposeTitle
        </div>

        <div class="create-purpose-list">
            @foreach (var option in purposeOptions)
            {
                <label class="create-purpose-card"
                       for="purpose_@option.Value">

                    <input id="purpose_@option.Value"
                           class="create-purpose-input"
                           type="radio"
                           name="Purpose"
                           value="@option.Value"
                           checked="@(selectedPurpose == option.Value)" />

                    <span class="create-purpose-dot"></span>

                    <span>
                        <strong>@option.Label</strong>
                        <small>@option.Description</small>
                    </span>

                </label>
            }
        </div>

    </div>

    <div class="create-field-grid create-field-grid-secondary">

        <input type="hidden"
               id="PartnerType"
               name="PartnerType"
               value="@((int)InventoryPartnerType.NONE)" />

        <div class="create-field"
             id="partnerField">
            <label id="partnerNameLabel"
                   for="PartnerName">@L["InvDoc.General.Partner"]</label>
            <input id="PartnerName"
                   name="PartnerName"
                   class="form-control create-control partner-name-input"
                   value="@Model.SupplierName"
                   placeholder="@L["InvDoc.Info.PartnerPlaceholder"]" />
            <small id="partnerHint">
                @L["InvDoc.Info.PartnerHint"]
            </small>
        </div>

        <div class="create-field create-field-wide">
            <label for="Note">@L["InvDoc.Info.Note"]</label>
            <textarea id="Note"
                      name="Note"
                      rows="3"
                      class="form-control create-control"
                      placeholder="@L["InvDoc.Info.NotePlaceholder"]">@Model.Note</textarea>
            <small id="notePurposeHint"
                   class="d-none">
                @L["InvDoc.Info.NoteHint"]
            </small>
        </div>

        @if (isExport)
        {
            <div class="create-field create-field-wide negative-stock-mode-field"
                 id="negativeStockModeField"
                 data-policy-valid="@Model.NegativeInventoryPolicyValid.ToString().ToLowerInvariant()"
                 data-policy-enabled="@Model.NegativeInventoryPolicyEnabled.ToString().ToLowerInvariant()">
                <div class="create-section-subtitle negative-stock-mode-title">
                    <i class="fas fa-scale-balanced"></i>
                    @L["InvDoc.Info.NegTitle"]
                </div>

                <div class="negative-stock-mode-list" role="radiogroup" aria-label="@L["InvDoc.Info.NegTitle"]">
                    <label class="negative-stock-mode-card" for="negativeStockModeNormal">
                        <input id="negativeStockModeNormal"
                               class="negative-stock-mode-input"
                               type="radio"
                               name="NegativeStockMode"
                               value="normal"
                               checked />
                        <span class="negative-stock-mode-dot"></span>
                        <span>
                            <strong>@L["InvDoc.Info.NegNormal"]</strong>
                            <small>@L["InvDoc.Info.NegNormalDesc"]</small>
                        </span>
                    </label>

                    <label class="negative-stock-mode-card @(negativeInventoryAvailable ? null : "is-disabled")"
                           for="negativeStockModeRequest">
                        <input id="negativeStockModeRequest"
                               class="negative-stock-mode-input"
                               type="radio"
                               name="NegativeStockMode"
                               value="request-negative"
                               disabled="@(!negativeInventoryAvailable)" />
                        <span class="negative-stock-mode-dot"></span>
                        <span>
                            <strong>@L["InvDoc.Info.NegRequest"]</strong>
                            <small>@L["InvDoc.Info.NegRequestDesc"]</small>
                        </span>
                    </label>
                </div>

                @if (!Model.NegativeInventoryPolicyValid)
                {
                    <div class="negative-stock-policy-note is-error" role="status">
                        <i class="fas fa-triangle-exclamation"></i>
                        @L["InvDoc.Info.PolicyInvalid"]
                    </div>
                }
                else if (!Model.NegativeInventoryPolicyEnabled)
                {
                    <div class="negative-stock-policy-note" role="status">
                        <i class="fas fa-lock"></i>
                        @L["InvDoc.Info.PolicyOff"]
                    </div>
                }
                else
                {
                    <div class="negative-stock-policy-note is-enabled" role="status">
                        <i class="fas fa-shield-halved"></i>
                        @L["InvDoc.Info.PolicyOn"]@(Model.NegativeInventoryApprovalRequired ? L["InvDoc.Info.PolicyOnApproval"].Value : null).
                    </div>
                }

                <div class="negative-stock-projection is-pending"
                     id="negativeStockProjection"
                     aria-live="polite">
                    <div class="negative-stock-projection-head">
                        <span>@L["InvDoc.Info.ProjectionHead"]</span>
                        <strong class="negative-stock-projection-badge" id="negativeStockProjectionBadge">
                            @L["InvDoc.Info.ProjectionUnknown"]
                        </strong>
                    </div>
                    <p id="negativeStockProjectionMessage">
                        @L["InvDoc.Info.ProjectionMsg"]
                    </p>
                    <ul class="negative-stock-projection-lines d-none" id="negativeStockProjectionLines"></ul>
                </div>
            </div>
            <div class="create-field create-field-wide d-none" id="negativeReasonField">
                <label for="NegativeReason">@L["InvDoc.Info.NegReason"]</label>
                <textarea id="NegativeReason"
                          name="NegativeReason"
                          rows="2"
                          class="form-control create-control"
                          placeholder="@L["InvDoc.Info.NegReasonPlaceholder"]"></textarea>
                <small>@L["InvDoc.Info.NegReasonHelp"]</small>
            </div>
            <div class="create-field create-field-wide d-none" id="negativePreflightPanel" aria-live="polite"></div>
        }

    </div>

</section>
