@model CafeChain.ViewModels.Admin.InventoryDocuments.Create.AdminInventoryDocumentCreateVM
@using CafeChain.Models.Enums.Inventory;

@{
    var documentDate = Model.DocumentDate == default ? DateTime.Today : Model.DocumentDate;
    var isImport = Model.Type == InventoryDocumentType.IMPORT
        || Model.Type == InventoryDocumentType.ADJUSTMENT_IN;
    var isExport = Model.Type == InventoryDocumentType.EXPORT;
    var purposeTitle = Model.Type switch
    {
        InventoryDocumentType.IMPORT or InventoryDocumentType.ADJUSTMENT_IN => "Mục đích nhập kho",
        InventoryDocumentType.EXPORT => "Mục đích xuất kho",
        InventoryDocumentType.STOCK_TAKE => "Mục đích kiểm kê",
        InventoryDocumentType.WASTE => "Lý do hủy kho",
        _ => "Mục đích nghiệp vụ"
    };

    var purposeOptions = Model.Type switch
    {
        InventoryDocumentType.IMPORT or InventoryDocumentType.ADJUSTMENT_IN => new[]
        {
            new { Value = (int)InventoryDocumentPurpose.IMPORT_PURCHASE, Label = "Nhập từ nhà cung cấp", Description = "Tăng tồn kho từ đơn mua hàng" },
            new { Value = (int)InventoryDocumentPurpose.IMPORT_ADJUSTMENT, Label = "Điều chỉnh tăng", Description = "Bổ sung tồn do kiểm tra, kiểm kê lệch hoặc đối soát dữ liệu" }
        },
        InventoryDocumentType.EXPORT => new[]
        {
            new { Value = (int)InventoryDocumentPurpose.SALE, Label = "Xuất bán hàng", Description = "Giảm tồn kho phục vụ bán hàng" },
            new { Value = (int)InventoryDocumentPurpose.GIFT, Label = "Xuất quà tặng", Description = "Hàng quà tặng đã giao thực tế" },
            new { Value = (int)InventoryDocumentPurpose.DEBT, Label = "Xuất ghi nợ", Description = "Hàng đã giao và ghi nhận công nợ" },
            new { Value = (int)InventoryDocumentPurpose.SAMPLE, Label = "Xuất hàng mẫu", Description = "Hàng mẫu đã giao thực tế" },
            new { Value = (int)InventoryDocumentPurpose.ADJUSTMENT_OUT, Label = "Điều chỉnh giảm", Description = "Giảm tồn do đối soát" }
        },
        InventoryDocumentType.STOCK_TAKE => new[]
        {
            new { Value = (int)InventoryDocumentPurpose.STOCK_TAKE, Label = "Kiểm kê", Description = "Ghi nhận số lượng thực tế" }
        },
        InventoryDocumentType.WASTE => new[]
        {
            new { Value = (int)InventoryDocumentPurpose.DAMAGED, Label = "Hàng hỏng", Description = "Hủy do hư hỏng" },
            new { Value = (int)InventoryDocumentPurpose.EXPIRED, Label = "Hết hạn", Description = "Hủy do quá hạn sử dụng" },
            new { Value = (int)InventoryDocumentPurpose.BROKEN, Label = "Bị vỡ", Description = "Hủy do bị vỡ trong bảo quản hoặc vận hành" },
            new { Value = (int)InventoryDocumentPurpose.CONTAMINATED, Label = "Nhiễm bẩn", Description = "Hủy do không còn đảm bảo vệ sinh" },
            new { Value = (int)InventoryDocumentPurpose.LOST, Label = "Thất thoát", Description = "Ghi nhận mất mát" }
        },
        _ => new[]
        {
            new { Value = (int)InventoryDocumentPurpose.NONE, Label = "Không xác định", Description = "Chọn mục đích phù hợp" }
        }
    };

    var selectedPurpose = Model.Type switch
    {
        InventoryDocumentType.ADJUSTMENT_IN => (int)InventoryDocumentPurpose.IMPORT_ADJUSTMENT,
        _ => Model.Purpose == InventoryDocumentPurpose.NONE
            ? purposeOptions[0].Value
            : (int)Model.Purpose
    };
}

<section class="create-section create-document-info">

    <div class="create-section-header">
        <div>
            <span class="create-section-eyebrow">
                Thông tin chung
            </span>
            <h5>Thông tin phiếu</h5>
        </div>

        <span class="create-section-badge">
            Mã phiếu tự động
        </span>
    </div>

    <div class="create-field-grid">

        <div class="create-field">
            <label for="Code">Mã phiếu</label>
            <input id="Code"
                   name="Code"
                   class="form-control create-control"
                   value="@Model.Code"
                   placeholder="Tự động sinh khi lưu"
                   readonly />
        </div>

        <div class="create-field">
            <label for="DocumentDateDisplay">Ngày chứng từ</label>
            <input id="DocumentDateDisplay"
                   type="text"
                   class="form-control create-control create-control-readonly"
                   value="@documentDate.ToString("dd/MM/yyyy")"
                   readonly
                   required />
            <input id="DocumentDate"
                   name="DocumentDate"
                   type="hidden"
                   value="@documentDate.ToString("yyyy-MM-dd")" />
        </div>

        <div class="create-field">
            <label for="storeSelect">Cửa hàng</label>
            <select id="storeSelect"
                    name="StoreId"
                    class="form-select create-control"
                    required>
                <option value="">Chọn cửa hàng</option>
                @foreach (var item in Model.Stores)
                {
                    <option value="@item.StoreId"
                            selected="@(Model.StoreId == item.StoreId)">
                        @item.StoreName
                    </option>
                }
            </select>
        </div>

        @if (isImport)
        {
            <div class="create-field"
                 id="supplierField">
                <label for="supplierSelect">Nhà cung cấp</label>
                <select id="supplierSelect"
                        name="SupplierId"
                        class="form-select create-control">
                    <option value="">Chọn nhà cung cấp</option>
                    @foreach (var item in Model.Suppliers)
                    {
                        <option value="@item.SupplierId"
                                selected="@(Model.SupplierId == item.SupplierId)">
                            @item.SupplierName
                        </option>
                    }
                </select>
                <small>
                    Chỉ dùng khi mục đích là nhập từ nhà cung cấp.
                </small>
            </div>

        }

    </div>

    <div class="create-purpose-block">

        <div class="create-section-subtitle">
            <i class="fas fa-bullseye"></i>
            @purposeTitle
        </div>

        <div class="create-purpose-list">
            @foreach (var option in purposeOptions)
            {
                <label class="create-purpose-card"
                       for="purpose_@option.Value">

                    <input id="purpose_@option.Value"
                           class="create-purpose-input"
                           type="radio"
                           name="Purpose"
                           value="@option.Value"
                           checked="@(selectedPurpose == option.Value)" />

                    <span class="create-purpose-dot"></span>

                    <span>
                        <strong>@option.Label</strong>
                        <small>@option.Description</small>
                    </span>

                </label>
            }
        </div>

    </div>

    <div class="create-field-grid create-field-grid-secondary">

        <input type="hidden"
               id="PartnerType"
               name="PartnerType"
               value="@((int)InventoryPartnerType.NONE)" />

        <div class="create-field"
             id="partnerField">
            <label id="partnerNameLabel"
                   for="PartnerName">Đối tác</label>
            <input id="PartnerName"
                   name="PartnerName"
                   class="form-control create-control partner-name-input"
                   value="@Model.SupplierName"
                   placeholder="Nhập tên đối tác nếu cần" />
            <small id="partnerHint">
                Hệ thống tự xác định loại đối tác theo mục đích nghiệp vụ.
            </small>
        </div>

        <div class="create-field create-field-wide">
            <label for="Note">Ghi chú</label>
            <textarea id="Note"
                      name="Note"
                      rows="3"
                      class="form-control create-control"
                      placeholder="Nhập ghi chú cho phiếu kho">@Model.Note</textarea>
            <small id="notePurposeHint"
                   class="d-none">
                Phiếu điều chỉnh bắt buộc ghi rõ lý do điều chỉnh.
            </small>
        </div>

        @if (isExport)
        {
            <div class="create-field create-field-wide" id="negativeReasonField">
                <label for="NegativeReason">Lý do xuất âm (bắt buộc khi projected after âm)</label>
                <textarea id="NegativeReason"
                          name="NegativeReason"
                          rows="2"
                          class="form-control create-control"
                          placeholder="Mô tả giao dịch thực tế đã phát sinh và lý do không thể trì hoãn ghi nhận"></textarea>
            </div>
            <div class="create-field create-field-wide d-none" id="negativePreflightPanel" aria-live="polite"></div>
        }

    </div>

</section>
