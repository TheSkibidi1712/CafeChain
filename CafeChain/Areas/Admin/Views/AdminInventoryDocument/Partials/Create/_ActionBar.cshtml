@using Microsoft.Extensions.Localization
@inject IStringLocalizer<InventoryResource> L

<div class="inventory-create-actions">

    <button type="button"
            class="create-action-btn create-action-secondary"
            data-bs-dismiss="modal">
        <i class="fas fa-times"></i>
        @L["InvDoc.Create.Cancel"]
    </button>

    <div class="inventory-create-action-group">

        <button type="button"
                class="create-action-btn create-action-draft"
                id="btnSaveDraft">
            <i class="fas fa-save"></i>
            @L["InvDoc.Create.SaveDraft"]
        </button>

        <button type="button"
                class="create-action-btn create-action-confirm"
                id="btnCreateDocument">
            <i class="fas fa-check" id="createDocumentActionIcon"></i>
            <span id="createDocumentActionLabel">@L["InvDoc.Create.Confirm"]</span>
        </button>

    </div>

</div>
