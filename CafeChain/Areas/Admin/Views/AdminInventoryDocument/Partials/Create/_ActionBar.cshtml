<div class="inventory-create-actions">

    <button type="button"
            class="create-action-btn create-action-secondary"
            data-bs-dismiss="modal">
        <i class="fas fa-times"></i>
        Hủy
    </button>

    <div class="inventory-create-action-group">

        <button type="button"
                class="create-action-btn create-action-secondary d-none"
                id="btnAiSuggestInput">
            <i class="fas fa-wand-magic-sparkles"></i>
            AI Gợi Ý
        </button>

        <button type="button"
                class="create-action-btn create-action-secondary d-none"
                id="btnAnalyzeSupplier">
            <i class="fas fa-wand-magic-sparkles"></i>
            Phân tích nhà cung cấp
        </button>

        <button type="button"
                class="create-action-btn create-action-draft"
                id="btnSaveDraft">
            <i class="fas fa-save"></i>
            Lưu nháp
        </button>

        <button type="button"
                class="create-action-btn create-action-confirm"
                id="btnCreateDocument">
            <i class="fas fa-check"></i>
            Tạo & xác nhận
        </button>

    </div>

</div>
