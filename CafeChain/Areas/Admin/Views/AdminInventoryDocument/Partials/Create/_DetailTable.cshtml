@model CafeChain.ViewModels.Admin.InventoryDocuments.Create.AdminInventoryDocumentCreateVM
@using CafeChain.Models.Enums.Inventory;

@{
    var hint = Model.Type == InventoryDocumentType.IMPORT
        ? "Chọn mục đích nhập để hệ thống tải đúng nguồn nguyên liệu."
        : Model.Type == InventoryDocumentType.STOCK_TAKE
            ? "Chọn nguyên liệu cần kiểm kê và nhập số lượng thực tế sau khi đếm."
            : Model.Type == InventoryDocumentType.WASTE
                ? "Chọn nguyên liệu còn tồn, nhập số lượng hủy và ghi rõ lý do hủy."
                : "Thêm nguyên liệu và nhập số lượng cần xử lý.";

    var quantityHeader = Model.Type switch
    {
        InventoryDocumentType.STOCK_TAKE => "Số lượng thực tế",
        InventoryDocumentType.WASTE => "Số lượng hủy",
        _ => "Số lượng"
    };

    var referenceHeader = Model.Type switch
    {
        InventoryDocumentType.STOCK_TAKE => "Tồn hệ thống",
        InventoryDocumentType.WASTE => "Tồn khả dụng",
        InventoryDocumentType.EXPORT => "Tồn khả dụng",
        InventoryDocumentType.IMPORT => "MOQ/Còn nhận",
        _ => "Tham chiếu"
    };

    var hideMoneyColumns =
        Model.Type == InventoryDocumentType.STOCK_TAKE
        || Model.Type == InventoryDocumentType.WASTE;

    var showVarianceColumn =
        Model.Type == InventoryDocumentType.STOCK_TAKE;

    ViewData["HideMoneyColumns"] = hideMoneyColumns;
}
<style>
    /* Expand Action Column to fit text on a single line and allow perfect centering of the button */
    body.admin-premium-shell .inventory-create-table :is(th, td).create-col-action {
        width: 100px !important;
        text-align: center !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
    }

    body.admin-premium-shell .inventory-create-table th {
        text-align: center !important;
        vertical-align: middle !important;
    }
    
    body.admin-premium-shell .inventory-create-table td {
        text-align: center !important;
        vertical-align: middle !important;
    }
    
    body.admin-premium-shell .inventory-create-table td.create-col-index {
        text-align: center !important;
    }
    
    body.admin-premium-shell .inventory-create-table td :is(input, select) {
        text-align: center !important;
        text-align-last: center !important;
        margin: 0 auto !important;
    }
    
    body.admin-premium-shell .inventory-create-table .ingredient-row-meta {
        justify-content: center !important;
        text-align: center !important;
    }

    body.admin-premium-shell .inventory-create-table td.create-col-action .create-remove-row-btn {
        margin: 0 auto !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
    }
</style>

<section class="create-section create-detail-section">

    <div class="create-section-header">
        <div class="create-section-header-title-wrap">
            <span class="create-summary-icon">
                <i class="fas fa-clipboard-list"></i>
            </span>
            <div>
                <span class="create-section-eyebrow">
                    Bước 2 · Chi tiết nguyên liệu
                </span>
                <h5>Danh sách nguyên liệu</h5>
            </div>
        </div>

        <button type="button"
                class="create-add-row-btn"
                id="btnAddIngredient"
                title="Thêm nguyên liệu"
                aria-label="Thêm nguyên liệu vào phiếu">
            <i class="fas fa-plus"></i>
            Thêm nguyên liệu
        </button>
    </div>

    <p class="create-section-hint"
       id="createDetailHint">
        @hint
    </p>

    <div class="create-table-wrap">

        <table class="table align-middle inventory-create-table">

            <thead>
                <tr>
                    <th class="create-col-index">#</th>
                    <th>Nguyên liệu</th>
                    <th class="create-col-unit">ĐVT</th>
                    <th class="create-col-qty">@quantityHeader</th>
                    <th class="create-col-price @(hideMoneyColumns ? "d-none" : "")"
                        id="unitPriceHeader">Đơn giá nhập</th>
                    <th class="create-col-moq" id="quantityReferenceHeader">@referenceHeader</th>
                    <th class="create-col-variance @(showVarianceColumn ? "" : "d-none")">Chênh lệch</th>
                    <th class="create-col-total @(hideMoneyColumns ? "d-none" : "")">Thành tiền</th>
                    <th class="create-col-action text-center">Thao tác</th>
                </tr>
            </thead>

            <tbody id="ingredientTableBody">
                <partial name="Partials/Create/_IngredientRow" view-data="ViewData" />
            </tbody>

        </table>

    </div>

    <template id="ingredientRowTemplate">
        <partial name="Partials/Create/_IngredientRow" view-data="ViewData" />
    </template>

</section>
