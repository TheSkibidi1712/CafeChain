@{
    var hideMoneyColumns = ViewData["HideMoneyColumns"] as bool? == true;
    var showVarianceColumn = ViewData["ShowVarianceColumn"] as bool? == true;
}

<tr class="ingredient-row">

    <td class="create-col-index text-center">
        <span class="row-number">1</span>
    </td>

    <td>
        <select class="form-select create-control ingredient-select">
            <option value="">Chọn nguyên liệu</option>
        </select>

        <div class="ingredient-row-meta">
            <span class="base-unit-name">Đơn vị gốc</span>
            <span class="ingredient-source">Chưa chọn</span>
            <span class="available-stock-display">Tồn: -</span>
            <span class="price-source-display @(hideMoneyColumns ? "d-none" : "")">Nguồn giá: -</span>
            <span class="unit-conversion-display">Quy đổi: -</span>
        </div>

        <input type="hidden"
               class="ingredient-id"
               value="" />

        <input type="hidden"
               class="unit-id"
               value="" />

        <input type="hidden"
               class="base-quantity"
               value="0" />
    </td>

    <td class="create-col-unit">
        <select class="form-select create-control unit-select">
            <option value="">ĐVT</option>
        </select>
    </td>

    <td class="create-col-qty">
        <input type="number"
               class="form-control create-control quantity"
               min="0"
               step="any"
               inputmode="decimal"
               placeholder="Nhập số lượng"
               disabled />
    </td>

    <td class="create-col-price @(hideMoneyColumns ? "d-none" : "")">
        <input type="number"
               class="form-control create-control unit-price"
               min="0"
               step="0.01"
               placeholder="0"
               readonly />
    </td>

    <td class="create-col-moq">
        <span class="minimum-order-quantity">-</span>
    </td>

    <td class="create-col-variance @(showVarianceColumn ? "" : "d-none")">
        <span class="stocktake-variance-display">-</span>
        <small class="stocktake-status-display"></small>
    </td>

    <td class="create-col-total @(hideMoneyColumns ? "d-none" : "")">
        <span class="line-total-display">0</span>
        <small>VNĐ</small>

        <input type="hidden"
               class="total line-total"
               value="0" />
    </td>

    <td class="create-col-action">
        <button type="button"
                class="create-remove-row-btn btn-remove-row"
                title="Xóa dòng nguyên liệu"
                aria-label="Xóa dòng nguyên liệu">
            <i class="fas fa-trash-alt"></i>
        </button>
    </td>

</tr>
