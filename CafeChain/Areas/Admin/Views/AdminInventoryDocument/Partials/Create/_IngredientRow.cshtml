@using Microsoft.Extensions.Localization
@inject IStringLocalizer<InventoryResource> L

@{
    var hideMoneyColumns = ViewData["HideMoneyColumns"] as bool? == true;
    var showVarianceColumn = ViewData["ShowVarianceColumn"] as bool? == true;
}

<tr class="ingredient-row">

    <td class="create-col-index text-center">
        <span class="row-number">1</span>
    </td>

    <td>
        <select class="form-select create-control ingredient-select">
            <option value="">@L["InvDoc.Create.SelectIngredient"]</option>
        </select>

        <div class="ingredient-row-meta">
            <span class="base-unit-name">@L["InvDoc.Create.BaseUnit"]</span>
            <span class="ingredient-source">@L["InvDoc.Create.NotSelected"]</span>
            <span class="available-stock-display">@L["InvDoc.Create.StockLabel"]</span>
            <span class="price-source-display @(hideMoneyColumns ? "d-none" : "")">@L["InvDoc.Create.PriceSource"]</span>
            <span class="unit-conversion-display">@L["InvDoc.Create.Conversion"]</span>
        </div>

        <input type="hidden"
               class="ingredient-id"
               value="" />

        <input type="hidden"
               class="unit-id"
               value="" />

        <input type="hidden"
               class="base-quantity"
               value="0" />
    </td>

    <td class="create-col-unit">
        <select class="form-select create-control unit-select">
            <option value="">@L["InvDoc.General.Unit"]</option>
        </select>
    </td>

    <td class="create-col-qty">
        <input type="number"
               class="form-control create-control quantity"
               min="0"
               step="any"
               inputmode="decimal"
               placeholder="@L["InvDoc.Create.QtyPlaceholder"]"
               disabled />
    </td>

    <td class="create-col-price @(hideMoneyColumns ? "d-none" : "")">
        <input type="number"
               class="form-control create-control unit-price"
               min="0"
               step="0.01"
               placeholder="0"
               readonly />
    </td>

    <td class="create-col-moq">
        <span class="minimum-order-quantity">-</span>
    </td>

    <td class="create-col-variance @(showVarianceColumn ? "" : "d-none")">
        <span class="stocktake-variance-display">-</span>
        <small class="stocktake-status-display"></small>
    </td>

    <td class="create-col-total @(hideMoneyColumns ? "d-none" : "")">
        <span class="line-total-display">0</span>
        <small>@L["Common.Currency"]</small>

        <input type="hidden"
               class="total line-total"
               value="0" />
    </td>

    <td class="create-col-action">
        <button type="button"
                class="create-remove-row-btn btn-remove-row"
                title="@L["InvDoc.Create.RemoveRow"]"
                aria-label="@L["InvDoc.Create.RemoveRow"]">
            <i class="fas fa-trash-alt"></i>
        </button>
    </td>

</tr>
