@model CafeChain.ViewModels.Admin.InventoryDocuments.AdminInventoryDocumentIndexVM

<div class="inventory-cards">

    <div class="dashboard-card total">
        <div class="card-icon">
            <i class="fas fa-file-invoice"></i>
        </div>

        <div class="card-content">
            <div class="value">@Model.TotalDocuments</div>
            <div class="label">Tổng Phiếu</div>
        </div>
    </div>

    <div class="dashboard-card draft">
        <div class="card-icon">
            <i class="fas fa-edit"></i>
        </div>

        <div class="card-content">
            <div class="value">@Model.DraftDocuments</div>
            <div class="label">Bản Nháp</div>
        </div>
    </div>

    <div class="dashboard-card confirmed">
        <div class="card-icon">
            <i class="fas fa-check-circle"></i>
        </div>

        <div class="card-content">
            <div class="value">@Model.ConfirmedDocuments</div>
            <div class="label">Đã Duyệt</div>
        </div>
    </div>

    <div class="dashboard-card cancelled">
        <div class="card-icon">
            <i class="fas fa-times-circle"></i>
        </div>

        <div class="card-content">
            <div class="value">@Model.CancelledDocuments</div>
            <div class="label">Đã Hủy</div>
        </div>
    </div>

    <div class="dashboard-card month">
        <div class="card-icon">
            <i class="fas fa-calendar"></i>
        </div>

        <div class="card-content">
            <div class="value">@Model.ThisMonthDocuments</div>
            <div class="label">Tháng Này</div>
        </div>
    </div>

</div>