@model CafeChain.ViewModels.Admin.PreparedItems.AdminPreparedItemIndexPageVM
@using CafeChain.ViewModels.Admin.Shared
@{
    ViewData["Title"] = "Danh mục bán thành phẩm";
    // Prefer typed page VM (post-#129); fall back to ViewBag if model bag missing CanWrite.
    var canWrite = Model?.CanWrite == true
        || (ViewBag.CanWrite is bool vb && vb);
    int page = Model?.Page ?? (ViewBag.Page as int? ?? 1);
    int totalPages = Model?.TotalPages ?? (ViewBag.TotalPages as int? ?? 1);
    var items = Model?.Items ?? new List<CafeChain.Application.DTOs.Admin.PreparedItems.AdminPreparedItemDTO>();
    int colCount = canWrite ? 8 : 7;
}

@Html.AntiForgeryToken()
<link rel="stylesheet" href="~/css/recipe-builder.css" asp-append-version="true" />

<div class="rb-page">
<div class="container-fluid px-4 pt-4 pb-5">
    <div class="rb-page-header bom-depth-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div class="admin-module-heading-copy">
            <nav class="rb-breadcrumb" aria-label="breadcrumb">
                <span>Sản xuất / BOM</span> &gt; <span>Danh mục bán thành phẩm</span>
            </nav>
            <div class="admin-module-title-row">
                <span class="admin-module-title-icon" aria-hidden="true"><i class="fas fa-boxes-stacked"></i></span>
                <div>
                    <h1 class="rb-page-title mb-1">Danh mục bán thành phẩm</h1>
                    <p class="text-muted mb-0" style="max-width: 42rem;">
                        Quản lý danh tính BTP ổn định dùng cho công thức và tồn kho.
                        Đây <strong>không phải</strong> số lượng tồn kho tại cửa hàng.
                    </p>
                </div>
            </div>
        </div>
        @if (canWrite)
        {
            <button type="button" class="btn btn-rb-save admin-module-header-action" id="btnCreate">
                <i class="fas fa-plus me-2" aria-hidden="true"></i>Tạo bán thành phẩm
            </button>
        }
    </div>

    <form method="get" class="rb-list-filters rb-module-filter rb-module-filter--four mb-3" id="filterForm" role="search">
        <label class="visually-hidden" for="searchBox">Tìm theo mã hoặc tên</label>
        <input name="search" id="searchBox" class="form-control" value="@Model.Search"
               placeholder="Tìm theo mã hoặc tên bán thành phẩm..." autocomplete="off" />
        <label class="visually-hidden" for="statusFilter">Trạng thái</label>
        <select name="status" id="statusFilter" class="form-select">
            <option value="">Tất cả trạng thái</option>
            <option value="true" selected="@(Model.Status == true)">Hoạt động</option>
            <option value="false" selected="@(Model.Status == false)">Ngừng hoạt động</option>
        </select>
        <button type="submit" class="btn btn-rb-save"><i class="fas fa-filter" aria-hidden="true"></i>Lọc</button>
        <a asp-action="Index" class="btn btn-rb-ghost"><i class="fas fa-rotate-left" aria-hidden="true"></i>Đặt lại</a>
    </form>

    <div class="rb-card">
        <div class="table-responsive">
            <table class="table rb-table rb-prepareditem-table mb-0" aria-label="Danh sách bán thành phẩm">
                <thead>
                    <tr>
                        <th scope="col">Mã BTP</th>
                        <th scope="col">Tên BTP</th>
                        <th scope="col">Đơn vị tồn kho</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col">Công thức đang hoạt động</th>
                        <th scope="col" class="text-center">Số phiên bản</th>
                        <th scope="col">Trạng thái cấu hình</th>
                        @if (canWrite)
                        {
                            <th scope="col">Thao tác</th>
                        }
                    </tr>
                </thead>
                <tbody>
                @if (items == null || !items.Any())
                {
                    <tr>
                        <td colspan="@colCount" class="text-center py-5">
                            @* Inline empty CTA (restored after #129 ValueTuple _EmptyState path) so write roles always get btnCreateEmpty when CanWrite. *@
                            <div class="rb-empty-state" id="preparedItemEmptyState">
                                <p class="fw-semibold mb-1">Chưa có bán thành phẩm.</p>
                                @if (canWrite)
                                {
                                    <p class="text-muted small mb-3">Hãy tạo BTP trước khi tạo công thức sơ chế.</p>
                                    <button type="button" class="btn btn-rb-save" id="btnCreateEmpty">
                                        Tạo bán thành phẩm đầu tiên
                                    </button>
                                }
                                else
                                {
                                    <p class="text-muted small mb-0">
                                        Chưa có BTP trong hệ thống. Tài khoản hiện tại chỉ có quyền xem.
                                    </p>
                                }
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in items)
                    {
                        var statusDesc = AdminStatusDisplay.RecipeActive(item.Active);
                        var configDesc = AdminStatusDisplay.PreparedItemConfig(item.ConfigStatusKey, item.ConfigStatus);
                        <tr data-id="@item.PreparedItemId">
                            <td><code class="rb-code">@item.Code</code></td>
                            <td class="fw-semibold">@item.Name</td>
                            <td>
                                <span class="rb-qty-unit">@item.BaseUnitCode</span>
                                <small class="text-muted">(@item.BaseUnitName)</small>
                            </td>
                            <td>
                                <partial name="_StatusBadge" model="statusDesc" />
                            </td>
                            <td>
                                @if (item.ActiveRecipeId.HasValue)
                                {
                                    <a class="link-primary text-decoration-none"
                                       asp-area="Admin" asp-controller="AdminRecipe" asp-action="Edit"
                                       asp-route-id="@item.ActiveRecipeId"
                                       title="Xem công thức đang hoạt động">
                                        #@item.ActiveRecipeId
                                        @if (!string.IsNullOrWhiteSpace(item.ActiveRecipeCode))
                                        {
                                            <span class="text-muted small">(@item.ActiveRecipeCode)</span>
                                        }
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">Chưa có</span>
                                }
                            </td>
                            <td class="text-center font-monospace">@item.VersionCount</td>
                            <td>
                                <partial name="_StatusBadge" model="configDesc" />
                            </td>
                            @if (canWrite)
                            {
                                <td class="rb-prepareditem-actions-cell">
                                    <div class="d-flex flex-nowrap gap-1">
                                        @if (item.ActiveRecipeId.HasValue)
                                        {
                                            <a class="btn btn-sm btn-outline-secondary rb-table-action"
                                               asp-area="Admin" asp-controller="AdminRecipe" asp-action="Edit"
                                               asp-route-id="@item.ActiveRecipeId"
                                               title="Xem công thức"
                                               aria-label="Xem công thức của @item.Name">
                                                <i class="fas fa-diagram-project" aria-hidden="true"></i><span>Xem công thức</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <a class="btn btn-sm btn-outline-secondary rb-table-action"
                                               asp-area="Admin" asp-controller="AdminRecipe" asp-action="Create"
                                               title="Tạo công thức"
                                               aria-label="Tạo công thức cho @item.Name">
                                                <i class="fas fa-plus me-1" aria-hidden="true"></i><span>Tạo công thức</span>
                                            </a>
                                        }
                                        <button type="button" class="btn btn-sm btn-outline-primary edit-btn rb-table-action"
                                                data-id="@item.PreparedItemId"
                                                title="Sửa bán thành phẩm"
                                                aria-label="Sửa bán thành phẩm @item.Name"><i class="fas fa-pen" aria-hidden="true"></i><span>Sửa</span></button>
                                        <button type="button" class="btn btn-sm btn-outline-warning toggle-btn rb-table-action"
                                                data-id="@item.PreparedItemId"
                                                data-active="@(!item.Active)"
                                                title="@(item.Active ? "Ngừng hoạt động" : "Kích hoạt")"
                                                aria-label="@(item.Active ? $"Ngừng hoạt động {item.Name}" : $"Kích hoạt {item.Name}")">
                                            <i class="fas @(item.Active ? "fa-pause" : "fa-play")" aria-hidden="true"></i><span>@(item.Active ? "Ngừng hoạt động" : "Kích hoạt")</span>
                                        </button>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-3" aria-label="Phân trang danh mục BTP">
            <ul class="pagination">
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == page ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-search="@(Model?.Search ?? ViewBag.Search as string)"
                           asp-route-status="@(Model?.Status ?? ViewBag.Status as bool?)">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
</div>

@if (canWrite)
{
    <div class="modal fade" id="preparedItemModal" tabindex="-1" aria-labelledby="preparedItemModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content rb-modal rb-entity-modal">
                <div class="modal-header">
                    <div class="rb-modal-heading">
                        <span class="rb-modal-heading-icon" aria-hidden="true"><i class="fas fa-boxes-stacked"></i></span>
                        <div>
                            <h2 class="modal-title" id="preparedItemModalTitle">Tạo bán thành phẩm</h2>
                            <p class="rb-modal-subtitle mb-0">Thiết lập danh tính và đơn vị quản lý tồn kho.</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div id="pi-error-summary" class="alert alert-danger py-2 small" style="display:none;" role="alert" tabindex="-1"></div>
                    <input type="hidden" id="pi-id" />
                    <div class="rb-modal-section">
                        <div class="rb-modal-section-heading">
                            <i class="fas fa-fingerprint" aria-hidden="true"></i>
                            <div><strong>Thông tin định danh</strong><span>Mã và tên dùng xuyên suốt trong công thức BOM.</span></div>
                        </div>
                        <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" for="pi-code">Mã BTP <span class="text-danger">*</span></label>
                            <input id="pi-code" class="form-control" maxlength="50" autocomplete="off"
                                   aria-describedby="pi-code-help pi-error" />
                            <div id="pi-code-help" class="form-text">Viết hoa, không khoảng trắng thừa.</div>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-semibold" for="pi-name">Tên BTP <span class="text-danger">*</span></label>
                            <input id="pi-name" class="form-control" maxlength="200" autocomplete="off"
                                   aria-describedby="pi-error" />
                        </div>
                        </div>
                    </div>
                    <div class="rb-modal-section">
                        <div class="rb-modal-section-heading">
                            <i class="fas fa-warehouse" aria-hidden="true"></i>
                            <div><strong>Cấu hình tồn kho</strong><span>Chọn đơn vị cơ sở và bổ sung mô tả vận hành.</span></div>
                        </div>
                        <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" for="pi-unit">Đơn vị tồn kho cơ sở <span class="text-danger">*</span></label>
                            <select id="pi-unit" class="form-select" aria-describedby="pi-unit-help pi-error"></select>
                            <div id="pi-unit-help" class="form-text">
                                Đơn vị này được dùng để lưu số lượng tồn kho của BTP.
                                Sau khi đã phát sinh tồn kho, không nên thay đổi tùy tiện.
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" for="pi-desc">Mô tả</label>
                            <textarea id="pi-desc" class="form-control" maxlength="500" rows="3"
                                      aria-describedby="pi-error"></textarea>
                        </div>
                        <div class="col-12" id="pi-active-wrap" style="display:none">
                            <div class="form-check form-switch rb-brown-switch">
                                <input class="form-check-input" type="checkbox" id="pi-active" />
                                <label class="form-check-label" for="pi-active">Hoạt động</label>
                            </div>
                        </div>
                        </div>
                    </div>
                    <div id="pi-error" class="text-danger small mt-2" role="status" aria-live="polite"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-rb-ghost" data-bs-dismiss="modal"><i class="fas fa-xmark" aria-hidden="true"></i>Hủy</button>
                    <button type="button" class="btn btn-rb-save" id="btnSavePreparedItem"><i class="fas fa-floppy-disk" aria-hidden="true"></i>Lưu bán thành phẩm</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
@if (canWrite)
{
<script>
(function () {
    const base = '/Admin/AdminPreparedItem';
    let unitsLoaded = false;
    let modal;

    function token() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    }
    function ajaxHeaders() {
        return { 'RequestVerificationToken': token(), 'Content-Type': 'application/json' };
    }
    function showError(msg) {
        const el = document.getElementById('pi-error');
        const sum = document.getElementById('pi-error-summary');
        el.textContent = msg || '';
        if (msg) {
            sum.style.display = '';
            sum.textContent = msg;
            sum.focus();
        } else {
            sum.style.display = 'none';
            sum.textContent = '';
        }
    }
    function ensureUnits(done) {
        if (unitsLoaded) { done(); return; }
        fetch(base + '/GetUnits')
            .then(r => r.json())
            .then(res => {
                const sel = document.getElementById('pi-unit');
                sel.innerHTML = '<option value="">-- Chọn đơn vị --</option>';
                (res.data || []).forEach(u => {
                    const opt = document.createElement('option');
                    opt.value = u.unitId;
                    opt.textContent = (u.unitCode || '') + ' — ' + (u.name || '');
                    sel.appendChild(opt);
                });
                unitsLoaded = true;
                done();
            })
            .catch(() => showError('Không tải được danh sách đơn vị.'));
    }
    function resetForm() {
        document.getElementById('pi-id').value = '';
        document.getElementById('pi-code').value = '';
        document.getElementById('pi-name').value = '';
        document.getElementById('pi-unit').value = '';
        document.getElementById('pi-desc').value = '';
        document.getElementById('pi-active').checked = true;
        document.getElementById('pi-active-wrap').style.display = 'none';
        showError('');
        document.getElementById('preparedItemModalTitle').textContent = 'Tạo bán thành phẩm';
    }
    function openCreate() {
        ensureUnits(function () {
            resetForm();
            modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('preparedItemModal'));
            modal.show();
            setTimeout(() => document.getElementById('pi-code').focus(), 200);
        });
    }
    document.getElementById('btnCreate')?.addEventListener('click', openCreate);
    document.getElementById('btnCreateEmpty')?.addEventListener('click', openCreate);

    document.querySelectorAll('.edit-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            const id = this.getAttribute('data-id');
            ensureUnits(function () {
                fetch(base + '/GetById?id=' + id)
                    .then(r => r.json())
                    .then(res => {
                        if (!res.success) { showError(res.message); return; }
                        const d = res.data;
                        document.getElementById('pi-id').value = d.preparedItemId;
                        document.getElementById('pi-code').value = d.code || '';
                        document.getElementById('pi-name').value = d.name || '';
                        document.getElementById('pi-unit').value = d.baseUnitId;
                        document.getElementById('pi-desc').value = d.description || '';
                        document.getElementById('pi-active').checked = !!d.active;
                        document.getElementById('pi-active-wrap').style.display = '';
                        showError('');
                        document.getElementById('preparedItemModalTitle').textContent = 'Sửa bán thành phẩm';
                        modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('preparedItemModal'));
                        modal.show();
                    });
            });
        });
    });

    document.getElementById('btnSavePreparedItem')?.addEventListener('click', function () {
        const idVal = document.getElementById('pi-id').value;
        const dto = {
            preparedItemId: idVal ? parseInt(idVal, 10) : null,
            code: document.getElementById('pi-code').value,
            name: document.getElementById('pi-name').value,
            baseUnitId: parseInt(document.getElementById('pi-unit').value, 10) || 0,
            description: document.getElementById('pi-desc').value,
            active: document.getElementById('pi-active').checked
        };
        const url = idVal ? (base + '/Update') : (base + '/Create');
        fetch(url, { method: 'POST', headers: ajaxHeaders(), body: JSON.stringify(dto) })
            .then(r => r.json())
            .then(res => {
                if (res.success) location.reload();
                else showError(res.message || 'Lỗi lưu');
            })
            .catch(() => showError('Lỗi kết nối hoặc phiên làm việc không hợp lệ.'));
    });

    document.querySelectorAll('.toggle-btn').forEach(btn => {
        btn.addEventListener('click', async function () {
            const id = parseInt(this.getAttribute('data-id'), 10);
            const active = this.getAttribute('data-active') === 'True' || this.getAttribute('data-active') === 'true';
            const label = active ? 'Kích hoạt' : 'Ngừng hoạt động';
            const answer = await Swal.fire({
                icon: active ? 'question' : 'warning',
                title: label + ' bán thành phẩm?',
                text: active
                    ? 'Bán thành phẩm sẽ có thể tiếp tục được sử dụng trong cấu hình BOM.'
                    : 'Bán thành phẩm sẽ không còn được chọn cho cấu hình mới.',
                showCancelButton: true,
                confirmButtonText: label,
                cancelButtonText: 'Hủy',
                reverseButtons: true,
                customClass: { popup: 'rb-confirm-popup', confirmButton: 'rb-confirm-primary', cancelButton: 'rb-confirm-cancel' },
                buttonsStyling: false
            });
            if (!answer.isConfirmed) return;
            fetch(base + '/SetActive', {
                method: 'POST',
                headers: ajaxHeaders(),
                body: JSON.stringify({ preparedItemId: id, active: active })
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) location.reload();
                else Swal.fire({ icon: 'error', title: 'Không thể cập nhật', text: res.message || 'Đã xảy ra lỗi.', confirmButtonColor: '#6f4e37' });
            })
            .catch(() => Swal.fire({ icon: 'error', title: 'Mất kết nối', text: 'Không thể kết nối máy chủ.', confirmButtonColor: '#6f4e37' }));
        });
    });

    document.getElementById('preparedItemModal')?.addEventListener('shown.bs.modal', function () {
        document.getElementById('pi-code')?.focus();
    });
})();
</script>
}
}
