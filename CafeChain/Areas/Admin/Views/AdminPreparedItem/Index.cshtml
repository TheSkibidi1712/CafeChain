@model CafeChain.ViewModels.Admin.PreparedItems.AdminPreparedItemIndexPageVM
@using CafeChain.ViewModels.Admin.Shared
@using Microsoft.Extensions.Localization
@using System.Text.Json
@inject IStringLocalizer<CafeChain.ProductResource> ProductText
@{
    ViewData["Title"] = ProductText["PreparedItem.PageTitle"];
    // Prefer typed page VM (post-#129); fall back to ViewBag if model bag missing CanWrite.
    var canWrite = Model?.CanWrite == true
        || (ViewBag.CanWrite is bool vb && vb);
    int page = Model?.Page ?? (ViewBag.Page as int? ?? 1);
    int totalPages = Model?.TotalPages ?? (ViewBag.TotalPages as int? ?? 1);
    var items = Model?.Items ?? new List<CafeChain.Application.DTOs.Admin.PreparedItems.AdminPreparedItemDTO>();
    int colCount = canWrite ? 5 : 4;
    var heroActions = canWrite
        ? new List<AdminPageHeroActionVM>
        {
            new()
            {
                Id = "btnCreate",
                Label = ProductText["PreparedItem.Create"],
                Url = "#preparedItemEditor",
                IconClass = "fas fa-plus",
                IsPrimary = true
            }
        }
        : [];
    var hero = new AdminPageHeroVM
    {
        Eyebrow = ProductText["Recipe.Eyebrow"],
        Title = ProductText["PreparedItem.Title"],
        Description = ProductText["PreparedItem.Description"],
        IconClass = "fas fa-blender",
        Breadcrumbs = [new() { Label = ProductText["Recipe.Eyebrow"] }, new() { Label = ProductText["PreparedItem.Title"] }],
        Actions = heroActions
    };
    var preparedItemJsCatalog = JsonSerializer.Serialize(ProductText.GetAllStrings()
        .Where(message => message.Name.StartsWith("PreparedItem.Js.", StringComparison.Ordinal))
        .ToDictionary(message => message.Name, message => message.Value));
}

@Html.AntiForgeryToken()
<link rel="stylesheet" href="~/css/recipe-builder.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Admin/production-bom-ui.css" asp-append-version="true" />

<div class="rb-page production-bom-page production-bom-shell bom-list-page prepared-item-list-page">
<div class="container-fluid px-0">
    <partial name="_PageHero" model="hero" />

    <form method="get" class="rb-list-filters production-filter-card" id="filterForm" role="search">
        <label class="visually-hidden" for="searchBox">@ProductText["PreparedItem.SearchLabel"]</label>
        <input name="search" id="searchBox" class="form-control" value="@Model.Search"
               placeholder="@ProductText["PreparedItem.SearchPlaceholder"]" autocomplete="off" />
        <label class="visually-hidden" for="statusFilter">@ProductText["Common.Status"]</label>
        <select name="status" id="statusFilter" class="form-select">
            <option value="">@ProductText["Common.AllStatuses"]</option>
            <option value="true" selected="@(Model.Status == true)">@ProductText["Common.Active"]</option>
            <option value="false" selected="@(Model.Status == false)">@ProductText["Common.Inactive"]</option>
        </select>
        <button type="submit" class="btn btn-rb-save"><i class="fas fa-filter" aria-hidden="true"></i>@ProductText["Common.Filter"]</button>
        <a asp-action="Index" class="btn btn-rb-ghost production-filter-reset" aria-label="@ProductText["Common.ResetFilters"]" title="@ProductText["Common.ResetFilters"]"><i class="fas fa-rotate-left" aria-hidden="true"></i></a>
    </form>

    <section class="production-list-section" aria-labelledby="prepared-item-list-title">
        <header class="production-section-header">
            <div>
                <h2 id="prepared-item-list-title">@ProductText["PreparedItem.ListTitle"]</h2>
                <p>@ProductText["PreparedItem.ListHint"]</p>
            </div>
            <span class="production-section-header__count">@ProductText["PreparedItem.PageCount", items.Count]</span>
        </header>

    <div class="rb-card production-table-panel">
        <div class="table-responsive">
            <table class="table rb-table rb-prepareditem-table production-data-table @(canWrite ? "has-actions" : "is-readonly") mb-0" aria-label="@ProductText["PreparedItem.ListTitle"]">
                <colgroup>
                    <col class="rb-prepared-col-identity" />
                    <col class="rb-prepared-col-uom" />
                    <col class="rb-prepared-col-status" />
                    <col class="rb-prepared-col-recipe" />
                    @if (canWrite)
                    {
                        <col class="rb-prepared-col-actions" />
                    }
                </colgroup>
                <thead>
                    <tr>
                        <th scope="col">@ProductText["PreparedItem.Column.Item"]</th>
                        <th scope="col">@ProductText["PreparedItem.Column.Unit"]</th>
                        <th scope="col">@ProductText["Common.Status"]</th>
                        <th scope="col">@ProductText["PreparedItem.Column.ActiveRecipe"]</th>
                        @if (canWrite)
                        {
                            <th scope="col" class="rb-actions-heading">@ProductText["Common.Actions"]</th>
                        }
                    </tr>
                </thead>
                <tbody>
                @if (items == null || !items.Any())
                {
                    <tr>
                        <td colspan="@colCount" class="text-center py-5">
                            @* Inline empty CTA (restored after #129 ValueTuple _EmptyState path) so write roles always get btnCreateEmpty when CanWrite. *@
                            <div class="rb-empty-state" id="preparedItemEmptyState">
                                <p class="fw-semibold mb-1">@ProductText["PreparedItem.Empty.Title"]</p>
                                @if (canWrite)
                                {
                                    <p class="text-muted small mb-3">@ProductText["PreparedItem.Empty.CreateHint"]</p>
                                    <button type="button" class="btn btn-rb-save" id="btnCreateEmpty">
                                        @ProductText["PreparedItem.Empty.Create"]
                                    </button>
                                }
                                else
                                {
                                    <p class="text-muted small mb-0">
                                        @ProductText["PreparedItem.Empty.ReadOnly"]
                                    </p>
                                }
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in items)
                    {
                        var statusDesc = AdminStatusDisplay.RecipeActive(item.Active);
                        var configDesc = AdminStatusDisplay.PreparedItemConfig(item.ConfigStatusKey, item.ConfigStatus);
                        <tr data-id="@item.PreparedItemId">
                            <td class="rb-prepareditem-identity">
                                <div class="fw-semibold">@item.Name</div>
                                <code class="rb-code">@item.Code</code>
                            </td>
                            <td>
                                <span class="rb-qty-unit">@item.BaseUnitCode</span>
                                <small class="text-muted">(@item.BaseUnitName)</small>
                            </td>
                            <td class="rb-prepared-status-stack">
                                <partial name="_StatusBadge" model="statusDesc" />
                                <div class="rb-prepared-config-status">
                                    <partial name="_StatusBadge" model="configDesc" />
                                </div>
                            </td>
                            <td class="rb-prepared-recipe-cell">
                                @if (item.ActiveRecipeId.HasValue)
                                {
                                    <a class="production-link"
                                       asp-area="Admin" asp-controller="AdminRecipe" asp-action="Edit"
                                       asp-route-id="@item.ActiveRecipeId"
                                       title="@ProductText["PreparedItem.ViewActiveRecipe"]">
                                        @(string.IsNullOrWhiteSpace(item.ActiveRecipeCode) ? ProductText["PreparedItem.ActiveRecipe"] : item.ActiveRecipeCode)
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">@ProductText["Common.None"]</span>
                                }
                                <div class="small text-muted mt-1">@ProductText["PreparedItem.VersionCount", item.VersionCount]</div>
                            </td>
                            @if (canWrite)
                            {
                                <td class="rb-prepareditem-actions-cell">
                                    <div class="production-row-actions">
                                        @if (item.ActiveRecipeId.HasValue)
                                        {
                                            <a class="btn btn-sm btn-outline-secondary rb-table-action"
                                               asp-area="Admin" asp-controller="AdminRecipe" asp-action="Edit"
                                               asp-route-id="@item.ActiveRecipeId"
                                               title="@ProductText["PreparedItem.ViewRecipe"]"
                                               aria-label="@ProductText["PreparedItem.ViewRecipeAria", item.Name]">
                                                <i class="fas fa-diagram-project" aria-hidden="true"></i><span>@ProductText["PreparedItem.ViewRecipe"]</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <a class="btn btn-sm btn-outline-secondary rb-table-action"
                                               asp-area="Admin" asp-controller="AdminRecipe" asp-action="Create"
                                               title="@ProductText["PreparedItem.CreateRecipe"]"
                                               aria-label="@ProductText["PreparedItem.CreateRecipeAria", item.Name]">
                                                <i class="fas fa-plus" aria-hidden="true"></i><span>@ProductText["PreparedItem.CreateRecipe"]</span>
                                            </a>
                                        }
                                        <div class="dropdown production-row-menu">
                                            <button class="btn btn-sm production-row-menu__trigger" type="button"
                                                    data-bs-toggle="dropdown" aria-expanded="false"
                                                    title="@ProductText["Common.OpenActions"]"
                                                    aria-label="@ProductText["Common.OpenActionsAria", item.Name]">
                                                <i class="fas fa-ellipsis-vertical" aria-hidden="true"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li>
                                                    <button type="button" class="dropdown-item edit-btn" data-id="@item.PreparedItemId">
                                                        <i class="fas fa-pen" aria-hidden="true"></i>@ProductText["PreparedItem.Edit"]
                                                    </button>
                                                </li>
                                                <li><hr class="dropdown-divider" /></li>
                                                <li>
                                                    <button type="button" class="dropdown-item toggle-btn @(item.Active ? "text-danger" : "")"
                                                            data-id="@item.PreparedItemId" data-active="@(!item.Active)">
                                                        <i class="fas @(item.Active ? "fa-pause" : "fa-play")" aria-hidden="true"></i>
                                                        @(item.Active ? ProductText["Common.Deactivate"] : ProductText["Common.Activate"])
                                                    </button>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    @if (totalPages > 1)
    {
        <nav class="production-pagination" aria-label="@ProductText["PreparedItem.PaginationAria"]">
            <span class="production-pagination__summary">@ProductText["Common.PageSummary", page, totalPages]</span>
            <div class="production-pagination__links">
                @if (page > 1)
                {
                    <a class="production-page-link is-nav" aria-label="@ProductText["Common.PreviousPage"]"
                       asp-action="Index" asp-route-page="@(page - 1)"
                       asp-route-search="@(Model?.Search ?? ViewBag.Search as string)"
                       asp-route-status="@(Model?.Status ?? ViewBag.Status as bool?)"><i class="fas fa-chevron-left" aria-hidden="true"></i></a>
                }
                @for (int i = 1; i <= totalPages; i++)
                {
                        <a class="production-page-link @(i == page ? "is-current" : "")"
                           aria-current="@(i == page ? "page" : null)"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-search="@(Model?.Search ?? ViewBag.Search as string)"
                           asp-route-status="@(Model?.Status ?? ViewBag.Status as bool?)">@i</a>
                }
                @if (page < totalPages)
                {
                    <a class="production-page-link is-nav" aria-label="@ProductText["Common.NextPage"]"
                       asp-action="Index" asp-route-page="@(page + 1)"
                       asp-route-search="@(Model?.Search ?? ViewBag.Search as string)"
                       asp-route-status="@(Model?.Status ?? ViewBag.Status as bool?)"><i class="fas fa-chevron-right" aria-hidden="true"></i></a>
                }
            </div>
        </nav>
    }
    </div>
    </section>
</div>
</div>

@if (canWrite)
{
    <div class="modal fade" id="preparedItemModal" tabindex="-1" aria-labelledby="preparedItemModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content rb-modal rb-entity-modal">
                <div class="modal-header">
                    <div class="rb-modal-heading">
                        <span class="rb-modal-heading-icon" aria-hidden="true"><i class="fas fa-boxes-stacked"></i></span>
                        <div>
                            <h2 class="modal-title" id="preparedItemModalTitle">@ProductText["PreparedItem.Create"]</h2>
                            <p class="rb-modal-subtitle mb-0">@ProductText["PreparedItem.Modal.Subtitle"]</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@ProductText["Common.Close"]"></button>
                </div>
                <div class="modal-body">
                    <div id="pi-error-summary" class="alert alert-danger py-2 small" style="display:none;" role="alert" tabindex="-1"></div>
                    <input type="hidden" id="pi-id" />
                    <div class="rb-modal-section">
                        <div class="rb-modal-section-heading">
                            <i class="fas fa-fingerprint" aria-hidden="true"></i>
                            <div><strong>@ProductText["PreparedItem.Identity.Title"]</strong><span>@ProductText["PreparedItem.Identity.Hint"]</span></div>
                        </div>
                        <div class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label fw-semibold" for="pi-code">@ProductText["PreparedItem.Code"] <span class="text-danger">*</span></label>
                            <input id="pi-code" class="form-control" maxlength="50" autocomplete="off"
                                   aria-describedby="pi-code-help pi-error" />
                            <div id="pi-code-help" class="form-text" style="white-space: nowrap;">@ProductText["PreparedItem.CodeHint"]</div>
                        </div>
                        <div class="col-md-7">
                            <label class="form-label fw-semibold" for="pi-name">@ProductText["PreparedItem.Name"] <span class="text-danger">*</span></label>
                            <input id="pi-name" class="form-control" maxlength="200" autocomplete="off"
                                   aria-describedby="pi-error" />
                        </div>
                        </div>
                    </div>
                    <div class="rb-modal-section">
                        <div class="rb-modal-section-heading">
                            <i class="fas fa-warehouse" aria-hidden="true"></i>
                            <div><strong>@ProductText["PreparedItem.Inventory.Title"]</strong><span>@ProductText["PreparedItem.Inventory.Hint"]</span></div>
                        </div>
                        <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" for="pi-unit">@ProductText["PreparedItem.BaseUnit"] <span class="text-danger">*</span></label>
                            <select id="pi-unit" class="form-select" aria-describedby="pi-unit-help pi-error"></select>
                            <div id="pi-unit-help" class="form-text">
                                @ProductText["PreparedItem.BaseUnitHint"]
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" for="pi-desc">@ProductText["Common.Description"]</label>
                            <textarea id="pi-desc" class="form-control" maxlength="500" rows="3"
                                      aria-describedby="pi-error"></textarea>
                        </div>
                        <div class="col-12" id="pi-active-wrap" style="display:none">
                            <div class="form-check form-switch rb-brown-switch">
                                <input class="form-check-input" type="checkbox" id="pi-active" />
                                <label class="form-check-label" for="pi-active">@ProductText["Common.Active"]</label>
                            </div>
                        </div>
                        </div>
                    </div>
                    <div id="pi-error" class="text-danger small mt-2" role="status" aria-live="polite"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-rb-ghost" data-bs-dismiss="modal"><i class="fas fa-xmark" aria-hidden="true"></i>@ProductText["Common.Cancel"]</button>
                    <button type="button" class="btn btn-rb-save" id="btnSavePreparedItem"><i class="fas fa-floppy-disk" aria-hidden="true"></i>@ProductText["PreparedItem.Save"]</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
@if (canWrite)
{
<script id="preparedItemUiCatalog" type="application/json">@Html.Raw(preparedItemJsCatalog)</script>
<script>
(function () {
    const base = '/Admin/AdminPreparedItem';
    const catalog = window.CafeChainUiCatalog.read('preparedItemUiCatalog');
    const text = (key, values) => window.CafeChainUiCatalog.text(catalog, key, values);
    let unitsLoaded = false;
    let modal;

    function token() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    }
    function ajaxHeaders() {
        return { 'RequestVerificationToken': token(), 'Content-Type': 'application/json' };
    }
    function showError(msg) {
        const el = document.getElementById('pi-error');
        const sum = document.getElementById('pi-error-summary');
        el.textContent = msg || '';
        if (msg) {
            sum.style.display = '';
            sum.textContent = msg;
            sum.focus();
        } else {
            sum.style.display = 'none';
            sum.textContent = '';
        }
    }
    function ensureUnits(done) {
        if (unitsLoaded) { done(); return; }
        fetch(base + '/GetUnits')
            .then(r => r.json())
            .then(res => {
                const sel = document.getElementById('pi-unit');
                sel.replaceChildren(new Option(text('PreparedItem.Js.SelectUnit'), ''));
                (res.data || []).forEach(u => {
                    const opt = document.createElement('option');
                    opt.value = u.unitId;
                    opt.textContent = (u.unitCode || '') + ' — ' + (u.name || '');
                    sel.appendChild(opt);
                });
                unitsLoaded = true;
                done();
            })
            .catch(() => showError(text('PreparedItem.Js.UnitsLoadFailed')));
    }
    function resetForm() {
        document.getElementById('pi-id').value = '';
        document.getElementById('pi-code').value = '';
        document.getElementById('pi-name').value = '';
        document.getElementById('pi-unit').value = '';
        document.getElementById('pi-desc').value = '';
        document.getElementById('pi-active').checked = true;
        document.getElementById('pi-active-wrap').style.display = 'none';
        showError('');
        document.getElementById('preparedItemModalTitle').textContent = text('PreparedItem.Js.CreateTitle');
    }
    function openCreate() {
        ensureUnits(function () {
            resetForm();
            modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('preparedItemModal'));
            modal.show();
            setTimeout(() => document.getElementById('pi-code').focus(), 200);
        });
    }
    document.getElementById('btnCreate')?.addEventListener('click', function (event) {
        event.preventDefault();
        openCreate();
    });
    document.getElementById('btnCreateEmpty')?.addEventListener('click', openCreate);

    document.querySelectorAll('.edit-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            const id = this.getAttribute('data-id');
            ensureUnits(function () {
                fetch(base + '/GetById?id=' + id)
                    .then(r => r.json())
                    .then(res => {
                        if (!res.success) { showError(res.message); return; }
                        const d = res.data;
                        document.getElementById('pi-id').value = d.preparedItemId;
                        document.getElementById('pi-code').value = d.code || '';
                        document.getElementById('pi-name').value = d.name || '';
                        document.getElementById('pi-unit').value = d.baseUnitId;
                        document.getElementById('pi-desc').value = d.description || '';
                        document.getElementById('pi-active').checked = !!d.active;
                        document.getElementById('pi-active-wrap').style.display = '';
                        showError('');
                        document.getElementById('preparedItemModalTitle').textContent = text('PreparedItem.Js.EditTitle');
                        modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('preparedItemModal'));
                        modal.show();
                    });
            });
        });
    });

    document.getElementById('btnSavePreparedItem')?.addEventListener('click', function () {
        const idVal = document.getElementById('pi-id').value;
        const dto = {
            preparedItemId: idVal ? parseInt(idVal, 10) : null,
            code: document.getElementById('pi-code').value,
            name: document.getElementById('pi-name').value,
            baseUnitId: parseInt(document.getElementById('pi-unit').value, 10) || 0,
            description: document.getElementById('pi-desc').value,
            active: document.getElementById('pi-active').checked
        };
        const url = idVal ? (base + '/Update') : (base + '/Create');
        fetch(url, { method: 'POST', headers: ajaxHeaders(), body: JSON.stringify(dto) })
            .then(r => r.json())
            .then(res => {
                if (res.success) location.reload();
                else showError(res.message || text('PreparedItem.Js.SaveFailed'));
            })
            .catch(() => showError(text('PreparedItem.Js.SessionError')));
    });

    document.querySelectorAll('.toggle-btn').forEach(btn => {
        btn.addEventListener('click', async function () {
            const id = parseInt(this.getAttribute('data-id'), 10);
            const active = this.getAttribute('data-active') === 'True' || this.getAttribute('data-active') === 'true';
            const label = active ? text('PreparedItem.Js.Activate') : text('PreparedItem.Js.Deactivate');
            const answer = await Swal.fire({
                icon: active ? 'question' : 'warning',
                title: text('PreparedItem.Js.ToggleTitle', { action: label }),
                text: active
                    ? text('PreparedItem.Js.ActivateHint')
                    : text('PreparedItem.Js.DeactivateHint'),
                showCancelButton: true,
                confirmButtonText: label,
                cancelButtonText: text('PreparedItem.Js.Cancel'),
                reverseButtons: true,
                customClass: { popup: 'rb-confirm-popup', confirmButton: 'rb-confirm-primary', cancelButton: 'rb-confirm-cancel' },
                buttonsStyling: false
            });
            if (!answer.isConfirmed) return;
            fetch(base + '/SetActive', {
                method: 'POST',
                headers: ajaxHeaders(),
                body: JSON.stringify({ preparedItemId: id, active: active })
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) location.reload();
                else Swal.fire({ icon: 'error', title: text('PreparedItem.Js.UpdateFailed'), text: res.message || text('PreparedItem.Js.GenericError'), confirmButtonColor: '#6f4e37' });
            })
            .catch(() => Swal.fire({ icon: 'error', title: text('PreparedItem.Js.ConnectionLost'), text: text('PreparedItem.Js.ServerUnavailable'), confirmButtonColor: '#6f4e37' }));
        });
    });

    document.getElementById('preparedItemModal')?.addEventListener('shown.bs.modal', function () {
        document.getElementById('pi-code')?.focus();
    });
})();
</script>
}
}
