@model List<CafeChain.Application.DTOs.Admin.RestockRequests.BranchReceiptListItemDto>
@using CafeChain.Application.DTOs.Admin.StoreScope
@{
    ViewData["Title"] = "Phiếu nhận hàng chi nhánh";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var statusFilter = ViewBag.StatusFilter as string;
    var storeId = ViewBag.StoreId as int? ?? 0;
    var canCreate = ViewBag.CanCreate as bool? ?? false;
    var stores = ViewBag.StoreOptions as IReadOnlyList<AdminStoreOptionDto>
        ?? Array.Empty<AdminStoreOptionDto>();
    string StatusLabel(string value) => value switch
    {
        "DRAFT" => "Bản nháp",
        "CONFIRMED" => "Đã xác nhận",
        _ => value
    };
}

<link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />

<main class="ops-shell">
    <header class="ops-header">
        <div>
            <div class="ops-eyebrow">Chứng từ nhập kho · Cửa hàng #@storeId</div>
            <h1 class="ops-title">Phiếu nhận hàng</h1>
            <p class="ops-subtitle">Theo dõi hàng thực nhận và chi phí đã chốt. Chỉ phiếu đã xác nhận mới cập nhật tồn kho.</p>
        </div>
        <div class="ops-actions">
            <a class="ops-btn" asp-area="Admin" asp-controller="AdminRestockRequests" asp-action="Index" asp-route-storeId="@storeId">
                <i class="fa-solid fa-list-check" aria-hidden="true"></i> Yêu cầu nhập
            </a>
            @if (canCreate && storeId > 0)
            {
                <a class="ops-btn ops-btn-primary" asp-area="Admin" asp-controller="AdminBranchReceipts" asp-action="Create" asp-route-storeId="@storeId">
                    <i class="fa-solid fa-plus" aria-hidden="true"></i> Tạo phiếu nhận
                </a>
            }
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null) { <div class="ops-notice ops-notice-success" role="status">@TempData["SuccessMessage"]</div> }
    @if (TempData["WarningMessage"] != null) { <div class="ops-notice ops-notice-warning" role="status">@TempData["WarningMessage"]</div> }
    @if (TempData["ErrorMessage"] != null) { <div class="ops-notice ops-notice-error" role="alert">@TempData["ErrorMessage"]</div> }

    @if (stores.Count > 1)
    {
        <form method="get" class="ops-filterbar" aria-label="Chọn cửa hàng">
            <input type="hidden" name="status" value="@statusFilter" />
            <div class="ops-filter-group">
                <label class="ops-form-label mb-0" for="receiptStoreId">Cửa hàng</label>
                <select id="receiptStoreId" name="storeId" class="ops-select" onchange="this.form.submit()">
                    @foreach (var store in stores)
                    {
                        <option value="@store.StoreId" selected="@(store.StoreId == storeId)">@store.StoreName</option>
                    }
                </select>
            </div>
            <noscript><button type="submit" class="ops-btn">Áp dụng</button></noscript>
        </form>
    }

    <nav class="ops-tabs" aria-label="Lọc trạng thái phiếu nhận">
        <a class="ops-tab @(string.IsNullOrEmpty(statusFilter) ? "active" : "")" asp-action="Index" asp-route-storeId="@storeId">Tất cả</a>
        <a class="ops-tab @(statusFilter == "DRAFT" ? "active" : "")" asp-action="Index" asp-route-storeId="@storeId" asp-route-status="DRAFT">Bản nháp</a>
        <a class="ops-tab @(statusFilter == "CONFIRMED" ? "active" : "")" asp-action="Index" asp-route-storeId="@storeId" asp-route-status="CONFIRMED">Đã xác nhận</a>
    </nav>

    @if (Model.Count == 0)
    {
        <section class="ops-empty">
            <i class="fa-solid fa-clipboard-check fa-2x mb-3" aria-hidden="true"></i>
            <div class="fw-bold text-dark">Chưa có phiếu nhận phù hợp</div>
            <div class="mt-1">Chọn trạng thái khác hoặc tạo phiếu từ một yêu cầu nhập đang mở.</div>
        </section>
    }
    else
    {
        <section class="ops-panel">
            <div class="ops-table-scroll">
                <table class="ops-table" style="min-width:850px">
                    <caption class="visually-hidden">Danh sách phiếu nhận hàng chi nhánh</caption>
                    <thead><tr><th>Mã phiếu</th><th>Khóa chống trùng</th><th>Trạng thái</th><th class="number">Số dòng</th><th class="number">SL quy đổi</th><th class="number">Giá trị</th><th>Thời gian nhận</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.ReceiptCode</strong><div class="ops-secondary">Cửa hàng #@item.StoreId</div></td>
                            <td><code>@item.ReceiptKey</code></td>
                            <td><span class="ops-badge @(item.Status == "CONFIRMED" ? "ops-badge-success" : "ops-badge-neutral")">@StatusLabel(item.Status)</span></td>
                            <td class="number">@item.LineCount</td>
                            <td class="number">@item.TotalBaseQuantity.ToString("N3")</td>
                            <td class="number">@item.TotalLineCost.ToString("N0") đ</td>
                            <td class="text-nowrap">@item.ReceivedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end"><a class="ops-btn" asp-action="Details" asp-route-id="@item.BranchReceiptId">Chi tiết <i class="fa-solid fa-chevron-right ms-1" aria-hidden="true"></i></a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }
</main>
