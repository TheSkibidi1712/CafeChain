@model List<CafeChain.Application.DTOs.Admin.RestockRequests.BranchReceiptListItemDto>
@using CafeChain.Application.DTOs.Admin.StoreScope
@using CafeChain.ViewModels.Admin.Shared
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ProcurementResource> L
@{
    ViewData["Title"] = L["BranchReceipt.Title"];
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var statusFilter = ViewBag.StatusFilter as string;
    var storeId = ViewBag.StoreId as int? ?? 0;
    var canCreate = ViewBag.CanCreate as bool? ?? false;
    var stores = ViewBag.StoreOptions as IReadOnlyList<AdminStoreOptionDto>
        ?? Array.Empty<AdminStoreOptionDto>();
}

<link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />

<main class="ops-shell branch-receipt-page branch-receipt-index-page cc-warehouse-page">
    <header class="ops-header cc-warehouse-header">
        <div>
            <div class="ops-eyebrow">@L["BranchReceipt.Eyebrow", storeId]</div>
            <h1 class="ops-title"><i class="fa-solid fa-receipt me-2 text-warning" aria-hidden="true"></i>@L["BranchReceipt.Title"]</h1>
            <p class="ops-subtitle">@L["BranchReceipt.Subtitle"]</p>
        </div>
        <div class="ops-actions">
            <a class="ops-btn" asp-area="Admin" asp-controller="AdminRestockRequests" asp-action="Index" asp-route-storeId="@storeId">
                <i class="fa-solid fa-list-check" aria-hidden="true"></i> @L["BranchReceipt.RestockRequests"]
            </a>
            @if (canCreate && storeId > 0)
            {
                <a class="ops-btn ops-btn-primary" asp-area="Admin" asp-controller="AdminBranchReceipts" asp-action="Create" asp-route-storeId="@storeId">
                    <i class="fa-solid fa-plus" aria-hidden="true"></i> @L["BranchReceipt.Create"]
                </a>
            }
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null) { <div class="ops-notice ops-notice-success" role="status">@TempData["SuccessMessage"]</div> }
    @if (TempData["WarningMessage"] != null) { <div class="ops-notice ops-notice-warning" role="status">@TempData["WarningMessage"]</div> }
    @if (TempData["ErrorMessage"] != null) { <div class="ops-notice ops-notice-error" role="alert">@TempData["ErrorMessage"]</div> }

    @if (stores.Count > 1)
    {
        <form method="get" class="ops-filterbar cc-warehouse-filter" aria-label="@L["BranchReceipt.SelectBranchAria"]">
            <input type="hidden" name="status" value="@statusFilter" />
            <div class="ops-filter-group">
                <label class="ops-form-label mb-0" for="receiptStoreId">@L["Common.Branch"]</label>
                <select id="receiptStoreId" name="storeId" class="ops-select" onchange="this.form.submit()">
                    @foreach (var store in stores)
                    {
                        <option value="@store.StoreId" selected="@(store.StoreId == storeId)">@store.StoreName</option>
                    }
                </select>
            </div>
            <noscript><button type="submit" class="ops-btn">@L["Common.Apply"]</button></noscript>
        </form>
    }

    <nav class="ops-status-tabs" aria-label="@L["BranchReceipt.FilterAria"]">
        <a class="ops-tab @(string.IsNullOrEmpty(statusFilter) ? "active" : "")" asp-action="Index" asp-route-storeId="@storeId">@L["Common.All"]</a>
        <a class="ops-tab @(statusFilter == "DRAFT" ? "active" : "")" asp-action="Index" asp-route-storeId="@storeId" asp-route-status="DRAFT">@L["BranchReceipt.Draft"]</a>
        <a class="ops-tab @(statusFilter == "CONFIRMED" ? "active" : "")" asp-action="Index" asp-route-storeId="@storeId" asp-route-status="CONFIRMED">@L["BranchReceipt.Confirmed"]</a>
    </nav>

    @if (Model.Count == 0)
    {
        <section class="ops-empty cc-warehouse-empty" role="status">
            <i class="fa-solid fa-clipboard-check fa-2x mb-3" aria-hidden="true"></i>
            <div class="fw-bold text-dark">@L["BranchReceipt.EmptyTitle"]</div>
            <div class="mt-1">@L["BranchReceipt.EmptyCopy"]</div>
        </section>
    }
    else
    {
        <section class="ops-panel">
            <div class="ops-table-scroll cc-warehouse-table-shell">
                <table class="ops-table ops-table-min-850 branch-receipt-table">
                    <caption class="visually-hidden">@L["BranchReceipt.ListAria"]</caption>
                    <thead><tr><th>@L["BranchReceipt.Code"]</th><th>@L["Common.Status"]</th><th class="number">@L["BranchReceipt.LineCount"]</th><th class="number">@L["BranchReceipt.ConvertedQuantity"]</th><th class="number">@L["Common.Value"]</th><th>@L["BranchReceipt.ReceivedAt"]</th><th class="text-end">@L["Common.Actions"]</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            @{ var receiptStatus = AdminStatusDisplay.BranchReceipt(item.Status); }
                            <td class="ops-reference-cell"><strong>@item.ReceiptCode</strong><div class="ops-secondary">@L["BranchReceipt.BranchNumber", item.StoreId]</div></td>
                            <td><span class="ops-badge @(item.Status == "CONFIRMED" ? "ops-badge-success" : "ops-badge-neutral")">@L[$"Status.{item.Status}"]</span></td>
                            <td class="number">@item.LineCount</td>
                            <td class="number">@AdminStatusDisplay.Quantity(item.TotalBaseQuantity)</td>
                            <td class="number">@AdminStatusDisplay.Currency(item.TotalLineCost)</td>
                            <td class="text-nowrap">@AdminStatusDisplay.DateTime(item.ReceivedAt.ToLocalTime())</td>
                            <td class="text-end"><a class="ops-btn" asp-action="Details" asp-route-id="@item.BranchReceiptId">@L["Common.Details"] <i class="fa-solid fa-chevron-right ms-1" aria-hidden="true"></i></a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }
</main>
