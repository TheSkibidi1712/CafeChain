@model CafeChain.Application.DTOs.Admin.RestockRequests.PurchaseOrderReceiptDraftDto
@using CafeChain.Application.Constants
@using CafeChain.Models.Enums.Inventory
@using CafeChain.ViewModels.Admin.Shared
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ProcurementResource> L
@{
    ViewData["Title"] = L["BranchReceipt.Draft.Title"];
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />

<main class="ops-shell branch-receipt-page branch-receipt-draft-page cc-warehouse-page">
<header class="ops-header cc-warehouse-header cc-warehouse-header--compact">
        <div>
            <div class="ops-eyebrow">@Model.PurchaseOrderCode · @Model.StoreName</div>
            <h1 class="ops-title">@L["BranchReceipt.Draft.Heading", Model.SupplierName]</h1>
            <p class="ops-subtitle">@L["BranchReceipt.Draft.Subtitle"]</p>
        </div>
        <a class="ops-btn" asp-area="Admin" asp-controller="AdminPurchaseOrders" asp-action="Details" asp-route-id="@Model.PurchaseOrderId">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> @L["BranchReceipt.Draft.BackToOrder"]
        </a>
    </header>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="ops-notice ops-notice-success">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="ops-notice ops-notice-error">@error</div>
    }

    <section class="ops-metrics">
        <div class="ops-metric"><span class="ops-metric-label">@L["BranchReceipt.Draft.ReceiptCode"]</span><strong class="ops-metric-value">@Model.ReceiptCode</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">@L["Common.Branch"]</span><strong class="ops-metric-value">@Model.StoreName</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">@L["Common.Supplier"]</span><strong class="ops-metric-value">@Model.SupplierName</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">@L["BranchReceipt.Draft.RemainingLines"]</span><strong class="ops-metric-value warning">@Model.Lines.Count(x => x.OrderedProcurementQuantity.HasValue ? x.RemainingProcurementQuantity.GetValueOrDefault() > 0 : x.RemainingBaseQuantity > 0)</strong></div>
    </section>

    <div class="ops-notice ops-notice-info">
        @L["BranchReceipt.Draft.Info"]
    </div>

    <form asp-action="SavePurchaseOrderDraft" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="BranchReceiptId" value="@Model.BranchReceiptId" />
        <input type="hidden" name="RowVersion" value="@Model.RowVersion" />

        <section class="ops-panel">
            <div class="ops-panel-header"><h2 class="ops-panel-title">@L["BranchReceipt.Draft.DeliveryInfo"]</h2></div>
            <div class="ops-panel-body">
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="ops-form-label" for="referenceNumber">@L["BranchReceipt.Draft.SupplierDoc"]</label>
                        <input class="ops-input w-100" id="referenceNumber" name="ReferenceNumber" value="@Model.ReferenceNumber" maxlength="100" />
                    </div>
                    <div class="col-md-7">
                        <label class="ops-form-label" for="notes">@L["BranchReceipt.Draft.CountNotes"]</label>
                        <input class="ops-input w-100" id="notes" name="Notes" value="@Model.Notes" maxlength="1000" />
                    </div>
                </div>
            </div>
        </section>

        <section class="ops-panel">
            <div class="ops-panel-header"><h2 class="ops-panel-title">@L["BranchReceipt.Draft.LinesTitle"]</h2></div>
            <div class="ops-panel-body p-0">
                <div class="ops-table-scroll cc-warehouse-table-shell">
                    <table class="ops-table">
                        <thead>
                            <tr>
                                <th>@L["Common.Ingredient"]</th>
                                <th class="number">@L["BranchReceipt.Draft.Ordered"]</th>
                                <th class="number">@L["BranchReceipt.Draft.AlreadyAccepted"]</th>
                                <th class="number">@L["BranchReceipt.Draft.StillDue"]</th>
                                <th>@L["BranchReceipt.Details.ActualQty"]</th>
                                <th>@L["BranchReceipt.Details.RejectedQty"]</th>
                                <th>@L["BranchReceipt.Draft.ExpectedAccepted"]</th>
                                <th>@L["BranchReceipt.Draft.IssueReason"]</th>
                            </tr>
                        </thead>
                        <tbody>
                        @for (var i = 0; i < Model.Lines.Count; i++)
                        {
                            var line = Model.Lines[i];
                            var isLoose = line.PurchaseMode == PurchaseMode.Loose;
                            var usesProcurement = line.OrderedProcurementQuantity.HasValue;
                            var isClosed = usesProcurement
                                ? line.RemainingProcurementQuantity.GetValueOrDefault() <= 0
                                : line.RemainingBaseQuantity <= 0;
                            <tr class="receipt-draft-line" data-line-index="@i">
                                <td>
                                    <strong class="ops-item-name">@line.IngredientName</strong>
                                    @if (isLoose)
                                    {
                                        <div class="ops-secondary">@L["BranchReceipt.Draft.LooseMeta", AdminStatusDisplay.Currency(line.UnitPricePerProcurementUnit.GetValueOrDefault()), AdminStatusDisplay.Unit(line.ProcurementUnitName)]</div>
                                    }
                                    else
                                    {
                                        <div class="ops-secondary">@L["BranchReceipt.Draft.PackageMeta", AdminStatusDisplay.Quantity(line.PackageQuantitySnapshot.GetValueOrDefault()), AdminStatusDisplay.Unit(line.PackageUnitName), AdminStatusDisplay.Currency(line.PackagePriceSnapshot.GetValueOrDefault())]</div>
                                    }
                                    @if (line.OrderedProcurementQuantity.HasValue)
                                    {
                                        <div class="ops-secondary">@L["BranchReceipt.Draft.ProcurementMeta", AdminStatusDisplay.Quantity(line.OrderedProcurementQuantity.Value), AdminStatusDisplay.Unit(line.ProcurementUnitName), AdminStatusDisplay.Quantity(line.PreviouslyAcceptedProcurementQuantity.GetValueOrDefault()), AdminStatusDisplay.Quantity(line.RemainingProcurementQuantity.GetValueOrDefault())]</div>
                                    }
                                    @if (line.RestockRequestId.HasValue)
                                    {
                                        <div class="ops-secondary">@AdminStatusDisplay.RestockReference(line.RestockReferenceCode, line.RestockRequestId.Value)</div>
                                    }
                                </td>
                                <td class="number">@(usesProcurement ? AdminStatusDisplay.Quantity(line.OrderedProcurementQuantity!.Value) + " " + AdminStatusDisplay.Unit(line.ProcurementUnitName) : AdminStatusDisplay.Quantity(line.OrderedBaseQuantity) + " " + AdminStatusDisplay.Unit(line.BaseUnitName))</td>
                                <td class="number">@(usesProcurement ? AdminStatusDisplay.Quantity(line.PreviouslyAcceptedProcurementQuantity.GetValueOrDefault()) + " " + AdminStatusDisplay.Unit(line.ProcurementUnitName) : AdminStatusDisplay.Quantity(line.PreviouslyAcceptedBaseQuantity) + " " + AdminStatusDisplay.Unit(line.BaseUnitName))</td>
                                <td class="number"><strong>@(usesProcurement ? AdminStatusDisplay.Quantity(line.RemainingProcurementQuantity.GetValueOrDefault()) + " " + AdminStatusDisplay.Unit(line.ProcurementUnitName) : AdminStatusDisplay.Quantity(line.RemainingBaseQuantity) + " " + AdminStatusDisplay.Unit(line.BaseUnitName))</strong></td>
                                <td>
                                    <input type="hidden" name="Lines[@i].PurchaseOrderLineId" value="@line.PurchaseOrderLineId" />
                                    <input class="ops-input w-100 actual-quantity" type="number" step="0.001" min="0" name="Lines[@i].ActualReceivedQuantity" value="@line.ActualReceivedQuantity" disabled="@isClosed" aria-label="@(isLoose ? L["BranchReceipt.Draft.ActualAriaLoose", line.IngredientName].Value : L["BranchReceipt.Draft.ActualAriaPack", line.IngredientName].Value)" />
                                    <div class="ops-secondary">@(isLoose
                                        ? AdminStatusDisplay.Unit(line.ProcurementUnitName)
                                        : L["BranchReceipt.Draft.ActualPackagesHelp", AdminStatusDisplay.Quantity(line.PackageQuantitySnapshot.GetValueOrDefault()), AdminStatusDisplay.Unit(line.PackageUnitName)].Value)</div>
                                </td>
                                <td>
                                    <input class="ops-input w-100 rejected-quantity" type="number" step="0.001" min="0" name="Lines[@i].RejectedQuantity" value="@line.RejectedQuantity" disabled="@isClosed" aria-label="@(isLoose ? L["BranchReceipt.Draft.RejectedAriaLoose", line.IngredientName].Value : L["BranchReceipt.Draft.RejectedAriaPack", line.IngredientName].Value)" />
                                </td>
                                <td><strong class="accepted-preview">0</strong> @(isLoose ? AdminStatusDisplay.Unit(line.ProcurementUnitName) : L["BranchReceipt.Draft.PackageUnit"].Value)<span class="visually-hidden">@(isLoose ? "" : L["BranchReceipt.Draft.ExpectedPackHidden"].Value)</span></td>
                            <td class="ops-cell-min-240">
                                    <select class="ops-select w-100 mb-2" name="Lines[@i].RejectionIssueType" disabled="@isClosed">
                                        <option value="">@L["BranchReceipt.Draft.NoIssue"]</option>
                                        <option value="@SupplierReceiptIssueTypes.ShortDelivery" selected="@(line.RejectionIssueType == SupplierReceiptIssueTypes.ShortDelivery)">@L["BranchReceipt.Draft.Issue.Short"]</option>
                                        <option value="@SupplierReceiptIssueTypes.WrongItem" selected="@(line.RejectionIssueType == SupplierReceiptIssueTypes.WrongItem)">@L["BranchReceipt.Draft.Issue.Wrong"]</option>
                                        <option value="@SupplierReceiptIssueTypes.Damaged" selected="@(line.RejectionIssueType == SupplierReceiptIssueTypes.Damaged)">@L["BranchReceipt.Draft.Issue.Damaged"]</option>
                                        <option value="@SupplierReceiptIssueTypes.Expired" selected="@(line.RejectionIssueType == SupplierReceiptIssueTypes.Expired)">@L["BranchReceipt.Draft.Issue.Expired"]</option>
                                        <option value="@SupplierReceiptIssueTypes.QualityFailure" selected="@(line.RejectionIssueType == SupplierReceiptIssueTypes.QualityFailure)">@L["BranchReceipt.Draft.Issue.Quality"]</option>
                                        <option value="@SupplierReceiptIssueTypes.PackagingFailure" selected="@(line.RejectionIssueType == SupplierReceiptIssueTypes.PackagingFailure)">@L["BranchReceipt.Draft.Issue.Packaging"]</option>
                                        <option value="@SupplierReceiptIssueTypes.DocumentMismatch" selected="@(line.RejectionIssueType == SupplierReceiptIssueTypes.DocumentMismatch)">@L["BranchReceipt.Draft.Issue.Document"]</option>
                                        <option value="@SupplierReceiptIssueTypes.Other" selected="@(line.RejectionIssueType == SupplierReceiptIssueTypes.Other)">@L["BranchReceipt.Draft.Issue.Other"]</option>
                                    </select>
                                    <input class="ops-input w-100" name="Lines[@i].RejectionReason" value="@line.RejectionReason" maxlength="500" placeholder="@L["BranchReceipt.Draft.ReasonPlaceholder"]" disabled="@isClosed" />
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <div class="ops-inline-actions mt-3">
            <button class="ops-btn ops-btn-primary" type="submit"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> @L["BranchReceipt.Draft.Save"]</button>
            <a class="ops-btn" asp-action="Details" asp-route-id="@Model.BranchReceiptId">@L["BranchReceipt.Draft.ViewCurrent"]</a>
        </div>
    </form>
</main>

@section Scripts {
    <script>
        (() => {
            const updatePreview = (row) => {
                const actual = Number(row.querySelector('.actual-quantity')?.value || 0);
                const rejected = Number(row.querySelector('.rejected-quantity')?.value || 0);
                const preview = row.querySelector('.accepted-preview');
                if (preview) preview.textContent = Math.max(0, actual - rejected).toLocaleString('vi-VN', { maximumFractionDigits: 3 });
            };
            document.querySelectorAll('.receipt-draft-line').forEach(row => {
                row.querySelectorAll('.actual-quantity, .rejected-quantity').forEach(input => {
                    input.addEventListener('input', () => updatePreview(row));
                });
                updatePreview(row);
            });
        })();
    </script>
}
