@model CafeChain.Application.DTOs.Admin.RestockRequests.CreateBranchReceiptRequest
@using CafeChain.Application.DTOs.Admin.RestockRequests
@using Microsoft.Extensions.Localization
@using System.Text.Json
@inject IStringLocalizer<ProcurementResource> L
@{
    ViewData["Title"] = L["BranchReceipt.Create.Title"];
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var supplierOptions = ViewBag.SupplierOptions as IReadOnlyList<BranchReceiptSupplierOptionDto>
        ?? Array.Empty<BranchReceiptSupplierOptionDto>();
    string J(string key) => JsonSerializer.Serialize(L[key].Value);
}

<link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />

<main class="ops-shell ops-shell-narrow branch-receipt-page branch-receipt-create-page cc-warehouse-page">
<header class="ops-header cc-warehouse-header cc-warehouse-header--compact">
        <div>
            <div class="ops-eyebrow">@L["BranchReceipt.Create.Eyebrow", Model.StoreId]</div>
            <h1 class="ops-title">@L["BranchReceipt.Create.Heading"]</h1>
            <p class="ops-subtitle">@L["BranchReceipt.Create.Subtitle"]</p>
        </div>
        <div class="ops-actions">
            <a class="ops-btn" asp-action="Index" asp-route-storeId="@Model.StoreId"><i class="fa-solid fa-xmark" aria-hidden="true"></i> @L["Common.Cancel"]</a>
        </div>
    </header>

    @if (TempData["ErrorMessage"] != null) { <div class="ops-notice ops-notice-error" role="alert">@TempData["ErrorMessage"]</div> }
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="ops-notice ops-notice-error cc-warehouse-alert cc-warehouse-alert-danger" role="alert"></div>
    }

    <form method="post" asp-action="Create" id="branchReceiptForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="StoreId" />
        <input type="hidden" asp-for="ReceiptKey" />

        <section class="ops-panel">
            <div class="ops-panel-header"><h2 class="ops-panel-title">@L["BranchReceipt.Details.DocumentInfo"]</h2></div>
            <div class="ops-panel-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="ops-form-label" asp-for="SupplierId">@L["Common.Supplier"]</label>
                        <select class="ops-select w-100" asp-for="SupplierId" id="receiptSupplier" required>
                            <option value="">@L["BranchReceipt.Create.SelectSupplier"]</option>
                            @foreach (var supplier in supplierOptions)
                            {
                                <option value="@supplier.SupplierId">@supplier.SupplierCode · @supplier.SupplierName</option>
                            }
                        </select>
                        <div class="ops-help">@L["BranchReceipt.Create.SupplierHelp"]</div>
                    </div>
                    <div class="col-md-6">
                        <label class="ops-form-label" asp-for="ReferenceNumber">@L["BranchReceipt.Details.Reference"]</label>
                        <input class="ops-input w-100" asp-for="ReferenceNumber" maxlength="100" placeholder="@L["BranchReceipt.Create.ReferencePlaceholder"]" />
                    </div>
                    <div class="col-12">
                        <label class="ops-form-label" asp-for="Notes">@L["BranchReceipt.Create.ReceiptNotes"]</label>
                        <textarea class="ops-textarea" asp-for="Notes" maxlength="1000" placeholder="@L["BranchReceipt.Create.NotesPlaceholder"]"></textarea>
                    </div>
                </div>
            </div>
        </section>

        <section class="ops-panel">
            <div class="ops-panel-header">
                <div><h2 class="ops-panel-title">@L["BranchReceipt.Create.LinesTitle"]</h2><div class="ops-secondary">@L["BranchReceipt.Create.LinesHelp"]</div></div>
            </div>
            <div class="ops-panel-body">
                @for (var i = 0; i < Model.Lines.Count; i++)
                {
                    <div class="ops-line-editor mb-3">
                        <div class="ops-eyebrow mb-2">@L["BranchReceipt.Create.LineNumber", i + 1]</div>
                        <div class="row g-3">
                            <div class="col-lg-3 col-md-6">
                                <label class="ops-form-label">@L["BranchReceipt.Create.RestockRequired"] <span class="text-danger">*</span></label>
                                <input class="ops-input w-100" asp-for="Lines[i].RestockRequestId" type="number" min="1" required />
                                <input asp-for="Lines[i].PurchaseOrderLineId" type="hidden" />
                            </div>
                            <div class="col-lg-2 col-md-6">
                                <label class="ops-form-label">@L["BranchReceipt.Create.ActualPackages"] <span class="text-danger">*</span></label>
                                <input class="ops-input w-100 receipt-actual" asp-for="Lines[i].ActualReceivedQuantity" data-line-index="@i" type="number" step="0.001" min="0.001" required />
                                <span asp-validation-for="Lines[i].ActualReceivedQuantity" class="text-danger"></span>
                            </div>
                            <div class="col-lg-2 col-md-6">
                                <label class="ops-form-label">@L["BranchReceipt.Create.RejectedPackages"]</label>
                                <input class="ops-input w-100 receipt-rejected" asp-for="Lines[i].RejectedQuantity" data-line-index="@i" type="number" step="0.001" min="0" />
                                <span asp-validation-for="Lines[i].RejectedQuantity" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="ops-form-label">@L["BranchReceipt.Create.IssueType"]</label>
                                <select class="ops-select w-100 receipt-rejection-type" asp-for="Lines[i].RejectionIssueType" data-line-index="@i">
                                    <option value="">@L["BranchReceipt.Create.NoRejection"]</option>
                                    <option value="QUALITY_FAILURE">@L["BranchReceipt.Create.Issue.Quality"]</option>
                                    <option value="DAMAGED">@L["BranchReceipt.Create.Issue.Damaged"]</option>
                                    <option value="EXPIRED">@L["BranchReceipt.Create.Issue.Expired"]</option>
                                    <option value="WRONG_ITEM">@L["BranchReceipt.Create.Issue.WrongItem"]</option>
                                    <option value="OTHER">@L["BranchReceipt.Create.Issue.Other"]</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="ops-form-label">@L["BranchReceipt.Create.RejectionReason"]</label>
                                <input class="ops-input w-100 receipt-rejection-reason" asp-for="Lines[i].RejectionReason" data-line-index="@i" maxlength="500" />
                                <span asp-validation-for="Lines[i].RejectionReason" class="text-danger"></span>
                            </div>
                            <div class="col-lg-5 col-md-12">
                                <label class="ops-form-label">@L["BranchReceipt.Create.Offer"] <span class="text-danger">*</span></label>
                                <select class="ops-select w-100 receipt-offer"
                                        asp-for="Lines[i].IngredientSupplierId"
                                        data-line-index="@i"
                                        data-current-offer="@Model.Lines[i].IngredientSupplierId"
                                        required>
                                    <option value="">@L["BranchReceipt.Create.OfferPlaceholder"]</option>
                                </select>
                                <div class="ops-help offer-summary" data-line-index="@i">@L["BranchReceipt.Create.OfferHelp"]</div>
                                <input asp-for="Lines[i].InputUnitId" type="hidden" />
                                <input asp-for="Lines[i].ActualPackagePrice" type="hidden" />
                                <input asp-for="Lines[i].PackageQuantity" type="hidden" />
                                <input asp-for="Lines[i].PackageUnitId" type="hidden" />
                                <input asp-for="Lines[i].SupplierId" type="hidden" />
                            </div>
                        </div>
                    </div>
                }
                <div class="ops-notice ops-notice-info mb-0"><strong>@L["BranchReceipt.Create.ControlTitle"]</strong> @L["BranchReceipt.Create.ControlCopy"]</div>
            </div>
        </section>

        <div class="ops-actions justify-content-end">
            <a class="ops-btn" asp-action="Index" asp-route-storeId="@Model.StoreId">@L["Common.Cancel"]</a>
            <button type="submit" class="ops-btn ops-btn-primary" id="saveReceiptButton"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> @L["BranchReceipt.Create.SaveDraft"]</button>
        </div>
    </form>
</main>

<script>
    (() => {
        const storeId = @Model.StoreId;
        const supplier = document.getElementById('receiptSupplier');
        const form = document.getElementById('branchReceiptForm');
        const saveButton = document.getElementById('saveReceiptButton');
        const money = new Intl.NumberFormat('vi-VN');
        const msg = {
            rejectedExceeds: @Html.Raw(J("BranchReceipt.Create.Js.RejectedExceeds")),
            selectIssue: @Html.Raw(J("BranchReceipt.Create.Js.SelectIssue")),
            enterReason: @Html.Raw(J("BranchReceipt.Create.Js.EnterReason")),
            saving: @Html.Raw(J("BranchReceipt.Create.Js.Saving")),
            selectOffer: @Html.Raw(J("BranchReceipt.Create.Js.SelectOffer")),
            loadingOffers: @Html.Raw(J("BranchReceipt.Create.Js.LoadingOffers")),
            offerPlaceholder: @Html.Raw(J("BranchReceipt.Create.OfferPlaceholder")),
            loadFailed: @Html.Raw(J("BranchReceipt.Create.Js.LoadFailed")),
            chooseOffer: @Html.Raw(J("BranchReceipt.Create.Js.ChooseOffer")),
            noOffers: @Html.Raw(J("BranchReceipt.Create.Js.NoOffers")),
            offerSummary: @Html.Raw(J("BranchReceipt.Create.Js.OfferSummary"))
        };

        const validateReceiptLine = (index) => {
            const actual = document.querySelector(`.receipt-actual[data-line-index="${index}"]`);
            const rejected = document.querySelector(`.receipt-rejected[data-line-index="${index}"]`);
            const issueType = document.querySelector(`.receipt-rejection-type[data-line-index="${index}"]`);
            const reason = document.querySelector(`.receipt-rejection-reason[data-line-index="${index}"]`);
            const actualValue = Number(actual?.value || 0);
            const rejectedValue = Number(rejected?.value || 0);

            rejected?.setCustomValidity(rejectedValue > actualValue ? msg.rejectedExceeds : '');
            issueType?.setCustomValidity(rejectedValue > 0 && !issueType.value ? msg.selectIssue : '');
            reason?.setCustomValidity(rejectedValue > 0 && !reason.value.trim() ? msg.enterReason : '');
        };

        const lineIndexes = [...document.querySelectorAll('.receipt-actual')]
            .map(input => input.dataset.lineIndex);
        for (const index of lineIndexes) {
            for (const selector of ['.receipt-actual', '.receipt-rejected', '.receipt-rejection-type', '.receipt-rejection-reason']) {
                document.querySelector(`${selector}[data-line-index="${index}"]`)
                    ?.addEventListener('input', () => validateReceiptLine(index));
                document.querySelector(`${selector}[data-line-index="${index}"]`)
                    ?.addEventListener('change', () => validateReceiptLine(index));
            }
            validateReceiptLine(index);
        }

        form?.addEventListener('submit', (event) => {
            lineIndexes.forEach(validateReceiptLine);
            if (!form.checkValidity()) {
                event.preventDefault();
                form.querySelector(':invalid')?.focus();
                form.reportValidity();
                return;
            }

            saveButton.disabled = true;
            saveButton.setAttribute('aria-busy', 'true');
            saveButton.textContent = msg.saving;
        });

        const updateOfferFields = (select) => {
            const index = select.dataset.lineIndex;
            const option = select.selectedOptions[0];
            const summary = document.querySelector(`.offer-summary[data-line-index="${index}"]`);
            const setValue = (name, value) => {
                const field = document.querySelector(`[name="Lines[${index}].${name}"]`);
                if (field) field.value = value ?? '';
            };

            if (!option?.dataset.offerId) {
                summary.textContent = msg.selectOffer;
                ['InputUnitId', 'ActualPackagePrice', 'PackageQuantity', 'PackageUnitId', 'SupplierId']
                    .forEach(name => setValue(name, ''));
                return;
            }

            setValue('InputUnitId', option.dataset.unitId);
            setValue('PackageUnitId', option.dataset.unitId);
            setValue('PackageQuantity', option.dataset.packageQuantity);
            setValue('ActualPackagePrice', option.dataset.packagePrice);
            setValue('SupplierId', supplier.value);
            summary.textContent = msg.offerSummary
                .replace('{0}', option.dataset.packageDisplay)
                .replace('{1}', money.format(Number(option.dataset.packagePrice)))
                .replace('{2}', option.dataset.moq);
        };

        const loadOffers = async (select) => {
            const index = select.dataset.lineIndex;
            const requestInput = document.querySelector(`[name="Lines[${index}].RestockRequestId"]`);
            const supplierId = supplier.value;
            const requestId = requestInput?.value;
            select.innerHTML = `<option value="">${msg.loadingOffers}</option>`;
            select.disabled = true;

            if (!supplierId || !requestId) {
                select.innerHTML = `<option value="">${msg.offerPlaceholder}</option>`;
                select.disabled = false;
                updateOfferFields(select);
                return;
            }

            try {
                const url = `@Url.Action("OfferOptions", "AdminBranchReceipts", new { area = "Admin" })?storeId=${storeId}&supplierId=${supplierId}&restockRequestId=${requestId}`;
                const response = await fetch(url, { headers: { 'Accept': 'application/json' } });
                const payload = await response.json();
                if (!response.ok || !payload.success) throw new Error(payload.message || msg.loadFailed);

                select.innerHTML = `<option value="">${msg.chooseOffer}</option>`;
                for (const offer of payload.data ?? []) {
                    const option = document.createElement('option');
                    option.value = offer.ingredientSupplierId;
                    option.textContent = `${offer.ingredientName} · ${offer.packageDisplay} · ${money.format(offer.packagePrice)} ₫`;
                    option.dataset.offerId = offer.ingredientSupplierId;
                    option.dataset.unitId = offer.packageUnitId;
                    option.dataset.packageQuantity = offer.packageQuantity;
                    option.dataset.packagePrice = offer.packagePrice;
                    option.dataset.packageDisplay = offer.packageDisplay;
                    option.dataset.moq = offer.minimumOrderPackageCount || 0;
                    select.appendChild(option);
                }
                if ((payload.data ?? []).length === 0) {
                    select.innerHTML = `<option value="">${msg.noOffers}</option>`;
                } else if (select.dataset.currentOffer) {
                    select.value = select.dataset.currentOffer;
                }
            } catch (error) {
                select.innerHTML = `<option value="">${error.message}</option>`;
            } finally {
                select.disabled = false;
                updateOfferFields(select);
            }
        };

        const offerSelects = [...document.querySelectorAll('.receipt-offer')];
        supplier?.addEventListener('change', () => offerSelects.forEach(loadOffers));
        for (const select of offerSelects) {
            const index = select.dataset.lineIndex;
            document.querySelector(`[name="Lines[${index}].RestockRequestId"]`)
                ?.addEventListener('change', () => loadOffers(select));
            select.addEventListener('change', () => updateOfferFields(select));
            if (supplier?.value) loadOffers(select);
        }
    })();
</script>
