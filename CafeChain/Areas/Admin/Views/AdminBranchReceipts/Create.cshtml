@model CafeChain.Application.DTOs.Admin.RestockRequests.CreateBranchReceiptRequest
@using CafeChain.Application.DTOs.Admin.RestockRequests
@{
    ViewData["Title"] = "Tạo phiếu nhận hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var supplierOptions = ViewBag.SupplierOptions as IReadOnlyList<BranchReceiptSupplierOptionDto>
        ?? Array.Empty<BranchReceiptSupplierOptionDto>();
}

<link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />

<main class="ops-shell" style="max-width:1100px">
    <header class="ops-header">
        <div>
            <div class="ops-eyebrow">Phiếu nhận mới · Cửa hàng #@Model.StoreId</div>
            <h1 class="ops-title">Ghi nhận hàng thực nhận</h1>
            <p class="ops-subtitle">Lưu bản nháp để kiểm tra số lượng và chi phí. Tồn kho chỉ thay đổi sau bước xác nhận riêng.</p>
        </div>
        <div class="ops-actions">
            <a class="ops-btn" asp-action="Index" asp-route-storeId="@Model.StoreId"><i class="fa-solid fa-xmark" aria-hidden="true"></i> Hủy</a>
        </div>
    </header>

    @if (TempData["ErrorMessage"] != null) { <div class="ops-notice ops-notice-error" role="alert">@TempData["ErrorMessage"]</div> }
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="ops-notice ops-notice-error" role="alert"></div>
    }

    <form method="post" asp-action="Create">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="StoreId" />

        <section class="ops-panel">
            <div class="ops-panel-header"><h2 class="ops-panel-title">Thông tin chứng từ</h2></div>
            <div class="ops-panel-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="ops-form-label" asp-for="ReceiptKey">Khóa chống ghi trùng <span class="text-danger">*</span></label>
                        <input class="ops-input w-100" asp-for="ReceiptKey" required maxlength="100" readonly />
                        <div class="ops-help">Khóa hệ thống dùng để nhận diện thao tác gửi lại; không chỉnh sửa.</div>
                    </div>
                    <div class="col-md-3">
                        <label class="ops-form-label" asp-for="SupplierId">Nhà cung cấp</label>
                        <select class="ops-select w-100" asp-for="SupplierId" id="receiptSupplier" required>
                            <option value="">Chọn nhà cung cấp</option>
                            @foreach (var supplier in supplierOptions)
                            {
                                <option value="@supplier.SupplierId">@supplier.SupplierCode · @supplier.SupplierName</option>
                            }
                        </select>
                        <div class="ops-help">Chỉ hiển thị nhà cung cấp đang được gán cho cửa hàng.</div>
                    </div>
                    <div class="col-md-3">
                        <label class="ops-form-label" asp-for="ReferenceNumber">Số tham chiếu</label>
                        <input class="ops-input w-100" asp-for="ReferenceNumber" maxlength="100" placeholder="Hóa đơn / vận đơn" />
                    </div>
                    <div class="col-12">
                        <label class="ops-form-label" asp-for="Notes">Ghi chú nhận hàng</label>
                        <textarea class="ops-textarea" asp-for="Notes" maxlength="1000" placeholder="Sai lệch bao bì, tình trạng hàng hoặc thông tin cần đối chiếu..."></textarea>
                    </div>
                </div>
            </div>
        </section>

        <section class="ops-panel">
            <div class="ops-panel-header">
                <div><h2 class="ops-panel-title">Các dòng nhận</h2><div class="ops-secondary">Nhập đúng số lượng thực tế và giá gói đã xác nhận.</div></div>
            </div>
            <div class="ops-panel-body">
                @for (var i = 0; i < Model.Lines.Count; i++)
                {
                    <div class="ops-line-editor mb-3">
                        <div class="ops-eyebrow mb-2">Dòng @(i + 1)</div>
                        <div class="row g-3">
                            <div class="col-lg-3 col-md-6">
                                <label class="ops-form-label">Yêu cầu nhập <span class="text-danger">*</span></label>
                                <input class="ops-input w-100" asp-for="Lines[i].RestockRequestId" type="number" min="1" required />
                                <input asp-for="Lines[i].PurchaseOrderLineId" type="hidden" />
                            </div>
                            <div class="col-lg-2 col-md-6">
                                <label class="ops-form-label">Số gói thực nhận <span class="text-danger">*</span></label>
                                <input class="ops-input w-100" asp-for="Lines[i].InputQuantity" type="number" step="0.001" min="0.001" required />
                            </div>
                            <div class="col-lg-2 col-md-6">
                                <label class="ops-form-label">Lượng loại bỏ (base)</label>
                                <input class="ops-input w-100" asp-for="Lines[i].RejectedBaseQuantity" type="number" step="0.001" min="0" />
                            </div>
                            <div class="col-lg-5 col-md-12">
                                <label class="ops-form-label">Gói mua nguyên liệu <span class="text-danger">*</span></label>
                                <select class="ops-select w-100 receipt-offer"
                                        asp-for="Lines[i].IngredientSupplierId"
                                        data-line-index="@i"
                                        data-current-offer="@Model.Lines[i].IngredientSupplierId"
                                        required>
                                    <option value="">Nhập mã yêu cầu và chọn nhà cung cấp trước</option>
                                </select>
                                <div class="ops-help offer-summary" data-line-index="@i">Giá và quy cách được lấy từ offer hiện hành rồi lưu snapshot trên phiếu.</div>
                                <input asp-for="Lines[i].InputUnitId" type="hidden" />
                                <input asp-for="Lines[i].ActualPackagePrice" type="hidden" />
                                <input asp-for="Lines[i].PackageQuantity" type="hidden" />
                                <input asp-for="Lines[i].PackageUnitId" type="hidden" />
                                <input asp-for="Lines[i].SupplierId" type="hidden" />
                            </div>
                        </div>
                    </div>
                }
                <div class="ops-notice ops-notice-info mb-0"><strong>Kiểm soát dữ liệu:</strong> hệ thống nhân số gói × lượng trong gói, quy đổi về đơn vị tồn kho và lưu giá gói làm snapshot. Tổng nhận không được vượt yêu cầu còn lại.</div>
            </div>
        </section>

        <div class="ops-actions justify-content-end">
            <a class="ops-btn" asp-action="Index" asp-route-storeId="@Model.StoreId">Hủy</a>
            <button type="submit" class="ops-btn ops-btn-primary"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Lưu bản nháp</button>
        </div>
    </form>
</main>

<script>
    (() => {
        const storeId = @Model.StoreId;
        const supplier = document.getElementById('receiptSupplier');
        const money = new Intl.NumberFormat('vi-VN');

        const updateOfferFields = (select) => {
            const index = select.dataset.lineIndex;
            const option = select.selectedOptions[0];
            const summary = document.querySelector(`.offer-summary[data-line-index="${index}"]`);
            const setValue = (name, value) => {
                const field = document.querySelector(`[name="Lines[${index}].${name}"]`);
                if (field) field.value = value ?? '';
            };

            if (!option?.dataset.offerId) {
                summary.textContent = 'Chọn một gói mua hợp lệ để hệ thống chụp giá và quy cách.';
                ['InputUnitId', 'ActualPackagePrice', 'PackageQuantity', 'PackageUnitId', 'SupplierId']
                    .forEach(name => setValue(name, ''));
                return;
            }

            setValue('InputUnitId', option.dataset.unitId);
            setValue('PackageUnitId', option.dataset.unitId);
            setValue('PackageQuantity', option.dataset.packageQuantity);
            setValue('ActualPackagePrice', option.dataset.packagePrice);
            setValue('SupplierId', supplier.value);
            summary.textContent = `${option.dataset.packageDisplay} · ${money.format(Number(option.dataset.packagePrice))} đ/gói · MOQ ${option.dataset.moq} gói`;
        };

        const loadOffers = async (select) => {
            const index = select.dataset.lineIndex;
            const requestInput = document.querySelector(`[name="Lines[${index}].RestockRequestId"]`);
            const supplierId = supplier.value;
            const requestId = requestInput?.value;
            select.innerHTML = '<option value="">Đang tải gói mua...</option>';
            select.disabled = true;

            if (!supplierId || !requestId) {
                select.innerHTML = '<option value="">Nhập mã yêu cầu và chọn nhà cung cấp trước</option>';
                select.disabled = false;
                updateOfferFields(select);
                return;
            }

            try {
                const url = `@Url.Action("OfferOptions", "AdminBranchReceipts", new { area = "Admin" })?storeId=${storeId}&supplierId=${supplierId}&restockRequestId=${requestId}`;
                const response = await fetch(url, { headers: { 'Accept': 'application/json' } });
                const payload = await response.json();
                if (!response.ok || !payload.success) throw new Error(payload.message || 'Không tải được gói mua.');

                select.innerHTML = '<option value="">Chọn gói mua</option>';
                for (const offer of payload.data ?? []) {
                    const option = document.createElement('option');
                    option.value = offer.ingredientSupplierId;
                    option.textContent = `${offer.ingredientName} · ${offer.packageDisplay} · ${money.format(offer.packagePrice)} đ`;
                    option.dataset.offerId = offer.ingredientSupplierId;
                    option.dataset.unitId = offer.packageUnitId;
                    option.dataset.packageQuantity = offer.packageQuantity;
                    option.dataset.packagePrice = offer.packagePrice;
                    option.dataset.packageDisplay = offer.packageDisplay;
                    option.dataset.moq = offer.minimumOrderPackageCount || 0;
                    select.appendChild(option);
                }
                if ((payload.data ?? []).length === 0) {
                    select.innerHTML = '<option value="">Không có gói mua active cho nguyên liệu này</option>';
                } else if (select.dataset.currentOffer) {
                    select.value = select.dataset.currentOffer;
                }
            } catch (error) {
                select.innerHTML = `<option value="">${error.message}</option>`;
            } finally {
                select.disabled = false;
                updateOfferFields(select);
            }
        };

        const offerSelects = [...document.querySelectorAll('.receipt-offer')];
        supplier?.addEventListener('change', () => offerSelects.forEach(loadOffers));
        for (const select of offerSelects) {
            const index = select.dataset.lineIndex;
            document.querySelector(`[name="Lines[${index}].RestockRequestId"]`)
                ?.addEventListener('change', () => loadOffers(select));
            select.addEventListener('change', () => updateOfferFields(select));
            if (supplier?.value) loadOffers(select);
        }
    })();
</script>
