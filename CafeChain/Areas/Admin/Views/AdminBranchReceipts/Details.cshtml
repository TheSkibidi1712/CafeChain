@model CafeChain.Application.DTOs.Admin.RestockRequests.BranchReceiptDetailDto
@using CafeChain.ViewModels.Admin.Shared
@{
    ViewData["Title"] = "Chi tiết phiếu nhận";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var canConfirm = ViewBag.CanConfirm as bool? ?? false;
    var isConfirmed = Model.Status == "CONFIRMED";
}

<link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />

<main class="ops-shell">
    <header class="ops-header">
        <div>
            <div class="ops-eyebrow">Phiếu nhận #@Model.BranchReceiptId · Chi nhánh #@Model.StoreId</div>
            <h1 class="ops-title">@Model.ReceiptCode</h1>
            <p class="ops-subtitle">Nhận lúc @AdminStatusDisplay.DateTime(Model.ReceivedAt.ToLocalTime())</p>
        </div>
        <div class="ops-actions">
            @if (Model.PurchaseOrderId.HasValue)
            {
                <a class="ops-btn" asp-area="Admin" asp-controller="AdminPurchaseOrders" asp-action="Details" asp-route-id="@Model.PurchaseOrderId"><i class="fa-solid fa-file-invoice" aria-hidden="true"></i> Xem đơn đặt hàng</a>
            }
            <a class="ops-btn" asp-action="Index" asp-route-storeId="@Model.StoreId"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Danh sách</a>
            @if (canConfirm)
            {
                <form method="post" asp-action="Confirm" asp-route-id="@Model.BranchReceiptId" onsubmit="return confirm('Xác nhận nhập kho? Thao tác không thể hoàn tác.');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                    <button type="submit" class="ops-btn ops-btn-primary"><i class="fa-solid fa-check" aria-hidden="true"></i> Xác nhận nhập kho</button>
                </form>
            }
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null) { <div class="ops-notice ops-notice-success" role="status">@TempData["SuccessMessage"]</div> }
    @if (TempData["WarningMessage"] != null) { <div class="ops-notice ops-notice-warning" role="status">@TempData["WarningMessage"]</div> }
    @if (TempData["ErrorMessage"] != null) { <div class="ops-notice ops-notice-error" role="alert">@TempData["ErrorMessage"]</div> }

    <section class="ops-metrics" aria-label="Tóm tắt phiếu nhận">
        <div class="ops-metric"><span class="ops-metric-label">Trạng thái</span><strong class="ops-metric-value fs-5"><span class="ops-badge @(isConfirmed ? "ops-badge-success" : "ops-badge-neutral")">@(isConfirmed ? "Đã xác nhận" : "Bản nháp")</span></strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Số dòng</span><strong class="ops-metric-value">@Model.LineCount</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Số lượng quy đổi</span><strong class="ops-metric-value">@AdminStatusDisplay.Quantity(Model.TotalBaseQuantity)</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">Tổng giá trị</span><strong class="ops-metric-value">@AdminStatusDisplay.Currency(Model.TotalLineCost)</strong></div>
    </section>

    <div class="ops-detail-grid">
        <section class="ops-panel">
            <div class="ops-panel-header"><h2 class="ops-panel-title">Các dòng hàng thực nhận</h2></div>
            <div class="ops-table-scroll">
<table class="ops-table ops-table-min-900">
                    <thead><tr><th>Nguồn yêu cầu nhập</th><th>Mặt hàng</th><th class="number">Số lượng thực giao</th><th class="number">Số lượng chấp nhận</th><th class="number">Số lượng từ chối</th><th class="number">Giá vốn cơ sở</th><th class="number">Thành tiền</th><th>Giao dịch kho</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        var identity = line.IngredientId.HasValue ? $"Nguyên liệu #{line.IngredientId}" : line.PreparedItemId.HasValue ? $"Bán thành phẩm #{line.PreparedItemId}" : $"Công thức cũ #{line.RecipeId}";
                        <tr>
                            <td>
                                @if (line.RestockRequestId.HasValue)
                                {
                                    <a asp-area="Admin" asp-controller="AdminRestockRequests" asp-action="Details" asp-route-id="@line.RestockRequestId" asp-route-storeId="@Model.StoreId">#@line.RestockRequestId</a>
                                }
                                else
                                {
                                    <span class="ops-secondary">Mua chủ động theo đơn đặt hàng</span>
                                }
                            </td>
                            <td><strong>@identity</strong><div class="ops-secondary">Dòng #@line.BranchReceiptLineId</div></td>
                            <td class="number">@AdminStatusDisplay.Quantity(line.InputQuantity) @(line.InputUnitName ?? $"u{line.InputUnitId}")</td>
                            <td class="number">@AdminStatusDisplay.Quantity(line.ReceivedBaseQuantity) @(line.BaseUnitName ?? $"u{line.BaseUnitId}")</td>
                            <td class="number">@AdminStatusDisplay.Quantity(line.RejectedBaseQuantity)</td>
                            <td class="number">@AdminStatusDisplay.Currency(line.BaseUnitCostSnapshot)</td>
                            <td class="number fw-bold">@AdminStatusDisplay.Currency(line.LineTotalCost)</td>
                            <td>@(line.InventoryTransactionId.HasValue ? $"#{line.InventoryTransactionId}" : "Chưa ghi kho")</td>
                            <td>@if(isConfirmed && line.PurchaseOrderLineId.HasValue){<a class="ops-btn" asp-area="Admin" asp-controller="AdminSupplierQuality" asp-action="Create" asp-route-branchReceiptLineId="@line.BranchReceiptLineId">Ghi sự cố</a>}</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>

        <aside>
            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">Thông tin chứng từ</h2></div>
                <div class="ops-panel-body">
                    <div class="ops-data-grid">
                        <div><span class="ops-data-label">Nhà cung cấp</span><span class="ops-data-value">@(Model.SupplierName ?? (Model.SupplierId.HasValue ? $"#{Model.SupplierId}" : "Chưa gắn"))</span></div>
                        <div><span class="ops-data-label">Số tham chiếu</span><span class="ops-data-value">@(Model.ReferenceNumber ?? "—")</span></div>
                        <div><span class="ops-data-label">Người tạo</span><span class="ops-data-value">Nhân viên #@Model.CreatedByStaffId</span></div>
                        <div><span class="ops-data-label">Người nhận</span><span class="ops-data-value">@(Model.ReceivedByStaffId.HasValue ? $"Nhân viên #{Model.ReceivedByStaffId}" : "—")</span></div>
                        <div><span class="ops-data-label">Người xác nhận</span><span class="ops-data-value">@(Model.ConfirmedByStaffId.HasValue ? $"Nhân viên #{Model.ConfirmedByStaffId}" : "—")</span></div>
                        <div><span class="ops-data-label">Xác nhận lúc</span><span class="ops-data-value">@(Model.ConfirmedAt.HasValue ? AdminStatusDisplay.DateTime(Model.ConfirmedAt.Value.ToLocalTime()) : "—")</span></div>
                    </div>
<div class="mt-3"><span class="ops-data-label">Ghi chú</span><div class="ops-notice ops-pre-wrap mt-1 mb-0">@(Model.Notes ?? "Không có ghi chú")</div></div>
                </div>
            </section>

            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">Tác động tồn kho</h2></div>
                <div class="ops-panel-body">
                    @if (isConfirmed)
                    {
                        <div class="ops-notice ops-notice-success mb-0"><strong>Đã ghi nhận tồn kho.</strong><br />Mỗi dòng đã tạo giao dịch nhập và lớp giá vốn tương ứng.</div>
                    }
                    else
                    {
                        <div class="ops-notice ops-notice-warning mb-0"><strong>Chưa thay đổi tồn kho.</strong><br />Phiếu đang là bản nháp; số lượng và giá vốn mới chỉ được lưu để kiểm tra.</div>
                    }
                </div>
            </section>
        </aside>
    </div>
</main>
