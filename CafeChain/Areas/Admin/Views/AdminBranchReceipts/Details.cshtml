@model CafeChain.Application.DTOs.Admin.RestockRequests.BranchReceiptDetailDto
@using CafeChain.ViewModels.Admin.Shared
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ProcurementResource> L
@{
    ViewData["Title"] = L["BranchReceipt.Details.Title"];
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var canConfirm = ViewBag.CanConfirm as bool? ?? false;
    var isConfirmed = Model.Status == "CONFIRMED";
}

<link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" />
<style>
    /* Remove vertical brown accent border on the left of document info */
    .branch-receipt-detail-page .ops-data-grid {
        border-left: 0 !important;
    }
</style>

<main class="ops-shell branch-receipt-page branch-receipt-detail-page cc-warehouse-page">
<header class="ops-header cc-warehouse-header cc-warehouse-header--compact cc-warehouse-header--detail">
        <div>
            <div class="ops-eyebrow">@L["BranchReceipt.Details.Eyebrow", Model.BranchReceiptId, Model.StoreId]</div>
            <h1 class="ops-title">@Model.ReceiptCode</h1>
            <p class="ops-subtitle">@L["BranchReceipt.Details.ReceivedAt", AdminStatusDisplay.DateTime(Model.ReceivedAt.ToLocalTime())]</p>
        </div>
        <div class="ops-actions">
            @if (Model.PurchaseOrderId.HasValue)
            {
                <a class="ops-btn" asp-area="Admin" asp-controller="AdminPurchaseOrders" asp-action="Details" asp-route-id="@Model.PurchaseOrderId"><i class="fa-solid fa-file-invoice" aria-hidden="true"></i> @L["BranchReceipt.Details.ViewPurchaseOrder"]</a>
            }
            <a class="ops-btn" asp-action="Index" asp-route-storeId="@Model.StoreId"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> @L["Common.List"]</a>
            @if (canConfirm)
            {
                <form method="post" asp-action="Confirm" asp-route-id="@Model.BranchReceiptId" onsubmit="return confirm('@L["BranchReceipt.Details.ConfirmPrompt"]');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                    <button type="submit" class="ops-btn ops-btn-primary"><i class="fa-solid fa-check" aria-hidden="true"></i> @L["BranchReceipt.Details.ConfirmStock"]</button>
                </form>
            }
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null) { <div class="ops-notice ops-notice-success" role="status">@TempData["SuccessMessage"]</div> }
    @if (TempData["WarningMessage"] != null) { <div class="ops-notice ops-notice-warning" role="status">@TempData["WarningMessage"]</div> }
    @if (TempData["ErrorMessage"] != null) { <div class="ops-notice ops-notice-error" role="alert">@TempData["ErrorMessage"]</div> }

    <section class="ops-metrics" aria-label="@L["BranchReceipt.Details.SummaryAria"]">
        <div class="ops-metric"><span class="ops-metric-label">@L["Common.Status"]</span><strong class="ops-metric-value fs-5"><span class="ops-badge @(isConfirmed ? "ops-badge-success" : "ops-badge-neutral")">@(isConfirmed ? L["BranchReceipt.Confirmed"] : L["BranchReceipt.Draft"])</span></strong></div>
        <div class="ops-metric"><span class="ops-metric-label">@L["BranchReceipt.LineCount"]</span><strong class="ops-metric-value">@Model.LineCount</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">@L["BranchReceipt.ConvertedQuantity"]</span><strong class="ops-metric-value">@AdminStatusDisplay.Quantity(Model.TotalBaseQuantity)</strong></div>
        <div class="ops-metric"><span class="ops-metric-label">@L["BranchReceipt.Details.TotalValue"]</span><strong class="ops-metric-value">@AdminStatusDisplay.Currency(Model.TotalLineCost)</strong></div>
    </section>

    <div class="ops-detail-grid">
        <section class="ops-panel">
            <div class="ops-panel-header"><h2 class="ops-panel-title">@L["BranchReceipt.Details.LinesTitle"]</h2></div>
            <div class="ops-table-scroll cc-warehouse-table-shell">
<table class="ops-table ops-table-min-900">
                    <thead><tr><th>@L["BranchReceipt.Details.RestockSource"]</th><th>@L["BranchReceipt.Details.Item"]</th><th class="number">@L["BranchReceipt.Details.ActualQty"]</th><th class="number">@L["BranchReceipt.Details.AcceptedQty"]</th><th class="number">@L["BranchReceipt.Details.RejectedQty"]</th><th class="number">@L["BranchReceipt.Details.BaseCost"]</th><th class="number">@L["BranchReceipt.Details.LineTotal"]</th><th>@L["BranchReceipt.Details.InventoryTxn"]</th><th class="text-center">@L["Common.Actions"]</th></tr></thead>
                    <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        var identity = line.IngredientId.HasValue ? L["BranchReceipt.Details.Ingredient", line.IngredientId].Value : line.PreparedItemId.HasValue ? L["BranchReceipt.Details.PreparedItem", line.PreparedItemId].Value : L["BranchReceipt.Details.LegacyRecipe", line.RecipeId].Value;
                        <tr>
                            <td>
                                @if (line.RestockRequestId.HasValue)
                                {
                                    <a asp-area="Admin" asp-controller="AdminRestockRequests" asp-action="Details" asp-route-id="@line.RestockRequestId" asp-route-storeId="@Model.StoreId">@AdminStatusDisplay.RestockReference(line.RestockReferenceCode, line.RestockRequestId.Value)</a>
                                }
                                else
                                {
                                    <span class="ops-secondary">@L["BranchReceipt.Details.DirectPurchase"]</span>
                                }
                            </td>
                            <td><strong>@identity</strong><div class="ops-secondary">@L["BranchReceipt.Details.LineNumber", line.BranchReceiptLineId]</div></td>
                            <td class="number">@AdminStatusDisplay.Quantity(line.InputQuantity) @AdminStatusDisplay.Unit(line.InputUnitName ?? $"u{line.InputUnitId}")</td>
                            <td class="number">@AdminStatusDisplay.Quantity(line.ReceivedBaseQuantity) @AdminStatusDisplay.Unit(line.BaseUnitName ?? $"u{line.BaseUnitId}")</td>
                            <td class="number">@AdminStatusDisplay.Quantity(line.RejectedBaseQuantity) @AdminStatusDisplay.Unit(line.BaseUnitName ?? $"u{line.BaseUnitId}")</td>
                            <td class="number">@AdminStatusDisplay.Currency(line.BaseUnitCostSnapshot)</td>
                            <td class="number fw-bold">@AdminStatusDisplay.Currency(line.LineTotalCost)</td>
                            <td>@(line.InventoryTransactionId.HasValue ? $"#{line.InventoryTransactionId}" : L["BranchReceipt.Details.NotPosted"].Value)</td>
                            <td class="text-center">@if(isConfirmed && line.PurchaseOrderLineId.HasValue){<a class="ops-btn" asp-area="Admin" asp-controller="AdminSupplierQuality" asp-action="Create" asp-route-branchReceiptLineId="@line.BranchReceiptLineId">@L["BranchReceipt.Details.LogIssue"]</a>}</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>

        <aside>
            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">@L["BranchReceipt.Details.DocumentInfo"]</h2></div>
                <div class="ops-panel-body">
                    <div class="ops-data-grid">
                        <div><span class="ops-data-label">@L["Common.Supplier"]</span><span class="ops-data-value">@(Model.SupplierName ?? (Model.SupplierId.HasValue ? $"#{Model.SupplierId}" : L["BranchReceipt.Details.Unassigned"].Value))</span></div>
                        <div><span class="ops-data-label">@L["BranchReceipt.Details.Reference"]</span><span class="ops-data-value">@(Model.ReferenceNumber ?? L["Common.Dash"].Value)</span></div>
                        <div><span class="ops-data-label">@L["BranchReceipt.Details.CreatedBy"]</span><span class="ops-data-value">@L["Common.StaffNumber", Model.CreatedByStaffId]</span></div>
                        <div><span class="ops-data-label">@L["BranchReceipt.Details.ReceivedBy"]</span><span class="ops-data-value">@(Model.ReceivedByStaffId.HasValue ? L["Common.StaffNumber", Model.ReceivedByStaffId].Value : L["Common.Dash"].Value)</span></div>
                        <div><span class="ops-data-label">@L["BranchReceipt.Details.ConfirmedBy"]</span><span class="ops-data-value">@(Model.ConfirmedByStaffId.HasValue ? L["Common.StaffNumber", Model.ConfirmedByStaffId].Value : L["Common.Dash"].Value)</span></div>
                        <div><span class="ops-data-label">@L["BranchReceipt.Details.ConfirmedAt"]</span><span class="ops-data-value">@(Model.ConfirmedAt.HasValue ? AdminStatusDisplay.DateTime(Model.ConfirmedAt.Value.ToLocalTime()) : L["Common.Dash"].Value)</span></div>
                    </div>
<div class="mt-3"><span class="ops-data-label">@L["Common.Notes"]</span><div class="ops-notice ops-pre-wrap mt-1 mb-0">@(Model.Notes ?? L["BranchReceipt.Details.NoNotes"].Value)</div></div>
                </div>
            </section>

            <section class="ops-panel">
                <div class="ops-panel-header"><h2 class="ops-panel-title">@L["BranchReceipt.Details.InventoryImpact"]</h2></div>
                <div class="ops-panel-body">
                    @if (isConfirmed)
                    {
                        <div class="ops-notice ops-notice-success mb-0"><strong>@L["BranchReceipt.Details.PostedTitle"]</strong><br />@L["BranchReceipt.Details.PostedCopy"]</div>
                    }
                    else
                    {
                        <div class="ops-notice ops-notice-warning mb-0"><strong>@L["BranchReceipt.Details.DraftTitle"]</strong><br />@L["BranchReceipt.Details.DraftCopy"]</div>
                    }
                </div>
            </section>
        </aside>
    </div>
</main>
