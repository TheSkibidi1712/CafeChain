@model CafeChain.ViewModels.Admin.Drinks.AdminDrinkEditViewModel

@{
    ViewData["Title"] = "Chỉnh sửa Nước uống";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4">

    <h1 class="mt-4">Chỉnh sửa Nước uống</h1>

    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item">
            <a asp-area="Admin"
               asp-controller="Home"
               asp-action="Index">
                Dashboard
            </a>
        </li>

        <li class="breadcrumb-item">
            <a asp-area="Admin"
               asp-controller="AdminDrink"
               asp-action="Index">
                Danh sách Nước uống
            </a>
        </li>

        <li class="breadcrumb-item active">
            Chỉnh sửa
        </li>
    </ol>

    <div class="card mb-4 shadow-sm border-0">

        <div class="card-header bg-white">

            <h5 class="mb-0 text-primary">
                <i class="fas fa-edit"></i>
                Thông tin Nước uống
            </h5>

        </div>

        <div class="card-body">

            <form asp-action="Edit"
                  method="post">

                <input type="hidden"
                       asp-for="DrinkUpdateDTO.DrinkId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <div class="col-md-8 mx-auto">

                        <div class="mb-3">

                            <label asp-for="DrinkUpdateDTO.Name"
                                   class="form-label fw-bold">

                                Tên Nước Uống
                                <span class="text-danger">*</span>

                            </label>

                            <input asp-for="DrinkUpdateDTO.Name"
                                   class="form-control"
                                   placeholder="Nhập tên nước uống..." />

                            <span asp-validation-for="DrinkUpdateDTO.Name"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="DrinkUpdateDTO.CategoryId"
                                       class="form-label fw-bold">

                                    Danh Mục
                                    <span class="text-danger">*</span>

                                </label>

                                <select asp-for="DrinkUpdateDTO.CategoryId"
                                        class="form-select"
                                        asp-items="Model.Categories">

                                    <option value="">
                                        -- Chọn Danh Mục --
                                    </option>

                                </select>

                                <span asp-validation-for="DrinkUpdateDTO.CategoryId"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="DrinkUpdateDTO.ProductTypeId"
                                       class="form-label fw-bold">

                                    Loại Sản Phẩm
                                    <span class="text-danger">*</span>

                                </label>

                                <select asp-for="DrinkUpdateDTO.ProductTypeId"
                                        class="form-select"
                                        asp-items="Model.ProductTypes">

                                    <option value="">
                                        -- Chọn Loại Sản Phẩm --
                                    </option>

                                </select>

                                <span asp-validation-for="DrinkUpdateDTO.ProductTypeId"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <div class="mb-3">

                            <label asp-for="DrinkUpdateDTO.Description"
                                   class="form-label fw-bold">

                                Mô tả chi tiết

                            </label>

                            <textarea asp-for="DrinkUpdateDTO.Description"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Mô tả thành phần, hương vị..."></textarea>

                            <span asp-validation-for="DrinkUpdateDTO.Description"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3 form-check form-switch bg-light p-3 rounded">

                            <input class="form-check-input ms-0 me-2"
                                   type="checkbox"
                                   role="switch"
                                   id="activeStatusSwitch"
                                   asp-for="DrinkUpdateDTO.Active">

                            <label class="form-check-label fw-bold text-success"
                                   for="activeStatusSwitch"
                                   id="activeStatusLabel">

                                Trạng thái: Đang bán
                                (Kéo để Đang bán/Ngừng bán)

                            </label>

                        </div>

                    </div>

                </div>

                <div class="d-flex justify-content-center mt-4 border-top pt-3">

                    <a asp-action="Index"
                       class="btn btn-secondary me-2">

                        <i class="fas fa-arrow-left"></i>
                        Quay lại

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fas fa-save"></i>
                        Cập nhật ngay

                    </button>

                </div>

            </form>

        </div>

    </div>
</div>

<!-- Crop Modal For Update Image -->

<div class="modal fade"
     id="cropEditImageModal"
     tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">

                    <i class="fas fa-crop-alt me-2"></i>
                    Cắt ảnh thay thế

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <div class="row">

                    <div class="col-md-8">

                        <div style="max-height:600px;">

                            <img id="cropEditImage"
                                 style="max-width:100%;" />

                        </div>

                    </div>

                    <div class="col-md-4">

                        <h6>Xem trước</h6>

                        <div class="border rounded overflow-hidden"
                             style="width:250px;height:250px;">

                            <div class="preview-edit"></div>

                        </div>

                        <div class="alert alert-info mt-3 mb-0">

                            Tỷ lệ chuẩn:
                            <strong>1 : 1</strong>

                            <br />

                            Kích thước lưu:
                            <strong>1000 x 1000</strong>

                        </div>

                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Hủy

                </button>

                <button type="button"
                        id="btnCropEditImage"
                        class="btn btn-primary">

                    <i class="fas fa-check"></i>
                    Xác nhận cắt

                </button>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>

    <script src="~/js/Admin/Drink/drink.js"></script>
}
