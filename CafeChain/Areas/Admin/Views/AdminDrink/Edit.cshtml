@model CafeChain.ViewModels.Admin.Drinks.AdminDrinkEditViewModel
@using System.Security.Claims
@using CafeChain.Application.Constants
@using CafeChain.Application.Interfaces.Admin.Permissions
@inject IAdminPermissionService PermissionService

@{
    ViewData["Title"] = "Chỉnh sửa Nước uống";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var canUpdateImage = false;
    if (int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var accountId))
    {
        canUpdateImage = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.DrinkUpdateImage)).Data?.Allowed == true;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/Drink/drink.css" asp-append-version="true" />
}

<div class="container-fluid px-0 drink-form-page">
    <div class="drink-form-heading">
        <span class="drink-eyebrow"><i class="fas fa-pen"></i> Cập nhật sản phẩm</span>
        <h1>Chỉnh sửa nước uống</h1>
        <p>Điều chỉnh thông tin và thư viện ảnh để sản phẩm luôn đồng nhất trên menu.</p>
    </div>

    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item active">
            Chỉnh sửa
        </li>
    </ol>

    <div class="row g-4">

        <div class="col-lg-8">

            <form id="drinkEditForm"
                  asp-action="Edit"
                  method="post">

                <input type="hidden"
                       asp-for="DrinkUpdateDTO.DrinkId" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger mb-3"
                     style="display:none">
                </div>

                <div class="card shadow-sm border-0 h-100">

                    <div class="card-header bg-white border-bottom">
                        <h5 class="mb-0 text-primary">
                            <i class="fas fa-edit me-2"></i>
                            Thông tin Nước uống
                        </h5>
                    </div>

                    <div class="card-body">

                        <div class="row g-3 mb-4">

                            <div class="col-md-5">

                                <label asp-for="DrinkUpdateDTO.DrinkCode"
                                       class="form-label fw-semibold">
                                    Mã Nước Uống
                                    <span class="text-danger">*</span>
                                </label>

                                <input asp-for="DrinkUpdateDTO.DrinkCode"
                                       class="form-control form-control-lg"
                                       placeholder="VD: CF_Sua" />

                                <span asp-validation-for="DrinkUpdateDTO.DrinkCode"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-md-7">

                                <label asp-for="DrinkUpdateDTO.Name"
                                       class="form-label fw-semibold">
                                    Tên Nước Uống
                                    <span class="text-danger">*</span>
                                </label>

                                <input asp-for="DrinkUpdateDTO.Name"
                                       class="form-control form-control-lg"
                                       placeholder="Nhập tên nước uống..." />

                                <span asp-validation-for="DrinkUpdateDTO.Name"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                        <div class="row g-3 mb-4">

                            <div class="col-md-6">

                                <label asp-for="DrinkUpdateDTO.CategoryId"
                                       class="form-label fw-semibold">
                                    Danh Mục
                                    <span class="text-danger">*</span>
                                </label>

                                <select asp-for="DrinkUpdateDTO.CategoryId"
                                        class="form-select"
                                        asp-items="Model.Categories">
                                    <option value="">
                                        -- Chọn Danh Mục --
                                    </option>
                                </select>

                                <span asp-validation-for="DrinkUpdateDTO.CategoryId"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="DrinkUpdateDTO.ProductTypeId"
                                       class="form-label fw-semibold">
                                    Loại Sản Phẩm
                                    <span class="text-danger">*</span>
                                </label>

                                <select asp-for="DrinkUpdateDTO.ProductTypeId"
                                        class="form-select"
                                        asp-items="Model.ProductTypes">
                                    <option value="">
                                        -- Chọn Loại Sản Phẩm --
                                    </option>
                                </select>

                                <span asp-validation-for="DrinkUpdateDTO.ProductTypeId"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                        <div class="mb-4">

                            <label asp-for="DrinkUpdateDTO.Description"
                                   class="form-label fw-semibold">
                                Mô tả chi tiết
                            </label>

                            <textarea asp-for="DrinkUpdateDTO.Description"
                                      class="form-control"
                                      rows="6"
                                      placeholder="Mô tả thành phần, hương vị..."></textarea>

                            <span asp-validation-for="DrinkUpdateDTO.Description"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="form-check form-switch bg-light p-3 rounded d-none" aria-hidden="true">

                            <input class="form-check-input ms-0 me-2"
                                   type="checkbox"
                                   role="switch"
                                   id="activeStatusSwitch"
                                   disabled
                                   asp-for="DrinkUpdateDTO.Active" />

                            <label class="form-check-label fw-semibold text-success"
                                   for="activeStatusSwitch"
                                   id="activeStatusLabel">
                                Trạng thái: Đang bán
                            </label>

                        </div>

                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        <i class="fas fa-arrow-left me-1"></i>
                        Quay lại
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">
                        <i class="fas fa-save me-1"></i>
                        Cập nhật Nước Uống
                    </button>

                </div>

            </form>

        </div>

        @if (canUpdateImage)
        {
        <div class="col-lg-4">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0">
                        <i class="fas fa-images me-2"></i>
                        Hình Ảnh Sản Phẩm
                    </h5>
                </div>

                <div class="card-body">

                    <input type="hidden"
                           id="currentDrinkId"
                           value="@Model.DrinkUpdateDTO.DrinkId" />

                    <div class="drink-image-upload-panel mb-4">
                        <div class="drink-image-upload-heading">
                            <span><i class="fas fa-cloud-arrow-up"></i></span>
                            <div>
                                <h6>Thêm ảnh mới</h6>
                                <p>JPG, PNG • Tối đa 5MB • Crop chuẩn 1:1</p>
                            </div>
                        </div>

                        <input type="file"
                               class="form-control drink-image-file-input mb-3"
                               id="uploadImageInput"
                               accept=".jpg,.jpeg,.png" />

                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input"
                                       type="checkbox"
                                       role="switch"
                                       id="uploadDefaultSwitch" />

                                <label class="form-check-label small"
                                       for="uploadDefaultSwitch">
                                    Đặt làm mặc định
                                </label>
                            </div>

                            <button type="button"
                                    class="btn drink-image-upload-btn"
                                    id="btnUploadDrinkImage">
                                <i class="fas fa-upload me-1"></i>
                                Tải ảnh
                            </button>
                        </div>
                    </div>

                    <div class="drink-image-library-heading mb-3">
                        <div>
                            <i class="fas fa-layer-group"></i>
                            <span>Danh Sách Ảnh Đã Tải Lên</span>
                        </div>
                    </div>

                    <div class="row g-2 drink-image-grid"
                         id="imageListContainer">
                        <div class="col-12 text-center text-muted py-3">
                            <i class="fas fa-spinner fa-spin me-1"></i> Đang tải...
                        </div>
                    </div>

                </div>

            </div>

        </div>
        }

    </div>

</div>

@if (canUpdateImage)
{
<!-- Modal Edit Image -->
<div class="modal fade"
     id="editImageModal"
     tabindex="-1"
     aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content drink-modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-warning">
                    <i class="fas fa-pencil-alt"></i>
                    Chỉnh sửa ảnh
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden"
                       id="editImageId"
                       value="" />
                <div class="mb-3 text-center">
                    <p class="text-muted small mb-2">Ảnh hiện tại:</p>
                    <img id="editCurrentPreview"
                         src=""
                         alt="Current Image"
                         style="max-height: 150px; max-width: 100%; object-fit: contain; border-radius: 6px; border: 1px solid #dee2e6;" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Chọn ảnh mới
                        <span class="text-danger">*</span>
                    </label>
                    <input type="file"
                           class="form-control"
                           id="newImageFileInput"
                           accept=".jpg,.jpeg,.png" />
                    <div class="form-text">Chỉ chấp nhận JPG, JPEG, PNG.</div>
                </div>
                <div id="newImagePreviewWrapper"
                     class="text-center mb-2"
                     style="display:none;">
                    <p class="text-muted small mb-1">Xem trước ảnh mới:</p>
                    <img id="newImagePreview"
                         src=""
                         alt="New Image Preview"
                         style="max-height: 150px; max-width: 100%; object-fit: contain; border-radius: 6px; border: 1px dashed #0d6efd;" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary btn-sm"
                        data-bs-dismiss="modal">
                    Hủy
                </button>
                <button type="button"
                        class="btn btn-warning btn-sm"
                        id="btnConfirmEditImage">
                    <i class="fas fa-save"></i>
                    Lưu ảnh mới
                </button>
            </div>
        </div>
    </div>
</div>
}

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/Admin/Drink/drink.js"></script>
}
