@model CafeChain.ViewModels.Admin.Drinks.AdminDrinkEditViewModel
@using System.Security.Claims
@using CafeChain.Application.Constants
@using CafeChain.Application.Interfaces.Admin.Permissions
@inject IAdminPermissionService PermissionService

@{
    ViewData["Title"] = "Chỉnh sửa Nước uống";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var canUpdateImage = false;
    if (int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var accountId))
    {
        canUpdateImage = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.DrinkUpdateImage)).Data?.Allowed == true;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/Drink/drink.css" asp-append-version="true" />
}

<div class="container-fluid px-0 drink-form-page">
    <div class="drink-form-heading">
        <span class="drink-eyebrow"><i class="fas fa-pen"></i> Cập nhật sản phẩm</span>
        <h1>Chỉnh sửa nước uống</h1>
        <p>Điều chỉnh thông tin và thư viện ảnh để sản phẩm luôn đồng nhất trên menu.</p>
    </div>

    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item active">
            Chỉnh sửa
        </li>
    </ol>

    <div class="row g-4">

        <div class="col-lg-8">

            <form id="drinkEditForm"
                  asp-action="Edit"
                  method="post">

                <input type="hidden"
                       asp-for="DrinkUpdateDTO.DrinkId" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger mb-3"
                     style="display:none">
                </div>

                <div class="card shadow-sm border-0 h-100">

                    <div class="card-header bg-white border-bottom">
                        <h5 class="mb-0 text-primary">
                            <i class="fas fa-edit me-2"></i>
                            Thông tin Nước uống
                        </h5>
                    </div>

                    <div class="card-body">

                        <div class="row g-3 mb-4">

                            <div class="col-md-5">

                                <label asp-for="DrinkUpdateDTO.DrinkCode"
                                       class="form-label fw-semibold">
                                    Mã Nước Uống
                                    <span class="text-danger">*</span>
                                </label>

                                <input asp-for="DrinkUpdateDTO.DrinkCode"
                                       class="form-control form-control-lg"
                                       placeholder="VD: CF_Sua" />

                                <span asp-validation-for="DrinkUpdateDTO.DrinkCode"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-md-7">

                                <label asp-for="DrinkUpdateDTO.Name"
                                       class="form-label fw-semibold">
                                    Tên Nước Uống
                                    <span class="text-danger">*</span>
                                </label>

                                <input asp-for="DrinkUpdateDTO.Name"
                                       class="form-control form-control-lg"
                                       placeholder="Nhập tên nước uống..." />

                                <span asp-validation-for="DrinkUpdateDTO.Name"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                        <div class="row g-3 mb-4">

                            <div class="col-md-6">

                                <label asp-for="DrinkUpdateDTO.CategoryId"
                                       class="form-label fw-semibold">
                                    Danh Mục
                                    <span class="text-danger">*</span>
                                </label>

                                <select asp-for="DrinkUpdateDTO.CategoryId"
                                        class="form-select"
                                        asp-items="Model.Categories">
                                    <option value="">
                                        -- Chọn Danh Mục --
                                    </option>
                                </select>

                                <span asp-validation-for="DrinkUpdateDTO.CategoryId"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="DrinkUpdateDTO.ProductTypeId"
                                       class="form-label fw-semibold">
                                    Loại Sản Phẩm
                                    <span class="text-danger">*</span>
                                </label>

                                <select asp-for="DrinkUpdateDTO.ProductTypeId"
                                        class="form-select"
                                        asp-items="Model.ProductTypes">
                                    <option value="">
                                        -- Chọn Loại Sản Phẩm --
                                    </option>
                                </select>

                                <span asp-validation-for="DrinkUpdateDTO.ProductTypeId"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                        <div class="mb-4">

                            <label asp-for="DrinkUpdateDTO.Description"
                                   class="form-label fw-semibold">
                                Mô tả chi tiết
                            </label>

                            <textarea asp-for="DrinkUpdateDTO.Description"
                                      class="form-control"
                                      rows="6"
                                      placeholder="Mô tả thành phần, hương vị..."></textarea>

                            <span asp-validation-for="DrinkUpdateDTO.Description"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="form-check form-switch bg-light p-3 rounded d-none" aria-hidden="true">

                            <input class="form-check-input ms-0 me-2"
                                   type="checkbox"
                                   role="switch"
                                   id="activeStatusSwitch"
                                   disabled
                                   asp-for="DrinkUpdateDTO.Active" />

                            <label class="form-check-label fw-semibold text-success"
                                   for="activeStatusSwitch"
                                   id="activeStatusLabel">
                                Trạng thái: Đang bán
                            </label>

                        </div>

                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        <i class="fas fa-arrow-left me-1"></i>
                        Quay lại
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">
                        <i class="fas fa-save me-1"></i>
                        Cập nhật Nước Uống
                    </button>

                </div>

            </form>

        </div>

        @if (canUpdateImage)
        {
        <div class="col-lg-4">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0">
                        <i class="fas fa-images me-2"></i>
                        Hình Ảnh Sản Phẩm
                    </h5>
                </div>

                <div class="card-body">

                    <input type="hidden"
                           id="currentDrinkId"
                           value="@Model.DrinkUpdateDTO.DrinkId" />

                    <div class="drink-image-library-heading mb-3">
                        <div>
                            <i class="fas fa-layer-group"></i>
                            <span>Danh Sách Ảnh Đã Tải Lên</span>
                        </div>
                    </div>

                    <div class="row g-2 drink-image-grid"
                         id="imageListContainer">
                        <div class="col-12 text-center text-muted py-3">
                            <i class="fas fa-spinner fa-spin me-1"></i> Đang tải...
                        </div>
                    </div>

                </div>

            </div>

        </div>
        }

    </div>

</div>

<!-- Modal Edit Image -->
<div class="modal fade" id="editImageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content drink-modal-content drink-image-edit-modal">
            <div class="modal-header">
                <div class="drink-image-modal-title">
                    <span class="drink-image-modal-icon"><i class="fas fa-pen"></i></span>
                    <div>
                        <h5 class="modal-title">Chỉnh sửa ảnh</h5>
                        <p class="modal-header-subtitle">Thay thế ảnh hiện tại bằng ảnh mới</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editImageForm" enctype="multipart/form-data">
                <div class="modal-body">
                    <input type="hidden" id="editDrinkImageId" value="" />
                    <input type="file"
                           class="drink-image-file-input-hidden"
                           id="editImageFileInput"
                           accept=".jpg,.jpeg,.png" />

                    <div class="row g-4 align-items-center justify-content-center">
                        <div class="col-6 edit-image-col">
                            <span class="edit-image-col-label">Ảnh hiện tại</span>
                            <div class="edit-image-box-wrapper">
                                <img id="editCurrentPreview" src="" alt="Ảnh hiện tại" />
                            </div>
                        </div>
                        <div class="col-6 edit-image-col">
                            <span class="edit-image-col-label">Ảnh mới (xem trước)</span>
                            <label for="editImageFileInput" class="m-0 p-0 d-block" style="cursor: pointer;" title="Bấm để chọn ảnh mới">
                                <div id="editNewPreviewPlaceholder" class="edit-image-picker-box">
                                    <i class="fas fa-folder-open"></i>
                                    <span>Chọn ảnh mới</span>
                                </div>
                                <div id="editNewPreviewWrapper" class="edit-image-box-wrapper" style="display: none;">
                                    <img id="editNewPreview" src="" alt="Ảnh mới" />
                                    <div class="edit-image-preview-overlay">
                                        <i class="fas fa-sync-alt"></i>
                                        <span>Đổi ảnh khác</span>
                                    </div>
                                </div>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn drink-modal-btn-cancel" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn drink-modal-btn-save" id="btnSaveEditImage">
                        <i class="fas fa-save me-1"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>



@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/Admin/Drink/drink.js"></script>
}
