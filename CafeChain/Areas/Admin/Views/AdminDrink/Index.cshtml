@model CafeChain.ViewModels.Admin.Drinks.AdminDrinkIndexViewModel
@using System.Security.Claims
@using CafeChain.Application.Constants
@using CafeChain.Application.Interfaces.Admin.Permissions
@using Microsoft.Extensions.Localization
@inject IAdminPermissionService PermissionService
@inject IStringLocalizer<CafeChain.ProductResource> ProductText

@{
    ViewData["Title"] = ProductText["Drink.PageTitle"];
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var filter = Model.Filter;
    var drinks = Model.Drinks.Items;
    var totalFilteredDrinks = Model.Drinks.TotalCount;
    var totalPages = Math.Max(1, Model.Drinks.TotalPages);
    var currentPage = Math.Min(Math.Max(1, Model.Drinks.PageIndex), totalPages);
    var startItem = totalFilteredDrinks == 0
        ? 0
        : ((currentPage - 1) * filter.PageSize) + 1;
    var endItem = totalFilteredDrinks == 0
        ? 0
        : Math.Min(startItem + drinks.Count - 1, totalFilteredDrinks);
    var fromPage = Math.Max(1, currentPage - 2);
    var toPage = Math.Min(totalPages, currentPage + 2);

    string TabClass(bool? active) =>
        filter.Active == active ? "drink-tab active" : "drink-tab";
    var hasFilters = !string.IsNullOrWhiteSpace(filter.Keyword) || filter.Active.HasValue;
    var canCreate = false;
    var canUpdate = false;
    var canToggle = false;
    var canUpdateImage = false;
    if (int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var accountId))
    {
        var permissions = (await PermissionService.GetEffectivePermissionCodesAsync(accountId)).Data
            ?? new HashSet<string>(StringComparer.Ordinal);
        canCreate = permissions.Contains(PermissionConstants.DrinkCreate);
        canUpdate = permissions.Contains(PermissionConstants.DrinkUpdate);
        canToggle = permissions.Contains(PermissionConstants.DrinkToggleStatus);
        canUpdateImage = permissions.Contains(PermissionConstants.DrinkUpdateImage);
    }

}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/InventoryOperations/inventory-operations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/Drink/drink.css" asp-append-version="true" />
}

<main class="drink-page ops-shell cc-warehouse-page">
    @Html.AntiForgeryToken()
    <header class="drink-page-header ops-header cc-warehouse-header">
        <div>
            <span class="drink-eyebrow ops-eyebrow">
                <i class="fas fa-mug-hot"></i>
                @ProductText["Drink.Eyebrow"]
            </span>
            <h1 class="ops-title"><i class="fa-solid fa-mug-hot me-2 text-warning" aria-hidden="true"></i>@ProductText["Drink.Title"]</h1>
            <p class="ops-subtitle">@ProductText["Drink.Description"]</p>
        </div>

        <div class="drink-header-actions ops-actions">
            <a asp-action="Index" class="btn drink-filter-btn @(hasFilters ? "" : "is-muted")">
                <i class="fas fa-rotate-left"></i>
                @ProductText["Common.ClearFilters"]
            </a>

            @if (canCreate)
            {
            <a asp-action="Create" class="btn drink-primary-btn">
                <i class="fas fa-plus"></i>
                @ProductText["Common.Add"]
            </a>
            }
        </div>
    </header>

    <div class="drink-summary-grid">
        <div class="drink-summary-card drink-summary-total">
            <span class="drink-summary-icon"><i class="fas fa-mug-hot"></i></span>
            <span><strong>@Model.TotalCount</strong><small>@ProductText["Drink.Total"]</small></span>
        </div>
        <div class="drink-summary-card drink-summary-active">
            <span class="drink-summary-icon"><i class="fas fa-circle-check"></i></span>
            <span><strong>@Model.ActiveCount</strong><small>@ProductText["Drink.Selling"]</small></span>
        </div>
        <div class="drink-summary-card drink-summary-inactive">
            <span class="drink-summary-icon"><i class="fas fa-circle-pause"></i></span>
            <span><strong>@Model.InactiveCount</strong><small>@ProductText["Drink.Paused"]</small></span>
        </div>
    </div>

    <div class="drink-toolbar">
        <div class="drink-status-tabs" aria-label="@ProductText["Drink.FilterAria"]">
            <a class="@TabClass(null)"
               asp-action="Index"
               asp-route-keyword="@filter.Keyword"
               asp-route-page="1"
               asp-route-pageSize="@filter.PageSize">
                @ProductText["Common.AllWithCount", Model.TotalCount]
            </a>

            <a class="@TabClass(true)"
               asp-action="Index"
               asp-route-keyword="@filter.Keyword"
               asp-route-active="true"
               asp-route-page="1"
               asp-route-pageSize="@filter.PageSize">
                @ProductText["Drink.Selling"] (@Model.ActiveCount)
            </a>

            <a class="@TabClass(false)"
               asp-action="Index"
               asp-route-keyword="@filter.Keyword"
               asp-route-active="false"
               asp-route-page="1"
               asp-route-pageSize="@filter.PageSize">
                @ProductText["Drink.Paused"] (@Model.InactiveCount)
            </a>
        </div>

        <form asp-action="Index"
              method="get"
              class="drink-list-tools"
              id="drinkFilterForm">
            <input type="hidden" name="Active" value="@filter.Active" />
            <input type="hidden" name="Page" value="1" />

            <div class="drink-search-box">
                <button type="submit" class="drink-search-btn" title="@ProductText["Common.Search"]" aria-label="@ProductText["Drink.SearchAria"]">
                    <i class="fas fa-search" aria-hidden="true"></i>
                </button>
                <input type="search"
                       name="Keyword"
                       value="@filter.Keyword"
                       placeholder="@ProductText["Drink.SearchPlaceholder"]"
                       aria-label="@ProductText["Drink.SearchAria"]" />
            </div>

            <label class="drink-page-size">
                <span>@ProductText["Common.Display"]</span>
                <select name="PageSize"
                        aria-label="@ProductText["Common.DisplayRows"]"
                        onchange="this.form.submit()">
                    <option value="10" selected="@(filter.PageSize == 10)">10</option>
                    <option value="25" selected="@(filter.PageSize == 25)">25</option>
                    <option value="50" selected="@(filter.PageSize == 50)">50</option>
                </select>
            </label>
        </form>
    </div>

    <div class="drink-table-card">
        <div class="drink-list-heading">
            <div>
                <h2>@ProductText["Drink.InventoryTitle"]</h2>
                <p>@ProductText["Drink.InventoryDescription"]</p>
            </div>
            <span>@ProductText["Common.Results", totalFilteredDrinks]</span>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0 drink-table" id="datatablesSimple">
                <thead>
                    <tr>
                        <th class="drink-check-cell">
                            <input type="checkbox" aria-label="@ProductText["Drink.SelectAll"]" />
                        </th>
                        <th class="text-center">@ProductText["Drink.Image"]</th>
                        <th class="text-center">@ProductText["Drink.Code"]</th>
                        <th>@ProductText["Drink.Name"]</th>
                        <th>@ProductText["Drink.Category"]</th>
                        <th>@ProductText["Drink.Type"]</th>
                        <th class="text-center">@ProductText["Common.Status"]</th>
                        <th class="text-center">@ProductText["Common.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!drinks.Any())
                    {
                        <tr>
                            <td colspan="8" class="drink-empty-state">
                                <span class="drink-empty-icon"><i class="fas fa-martini-glass-citrus"></i></span>
                                <strong>@ProductText["Drink.EmptyTitle"]</strong>
                                <small>@ProductText["Drink.EmptyHint"]</small>
                            </td>
                        </tr>
                    }

                    @foreach (var item in drinks)
                    {
                        <tr>
                            <td class="drink-check-cell">
                                <input type="checkbox" aria-label="@ProductText["Drink.SelectOne", item.Name]" />
                            </td>

                            <td data-label="@ProductText["Drink.Image"]" class="text-center">
                                <div class="drink-image-box">
                                    <img src="@item.ImageUrl" alt="@item.Name" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                    <div class="drink-image-fallback" style="display:none; width:100%; height:100%; align-items:center; justify-content:center; background:#f8f3ef; color:#8b6b55; font-size:16px;">
                                        <i class="fas fa-mug-hot"></i>
                                    </div>
                                </div>
                            </td>

                            <td class="text-center" data-label="@ProductText["Drink.Code"]">
                                <span class="drink-badge drink-badge-type">
                                    @item.DrinkCode
                                </span>
                            </td>

                            <td data-label="@ProductText["Drink.Name"]">
                                <div class="drink-name">@item.Name</div>
                            </td>

                            <td data-label="@ProductText["Drink.Category"]">
                                <span class="drink-badge drink-badge-category">
                                    @item.CategoryName
                                </span>
                            </td>

                            <td data-label="@ProductText["Drink.Type"]">
                                <span class="drink-badge drink-badge-type">
                                    @item.ProductTypeName
                                </span>
                            </td>

                            <td data-label="@ProductText["Common.Status"]" class="text-center">
                                @if (item.Active)
                                {
                                    <span class="drink-status-badge active">
                                        <span></span>
                                        @ProductText["Drink.Selling"]
                                    </span>
                                }
                                else
                                {
                                    <span class="drink-status-badge inactive">
                                        <span></span>
                                        @ProductText["Drink.Paused"]
                                    </span>
                                }
                            </td>

                            <td class="text-center" data-label="@ProductText["Common.Actions"]">
                                <div class="drink-action-group">
                                    @if (canUpdateImage)
                                    {
                                    <button type="button"
                                            class="btn drink-action-btn is-secondary btn-manage-images"
                                            data-id="@item.DrinkId"
                                            data-name="@item.Name"
                                            title="@ProductText["Drink.ManageImages"]">
                                        <i class="fas fa-images"></i>
                                    </button>
                                    }

                                    @if (canUpdate)
                                    {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.DrinkId"
                                       class="btn drink-action-btn is-edit"
                                       title="@ProductText["Drink.Edit"]">
                                        <i class="fas fa-pen"></i>
                                    </a>
                                    }

                                    @if (canToggle)
                                    {
                                    <button type="button"
                                            class="btn drink-action-btn js-toggle-drink @(item.Active ? "is-lock" : "is-unlock")"
                                            data-id="@item.DrinkId"
                                            title="@(item.Active ? ProductText["Drink.Paused"] : ProductText["Drink.Resume"])">
                                        <i class="fas @(item.Active ? "fa-pause" : "fa-play")"></i>
                                    </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="drink-table-footer">
            <span>
                @ProductText["Drink.Range", startItem, endItem, totalFilteredDrinks]
            </span>

            <div class="drink-pagination" aria-label="@ProductText["Drink.Pagination"]">
                <a asp-action="Index"
                   asp-route-keyword="@filter.Keyword"
                   asp-route-active="@filter.Active"
                   asp-route-page="@(currentPage - 1)"
                   asp-route-pageSize="@filter.PageSize"
                   class="@(currentPage > 1 ? "" : "disabled")"
                   aria-disabled="@(currentPage > 1 ? "false" : "true")">
                    <i class="fas fa-chevron-left"></i>
                </a>

                @if (fromPage > 1)
                {
                    <a asp-action="Index"
                       asp-route-keyword="@filter.Keyword"
                       asp-route-active="@filter.Active"
                       asp-route-page="1"
                       asp-route-pageSize="@filter.PageSize">
                        1
                    </a>

                    @if (fromPage > 2)
                    {
                        <span>...</span>
                    }
                }

                @for (var pageNumber = fromPage; pageNumber <= toPage; pageNumber++)
                {
                    <a asp-action="Index"
                       asp-route-keyword="@filter.Keyword"
                       asp-route-active="@filter.Active"
                       asp-route-page="@pageNumber"
                       asp-route-pageSize="@filter.PageSize"
                       class="@(pageNumber == currentPage ? "active" : "")">
                        @pageNumber
                    </a>
                }

                @if (toPage < totalPages)
                {
                    @if (toPage < totalPages - 1)
                    {
                        <span>...</span>
                    }

                    <a asp-action="Index"
                       asp-route-keyword="@filter.Keyword"
                       asp-route-active="@filter.Active"
                       asp-route-page="@totalPages"
                       asp-route-pageSize="@filter.PageSize">
                        @totalPages
                    </a>
                }

                <a asp-action="Index"
                   asp-route-keyword="@filter.Keyword"
                   asp-route-active="@filter.Active"
                   asp-route-page="@(currentPage + 1)"
                   asp-route-pageSize="@filter.PageSize"
                   class="@(currentPage < totalPages ? "" : "disabled")"
                   aria-disabled="@(currentPage < totalPages ? "false" : "true")">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </div>
    </div>
</main>

<!-- Modal Image Management -->
<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content drink-modal-content drink-image-manager">
            <div class="modal-header">
                <div class="drink-image-modal-title">
                    <span class="drink-image-modal-icon"><i class="fas fa-images"></i></span>
                    <div>
                        <h5 class="modal-title">@ProductText["Drink.ManageImages"]</h5>
                        <p id="modalDrinkName"></p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="currentDrinkId" value="" />

                <div class="drink-image-upload-panel">
                    <div class="drink-image-upload-heading">
                        <span><i class="fas fa-cloud-arrow-up"></i></span>
                        <div>
                            <h6>@ProductText["Drink.ImageAdd"]</h6>
                            <p>@ProductText["Drink.ImageHint"]</p>
                        </div>
                    </div>

                    <div class="drink-image-file-custom">
                        <input type="file"
                               class="drink-image-file-input-hidden"
                               id="uploadImageInput"
                               accept=".jpg,.jpeg,.png" />
                        <label for="uploadImageInput" class="btn drink-image-file-label">
                            <i class="fas fa-folder-open me-1"></i> @ProductText["Drink.ImageChoose"]
                        </label>
                        <span class="drink-image-file-name" id="uploadFileName">@ProductText["Drink.ImageNoFile"]</span>
                    </div>

                    <div class="drink-image-upload-actions d-flex align-items-center justify-content-between">
                        <label class="drink-default-switch-label mb-0" title="@ProductText["Drink.ImageDefault"]">
                            <input type="checkbox" id="uploadDefaultSwitch" class="drink-default-switch-input" />
                            <span class="drink-default-switch-custom">
                                <i class="far fa-star"></i>
                                <span>@ProductText["Drink.ImageDefault"]</span>
                            </span>
                        </label>
                    </div>
                </div>

                <!-- Image List -->
                <div class="drink-image-library-heading">
                    <div>
                        <i class="fas fa-layer-group"></i>
                        <span>@ProductText["Drink.ImageLibrary"]</span>
                    </div>
                    <small>@ProductText["Drink.ImageLibraryHint"]</small>
                </div>
                <div class="row g-3 drink-image-grid" id="imageListContainer">
                    <div class="col-12 text-center text-muted">@ProductText["Common.Loading"]</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Edit Image -->
<div class="modal fade" id="editImageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content drink-modal-content drink-image-edit-modal">
            <div class="modal-header">
                <div class="drink-image-modal-title">
                    <span class="drink-image-modal-icon"><i class="fas fa-pen"></i></span>
                    <div>
                        <h5 class="modal-title">@ProductText["Drink.ImageEditTitle"]</h5>
                        <p class="modal-header-subtitle">@ProductText["Drink.ImageEditHint"]</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editImageForm" enctype="multipart/form-data">
                <div class="modal-body">
                    <input type="hidden" id="editDrinkImageId" value="" />
                    <input type="file"
                           class="drink-image-file-input-hidden"
                           id="editImageFileInput"
                           accept=".jpg,.jpeg,.png" />

                    <div class="row g-4 align-items-center justify-content-center">
                        <div class="col-6 edit-image-col">
                            <span class="edit-image-col-label">@ProductText["Drink.ImageCurrent"]</span>
                            <div class="edit-image-box-wrapper">
                                <img id="editCurrentPreview" src="" alt="@ProductText["Drink.ImageCurrent"]" />
                            </div>
                        </div>
                        <div class="col-6 edit-image-col">
                            <span class="edit-image-col-label">@ProductText["Drink.ImageNew"]</span>
                            <label for="editImageFileInput" class="m-0 p-0 d-block" style="cursor: pointer;" title="@ProductText["Drink.ImageChooseNew"]">
                                <div id="editNewPreviewPlaceholder" class="edit-image-picker-box">
                                    <i class="fas fa-folder-open"></i>
                                    <span>@ProductText["Drink.ImageChooseNew"]</span>
                                </div>
                                <div id="editNewPreviewWrapper" class="edit-image-box-wrapper" style="display: none;">
                                    <img id="editNewPreview" src="" alt="@ProductText["Drink.ImageNew"]" />
                                    <div class="edit-image-preview-overlay">
                                        <i class="fas fa-sync-alt"></i>
                                        <span>@ProductText["Drink.ImageChange"]</span>
                                    </div>
                                </div>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn drink-modal-btn-cancel" data-bs-dismiss="modal">@ProductText["Common.Cancel"]</button>
                    <button type="submit" class="btn drink-modal-btn-save" id="btnSaveEditImage">
                        <i class="fas fa-save me-1"></i> @ProductText["Drink.ImageSave"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_DrinkUiCatalog" />
    <script src="~/js/Admin/Drink/drink.js" asp-append-version="true"></script>
}
