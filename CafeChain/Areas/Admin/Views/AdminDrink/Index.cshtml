@model CafeChain.ViewModels.Admin.Drinks.AdminDrinkIndexViewModel
@using System.Security.Claims
@using CafeChain.Application.Constants
@using CafeChain.Application.Interfaces.Admin.Permissions
@inject IAdminPermissionService PermissionService

@{
    ViewData["Title"] = "Quản lý Nước uống";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var filter = Model.Filter;
    var drinks = Model.Drinks.Items;
    var totalFilteredDrinks = Model.Drinks.TotalCount;
    var totalPages = Math.Max(1, Model.Drinks.TotalPages);
    var currentPage = Math.Min(Math.Max(1, Model.Drinks.PageIndex), totalPages);
    var startItem = totalFilteredDrinks == 0
        ? 0
        : ((currentPage - 1) * filter.PageSize) + 1;
    var endItem = totalFilteredDrinks == 0
        ? 0
        : Math.Min(startItem + drinks.Count - 1, totalFilteredDrinks);
    var fromPage = Math.Max(1, currentPage - 2);
    var toPage = Math.Min(totalPages, currentPage + 2);

    string TabClass(bool? active) =>
        filter.Active == active ? "drink-tab active" : "drink-tab";
    var hasFilters = !string.IsNullOrWhiteSpace(filter.Keyword) || filter.Active.HasValue;
    var canCreate = false;
    var canUpdate = false;
    var canToggle = false;
    var canUpdateImage = false;
    if (int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var accountId))
    {
        var permissions = (await PermissionService.GetEffectivePermissionCodesAsync(accountId)).Data
            ?? new HashSet<string>(StringComparer.Ordinal);
        canCreate = permissions.Contains(PermissionConstants.DrinkCreate);
        canUpdate = permissions.Contains(PermissionConstants.DrinkUpdate);
        canToggle = permissions.Contains(PermissionConstants.DrinkToggleStatus);
        canUpdateImage = permissions.Contains(PermissionConstants.DrinkUpdateImage);
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/Drink/drink.css" asp-append-version="true" />
}

<div class="drink-page">
    @Html.AntiForgeryToken()
    <div class="drink-page-header">
        <div>
            <span class="drink-eyebrow">
                <i class="fas fa-mug-hot"></i>
                Thực đơn CafeChain
            </span>
            <h1>Danh sách nước uống</h1>
            <p>Theo dõi hình ảnh, danh mục và trạng thái bán của toàn bộ sản phẩm.</p>
        </div>

        <div class="drink-header-actions">
            <a asp-action="Index" class="btn drink-filter-btn @(hasFilters ? "" : "is-muted")">
                <i class="fas fa-rotate-left"></i>
                Xóa lọc
            </a>

            @if (canCreate)
            {
            <a asp-action="Create" class="btn drink-primary-btn">
                <i class="fas fa-plus"></i>
                Thêm mới
            </a>
            }
        </div>
    </div>

    <div class="drink-summary-grid">
        <div class="drink-summary-card drink-summary-total">
            <span class="drink-summary-icon"><i class="fas fa-mug-hot"></i></span>
            <span><strong>@Model.TotalCount</strong><small>Tổng đồ uống</small></span>
        </div>
        <div class="drink-summary-card drink-summary-active">
            <span class="drink-summary-icon"><i class="fas fa-circle-check"></i></span>
            <span><strong>@Model.ActiveCount</strong><small>Đang bán</small></span>
        </div>
        <div class="drink-summary-card drink-summary-inactive">
            <span class="drink-summary-icon"><i class="fas fa-circle-pause"></i></span>
            <span><strong>@Model.InactiveCount</strong><small>Ngừng bán</small></span>
        </div>
    </div>

    <div class="drink-toolbar">
        <div class="drink-status-tabs" aria-label="Bộ lọc trạng thái đồ uống">
            <a class="@TabClass(null)"
               asp-action="Index"
               asp-route-keyword="@filter.Keyword"
               asp-route-page="1"
               asp-route-pageSize="@filter.PageSize">
                Tất cả (@Model.TotalCount)
            </a>

            <a class="@TabClass(true)"
               asp-action="Index"
               asp-route-keyword="@filter.Keyword"
               asp-route-active="true"
               asp-route-page="1"
               asp-route-pageSize="@filter.PageSize">
                Đang bán (@Model.ActiveCount)
            </a>

            <a class="@TabClass(false)"
               asp-action="Index"
               asp-route-keyword="@filter.Keyword"
               asp-route-active="false"
               asp-route-page="1"
               asp-route-pageSize="@filter.PageSize">
                Ngừng bán (@Model.InactiveCount)
            </a>
        </div>

        <form asp-action="Index"
              method="get"
              class="drink-list-tools"
              id="drinkFilterForm">
            <input type="hidden" name="Active" value="@filter.Active" />
            <input type="hidden" name="Page" value="1" />

            <label class="drink-search-box" aria-label="Tìm đồ uống">
                <i class="fas fa-search"></i>
                <input type="search"
                       name="Keyword"
                       value="@filter.Keyword"
                       placeholder="Tìm đồ uống..." />
                <button type="submit" title="Tìm kiếm" aria-label="Tìm kiếm">
                    <i class="fas fa-arrow-right"></i>
                </button>
            </label>

            <label class="drink-page-size">
                <span>Hiển thị:</span>
                <select name="PageSize"
                        aria-label="Số dòng hiển thị"
                        onchange="this.form.submit()">
                    <option value="10" selected="@(filter.PageSize == 10)">10</option>
                    <option value="25" selected="@(filter.PageSize == 25)">25</option>
                    <option value="50" selected="@(filter.PageSize == 50)">50</option>
                </select>
            </label>
        </form>
    </div>

    <div class="drink-table-card">
        <div class="drink-list-heading">
            <div>
                <h2>Kho đồ uống</h2>
                <p>Cập nhật hình ảnh và thông tin sản phẩm ngay tại một nơi.</p>
            </div>
            <span>@totalFilteredDrinks kết quả</span>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0 drink-table" id="datatablesSimple">
                <thead>
                    <tr>
                        <th class="drink-check-cell">
                            <input type="checkbox" aria-label="Chọn tất cả đồ uống" />
                        </th>
                        <th>Hình ảnh</th>
                        <th>Mã</th>
                        <th>Tên nước uống</th>
                        <th>Danh mục</th>
                        <th>Loại sản phẩm</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!drinks.Any())
                    {
                        <tr>
                            <td colspan="8" class="drink-empty-state">
                                <span class="drink-empty-icon"><i class="fas fa-martini-glass-citrus"></i></span>
                                <strong>Không tìm thấy đồ uống phù hợp</strong>
                                <small>Thử đổi từ khóa hoặc trạng thái lọc để xem thêm kết quả.</small>
                            </td>
                        </tr>
                    }

                    @foreach (var item in drinks)
                    {
                        <tr>
                            <td class="drink-check-cell">
                                <input type="checkbox" aria-label="Chọn @item.Name" />
                            </td>

                            <td data-label="Hình ảnh">
                                <div class="drink-image-box">
                                    <img src="@item.ImageUrl" alt="@item.Name" />
                                </div>
                            </td>

                            <td data-label="Mã">
                                <span class="drink-badge drink-badge-type">
                                    @item.DrinkCode
                                </span>
                            </td>

                            <td data-label="Tên nước uống">
                                <div class="drink-name">@item.Name</div>
                            </td>

                            <td data-label="Danh mục">
                                <span class="drink-badge drink-badge-category">
                                    @item.CategoryName
                                </span>
                            </td>

                            <td data-label="Loại sản phẩm">
                                <span class="drink-badge drink-badge-type">
                                    @item.ProductTypeName
                                </span>
                            </td>

                            <td data-label="Trạng thái">
                                @if (item.Active)
                                {
                                    <span class="drink-status-badge active">
                                        <span></span>
                                        Đang bán
                                    </span>
                                }
                                else
                                {
                                    <span class="drink-status-badge inactive">
                                        <span></span>
                                        Ngừng bán
                                    </span>
                                }
                            </td>

                            <td class="text-center" data-label="Thao tác">
                                <div class="drink-action-group">
                                    @if (canUpdateImage)
                                    {
                                    <button type="button"
                                            class="btn drink-action-btn btn-manage-images"
                                            data-id="@item.DrinkId"
                                            data-name="@item.Name"
                                            title="Quản lý ảnh">
                                        <i class="fas fa-images"></i>
                                    </button>
                                    }

                                    @if (canUpdate)
                                    {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.DrinkId"
                                       class="btn drink-action-btn"
                                       title="Sửa đồ uống">
                                        <i class="fas fa-pen"></i>
                                    </a>
                                    }

                                    @if (canToggle)
                                    {
                                    <button type="button"
                                            class="btn drink-action-btn js-toggle-drink"
                                            data-id="@item.DrinkId"
                                            title="@(item.Active ? "Ngừng bán" : "Mở bán lại")">
                                        <i class="fas @(item.Active ? "fa-pause" : "fa-play")"></i>
                                    </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="drink-table-footer">
            <span>
                Hiển thị @startItem-@endItem trong số @totalFilteredDrinks
            </span>

            <div class="drink-pagination" aria-label="Phân trang đồ uống">
                <a asp-action="Index"
                   asp-route-keyword="@filter.Keyword"
                   asp-route-active="@filter.Active"
                   asp-route-page="@(currentPage - 1)"
                   asp-route-pageSize="@filter.PageSize"
                   class="@(currentPage > 1 ? "" : "disabled")"
                   aria-disabled="@(currentPage > 1 ? "false" : "true")">
                    <i class="fas fa-chevron-left"></i>
                </a>

                @if (fromPage > 1)
                {
                    <a asp-action="Index"
                       asp-route-keyword="@filter.Keyword"
                       asp-route-active="@filter.Active"
                       asp-route-page="1"
                       asp-route-pageSize="@filter.PageSize">
                        1
                    </a>

                    @if (fromPage > 2)
                    {
                        <span>...</span>
                    }
                }

                @for (var pageNumber = fromPage; pageNumber <= toPage; pageNumber++)
                {
                    <a asp-action="Index"
                       asp-route-keyword="@filter.Keyword"
                       asp-route-active="@filter.Active"
                       asp-route-page="@pageNumber"
                       asp-route-pageSize="@filter.PageSize"
                       class="@(pageNumber == currentPage ? "active" : "")">
                        @pageNumber
                    </a>
                }

                @if (toPage < totalPages)
                {
                    @if (toPage < totalPages - 1)
                    {
                        <span>...</span>
                    }

                    <a asp-action="Index"
                       asp-route-keyword="@filter.Keyword"
                       asp-route-active="@filter.Active"
                       asp-route-page="@totalPages"
                       asp-route-pageSize="@filter.PageSize">
                        @totalPages
                    </a>
                }

                <a asp-action="Index"
                   asp-route-keyword="@filter.Keyword"
                   asp-route-active="@filter.Active"
                   asp-route-page="@(currentPage + 1)"
                   asp-route-pageSize="@filter.PageSize"
                   class="@(currentPage < totalPages ? "" : "disabled")"
                   aria-disabled="@(currentPage < totalPages ? "false" : "true")">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Modal Image Management -->
<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content drink-modal-content drink-image-manager">
            <div class="modal-header">
                <div class="drink-image-modal-title">
                    <span class="drink-image-modal-icon"><i class="fas fa-images"></i></span>
                    <div>
                        <h5 class="modal-title">Quản lý ảnh</h5>
                        <p id="modalDrinkName"></p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="currentDrinkId" value="" />

                <div class="drink-image-upload-panel">
                    <div class="drink-image-upload-heading">
                        <span><i class="fas fa-cloud-arrow-up"></i></span>
                        <div>
                            <h6>Thêm ảnh mới</h6>
                            <p>Ảnh JPG hoặc PNG, nên sử dụng ảnh vuông để hiển thị đẹp nhất.</p>
                        </div>
                    </div>

                    <input type="file"
                           class="form-control drink-image-file-input"
                           id="uploadImageInput"
                           accept=".jpg,.jpeg,.png" />

                    <div class="drink-image-upload-actions">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input"
                                   type="checkbox"
                                   role="switch"
                                   id="uploadDefaultSwitch" />

                            <label class="form-check-label small"
                                   for="uploadDefaultSwitch">
                                Đặt làm mặc định
                            </label>
                        </div>

                        <button type="button"
                                class="btn drink-image-upload-btn"
                                id="btnUploadDrinkImage">
                            <i class="fas fa-upload me-1"></i>
                            Tải ảnh
                        </button>
                    </div>
                </div>

                <!-- Image List -->
                <div class="drink-image-library-heading">
                    <div>
                        <i class="fas fa-layer-group"></i>
                        <span>Thư viện ảnh</span>
                    </div>
                    <small>Chọn ảnh đại diện, chỉnh sửa hoặc xóa ảnh</small>
                </div>
                <div class="row g-3 drink-image-grid" id="imageListContainer">
                    <div class="col-12 text-center text-muted">Đang tải...</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Edit Image -->
<div class="modal fade" id="editImageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content drink-modal-content drink-image-edit-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-warning"><i class="fas fa-pencil-alt"></i> Chỉnh sửa ảnh</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editImageId" value="" />
                <div class="mb-3 text-center">
                    <p class="text-muted small mb-2">Ảnh hiện tại:</p>
                    <img id="editCurrentPreview" src="" alt="Ảnh hiện tại"
                         class="drink-edit-image-preview" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Chọn ảnh mới <span class="text-danger">*</span></label>
                    <input type="file" class="form-control" id="newImageFileInput" accept=".jpg,.jpeg,.png" />
                    <div class="form-text">Chỉ chấp nhận JPG, JPEG, PNG.</div>
                </div>
                <div id="newImagePreviewWrapper" class="text-center mb-2" style="display:none;">
                    <p class="text-muted small mb-1">Xem trước ảnh mới:</p>
                    <img id="newImagePreview" src="" alt="Xem trước ảnh mới"
                         class="drink-edit-image-preview is-new" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn drink-image-upload-btn" id="btnConfirmEditImage">
                    <i class="fas fa-save"></i> Lưu ảnh mới
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Admin/Drink/drink.js"></script>
}
