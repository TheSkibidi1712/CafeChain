@model IEnumerable<CafeChain.Application.DTOs.Admin.Drinks.AdminDrinkDTO>
@using System.Security.Claims
@using CafeChain.Application.Constants
@using CafeChain.Application.Interfaces.Admin.Permissions
@inject IAdminPermissionService PermissionService
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<CafeChain.ProductResource> ProductText

@{
    var drinks = Model?.ToList() ?? new List<CafeChain.Application.DTOs.Admin.Drinks.AdminDrinkDTO>();
    var canUpdate = false;
    var canToggle = false;
    var canUpdateImage = false;
    if (int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var accountId))
    {
        canUpdate = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.DrinkUpdate)).Data?.Allowed == true;
        canToggle = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.DrinkToggleStatus)).Data?.Allowed == true;
        canUpdateImage = (await PermissionService.HasPermissionAsync(accountId, PermissionConstants.DrinkUpdateImage)).Data?.Allowed == true;
    }
}

<tbody>
    @if (!drinks.Any())
    {
        <tr>
            <td colspan="8" class="drink-empty-state">
                @ProductText["Drink.EmptyTitle"]
            </td>
        </tr>
    }

    @foreach (var item in drinks)
    {
        <tr>
            <td class="drink-check-cell">
                <input type="checkbox" aria-label="@ProductText["Drink.SelectOne", item.Name]" />
            </td>

            <td>
                <div class="drink-image-box">
                    <img src="@item.ImageUrl" alt="@item.Name" />
                </div>
            </td>

            <td>
                <span class="drink-badge drink-badge-type">
                    @item.DrinkCode
                </span>
            </td>

            <td>
                <div class="drink-name">@item.Name</div>
            </td>

            <td>
                <span class="drink-badge drink-badge-category">
                    @item.CategoryName
                </span>
            </td>

            <td>
                <span class="drink-badge drink-badge-type">
                    @item.ProductTypeName
                </span>
            </td>

            <td>
                @if (item.Active)
                {
                    <span class="drink-status-badge active">
                        <span></span>
                        @ProductText["Drink.Selling"]
                    </span>
                }
                else
                {
                    <span class="drink-status-badge inactive">
                        <span></span>
                        @ProductText["Drink.Paused"]
                    </span>
                }
            </td>

            <td class="text-center">
                <div class="drink-action-group">
                    @if (canUpdateImage)
                    {
                    <button type="button"
                            class="btn drink-action-btn is-secondary btn-manage-images"
                            data-id="@item.DrinkId"
                            data-name="@item.Name"
                            title="@ProductText["Drink.ManageImages"]">
                        <i class="fas fa-images"></i>
                    </button>
                    }

                    @if (canUpdate)
                    {
                    <a asp-action="Edit"
                       asp-route-id="@item.DrinkId"
                       class="btn drink-action-btn is-edit"
                       title="@ProductText["Drink.Edit"]">
                        <i class="fas fa-pen"></i>
                    </a>
                    }

                    @if (canToggle)
                    {
                        <button type="button" class="btn drink-action-btn js-toggle-drink @(item.Active ? "is-lock" : "is-unlock")"
                                data-id="@item.DrinkId" title="@(item.Active ? ProductText["Common.Lock"] : ProductText["Common.Unlock"])">
                            <i class="fas @(item.Active ? "fa-lock text-danger" : "fa-unlock text-success")"></i>
                        </button>
                    }
                </div>
            </td>
        </tr>
    }
</tbody>
