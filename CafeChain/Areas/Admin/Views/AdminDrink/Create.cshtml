@model CafeChain.ViewModels.Admin.Drinks.AdminDrinkCreateViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<CafeChain.ProductResource> ProductText

@{
    ViewData["Title"] = ProductText["Drink.Form.CreateTitle"];
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/Drink/drink.css" asp-append-version="true" />
}

<div class="container-fluid px-0 drink-form-page">
    <div class="drink-form-heading">
        <span class="drink-eyebrow"><i class="fas fa-wand-magic-sparkles"></i> @ProductText["Drink.Form.CreateEyebrow"]</span>
        <h1>@ProductText["Drink.Form.CreateTitle"]</h1>
        <p>@ProductText["Drink.Form.CreateDescription"]</p>
    </div>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item active">
            @ProductText["Common.Add"]
        </li>
    </ol>

    <form id="drinkCreateForm"
          asp-action="Create"
          method="post"
          enctype="multipart/form-data">

        <input type="hidden"
               asp-for="DrinkCreateDTO.DefaultImageIndex"
               id="defaultImageIndex" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger mb-3"
             style="display:none">
        </div>

        <div id="drinkCreateValidationSummary"
             class="alert alert-warning mb-3 d-none"
             role="alert"
             tabindex="-1">
            @ProductText["Drink.Js.Validation"]
        </div>

        <div class="row g-4">

            <!-- LEFT -->
            <div class="col-lg-8">

                <div class="card shadow-sm border-0 h-100">

                    <div class="card-header bg-white border-bottom">
                        <h5 class="mb-0 text-primary">
                            <i class="fas fa-coffee me-2"></i>
                            @ProductText["Drink.Form.Information"]
                        </h5>
                    </div>

                    <div class="card-body">

                        <div class="row g-3 mb-4">

                            <div class="col-md-5">

                                <label asp-for="DrinkCreateDTO.DrinkCode"
                                       class="form-label fw-semibold">

                                    @ProductText["Drink.Form.Code"]
                                    <span class="text-danger">*</span>

                                </label>

                                <input asp-for="DrinkCreateDTO.DrinkCode"
                                       class="form-control form-control-lg"
                                       placeholder="VD: CF_Sua" />

                                <span asp-validation-for="DrinkCreateDTO.DrinkCode"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-md-7">

                                <label asp-for="DrinkCreateDTO.Name"
                                       class="form-label fw-semibold">

                                    @ProductText["Drink.Form.Name"]
                                    <span class="text-danger">*</span>

                                </label>

                                <input asp-for="DrinkCreateDTO.Name"
                                       class="form-control form-control-lg"
                                       placeholder="@ProductText["Drink.Form.NamePlaceholder"]" />

                                <span asp-validation-for="DrinkCreateDTO.Name"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                        <div class="row g-3 mb-4">

                            <div class="col-md-6">

                                <label asp-for="DrinkCreateDTO.CategoryId"
                                       class="form-label fw-semibold">

                                    @ProductText["Drink.Form.Category"]
                                    <span class="text-danger">*</span>

                                </label>

                                <select asp-for="DrinkCreateDTO.CategoryId"
                                        class="form-select"
                                        asp-items="Model.Categories">

                                    <option value="">
                                        @ProductText["Drink.Form.CategoryChoose"]
                                    </option>

                                </select>

                                <span asp-validation-for="DrinkCreateDTO.CategoryId"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="DrinkCreateDTO.ProductTypeId"
                                       class="form-label fw-semibold">

                                    @ProductText["Drink.Form.Type"]
                                    <span class="text-danger">*</span>

                                </label>

                                <select asp-for="DrinkCreateDTO.ProductTypeId"
                                        class="form-select"
                                        asp-items="Model.ProductTypes">

                                    <option value="">
                                        @ProductText["Drink.Form.TypeChoose"]
                                    </option>

                                </select>

                                <span asp-validation-for="DrinkCreateDTO.ProductTypeId"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                        <div class="mb-2">

                            <label asp-for="DrinkCreateDTO.Description"
                                   class="form-label fw-semibold">

                                @ProductText["Drink.Form.Description"]

                            </label>

                            <textarea asp-for="DrinkCreateDTO.Description"
                                      class="form-control"
                                      rows="6"
                                      placeholder="@ProductText["Drink.Form.DescriptionPlaceholder"]"></textarea>

                        </div>

                    </div>

                </div>

            </div>

            <!-- RIGHT -->
            <div class="col-lg-4">

                <div class="card shadow-sm border-0">

                    <div class="card-header bg-white border-bottom">

                        <h5 class="mb-0 text-primary">
                            <i class="fas fa-images me-2"></i>
                            @ProductText["Drink.Form.ProductImages"]
                        </h5>

                    </div>

                    <div class="card-body">

                        <p class="text-muted small mb-3">

                            <i class="fas fa-info-circle me-1"></i>

                            @ProductText["Drink.Form.ImageRules"]

                        </p>

                        <label id="dropZone"
                               class="w-100 border border-2 border-dashed rounded-3 text-center mb-3 d-flex flex-column justify-content-center align-items-center"
                               style="cursor:pointer;
                            border-color:#dee2e6;
                            background:#fafafa;
                            min-height:260px;
                            transition:.2s;">

                            <i class="fas fa-cloud-upload-alt fa-3x text-primary mb-3"></i>

                            <p class="fw-semibold mb-1">
                                @ProductText["Drink.Form.DropImages"]
                            </p>

                            <p class="text-muted small mb-2">
                                @ProductText["Drink.Form.Or"]
                                <span class="text-primary text-decoration-underline">
                                    @ProductText["Drink.Form.ChooseFile"]
                                </span>
                            </p>

                            <small class="text-muted">
                                @ProductText["Drink.Form.ImageRules"]
                            </small>

                            <input asp-for="DrinkCreateDTO.ImageFiles"
                                   id="imageFilesInput"
                                   type="file"
                                   multiple
                                   accept=".jpg,.jpeg,.png"
                                   hidden />
                        </label>

                        <div id="previewContainer"
                             class="row g-2 mt-2">
                        </div>

                        <div id="createDefaultNote"
                             class="drink-default-note mt-3 d-flex align-items-center gap-2 d-none">
                            <i class="fas fa-star text-warning flex-shrink-0"></i>
                            <small class="text-secondary fw-semibold">
                                @ProductText["Drink.Form.DefaultHint"]
                            </small>
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">

            <a asp-action="Index"
               class="btn btn-outline-secondary px-4">

                <i class="fas fa-arrow-left me-1"></i>
                @ProductText["Drink.Form.Back"]

            </a>

            <button type="submit"
                    class="btn btn-primary px-4">

                <i class="fas fa-save me-1"></i>
                @ProductText["Drink.Js.Create"]

            </button>

        </div>

    </form>

</div>

<!-- Preview Image -->

<div class="modal fade"
     id="previewModal">
    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content bg-dark border-0">

            <img id="previewModalImg"
                 class="w-100 rounded" />

        </div>

    </div>

</div>

<!-- Crop Image -->

<div class="modal fade"
     id="cropImageModal"
     tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">

                    <i class="fas fa-crop-alt me-2"></i>
                    @ProductText["Drink.Form.CropTitle"]

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <div class="row">

                    <div class="col-md-8">

                        <div style="max-height:600px;">

                            <img id="cropImage"
                                 style="max-width:100%;" />

                        </div>

                    </div>

                    <div class="col-md-4">

                        <h6>@ProductText["Drink.Form.Preview"]</h6>

                        <div class="border rounded overflow-hidden"
                             style="width:250px;height:250px;">

                            <div class="preview"></div>

                        </div>

                        <div class="alert alert-info mt-3 mb-0">

                            @ProductText["Drink.Form.AspectRatio"]
                            <strong>1 : 1</strong>

                            <br />

                            @ProductText["Drink.Form.OutputSize"]
                            <strong>1000 x 1000</strong>

                        </div>

                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    @ProductText["Common.Cancel"]

                </button>

                <button type="button"
                        id="btnCropImage"
                        class="btn btn-primary">

                    <i class="fas fa-check"></i>
                    @ProductText["Drink.Form.CropConfirm"]

                </button>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>

    <partial name="_DrinkUiCatalog" />
    <script src="~/js/Admin/Drink/drink.js" asp-append-version="true"></script>

}
