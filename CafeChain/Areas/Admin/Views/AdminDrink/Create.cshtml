@model CafeChain.ViewModels.Admin.Drinks.AdminDrinkCreateViewModel

@{
    ViewData["Title"] = "Thêm Nước Uống Mới";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin/Drink/drink.css" asp-append-version="true" />
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Thêm Nước Uống Mới</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item">
            <a asp-area="Admin"
               asp-controller="AdminDrink"
               asp-action="Index">
                Danh sách Nước uống
            </a>
        </li>
        <li class="breadcrumb-item active">
            Thêm mới
        </li>
    </ol>

    <form id="drinkCreateForm"
          asp-action="Create"
          method="post"
          enctype="multipart/form-data">

        <input type="hidden"
               asp-for="DrinkCreateDTO.DefaultImageIndex"
               id="defaultImageIndex" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger mb-3"
             style="display:none">
        </div>

        <div class="row g-4">

            <!-- LEFT -->
            <div class="col-lg-8">

                <div class="card shadow-sm border-0 h-100">

                    <div class="card-header bg-white border-bottom">
                        <h5 class="mb-0 text-primary">
                            <i class="fas fa-coffee me-2"></i>
                            Thông tin Nước uống
                        </h5>
                    </div>

                    <div class="card-body">

                        <div class="row g-3 mb-4">

                            <div class="col-md-5">

                                <label asp-for="DrinkCreateDTO.DrinkCode"
                                       class="form-label fw-semibold">

                                    Mã Nước Uống
                                    <span class="text-danger">*</span>

                                </label>

                                <input asp-for="DrinkCreateDTO.DrinkCode"
                                       class="form-control form-control-lg"
                                       placeholder="VD: CF_Sua" />

                                <span asp-validation-for="DrinkCreateDTO.DrinkCode"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-md-7">

                                <label asp-for="DrinkCreateDTO.Name"
                                       class="form-label fw-semibold">

                                    Tên Nước Uống
                                    <span class="text-danger">*</span>

                                </label>

                                <input asp-for="DrinkCreateDTO.Name"
                                       class="form-control form-control-lg"
                                       placeholder="Nhập tên nước uống..." />

                                <span asp-validation-for="DrinkCreateDTO.Name"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                        <div class="row g-3 mb-4">

                            <div class="col-md-6">

                                <label asp-for="DrinkCreateDTO.CategoryId"
                                       class="form-label fw-semibold">

                                    Danh Mục
                                    <span class="text-danger">*</span>

                                </label>

                                <select asp-for="DrinkCreateDTO.CategoryId"
                                        class="form-select"
                                        asp-items="Model.Categories">

                                    <option value="">
                                        -- Chọn Danh Mục --
                                    </option>

                                </select>

                                <span asp-validation-for="DrinkCreateDTO.CategoryId"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="DrinkCreateDTO.ProductTypeId"
                                       class="form-label fw-semibold">

                                    Loại Sản Phẩm
                                    <span class="text-danger">*</span>

                                </label>

                                <select asp-for="DrinkCreateDTO.ProductTypeId"
                                        class="form-select"
                                        asp-items="Model.ProductTypes">

                                    <option value="">
                                        -- Chọn Loại Sản Phẩm --
                                    </option>

                                </select>

                                <span asp-validation-for="DrinkCreateDTO.ProductTypeId"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                        <div class="mb-2">

                            <label asp-for="DrinkCreateDTO.Description"
                                   class="form-label fw-semibold">

                                Mô tả chi tiết

                            </label>

                            <textarea asp-for="DrinkCreateDTO.Description"
                                      class="form-control"
                                      rows="6"
                                      placeholder="Mô tả thành phần, hương vị..."></textarea>

                        </div>

                        <div class="mt-3">
                            <label for="drinkAiIdea" class="form-label fw-semibold">Ý tưởng cho AI <span class="text-muted fw-normal">(không bắt buộc)</span></label>
                            <div class="input-group">
                            <input id="drinkAiIdea" class="form-control" maxlength="200" placeholder="Ví dụ: trà đào mùa hè" autocomplete="off" />
                            <button type="button" id="btnDrinkAiSuggestion" class="btn btn-outline-primary">
                                <i class="fas fa-wand-magic-sparkles me-1"></i> AI gợi ý
                            </button>
                            </div>
                        </div>

                        <div id="drinkAiSuggestionPanel" class="ai-suggestion-panel mt-3 d-none" aria-live="polite">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong>Gợi ý cho đồ uống</strong>
                                <span id="drinkAiSource" class="badge bg-secondary"></span>
                            </div>
                            <div id="drinkAiOptionList" class="ai-option-grid"></div>
                            <div class="mt-2"><small class="text-muted">Ảnh gợi ý</small><div><img id="drinkAiImage" class="img-thumbnail d-none mt-1" style="max-width:180px" alt="Ảnh AI gợi ý" /></div></div>
                            <div id="drinkAiImageAttribution" class="small text-muted mt-1 d-none"></div>
                            <div id="drinkAiWarnings" class="small text-warning mt-2"></div>
                            <div class="d-flex gap-2 mt-3">
                                <button type="button" id="btnApplyDrinkAi" class="btn btn-primary btn-sm" disabled>Áp dụng</button>
                                <button type="button" id="btnRegenerateDrinkAiImage" class="btn btn-outline-secondary btn-sm" disabled>Tạo lại ảnh</button>
                                <button type="button" id="btnDismissDrinkAi" class="btn btn-light btn-sm">Bỏ qua</button>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

            <!-- RIGHT -->
            <div class="col-lg-4">

                <div class="card shadow-sm border-0">

                    <div class="card-header bg-white border-bottom">

                        <h5 class="mb-0 text-primary">
                            <i class="fas fa-images me-2"></i>
                            Hình Ảnh Sản Phẩm
                        </h5>

                    </div>

                    <div class="card-body">

                        <p class="text-muted small mb-3">

                            <i class="fas fa-info-circle me-1"></i>

                            JPG, PNG • Tối đa 5MB •
                            Ảnh sẽ được crop chuẩn vuông trước khi upload

                        </p>

                        <label id="dropZone"
                               class="w-100 border border-2 border-dashed rounded-3 text-center mb-3 d-flex flex-column justify-content-center align-items-center"
                               style="cursor:pointer;
                            border-color:#dee2e6;
                            background:#fafafa;
                            min-height:260px;
                            transition:.2s;">

                            <i class="fas fa-cloud-upload-alt fa-3x text-primary mb-3"></i>

                            <p class="fw-semibold mb-1">
                                Kéo & thả ảnh vào đây
                            </p>

                            <p class="text-muted small mb-2">
                                hoặc
                                <span class="text-primary text-decoration-underline">
                                    chọn file
                                </span>
                            </p>

                            <small class="text-muted">
                                PNG, JPG • Tối đa 5MB
                            </small>

                            <input asp-for="DrinkCreateDTO.ImageFiles"
                                   id="imageFilesInput"
                                   type="file"
                                   multiple
                                   accept=".jpg,.jpeg,.png"
                                   hidden />
                        </label>

                        <div id="previewContainer"
                             class="row g-2 mt-2">
                        </div>

                        <p class="text-muted small mt-3 mb-0">
                            <i class="fas fa-star me-1 text-warning"></i>
                            Chọn một ảnh làm ảnh mặc định. Nếu không chọn, ảnh đầu tiên sẽ được dùng.
                        </p>

                    </div>

                </div>

            </div>

        </div>

        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">

            <a asp-action="Index"
               class="btn btn-outline-secondary px-4">

                <i class="fas fa-arrow-left me-1"></i>
                Quay lại

            </a>

            <button type="submit"
                    class="btn btn-primary px-4">

                <i class="fas fa-save me-1"></i>
                Tạo Nước Uống

            </button>

        </div>

    </form>

</div>

<!-- Preview Image -->

<div class="modal fade"
     id="previewModal">
    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content bg-dark border-0">

            <img id="previewModalImg"
                 class="w-100 rounded" />

        </div>

    </div>

</div>

<!-- Crop Image -->

<div class="modal fade"
     id="cropImageModal"
     tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">

                    <i class="fas fa-crop-alt me-2"></i>
                    Cắt ảnh sản phẩm

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <div class="row">

                    <div class="col-md-8">

                        <div style="max-height:600px;">

                            <img id="cropImage"
                                 style="max-width:100%;" />

                        </div>

                    </div>

                    <div class="col-md-4">

                        <h6>Xem trước</h6>

                        <div class="border rounded overflow-hidden"
                             style="width:250px;height:250px;">

                            <div class="preview"></div>

                        </div>

                        <div class="alert alert-info mt-3 mb-0">

                            Tỷ lệ chuẩn:
                            <strong>1 : 1</strong>

                            <br />

                            Kích thước lưu:
                            <strong>1000 x 1000</strong>

                        </div>

                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Hủy

                </button>

                <button type="button"
                        id="btnCropImage"
                        class="btn btn-primary">

                    <i class="fas fa-check"></i>
                    Xác nhận cắt

                </button>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>

    <script src="~/js/Admin/Drink/drink.js"></script>

}
