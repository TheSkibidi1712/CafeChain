@model CafeChain.Application.DTOs.Inventories.OperationalIceReportDto
@using CafeChain.Application.Constants
@using System.Globalization
@{
    ViewData["Title"] = $"Báo cáo đá {Model.OperationalShiftName}";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var unit = string.IsNullOrWhiteSpace(Model.UnitName) ? "đơn vị tồn kho" : Model.UnitName;
    var viCulture = CultureInfo.GetCultureInfo("vi-VN");
    string Quantity(decimal value) => $"{value.ToString("0.##", viCulture)} {unit}";
    string NullableQuantity(decimal? value) => value.HasValue ? Quantity(value.Value) : "Chưa chốt";
    string Money(decimal? value) => value.HasValue ? $"{value.Value.ToString("N0", viCulture)} đ" : "Chưa đủ dữ liệu";
    string StatusLabel(string status) => status switch
    {
        OperationalIceStatuses.Draft => "Kế hoạch",
        OperationalIceStatuses.Open => "Đang vận hành",
        OperationalIceStatuses.PendingApproval => "Chờ duyệt chênh lệch",
        OperationalIceStatuses.ReconciliationRequired => "Cần đối soát",
        OperationalIceStatuses.Closed => "Đã đóng",
        OperationalIceStatuses.Cancelled => "Đã hủy",
        _ => status
    };
}
<link rel="stylesheet" href="~/css/Admin/OperationalIce/operational-ice.css" />

<main class="ice-shell ice-report-shell cc-warehouse-page">
    <header class="ice-page-header ice-detail-header cc-warehouse-header">
        <div>
            <a class="ice-back-link" asp-action="Details" asp-route-id="@Model.IceAllocationId">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Quay lại ca đá
            </a>
            <div class="ice-eyebrow">@Model.StoreName · @Model.BusinessDate.ToString("dd/MM/yyyy")</div>
            <h1>Báo cáo @Model.OperationalShiftName</h1>
            <p>@Model.IngredientName · Dữ liệu chi phí lấy từ FIFO và ledger kho.</p>
        </div>
        <div class="ice-header-actions">
            <a class="ice-btn ice-btn-primary" asp-action="DownloadReport" asp-route-id="@Model.IceAllocationId">
                <i class="fa-solid fa-file-pdf" aria-hidden="true"></i> Tải PDF
            </a>
            <button class="ice-btn ice-btn-secondary" type="button" onclick="window.print()">
                <i class="fa-solid fa-print" aria-hidden="true"></i> In báo cáo
            </button>
        </div>
    </header>

    @if (Model.HasUsageSnapshotMismatch)
    {
        <div class="ice-notice ice-notice-danger" role="alert">
            Snapshot lý thuyết khi chốt là @Quantity(Model.TheoreticalUsage), trong khi ledger hiện tại là @Quantity(Model.LedgerTheoreticalUsage).
            Cần đối soát dữ liệu đơn hàng liên kết trước khi sử dụng báo cáo.
        </div>
    }

    <section class="ice-report-meta">
        <article>
            <span>Ca vận hành</span>
            <strong>#@Model.OperationalShiftId · @Model.OperationalShiftName</strong>
            <small>@Model.StartAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm") – @Model.EndAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
        </article>
        <article>
            <span>Trạng thái</span>
            <strong>@StatusLabel(Model.Status)</strong>
            <small>Allocation #@Model.IceAllocationId</small>
        </article>
        <article>
            <span>WorkShift POS</span>
            <strong>@(Model.WorkShiftIds.Count == 0 ? "Chưa liên kết" : string.Join(", ", Model.WorkShiftIds.Select(x => $"#{x}")))</strong>
            <small>Nguồn tính tiêu hao lý thuyết</small>
        </article>
        <article>
            <span>Tình trạng giá vốn</span>
            <strong>@Model.CostStatus</strong>
            <small>Không dùng giá seed làm authority</small>
        </article>
    </section>

    <section class="ice-panel">
        <div class="ice-section-heading">
            <div>
                <span class="ice-section-kicker">Số lượng</span>
                <h2>Đối chiếu ca/ngày</h2>
            </div>
            <p>Thực tế = tồn chuyển đầu + tổng cấp − tồn chuyển cuối − trả kho hợp lệ.</p>
        </div>
        <div class="ice-report-quantity-grid">
            <article><span>Tồn chuyển đầu ca</span><strong>@Quantity(Model.OpeningCarry)</strong></article>
            <article><span>Cấp đầu ca</span><strong>@Quantity(Model.InitialIssued)</strong></article>
            <article><span>Cấp bổ sung</span><strong>@Quantity(Model.SupplementalIssued)</strong></article>
            <article><span>Trả kho hợp lệ</span><strong>@Quantity(Model.ReturnedQuantity)</strong></article>
            <article><span>Tồn chuyển cuối ca</span><strong>@Quantity(Model.ClosingCarry)</strong></article>
            <article><span>Dùng thực tế</span><strong>@NullableQuantity(Model.ActualUsage)</strong></article>
            <article><span>Dùng theo POS</span><strong>@Quantity(Model.TheoreticalUsage)</strong></article>
            <article class="@(Model.Variance is > 0 ? "is-danger" : Model.Variance is < 0 ? "is-warning" : "")"><span>Chênh lệch</span><strong>@NullableQuantity(Model.Variance)</strong></article>
        </div>
    </section>

    <section class="ice-panel">
        <div class="ice-section-heading">
            <div>
                <span class="ice-section-kicker">FIFO / Ledger</span>
                <h2>Giá vốn vận hành</h2>
            </div>
            <p>Ô thiếu dữ liệu được giữ trống có chủ đích, không nội suy từ giá seed.</p>
        </div>
        <div class="ice-report-cost-grid">
            <article><span>Giá vốn theo POS</span><strong>@Money(Model.TheoreticalCost)</strong></article>
            <article><span>Giá vốn chênh lệch</span><strong>@Money(Model.VarianceCost)</strong></article>
            <article><span>Giá vốn thực tế</span><strong>@Money(Model.ActualCost)</strong></article>
        </div>
        <p class="ice-report-cost-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> @Model.CostStatus</p>
    </section>

    <div class="ice-report-two-column">
        <section class="ice-panel">
            <div class="ice-section-heading">
                <div><span class="ice-section-kicker">Trách nhiệm</span><h2>Người giao / nhận / duyệt</h2></div>
            </div>
            <dl class="ice-audit-list">
                <div><dt>Người cấp đầu ca</dt><dd>@(Model.IssuedBy ?? "—")</dd></div>
                <div><dt>Ca trưởng / người nhận</dt><dd>@(Model.ShiftLead ?? "—")</dd></div>
                <div><dt>Người trả kho</dt><dd>@(Model.ReturnedBy ?? "—")</dd></div>
                <div><dt>Người nhận trả kho</dt><dd>@(Model.ReturnReceivedBy ?? "—")</dd></div>
                <div><dt>Người chốt</dt><dd>@(Model.ClosedBy ?? "—")</dd></div>
                <div><dt>Người duyệt điều chỉnh</dt><dd>@(Model.ApprovedBy ?? "—")</dd></div>
            </dl>
        </section>

        <section class="ice-panel">
            <div class="ice-section-heading">
                <div><span class="ice-section-kicker">Bàn giao</span><h2>Carry-over cùng ngày</h2></div>
            </div>
            @if (Model.CarryOvers.Count == 0)
            {
                <p class="ice-muted">Không phát sinh bàn giao giữa các ca.</p>
            }
            else
            {
                <div class="ice-report-list">
                    @foreach (var carry in Model.CarryOvers)
                    {
                        <article>
                            <strong>@carry.Direction @Quantity(carry.Quantity) · @carry.OtherShiftName</strong>
                            <span>@carry.HandedOverBy → @(carry.ReceivedBy ?? "Chưa xác nhận")</span>
                            <small>@carry.Status · @(carry.ConfirmedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa xác nhận")</small>
                        </article>
                    }
                </div>
            }
        </section>
    </div>

    <section class="ice-panel">
        <div class="ice-section-heading">
            <div>
                <span class="ice-section-kicker">Audit</span>
                <h2>Tham chiếu bút toán kho</h2>
            </div>
            <p>Mỗi chênh lệch dương chỉ có một idempotency key và một giao dịch kho.</p>
        </div>
        @if (Model.InventoryPostings.Count == 0)
        {
            <div class="ice-empty ice-empty-compact cc-warehouse-empty" role="status">
                <i class="fa-solid fa-check-circle" aria-hidden="true"></i>
                <h3>Không có bút toán điều chỉnh</h3>
                <p>Ca không phát sinh chênh lệch dương đã duyệt.</p>
            </div>
        }
        else
        {
            <div class="ice-table-scroll cc-warehouse-table-shell">
                <table class="ice-table">
                    <thead><tr><th>Posting</th><th>Idempotency key</th><th>Giao dịch kho</th><th class="ice-number">Số lượng</th><th class="ice-number">Giá trị</th><th>Người duyệt</th></tr></thead>
                    <tbody>
                    @foreach (var posting in Model.InventoryPostings)
                    {
                        <tr>
                            <td>#@posting.IceInventoryPostingId · @posting.PostingType</td>
                            <td><code>@posting.IdempotencyKey</code></td>
                            <td>@(posting.InventoryTransactionId.HasValue ? $"#{posting.InventoryTransactionId}" : "—")</td>
                            <td class="ice-number">@Quantity(posting.Quantity)</td>
                            <td class="ice-number">@Money(posting.TotalCost)</td>
                            <td>@posting.ApprovedBy<small>@posting.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.CloseReason) || !string.IsNullOrWhiteSpace(Model.ReconciliationReason))
    {
        <section class="ice-panel">
            <div class="ice-section-heading"><div><span class="ice-section-kicker">Đối soát</span><h2>Lý do và kết luận</h2></div></div>
            @if (!string.IsNullOrWhiteSpace(Model.CloseReason)) { <p><strong>Lý do chênh lệch:</strong> @Model.CloseReason</p> }
            @if (!string.IsNullOrWhiteSpace(Model.ReconciliationReason)) { <p><strong>Kết luận đối soát:</strong> @Model.ReconciliationReason</p> }
        </section>
    }
</main>
