        function setDefaultAddress(id) {
            const fd = new FormData();
            fd.append('id', id);
            fetch('/CustomerAddress/SetDefaultAddress', { method: 'POST', body: fd })
                .then(r => r.json())
                .then(res => {
                    if(res.success) location.reload();
                    else showToast(res.message, 'error');
                });
        }

        function deleteAddressAjax(id) {
            showConfirm({
                title: 'Xóa địa chỉ',
                message: 'Bạn có chắc muốn xóa địa chỉ giao hàng này không?',
                type: 'danger',
                okText: 'Xóa địa chỉ',
                cancelText: 'Giữ lại',
                onConfirm: function() {
                    const fd = new FormData();
                    fd.append('id', id);
                    fetch('/CustomerAddress/DeleteAddress', { method: 'POST', body: fd })
                        .then(r => r.json())
                        .then(res => {
                            if(res.success) location.reload();
                            else showToast(res.message, 'error');
                        });
                }
            });
        }
    </script>
