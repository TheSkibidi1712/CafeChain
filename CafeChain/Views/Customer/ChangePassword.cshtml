@model CafeChain.ViewModels.Customers.CustomerProfileViewModel
@* Tạm thời dùng lại ViewModel này để lấy thông tin Avatar/Tên bên cột trái *@

@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="container my-5">
    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
                <div class="position-relative d-inline-block mb-3">
                    <img src="@(Model?.Customer?.AvatarUrl ?? "/images/default-avatar.jpg")"
                         class="rounded-circle object-fit-cover"
                         style="width: 120px; height: 120px; border: 3px solid #d35400;" alt="Avatar">
                </div>

                <h4 class="fw-bold">@(Model?.Customer?.FullName ?? "Khách hàng")</h4>
                <p class="text-orange mb-4 small">Khách hàng thân thiết</p>

                <div class="gold-card text-white rounded-4 p-4 text-start mb-4 position-relative overflow-hidden">
                    <p class="small text-uppercase mb-1 opacity-75 fw-semibold">Hạng thành viên</p>
                    <h4 class="fw-bold mb-4">GOLD MEMBER <i class="bi bi-pencil-fill ms-2 fs-6 opacity-50"></i></h4>

                    <p class="small mb-1 opacity-75">Điểm tích lũy hiện tại</p>
                    <h2 class="fw-bold mb-3">1,250 <span class="fs-6 fw-normal">điểm</span></h2>

                    <div class="progress bg-white bg-opacity-25" style="height: 4px;">
                        <div class="progress-bar bg-white" style="width: 70%"></div>
                    </div>
                    <p class="mt-2 mb-0 fw-light" style="font-size: 0.65rem;">CAFECHAIN ELITE</p>
                </div>

                <div class="text-start profile-menu">
                    <a href="/Customer/Profile" class="nav-link rounded-3 p-3 mb-2 text-muted"><i class="bi bi-person me-3"></i> Hồ sơ cá nhân</a>
                    <a href="/Customer/OrderHistory" class="nav-link rounded-3 p-3 mb-2 text-muted"><i class="bi bi-clock-history me-3"></i> Lịch sử đơn hàng</a>
                    <a href="/Customer/MyVouchers" class="nav-link rounded-3 p-3 mb-2 text-muted"><i class="bi bi-gift me-3"></i> Ưu đãi của tôi</a>
                    <a href="/Customer/ChangePassword" class="nav-link active bg-orange-light text-orange fw-bold rounded-3 p-3 mb-2"><i class="bi bi-key me-3"></i> Đổi mật khẩu</a>
                    <hr class="my-3 opacity-10">
                    <partial name="~/Views/Shared/_LogoutForm.cshtml"
                             model="CafeChain.ViewModels.Shared.LogoutFormViewModel.CustomerMenu()" />
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <h3 class="fw-bold mb-2">Đổi mật khẩu</h3>
                <p class="text-muted small mb-4">Vì lý do bảo mật, vui lòng không chia sẻ mật khẩu của bạn cho người khác.</p>

                <form id="changePasswordForm">
                    <div class="mb-4">
                        <label class="form-label fw-bold small">Mật khẩu hiện tại</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-key text-orange"></i></span>
                            <input type="password" id="currentPassword" class="form-control bg-light border-0 py-2 shadow-none" placeholder="••••••••">
                            <span class="input-group-text bg-light border-0" style="cursor: pointer;" onclick="togglePassword('currentPassword', 'iconCurrent')">
                                <i class="bi bi-eye text-muted" id="iconCurrent"></i>
                            </span>
                        </div>
                    </div>

                    <div class="mb-4 position-relative">
                        <label class="form-label fw-bold small">Mật khẩu mới</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-key text-orange"></i></span>
                            <input type="password" id="newPassword" class="form-control bg-light border-0 py-2 shadow-none" placeholder="••••••••" oninput="validateNewPassword()">
                            <span class="input-group-text bg-light border-0" style="cursor: pointer;" onclick="togglePassword('newPassword', 'iconNew')">
                                <i class="bi bi-eye text-muted" id="iconNew"></i>
                            </span>
                        </div>
                        <span id="newPassError" class="text-danger small mt-1 position-absolute" style="top: 100%; left: 0; display: none;"></span>
                    </div>


                    <div class="mb-5 position-relative">
                        <label class="form-label fw-bold small">Xác nhận mật khẩu mới</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-shield-check text-orange"></i></span>
                            <input type="password" id="confirmPassword" class="form-control bg-light border-0 py-2 shadow-none" placeholder="••••••••" oninput="validateConfirmPassword()">
                            <span class="input-group-text bg-light border-0" style="cursor: pointer;" onclick="togglePassword('confirmPassword', 'iconConfirm')">
                                <i class="bi bi-eye text-muted" id="iconConfirm"></i>
                            </span>
                        </div>
                        <span id="confirmPassError" class="text-danger small mt-1 position-absolute" style="top: 100%; left: 0; display: none;"></span>
                    </div>

                    <div class="row g-3 mb-5">
                        <div class="col-md-6">
                            <button type="button" class="btn btn-orange w-100 rounded-3 py-2 fw-bold" onclick="submitPasswordChange()">
                                <i class="bi bi-arrow-repeat me-2"></i>Cập nhật mật khẩu
                            </button>
                        </div>
                        <div class="col-md-6">
                            <a href="/Customer/Profile" class="btn btn-outline-secondary w-100 rounded-3 py-2 fw-bold border-1">
                                <i class="bi bi-x me-2"></i>Hủy bỏ
                            </a>
                        </div>
                    </div>
                </form>

                <div class="p-3 rounded-4 bg-orange-light border border-orange-subtle d-flex gap-3">
                    <i class="bi bi-info-circle-fill text-orange fs-4"></i>
                    <div>
                        <h6 class="fw-bold mb-1 text-orange">Mẹo bảo mật</h6>
                        <p class="small text-muted mb-0">Mật khẩu mới đã được cập nhật và có hiệu lực ngay lập tức. Hãy ghi nhớ mật khẩu này cho những lần đăng nhập tiếp theo!</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="notificationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-sm">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-body text-center p-4 p-md-5">
                <div id="modalIcon" class="mb-4"></div>
                <h4 class="fw-bold mb-3" id="modalTitle">Thông báo</h4>
                <p class="text-muted mb-4" id="modalMessage">Nội dung chi tiết...</p>
                <button type="button" class="btn btn-orange w-100 rounded-3 py-2 fw-bold shadow-sm" id="modalBtn" data-bs-dismiss="modal">
                    Đã hiểu
                </button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <style>
        .gold-card {
            background-color: #d35400;
            box-shadow: 0 10px 20px rgba(211, 84, 0, 0.3);
        }

        .bg-orange-light {
            background-color: #fff3ed;
        }

        .text-orange {
            color: #d35400;
        }

        .btn-outline-secondary:hover {
            background-color: #f8f9fa;
            color: #6c757d;
        }
    </style>

    <script>
        let notificationModal;

         window.addEventListener('DOMContentLoaded', (event) => {
             const modalEl = document.getElementById('notificationModal');
             if (modalEl) {
                 notificationModal = new bootstrap.Modal(modalEl);
             }
         });

         function togglePassword(inputId, iconId) {
             const input = document.getElementById(inputId);
             const icon = document.getElementById(iconId);

             if (input.type === "password") {
                 input.type = "text";
                 icon.classList.replace("bi-eye", "bi-eye-slash");
             } else {
                 input.type = "password";
                 icon.classList.replace("bi-eye-slash", "bi-eye");
             }
         }

         // Tắt báo lỗi khi người dùng bắt đầu gõ lại
         function clearError(errorId) {
             const errorSpan = document.getElementById(errorId);
             if (errorSpan) {
                 errorSpan.style.display = 'none';
                 errorSpan.innerText = '';
             }
         }

         // Hàm bật báo lỗi đỏ dưới ô input
         function showInlineError(errorId, message) {
             const errorSpan = document.getElementById(errorId);
             if (errorSpan) {
                 errorSpan.innerText = message;
                 errorSpan.style.display = 'block';
             }
         }
         // Bắt lỗi khi đang gõ Mật khẩu mới
        function validateNewPassword() {
            const newPass = document.getElementById('newPassword').value;

            // Nếu xóa trắng thì tắt lỗi
            if (newPass.length === 0) {
                clearError('newPassError');
                return false;
            }

            const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}$/;
            if (!passwordRegex.test(newPass)) {
                showInlineError('newPassError', 'Mật khẩu phải có ít nhất 8 ký tự, bao gồm chữ hoa, chữ thường và chữ số.');
                return false;
            } else {
                clearError('newPassError');
                // Gọi luôn hàm check khớp để lỡ ô dưới có chữ sẵn thì nó tự tắt/bật lỗi cho đồng bộ
                validateConfirmPassword();
                return true;
            }
        }

        // Bắt lỗi khi đang gõ Xác nhận mật khẩu
        function validateConfirmPassword() {
            const newPass = document.getElementById('newPassword').value;
            const confirmPass = document.getElementById('confirmPassword').value;

            // Nếu xóa trắng thì tắt lỗi
            if (confirmPass.length === 0) {
                clearError('confirmPassError');
                return false;
            }

            if (newPass !== confirmPass) {
                showInlineError('confirmPassError', 'Xác nhận mật khẩu không trùng khớp.');
                return false;
            } else {
                clearError('confirmPassError');
                return true;
            }
        }
         // Hàm Modal thông báo
         function showMessage(type, message) {
             try {
                 const iconContainer = document.getElementById('modalIcon');
                 const titleEl = document.getElementById('modalTitle');
                 const messageEl = document.getElementById('modalMessage');

                 if (iconContainer && titleEl && messageEl && notificationModal) {
                     if (type === 'success') {
                         iconContainer.innerHTML = '<i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>';
                         titleEl.className = 'fw-bold mb-3 text-success';
                         titleEl.innerText = 'Thành công!';
                     } else {
                         iconContainer.innerHTML = '<i class="bi bi-x-circle-fill text-danger" style="font-size: 4rem;"></i>';
                         titleEl.className = 'fw-bold mb-3 text-danger';
                         titleEl.innerText = 'Thông báo';
                     }
                     messageEl.innerText = message;
                     notificationModal.show();
                     return;
                 }
             } catch (e) { console.log(e); }
             showToast(message, message.includes('lỗi') ? 'error' : 'success'); // Fallback
         }

         function submitPasswordChange() {
                    const current = document.getElementById('currentPassword').value;
                    const newPass = document.getElementById('newPassword').value;
                    const confirm = document.getElementById('confirmPassword').value;

                    // Kiểm tra rỗng
                    if(!current || !newPass || !confirm) {
                        showMessage('error', 'Vui lòng điền đầy đủ các trường mật khẩu.');
                        return;
                    }

                    // BẮT BUỘC Radar phải xanh (true) thì mới cho đi tiếp
                    const isNewPassValid = validateNewPassword();
                    const isConfirmValid = validateConfirmPassword();

                    if (!isNewPassValid || !isConfirmValid) {
                        return; // Nếu 1 trong 2 cái Radar đang báo lỗi đỏ thì ngưng luôn, không gọi Backend
                    }

                    const payload = {
                        CurrentPassword: current,
                        NewPassword: newPass,
                        ConfirmPassword: confirm
                    };

             let btn = document.querySelector('button[onclick="submitPasswordChange()"]');
             let originalText = btn.innerHTML;
             btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý...';
             btn.disabled = true;

             fetch('/Customer/UpdatePassword', {
                 method: 'POST',
                 headers: { 'Content-Type': 'application/json' },
                 body: JSON.stringify(payload)
             })
             .then(async res => {
                 if (!res.ok && res.status === 401) {
                     throw new Error("Bạn đã hết phiên đăng nhập. Vui lòng tải lại trang!");
                 }
                 return res.json();
             })
             .then(data => {
                 if(data.success) {
                     // Hiện Modal Thành Công
                     showMessage('success', data.message);
                     // Dọn dẹp form
                     document.getElementById('currentPassword').value = '';
                     document.getElementById('newPassword').value = '';
                     document.getElementById('confirmPassword').value = '';
                 } else {
                     // Nếu lỗi từ Backend (Sai pass cũ, Pass trùng nhau) -> Dùng Modal lỗi
                     showMessage('error', data.message);
                 }
             })
             .catch(err => {
                 console.error("Lỗi:", err);
                 let msg = err.message.includes("JSON")
                     ? "Lỗi máy chủ (Server Error). Vui lòng kiểm tra lại code C#!"
                     : err.message;
                 showMessage('error', msg);
             })
             .finally(() => {
                 if (btn) {
                     btn.innerHTML = originalText;
                     btn.disabled = false;
                 }
             });
         }
    </script>
}
