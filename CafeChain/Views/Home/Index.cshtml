            box-shadow: var(--cc-shadow-lg);
            color: #fff;
            display: grid;
            min-height: 320px;
            overflow: hidden;
            padding: 60px 32px;
            place-items: center;
            position: relative;
            text-align: center;
        }

        .cc-cta::before,
        .cc-cta::after {
            border: 1px solid rgba(255, 255, 255, .08);
            border-radius: 50%;
            content: "";
            height: 320px;
            position: absolute;
            width: 320px;
        }

        .cc-cta::before {
            bottom: -210px;
            left: -210px;
        }

        .cc-cta::after {
            right: -210px;
            top: -210px;
        }

        .cc-cta-content {
            max-width: 780px;
            position: relative;
            z-index: 1;
        }

        .cc-cta-label {
            color: #F4C6A6;
            font-size: 12px;
            font-weight: 900;
            letter-spacing: .1em;
            text-transform: uppercase;
        }

