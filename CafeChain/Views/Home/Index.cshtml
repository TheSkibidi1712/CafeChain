            gap: 35px;
            grid-template-columns: 1.5fr repeat(3, 1fr);
        }

        .cc-footer .cc-brand,
        .cc-footer .cc-brand-name {
            color: var(--cc-text);
        }

        .cc-footer .cc-brand-sub,
        .cc-footer p {
            color: var(--cc-muted);
        }

        .cc-footer p {
            font-size: 13px;
            line-height: 1.7;
            margin: 16px 0 0;
            max-width: 330px;
        }

        .cc-footer h3 {
            color: var(--cc-text);
            font-size: 13px;
            font-weight: 950;
            margin: 0 0 14px;
        }

        .cc-footer-links {
            display: grid;
            gap: 8px;
            justify-items: start;
        }

        .cc-footer-link {
            color: var(--cc-muted);
            min-height: auto;
            padding: 0;
            text-align: left;
        }

        .cc-footer-link:hover {
            background: transparent;
            color: var(--cc-primary);
        }

        .cc-footer-bottom {
            border-top: 1px solid var(--cc-line);
            color: #81736A;
            display: flex;
            font-size: 11px;
            gap: 18px;
            justify-content: space-between;
            margin-top: 34px;
            padding-top: 22px;
        }

        .js .reveal {
            opacity: 0;
            transform: translateY(26px);
            transition: opacity .62s ease, transform .62s ease;
        }

        .js .reveal[data-reveal="left"] {
            transform: translateX(-28px);
        }

        .js .reveal[data-reveal="right"] {
            transform: translateX(28px);
        }

        .js .reveal[data-delay="1"] {
            transition-delay: .08s;
        }

        .js .reveal[data-delay="2"] {
            transition-delay: .16s;
        }

        .js .reveal[data-delay="3"] {
            transition-delay: .24s;
        }

        .js .reveal.visible {
            opacity: 1;
            transform: translate(0, 0);
        }

        @@media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }

            *,
            *::before,
            *::after {
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
                scroll-behavior: auto !important;
                transition-duration: .01ms !important;
            }

            .js .reveal {
                opacity: 1;
                transform: none;
            }
        }

        @@media (min-width: 761px) {
            .cc-role-card {
                min-height: 420px;
            }

            .cc-role-card h3 {
                font-size: 22px;
                min-height: 30px;
                white-space: nowrap;
            }
        }

        @@media (max-width: 1080px) {
            .cc-container {
                padding: 0 20px;
            }

            .cc-menu-toggle {
                display: inline-flex;
            }

            .cc-nav {
                background: var(--cc-dark);
                border: 1px solid rgba(255, 255, 255, .12);
                border-radius: var(--cc-radius);
                box-shadow: 0 20px 50px rgba(0, 0, 0, .22);
                display: none;
                left: 20px;
                padding: 8px;
                position: absolute;
                right: 20px;
                top: calc(100% + 8px);
            }

            .cc-nav.open {
                display: grid;
            }

            .cc-nav button {
                justify-content: flex-start;
                width: 100%;
            }

            .cc-header-actions .cc-btn-secondary {
                display: none;
            }

            .cc-hero-inner {
                gap: 40px;
                grid-template-columns: 1fr;
            }

            .cc-hero-copy {
                max-width: 780px;
            }

            .cc-dashboard-stage {
                margin: 0 auto;
                max-width: 760px;
                width: 100%;
            }

            .cc-proof-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .cc-proof-intro {
                grid-column: 1 / -1;
            }

            .cc-solution-row,
            .cc-solution-row:nth-child(even) {
                gap: 36px;
                grid-template-columns: 1fr;
            }

            .cc-solution-row:nth-child(even) .cc-solution-copy {
                order: 0;
            }

            .cc-bento-card--wide,
            .cc-bento-card--narrow {
                grid-column: span 6;
            }

            .cc-role-grid {
                grid-template-columns: 1fr 1fr;
            }

            .cc-trust-grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .cc-footer-grid {
                grid-template-columns: 1fr 1fr;
            }

            .cc-footer-brand {
                grid-column: 1 / -1;
            }
        }

        @@media (max-width: 760px) {
            :root {
                --cc-header: 70px;
            }

            .cc-header-actions .cc-btn-primary,
            .cc-brand-sub {
                display: none;
            }

            .cc-hero {
                min-height: auto;
                padding: 58px 0 72px;
            }

            .cc-hero-title {
                font-size: 42px;
            }

            .cc-hero-desc {
                font-size: 15px;
            }

            .cc-hero-actions {
                display: grid;
                grid-template-columns: 1fr;
            }

            .cc-btn {
                width: 100%;
            }

            .cc-dashboard-stage {
                min-height: 420px;
                padding-bottom: 0;
            }

            .cc-dashboard-shell {
                grid-template-columns: 52px 1fr;
                min-height: 330px;
            }

            .cc-dashboard-sidebar {
                padding: 12px 7px;
            }

            .cc-side-logo {
                height: 29px;
                width: 29px;
            }

            .cc-dashboard-content {
                padding: 13px 0 0 10px;
            }

            .cc-stat-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .cc-stat-card:nth-child(n+3),
            .cc-alert-card,
            .cc-floating-chip {
                display: none;
            }

            .cc-dashboard-lower {
                grid-template-columns: 1fr;
            }

            .cc-chart-svg {
                height: 125px;
            }

            .cc-proof-grid {
                grid-template-columns: 1fr 1fr;
            }

            .cc-section {
                padding: 76px 0;
            }

            .cc-section-head {
                margin-bottom: 36px;
                text-align: left;
            }

            .cc-section-title {
                font-size: 34px;
            }

            .cc-solution-row {
                min-height: 0;
                padding: 24px 20px;
            }

            .cc-solution-copy h3 {
                font-size: 32px;
            }

            .cc-visual-panel {
                min-height: 310px;
            }

            .cc-overview-content {
                grid-template-columns: 1fr;
            }

            .cc-store-list,
            .cc-supplier-panel {
                display: none;
            }

            .cc-bars {
                height: 160px;
            }

            .cc-pos-shell {
                grid-template-columns: 64px 1fr;
                min-height: 315px;
            }

            .cc-pos-ticket {
                display: none;
            }

            .cc-product-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .cc-product-card:nth-child(3) {
                display: none;
            }

            .cc-inventory-summary,
            .cc-overview-kpis {
                grid-template-columns: 1fr;
            }

            .cc-table {
                font-size: 10px;
            }

            .cc-bento-grid,
            .cc-role-grid,
            .cc-trust-grid {
                grid-template-columns: 1fr;
            }

            .cc-bento-card--wide,
            .cc-bento-card--narrow {
                grid-column: auto;
            }

            .cc-role-card {
                min-height: 345px;
            }

            .cc-role-card h3,
            .cc-role-card > p {
                min-height: 0;
            }

            .cc-role-card ul {
                gap: 10px;
                grid-template-rows: none;
            }

            .cc-cta {
                min-height: 360px;
                padding: 48px 22px;
            }

            .cc-cta h2 {
                font-size: 34px;
            }

            .cc-footer-bottom {
                display: grid;
            }
        }

        @@media (max-width: 460px) {
            .cc-container {
                padding: 0 16px;
            }

            .cc-hero-title {
                font-size: 36px;
            }

            .cc-proof-grid,
            .cc-footer-grid {
                grid-template-columns: 1fr;
            }

            .cc-proof-intro {
                margin-bottom: 2px;
            }
        }
    </style>
    <noscript>
        <style>
            .reveal {
                opacity: 1 !important;
                transform: none !important;
            }
        </style>
    </noscript>
</head>
<body>
    <a class="cc-skip-link" href="#main-content">Bỏ qua điều hướng</a>

    <div class="cc-page">
        <header class="cc-header">
            <div class="cc-container">
                <div class="cc-header-inner">
                    <button class="cc-brand" type="button" data-scroll-target="home" aria-label="CafeChain về đầu trang">
                        <span class="cc-brand-mark" aria-hidden="true">
                            <svg class="cc-icon" viewBox="0 0 24 24">
                                <path d="M5 9h11v5a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5V9Z" />
                                <path d="M16 11h1.5a2.5 2.5 0 0 1 0 5H16" />
                                <path d="M8 4v2" />
                                <path d="M12 4v2" />
                            </svg>
                        </span>
                        <span>
                            <span class="cc-brand-name">CafeChain</span>
                            <span class="cc-brand-sub">Nền tảng vận hành</span>
                        </span>
                    </button>

                    <nav class="cc-nav" id="cc-main-nav" aria-label="Điều hướng chính">
                        <button type="button" data-scroll-target="home" aria-current="location">Trang chủ</button>
                        <button type="button" data-scroll-target="solutions">Giải pháp</button>
                        <button type="button" data-scroll-target="capabilities">Tính năng</button>
                        <button type="button" data-scroll-target="roles">Vai trò</button>
                        <button type="button" data-scroll-target="trust">Tin cậy</button>
                    </nav>

                    <div class="cc-header-actions">
                        @{
                            var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
                            var isEn = currentCulture == "en-US";
                        }
                        <a href="/ui-preferences/culture?culture=@(isEn ? "vi-VN" : "en-US")&returnUrl=/"
                           class="cc-lang-switcher"
                           title="@(isEn ? "Chuyển sang Tiếng Việt" : "Switch to English")">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M2 12h20"/>
                                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                            </svg>
                            @if (isEn) {
                                <span class="cc-lang-active">EN</span><span class="cc-lang-divider">/</span><span>VI</span>
                            } else {
                                <span class="cc-lang-active">VI</span><span class="cc-lang-divider">/</span><span>EN</span>
                            }
                        </a>
                        <a asp-controller="@accessController" asp-action="@accessAction" class="cc-btn cc-btn-ghost">@accessText</a>
                        <button class="cc-menu-toggle" type="button" aria-controls="cc-main-nav" aria-expanded="false" aria-label="Mở menu">
                            <svg class="cc-icon" viewBox="0 0 24 24">
                                <path d="M4 7h16" />
                                <path d="M4 12h16" />
                                <path d="M4 17h16" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </header>

        <main id="main-content">
            <section class="cc-section cc-hero" id="home">
                <div class="cc-container cc-hero-inner">
                    <div class="cc-hero-copy reveal" data-reveal="left">
                        <span class="cc-eyebrow">
                            <svg class="cc-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M13 2 4 14h7l-1 8 10-13h-7l1-7Z" />
                            </svg>
                            Bán hàng · Xếp ca · Kho · Nhà cung cấp
                        </span>
                        <h1 class="cc-hero-title">Vận hành chuỗi cửa hàng trên <span>một hệ thống.</span></h1>
                        <p class="cc-hero-desc">
                            CafeChain kết hợp bán hàng tại quầy, quản lý nhân viên, xếp ca, kho, nhà cung cấp, phân quyền và bảng điều hành để chủ chuỗi theo dõi vận hành rõ ràng từ một nơi.
                        </p>
                        <div class="cc-hero-actions">
                            <button type="button" class="cc-btn cc-btn-primary" data-scroll-target="solutions">
                                Khám phá hệ thống
                                <svg class="cc-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="m9 18 6-6-6-6" />
                                </svg>
                            </button>
                            <a asp-controller="@accessController" asp-action="@accessAction" class="cc-btn cc-btn-secondary">
                                <svg class="cc-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                                    <path d="m10 17 5-5-5-5" />
                                    <path d="M15 12H3" />
                                </svg>
                                @accessText
                            </a>
                        </div>
                        <div class="cc-hero-note" aria-label="Điểm nổi bật">
                            <span>Bán hàng liền mạch</span>
                            <span>Kho rõ tồn và lô</span>
                            <span>Quyền đúng phạm vi</span>
                        </div>
                    </div>

                    <div class="cc-dashboard-stage reveal" data-reveal="right" aria-label="Ảnh minh họa bảng điều hành CafeChain">
                        <div class="cc-dashboard-window">
                            <div class="cc-window-bar">
                                <div class="cc-window-dots" aria-hidden="true"><i></i><i></i><i></i></div>
                                <span class="cc-window-status">Hệ thống hoạt động</span>
                            </div>
                            <div class="cc-dashboard-shell">
                                <aside class="cc-dashboard-sidebar" aria-hidden="true">
                                    <div class="cc-side-logo">
                                        <svg class="cc-icon" viewBox="0 0 24 24">
                                            <path d="M5 9h11v5a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5V9Z" />
                                            <path d="M16 11h1.5a2.5 2.5 0 0 1 0 5H16" />
                                        </svg>
                                    </div>
                                    <div class="cc-side-item is-active"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h7v7H4z" /><path d="M13 4h7v7h-7z" /><path d="M4 13h7v7H4z" /><path d="M13 13h7v7h-7z" /></svg></div>
                                    <div class="cc-side-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 6h14" /><path d="M5 12h14" /><path d="M5 18h9" /></svg></div>
                                    <div class="cc-side-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 7 9-4 9 4-9 4-9-4Z" /><path d="m3 12 9 4 9-4" /></svg></div>
                                    <div class="cc-side-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" /><path d="M4 22a8 8 0 0 1 16 0" /></svg></div>
                                </aside>
                                <div class="cc-dashboard-content">
                                    <div class="cc-dashboard-heading">
                                        <div>
                                            <strong>Chào buổi sáng, Quản lý</strong>
                                            <small>Tổng quan vận hành toàn chuỗi</small>
                                        </div>
                                        <span class="cc-demo-label">03 ca làm đang mở</span>
                                    </div>
                                    <div class="cc-stat-grid">
                                        <div class="cc-stat-card"><small>Doanh thu hôm nay</small><strong>28,6 triệu</strong><span class="cc-stat-trend">+8,4%</span></div>
                                        <div class="cc-stat-card"><small>Đơn bán</small><strong>486</strong><span class="cc-stat-trend">Đã hoàn tất</span></div>
                                        <div class="cc-stat-card"><small>Giá trị tồn</small><strong>58.900đ</strong><span class="cc-stat-trend">Ổn định</span></div>
                                        <div class="cc-stat-card"><small>Phiếu chờ duyệt</small><strong>03</strong><span class="cc-stat-trend">Đúng hạn</span></div>
                                    </div>
                                    <div class="cc-dashboard-lower">
                                        <div class="cc-chart-card">
                                            <div class="cc-card-title"><span>Doanh thu 7 ngày</span><span>Theo cửa hàng</span></div>
                                            <svg class="cc-chart-svg" viewBox="0 0 420 170" aria-hidden="true">
                                                <path d="M8 145 C64 112, 90 118, 138 92 S218 74, 266 56 341 34, 412 39" fill="none" stroke="#C67A45" stroke-width="5" stroke-linecap="round" />
                                                <path d="M8 145 C64 112, 90 118, 138 92 S218 74, 266 56 341 34, 412 39 L412 166 L8 166Z" fill="rgba(198,122,69,.14)" />
                                                <g stroke="rgba(111,78,55,.12)" stroke-width="1">
                                                    <path d="M8 132h404" /><path d="M8 96h404" /><path d="M8 60h404" />
                                                </g>
                                            </svg>
                                        </div>
                                        <div class="cc-alert-card">
                                            <div class="cc-card-title"><span>Cần chú ý</span><span>4 cảnh báo</span></div>
                                            <div class="cc-alert-row"><span class="cc-alert-icon">!</span><span class="cc-alert-copy"><strong>Tồn kho thấp</strong><small>Ly nhựa M · Cửa hàng 02</small></span></div>
                                            <div class="cc-alert-row"><span class="cc-alert-icon">₫</span><span class="cc-alert-copy"><strong>Ca mở trễ</strong><small>Cần quản lý xác nhận</small></span></div>
                                            <div class="cc-alert-row"><span class="cc-alert-icon">✓</span><span class="cc-alert-copy"><strong>Phiếu chờ duyệt</strong><small>2 phiếu nhập kho</small></span></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="cc-floating-chip cc-floating-chip--sync">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 0 1 15-6.7" /><path d="M18 3v5h-5" /><path d="M21 12a9 9 0 0 1-15 6.7" /><path d="M6 21v-5h5" /></svg>
                            Dữ liệu nhất quán
                        </div>
                        <div class="cc-floating-chip cc-floating-chip--shift">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2v4" /><path d="M16 2v4" /><path d="M3 10h18" /><path d="M5 4h14v18H5z" /></svg>
                            Xếp ca đang mở
                        </div>
                    </div>
                </div>
            </section>

            <section class="cc-proof" aria-label="Năng lực cốt lõi">
                <div class="cc-container cc-proof-grid reveal">
                    <div class="cc-proof-intro">Nền tảng hợp nhất cho chuỗi cửa hàng</div>
                    <div class="cc-proof-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h16v16H4z" /><path d="M8 8h8v8H8z" /></svg> Bán hàng tại quầy</div>
                    <div class="cc-proof-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 2v4" /><path d="M16 2v4" /><path d="M3 10h18" /><path d="M5 4h14v18H5z" /></svg> Xếp ca</div>
                    <div class="cc-proof-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m3 7 9-4 9 4-9 4-9-4Z" /><path d="m3 12 9 4 9-4" /><path d="M3 17l9 4 9-4" /></svg> Kho · Định mức · Lớp giá</div>
                    <div class="cc-proof-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 20V8l8-4 8 4v12" /><path d="M9 20v-6h6v6" /></svg> Nhà cung cấp</div>
                </div>
            </section>

            <section class="cc-section" id="solutions" aria-labelledby="ccSolutionsTitle">
                <div class="cc-container">
                    <div class="cc-section-head reveal">
                        <div class="cc-kicker">Giải pháp vận hành</div>
                        <h2 class="cc-section-title" id="ccSolutionsTitle">Một luồng dữ liệu xuyên suốt từ quầy bán đến quản trị.</h2>
                        <p class="cc-section-desc">
                            Các màn hình dưới đây mô phỏng cách CafeChain kết nối bảng điều hành, bán hàng và kho trong một trải nghiệm thống nhất.
                        </p>
                    </div>

                    <div class="cc-solution-stack">
                        <article class="cc-solution-row reveal">
                            <div class="cc-solution-copy">
                                <div class="cc-solution-index">01 · Tổng quan</div>
                                <h3>Bảng điều hành đa cửa hàng theo đúng phạm vi quyền.</h3>
                                <p>Chủ doanh nghiệp và quản lý theo dõi doanh thu, đơn hàng, thanh toán, tồn kho, phiên kết và hiệu suất vận hành theo cửa hàng được cấp quyền.</p>
                                <ul class="cc-check-list">
                                    <li>Doanh thu, đơn bán và phương thức thanh toán</li>
                                    <li>Ca làm đang mở và chênh lệch phiên kết</li>
                                    <li>Tồn kho, hao hụt, âm kho và giá trị theo lớp giá</li>
                                </ul>
                                <button class="cc-text-link" type="button" data-scroll-target="capabilities">Xem các năng lực hệ thống <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6" /></svg></button>
                            </div>
                            <div class="cc-visual-panel" aria-label="Bảng điều hành đa cửa hàng minh họa">
                                <div class="cc-visual-card">
                                    <div class="cc-visual-toolbar"><strong>Tổng quan toàn chuỗi</strong><small>30 ngày gần nhất</small></div>
                                    <div class="cc-overview-body">
                                        <div class="cc-overview-kpis">
                                            <div><small>Cửa hàng hoạt động</small><strong>05</strong></div>
                                            <div><small>Đơn đã hoàn tất</small><strong>4.862</strong></div>
                                            <div><small>Cảnh báo mở</small><strong>07</strong></div>
                                        </div>
                                        <div class="cc-overview-content">
                                            <div class="cc-bars" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
                                            <div class="cc-store-list">
                                                <div class="cc-store-row"><strong><span>Nguyễn Văn Linh</span><span>31%</span></strong><small>Đang hoạt động</small></div>
                                                <div class="cc-store-row"><strong><span>Thủ Dầu Một</span><span>27%</span></strong><small>Đang hoạt động</small></div>
                                                <div class="cc-store-row"><strong><span>Dĩ An</span><span>22%</span></strong><small>1 cảnh báo tồn</small></div>
                                                <div class="cc-store-row"><strong><span>Thuận An</span><span>20%</span></strong><small>Đang hoạt động</small></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </article>

                        <article class="cc-solution-row reveal">
                            <div class="cc-solution-copy">
                                <div class="cc-solution-index">02 · Bán hàng</div>
                                <h3>Bán hàng tại quầy nhanh, ổn định và rõ ràng.</h3>
                                <p>Phân hệ bán hàng tại quầy giúp nhân viên chọn món, tạo phiếu và thanh toán thuận tiện trong mỗi ca làm việc.</p>
                                <ul class="cc-check-list">
                                    <li>Danh mục đồ uống, kích cỡ và món thêm theo cửa hàng</li>
                                    <li>Thanh toán và in phiếu bán ngay tại quầy</li>
                                    <li>Theo dõi món đã chọn và tổng tiền rõ ràng</li>
                                </ul>
                            </div>
                            <div class="cc-visual-panel" aria-label="Màn hình bán hàng minh họa">
                                <div class="cc-visual-card">
                                    <div class="cc-visual-toolbar"><strong>Bán hàng · CN Nguyễn Văn Linh</strong><small>Ca sáng · 07:00</small></div>
                                    <div class="cc-pos-shell">
                                        <div class="cc-pos-categories">
                                            <strong>Danh mục</strong>
                                            <div class="cc-category-pill is-active">Tất cả</div>
                                            <div class="cc-category-pill">Cà phê</div>
                                            <div class="cc-category-pill">Trà</div>
                                            <div class="cc-category-pill">Đá xay</div>
