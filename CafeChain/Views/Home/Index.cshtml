@model CafeChain.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "CafeChain - Nền tảng vận hành chuỗi cửa hàng";
    Layout = null;

    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isStaffAuthenticated = isAuthenticated && User.HasClaim(claim => claim.Type == "StaffId");
    var isCustomerAuthenticated = isAuthenticated
        && !isStaffAuthenticated
        && User.HasClaim(claim => claim.Type == "CustomerId");
    var accessController = isStaffAuthenticated
        ? "AppLauncher"
        : isCustomerAuthenticated
            ? "Customer"
            : "Account";
    var accessAction = isStaffAuthenticated
        ? "Index"
        : isCustomerAuthenticated
            ? "Profile"
            : "Login";
    var accessText = isStaffAuthenticated
        ? "Chọn ứng dụng"
        : isCustomerAuthenticated
            ? "Tài khoản của tôi"
            : "Đăng nhập hệ thống";
}

<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="CafeChain là nền tảng vận hành chuỗi cửa hàng với bán hàng tại quầy, quản lý nhân viên, xếp ca, kho theo lớp giá nhập trước xuất trước, nhà cung cấp, báo cáo và phân quyền theo cửa hàng." />
    <title>@ViewData["Title"]</title>
    <script>
        document.documentElement.classList.add("js");
    </script>
    <style>
        :root {
            --cc-bg: #F7F3EE;
            --cc-surface: #FFFFFF;
            --cc-primary: #6F4E37;
            --cc-primary-hover: #5C3F2B;
            --cc-accent: #C67A45;
            --cc-text: #1F2937;
            --cc-muted: #475569;
            --cc-success: #2F6F5E;
            --cc-warning: #99623B;
            --cc-danger: #991B1B;
            --cc-dark: #2B1A13;
            --cc-dark-2: #39251C;
            --cc-line: rgba(111, 78, 55, .18);
            --cc-line-strong: rgba(111, 78, 55, .32);
            --cc-soft: rgba(198, 122, 69, .13);
            --cc-soft-strong: rgba(198, 122, 69, .22);
            --cc-green-soft: rgba(47, 111, 94, .12);
            --cc-shadow-sm: 0 10px 28px rgba(31, 41, 55, .07);
            --cc-shadow-md: 0 18px 46px rgba(111, 78, 55, .14);
            --cc-shadow-lg: 0 28px 72px rgba(31, 41, 55, .18);
            --cc-radius: 8px;
            --cc-header: 72px;
            --cc-container: 1180px;
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background:
                linear-gradient(180deg, #FFFDF9 0, var(--cc-bg) 46%, #FFFDF9 100%);
            color: var(--cc-text);
            font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
            line-height: 1.55;
            overflow-x: hidden;
            text-rendering: geometricPrecision;
        }

        a {
            color: inherit;
        }

        button,
        input {
            font: inherit;
        }

        button {
            cursor: pointer;
        }

        svg {
            display: block;
        }

        .cc-skip-link {
            background: var(--cc-primary-hover);
            border-radius: var(--cc-radius);
            color: var(--cc-surface);
            font-weight: 800;
            left: 16px;
            padding: 10px 14px;
            position: fixed;
            text-decoration: none;
            top: 12px;
            transform: translateY(-140%);
            transition: transform .2s ease;
            z-index: 3000;
        }

        .cc-skip-link:focus {
            transform: translateY(0);
        }

        .cc-page {
            min-height: 100vh;
            overflow-x: clip;
            position: relative;
        }

        .cc-page p,
        .cc-page li,
        .cc-page small {
            text-wrap: pretty;
        }

        .cc-page h1,
        .cc-page h2,
        .cc-page h3,
        .cc-page strong {
            text-wrap: balance;
        }

        .cc-container {
            margin: 0 auto;
            max-width: var(--cc-container);
            padding: 0 28px;
            width: 100%;
        }

        .cc-header {
            background: rgba(43, 26, 19, .96);
            border-bottom: 1px solid rgba(255, 255, 255, .08);
            color: var(--cc-surface);
            left: 0;
            position: sticky;
            right: 0;
            top: 0;
            z-index: 1000;
        }

        .cc-header-inner {
            align-items: center;
            display: flex;
            gap: 22px;
            min-height: var(--cc-header);
            position: relative;
        }

        .cc-brand {
            align-items: center;
            background: transparent;
            border: 0;
            color: inherit;
            display: inline-flex;
            flex: 0 0 auto;
            gap: 11px;
            padding: 0;
            text-align: left;
            text-decoration: none;
        }

        .cc-brand-mark {
            align-items: center;
            background: linear-gradient(135deg, var(--cc-accent), #8A4A2E);
            border-radius: var(--cc-radius);
            color: #fff;
            display: inline-flex;
            height: 38px;
            justify-content: center;
            width: 38px;
        }

        .cc-brand-name {
            display: block;
            font-size: 17px;
            font-weight: 900;
            line-height: 1;
        }

        .cc-brand-sub {
            color: rgba(255, 255, 255, .66);
            display: block;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .08em;
            margin-top: 5px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .cc-nav {
            align-items: center;
            display: flex;
            flex: 1;
            gap: 4px;
            justify-content: center;
        }

        .cc-nav button,
        .cc-footer-link {
            background: transparent;
            border: 0;
            border-radius: var(--cc-radius);
            color: rgba(255, 255, 255, .74);
            font-size: 13px;
            font-weight: 800;
            min-height: 40px;
            padding: 9px 12px;
        }

        .cc-nav button:hover,
        .cc-nav button[aria-current="location"] {
            background: rgba(255, 255, 255, .1);
            color: #fff;
        }

        .cc-header-actions {
            align-items: center;
            display: flex;
            gap: 10px;
        }

        .cc-menu-toggle {
            align-items: center;
            background: rgba(255, 255, 255, .06);
            border: 1px solid rgba(255, 255, 255, .18);
            border-radius: var(--cc-radius);
            color: #fff;
            display: none;
            height: 42px;
            justify-content: center;
            width: 42px;
        }

        .cc-btn {
            align-items: center;
            border: 1px solid transparent;
            border-radius: var(--cc-radius);
            display: inline-flex;
            gap: 8px;
            justify-content: center;
            min-height: 44px;
            padding: 10px 17px;
            text-decoration: none;
            white-space: nowrap;
            font-size: 14px;
            font-weight: 850;
            transition: background .2s ease, border-color .2s ease, box-shadow .2s ease, color .2s ease, transform .2s ease;
        }

        .cc-btn:hover {
            transform: translateY(-1px);
        }

        .cc-btn-primary {
            background: var(--cc-accent);
            border-color: var(--cc-accent);
            box-shadow: 0 14px 28px rgba(198, 122, 69, .25);
            color: #fff;
        }

        .cc-btn-primary:hover {
            background: #B66F3F;
            border-color: #B66F3F;
        }

        .cc-btn-secondary {
            background: rgba(255, 255, 255, .92);
            border-color: var(--cc-line);
            color: var(--cc-primary);
        }

        .cc-btn-secondary:hover {
            background: #fff;
            border-color: var(--cc-line-strong);
        }

        .cc-btn-ghost {
            background: transparent;
            border-color: rgba(255, 255, 255, .24);
            color: #fff;
        }

        .cc-btn-ghost:hover {
            background: rgba(255, 255, 255, .08);
        }

        /* ── Language Switcher ── */
        .cc-lang-switcher {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border: 1.5px solid rgba(198, 122, 69, .45);
            border-radius: 100px;
            padding: 6px 14px 6px 10px;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .04em;
            color: rgba(255,255,255,.82);
            background: rgba(198,122,69,.08);
            cursor: pointer;
            transition: background .22s ease, border-color .22s ease, color .22s ease, transform .18s ease;
            text-decoration: none;
            white-space: nowrap;
            position: relative;
            overflow: hidden;
        }
        .cc-lang-switcher::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(198,122,69,.15), rgba(111,78,55,.1));
            opacity: 0;
            transition: opacity .22s ease;
            border-radius: inherit;
        }
        .cc-lang-switcher:hover {
            border-color: rgba(198,122,69,.8);
            color: #fff;
            transform: translateY(-1px);
            background: rgba(198,122,69,.16);
        }
        .cc-lang-switcher:hover::before { opacity: 1; }
        .cc-lang-switcher svg {
            width: 15px;
            height: 15px;
            flex-shrink: 0;
            opacity: .85;
            transition: opacity .2s, transform .4s ease;
        }
        .cc-lang-switcher:hover svg {
            opacity: 1;
            transform: rotate(20deg);
        }
        .cc-lang-switcher .cc-lang-active {
            color: var(--cc-accent);
            font-weight: 900;
        }
        .cc-lang-divider {
            opacity: .35;
            margin: 0 1px;
        }

        .cc-icon {
            display: block;
            fill: none;
            height: 20px;
            stroke: currentColor;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke-width: 2;
            width: 20px;
        }

        .cc-section {
            padding: 96px 0;
            scroll-margin-top: calc(var(--cc-header) + 22px);
        }

        .cc-hero {
            align-items: center;
            background:
                linear-gradient(rgba(111, 78, 55, .05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(111, 78, 55, .05) 1px, transparent 1px),
                linear-gradient(180deg, #FFFDF9 0, var(--cc-bg) 100%);
            background-size: 48px 48px, 48px 48px, auto;
            display: flex;
            min-height: calc(100svh - var(--cc-header));
            overflow: hidden;
            padding: 78px 0 88px;
            position: relative;
        }

        .cc-hero::after {
            background: linear-gradient(90deg, transparent, var(--cc-line), transparent);
            bottom: 0;
            content: "";
            height: 1px;
            left: 0;
            position: absolute;
            right: 0;
        }

        .cc-hero-inner {
            align-items: center;
            display: grid;
            gap: 62px;
            grid-template-columns: minmax(0, .92fr) minmax(520px, 1.08fr);
        }

        .cc-hero-copy {
            max-width: 650px;
            position: relative;
            z-index: 2;
        }

        .cc-eyebrow,
        .cc-kicker {
            align-items: center;
            color: var(--cc-primary);
            display: inline-flex;
            font-size: 12px;
            font-weight: 900;
            gap: 8px;
            letter-spacing: .05em;
            text-transform: uppercase;
        }

        .cc-eyebrow {
            background: rgba(255, 255, 255, .84);
            border: 1px solid var(--cc-line);
            border-radius: var(--cc-radius);
            margin-bottom: 22px;
            padding: 8px 11px;
        }

        .cc-kicker {
            margin-bottom: 14px;
        }

        .cc-kicker::before {
            background: currentColor;
            content: "";
            height: 1px;
            width: 30px;
        }

        .cc-hero-title {
            color: var(--cc-text);
            font-size: 64px;
            font-weight: 950;
            letter-spacing: 0;
            line-height: 1.02;
            margin: 0;
            max-width: 680px;
            text-wrap: balance;
        }

        .cc-hero-title span {
            color: var(--cc-primary);
        }

        .cc-hero-desc {
            color: var(--cc-muted);
            font-size: 17px;
            line-height: 1.78;
            margin: 24px 0 0;
            max-width: 620px;
            text-wrap: pretty;
        }

        .cc-hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 32px;
        }

        .cc-hero-note {
            color: #6A5B51;
            display: flex;
            flex-wrap: wrap;
            gap: 10px 18px;
            margin-top: 24px;
            font-size: 12px;
            font-weight: 800;
        }

        .cc-hero-note span {
            align-items: center;
            display: inline-flex;
            gap: 8px;
        }

        .cc-hero-note span::before {
            background: var(--cc-accent);
            border-radius: 999px;
            content: "";
            height: 5px;
            width: 5px;
        }

        .cc-dashboard-stage {
            min-height: 520px;
            padding-bottom: 54px;
            position: relative;
        }

        .cc-dashboard-window {
            background: rgba(255, 255, 255, .95);
            border: 1px solid var(--cc-line);
            border-radius: var(--cc-radius);
            box-shadow: var(--cc-shadow-lg);
            overflow: hidden;
            position: relative;
        }

        .cc-window-bar {
            align-items: center;
            border-bottom: 1px solid var(--cc-line);
            display: flex;
            height: 38px;
            justify-content: space-between;
            padding: 0 13px;
        }

        .cc-window-dots {
            display: flex;
            gap: 6px;
        }

        .cc-window-dots i {
            background: #D7C3B2;
            border-radius: 50%;
            height: 7px;
            width: 7px;
        }

        .cc-window-status {
            align-items: center;
            color: var(--cc-success);
            display: inline-flex;
            gap: 7px;
            font-size: 11px;
            font-weight: 900;
        }

        .cc-window-status::before {
            background: currentColor;
            border-radius: 999px;
            content: "";
            height: 7px;
            width: 7px;
        }

        .cc-dashboard-shell {
            display: grid;
            grid-template-columns: 82px 1fr;
            min-height: 430px;
            padding: 14px;
        }

        .cc-dashboard-sidebar {
            background: var(--cc-dark);
            border-radius: var(--cc-radius);
            color: rgba(255, 255, 255, .62);
            padding: 16px 10px;
        }

        .cc-side-logo {
            align-items: center;
            background: var(--cc-accent);
            border-radius: var(--cc-radius);
            color: #fff;
            display: flex;
            height: 36px;
            justify-content: center;
            margin: 0 auto 20px;
            width: 36px;
        }

        .cc-side-item {
            align-items: center;
            border-radius: var(--cc-radius);
            display: flex;
            height: 32px;
            justify-content: center;
            margin-bottom: 8px;
        }

        .cc-side-item.is-active {
            background: rgba(255, 255, 255, .12);
            color: #fff;
        }

        .cc-side-item svg {
            height: 16px;
            width: 16px;
        }

        .cc-dashboard-content {
            display: grid;
            gap: 14px;
            padding: 18px 0 0 18px;
        }

        .cc-dashboard-heading {
            align-items: center;
            display: flex;
            gap: 16px;
            justify-content: space-between;
            min-height: 42px;
        }

        .cc-dashboard-heading strong {
            display: block;
            font-size: 17px;
        }

        .cc-dashboard-heading small {
            color: #8A7D74;
            display: block;
            font-size: 11px;
            margin-top: 4px;
        }

        .cc-demo-label {
            background: var(--cc-soft);
            border: 1px solid var(--cc-line);
            border-radius: var(--cc-radius);
            color: var(--cc-primary);
            font-size: 11px;
            font-weight: 900;
            padding: 8px 10px;
            white-space: nowrap;
        }

        .cc-stat-grid {
            display: grid;
            gap: 10px;
            grid-template-columns: repeat(4, 1fr);
        }

        .cc-stat-card {
            background: #fff;
            border: 1px solid var(--cc-line);
            border-radius: var(--cc-radius);
            display: grid;
            grid-template-rows: 30px 25px 16px;
            min-height: 105px;
            padding: 12px 10px;
            row-gap: 4px;
        }

        .cc-stat-card small {
            color: #81736A;
            display: block;
            font-size: 10px;
            font-weight: 800;
            line-height: 1.35;
        }

        .cc-stat-card strong {
            color: var(--cc-text);
            display: block;
            font-size: 18px;
            line-height: 1.25;
            margin-top: 0;
            white-space: nowrap;
        }

        .cc-stat-trend {
            color: var(--cc-success);
            display: block;
            font-size: 10px;
            font-weight: 900;
            line-height: 1.4;
            margin-top: 0;
        }

        .cc-dashboard-lower {
            display: grid;
            gap: 12px;
            grid-template-columns: minmax(0, 1.55fr) minmax(160px, .7fr);
        }

        .cc-chart-card,
        .cc-alert-card {
            background: #fff;
            border: 1px solid var(--cc-line);
            border-radius: var(--cc-radius);
            padding: 14px;
        }

        .cc-card-title {
            align-items: center;
            display: flex;
            font-size: 12px;
            font-weight: 900;
            justify-content: space-between;
            margin-bottom: 10px;
        }

        .cc-card-title span:last-child {
            color: #8A7D74;
            font-size: 10px;
            font-weight: 700;
        }

        .cc-chart-svg {
            height: 160px;
            width: 100%;
        }

        .cc-alert-row {
            align-items: center;
            border-bottom: 1px solid rgba(111, 78, 55, .12);
            display: grid;
            gap: 8px;
            grid-template-columns: 28px 1fr;
            padding: 9px 0;
        }

        .cc-alert-row:last-child {
            border-bottom: 0;
        }

        .cc-alert-icon {
            align-items: center;
            background: var(--cc-soft);
            border-radius: var(--cc-radius);
            color: var(--cc-primary);
            display: flex;
            height: 28px;
            justify-content: center;
            width: 28px;
        }

        .cc-alert-copy strong {
            display: block;
            font-size: 11px;
        }

        .cc-alert-copy small {
            color: #81736A;
            display: block;
            font-size: 10px;
            margin-top: 2px;
        }

        .cc-floating-chip {
            align-items: center;
            background: rgba(255, 255, 255, .96);
            border: 1px solid var(--cc-line);
            border-radius: var(--cc-radius);
            box-shadow: var(--cc-shadow-sm);
            color: #5D4333;
            display: flex;
            font-size: 12px;
            font-weight: 900;
            gap: 8px;
            padding: 10px 12px;
            position: absolute;
            z-index: 3;
        }

        .cc-floating-chip svg {
            color: var(--cc-success);
            height: 16px;
            width: 16px;
        }

        .cc-floating-chip--sync {
            bottom: 0;
            left: 18px;
        }

        .cc-floating-chip--shift {
            bottom: 0;
            right: 18px;
            top: auto;
        }

        .cc-floating-chip--shift svg {
            color: var(--cc-accent);
        }

        .cc-proof {
            background: rgba(255, 255, 255, .72);
            border-bottom: 1px solid var(--cc-line);
        }

        .cc-proof-grid {
            align-items: center;
            display: grid;
            gap: 18px;
            grid-template-columns: 1.25fr repeat(4, 1fr);
            padding: 24px 0;
        }

        .cc-proof-intro {
            color: var(--cc-muted);
            font-size: 13px;
            font-weight: 850;
            text-wrap: pretty;
        }

        .cc-proof-item {
            align-items: center;
            color: #51423A;
            display: flex;
            font-size: 13px;
            font-weight: 900;
            gap: 10px;
        }

        .cc-proof-item svg {
            color: var(--cc-accent);
            height: 20px;
            width: 20px;
        }

        .cc-section-soft {
            background: rgba(255, 255, 255, .62);
            border-bottom: 1px solid var(--cc-line);
            border-top: 1px solid var(--cc-line);
        }

        .cc-section-dark {
            background: var(--cc-dark);
            color: #fff;
        }

        .cc-section-head {
            margin: 0 auto 52px;
            max-width: 780px;
            text-align: center;
        }

        .cc-section-title {
            color: var(--cc-text);
            font-size: 46px;
            font-weight: 950;
            letter-spacing: 0;
            line-height: 1.12;
            margin: 0;
            text-wrap: balance;
        }

        .cc-section-desc {
            color: var(--cc-muted);
            font-size: 16px;
            line-height: 1.78;
            margin: 18px auto 0;
            max-width: 720px;
            text-wrap: pretty;
        }

        .cc-solution-stack {
            display: grid;
            gap: 34px;
        }

        .cc-solution-row {
            align-items: center;
            background: rgba(255, 255, 255, .86);
            border: 1px solid var(--cc-line);
            border-radius: var(--cc-radius);
            box-shadow: var(--cc-shadow-sm);
            display: grid;
            gap: 60px;
            grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr);
            min-height: 500px;
            overflow: hidden;
            padding: 44px;
        }

        .cc-solution-row:nth-child(even) {
            grid-template-columns: minmax(0, 1.18fr) minmax(0, .82fr);
        }

        .cc-solution-row:nth-child(even) .cc-solution-copy {
            order: 2;
        }

        .cc-solution-index {
            align-items: center;
            color: var(--cc-accent);
            display: flex;
            font-size: 12px;
            font-weight: 900;
            gap: 9px;
            letter-spacing: .06em;
            margin-bottom: 18px;
            text-transform: uppercase;
        }

        .cc-solution-index::after {
            background: currentColor;
            content: "";
            height: 1px;
            width: 34px;
        }

        .cc-solution-copy h3 {
            color: var(--cc-text);
            font-size: 40px;
            font-weight: 950;
            letter-spacing: 0;
            line-height: 1.12;
            margin: 0;
            text-wrap: balance;
        }

        .cc-solution-copy > p {
            color: var(--cc-muted);
            font-size: 15px;
            line-height: 1.8;
            margin: 18px 0 0;
        }

        .cc-check-list {
            display: grid;
            gap: 12px;
            list-style: none;
            margin: 24px 0 0;
            padding: 0;
        }

        .cc-check-list li {
