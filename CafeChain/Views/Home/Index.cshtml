    <script>
        (function () {
            const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            const header = document.querySelector(".cc-header");
            const nav = document.getElementById("cc-main-nav");
            const menuToggle = document.querySelector(".cc-menu-toggle");
            const navButtons = Array.from(document.querySelectorAll(".cc-nav button[data-scroll-target]"));
            const scrollButtons = Array.from(document.querySelectorAll("[data-scroll-target]"));
            const sectionIds = ["home", "solutions", "capabilities", "roles", "trust"];
            let activeLockTimer = null;
            let lastActiveTarget = "home";

            function headerOffset() {
                return (header ? header.getBoundingClientRect().height : 0) + 14;
            }

            function setActive(target) {
                if (!target || target === lastActiveTarget) return;
                lastActiveTarget = target;
                navButtons.forEach(function (button) {
                    if (button.dataset.scrollTarget === target) {
                        button.setAttribute("aria-current", "location");
                    } else {
                        button.removeAttribute("aria-current");
                    }
                });
            }

            function closeMenu() {
                if (!nav || !menuToggle) return;
                nav.classList.remove("open");
                menuToggle.setAttribute("aria-expanded", "false");
                menuToggle.setAttribute("aria-label", "Mở menu");
            }

            function toggleMenu() {
                if (!nav || !menuToggle) return;
                const open = nav.classList.toggle("open");
                menuToggle.setAttribute("aria-expanded", String(open));
                menuToggle.setAttribute("aria-label", open ? "Đóng menu" : "Mở menu");
            }

            function scrollToSection(target) {
                const section = document.getElementById(target);
                if (!section) return;

                closeMenu();
                setActive(target);
                window.clearTimeout(activeLockTimer);

                const destination = section.getBoundingClientRect().top + window.scrollY - headerOffset();
                window.scrollTo({
                    top: Math.max(0, destination),
                    behavior: prefersReducedMotion ? "auto" : "smooth"
                });

                activeLockTimer = window.setTimeout(function () {
                    activeLockTimer = null;
                }, prefersReducedMotion ? 40 : 750);
            }

            function updateScrollSpy() {
                if (activeLockTimer) return;

                const sections = sectionIds
                    .map(function (id) { return document.getElementById(id); })
                    .filter(Boolean);

                if (!sections.length) return;

                const probe = window.scrollY + headerOffset() + 80;
                let current = sections[0].id;

                sections.forEach(function (section) {
                    if (section.offsetTop <= probe) {
                        current = section.id;
                    }
                });

                if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 8) {
                    current = sections[sections.length - 1].id;
                }

                setActive(current);
            }

            function releaseLock() {
                if (!activeLockTimer) return;
                window.clearTimeout(activeLockTimer);
                activeLockTimer = null;
                updateScrollSpy();
            }

            scrollButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    scrollToSection(button.dataset.scrollTarget);
                });
            });

            if (menuToggle) {
                menuToggle.addEventListener("click", toggleMenu);
            }

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape") {
                    closeMenu();
                }
            });

            window.addEventListener("scroll", updateScrollSpy, { passive: true });
            window.addEventListener("resize", updateScrollSpy);
            window.addEventListener("wheel", releaseLock, { passive: true });
            window.addEventListener("touchmove", releaseLock, { passive: true });

            const revealItems = Array.from(document.querySelectorAll(".reveal"));
            if (!("IntersectionObserver" in window) || prefersReducedMotion) {
                revealItems.forEach(function (item) {
                    item.classList.add("visible");
                });
            } else {
                const observer = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("visible");
                            observer.unobserve(entry.target);
                        }
                    });
                }, { threshold: .14, rootMargin: "0px 0px -40px 0px" });

                revealItems.forEach(function (item) {
                    observer.observe(item);
                });
            }

            window.setTimeout(function () {
                revealItems.slice(0, 2).forEach(function (item) {
                    item.classList.add("visible");
                });
            }, 40);

            setActive("home");
            updateScrollSpy();
        })();
    </script>
</body>
</html>
