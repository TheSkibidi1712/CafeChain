@{
    Layout = "_Layout";
    ViewData["Title"] = "Chấm Công Điện Thoại";
}

<div class="container text-center mt-4">
    <h4 class="fw-bold">Ca Làm Việc Của: @ViewBag.StaffName — <span class="text-primary">@ViewBag.StoreName</span></h4>
    <h1 id="clock" class="display-3 fw-bold text-primary my-3">--:--:--</h1>
    <h3 id="tracker" class="fw-bold text-success" style="display:none;">Tổng giờ làm: <span id="tracker-time">00:00:00</span></h3>
    
    <div class="mx-auto shadow rounded-4 overflow-hidden mb-3" style="width: 300px; height: 350px; position: relative; background:#000;">
        <video id="videoElement" autoplay muted playsinline style="width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1);"></video>
    </div>

    <p id="status-msg" class="fw-bold text-warning">Đang khởi động Camera... Vui lòng cho phép quyền truy cập.</p>
    
    <div class="row g-3 px-3">
        <!-- SINGLE TOGGLE BUTTON -->
        <div class="col-12">
            <button class="btn btn-success w-100 py-4 rounded-4 fw-bold shadow transition-all action-btn" 
                    id="btnAttendanceToggle" 
                    onclick="handleAttendanceToggle()" disabled>
                <i class="fas fa-sign-in-alt d-block mb-2" style="font-size: 2rem;"></i> 
                <span id="btnToggleText" style="font-size: 1.25rem;">VÀO CA</span>
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script src="/js/face-api.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const video = document.getElementById('videoElement');
    const msg = document.getElementById('status-msg');
    const actionBtns = document.querySelectorAll('.action-btn');
    const btnToggle = document.getElementById('btnAttendanceToggle');
    const btnToggleText = document.getElementById('btnToggleText');
    const btnToggleIcon = btnToggle.querySelector('i');

    let checkInTimestamp = null;
    let localDelta = 0;
    let currentAction = 'CheckIn';

    // ═══════════════════════════════════════════════════════
    // UI STATE: Switch between Pre-Shift and In-Shift (Single Button Toggle)
    // ═══════════════════════════════════════════════════════
    function switchToInShiftState() {
        currentAction = 'CheckOut';
        btnToggle.className = 'btn btn-danger w-100 py-4 rounded-4 fw-bold shadow transition-all action-btn';
        btnToggleIcon.className = 'fas fa-sign-out-alt d-block mb-2';
        btnToggleText.innerText = 'TAN CA';
        tracker.style.display = 'block';
    }

    function switchToPreShiftState() {
        currentAction = 'CheckIn';
        btnToggle.className = 'btn btn-success w-100 py-4 rounded-4 fw-bold shadow transition-all action-btn';
        btnToggleIcon.className = 'fas fa-sign-in-alt d-block mb-2';
        btnToggleText.innerText = 'VÀO CA';
        tracker.style.display = 'none';
    }

    function handleAttendanceToggle() {
        captureAndSubmit(currentAction);
    }

    // ═══════════════════════════════════════════════════════
    // REAL-TIME CLOCK + SERVER-SYNCED TRACKER (Zero-Trust)
    // ═══════════════════════════════════════════════════════
    setInterval(() => {
        document.getElementById('clock').innerText = new Date().toLocaleTimeString('vi-VN');
        if (checkInTimestamp) {
            const nowServer = new Date(Date.now() + localDelta);
            const elapsed = nowServer - checkInTimestamp;
            if (elapsed > 0) {
                const s = Math.floor(elapsed / 1000);
                const h = String(Math.floor(s / 3600)).padStart(2, '0');
                const m = String(Math.floor((s % 3600) / 60)).padStart(2, '0');
                const sec = String(s % 60).padStart(2, '0');
                document.getElementById('tracker-time').innerText = `${h}:${m}:${sec}`;
            }
        }
    }, 1000);

    // ═══════════════════════════════════════════════════════
    // BOOT: Face-API + Camera + Initial State
    // ═══════════════════════════════════════════════════════
    async function initBYOD() {
        try {
            const resData = await fetch(`/api/Attendance/GetKioskData?accountId=${'@ViewBag.AccountId'}`);
            const dataObj = await resData.json();

            if (dataObj.success && dataObj.data) {
                const data = dataObj.data;
                const svIso = new Date(data.serverTimeIso);
                localDelta = svIso.getTime() - Date.now();

                if (data.checkInIso) {
                    checkInTimestamp = new Date(data.checkInIso);
                    switchToInShiftState();
                } else {
                    switchToPreShiftState();
                }
            }

            await Promise.all([
                faceapi.nets.ssdMobilenetv1.loadFromUri('/aifx'),
                faceapi.nets.faceLandmark68Net.loadFromUri('/aifx'),
                faceapi.nets.faceRecognitionNet.loadFromUri('/aifx')
            ]);
            
            let stream;
            try {
                stream = await navigator.mediaDevices.getUserMedia({
                    video: { facingMode: "user", width: { ideal: 480 }, height: { ideal: 640 } }
                });
            } catch(e) {
                stream = await navigator.mediaDevices.getUserMedia({ video: true });
            }
            video.srcObject = stream;
            
            video.onloadeddata = () => {
                msg.innerText = "Camera Sẵn Sàng! Hãy chọn hành động chấm công bên dưới";
                msg.className = "fw-bold text-success";
                actionBtns.forEach(b => b.disabled = false);
            };
        } catch (err) {
            msg.innerText = "Lỗi Camera: " + err.message;
            msg.className = "fw-bold text-danger";
        }
    }

    // ═══════════════════════════════════════════════════════
    // CAPTURE & SUBMIT (with Force Clock-in / Ad-hoc)
    // ═══════════════════════════════════════════════════════
    async function captureAndSubmit(actionType, forceSave = false) {
        actionBtns.forEach(b => b.disabled = true);
        msg.innerText = "Đang trích xuất dữ liệu khuôn mặt...";
        msg.className = "fw-bold text-warning";

        try {
            const detection = await faceapi.detectSingleFace(video, new faceapi.SsdMobilenetv1Options({ minConfidence: 0.5 }))
                                           .withFaceLandmarks().withFaceDescriptor();
            
            if (!detection) {
                msg.innerText = "Không tìm thấy khuôn mặt rõ nét! Xin chỉnh lại khung hình.";
                msg.className = "fw-bold text-danger";
                actionBtns.forEach(b => b.disabled = false);
                return;
            }

            msg.innerText = "Đang khớp số liệu toán học...";
            const faceVectorJson = JSON.stringify(Array.from(detection.descriptor));

            const formData = new FormData();
            formData.append('accountId', '@ViewBag.AccountId');
            formData.append('actionType', actionType);
            formData.append('faceDescriptor', faceVectorJson);
            formData.append('forceSave', forceSave);

            const res = await fetch('/api/Attendance/SubmitTimeAction', { method: 'POST', body: formData });
            const result = await res.json();

            if (result.success) {
                Swal.fire("Thành công", result.message, "success");
                msg.innerText = result.message;
                msg.className = "fw-bold text-success";

                // REALTIME UI TOGGLE: No full page reload needed
                if (actionType === 'CheckIn') {
                    checkInTimestamp = new Date(Date.now() + localDelta);
                    switchToInShiftState();
                } else if (actionType === 'CheckOut') {
                    checkInTimestamp = null;
                    switchToPreShiftState();
                    // Stop camera to save battery after checkout
                    video.srcObject.getTracks().forEach(track => track.stop());
                }
                actionBtns.forEach(b => b.disabled = false);
            } else {
                if (result.errorCode === 'AD_HOC_CONFIRMATION_REQUIRED') {
                    Swal.fire({
                        title: "Cảnh báo",
                        text: result.message,
                        icon: "warning",
                        showCancelButton: true,
                        confirmButtonText: "Lưu (Ca Tự Do)",
                        cancelButtonText: "Đóng"
                    }).then((swalRes) => {
                        if (swalRes.isConfirmed) {
                            captureAndSubmit(actionType, true);
                        } else {
                            msg.innerText = "Đã bỏ qua VÀO CA phát sinh.";
                            actionBtns.forEach(b => b.disabled = false);
                        }
                    });
                } else {
                    Swal.fire("Thất bại", result.message, "error");
                    msg.innerText = "Chấm công thất bại!";
                    actionBtns.forEach(b => b.disabled = false);
                }
            }
        } catch (e) {
            Swal.fire("Lỗi dữ liệu", "Lỗi thực thi: " + e.message, "error");
            actionBtns.forEach(b => b.disabled = false);
        }
    }

    window.addEventListener('load', initBYOD);
</script>
}
