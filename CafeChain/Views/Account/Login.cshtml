@model CafeChain.ViewModels.Accounts.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
    var isLocked = ViewBag.IsLocked ?? false;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CafeChain</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --primary-orange: #d34817;
            --bg-color: #f9f9f9;
            --text-color: #1a1a1a;
            --border-color: #eeeeee;
            --placeholder-color: #9ca3af;
        }

        input[type="password"]::-ms-reveal,
        input[type="password"]::-ms-clear {
            display: none;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/Images/Login/LogIn.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        .login-card {
            background-color: white;
            width: 100%;
            max-width: 480px;
            border-radius: 24px;
            padding: 3rem;
            box-shadow: 0 20px 60px rgba(0,0,0,0.2);
            text-align: center;
        }

        .logo-container {
            margin-bottom: 1.5rem;
        }

        .logo-icon {
            background-color: #fff1ed;
            color: var(--primary-orange);
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.75rem;
            margin: 0 auto 1rem;
        }

        .brand-name {
            font-size: 2.25rem;
            font-weight: 800;
            color: #0c1221;
            margin-bottom: 0.5rem;
        }

        .subtitle {
            font-size: 1.1rem;
            color: #666;
            margin-bottom: 3rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
            text-align: left;
        }

        .form-label {
            display: block;
            margin-bottom: 0.75rem;
            font-weight: 600;
            font-size: 0.95rem;
            color: #555;
        }

        .input-wrapper {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 1.25rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--placeholder-color);
        }

        .form-input {
            width: 100%;
            padding: 1rem 1.25rem 1rem 3.2rem;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            font-size: 1.05rem;
            background-color: #ffffff;
            transition: all 0.2s;
        }

        .form-input:focus {
            outline: none;
            border-color: var(--primary-orange);
            box-shadow: 0 0 0 4px rgba(211, 72, 23, 0.1);
        }

        .toggle-password {
            position: absolute;
            right: 1.25rem;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: var(--placeholder-color);
        }

        .action-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            font-size: 0.95rem;
        }

        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: #666;
        }

        .checkbox-group input {
            cursor: pointer;
            width: 18px;
            height: 18px;
            accent-color: var(--primary-orange);
        }

        .forgot-password {
            color: var(--primary-orange);
            text-decoration: none;
            font-weight: 600;
        }

        .submit-btn {
            width: 100%;
            background-color: var(--primary-orange);
            color: white;
            border: none;
            padding: 1.125rem;
            border-radius: 16px;
            font-size: 1.1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
            box-shadow: 0 10px 20px rgba(211, 72, 23, 0.25);
            margin-bottom: 2rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .submit-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .validation-summary {
            background-color: #fee2e2;
            color: #b91c1c;
            padding: 1rem;
            border-radius: 12px;
            margin-bottom: 1.5rem;
            font-size: 0.9rem;
            text-align: left;
        }

        
            .demo-accounts {
                margin-top: 25px;
                border-top: 1px solid #eee;
                padding-top: 20px;
            }

                .demo-accounts h3 {
                    margin-bottom: 15px;
                    font-size: 16px;
                    color: #333;
                }

            .account-grid {
                display: grid;
                grid-template-columns: repeat(2,1fr);
                gap: 10px;
            }

            .account-card {
                border: 1px solid #ddd;
                border-radius: 12px;
                padding: 12px;
                cursor: pointer;
                transition: all .2s;
                text-align: left;
                background: #fafafa;
            }

                .account-card:hover {
                    border-color: #d34817;
                    transform: translateY(-2px);
                }

                .account-card strong {
                    display: block;
                    color: #d34817;
                }

                .account-card small {
                    color: #666;
                    word-break: break-all;
                }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="logo-container">
            <div class="logo-icon">
                <i class="fas fa-coffee"></i>
            </div>
            <h1 class="brand-name">CafeChain</h1>
            <p class="subtitle">Chào mừng bạn quay trở lại</p>
        </div>
        <div class="demo-accounts">
            <h3>Tài khoản nhanh</h3>

            <div class="account-grid">
                <div class="account-card"
                     data-email="owner@cafechain.vn"
                     data-password="The@1712">
                    <strong>Chủ doanh nghiệp</strong>
                    <small>owner@cafechain.vn</small>
                </div>

                <div class="account-card"
                     data-email="areamanager@cafechain.vn"
                     data-password="The@1712">
                    <strong>Quản lý vùng</strong>
                    <small>areamanager@cafechain.vn</small>
                </div>

                <div class="account-card"
                     data-email="storemanager@cafechain.vn"
                     data-password="The@1712">
                    <strong>Quản lý chi nhánh</strong>
                    <small>storemanager@cafechain.vn</small>
                </div>

                <div class="account-card"
                     data-email="salesstaff@cafechain.vn"
                     data-password="The@1712">
                    <strong>Nhân viên bán hàng</strong>
                    <small>salesstaff@cafechain.vn</small>
                </div>

                <div class="account-card"
                     data-email="accountantwarehouse@cafechain.vn"
                     data-password="The@1712">
                    <strong>Kế toán/kho</strong>
                    <small>accountantwarehouse@cafechain.vn</small>
                </div>

                <div class="account-card"
                     data-email="systemadmin@cafechain.vn"
                     data-password="The@1712">
                    <strong>Quản trị hệ thống</strong>
                    <small>systemadmin@cafechain.vn</small>
                </div>

                <div class="account-card"
                     data-email="khachhang@gmail.com"
                     data-password="The@1712">
                    <strong>Khách hàng</strong>
                    <small>khachhang@gmail.com</small>
                </div>
            </div>
        </div>

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@Context.Request.Query["returnUrl"]" />

            @if (ViewBag.LockMessage != null)
            {
                <div class="validation-summary">
                    @ViewBag.LockMessage
                </div>
            }
            else if (!ViewData.ModelState.IsValid)
            {
                <div class="validation-summary" asp-validation-summary="All"></div>
            }

            <div class="form-group">
                <label class="form-label" asp-for="Email"></label>
                <div class="input-wrapper">
                    <i class="far fa-envelope input-icon"></i>
                    <input asp-for="Email" class="form-input" placeholder="username@email.com" readonly="@(isLocked ? "readonly" : null)" />
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="Password"></label>
                <div class="input-wrapper">
                    <i class="fas fa-lock input-icon"></i>
                    <input asp-for="Password" type="password" class="form-input" id="passwordInput" placeholder="••••••••" readonly="@(isLocked ? "readonly" : null)" />
                    <i class="far fa-eye toggle-password" id="togglePassword"></i>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="action-row">
                <div class="checkbox-group">
                    <input type="checkbox" asp-for="RememberMe" id="rememberMe" disabled="@(isLocked ? "disabled" : null)" />
                    <label for="rememberMe">Ghi nhớ đăng nhập</label>
                </div>
                <a asp-controller="Password" asp-action="ForgotPassword" class="forgot-password">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="submit-btn" disabled="@(isLocked ? "disabled" : null)">
                @(isLocked ? "Đang bị khóa..." : "Đăng nhập")
            </button>

            <p class="register-link">
                Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a>
            </p>
        </form>

        <div class="card-footer">
            © 2026 CafeChain Professional Network
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script>
        $(document).ready(function () {

            // Toggle password
            $('#togglePassword').click(function () {
                const input = $('#passwordInput');
                const type = input.attr('type') === 'password' ? 'text' : 'password';
                input.attr('type', type);
                $(this).toggleClass('fa-eye fa-eye-slash');
            });

            // ===== COUNTDOWN LOCK =====
                   const email = $('input[name="Email"]').val();

            function updateLockUI(isLocked, remainingMinutes) {
                const btn = $('.submit-btn');

                if (isLocked) {
                    $('input, button').prop('disabled', true);

                    btn.text(`Thử lại sau ${remainingMinutes} phút`);
                } else {
                    $('input, button').prop('disabled', false);
                    btn.text('Đăng nhập');
                }
            }

            async function checkLock() {
                if (!email) return;

                try {
                    const res = await fetch(`/Account/CheckLockStatus?email=${encodeURIComponent(email)}`);
                    const data = await res.json();

                    updateLockUI(data.isLocked, data.remainingMinutes);

                    // 🔥 nếu đã unlock thì dừng polling
                    if (!data.isLocked) {
                        clearInterval(interval);
                    }

                } catch (err) {
                    console.error('Check lock error:', err);
                }
            }

            // 🔥 chạy ngay lần đầu
            checkLock();

            // 🔥 polling mỗi 5 giây
            const interval = setInterval(checkLock, 5000);
        });

        $('.account-card').click(function () {

            const email = $(this).data('email');
            const password = $(this).data('password');

            $('#Email').val(email);
            $('#passwordInput').val(password);

        });
    </script>
</body>
</html>