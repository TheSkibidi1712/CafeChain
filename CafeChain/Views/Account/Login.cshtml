    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script>
        $(document).ready(function () {
            // ===== 1. INTERACTIVE MOUSE PARALLAX BACKDROP SPOTLIGHT =====
            $(document).on('mousemove', function (e) {
                const x = (e.clientX / window.innerWidth) * 100;
                const y = (e.clientY / window.innerHeight) * 100;
                document.documentElement.style.setProperty('--mouse-x', x + '%');
                document.documentElement.style.setProperty('--mouse-y', y + '%');
            });

            // ===== 2. CANVAS GOLDEN CREMA BOKEH PARTICLES =====
            const canvas = document.getElementById('particleCanvas');
            if (canvas) {
                const ctx = canvas.getContext('2d');
                let particles = [];

                function resizeCanvas() {
                    canvas.width = window.innerWidth;
                    canvas.height = window.innerHeight;
                }
                resizeCanvas();
                $(window).on('resize', resizeCanvas);

                class Particle {
                    constructor() {
                        this.reset();
                    }
                    reset() {
                        this.x = Math.random() * canvas.width;
                        this.y = canvas.height + Math.random() * 50;
                        this.radius = Math.random() * 3 + 1;
                        this.speed = Math.random() * 0.8 + 0.3;
                        this.opacity = Math.random() * 0.5 + 0.15;
                        this.swing = Math.random() * 0.02 - 0.01;
                        this.color = Math.random() > 0.5 ? '212, 163, 115' : '224, 176, 122';
                    }
                    update() {
                        this.y -= this.speed;
                        this.x += Math.sin(this.y * 0.01) * 0.5;
                        if (this.y < -20) this.reset();
                    }
                    draw() {
                        ctx.beginPath();
                        ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
                        ctx.fillStyle = `rgba(${this.color}, ${this.opacity})`;
                        ctx.shadowBlur = 10;
                        ctx.shadowColor = `rgba(${this.color}, 0.5)`;
                        ctx.fill();
                    }
                }

                for (let i = 0; i < 45; i++) {
                    const p = new Particle();
                    p.y = Math.random() * canvas.height;
                    particles.push(p);
                }

                function animateParticles() {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    particles.forEach(p => {
                        p.update();
                        p.draw();
                    });
                    requestAnimationFrame(animateParticles);
                }
                animateParticles();
            }

            // ===== 3. THEME SWITCHER (Dark Espresso / Light Latte) =====
            const savedTheme = localStorage.getItem('cafechain_theme') || 'dark';
            setTheme(savedTheme);

            $('#themeToggleBtn').click(function () {
                const currentTheme = $('html').attr('data-theme');
                const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
                setTheme(newTheme);
            });

            function setTheme(theme) {
                $('html').attr('data-theme', theme);
                localStorage.setItem('cafechain_theme', theme);
                if (theme === 'dark') {
                    $('#themeIcon').removeClass('fa-moon').addClass('fa-sun');
                } else {
                    $('#themeIcon').removeClass('fa-sun').addClass('fa-moon');
                }
            }

            // ===== 4. TOGGLE PASSWORD VISIBILITY =====
            $('#togglePassword').click(function () {
                const input = $('#passwordInput');
                const type = input.attr('type') === 'password' ? 'text' : 'password';
                input.attr('type', type);
                $(this).toggleClass('fa-eye fa-eye-slash');
            });

            // ===== 5. DEMO ACCOUNTS SELECTION =====
            $('.account-card').click(function () {
                $('.account-card').removeClass('active');
                $(this).addClass('active');

                const email = $(this).data('email');
                const password = $(this).data('password');
                const roleName = $(this).data('role');

                $('#Email').val(email).trigger('change');
                $('#passwordInput').val(password).trigger('change');

                $('#selectedRoleText').text(roleName);
                $('#selectedAccountBadge').fadeIn(200);

                $('#Email, #passwordInput').css('border-color', 'var(--crema-gold)');
                setTimeout(() => {
                    $('#Email, #passwordInput').css('border-color', '');
                }, 600);
            });

            const currentEmail = $('#Email').val();
            if (currentEmail) {
                $(`.account-card[data-email="${currentEmail}"]`).addClass('active');
            }

            // ===== 6. LOCK COUNTDOWN POLLING =====
            const email = $('input[name="Email"]').val();

            function updateLockUI(isLocked, remainingMinutes) {
                const btn = $('#btnSubmit');

                if (isLocked) {
                    $('input, button:not(#themeToggleBtn)').prop('disabled', true);
                    btn.find('span').text(`Thử lại sau ${remainingMinutes} phút`);
                    $('#btnIcon').attr('class', 'fas fa-lock');
                } else {
                    $('input, button').prop('disabled', false);
                    btn.find('span').text('Truy cập hệ thống');
                    $('#btnIcon').attr('class', 'fas fa-arrow-right');
                }
            }

            async function checkLock() {
                if (!email) return;

                try {
                    const res = await fetch(`/Account/CheckLockStatus?email=${encodeURIComponent(email)}`);
                    const data = await res.json();

                    updateLockUI(data.isLocked, data.remainingMinutes);

                    if (!data.isLocked && typeof interval !== 'undefined') {
                        clearInterval(interval);
                    }
                } catch (err) {
                    console.error('Check lock status error:', err);
                }
            }

            if (email) {
                checkLock();
                var interval = setInterval(checkLock, 5000);
            }

            // ===== 7. SUBMIT SPINNER ANIMATION =====
            $('#loginForm').submit(function () {
                if ($(this).valid && !$(this).valid()) return;

                const btn = $('#btnSubmit');
                btn.prop('disabled', true);
                btn.find('span').text('Đang xác thực...');
                $('#btnIcon').attr('class', 'fas fa-spinner fa-spin');
            });
        });
    </script>
</body>
