@model CafeChain.ViewModels.Accounts.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký thành viên";
    Layout = null; // We'll use a custom layout for this page to match the image
}
@using CafeChain.Models.Enums.Customer

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0" />
    <title>@ViewData["Title"] - CafeChain</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --primary-orange: #d34817;
            --bg-color: #f9f9f9;
            --text-color: #1a1a1a;
            --border-color: #eeeeee;
            --placeholder-color: #9ca3af;
        }

        /* Ẩn con mắt mặc định của trình duyệt Edge để tránh trùng lặp */
        input[type="password"]::-ms-reveal,
        input[type="password"]::-ms-clear {
            display: none;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .header {
            background-color: white;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        }

        .logo-container {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: white;
            font-weight: 700;
            font-size: 1.25rem;
        }

        .logo-icon {
            background-color: var(--primary-orange);
            color: white;
            padding: 0.5rem;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .logo-text {
            color: #333;
        }

        .back-button {
            color: var(--primary-orange);
            background-color: #fff1ed;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: all 0.2s;
        }

        .back-button:hover {
            background-color: #ffe4db;
        }

        .register-container {
            max-width: 850px;
            margin: 4rem auto;
            background-color: transparent;
        }

        .banner {
            position: relative;
            height: 320px;
            background-image: linear-gradient(rgba(0,0,0,0.2), rgba(0,0,0,0.5)), url('/Images/register/Dangki.jpg');
            background-size: cover;
            background-position: center;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 3rem;
            color: white;
            border-radius: 24px;
            box-shadow: 0 15px 45px rgba(0,0,0,0.15);
            margin-bottom: 3rem;
        }

        .banner h1 {
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 0.75rem;
        }

        .banner p {
            font-size: 1.25rem;
            opacity: 0.95;
        }

        .form-content {
            padding: 0;
        }

        .form-title {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 2.5rem;
            color: #0c1221;
        }

        .form-group {
            margin-bottom: 2.2rem; /* 🔥 CHỐT 1: Chừa sẵn 1 khoảng trống tàng hình ở dưới để chứa chữ */
            position: relative; /* 🔥 CHỐT 2: Làm mỏ neo để chữ đỏ bám vào */
        }

        .form-label {
            display: block;
            margin-bottom: 0.75rem;
            font-weight: 600;
            font-size: 1rem;
            color: #555;
        }

        .input-wrapper {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--placeholder-color);
        }

        .form-input {
            width: 100%;
            padding: 1rem 1.25rem 1rem 3.2rem;
            border: 1px solid var(--border-color);
            border-radius: 16px;
            font-size: 16px; /* 🔥 CHỐT CHẶN: Ép chuẩn 16px để iOS Safari không bao giờ tự Zoom */
            background-color: #ffffff;
            transition: all 0.2s;
        }

        .form-input:focus {
            outline: none;
            border-color: var(--primary-orange);
            
        }

        .toggle-password {
            position: absolute;
            right: 1.25rem;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: var(--placeholder-color);
            transition: color 0.2s;
            font-size: 1.1rem;
            z-index: 10;
        }

        .toggle-password:hover {
            color: var(--primary-orange);
        }

        .row {
            display: flex;
            gap: 1.5rem;
            margin-bottom: 1.2rem; /* 🔥 THÊM DÒNG NÀY: Đẩy khoảng cách với ô Checkbox ra xa thêm */
        }

        .row .form-group {
            flex: 1;
            min-width: 0; /* 🔥 CHỐT CHẶN: Ép không cho phình cột theo chiều ngang */
        }

        .checkbox-group {
            display: flex;
            align-items: flex-start;
            gap: 1rem;
            margin-bottom: 2.5rem;
        }

        .checkbox-group input {
            margin-top: 0.25rem;
            width: 18px;
            height: 18px;
            accent-color: var(--primary-orange);
        }

        .checkbox-label {
            font-size: 1rem;
            color: #555;
            line-height: 1.6;
            cursor: pointer;
        }

        .checkbox-label span {
            color: var(--primary-orange);
            font-weight: 600;
        }

        .submit-btn {
            width: 100%;
            background-color: var(--primary-orange);
            color: white;
            border: none;
            padding: 1.25rem;
            border-radius: 18px;
            font-size: 1.25rem;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            transition: all 0.2s;
            box-shadow: 0 12px 24px rgba(211, 72, 23, 0.25);
        }

        .submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(211, 72, 23, 0.4);
            filter: brightness(1.1);
        }

        .login-link {
            text-align: center;
            margin-top: 2rem;
            font-size: 1.1rem;
            color: #666;
        }

        .login-link a {
            color: var(--primary-orange);
            text-decoration: none;
            font-weight: 600;
        }

        .footer {
            margin-top: 5rem;
            padding: 3rem;
            text-align: center;
            font-size: 0.95rem;
            color: #777;
            background-color: #f1efed;
            border-top: 1px solid #eeeeee;
        }

        .text-danger {
            position: absolute; /* 🔥 CHỐT 3: Rút chữ ra khỏi luồng vật lý để không đẩy form */
            top: 100%; /* Neo chữ xuất hiện chính xác ngay mép dưới của ô input */
            left: 0;
            width: 100%;
            color: #dc2626;
            font-size: 0.8rem;
            margin-top: 0.3rem;
            line-height: 1.4;
            word-wrap: break-word;
        }

        .validation-summary {
            background-color: #fee2e2;
            border-radius: 12px;
            padding: 1rem;
            margin-bottom: 2rem;
            color: #b91c1c;
            font-size: 0.9rem;
        }

        .validation-summary ul {
            list-style-position: inside;
        }

        @@media (max-width: 640px) {
            .register-container {
                margin: 0;
                border-radius: 0;
            }
            .row {
                flex-direction: column;
                gap: 0;
            }
        }
    </style>
</head>
<body>
    <header class="header">
        <div class="logo-container">
            <div class="logo-icon">
                <i class="fas fa-coffee"></i>
            </div>
            <div class="logo-text">CafeChain</div>
        </div>
        <a href="/" class="back-button">
            <i class="fas fa-arrow-left"></i>
        </a>
    </header>

    <div class="register-container">
        <div class="banner">
            <h1>Tham gia CafeChain</h1>
            <p>Hương vị cà phê nguyên bản, kết nối cộng đồng.</p>
        </div>

        <div class="form-content">
            <h2 class="form-title">Đăng ký tài khoản</h2>

            <form asp-action="Register" method="post">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="validation-summary">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <div class="form-group">
                    <label class="form-label" asp-for="FullName"></label>
                    <div class="input-wrapper">
                        <i class="far fa-user input-icon"></i>
                        <input asp-for="FullName" class="form-input" placeholder="Nhập họ và tên của bạn" maxlength="100" />
                    </div>
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="DateOfBirthText">Ngày sinh</label>
                    <div class="input-wrapper">
                        <i class="fas fa-calendar input-icon"></i>
                        <!-- Ô text hiển thị dd/MM/yyyy -->
                        <input asp-for="DateOfBirthText" type="text" class="form-input" placeholder="dd/mm/yyyy" id="DateOfBirthText" autocomplete="off" />
                        <!-- Lịch native ẩn -->
                        <i class="fas fa-calendar-alt toggle-date" style="position: absolute; right: 1.25rem; top: 50%; transform: translateY(-50%); color: var(--primary-orange); cursor: pointer;"></i>
                        <input type="date" id="HiddenDatePicker" style="position: absolute; right: 1rem; top: 50%; transform: translateY(-50%); opacity: 0; width: 30px; height: 30px; cursor: pointer; z-index: 5;" />
                    </div>
                    <span asp-validation-for="DateOfBirthText" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="PhoneNumber">Số điện thoại <span>(để tích điểm)</span></label>
                    <div class="input-wrapper">
                        <i class="fas fa-mobile-alt input-icon"></i>
                        <input asp-for="PhoneNumber" class="form-input" placeholder="0xxx xxx xxx" maxlength="11" minlength="10" />
                    </div>
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="Gender">
                        Giới tính
                        <span>(không bắt buộc)</span>
                    </label>

                    <div class="input-wrapper">
                        <i class="fas fa-venus-mars input-icon"></i>

                        <select asp-for="Gender" class="form-input">

                            <option value="@((int)Gender.Unknown)">
                                Không muốn tiết lộ
                            </option>

                            <option value="@((int)Gender.Male)">
                                Nam
                            </option>

                            <option value="@((int)Gender.Female)">
                                Nữ
                            </option>

                            <option value="@((int)Gender.Other)">
                                Khác
                            </option>

                        </select>
                    </div>

                    <span asp-validation-for="Gender" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="Email"></label>
                    <div class="input-wrapper">
                        <i class="far fa-envelope input-icon"></i>
                        <input asp-for="Email" class="form-input" placeholder="example@gmail.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="form-group">
                        <label class="form-label" asp-for="Password"></label>
                        <div class="input-wrapper">
                            <i class="fas fa-lock input-icon"></i>
                            <input asp-for="Password" class="form-input" placeholder="••••••••" id="passwordInput" />
                            <i class="far fa-eye toggle-password" onclick="togglePasswordVisibility('passwordInput')"></i>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" asp-for="ConfirmPassword"></label>
                        <div class="input-wrapper">
                            <i class="fas fa-undo-alt input-icon"></i>
                            <input asp-for="ConfirmPassword" class="form-input" placeholder="••••••••" id="confirmPasswordInput" />
                            <i class="far fa-eye toggle-password" onclick="togglePasswordVisibility('confirmPasswordInput')"></i>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                        <input asp-for="AcceptTerms" id="terms" type="checkbox" />
                        <label for="terms" class="checkbox-label">
                        Tôi đồng ý với <span>điều khoản thành viên</span> và chính sách bảo mật của CafeChain.
                        </label>
                    <span asp-validation-for="AcceptTerms" class="text-danger"></span>
                </div>
                <button type="submit" class="submit-btn">
                    Tạo tài khoản <i class="fas fa-arrow-right"></i>
                </button>

                <p class="login-link">
                    Đã có tài khoản? <a asp-action="Login">Đăng nhập ngay</a>
                </p>
            </form>
        </div>
    </div>

    <footer class="footer">
        <p>&copy; 2026 CafeChain Corporation. Tất cả quyền được bảo lưu.</p>
        <p>Cà phê sạch cho tâm hồn thanh thản.</p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(function () {
            // Calendar picker sync logic
            var $dobText = $('#DateOfBirthText');
            var $hiddenPicker = $('#HiddenDatePicker');
            var $calendarIcon = $('.toggle-date');

            function toVN(dateIso) {
                if (!dateIso || dateIso.indexOf('-') === -1) return dateIso;
                var p = dateIso.split('-');
                return p[2] + '/' + p[1] + '/' + p[0];
            }

            function toISO(dateVn) {
                if (!dateVn || dateVn.indexOf('/') === -1) return dateVn;
                var p = dateVn.split('/');
                return p[2] + '-' + p[1] + '-' + p[0];
            }

            // Click icon hoặc ô text → mở lịch
            $calendarIcon.add($dobText).on('click', function () {
                try { $hiddenPicker[0].showPicker(); } catch (e) { $hiddenPicker.focus().click(); }
            });

            // Chọn từ lịch → hiển thị dd/MM/yyyy trong text box
            $hiddenPicker.on('change', function () {
                var vIso = $(this).val();
                if (vIso) {
                    $dobText.val(toVN(vIso)).trigger('change');
                }
            });

            // Gõ tay → sync ngược lại vào lịch ẩn
            $dobText.on('input', function () {
                var vVn = $(this).val();
                if (vVn && vVn.length === 10) {
                    $hiddenPicker.val(toISO(vVn));
                }
            });
        });

        function togglePasswordVisibility(inputId) {
            const input = document.getElementById(inputId);
            const icon = input.nextElementSibling;
            
            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }
    </script>
</body>
</html>
