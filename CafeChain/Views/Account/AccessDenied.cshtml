@using Microsoft.Extensions.Localization
@inject IStringLocalizer<CafeChain.SharedResource> SharedText
@{
    var isAuthenticated = ViewBag.IsAuthenticated as bool? == true;

    ViewData["Title"] = isAuthenticated
        ? SharedText["AccessDenied.Forbidden.Title"]
        : SharedText["AccessDenied.LoginRequired.Title"];

    var heading = isAuthenticated
        ? SharedText["AccessDenied.Forbidden.Heading"]
        : SharedText["AccessDenied.LoginRequired.Heading"];

    var message = isAuthenticated
        ? SharedText["AccessDenied.Forbidden.Detail"]
        : SharedText["AccessDenied.LoginRequired.Detail"];
}

<div class="container py-5 text-center access-denied-page">
    <div class="row justify-content-center w-100">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-4 p-5">
                <div class="mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 rounded-circle access-denied-icon">
                        <i class="fas fa-shield-halved text-danger fa-3x"></i>
                    </div>
                </div>

                <h2 class="fw-bold mb-3 text-dark">
                    @heading
                </h2>

                <p class="text-muted mb-4 fs-6">
                    @message
                </p>

                <div class="d-flex gap-3 justify-content-center flex-wrap">
                    <button type="button"
                            class="btn btn-light rounded-3 px-4 py-2 border fw-bold text-muted"
                            onclick="history.back()">
                        @SharedText["Common.Back"]
                    </button>

                    @if (isAuthenticated)
                    {
                        <a href="/"
                           class="btn text-white rounded-3 px-4 py-2 fw-bold shadow-sm access-denied-primary">
                            @SharedText["Navigation.Home"]
                        </a>
                    }
                    else
                    {
                        <a href="/Account/Login"
                           class="btn text-white rounded-3 px-4 py-2 fw-bold shadow-sm access-denied-primary">
                            @SharedText["Common.Login"]
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        body {
            background-color: var(--cc-canvas, #f8f9fa);
        }

        .access-denied-page {
            min-height: 80vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .access-denied-icon {
            width: 100px;
            height: 100px;
        }

        .access-denied-primary {
            background-color: var(--cc-danger, #d93d20);
        }

        .access-denied-primary:hover {
            filter: brightness(.9);
        }
    </style>
}
