@model CafeChain.ViewModels.Orders.OrderDetailViewModel
@{
    ViewData["Title"] = "Chi tiết đơn hàng " + Model.FormattedOrderId;
}

<div class="container mt-4 mb-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="/Customer/Profile" class="text-muted text-decoration-none">Hồ sơ cá nhân</a></li>
            <li class="breadcrumb-item"><a href="/Order/History" class="text-muted text-decoration-none">Lịch sử đơn hàng</a></li>
            <li class="breadcrumb-item active text-orange fw-semibold" aria-current="page">Chi tiết @Model.FormattedOrderId</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">    
        <h2 class="fw-bold mb-0">Chi tiết <span class="text-orange">@Model.FormattedOrderId</span></h2>
        <span class="badge rounded-pill bg-dark px-3 py-2 fs-6">Trạng thái: @Model.StatusName</span>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-0 pb-3 border-bottom"><i class="bi bi-receipt text-orange me-2"></i>Danh sách sản phẩm</h5>
                    
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        <ul class="list-group list-group-flush mb-0 mt-2">
                            @foreach (var item in Model.Items)
                            {
                                <li class="list-group-item px-0 d-flex justify-content-between align-items-start border-bottom-dashed py-3">
                                    <div class="d-flex w-100 mb-2 mb-md-0">
                                        <!-- Cụm Ảnh Thumbnail -->
                                        <div style="width: 64px; height: 64px; flex-shrink: 0;" class="me-3 mt-1">
                                            <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px; border: 1px solid #e0e0e0;">
                                        </div>
                                        
                                        <!-- Cụm Thông tin -->
                                        <div class="me-auto">
                                            <div class="fw-bold text-dark fs-6 d-flex align-items-center">
                                                <span class="badge bg-orange rounded-pill me-2">x @item.Quantity</span> 
                                                <span>@item.Name</span>
                                            </div>
                                            <div class="text-muted mt-1" style="font-size: 0.85rem;">
                                                Size: <span class="fw-bold text-dark">@item.SizeName</span>
                                        
                                                @if (item.ToppingNames != null && item.ToppingNames.Any())
                                                {
                                                    <br /><span class="fst-italic">+ @string.Join(", ", item.ToppingNames)</span>
                                                }
                                                
                                                @if(!string.IsNullOrEmpty(item.Note))
                                                {
                                                    <div class="fst-italic mt-1 text-orange">
                                                        <i class="bi bi-chat-text me-1"></i> @item.Note
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <span class="fw-bold text-dark fs-5 mt-1">
                                        @((item.Price * item.Quantity).ToString("N0"))đ
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">Không tìm thấy sản phẩm trong đơn.</div>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-2"><i class="bi bi-journal-text text-orange me-2"></i>Ghi chú cửa hàng / shipper:</h6>
                    <p class="text-muted mb-0 fst-italic">@(string.IsNullOrEmpty(Model.Note) ? "Không có ghi chú gì thêm." : Model.Note)</p>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4 position-sticky" style="top: 20px;">
                <div class="card-body p-4">
                    
                    <h5 class="fw-bold border-bottom pb-3 mb-3"><i class="bi bi-truck text-orange me-2"></i>Giao hàng</h5>
                    <div class="mb-4 small">
                        <div class="fw-bold text-dark mb-1">@Model.ReceiverName</div>
                        <div class="text-muted mb-1"><i class="bi bi-telephone-fill me-2 bg-light p-1 rounded text-orange"></i>@Model.ReceiverPhone</div>
                        <div class="text-muted"><i class="bi bi-geo-alt-fill me-2 bg-light p-1 rounded text-orange"></i>@Model.DeliveryAddress</div>
                    </div>

                    <h5 class="fw-bold border-bottom pb-3 mb-3"><i class="bi bi-wallet2 text-orange me-2"></i>Thanh toán</h5>
                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Ngày đặt</span>
                        <span class="fw-bold">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    @if(!string.IsNullOrEmpty(Model.StoreName))
                    {
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Cửa hàng</span>
                            <span class="fw-bold">@Model.StoreName</span>
                        </div>
                    }
                    <div class="d-flex justify-content-between mb-4 small">
                        <span class="text-muted">Hình thức</span>
                        <span class="fw-bold">@Model.PaymentMethodName</span>
                    </div>

                    <h5 class="fw-bold border-bottom pb-3 mb-3"><i class="bi bi-file-earmark-ruled text-orange me-2"></i>Chi phí</h5>
                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Tạm tính</span>
                        <span class="fw-bold">@Model.SubTotal.ToString("N0")đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Phí ship</span>
                        <span class="fw-bold">@Model.ShippingFee.ToString("N0")đ</span>
                    </div>
                    @if(Model.VoucherDiscount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 small text-success">
                            <span>Voucher giảm giá</span>
                            <span class="fw-bold">-@Model.VoucherDiscount.ToString("N0")đ</span>
                        </div>
                    }
                    @if(Model.PointDiscount > 0)
                    {
                        <div class="d-flex justify-content-between mb-3 small text-success">
                            <span>Dùng điểm</span>
                            <span class="fw-bold">-@Model.PointDiscount.ToString("N0")đ</span>
                        </div>
                    }
                    
                    <hr class="opacity-10 my-3">
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="fw-bold fs-6">Thành tiền</span>
                        <span class="fw-bold fs-4 text-orange">@Model.FinalTotal.ToString("N0")đ</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .text-orange { color: #d35400; }
        .bg-orange { background-color: #d35400 !important; color: white !important; }
        .border-bottom-dashed { border-bottom: 1px dashed #dee2e6; }
        .list-group-item:last-child { border-bottom: none; }
    </style>
}