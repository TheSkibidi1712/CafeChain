@model CafeChain.Application.DTOs.AppLauncher.AppLauncherVM
@using System.Globalization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<CafeChain.SharedResource> SharedText
@{
    Layout = null;
    ViewData["Title"] = SharedText["AppLauncher.Title"];
    var availableApps = Model.Apps.Where(x => x.IsAvailable).ToList();
    var culture = CultureInfo.CurrentUICulture.Name == "en-US" ? "en-US" : "vi-VN";
}
<!doctype html>
<html lang="@culture" data-culture="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - CafeChain</title>
    <script src="~/js/shared/appearance.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/shared/appearance.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/AppLauncher/app-launcher.css" asp-append-version="true" />
</head>
<body>
    <div class="launcher-bg-decor" aria-hidden="true">
        <div class="launcher-circle launcher-circle--1"></div>
        <div class="launcher-circle launcher-circle--2"></div>
        <div class="launcher-circle launcher-circle--3"></div>
    </div>

    <main class="launcher-shell"
          id="appLauncher"
          data-launch-pos-url="@Url.Action("LaunchPos", "AppLauncher")"
          data-pos-status-url="@Url.Action("PosStatus", "AppLauncher")"
          data-staffhub-pos-url="@Url.Action("Index", "StaffHub", new { openPos = 1 })">
        @Html.AntiForgeryToken()
        <header class="launcher-header">
            <div class="launcher-header-left">
                <span class="launcher-eyebrow"><i class="bi bi-shield-lock-fill"></i> @SharedText["AppLauncher.Workspace"]</span>
                <div class="launcher-brand-row">
                    <span class="launcher-brand"><span class="launcher-brand-box"><i class="bi bi-cup-hot-fill"></i></span> CafeChain</span>
                </div>
                <h1>@SharedText["AppLauncher.Greeting", Model.DisplayName]</h1>
                <p>@SharedText["AppLauncher.Instruction"]</p>
            </div>
            <div class="launcher-header-right">
                <div class="cc-appearance-controls" aria-label="@SharedText["Common.DisplayPreferences"]">
                    <select class="cc-appearance-select" data-culture-selector aria-label="@SharedText["Language.Label"]">
                        <option value="vi-VN">Tiếng Việt</option>
                        <option value="en-US">English</option>
                    </select>
                </div>
                <partial name="~/Views/Shared/_LogoutForm.cshtml"
                         model="CafeChain.ViewModels.Shared.LogoutFormViewModel.AppLauncher()" />
            </div>
        </header>

        @if (availableApps.Count > 0)
        {
            <section class="launcher-grid launcher-grid--count-@availableApps.Count" aria-label="@SharedText["AppLauncher.AllowedApps"]">
                @foreach (var app in availableApps)
                {
                    var appClass = "launcher-card--default";
                    if (app.Code == CafeChain.Application.DTOs.AppLauncher.AppCode.AdminDashboard)
                    {
                        appClass = "launcher-card--admindashboard";
                    }
                    else if (app.Code == CafeChain.Application.DTOs.AppLauncher.AppCode.StaffHub)
                    {
                        appClass = "launcher-card--staffhub";
                    }
                    else if (app.Code == CafeChain.Application.DTOs.AppLauncher.AppCode.Pos)
                    {
                        appClass = "launcher-card--pos";
                    }
                    else if (app.Code == CafeChain.Application.DTOs.AppLauncher.AppCode.OperationalIce)
                    {
                        appClass = "launcher-card--operationalice";
                    }
                    var appTitle = SharedText[$"AppLauncher.App.{app.Code}.Title"];
                    var appDescription = SharedText[$"AppLauncher.App.{app.Code}.Description"];

                    <a class="launcher-card @appClass @(app.RequiresLaunch ? "launcher-card-pos" : string.Empty)"
                       href="@app.Route"
                       data-requires-launch="@app.RequiresLaunch.ToString().ToLowerInvariant()"
                       aria-label="@SharedText["AppLauncher.OpenApp", appTitle]">
                        <span class="launcher-icon"><i class="bi @app.Icon"></i></span>
                        <span class="launcher-card-body">
                            <strong>@appTitle</strong>
                            <span>@appDescription</span>
                            <span class="launcher-card-action">@SharedText["AppLauncher.Access"] <i class="bi bi-chevron-right"></i></span>
                        </span>
                        <i class="bi bi-arrow-right launcher-arrow" aria-hidden="true"></i>
                    </a>
                }
            </section>
            <div id="posLaunchStatus" class="launcher-status" role="status" aria-live="polite" hidden></div>
        }
        else
        {
            <section class="launcher-empty" role="status">
                <div class="launcher-empty-card">
                    <span class="launcher-empty-icon"><i class="bi bi-shield-lock-fill"></i></span>
                    <h2>@SharedText["AppLauncher.Empty.Title"]</h2>
                    <p>@SharedText["AppLauncher.Empty.Detail"]</p>
                </div>
            </section>
        }
    </main>
    <script src="~/js/AppLauncher/app-launcher.js" asp-append-version="true"></script>
    <script src="~/js/shared/mutation-guard.js" asp-append-version="true"></script>
</body>
</html>
