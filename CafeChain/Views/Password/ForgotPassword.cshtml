@model CafeChain.ViewModels.Accounts.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quên mật khẩu - CafeChain</title>

    <link rel="stylesheet" href="~/css/ForgotPassword/forgot-password.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
</head>
<body>

    <!-- HEADER -->
    <div class="header">
        <div class="logo">
            <i class="fa-solid fa-mug-hot"></i>
            <span>CafeChain</span>
        </div>

        <a asp-controller="Account" asp-action="Login" class="back-btn">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
    </div>

    <!-- MAIN -->
    <div class="container">
        <div class="card">

            <div class="icon">
                <i class="fa-solid fa-lock"></i>
            </div>

            <h2>Quên mật khẩu</h2>
            <p class="subtitle">
                Nhập email để nhận mã OTP đặt lại mật khẩu.
            </p>

            <!-- FORM -->
            <form asp-controller="Password" asp-action="ForgotPassword" method="post" id="forgotForm">
                
                @Html.AntiForgeryToken()

                <!-- SERVER ERROR -->
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label>Email</label>

                    <div class="input-wrapper">
                        <i class="fa-regular fa-envelope"></i>
                        <input asp-for="Email" type="email" placeholder="example@email.com" />
                    </div>

                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <button type="submit" id="btnSubmit" class="btn-submit">
                    Gửi OTP
                </button>
            </form>

            <div class="footer">
                <span>Đã nhớ mật khẩu?</span>
                <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
            </div>

        </div>
    </div>

    <div class="banner">
        <div class="banner-text">
            Trải nghiệm hương vị <br />
            CafeChain đích thực
        </div>
    </div>

    <div class="copyright">
        © 2026 CafeChain System
    </div>

    <!-- VALIDATION -->
    <partial name="_ValidationScriptsPartial" />

    <!-- 🔥 JS CHỐNG SPAM -->
    <script>
            const form = document.getElementById("forgotForm");
            const btn = document.getElementById("btnSubmit");

            form.addEventListener("submit", function () {
                btn.disabled = true;
                btn.innerText = "Đang gửi...";
            });
    </script>

</body>
</html>