@model CafeChain.ViewModels.Accounts.ResetPasswordViewModel

@using System.Text.Json
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<CafeChain.SharedResource> SharedText
@{
    ViewData["Title"] = SharedText["Auth.Reset.Title"];
}

<div class="container my-5" style="min-height: 70vh; display: flex; align-items: center; justify-content: center;">
    <div class="row w-100 justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">

                <div class="text-center mb-4">
                    <div class="d-inline-block bg-orange-light text-orange rounded-circle p-3 mb-3">
                        <i class="bi bi-shield-lock fs-1"></i>
                    </div>
                    <h3 class="fw-bold mb-2">@SharedText["Auth.Reset.Heading"]</h3>
                    <p class="text-muted small">@SharedText["Auth.Reset.Instruction"] <strong class="text-dark" id="displayEmail">@Model.Email</strong></p>
                </div>

                <form id="resetPasswordForm">
                    <input type="hidden" id="emailInput" value="@Model.Email" />
                    <input type="hidden" id="otpCodeInput" value="@Model.OtpCode" />

                    <div class="form-group position-relative mb-4">
                        <label class="form-label fw-bold small">@SharedText["Auth.Reset.NewPassword"]</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-key text-orange"></i></span>
                            <input type="password" id="newPassword" class="form-control bg-light border-0 py-2 shadow-none" placeholder="@SharedText["Auth.Reset.NewPlaceholder"]" oninput="validateNewPassword()">
                            <span class="input-group-text bg-light border-0" style="cursor: pointer;" onclick="togglePassword('newPassword', 'iconNew')">
                                <i class="bi bi-eye text-muted" id="iconNew"></i>
                            </span>
                        </div>
                        <span id="newPassError" class="text-danger small mt-1 position-absolute" style="top: 100%; left: 0; display: none;"></span>
                    </div>

                    <div class="form-group position-relative mb-5 mt-4">
                        <label class="form-label fw-bold small">@SharedText["Auth.Reset.ConfirmPassword"]</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-shield-check text-orange"></i></span>
                            <input type="password" id="confirmPassword" class="form-control bg-light border-0 py-2 shadow-none" placeholder="@SharedText["Auth.Reset.ConfirmPlaceholder"]" oninput="validateConfirmPassword()">
                            <span class="input-group-text bg-light border-0" style="cursor: pointer;" onclick="togglePassword('confirmPassword', 'iconConfirm')">
                                <i class="bi bi-eye text-muted" id="iconConfirm"></i>
                            </span>
                        </div>
                        <span id="confirmPassError" class="text-danger small mt-1 position-absolute" style="top: 100%; left: 0; display: none;"></span>
                    </div>

                    <button type="button" class="btn btn-orange w-100 rounded-3 py-3 fw-bold mb-3" onclick="submitResetPassword()">
                        <i class="bi bi-check-circle me-2"></i>@SharedText["Auth.Reset.Submit"]
                    </button>

                    <div class="text-center mt-3">
                        <a href="/Account/Login" class="text-muted text-decoration-none small hover-text-orange">
                            <i class="bi bi-arrow-left me-1"></i> @SharedText["Auth.Reset.BackToLogin"]
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="notificationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-sm">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-body text-center p-4 p-md-5">
                <div id="modalIcon" class="mb-4"></div>
                <h4 class="fw-bold mb-3" id="modalTitle">@SharedText["Common.Notifications"]</h4>
                <p class="text-muted mb-4" id="modalMessage">@SharedText["Auth.Reset.ModalDetail"]</p>
                <button type="button" class="btn btn-orange w-100 rounded-3 py-2 fw-bold shadow-sm" id="modalBtn" data-bs-dismiss="modal">
                    @SharedText["Common.Understood"]
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .bg-orange-light {
            background-color: #fff3ed;
        }

        .text-orange {
            color: #d35400;
        }

        .btn-orange {
            background-color: #d35400;
            color: white;
            transition: 0.3s;
        }

            .btn-orange:hover {
                background-color: #a04000;
                color: white;
                transform: translateY(-2px);
            }

        .hover-text-orange:hover {
            color: #d35400 !important;
        }

        /* Trị dứt điểm bệnh nháy form */
        .text-danger {
            position: absolute;
            top: 100%;
            left: 0;
            width: 100%;
            color: #dc2626;
            font-size: 0.8rem;
            margin-top: 0.3rem;
            line-height: 1.4;
            word-wrap: break-word;
        }
    </style>

    <script>
        const resetPasswordText = @Html.Raw(JsonSerializer.Serialize(new {
            passwordRule = SharedText["Auth.Reset.PasswordRule"].Value,
            passwordMismatch = SharedText["Auth.Reset.PasswordMismatch"].Value,
            required = SharedText["Auth.Reset.Required"].Value,
            success = SharedText["Common.Success"].Value,
            notification = SharedText["Common.Notifications"].Value,
            processing = SharedText["Common.Processing"].Value,
            connectionError = SharedText["Common.ConnectionError"].Value
        }));
        let notificationModal;

        window.addEventListener('DOMContentLoaded', (event) => {
            const modalEl = document.getElementById('notificationModal');
            if (modalEl) notificationModal = new bootstrap.Modal(modalEl);
        });

        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === "password") {
                input.type = "text";
                icon.classList.replace("bi-eye", "bi-eye-slash");
            } else {
                input.type = "password";
                icon.classList.replace("bi-eye-slash", "bi-eye");
            }
        }

        // Tắt báo lỗi
        function clearError(errorId) {
            const errorSpan = document.getElementById(errorId);
            if (errorSpan) {
                errorSpan.style.display = 'none';
                errorSpan.innerText = '';
            }
        }

        // Bật báo lỗi đỏ
        function showInlineError(errorId, message) {
            const errorSpan = document.getElementById(errorId);
            if (errorSpan) {
                errorSpan.innerText = message;
                errorSpan.style.display = 'block';
            }
        }

        // Radar bắt lỗi Mật khẩu mới
        function validateNewPassword() {
            const newPass = document.getElementById('newPassword').value;
            if (newPass.length === 0) { clearError('newPassError'); return false; }

            const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}$/;
            if (!passwordRegex.test(newPass)) {
                showInlineError('newPassError', resetPasswordText.passwordRule);
                return false;
            } else {
                clearError('newPassError');
                validateConfirmPassword();
                return true;
            }
        }

        // Radar bắt lỗi Xác nhận mật khẩu
        function validateConfirmPassword() {
            const newPass = document.getElementById('newPassword').value;
            const confirmPass = document.getElementById('confirmPassword').value;
            if (confirmPass.length === 0) { clearError('confirmPassError'); return false; }

            if (newPass !== confirmPass) {
                showInlineError('confirmPassError', resetPasswordText.passwordMismatch);
                return false;
            } else {
                clearError('confirmPassError');
                return true;
            }
        }

        // Modal thông minh
        function showMessage(type, message, callback = null) {
            try {
                const iconContainer = document.getElementById('modalIcon');
                const titleEl = document.getElementById('modalTitle');
                const messageEl = document.getElementById('modalMessage');
                const btn = document.getElementById('modalBtn');

                if (iconContainer && titleEl && messageEl && notificationModal) {
                    if (type === 'success') {
                        iconContainer.innerHTML = '<i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>';
                        titleEl.className = 'fw-bold mb-3 text-success';
                        titleEl.innerText = resetPasswordText.success;
                    } else {
                        iconContainer.innerHTML = '<i class="bi bi-x-circle-fill text-danger" style="font-size: 4rem;"></i>';
                        titleEl.className = 'fw-bold mb-3 text-danger';
                        titleEl.innerText = resetPasswordText.notification;
                    }
                    messageEl.innerText = message;

                    const newBtn = btn.cloneNode(true);
                    btn.parentNode.replaceChild(newBtn, btn);
                    if (callback) newBtn.addEventListener('click', callback);

                    notificationModal.show();
                    return;
                }
            } catch (e) { console.log(e); }
            showToast(message, type === 'error' ? 'error' : 'success');
        }

        function submitResetPassword() {
            const emailVal = document.getElementById('emailInput').value;
            const otpCodeVal = document.getElementById('otpCodeInput').value;
            const newPass = document.getElementById('newPassword').value;
            const confirm = document.getElementById('confirmPassword').value;

            if(!newPass || !confirm) {
                showMessage('error', resetPasswordText.required);
                return;
            }

            // Radar quét
            const isNewPassValid = validateNewPassword();
            const isConfirmValid = validateConfirmPassword();
            if (!isNewPassValid || !isConfirmValid) return;

            const payload = {
                Email: emailVal,
                OtpCode: otpCodeVal,
                NewPassword: newPass,
                ConfirmPassword: confirm
            };

            let btn = document.querySelector('button[onclick="submitResetPassword()"]');
            let originalText = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>' + resetPasswordText.processing;
            btn.disabled = true;

            fetch('/Password/ResetPassword', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    // Cập nhật thành công -> Bấm OK nhảy về trang Login
                    showMessage('success', data.message, () => {
                        window.location.href = '/Account/Login';
                    });
                } else {
                    showMessage('error', data.message);
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            })
            .catch(err => {
                console.error("Lỗi:", err);
                showMessage('error', resetPasswordText.connectionError);
                btn.innerHTML = originalText;
                btn.disabled = false;
            });
        }
    </script>
}
