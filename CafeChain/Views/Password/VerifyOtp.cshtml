@model CafeChain.ViewModels.Accounts.VerifyOtpViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Xác minh OTP</title>
    <link rel="stylesheet" href="~/css/ForgotPassword/otp.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        #cc-toast-container { position: fixed; bottom: 24px; right: 24px; z-index: 99999; display: flex; flex-direction: column; gap: 12px; }
        .cc-toast { display: flex; align-items: flex-start; gap: 12px; min-width: 280px; padding: 14px 16px; border-radius: 12px; background: #fff; box-shadow: 0 8px 24px rgba(0,0,0,0.12); border-left: 4px solid #fd7e14; opacity: 0; transform: translateY(16px); transition: all 0.25s ease; }
        .cc-toast.cc-show { opacity: 1; transform: translateY(0); }
        .cc-toast-msg { font-size: 0.85rem; color: #444; }
    </style>
</head>
<body>
    <div id="cc-toast-container"></div>

    <div class="otp-container">
        <h2>Xác minh OTP</h2>
        <p>Nhập mã 6 ký tự đã gửi đến email của bạn</p>

        <form asp-action="VerifyOtp" method="post" id="otpForm">
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="OtpCode" id="OtpCode" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="otp-box">
                <input maxlength="1" class="otp-input" autofocus />
                <input maxlength="1" class="otp-input" />
                <input maxlength="1" class="otp-input" />
                <input maxlength="1" class="otp-input" />
                <input maxlength="1" class="otp-input" />
                <input maxlength="1" class="otp-input" />
            </div>
            <div class="error-message">
                @Html.ValidationSummary()
            </div>

            <button type="submit">Xác nhận</button>
        </form>

        <div class="resend">
            <span id="countdown">05:00</span>
            <button id="resendBtn" disabled>Gửi lại OTP</button>
        </div>
    </div>

    <script>
        // Minimal inline Toast for standalone pages (no Layout)
        window.showToast = function(msg, type) {
            var c = document.getElementById('cc-toast-container');
            var t = document.createElement('div');
            t.className = 'cc-toast';
            t.style.borderLeftColor = type === 'error' ? '#dc3545' : type === 'success' ? '#28a745' : '#fd7e14';
            t.innerHTML = '<div class="cc-toast-msg">' + msg + '</div>';
            c.appendChild(t);
            requestAnimationFrame(function(){ requestAnimationFrame(function(){ t.classList.add('cc-show'); }); });
            setTimeout(function(){ t.style.opacity='0'; setTimeout(function(){ if(t.parentNode) t.parentNode.removeChild(t); }, 300); }, 3500);
        };

        const inputs = document.querySelectorAll(".otp-input");
        const hiddenInput = document.getElementById("OtpCode");
        const form = document.getElementById("otpForm");

        inputs.forEach((input, index) => {
            input.addEventListener("input", (e) => {
                let value = e.target.value;
                if (!/^[a-zA-Z0-9]$/.test(value)) { input.value = ""; return; }
                value = value.toUpperCase();
                input.value = value;
                if (value && index < inputs.length - 1) inputs[index + 1].focus();
                updateOtp();
            });
            input.addEventListener("keydown", (e) => {
                if (e.key === "Backspace" && !input.value && index > 0) inputs[index - 1].focus();
            });
        });

        function updateOtp() {
            let otp = "";
            inputs.forEach(i => otp += i.value);
            hiddenInput.value = otp;
        }

        form.addEventListener("submit", function (e) {
            if (hiddenInput.value.length !== 6) {
                e.preventDefault();
                showToast('Vui lòng nhập đủ 6 ký tự OTP!', 'warning');
            }
        });

         // ================== FIX COUNTDOWN ==================
        const expireAtStr = '@(((DateTime)ViewBag.ExpireAt).ToString("o"))';
        const expireAt = new Date(expireAtStr).getTime();

        const countdownEl = document.getElementById("countdown");
        const resendBtn = document.getElementById("resendBtn");

        const timer = setInterval(() => {
            const now = new Date().getTime();
            const timeLeft = Math.floor((expireAt - now) / 1000);

            if (timeLeft <= 0) {
                clearInterval(timer);
                countdownEl.innerText = "00:00";
                resendBtn.disabled = false;
                return;
            }

            countdownEl.innerText =
                String(Math.floor(timeLeft / 60)).padStart(2, '0') +
                ":" +
                String(timeLeft % 60).padStart(2, '0');

        }, 1000);

        resendBtn.addEventListener("click", () => {
            resendBtn.disabled = true;

            fetch('/Password/ResendOtp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify('@Model.Email')
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {

                    showToast('OTP mới đã được gửi!', 'success');

                    // RESET COUNTDOWN
                    const newExpire = new Date(data.expireAt).getTime();

                    const newTimer = setInterval(() => {
                        const now = new Date().getTime();
                        const timeLeft = Math.floor((newExpire - now) / 1000);

                        if (timeLeft <= 0) {
                            clearInterval(newTimer);
                            countdownEl.innerText = "00:00";
                            resendBtn.disabled = false;
                            return;
                        }

                        countdownEl.innerText =
                            String(Math.floor(timeLeft / 60)).padStart(2, '0') +
                            ":" +
                            String(timeLeft % 60).padStart(2, '0');

                    }, 1000);

                } else {
                    showToast(data.message, 'error');
                    resendBtn.disabled = false;
                }
            })
            .catch(() => {
                showToast('Lỗi gửi OTP', 'error');
                resendBtn.disabled = false;
            });
        });
    </script>
</body>
</html>
