@model CafeChain.ViewModels.StaffHub.StaffHubScheduleVM
@using System.Globalization
@using CafeChain.Application.Constants.Cloudinaries
@{
    ViewData["Title"] = "Lịch làm việc";
    Layout = "_Layout";
    var canAccessPos = ViewBag.CanAccessPos is true;
    var days = Enumerable.Range(0, 7).Select(i => Model.WeekStart.AddDays(i)).ToList();
}

<style>
    .staffhub-shell { max-width: 1180px; margin: 0 auto; }
    .staffhub-profile { background: linear-gradient(135deg,#7c2d12,#ea580c); color:#fff; border-radius:18px; }
    .staffhub-avatar { width:72px; height:72px; border-radius:50%; object-fit:cover; border:3px solid rgba(255,255,255,.75); }
    .schedule-day { border:1px solid #e2e8f0; border-radius:14px; background:#fff; min-height:170px; }
    .schedule-day.today { border-color:#fb923c; box-shadow:0 0 0 2px rgba(251,146,60,.14); }
    .schedule-item { border-left:4px solid #f97316; background:#fff7ed; border-radius:8px; padding:10px; margin-top:8px; }
    .schedule-item.cancelled { border-color:#94a3b8; background:#f8fafc; color:#64748b; }
</style>

<div id="staffHubApp"
     class="container-fluid py-4"
     data-requires-password-change="@Model.RequiresPasswordChange.ToString().ToLowerInvariant()"
     data-change-password-url="@Url.Action("ChangeRequiredPassword", "StaffHub")"
     data-issue-pos-url="@Url.Action("IssuePosToken", "StaffHub")">
    @Html.AntiForgeryToken()
    <div class="staffhub-shell">
        <section class="staffhub-profile p-4 mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <img class="staffhub-avatar" src="@(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? DefaultImages.StaffAvatarUrl : Model.AvatarUrl)" onerror="this.src='@DefaultImages.StaffAvatarUrl'" />
                <div><h2 class="fw-bold mb-1">@Model.StaffName</h2><div>@Model.StoreName · Lịch làm việc dự kiến</div></div>
            </div>
            @if (canAccessPos)
            {
                <button id="openPosButton" type="button" class="btn btn-light btn-lg fw-bold"><i class="bi bi-cash-register me-2"></i>Mở POS</button>
            }
        </section>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-date="@Model.WeekStart.AddDays(-7).ToString("yyyy-MM-dd")"><i class="bi bi-chevron-left"></i> Tuần trước</a>
            <h4 class="fw-bold mb-0">@Model.WeekStart.ToString("dd/MM") – @Model.WeekStart.AddDays(6).ToString("dd/MM/yyyy")</h4>
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-date="@Model.WeekStart.AddDays(7).ToString("yyyy-MM-dd")">Tuần sau <i class="bi bi-chevron-right"></i></a>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-3">
            @foreach (var day in days)
            {
                var schedules = Model.Schedules.Where(x => x.WorkDate.Date == day.Date).ToList();
                <div class="col">
                    <div class="schedule-day p-3 @(day.Date == DateTime.Today ? "today" : "")">
                        <div class="fw-bold text-capitalize">@day.ToString("dddd", new CultureInfo("vi-VN"))</div>
                        <small class="text-muted">@day.ToString("dd/MM/yyyy")</small>
                        @foreach (var item in schedules)
                        {
                            <div class="schedule-item @(item.StatusCode == "CANCELLED" ? "cancelled" : "")">
                                <div class="fw-semibold">@item.ShiftName</div>
                                <div>@item.StartTime.ToString(@"hh\:mm") – @item.EndTime.ToString(@"hh\:mm") @(item.IsOvernight ? "(+1 ngày)" : "")</div>
                                @if (item.StatusCode == "CANCELLED") { <small>Đã hủy</small> }
                            </div>
                        }
                        @if (!schedules.Any()) { <div class="text-muted small mt-4">Chưa có lịch.</div> }
                    </div>
                </div>
            }
        </div>
        <div class="alert alert-info mt-4"><i class="bi bi-info-circle me-2"></i>Đây là lịch dự kiến, không phải dữ liệu chấm công. Việc chưa được xếp lịch không ngăn bạn mở POS nếu tài khoản có quyền.</div>
    </div>
</div>

<div class="modal fade" id="passwordModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form id="requiredPasswordForm">
        <div class="modal-header"><h5 class="modal-title">Đổi mật khẩu lần đầu</h5></div>
        <div class="modal-body">
            <p class="text-muted">Bạn cần đổi mật khẩu mặc định trước khi tiếp tục.</p>
            <div class="mb-3"><label class="form-label">Mật khẩu hiện tại</label><input type="password" class="form-control" name="oldPassword" required></div>
            <div><label class="form-label">Mật khẩu mới</label><input type="password" class="form-control" name="newPassword" minlength="6" required></div>
        </div><div class="modal-footer"><button type="submit" class="btn btn-primary">Đổi mật khẩu</button></div>
    </form></div></div>
</div>

@section Scripts {
    <script src="~/js/StaffHub/staffhub-schedule.js" asp-append-version="true"></script>
}
