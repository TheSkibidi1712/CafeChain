@model CafeChain.ViewModels.StaffHub.StaffHubScheduleVM
@using System.Globalization
@using CafeChain.Application.Constants.Cloudinaries
@using CafeChain.Application.DTOs.POS
@{
    ViewData["Title"] = "Lịch làm việc";
    Layout = "_Layout";
    var canOpenPos = ViewBag.CanOpenPos is true;
    var canRegisterTerminal = ViewBag.CanRegisterTerminal is true;
    var canManageOperatorPin = ViewBag.CanManageOperatorPin is true;
    var canAccessDashboard = ViewBag.CanAccessDashboard is true;
    var days = Enumerable.Range(0, 7).Select(i => Model.WeekStart.AddDays(i)).ToList();
    var activeSchedules = Model.Schedules
        .Where(x => !string.Equals(x.StatusCode, "CANCELLED", StringComparison.OrdinalIgnoreCase))
        .ToList();
    var workingDayCount = activeSchedules
        .Select(x => x.WorkDate.Date)
        .Distinct()
        .Count();
    var cancelledScheduleCount = Model.Schedules.Count(
        x => string.Equals(x.StatusCode, "CANCELLED", StringComparison.OrdinalIgnoreCase));
    var terminals = ViewBag.PosTerminals as IReadOnlyList<PosTerminalOptionDto>
        ?? Array.Empty<PosTerminalOptionDto>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/StaffHub/staffhub.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/verification-code-input.css" asp-append-version="true" />
}

<div id="staffHubApp"
     class="staffhub-page"
     data-store-id="@((int?)ViewBag.CurrentStoreId ?? 0)"
     data-store-name="@Model.StoreName"
     data-preview-pos-url="@Url.Action("PreviewOpenPos", "StaffHub")"
     data-issue-pos-url="@Url.Action("IssuePosToken", "StaffHub")"
     data-cancel-open-pos-url="@Url.Action("CancelOpenPosIntent", "StaffHub")"
     data-resume-pos-url="@Url.Action("IssueResumePosToken", "StaffHub")"
     data-request-open-otp-url="@Url.Action("RequestOpenPosOtp", "StaffHub")"
     data-open-otp-state-url="@Url.Action("GetOpenPosOtpState", "StaffHub")"
     data-request-terminal-otp-url="@Url.Action("RequestTerminalRegistrationOtp", "StaffHub")"
     data-terminal-otp-state-url="@Url.Action("GetTerminalRegistrationOtpState", "StaffHub")"
     data-cancel-terminal-otp-url="@Url.Action("CancelTerminalRegistrationOtp", "StaffHub")"
     data-request-late-open-approval-url="@Url.Action("RequestLateOpenApproval", "StaffHub")"
     data-late-open-approval-state-url="@Url.Action("GetLateOpenApproval", "StaffHub")"
     data-verify-otp-url="@Url.Action("VerifyOperationalOtp", "StaffHub")"
     data-resend-otp-url="@Url.Action("ResendOperationalOtp", "StaffHub")"
     data-set-operator-pin-url="@Url.Action("SetOperatorPin", "StaffHub")"
     data-operator-pin-configured="@Model.OperatorPinConfigured.ToString().ToLowerInvariant()"
     >
    <span id="staffHubLaunchOptions"
          data-auto-open-pos="@((ViewBag.AutoOpenPos is true).ToString().ToLowerInvariant())"
          data-requested-terminal-id="@(ViewBag.RequestedTerminalId as string ?? string.Empty)"
          data-pos-launch-error="@(ViewBag.PosLaunchError as string ?? string.Empty)"
          hidden></span>
    @Html.AntiForgeryToken()
    <div class="staffhub-shell">
        <section class="staffhub-profile">
            <div class="staffhub-profile-main">
                <div class="staffhub-avatar-wrap">
                    <img class="staffhub-avatar"
                         src="@(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? DefaultImages.StaffAvatarUrl : Model.AvatarUrl)"
                         alt="Ảnh đại diện của @Model.StaffName"
                         onerror="this.src='@DefaultImages.StaffAvatarUrl'" />
                    <span class="staffhub-online-dot" title="Tài khoản đang hoạt động" aria-hidden="true"></span>
                </div>
                <div class="staffhub-profile-copy">
                    <span class="staffhub-eyebrow"><i class="bi bi-person-badge"></i> Không gian nhân viên</span>
                    <h1>@Model.StaffName</h1>
                    <div class="staffhub-profile-meta">
                        <span><i class="bi bi-shop"></i> @Model.StoreName</span>
                        <span><i class="bi bi-calendar3"></i> Lịch làm việc dự kiến</span>
                    </div>
                </div>
            </div>
            <nav class="staffhub-profile-actions" aria-label="Điều hướng StaffHub">
                <a asp-area=""
                   asp-controller="AppLauncher"
                   asp-action="Index"
                   class="staffhub-action-button is-secondary"
                   aria-label="Quay về AppLauncher">
                    <span><i class="bi bi-grid-3x3-gap"></i></span>
                    <span><strong>AppLauncher</strong><small>Chọn ứng dụng</small></span>
                    <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                </a>

                @if (canAccessDashboard)
                {
                    <a asp-area="Admin"
                       asp-controller="Dashboard"
                       asp-action="Index"
                       class="staffhub-action-button is-secondary"
                       aria-label="Quay về Dashboard">
                        <span><i class="bi bi-speedometer2"></i></span>
                        <span><strong>Dashboard</strong><small>Tổng quan vận hành</small></span>
                        <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                    </a>
                }

                @if (canOpenPos || canRegisterTerminal)
                {
                    @if (canOpenPos)
                    {
                        <button id="openPosButton" type="button" class="staffhub-action-button is-primary">
                            <span><i class="bi bi-cash-register"></i></span>
                            <span><strong>Mở POS</strong><small>Bắt đầu bán hàng</small></span>
                            <i class="bi bi-arrow-right" aria-hidden="true"></i>
                        </button>
                    }
                    @if (canRegisterTerminal)
                    {
                        <button id="registerTerminalButton"
                                type="button"
                                class="staffhub-action-button is-secondary staffhub-terminal-action"
                                data-terminal-state="unlinked"
                                aria-describedby="terminalActionSubtitle">
                            <span id="terminalActionIcon"><i class="bi bi-display"></i></span>
                            <span>
                                <strong id="terminalActionTitle">Đăng ký thiết bị này</strong>
                                <small id="terminalActionSubtitle">Chưa liên kết Terminal POS</small>
                            </span>
                            <span id="terminalActionBadge" class="staffhub-terminal-action-badge is-unlinked">Chưa liên kết</span>
                        </button>
                    }
                }
            </nav>
        </section>

        <section class="staffhub-summary" aria-label="Tổng quan lịch làm việc">
            <div class="staffhub-summary-card">
                <span class="staffhub-summary-icon"><i class="bi bi-calendar2-check"></i></span>
                <span><strong>@activeSchedules.Count</strong><small>Ca được xếp</small></span>
            </div>
            <div class="staffhub-summary-card">
                <span class="staffhub-summary-icon is-days"><i class="bi bi-calendar-week"></i></span>
                <span><strong>@workingDayCount</strong><small>Ngày có lịch</small></span>
            </div>
            <div class="staffhub-summary-card">
                <span class="staffhub-summary-icon is-cancelled"><i class="bi bi-calendar2-x"></i></span>
                <span><strong>@cancelledScheduleCount</strong><small>Ca đã hủy</small></span>
            </div>
        </section>

        <section class="staffhub-schedule-panel">
            <header class="staffhub-schedule-header">
                <div class="staffhub-section-heading">
                    <span class="staffhub-section-icon"><i class="bi bi-calendar3"></i></span>
                    <div>
                        <span>Lịch cá nhân</span>
                        <h2>@Model.WeekStart.ToString("dd/MM") – @Model.WeekStart.AddDays(6).ToString("dd/MM/yyyy")</h2>
                    </div>
                </div>
                <nav class="staffhub-week-nav" aria-label="Điều hướng tuần">
                    <a asp-action="Index"
                       asp-route-date="@Model.WeekStart.AddDays(-7).ToString("yyyy-MM-dd")"
                       aria-label="Xem tuần trước">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i><span>Tuần trước</span>
                    </a>
                    <a asp-action="Index"
                       asp-route-date="@Model.WeekStart.AddDays(7).ToString("yyyy-MM-dd")"
                       aria-label="Xem tuần sau">
                        <span>Tuần sau</span><i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </a>
                </nav>
            </header>

            <div class="staffhub-calendar-grid">
                @foreach (var day in days)
                {
                    var schedules = Model.Schedules.Where(x => x.WorkDate.Date == day.Date).ToList();
                    var isToday = day.Date == DateTime.Today;
                    <article class="schedule-day @(isToday ? "today" : "")">
                        <header class="schedule-day-header">
                            <div>
                                <span class="schedule-weekday">@day.ToString("dddd", new CultureInfo("vi-VN"))</span>
                                @if (isToday)
                                {
                                    <time datetime="@day.ToString("yyyy-MM-dd")" aria-current="date">@day.ToString("dd/MM/yyyy")</time>
                                }
                                else
                                {
                                    <time datetime="@day.ToString("yyyy-MM-dd")">@day.ToString("dd/MM/yyyy")</time>
                                }
                            </div>
                            @if (isToday)
                            {
                                <span class="schedule-today-badge">Hôm nay</span>
                            }
                        </header>

                        <div class="schedule-day-body">
                            @foreach (var item in schedules)
                            {
                                <div class="schedule-item @(item.StatusCode == "CANCELLED" ? "cancelled" : "")">
                                    <div class="schedule-item-top">
                                        <strong>@item.ShiftName</strong>
                                        @if (item.StatusCode == "CANCELLED")
                                        {
                                            <span class="schedule-cancelled-badge">Đã hủy</span>
                                        }
                                    </div>
                                    <div class="schedule-time">
                                        <i class="bi bi-clock" aria-hidden="true"></i>
                                        <span>@item.PlannedStartLocal.ToString("HH:mm") – @item.PlannedEndLocal.ToString("HH:mm")</span>
                                        @if (item.IsOvernight)
                                        {
                                            <span class="schedule-overnight-badge" title="Ca làm việc kéo dài qua ngày hôm sau">Qua đêm · +1 ngày</span>
                                        }
                                    </div>
                                </div>
                            }

                            @if (!schedules.Any())
                            {
                                <div class="schedule-empty">
                                    <span class="schedule-empty-icon"><i class="bi bi-cup-hot" aria-hidden="true"></i></span>
                                    <strong>Chưa có lịch</strong>
                                    <small>Thời gian nghỉ hoặc chưa được phân ca.</small>
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>

        <aside class="staffhub-note">
            <span class="staffhub-note-icon"><i class="bi bi-info-circle-fill" aria-hidden="true"></i></span>
            <div>
                <strong>Lịch làm việc dự kiến</strong>
                <p>Đây không phải dữ liệu chấm công. Việc chưa được xếp lịch không ngăn bạn mở POS nếu tài khoản đã được cấp quyền.</p>
            </div>
        </aside>

        @if (canManageOperatorPin)
        {
            <section class="staffhub-note" aria-labelledby="operatorPinHeading">
                <span class="staffhub-note-icon"><i class="bi bi-shield-lock-fill" aria-hidden="true"></i></span>
                <div class="staffhub-operator-pin-copy">
                    <div class="staffhub-operator-pin-heading">
                        <strong id="operatorPinHeading">PIN thao tác POS</strong>
                        <span id="operatorPinStateBadge"
                              class="staffhub-pin-status @(Model.OperatorPinConfigured ? "is-configured" : "is-unconfigured")"
                              role="status" aria-live="polite">
                            <i class="bi @(Model.OperatorPinConfigured ? "bi-check-circle-fill" : "bi-exclamation-circle-fill")" aria-hidden="true"></i>
                            <span>@(Model.OperatorPinConfigured ? "Đã thiết lập" : "Chưa thiết lập")</span>
                        </span>
                    </div>
                    <p>PIN cá nhân gồm 6 chữ số, dùng khi đổi Current Operator. PIN không thay đổi người chịu trách nhiệm két.</p>
                    <p id="operatorPinStateText" class="staffhub-pin-state-text">
                        @(Model.OperatorPinConfigured
                            ? "PIN đã sẵn sàng để xác thực khi đổi người thao tác POS."
                            : "Bạn cần thiết lập PIN trước khi có thể trở thành Current Operator.")
                    </p>
                    <button id="openOperatorPinDialog" type="button" class="staffhub-dialog-button is-secondary">
                        @(Model.OperatorPinConfigured ? "Đổi PIN" : "Thiết lập PIN")
                    </button>
                </div>
            </section>
        }

    </div>

        <div id="openPosPreviewDialog" class="modal fade staffhub-pos-dialog" tabindex="-1" aria-hidden="true" aria-labelledby="openPosPreviewTitle">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <form class="modal-content staffhub-pos-dialog-card">
                <header class="staffhub-pos-dialog-header">
                    <span class="staffhub-pos-dialog-icon"><i class="bi bi-cash-register" aria-hidden="true"></i></span>
                    <div>
                        <small>Xác nhận mở POS</small>
                        <h2 id="openPosPreviewTitle">Kiểm tra lịch dự kiến</h2>
                    </div>
                </header>
                <div class="modal-body staffhub-pos-dialog-body">
                    <label class="staffhub-terminal-picker staffhub-modal-terminal-picker">
                        <span>Terminal POS</span>
                        <select id="staffHubTerminalSelect">
                            <option value="">Chọn terminal</option>
                            @foreach (var terminal in terminals)
                            {
                                <option value="@terminal.TerminalId">@terminal.Name</option>
                            }
                        </select>
                    </label>
                    <dl class="staffhub-pos-preview-grid">
                        <div><dt>Nhân viên</dt><dd>@Model.StaffName</dd></div>
                        <div><dt>Cửa hàng</dt><dd>@Model.StoreName</dd></div>
                        <div><dt>Thời gian máy chủ</dt><dd id="openPosServerTime">—</dd></div>
                        <div><dt>Phân loại</dt><dd id="openPosContextLabel">—</dd></div>
                        <div id="openPosPlannedRow" hidden><dt>Lịch liên quan</dt><dd id="openPosPlannedTime">—</dd></div>
                        <div id="openPosExpiryRow" hidden><dt>Dự kiến hết hạn</dt><dd id="openPosExpiryTime">—</dd></div>
                        <div id="openPosBlockingIdRow" hidden><dt>Mã phiên</dt><dd id="openPosBlockingId">—</dd></div>
                        <div id="openPosBlockingTerminalRow" hidden><dt>Terminal</dt><dd id="openPosBlockingTerminal">—</dd></div>
                        <div id="openPosBlockingStartRow" hidden><dt>Bắt đầu</dt><dd id="openPosBlockingStart">—</dd></div>
                        <div id="openPosBlockingStatusRow" hidden><dt>Trạng thái</dt><dd id="openPosBlockingStatus">—</dd></div>
                        <div id="openPosBlockingExpiryRow" hidden><dt>Hết hạn</dt><dd id="openPosBlockingExpiry">—</dd></div>
                    </dl>
                    <div id="openPosPreviewNotice" class="staffhub-pos-preview-notice" role="status"></div>
                    <div id="openPosApprovalFields" hidden>
                        <label>Lý do
                            <textarea id="openPosReason" minlength="10" maxlength="500" aria-describedby="openPosReasonCounter"></textarea>
                            <small id="openPosReasonCounter">0 / 500</small>
                        </label>
                        <div id="openPosOtpFields" hidden>
                            <button id="requestOpenPosOtp" type="button" class="staffhub-dialog-button is-secondary">Gửi OTP</button>
                            <div id="openPosOtpVerification" hidden>
                                <label>Mã OTP <input id="openPosOtpCode" maxlength="6" autocomplete="one-time-code" data-verification-code-input /></label>
                                <button id="verifyOpenPosOtp" type="button" class="staffhub-dialog-button is-secondary">Xác nhận OTP</button>
                                <button id="resendOpenPosOtp" type="button" class="staffhub-dialog-button is-secondary" disabled>Gửi lại OTP</button>
                            </div>
                            <strong id="openPosOtpVerified" class="staffhub-otp-verified" hidden>✓ OTP đã được xác nhận</strong>
                            <small id="openPosOtpStatus" aria-live="polite"></small>
                        </div>
                        <div id="openPosManagerApprovalFields" hidden>
                            <button id="requestLateOpenApproval" type="button" class="staffhub-dialog-button is-primary">Gửi yêu cầu Manager</button>
                            <small id="lateOpenApprovalStatus" aria-live="polite"></small>
                        </div>
                    </div>
                    <p class="staffhub-pos-preview-boundary">
                        Việc mở POS chỉ tạo phiên chịu trách nhiệm POS/két. Hệ thống không tạo lịch làm việc hoặc dữ liệu chấm công.
                    </p>
                    <p class="staffhub-pos-preview-next">
                        Terminal, lý do và phê duyệt (nếu cần) được xác nhận tại StaffHub. POS chỉ yêu cầu nhập tiền đầu phiên.
                    </p>
                </div>
                <footer class="staffhub-pos-dialog-actions">
                    <button id="cancelOpenPosPreview" type="button" class="staffhub-dialog-button is-secondary">Hủy</button>
                    <button id="continueOpenPosPreview" type="button" class="staffhub-dialog-button is-primary" hidden>
                        <span>Tiếp tục sang POS</span><i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </button>
                    <button id="resumeExistingPos" type="button" class="staffhub-dialog-button is-primary" hidden></button>
                </footer>
            </form>
            </div>
        </div>

        <div id="terminalRegistrationDialog" class="modal fade staffhub-pos-dialog" tabindex="-1" aria-hidden="true" aria-labelledby="terminalRegistrationDialogTitle">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <form class="modal-content staffhub-pos-dialog-card">
                <header class="staffhub-pos-dialog-header">
                    <span class="staffhub-pos-dialog-icon"><i class="bi bi-display" aria-hidden="true"></i></span>
                    <div>
                        <small>Thiết bị POS hiện tại</small>
                        <h2 id="terminalRegistrationDialogTitle">Đăng ký Terminal POS</h2>
                    </div>
                </header>
                <div class="modal-body staffhub-pos-dialog-body">
                    <section id="terminalDeviceState"
                             class="staffhub-terminal-device-state is-unlinked"
                             role="status"
                             aria-live="polite">
                        <span id="terminalDeviceStateIcon" class="staffhub-terminal-device-state-icon">
                            <i class="bi bi-display" aria-hidden="true"></i>
                        </span>
                        <div>
                            <span id="terminalDeviceStateBadge" class="staffhub-terminal-device-state-badge">Chưa liên kết</span>
                            <h3 id="terminalDeviceStateTitle">Thiết bị này chưa được đăng ký</h3>
                            <p id="terminalDeviceStateDescription">Mỗi thiết bị chỉ sử dụng một Terminal ID ổn định.</p>
                        </div>
                    </section>

                    <dl id="terminalDeviceDetails" class="staffhub-terminal-device-details" hidden>
                        <div><dt>Tên Terminal</dt><dd id="terminalDeviceName">—</dd></div>
                        <div><dt>Cửa hàng</dt><dd id="terminalDeviceStore">@Model.StoreName</dd></div>
                        <div><dt>Mã thiết bị</dt><dd id="terminalDeviceId">—</dd></div>
                    </dl>

                    <section id="terminalRegistrationFields" class="staffhub-terminal-registration-fields">
                        <label for="terminalRegistrationName">Tên Terminal trên thiết bị này</label>
                        <input id="terminalRegistrationName"
                               name="TerminalName"
                               maxlength="100"
                               autocomplete="off"
                               placeholder="Ví dụ: Quầy pha chế 01" />
                        <p>
                            Thao tác <strong>Gửi yêu cầu xác nhận Terminal</strong> sẽ chuyển yêu cầu tới người có quyền phê duyệt. Người duyệt mở
                            <strong>Thông báo</strong>, chọn <strong>Xem OTP</strong> rồi xác nhận Terminal.
                        </p>
                    </section>

                    @if (terminals.Count > 0)
                    {
                        <section id="terminalExistingLink" class="staffhub-terminal-existing-link">
                            <div>
                                <strong>Thiết bị này đã được đăng ký trước đây?</strong>
                                <p>Liên kết với một Terminal active hiện có. Thao tác này chỉ lưu lựa chọn trên trình duyệt và không cấp thêm quyền.</p>
                            </div>
                            <label for="terminalExistingSelect">Terminal đã được duyệt</label>
                            <select id="terminalExistingSelect" name="ExistingTerminalId">
                                <option value="">Chọn Terminal active</option>
                                @foreach (var terminal in terminals)
                                {
                                    <option value="@terminal.TerminalId">@terminal.Name</option>
                                }
                            </select>
                            <button id="linkExistingTerminal" type="button" class="staffhub-dialog-button is-secondary">
                                Liên kết Terminal đã có
                            </button>
                        </section>
                    }

                    <small id="terminalRegistrationStatus" class="staffhub-terminal-registration-feedback" aria-live="polite"></small>
                </div>
                <footer class="staffhub-pos-dialog-actions">
                    <button id="cancelTerminalRegistration" type="button" class="staffhub-dialog-button is-secondary">Đóng</button>
                    <button id="cancelTerminalRegistrationRequest" type="button" class="staffhub-dialog-button is-secondary" hidden>Hủy yêu cầu xác nhận Terminal</button>
                    <button id="requestTerminalOtp" type="button" class="staffhub-dialog-button is-primary">Đăng ký thiết bị này</button>
                    <button id="resendTerminalOtp" type="button" class="staffhub-dialog-button is-primary" disabled hidden>Gửi lại OTP</button>
                </footer>
            </form>
            </div>
        </div>

        <div id="operatorPinDialog" class="modal fade staffhub-pos-dialog" tabindex="-1" aria-hidden="true" aria-labelledby="operatorPinDialogTitle">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <form id="operatorPinForm" class="modal-content staffhub-pos-dialog-card">
                <header class="staffhub-pos-dialog-header">
                    <h2 id="operatorPinDialogTitle">@(Model.OperatorPinConfigured ? "Đổi PIN thao tác POS" : "Thiết lập PIN thao tác POS")</h2>
                </header>
                <div class="modal-body staffhub-pos-dialog-body">
                    <label>Mật khẩu hiện tại
                        <input id="operatorCurrentPassword" type="password" autocomplete="current-password" maxlength="200" required />
                    </label>
                    <label>PIN mới gồm 6 chữ số
                        <input id="operatorNewPin" type="password" inputmode="numeric" autocomplete="new-password" minlength="6" maxlength="6" pattern="[0-9]{6}" data-verification-code-input data-verification-mode="pin" required />
                    </label>
                    <small id="operatorPinStatus" aria-live="polite"></small>
                </div>
                <footer class="staffhub-pos-dialog-actions">
                    <button id="cancelOperatorPin" type="button" class="staffhub-dialog-button is-secondary">Hủy</button>
                    <button id="saveOperatorPin" type="submit" class="staffhub-dialog-button is-primary">Lưu PIN</button>
                </footer>
            </form>
            </div>
        </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.25/dist/sweetalert2.all.min.js"></script>
    <script src="~/lib/microsoft-signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/shared/verification-code-input.js" asp-append-version="true"></script>
    <script src="~/js/StaffHub/staffhub-schedule.js" asp-append-version="true"></script>
}
