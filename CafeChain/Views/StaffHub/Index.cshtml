@model CafeChain.ViewModels.StaffHub.StaffHubScheduleVM
@using System.Globalization
@using CafeChain.Application.Constants.Cloudinaries
@{
    ViewData["Title"] = "Lịch làm việc";
    Layout = "_Layout";
    var canAccessPos = ViewBag.CanAccessPos is true;
    var canAccessDashboard = ViewBag.CanAccessDashboard is true;
    var days = Enumerable.Range(0, 7).Select(i => Model.WeekStart.AddDays(i)).ToList();
    var activeSchedules = Model.Schedules
        .Where(x => !string.Equals(x.StatusCode, "CANCELLED", StringComparison.OrdinalIgnoreCase))
        .ToList();
    var workingDayCount = activeSchedules
        .Select(x => x.WorkDate.Date)
        .Distinct()
        .Count();
    var cancelledScheduleCount = Model.Schedules.Count(
        x => string.Equals(x.StatusCode, "CANCELLED", StringComparison.OrdinalIgnoreCase));
}

@section Styles {
    <link rel="stylesheet" href="~/css/StaffHub/staffhub.css" asp-append-version="true" />
}

<div id="staffHubApp"
     class="staffhub-page"
     data-preview-pos-url="@Url.Action("PreviewOpenPos", "StaffHub")"
     data-issue-pos-url="@Url.Action("IssuePosToken", "StaffHub")">
    @Html.AntiForgeryToken()
    <div class="staffhub-shell">
        <section class="staffhub-profile">
            <div class="staffhub-profile-main">
                <div class="staffhub-avatar-wrap">
                    <img class="staffhub-avatar"
                         src="@(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? DefaultImages.StaffAvatarUrl : Model.AvatarUrl)"
                         alt="Ảnh đại diện của @Model.StaffName"
                         onerror="this.src='@DefaultImages.StaffAvatarUrl'" />
                    <span class="staffhub-online-dot" title="Tài khoản đang hoạt động" aria-hidden="true"></span>
                </div>
                <div class="staffhub-profile-copy">
                    <span class="staffhub-eyebrow"><i class="bi bi-person-badge"></i> Không gian nhân viên</span>
                    <h1>@Model.StaffName</h1>
                    <div class="staffhub-profile-meta">
                        <span><i class="bi bi-shop"></i> @Model.StoreName</span>
                        <span><i class="bi bi-calendar3"></i> Lịch làm việc dự kiến</span>
                    </div>
                </div>
            </div>
            <nav class="staffhub-profile-actions" aria-label="Điều hướng StaffHub">
                <a asp-area=""
                   asp-controller="AppLauncher"
                   asp-action="Index"
                   class="staffhub-action-button is-secondary"
                   aria-label="Quay về AppLauncher">
                    <span><i class="bi bi-grid-3x3-gap"></i></span>
                    <span><strong>AppLauncher</strong><small>Chọn ứng dụng</small></span>
                    <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                </a>

                @if (canAccessDashboard)
                {
                    <a asp-area="Admin"
                       asp-controller="Dashboard"
                       asp-action="Index"
                       class="staffhub-action-button is-secondary"
                       aria-label="Quay về Dashboard">
                        <span><i class="bi bi-speedometer2"></i></span>
                        <span><strong>Dashboard</strong><small>Tổng quan vận hành</small></span>
                        <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                    </a>
                }

                @if (canAccessPos)
                {
                    <button id="openPosButton" type="button" class="staffhub-action-button is-primary">
                        <span><i class="bi bi-cash-register"></i></span>
                        <span><strong>Mở POS</strong><small>Bắt đầu bán hàng</small></span>
                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </button>
                }
            </nav>
        </section>

        <section class="staffhub-summary" aria-label="Tổng quan lịch làm việc">
            <div class="staffhub-summary-card">
                <span class="staffhub-summary-icon"><i class="bi bi-calendar2-check"></i></span>
                <span><strong>@activeSchedules.Count</strong><small>Ca được xếp</small></span>
            </div>
            <div class="staffhub-summary-card">
                <span class="staffhub-summary-icon is-days"><i class="bi bi-calendar-week"></i></span>
                <span><strong>@workingDayCount</strong><small>Ngày có lịch</small></span>
            </div>
            <div class="staffhub-summary-card">
                <span class="staffhub-summary-icon is-cancelled"><i class="bi bi-calendar2-x"></i></span>
                <span><strong>@cancelledScheduleCount</strong><small>Ca đã hủy</small></span>
            </div>
        </section>

        <section class="staffhub-schedule-panel">
            <header class="staffhub-schedule-header">
                <div class="staffhub-section-heading">
                    <span class="staffhub-section-icon"><i class="bi bi-calendar3"></i></span>
                    <div>
                        <span>Lịch cá nhân</span>
                        <h2>@Model.WeekStart.ToString("dd/MM") – @Model.WeekStart.AddDays(6).ToString("dd/MM/yyyy")</h2>
                    </div>
                </div>
                <nav class="staffhub-week-nav" aria-label="Điều hướng tuần">
                    <a asp-action="Index"
                       asp-route-date="@Model.WeekStart.AddDays(-7).ToString("yyyy-MM-dd")"
                       aria-label="Xem tuần trước">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i><span>Tuần trước</span>
                    </a>
                    <a asp-action="Index"
                       asp-route-date="@Model.WeekStart.AddDays(7).ToString("yyyy-MM-dd")"
                       aria-label="Xem tuần sau">
                        <span>Tuần sau</span><i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </a>
                </nav>
            </header>

            <div class="staffhub-calendar-grid">
                @foreach (var day in days)
                {
                    var schedules = Model.Schedules.Where(x => x.WorkDate.Date == day.Date).ToList();
                    var isToday = day.Date == DateTime.Today;
                    <article class="schedule-day @(isToday ? "today" : "")">
                        <header class="schedule-day-header">
                            <div>
                                <span class="schedule-weekday">@day.ToString("dddd", new CultureInfo("vi-VN"))</span>
                                @if (isToday)
                                {
                                    <time datetime="@day.ToString("yyyy-MM-dd")" aria-current="date">@day.ToString("dd/MM/yyyy")</time>
                                }
                                else
                                {
                                    <time datetime="@day.ToString("yyyy-MM-dd")">@day.ToString("dd/MM/yyyy")</time>
                                }
                            </div>
                            @if (isToday)
                            {
                                <span class="schedule-today-badge">Hôm nay</span>
                            }
                        </header>

                        <div class="schedule-day-body">
                            @foreach (var item in schedules)
                            {
                                <div class="schedule-item @(item.StatusCode == "CANCELLED" ? "cancelled" : "")">
                                    <div class="schedule-item-top">
                                        <strong>@item.ShiftName</strong>
                                        @if (item.StatusCode == "CANCELLED")
                                        {
                                            <span class="schedule-cancelled-badge">Đã hủy</span>
                                        }
                                    </div>
                                    <div class="schedule-time">
                                        <i class="bi bi-clock" aria-hidden="true"></i>
                                        <span>@item.PlannedStartLocal.ToString("HH:mm") – @item.PlannedEndLocal.ToString("HH:mm")</span>
                                        @if (item.IsOvernight)
                                        {
                                            <span class="schedule-overnight-badge" title="Ca làm việc kéo dài qua ngày hôm sau">Qua đêm · +1 ngày</span>
                                        }
                                    </div>
                                </div>
                            }

                            @if (!schedules.Any())
                            {
                                <div class="schedule-empty">
                                    <span class="schedule-empty-icon"><i class="bi bi-cup-hot" aria-hidden="true"></i></span>
                                    <strong>Chưa có lịch</strong>
                                    <small>Thời gian nghỉ hoặc chưa được phân ca.</small>
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>

        <aside class="staffhub-note">
            <span class="staffhub-note-icon"><i class="bi bi-info-circle-fill" aria-hidden="true"></i></span>
            <div>
                <strong>Lịch làm việc dự kiến</strong>
                <p>Đây không phải dữ liệu chấm công. Việc chưa được xếp lịch không ngăn bạn mở POS nếu tài khoản đã được cấp quyền.</p>
            </div>
        </aside>

        <dialog id="openPosPreviewDialog" class="staffhub-pos-dialog" aria-labelledby="openPosPreviewTitle">
            <form method="dialog" class="staffhub-pos-dialog-card">
                <header class="staffhub-pos-dialog-header">
                    <span class="staffhub-pos-dialog-icon"><i class="bi bi-cash-register" aria-hidden="true"></i></span>
                    <div>
                        <small>Xác nhận mở POS</small>
                        <h2 id="openPosPreviewTitle">Kiểm tra lịch dự kiến</h2>
                    </div>
                </header>
                <div class="staffhub-pos-dialog-body">
                    <dl class="staffhub-pos-preview-grid">
                        <div><dt>Nhân viên</dt><dd>@Model.StaffName</dd></div>
                        <div><dt>Cửa hàng</dt><dd>@Model.StoreName</dd></div>
                        <div><dt>Thời gian máy chủ</dt><dd id="openPosServerTime">—</dd></div>
                        <div><dt>Phân loại</dt><dd id="openPosContextLabel">—</dd></div>
                        <div id="openPosPlannedRow" hidden><dt>Lịch liên quan</dt><dd id="openPosPlannedTime">—</dd></div>
                        <div id="openPosExpiryRow" hidden><dt>Dự kiến hết hạn</dt><dd id="openPosExpiryTime">—</dd></div>
                    </dl>
                    <div id="openPosPreviewNotice" class="staffhub-pos-preview-notice" role="status"></div>
                    <p class="staffhub-pos-preview-boundary">
                        Việc mở POS chỉ tạo phiên chịu trách nhiệm POS/két. Hệ thống không tạo lịch làm việc hoặc dữ liệu chấm công.
                    </p>
                    <p class="staffhub-pos-preview-next">
                        Tiền đầu phiên, terminal, lý do và OTP (nếu cần) sẽ được nhập và xác nhận tại POS.
                    </p>
                </div>
                <footer class="staffhub-pos-dialog-actions">
                    <button id="cancelOpenPosPreview" type="button" class="staffhub-dialog-button is-secondary">Hủy</button>
                    <button id="continueOpenPosPreview" type="button" class="staffhub-dialog-button is-primary">
                        <span>Tiếp tục sang POS</span><i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </button>
                </footer>
            </form>
        </dialog>
    </div>
</div>
