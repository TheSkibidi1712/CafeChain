    <script>
    /* ========================================================
       CAFECHAIN TOAST ENGINE
       Dùng ở bất kỳ đâu:  showToast('Thông báo', 'success')
       type: 'success' | 'error' | 'warning' | 'info'
    ======================================================== */
    (function () {
        const ICONS = {
            success: 'bi bi-check-lg',
            error:   'bi bi-x-lg',
            warning: 'bi bi-exclamation-lg',
            info:    'bi bi-info-lg'
        };
        const TITLES = {
            success: 'Thành công',
            error:   'Có lỗi xảy ra',
            warning: 'Lưu ý',
            info:    'Thông báo'
        };

        window.showToast = function (message, type, title, duration) {
            type     = type     || 'success';
            duration = duration || 4000;
            var container = document.getElementById('cc-toast-container');
            if (!container || !message) return;

            var toastTitle = title || TITLES[type] || TITLES.info;
            var icon       = ICONS[type] || ICONS.info;
            var id         = 'cc-toast-' + Date.now();

            var toast = document.createElement('div');
            toast.className = 'cc-toast cc-' + type;
            toast.id = id;
            toast.innerHTML =
                '<div class="cc-toast-icon"><i class="' + icon + '"></i></div>' +
                '<div class="cc-toast-body">' +
                    '<div class="cc-toast-title">' + toastTitle + '</div>' +
                    '<div class="cc-toast-msg">' + message + '</div>' +
                '</div>' +
                '<button class="cc-toast-close" onclick="window.closeToast(\'' + id + '\')" title="Đóng"><i class="bi bi-x"></i></button>' +
                '<div class="cc-toast-progress" style="animation-duration: ' + duration + 'ms;"></div>';

            container.appendChild(toast);

            // Trigger entrance animation
            requestAnimationFrame(function () {
                requestAnimationFrame(function () {
                    toast.classList.add('cc-show');
                });
            });

            // Auto-dismiss
            toast._ccTimer = setTimeout(function () { window.closeToast(id); }, duration);
        };

        window.closeToast = function (id) {
            var toast = document.getElementById(id);
            if (!toast) return;
            clearTimeout(toast._ccTimer);
            toast.classList.remove('cc-show');
            toast.classList.add('cc-hide');
            setTimeout(function () { if (toast.parentNode) toast.parentNode.removeChild(toast); }, 320);
        };

        // ============================================================
        // CAFECHAIN CONFIRM ENGINE
        // showConfirm(options) — thay thế browser confirm()
        // options: { message, title, icon, okText, cancelText, type, onConfirm, onCancel }
        // type: 'danger' | 'warning' | 'default'
        // VD: showConfirm({ message: 'Xóa không?', type: 'danger', onConfirm: () => doDelete() })
        // ============================================================
        window.showConfirm = function(opts) {
            opts = opts || {};
            var overlay  = document.getElementById('cc-confirm-overlay');
            var box      = document.getElementById('cc-confirm-box');
            var titleEl  = document.getElementById('cc-confirm-title');
            var msgEl    = document.getElementById('cc-confirm-msg');
            var iconEl   = document.getElementById('cc-confirm-icon');
            var iconInner = document.getElementById('cc-confirm-icon-inner');
            var okBtn    = document.getElementById('cc-confirm-ok');
            var cancelBtn = document.getElementById('cc-confirm-cancel');
            if (!overlay) return;

            // Thiết lập nội dung
            titleEl.textContent  = opts.title   || 'Xác nhận hành động';
            msgEl.textContent    = opts.message  || 'Bạn có chắc chắn muốn thực hiện thao tác này không?';
            okBtn.textContent    = opts.okText   || 'Xác nhận';
            cancelBtn.textContent = opts.cancelText || 'Hủy bỏ';

            // Thiết lập style theo type
            okBtn.className = 'cc-confirm-btn-ok';
            iconEl.style.background = '#fff3ed';
            iconEl.style.color = '#d35400';

            var iconClass = opts.icon || (opts.type === 'danger' ? 'bi-trash3-fill' : opts.type === 'warning' ? 'bi-exclamation-triangle-fill' : 'bi-question-circle-fill');
            iconInner.className = 'bi ' + iconClass;

            if (opts.type === 'danger') {
                okBtn.classList.add('cc-danger');
                iconEl.style.background = '#fdecea';
                iconEl.style.color = '#c62828';
            } else if (opts.type === 'warning') {
                iconEl.style.background = '#fff8e1';
                iconEl.style.color = '#f57c00';
            }

            // Hiển thị
            overlay.classList.add('cc-confirm-show');
            document.body.style.overflow = 'hidden';

            // Clone buttons để xóa event listeners cũ
            var newOk = okBtn.cloneNode(true);
            var newCancel = cancelBtn.cloneNode(true);
            okBtn.parentNode.replaceChild(newOk, okBtn);
            cancelBtn.parentNode.replaceChild(newCancel, cancelBtn);

            function closeConfirm() {
                overlay.classList.remove('cc-confirm-show');
                document.body.style.overflow = '';
            }

            newOk.addEventListener('click', function() {
                closeConfirm();
                if (typeof opts.onConfirm === 'function') opts.onConfirm();
            });

            newCancel.addEventListener('click', function() {
                closeConfirm();
                if (typeof opts.onCancel === 'function') opts.onCancel();
            });

            // Click backdrop để đóng
            overlay.addEventListener('click', function handler(e) {
                if (e.target === overlay) {
                    closeConfirm();
                    overlay.removeEventListener('click', handler);
                }
            });

            // ESC để đóng
            document.addEventListener('keydown', function escHandler(e) {
                if (e.key === 'Escape') {
                    closeConfirm();
                    document.removeEventListener('keydown', escHandler);
                }
            });
        };

        // Kích hoạt TempData thông báo từ Server-Side
        document.addEventListener('DOMContentLoaded', function () {
            @if (!string.IsNullOrEmpty(tempSuccess))
            {
                <text>showToast('@Html.Raw(tempSuccess?.Replace("'", "\\'")??"" )', 'success');</text>
            }
            @if (!string.IsNullOrEmpty(tempError))
            {
                <text>showToast('@Html.Raw(tempError?.Replace("'", "\\'") ?? "")', 'error', null, 6000);</text>
            }
            @if (!string.IsNullOrEmpty(tempWarning))
            {
                <text>showToast('@Html.Raw(tempWarning?.Replace("'", "\\'") ?? "")', 'warning', null, 5000);</text>
            }
        });
    })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/shared/mutation-guard.js" asp-append-version="true"></script>
</body>
</html>
