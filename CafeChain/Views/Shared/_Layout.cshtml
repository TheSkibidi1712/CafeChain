@using CafeChain.Application.Interfaces
@using CafeChain.Helpers;
@using CafeChain.Application.Constants
@using CafeChain.Application.Constants.Cloudinaries
@inject ICartService CartService
@{
    int cartCount = CartService.GetTotalCount();
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var tempSuccess = TempData["SuccessMessage"]?.ToString();
    var tempError   = TempData["ErrorMessage"]?.ToString();
    var tempWarning = TempData["WarningMessage"]?.ToString();
    var isAdminArea = ViewContext.RouteData.Values["area"]?.ToString() == "Admin";
    var defaultAvatarUrl = User.FindFirst("StaffId") != null
        ? DefaultImages.StaffAvatarUrl
        : DefaultImages.CustomerAvatarUrl;

}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CafeChain</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* ============= CAFECHAIN TOAST SYSTEM ============= */
        .no-underline{
            text-decoration: none;
        }
        #cc-toast-container {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 99999;
            display: flex;
            flex-direction: column;
            gap: 12px;
            pointer-events: none;
        }
        .cc-toast {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            min-width: 320px;
            max-width: 420px;
            padding: 16px 18px;
            border-radius: 14px;
            background: #fff;
            box-shadow: 0 8px 32px rgba(0,0,0,0.13), 0 2px 8px rgba(0,0,0,0.07);
            pointer-events: all;
            opacity: 0;
            transform: translateY(20px) scale(0.97);
            transition: opacity 0.28s cubic-bezier(.4,0,.2,1), transform 0.28s cubic-bezier(.4,0,.2,1);
            border-left: 4px solid #d35400;
            position: relative;
            overflow: hidden;
        }
        .cc-toast.cc-show {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
        .cc-toast.cc-hide {
            opacity: 0;
            transform: translateY(12px) scale(0.96);
        }
        .cc-toast.cc-success { border-left-color: #28a745; }
        .cc-toast.cc-error   { border-left-color: #dc3545; }
        .cc-toast.cc-warning { border-left-color: #fd7e14; }
        .cc-toast.cc-info    { border-left-color: #0d6efd; }

        .cc-toast-icon {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 1.1rem;
        }
        .cc-success .cc-toast-icon { background: #d4edda; color: #28a745; }
        .cc-error   .cc-toast-icon { background: #f8d7da; color: #dc3545; }
        .cc-warning .cc-toast-icon { background: #fff3cd; color: #fd7e14; }
        .cc-info    .cc-toast-icon { background: #cce5ff; color: #0d6efd; }

        .cc-toast-body { flex: 1; min-width: 0; }
        .cc-toast-title {
            font-weight: 700;
            font-size: 0.88rem;
            color: #1a1a1a;
            margin-bottom: 3px;
            letter-spacing: 0.01em;
        }
        .cc-toast-msg {
            font-size: 0.84rem;
            color: #4a4a4a;
            line-height: 1.45;
            word-break: break-word;
        }
        .cc-toast-close {
            background: none;
            border: none;
            color: #aaa;
            cursor: pointer;
            font-size: 1rem;
            padding: 0;
            margin-left: 4px;
            flex-shrink: 0;
            transition: color 0.2s;
            align-self: flex-start;
        }
        .cc-toast-close:hover { color: #333; }
        .cc-toast-progress {
            position: absolute;
            bottom: 0;
            left: 0;
            height: 3px;
            border-radius: 0;
            opacity: 0.3;
            animation: ccToastProgress linear forwards;
        }
        .cc-success .cc-toast-progress { background: #28a745; }
        .cc-error   .cc-toast-progress { background: #dc3545; }
        .cc-warning .cc-toast-progress { background: #fd7e14; }
        .cc-info    .cc-toast-progress { background: #0d6efd; }

        @@keyframes ccToastProgress {
            from { width: 100%; }
            to   { width: 0%; }
        }

        /* ============= CAFECHAIN CONFIRM MODAL ============= */
        #cc-confirm-overlay {
            position: fixed;
            inset: 0;
            z-index: 100000;
            background: rgba(15, 15, 25, 0.55);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.22s ease;
            pointer-events: none;
        }
        #cc-confirm-overlay.cc-confirm-show {
            opacity: 1;
            pointer-events: all;
        }
        #cc-confirm-box {
            background: #fff;
            border-radius: 20px;
            padding: 36px 32px 28px;
            max-width: 380px;
            width: 90%;
            box-shadow: 0 20px 60px rgba(0,0,0,0.18), 0 4px 16px rgba(0,0,0,0.08);
            text-align: center;
            transform: translateY(-24px) scale(0.96);
            transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.22s ease;
            opacity: 0;
        }
        #cc-confirm-overlay.cc-confirm-show #cc-confirm-box {
            transform: translateY(0) scale(1);
            opacity: 1;
        }
        .cc-confirm-icon-wrap {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: #fff3ed;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            font-size: 1.8rem;
            color: #d35400;
        }
        .cc-confirm-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 8px;
        }
        .cc-confirm-msg {
            font-size: 0.88rem;
            color: #666;
            line-height: 1.55;
            margin-bottom: 28px;
        }
        .cc-confirm-actions {
            display: flex;
            gap: 10px;
        }
        .cc-confirm-btn-cancel {
            flex: 1;
            padding: 11px 0;
            border-radius: 12px;
            border: 2px solid #e8e8e8;
            background: #f8f8f8;
            color: #555;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.18s;
        }
        .cc-confirm-btn-cancel:hover {
            background: #efefef;
            border-color: #d0d0d0;
        }
        .cc-confirm-btn-ok {
            flex: 1;
            padding: 11px 0;
            border-radius: 12px;
            border: none;
            background: linear-gradient(135deg, #e8590c, #d35400);
            color: #fff;
            font-weight: 700;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.18s;
            box-shadow: 0 4px 14px rgba(211, 84, 0, 0.35);
        }
        .cc-confirm-btn-ok:hover {
            background: linear-gradient(135deg, #d35400, #b84800);
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(211, 84, 0, 0.45);
        }
        .cc-confirm-btn-ok.cc-danger {
            background: linear-gradient(135deg, #e53935, #c62828);
            box-shadow: 0 4px 14px rgba(198, 40, 40, 0.35);
        }
        .cc-confirm-btn-ok.cc-danger:hover {
            background: linear-gradient(135deg, #c62828, #b71c1c);
            box-shadow: 0 6px 18px rgba(198, 40, 40, 0.45);
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- ========== TOAST CONTAINER (Global - CafeChain) ========== -->
    <div id="cc-toast-container"></div>

    <!-- ========== CONFIRM MODAL (Global - CafeChain) ========== -->
    <div id="cc-confirm-overlay">
        <div id="cc-confirm-box">
            <div class="cc-confirm-icon-wrap" id="cc-confirm-icon">
                <i class="bi bi-trash3-fill" id="cc-confirm-icon-inner"></i>
            </div>
            <div class="cc-confirm-title" id="cc-confirm-title">Xác nhận hành động</div>
            <div class="cc-confirm-msg" id="cc-confirm-msg">Bạn có chắc chắn muốn thực hiện thao tác này không?</div>
