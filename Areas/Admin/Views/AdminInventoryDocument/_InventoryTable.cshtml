@model List<CafeChain.ViewModels.Admin.InventoryDocuments.InventoryDocumentItemVM>
@using CafeChain.Models.Enums.Inventory

<table class="table">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Kho</th>
            <th>Nhân viên</th>
            @if (Model.Any(x => x.Type != InventoryDocumentType.STOCK_TAKE && x.Type != InventoryDocumentType.WASTE))
            {
                <th>Đối tượng</th>
            }
            <th>Loại</th>
            <th>Trạng thái</th>
            <th>Ngày</th>
            @if (Model.Any(x => x.Type == InventoryDocumentType.IMPORT))
            {
                <th>Tổng tiền</th>
            }
            <th>Ghi chú</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr onclick="openDetail(@item.Id)">
                <td>@item.Code</td>
                <td>@item.StoreName</td>
                <td>@item.StaffName</td>

                @if (item.Type != InventoryDocumentType.STOCK_TAKE && item.Type != InventoryDocumentType.WASTE)
                {
                    <td>
                        @(!string.IsNullOrEmpty(item.PartnerName)
                            ? item.PartnerName
                            : item.SupplierName ?? "")
                    </td>
                }

                <td>
                    <span class="badge
                        @(item.Type == InventoryDocumentType.IMPORT ? "import" :
                                                    item.Type == InventoryDocumentType.EXPORT ? "export" :
                                                    item.Type == InventoryDocumentType.STOCK_TAKE ? "stocktake" :
                                                    "waste")">

                        @(item.Type == InventoryDocumentType.IMPORT ? "Nhập kho" :
                          item.Type == InventoryDocumentType.EXPORT ? "Xuất kho" :
                          item.Type == InventoryDocumentType.STOCK_TAKE ? "Kiểm kê" :
                          "Hủy kho")
                    </span>
                </td>
                <td>
                    <span class="badge-status
                        @(item.Status == InventoryDocumentStatus.DRAFT ? "draft" :
                                    item.Status == InventoryDocumentStatus.CONFIRMED ? "confirmed" :
                                    item.Status == InventoryDocumentStatus.CANCELLED ? "cancelled" :
                                    "")">

                        @(item.Status == InventoryDocumentStatus.DRAFT ? "Nháp" :
                          item.Status == InventoryDocumentStatus.CONFIRMED ? "Đã duyệt" :
                          item.Status == InventoryDocumentStatus.CANCELLED ? "Đã hủy" :
                          item.Status.ToString())
                    </span>
                </td>
                <td>@item.Date.ToString("dd/MM/yyyy")</td>

                @if (item.Type == InventoryDocumentType.IMPORT )
                {
                    <td>@item.TotalAmount.ToString("N0")</td>
                }


                <td>@item.Note</td>

                <td>
                    <button class="btn-detail"
                            onclick="event.stopPropagation(); openDetail(@item.Id)">
                        Chi tiết
                    </button>

                    @if (item.Type == InventoryDocumentType.IMPORT && item.Purpose == InventoryDocumentPurpose.IMPORT_INTERNAL && item.Status != InventoryDocumentStatus.CONFIRMED)
                    {
                        <button type="button"
                                class="btn-confirm"
                                onclick="confirmAll(@item.InventoryTransferId)">
                            Confirm nhận hết
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>