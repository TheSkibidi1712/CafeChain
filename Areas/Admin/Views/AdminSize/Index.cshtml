@model IEnumerable<CafeChain.ViewModels.Admin.Sizes.AdminSizeVM>
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<link rel="stylesheet" href="~/css/size.css" />

<div class="container-fluid p-4">

    <!-- Tabs -->
    <div class="d-flex mb-3 border-bottom">
        <a asp-area="Admin"
               asp-controller="AdminSize"
               asp-action="Index"
               class="me-4 pb-2 text-decoration-none fw-semibold
            @(currentController == "AdminSize" ? "text-danger border-bottom border-danger" : "text-muted")">
            Quản lý Size
        </a>

        <a asp-area="Admin"
               asp-controller="AdminTopping"
               asp-action="Index"
               class="pb-2 text-decoration-none fw-semibold
            @(currentController == "AdminTopping" ? "text-danger border-bottom border-danger" : "text-muted")">
            Quản lý Topping
        </a>
    </div>
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- Card -->
    <div class="main-card shadow-sm p-3">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">Danh sách Size</h5>

            <button class="btn btn-orange px-3"
                    data-bs-toggle="modal"
                    data-bs-target="#createModal">
                <i class="fas fa-plus me-2"></i> Thêm mới
            </button>
        </div>

        <!-- Table -->
        <table class="table table-borderless">
            <thead class="text-muted">
                <tr>
                    <th>TÊN SIZE</th>
                    <th>MÔ TẢ</th>
                    <th>TRẠNG THÁI</th>
                    <th class="text-end">HÀNH ĐỘNG</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="border-top">
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="size-badge me-3">
                                    @item.Name
                                </div>
                            </div>
                        </td>

                        <td>@item.Description</td>

                        <td>
                            @if (item.Active)
                            {
                                <span class="status-active">Hoạt động</span>
                            }
                            else
                            {
                                <span class="status-inactive">Ngừng</span>
                            }
                        </td>

                        <td class="text-end">
                            <!-- ASSIGN DRINK-->
                            <button class="btn btn-sm btn-warning me-2"
                                    onclick="openDrinkModal(@item.SizeId, '@item.Name')">
                                <i class="fas fa-link"></i>
                            </button>

                            <!-- EDIT -->
                            <button class="btn btn-sm btn-light me-2"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editModal"
                                    onclick="openDrinkModal(@item.SizeId, '@item.Name.Replace("'", "\\'")')">
                                <i class="fas fa-pen text-primary"></i>
                            </button>

                            <!-- TOGGLE -->
                            <form asp-action="ToggleStatus"
                                  asp-route-id="@item.SizeId"
                                  method="post"
                                  class="d-inline">
                                <button type="submit"
                                        class="btn btn-sm btn-light"
                                        onclick="return confirm('Đổi trạng thái size?')">
                                    <i class="fas @(item.Active ? "fa-lock text-danger" : "fa-unlock text-success")"></i>
                                </button>
                            </form>

                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>

<!-- ================= CREATE MODAL ================= -->
<div class="modal fade" id="createModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-3">

            <!-- Header -->
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-start gap-2">
                    <div class="p-2 rounded-3" style="background:#FBE9E7;">
                        <i class="fas fa-box text-danger"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Thêm mới Size đồ uống</h6>
                        <small class="text-muted text-uppercase" style="font-size:11px;">
                            Cấu hình thực đơn
                        </small>
                    </div>
                </div>

                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Form -->
            <form asp-action="Create" method="post">
                <div class="modal-body">

                    <div class="row g-3">
                        <!-- Tên Size -->
                        <div class="col-4">
                            <label class="form-label fw-semibold">
                                Tên Size <span class="text-danger">*</span>
                            </label>
                            <input name="Name"
                                   class="form-control bg-light text-center"
                                   placeholder="M"
                                   required />
                        </div>
                        <!-- Mô Tả Size -->
                        <div class="col-8">
                            <label class="form-label fw-semibold">
                                Mô Tả Size <span class="text-danger">*</span>
                            </label>
                            <input name="Description"
                                   class="form-control bg-light"
                                   placeholder="Ví dụ: Size Vừa"
                                   required />
                        </div>

                    </div>

                    <p class="text-muted small mt-3 mb-0">
                        Sử dụng mã ngắn (S, M, L) để hiển thị nhanh trên hóa đơn.
                    </p>

                </div>

                <!-- Footer -->
                <div class="modal-footer border-0 pt-2">
                    <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal">
                        Hủy bỏ
                    </button>

                    <button type="submit" class="btn btn-orange px-4">
                        <i class="fas fa-save me-2"></i> Lưu thông tin
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>
<!-- ================= EDIT MODAL ================= -->
<div class="modal fade" id="editModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-3">

            <!-- Header -->
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-start gap-2">
                    <div class="p-2 rounded-3" style="background:#E3F2FD;">
                        <i class="fas fa-pen text-primary"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Chỉnh sửa Size</h6>
                        <small class="text-muted text-uppercase" style="font-size:11px;">
                            Cập nhật thông tin
                        </small>
                    </div>
                </div>

                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Form -->
            <form asp-action="Edit" method="post">
                <input type="hidden" id="edit-id" name="SizeId" />

                <div class="modal-body">

                    <div class="row g-3">

                        <!-- Tên -->
                        <div class="col-4">
                            <label class="form-label fw-semibold">
                                Tên Size <span class="text-danger">*</span>
                            </label>
                            <input id="edit-name"
                                   name="Name"
                                   class="form-control bg-light text-center"
                                   required />
                        </div>

                        <!-- Mô tả -->
                        <div class="col-8">
                            <label class="form-label fw-semibold">
                                Mô Tả Size <span class="text-danger">*</span>
                            </label>
                            <input id="edit-description"
                                   name="Description"
                                   class="form-control bg-light"
                                   required />
                        </div>

                    </div>

                </div>

                <!-- Footer -->
                <div class="modal-footer border-0 pt-2">
                    <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal">
                        Hủy bỏ
                    </button>

                    <button type="submit" class="btn btn-orange px-4">
                        <i class="fas fa-check me-2"></i> Cập nhật
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<!-- ================= DRINK MODAL ================= -->
<div class="modal fade" id="drinkModal">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content p-3">

            <!-- HEADER -->
            <div class="modal-header border-0">
                <h5 class="fw-bold mb-0" id="drinkModalTitle"></h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body">
                <div class="row">

                    <!-- UNASSIGNED -->
                    <div class="mb-3">
                        <span class="badge bg-danger fs-6" id="currentSizeBadge"></span>
                    </div>
                    <div class="col-6">
                        <h6 class="fw-bold text-muted mb-3">Chưa gán</h6>
                        <div id="unassignedList" class="row g-2"></div>
                    </div>

                    <!-- ASSIGNED -->
                    <div class="col-6">
                        <h6 class="fw-bold text-muted mb-3">Đã gán</h6>
                        <div id="assignedList" class="row g-2"></div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>


<div class="modal fade" id="priceModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-3">

            <div class="modal-header border-0">
                <h6 class="fw-bold">Nhập giá</h6>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="number" id="priceInput" class="form-control" placeholder="Nhập giá..." />
            </div>

            <div class="modal-footer border-0">
                <button class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-orange" onclick="confirmAssign()">Xác nhận</button>
            </div>

        </div>
    </div>
</div>

<!-- TOAST-->
<div class="toast position-fixed bottom-0 end-0 p-3" id="liveToast" data-bs-delay="2000">
    <div class="toast-body bg-success text-white rounded">
        Thành công!
    </div>
</div>
<script>
    let currentSizeId = 0;
    let currentSizeName = ""; // 🔥 thêm dòng này
    let selectedDrinkId = 0;
    let drinkModalInstance = null;
    let priceModalInstance = null;

    // =========================
    // TOAST
    // =========================
    function showToast(msg) {
        let toastEl = document.getElementById('liveToast');
        toastEl.querySelector('.toast-body').innerText = msg;
        new bootstrap.Toast(toastEl).show();
    }

    // =========================
    // OPEN DRINK MODAL
    // =========================
    function openDrinkModal(sizeId) {
        currentSizeId = sizeId;

        // 🔥 set title tại đây
        document.getElementById("drinkModalTitle").innerText =
        `Quản lý Drink - Size ${sizeName}`;

        fetch(`/Admin/AdminSize/GetDrinks?sizeId=${sizeId}`)
            .then(res => res.json())
            .then(data => renderDrinkUI(data));
    }

    // =========================
    // RENDER UI (QUAN TRỌNG)
    // =========================
    function renderDrinkUI(data) {

        let assignedHtml = "";
        let unassignedHtml = "";

        data.forEach(d => {

            let image = d.imageUrl ?? "/images/no-image.png";

            let card = `
            <div class="col-6">
                <div class="drink-card p-2">
                    <img src="${image}" class="drink-img mb-2"/>
                    <h6 class="mb-1">${d.name}</h6>
                    <small class="text-muted">${d.categoryName ?? ""} - ${d.productTypeName ?? ""}</small>
            `;

            // ===== ĐÃ GÁN =====
            if (d.isAssigned) {
                assignedHtml += card + `
                    <div class="mt-2">

                        <input type="number"
                               id="price-${d.drinkSizeId}"
                               value="${d.price ?? 0}"
                               class="form-control form-control-sm mb-2"
                               disabled />

                        <button class="btn btn-sm btn-primary w-100 mb-1"
                                id="btn-edit-${d.drinkSizeId}"
                                onclick="toggleEdit(${d.drinkSizeId})">
                            Chỉnh sửa
                        </button>

                        <button class="btn btn-sm btn-outline-danger w-100"
                                onclick="toggleDrinkSize(${d.drinkSizeId})">
                            ${d.active ? "Tắt" : "Bật"}
                        </button>

                    </div>
                </div>
            </div>`;
            }

            // ===== CHƯA GÁN =====
            else {
                unassignedHtml += card + `
                    <button class="btn btn-sm btn-orange w-100 mt-2"
                            onclick="openPriceModal(${d.drinkId})">
                        Gán
                    </button>
                </div>
            </div>`;
            }
        });

        document.getElementById("assignedList").innerHTML = assignedHtml;
        document.getElementById("unassignedList").innerHTML = unassignedHtml;

        // chỉ tạo modal 1 lần
        if (!drinkModalInstance) {
            drinkModalInstance = new bootstrap.Modal(document.getElementById('drinkModal'));
        }

        drinkModalInstance.show();
    }

    // =========================
    // OPEN PRICE MODAL
    // =========================
    function openDrinkModal(sizeId, sizeName) {
        currentSizeId = sizeId;
        currentSizeName = sizeName;

        document.getElementById("drinkModalTitle").innerText =
            `Quản lý Drink - Size ${sizeName}`;

        document.getElementById("currentSizeBadge").innerText =
            `Size: ${sizeName}`;

        fetch(`/Admin/AdminSize/GetDrinks?sizeId=${sizeId}`)
            .then(res => res.json())
            .then(data => renderDrinkUI(data));
    }

    // =========================
    // CONFIRM ASSIGN
    // =========================
    function confirmAssign() {
        let price = document.getElementById("priceInput").value;

        if (!price || price <= 0) {
            alert("Giá không hợp lệ");
            return;
        }

        fetch('/Admin/AdminSize/AssignDrink', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                drinkId: selectedDrinkId,
                sizeId: currentSizeId,
                price: price
            })
        })
        .then(res => {
            if (!res.ok) throw new Error();
            return res.text();
        })
        .then(() => {
            priceModalInstance.hide();
            showToast("Gán thành công");

            // reload data KHÔNG reopen modal
            return fetch(`/Admin/AdminSize/GetDrinks?sizeId=${currentSizeId}`);
        })
        .then(res => res.json())
        .then(data => renderDrinkUI(data))
        .catch(() => alert("Lỗi khi gán"));
    }

    // =========================
    // EDIT PRICE INLINE
    // =========================
    function toggleEdit(drinkSizeId) {
        let input = document.getElementById(`price-${drinkSizeId}`);
        let btn = document.getElementById(`btn-edit-${drinkSizeId}`);

        if (input.disabled) {
            input.disabled = false;
            input.focus();
            btn.innerText = "Lưu";
            btn.classList.replace("btn-primary", "btn-success");
        } else {
            let price = input.value;

            if (!price || price <= 0) {
                alert("Giá không hợp lệ");
                return;
            }

            fetch(`/Admin/AdminSize/UpdatePrice?drinkSizeId=${drinkSizeId}&price=${price}`, {
                method: 'POST'
            })
            .then(() => {
                input.disabled = true;
                btn.innerText = "Chỉnh sửa";
                btn.classList.replace("btn-success", "btn-primary");

                showToast("Cập nhật thành công");
            });
        }
    }

    // =========================
    // TOGGLE ACTIVE
    // =========================
    function toggleDrinkSize(id) {
        fetch(`/Admin/AdminSize/ToggleDrinkSize?id=${id}`, {
            method: 'POST'
        })
        .then(() => {
            showToast("Cập nhật trạng thái");

            return fetch(`/Admin/AdminSize/GetDrinks?sizeId=${currentSizeId}`);
        })
        .then(res => res.json())
        .then(data => renderDrinkUI(data));
    }

    // =========================
    // EDIT SIZE
    // =========================
    function openEditModal(id, name, description) {
        document.getElementById('edit-id').value = id;
        document.getElementById('edit-name').value = name;
        document.getElementById('edit-description').value = description;
    }
</script>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}