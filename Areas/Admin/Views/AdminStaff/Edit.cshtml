@model CafeChain.ViewModels.Admin.Staffs.StaffEditVM
@{
    ViewData["Title"] = "Chỉnh sửa nhân viên";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var roles = ViewBag.Roles as List<CafeChain.Models.Staffs.Role>;
    var stores = ViewBag.Stores as List<CafeChain.Models.Stores.Store>;
    var scopeTypes = ViewBag.ScopeTypes as List<CafeChain.Models.Staffs.ScopeType>;
    bool isStoreManager = ViewBag.IsStoreManager ?? false;
    int currentStoreId = ViewBag.CurrentStoreId ?? 0;
    string currentStoreName = ViewBag.CurrentStoreName ?? "";
}

<link rel="stylesheet" href="~/css/staff.css" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<style>
    .staff-modal .form-label { font-weight: 600; font-size: 11px; text-transform: uppercase; color: #868e96; margin-bottom: 5px; }
    .staff-modal .form-control, .staff-modal .form-select { border-radius: 6px; border: 1px solid #ced4da; font-size: 14px; padding: 10px 12px; }
    .staff-modal .form-control:focus, .staff-modal .form-select:focus { border-color: #d93d20; box-shadow: 0 0 0 0.2rem rgba(217, 61, 32, 0.25); }
    .staff-modal .btn-submit { background-color: #d93d20; color: white; border: none; padding: 10px 24px; border-radius: 6px; font-weight: 600; }
    .staff-modal .btn-submit:hover { background-color: #b52f16; }
    .avatar-upload-box { 
        border: 2px dashed #ced4da; border-radius: 8px; aspect-ratio: 1/1; width: 100%; max-height: 250px;
        display: flex; flex-direction: column; align-items: center; justify-content: center; background-color: #f8f9fa; 
        cursor: pointer; transition: all 0.3s; text-align: center; padding: 20px; overflow: hidden;
    }
    .avatar-upload-box:hover { border-color: #d93d20; background-color: #fffaf9; }
    .avatar-upload-box i { font-size: 40px; color: #adb5bd; margin-bottom: 10px; }
    .avatar-upload-box span { font-size: 13px; color: #6c757d; }
    .avatar-upload-box img { width: 100%; height: 100%; object-fit: cover; border-radius: 6px; }
    .section-title { font-size: 14px; font-weight: 700; color: #495057; text-transform: uppercase; margin-top: 15px; margin-bottom: 15px; border-bottom: 2px solid #e9ecef; padding-bottom: 5px; }
	.btn-reset-pass { background-color:#eff2f5; color:#495057; border:1px solid #ced4da; font-size:12px; font-weight:600; padding:6px 12px; border-radius:6px; transition:0.3s; }
	.btn-reset-pass:hover { background-color:#e2e6ea; }
</style>

<div class="staff-page-header">
    <div>
        <h2>Chỉnh sửa nhân viên</h2>
        <p>Cập nhật thông tin nhân viên <strong>@Model.FullName</strong></p>
    </div>
    <a href="@Url.Action("Index", "AdminStaff", new { area = "Admin" })" class="btn btn-outline-secondary" style="border-radius: 10px; font-weight: 500;">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>
</div>

<div class="staff-table-wrap staff-modal" style="padding: 28px;">
    <form asp-action="Edit" asp-route-id="@Model.StaffId" method="post" enctype="multipart/form-data" id="editStaffForm">
        <input type="hidden" asp-for="StaffId" />
        <input type="hidden" asp-for="AccountId" />
        <input type="hidden" asp-for="Active" />
        <input type="hidden" asp-for="CurrentAvatarUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <!-- CỘT TRÁI: AVATAR -->
            <div class="col-md-3 mb-4">
                <label class="form-label">Ảnh đại diện</label>
                <div class="avatar-upload-box" onclick="document.getElementById('editAvatarInput').click()">
                    @if (string.IsNullOrEmpty(Model.CurrentAvatarUrl)) {
                        <i class="fas fa-cloud-upload-alt placeholder-icon"></i>
                        <span class="placeholder-text">Click để tải ảnh mới</span>
                        <img id="editAvatarPreview" src="" style="display:none;" />
                    } else {
                        <i class="fas fa-cloud-upload-alt placeholder-icon" style="display:none;"></i>
                        <span class="placeholder-text" style="display:none;">Click để tải ảnh mới</span>
                        <img id="editAvatarPreview" src="@Model.CurrentAvatarUrl" />
                    }
                </div>
                <input type="file" name="AvatarFile" id="editAvatarInput" class="d-none" accept="image/*" onchange="previewAvatarEdit(this)" />
                
                <!-- BẮT BUỘC: Xử lý phần UX Cấp lại mật khẩu -->
                <div class="mt-4 text-center">
                    <label class="form-label d-block text-muted">Bảo mật tài khoản</label>
                    <button type="button" class="btn-reset-pass w-100" onclick="$('#changePasswordModal').modal('show')">
                        <i class="fas fa-key me-1"></i> Đổi mật khẩu thủ công
                    </button>
                </div>
            </div>

            <!-- CỘT PHẢI: CHI TIẾT -->
            <div class="col-md-9">
                <div class="row">
                    <!-- Nhóm Định danh -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-danger">Vai trò hệ thống *</label>
                        <select asp-for="SelectedRoleId" class="form-select" id="editDynamicRoleSelect">
                            <option value="">-- Chọn vai trò --</option>
                            @if(roles != null) { foreach(var r in roles) { <option value="@r.RoleId">@r.Name</option> } }
                        </select>
                        <span asp-validation-for="SelectedRoleId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Họ và tên <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Email đăng nhập <span class="text-danger">*</span></label>
                        <input asp-for="Email" class="form-control" readonly style="background-color: #e9ecef; cursor: not-allowed;" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Căn cước công dân</label>
                        <input asp-for="CCCD" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Giới tính</label>
                        <select asp-for="Gender" class="form-select">
                            <option value="0">Nữ</option>
                            <option value="1">Nam</option>
                            <option value="2">Khác</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Ngày sinh</label>
                        <input type="text" asp-for="DateOfBirth" class="form-control flatpickr-date" placeholder="dd/mm/yyyy" value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Ngày bắt đầu làm việc</label>
                        <input type="text" asp-for="StartDate" class="form-control flatpickr-date" placeholder="dd/mm/yyyy" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Trạng thái làm việc</label>
                        <select asp-for="EmployeeStatus" class="form-select">
                            <option value="1">Thử việc</option>
                            <option value="2">Chính thức</option>
                        </select>
                    </div>

                    <div class="col-12"><div class="section-title">Nhóm Phân quyền</div></div>

                    @if (isStoreManager)
                    {
                        <div class="col-md-4 mb-3">
                            <label class="form-label text-danger">Theo quyền Store Manager</label>
                            <input type="text" class="form-control" value="@currentStoreName" disabled />
                            <input type="hidden" name="StoreId" value="@currentStoreId" />
                            <input type="hidden" name="ScopeTypeId" value="4" />
                            <input type="hidden" name="ScopeRefId" value="@currentStoreId" />
                        </div>
                    }
                    else 
                    {
                        <div class="col-md-4 mb-3">
                            <label class="form-label text-danger">Loại phạm vi *</label>
                            <select asp-for="ScopeTypeId" class="form-select" id="editDynamicScopeTypeSelect">
                                <option value="">-- Xin vui lòng chọn --</option>
                                @if(scopeTypes != null) { foreach(var st in scopeTypes) { <option value="@st.ScopeTypeId">@st.Name</option> } }
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label" id="editLblScopeRefId">Mã tham chiếu</label>
                            <input type="hidden" name="ScopeRefId" id="editHiddenScopeRefId" value="@Model.ScopeRefId" />
                            <button type="button" id="editBtnLocationPicker" class="form-select text-start" style="width: 100%;">
                                -- Đang tải dữ liệu... --
                            </button>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Cửa Hàng Đồng Bộ</label>
                            <select asp-for="StoreId" class="form-select" id="editDynamicStoreSelect">
                                <option value="">-- Tự động --</option>
                                @if(stores != null) { foreach(var s in stores) { <option value="@s.StoreId">@s.Name</option> } }
                            </select>
                        </div>
                    }

                    <div class="col-12"><div class="section-title">Nhóm Lương & Thuế</div></div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Hình thức trả lương</label>
                        <select asp-for="SalaryType" class="form-select" id="SalaryTypeSelect">
                            <option value="1">Lương Cố định</option>
                            <option value="2">Lương Theo giờ</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label" id="lblBaseSalary">Lương gốc (VNĐ)</label>
                        <input asp-for="BaseSalary" type="number" class="form-control" step="1000" title="@(isStoreManager ? "Không thể sửa đổi" : "")" />
                        @if (isStoreManager) { <input type="hidden" name="BaseSalary" value="@Model.BaseSalary" /> }
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Phụ cấp (VNĐ)</label>
                        <input asp-for="Allowance" type="number" class="form-control" step="1000" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Hệ số Lương Thử việc</label>
                        <input asp-for="ProbationRate" id="ProbationRateInput" type="number" class="form-control" step="0.01" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Hệ số Nhân lương OT</label>
                        <input asp-for="OvertimeRate" type="number" class="form-control" step="0.1" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Sổ BHXH</label>
                        <input asp-for="SocialInsuranceNumber" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Người phụ thuộc (SL)</label>
                        <input asp-for="DependentCount" type="number" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Mã số thuế cá nhân</label>
                        <input asp-for="TaxCode" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Mã số thuế người phụ thuộc</label>
                        <input asp-for="DependentTaxCode" class="form-control" />
                    </div>
                </div>
            </div>

            <!-- HÀNG LIÊN HỆ DƯỚI CÙNG -->
            <div class="col-12"><div class="section-title mt-2">Thông tin Liên hệ</div></div>
            
            <div class="col-md-6 mb-3">
                <label class="form-label">Số điện thoại liên lạc</label>
                <div id="editPhonesContainer">
                    @if(Model.Phones != null && Model.Phones.Any()) {
                        @foreach(var phone in Model.Phones) {
                            <div class="dynamic-input-group d-flex mb-2">
                                <input name="Phones" class="form-control me-2" value="@phone" />
                                <button type="button" class="btn btn-sm btn-danger" onclick="this.parentElement.remove()"><i class="fas fa-trash"></i></button>
                            </div>
                        }
                    }
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary fw-bold text-primary border-primary mt-1" onclick="addDynamicInput('editPhonesContainer', 'Phones', 3, 'Nhập SĐT')"><i class="fas fa-plus"></i> Thêm SĐT</button>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Địa chỉ liên hệ</label>
                <div id="editAddressesContainer">
                    @if(Model.Addresses != null && Model.Addresses.Any()) {
                        @foreach(var address in Model.Addresses) {
                            <div class="dynamic-input-group d-flex mb-2">
                                <input name="Addresses" class="form-control me-2" value="@address" />
                                <button type="button" class="btn btn-sm btn-danger" onclick="this.parentElement.remove()"><i class="fas fa-trash"></i></button>
                            </div>
                        }
                    }
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary fw-bold text-primary border-primary mt-1" onclick="addDynamicInput('editAddressesContainer', 'Addresses', 3, 'Nhập Địa chỉ')"><i class="fas fa-plus"></i> Thêm Địa chỉ</button>
            </div>
        
            <!-- NGÂN HÀNG TRÊN 1 DÒNG COL-12 CHIA 3 -->
            <div class="col-md-4 mb-3">
                <label class="form-label">Tên Ngân Hàng</label>
                <input asp-for="BankName" class="form-control" placeholder="Tên NH (VD: MBBank)" />
                <span asp-validation-for="BankName" class="text-danger small"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Số Tài Khoản</label>
                <input asp-for="AccountNumber" class="form-control" placeholder="Số TK" />
                <span asp-validation-for="AccountNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Tên Chủ Tài Khoản</label>
                <input asp-for="AccountHolderName" class="form-control" placeholder="Viết Hoa Không Dấu" style="text-transform:uppercase"/>
                <span asp-validation-for="AccountHolderName" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-3 mt-3 pt-3 border-top">
            <a href="@Url.Action("Index", "AdminStaff", new { area = "Admin" })" class="btn btn-light border px-4">Hủy</a>
            <button type="submit" class="btn-submit px-5">Lưu Thay Đổi</button>
        </div>
    </form>
</div>

<!-- THE MODAL ĐỔI MẬT KHẨU -->
<div class="modal fade staff-modal" id="changePasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title font-weight-bold" style="color: white;"><i class="fas fa-lock"></i> Thay đổi Mật Khẩu</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="resetAccountId" value="@Model.AccountId" />
                <div class="mb-3">
                    <label class="form-label font-weight-bold">Mật khẩu mới</label>
                    <input type="password" id="newPassValue" class="form-control" placeholder="Nhập mật khẩu mới..." />
                </div>
                <div class="mb-4">
                    <label class="form-label font-weight-bold">Xác nhận mật khẩu</label>
                    <input type="password" id="confirmPassValue" class="form-control" placeholder="Nhập lại mật khẩu..." />
                </div>
                <button type="button" class="btn btn-danger w-100 fw-bold" onclick="executeManualResetPass()" style="padding: 10px; border-radius: 6px;">CẬP NHẬT MẬT KHẨU</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/vn.js"></script>
    <script>
        function previewAvatarEdit(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    var box = input.previousElementSibling;
                    var icon = box.querySelector('.placeholder-icon');
                    var text = box.querySelector('.placeholder-text');
                    var img = box.querySelector('img');
                    if(icon) icon.style.display = 'none';
                    if(text) text.style.display = 'none';
                    img.src = e.target.result;
                    img.style.display = 'block';
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function addDynamicInput(containerId, fieldName, maxCount, placeholder) {
            const container = document.getElementById(containerId);
            if (container.children.length >= maxCount) return alert('Tối đa ' + maxCount + ' dòng');
            const div = document.createElement('div');
            div.className = 'dynamic-input-group d-flex mb-2';
            div.innerHTML = `<input name="${fieldName}" class="form-control me-2" placeholder="${placeholder}" />
                             <button type="button" class="btn btn-sm btn-danger" onclick="this.parentElement.remove()"><i class="fas fa-trash"></i></button>`;
            container.appendChild(div);
        }

        // Logic Reset Password (AJAX Fake Gọi API)
        function executeManualResetPass() {
            var accId = document.getElementById('resetAccountId').value;
            var p1 = document.getElementById('newPassValue').value;
            var p2 = document.getElementById('confirmPassValue').value;

            if(!p1 || p1.length < 6) return Swal.fire('Lỗi', 'Mật khẩu phải từ 6 ký tự!', 'error');
            if(p1 !== p2) return Swal.fire('Lỗi', 'Xác nhận mật khẩu không khớp!', 'warning');

            fetch('/Admin/AdminStaff/ManualResetPassword', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ accountId: accId, newPassword: p1 })
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    $('#changePasswordModal').modal('hide');
                    Swal.fire('Thành công', data.message, 'success');
                    document.getElementById('newPassValue').value = '';
                    document.getElementById('confirmPassValue').value = '';
                } else {
                    Swal.fire('Lỗi', data.message, 'error');
                }
            })
            .catch(err => {
                Swal.fire('Lỗi', 'Đã xảy ra lỗi máy chủ.', 'error');
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            flatpickr(".flatpickr-date", {
                dateFormat: "Y-m-d",
                altInput: true,
                altFormat: "d/m/Y",
                allowInput: true,
                locale: "vn"
            });

            const salaryTypeSelect = document.getElementById('SalaryTypeSelect');
            const probRateInput = document.getElementById('ProbationRateInput');
            const lblBaseSalary = document.getElementById('lblBaseSalary');
            if (salaryTypeSelect) {
                salaryTypeSelect.addEventListener('change', function() {
                    if(this.value == '2') { // Theo giờ
                        if(probRateInput) { probRateInput.value = 1; probRateInput.setAttribute('disabled', 'true'); }
                        if(lblBaseSalary) lblBaseSalary.innerText = "Mức lương/giờ";
                    } else { // Cố định
                        if(probRateInput) probRateInput.removeAttribute('disabled');
                        if(lblBaseSalary) lblBaseSalary.innerText = "Lương gốc/tháng";
                    }
                });
                salaryTypeSelect.dispatchEvent(new Event('change'));
            }

            const eRoleSel = document.getElementById('editDynamicRoleSelect');
            const eTypeSel = document.getElementById('editDynamicScopeTypeSelect');
            const eHiddenScp = document.getElementById('editHiddenScopeRefId');
            const eBtnPick = document.getElementById('editBtnLocationPicker');
            const eStoreSel = document.getElementById('editDynamicStoreSelect');
            const eLblRefId = document.getElementById('editLblScopeRefId');

            // 🔥 Bảng quy tắc cứng Array-based: RoleId → [ScopeTypeIds]
            const ROLE_SCOPE_MAP = {
                1: [1], 2: [1], 3: [1], 4: [1], 5: [1], 6: [1],  // HQ-level (Country)
                7: [2, 3, 4],                                // Area Manager → Province HOẶC District
                8: [4], 9: [4], 10: [4], 12: [4], 13: [4] // Store-level
            };

            function enforceEditCascadingRole() {
                if (!eRoleSel || !eTypeSel) return;
                const roleId = parseInt(eRoleSel.value) || 0;
                const allowedScopes = ROLE_SCOPE_MAP[roleId] || [];

                // RESET options của "Loại phạm vi"
                Array.from(eTypeSel.options).forEach(opt => {
                    opt.style.display = '';
                    opt.disabled = false;
                });

                if (roleId === 0 || allowedScopes.length === 0) {
                    eTypeSel.value = '';
                    refreshEditScopeMatrix();
                    return;
                }

                // Lọc options "Loại phạm vi" -> chỉ hiển thị scopes hợp lệ
                let firstValid = null;
                Array.from(eTypeSel.options).forEach(opt => {
                    const optVal = parseInt(opt.value);
                    if (opt.value !== "" && !allowedScopes.includes(optVal)) {
                        opt.style.display = 'none';
                        opt.disabled = true;
                    } else if (opt.value !== "" && allowedScopes.includes(optVal)) {
                        if (!firstValid) firstValid = opt.value;
                    }
                });

                const currentSelected = parseInt(eTypeSel.value);
                if (!allowedScopes.includes(currentSelected) && firstValid) {
                    eTypeSel.value = firstValid;
                }
                
                refreshEditScopeMatrix();
            }

            function refreshEditScopeMatrix() {
                if (!eRoleSel || !eTypeSel || !eBtnPick) return;
                
                const scopeTypeId = parseInt(eTypeSel.value) || 0;

                if (scopeTypeId === 1) {
                    eHiddenScp.value = '1';
                    eBtnPick.innerHTML = 'Trụ sở chính (HQ)';
                    eBtnPick.setAttribute('disabled', 'true');
                    if(eLblRefId) eLblRefId.innerText = "Phạm vi: Toàn chuỗi";
                    return;
                }

                eBtnPick.removeAttribute('disabled');

                if (scopeTypeId === 2) {
                    if(eLblRefId) eLblRefId.innerText = 'Tỉnh / Thành Phố quản lý';
                } else if (scopeTypeId === 3) {
                    if(eLblRefId) eLblRefId.innerText = 'Quận / Huyện quản lý';
                } else if (scopeTypeId === 4) {
                    if(eLblRefId) eLblRefId.innerText = 'Cửa Hàng cụ thể';
                } else {
                    if(eLblRefId) eLblRefId.innerText = 'Mã Tham Chiếu';
                }

                // Pre-fetch tên hiển thị cho button nếu có Data ban đầu
                const currVal = parseInt(eHiddenScp.value);
                if (currVal && eBtnPick.innerText.includes('Đang tải')) {
                    if (scopeTypeId === 2) {
                        fetch('https://provinces.open-api.vn/api/p/' + currVal)
                            .then(r=>r.json()).then(d=>{ eBtnPick.innerText = d.name; }).catch(()=>{ eBtnPick.innerText='-- Chọn lại --'; });
                    } else if (scopeTypeId === 3) {
                        fetch('https://provinces.open-api.vn/api/d/' + currVal)
                            .then(r=>r.json()).then(d=>{ eBtnPick.innerText = d.name; }).catch(()=>{ eBtnPick.innerText='-- Chọn lại --'; });
                    } else if (scopeTypeId === 4) {
                        fetch('/Admin/AdminStaff/GetScopeReferences?scopeTypeId=4')
                            .then(r=>r.json()).then(d=>{ 
                                const st = d.find(x => x.id === currVal); 
                                eBtnPick.innerText = st ? st.name : '-- Chọn lại --';
                            });
                    }
                } else if (!currVal) {
                    eBtnPick.innerText = '-- Bấm để chọn địa bàn --';
                }
            }

            // --- SWEETALERT LOCATION PICKER ---
            if (eBtnPick) {
                eBtnPick.addEventListener('click', function() {
                    const scopeTypeId = parseInt(eTypeSel.value) || 0;
                    if (!scopeTypeId) {
                        Swal.fire({ icon: 'warning', title: 'Thiếu thông tin', text: 'Vui lòng chọn Loại Phạm vi trước!' });
                        return;
                    }

                    if (scopeTypeId === 2) { // TỈNH
                        Swal.fire({
                            title: 'Chọn Tỉnh / Thành Phố',
                            html: '<select id="swal-province" class="form-select"><option value="">-- Đang tải dữ liệu... --</option></select>',
                            showCancelButton: true,
                            confirmButtonText: 'Xác nhận',
                            cancelButtonText: 'Hủy',
                            didOpen: () => {
                                Swal.showLoading();
                                fetch('/Admin/AdminStaff/GetScopeReferences?scopeTypeId=2')
                                    .then(res => res.json())
                                    .then(data => {
                                        Swal.hideLoading();
                                        const sel = document.getElementById('swal-province');
                                        sel.innerHTML = '<option value="">-- Chọn Tỉnh --</option>';
                                        data.forEach(p => { sel.innerHTML += `<option value="${p.id}">${p.name}</option>`; });
                                    });
                            },
                            preConfirm: () => {
                                const sel = document.getElementById('swal-province');
                                if (!sel.value) return Swal.showValidationMessage('Vui lòng chọn Tỉnh/Thành!');
                                return { id: sel.value, text: sel.options[sel.selectedIndex].text };
                            }
                        }).then((result) => {
                            if (result.isConfirmed) {
                                eHiddenScp.value = result.value.id;
                                eBtnPick.innerText = result.value.text;
                            }
                        });

                    } else if (scopeTypeId === 3) { // QUẬN HUYỆN
                        Swal.fire({
                            title: 'Chọn Quận / Huyện',
                            html: `
                                <select id="swal-province" class="form-select mb-2"><option value="">-- Đang tải Tỉnh... --</option></select>
                                <select id="swal-district" class="form-select" disabled><option value="">-- Chọn Quận/Huyện --</option></select>
                            `,
                            showCancelButton: true,
                            confirmButtonText: 'Xác nhận',
                            cancelButtonText: 'Hủy',
                            didOpen: () => {
                                Swal.showLoading();
                                const pSel = document.getElementById('swal-province');
                                const dSel = document.getElementById('swal-district');
                                
                                fetch('https://provinces.open-api.vn/api/p')
                                    .then(res => res.json())
                                    .then(data => {
                                        Swal.hideLoading();
                                        pSel.innerHTML = '<option value="">-- Chọn Tỉnh --</option>';
                                        data.forEach(p => { pSel.innerHTML += `<option value="${p.code}">${p.name}</option>`; });
                                    });

                                pSel.addEventListener('change', function() {
                                    if (!this.value) {
                                        dSel.innerHTML = '<option value="">-- Chọn Quận/Huyện --</option>';
                                        dSel.disabled = true; return;
                                    }
                                    dSel.innerHTML = '<option value="">-- Đang nạp danh sách... --</option>';
                                    fetch(`/Admin/AdminStaff/GetScopeReferences?scopeTypeId=3&parentId=${this.value}`)
                                        .then(res => res.json())
                                        .then(data => {
                                            dSel.disabled = false;
                                            dSel.innerHTML = '<option value="">-- Chọn Quận/Huyện --</option>';
                                            data.forEach(d => { dSel.innerHTML += `<option value="${d.id}">${d.name}</option>`; });
                                        });
                                });
                            },
                            preConfirm: () => {
                                const dSel = document.getElementById('swal-district');
                                if (!dSel.value) return Swal.showValidationMessage('Vui lòng chọn Quận/Huyện!');
                                const txt = dSel.options[dSel.selectedIndex].text;
                                const pTxt = document.getElementById('swal-province').options[document.getElementById('swal-province').selectedIndex].text;
                                return { id: dSel.value, text: txt + " (" + pTxt + ")" };
                            }
                        }).then((result) => {
                            if (result.isConfirmed) {
                                eHiddenScp.value = result.value.id;
                                eBtnPick.innerText = result.value.text;
                            }
                        });

                    } else if (scopeTypeId === 4) { // CỬA HÀNG
                        Swal.fire({
                            title: 'Chọn Cửa Hàng',
                            html: '<select id="swal-store" class="form-select"><option value="">-- Đang nạp... --</option></select>',
                            showCancelButton: true,
                            confirmButtonText: 'Xác nhận',
                            cancelButtonText: 'Hủy',
                            didOpen: () => {
                                Swal.showLoading();
                                fetch('/Admin/AdminStaff/GetScopeReferences?scopeTypeId=4')
                                    .then(r => r.json())
                                    .then(data => {
                                        Swal.hideLoading();
                                        const sel = document.getElementById('swal-store');
                                        sel.innerHTML = '<option value="">-- Chọn Cửa Hàng --</option>';
                                        data.forEach(s => { sel.innerHTML += `<option value="${s.id}">${s.name}</option>`; });
                                    });
                            },
                            preConfirm: () => {
                                const sel = document.getElementById('swal-store');
                                if (!sel.value) return Swal.showValidationMessage('Vui lòng chọn Cửa hàng!');
                                return { id: sel.value, text: sel.options[sel.selectedIndex].text };
                            }
                        }).then((result) => {
                            if (result.isConfirmed) {
                                eHiddenScp.value = result.value.id;
                                eBtnPick.innerText = result.value.text;
                                if (eStoreSel) eStoreSel.value = result.value.id;
                            }
                        });
                    }
                });
            }

            // 🔥 FIX: Bind events trực tiếp — không cần guard clause eRefSel
            if (eRoleSel && eTypeSel) {
                eRoleSel.addEventListener('change', enforceEditCascadingRole);
                eTypeSel.addEventListener('change', refreshEditScopeMatrix);
                // Init on page load — pre-fill cascading state từ dữ liệu hiện có
                enforceEditCascadingRole();
            }
        });


        @if (TempData["Error"] != null)
        {
            <text>
            Swal.fire({ title: 'Lỗi!', html: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Error"])), icon: 'error' });
            </text>
        }
        @if (TempData["Success"] != null)
        {
            <text>
            Swal.fire({ title: 'Thành công!', html: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Success"])), icon: 'success', timer: 2000, showConfirmButton: false });
            </text>
        }
    </script>
    <partial name="_ValidationScriptsPartial" />
}

