@model CafeChain.ViewModels.Admin.Staff.StaffIndexPageVM

@{
    ViewData["Title"] = "Quản lý nhân sự";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var roles = ViewBag.Roles as List<CafeChain.Models.Staffs.Role>;
    var stores = ViewBag.Stores as List<CafeChain.Models.Stores.Store>;
    var scopeTypes = ViewBag.ScopeTypes as List<CafeChain.Models.Staffs.ScopeType>;
    bool isStoreManager = ViewBag.IsStoreManager ?? false;
    int currentStoreId = ViewBag.CurrentStoreId ?? 0;
    string currentStoreName = ViewBag.CurrentStoreName ?? "";
}

<link rel="stylesheet" href="~/css/staff.css" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

<!-- ==================== HEADER ==================== -->
<div class="staff-page-header">
    <div>
        <h2>Quản lý nhân sự</h2>
        <p>Quản lý thông tin, vai trò và quyền hạn của đội ngũ nhân viên CafeChain.</p>
    </div>
    <button type="button" class="btn-create-staff" data-bs-toggle="modal" data-bs-target="#createStaffModal">
        <i class="fas fa-plus"></i> Thêm nhân viên mới
    </button>
</div>

<!-- ==================== KPI CARDS ==================== -->
<div class="staff-kpi-row">
    <div class="staff-kpi-card">
        <div class="kpi-icon total"><i class="fas fa-users"></i></div>
        <div class="kpi-info">
            <h4>@Model.TotalStaff</h4>
            <span>Tổng nhân sự</span>
        </div>
    </div>
    <div class="staff-kpi-card">
        <div class="kpi-icon active"><i class="fas fa-user-check"></i></div>
        <div class="kpi-info">
            <h4>@Model.ActiveCount</h4>
            <span>Đang làm việc</span>
        </div>
    </div>
    <div class="staff-kpi-card">
        <div class="kpi-icon inactive"><i class="fas fa-user-lock"></i></div>
        <div class="kpi-info">
            <h4>@Model.InactiveCount</h4>
            <span>Đã khóa</span>
        </div>
    </div>
</div>

<!-- ==================== SEARCH & FILTER ==================== -->
<form asp-action="Index" method="get" class="staff-toolbar">
    <div class="staff-search-box">
        <i class="fas fa-search"></i>
        <input type="text" name="search" value="@Model.SearchTerm" placeholder="Tìm kiếm nhân viên theo tên hoặc email..." />
    </div>
    <select name="roleFilter" class="staff-filter-select" onchange="this.form.submit()">
        <option value="">Tất cả vai trò</option>
        @if (roles != null)
        {
            @foreach (var role in roles)
            {
                <option value="@role.RoleId" selected="@(Model.RoleFilter == role.RoleId)">@role.Name</option>
            }
        }
    </select>
</form>

<!-- ==================== STAFF TABLE ==================== -->
<div class="staff-table-wrap">
    <table class="staff-table">
        <thead>
            <tr>
                <th>Tên nhân viên</th>
                <th>Email</th>
                <th>Vai trò</th>
                <th>Cửa hàng</th>
                <th>Trạng thái</th>
                <th style="text-align:center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.StaffList.Items == null || !Model.StaffList.Items.Any())
            {
                <tr>
                    <td colspan="6" style="text-align:center; padding: 40px; color: #adb5bd;">
                        <i class="fas fa-inbox" style="font-size:32px; margin-bottom:8px; display:block;"></i>
                        Chưa có nhân viên nào.
                    </td>
                </tr>
            }
            @foreach (var item in Model.StaffList.Items)
            {
                <tr>
                    <td>
                        <div class="staff-name-cell">
                            <img src="@item.AvatarUrl" alt="" class="staff-avatar" onerror="this.src='/Images/avatars/avtdf.jpg'" />
                            <span class="name">@item.FullName</span>
                        </div>
                    </td>
                    <td style="color: #495057;">@item.Email</td>
                    <td>
                        @foreach (var roleName in item.RoleNames)
                        {
                            var badgeClass = roleName switch
                            {
                                "Cashier" => "cashier",
                                "Store Manager" => "store-manager",
                                "Ward Manager" => "ward-manager",
                                "Province Manager" => "province-manager",
                                "Admin System" => "admin-system",
                                _ => "cashier"
                            };
                            <span class="role-badge @badgeClass">@roleName</span>
                        }
                    </td>
                    <td style="color: #495057;">@item.StoreName</td>
                    <td>
                        @if (item.Active)
                        {
                            <span class="status-badge active"><span class="dot"></span> Đang làm việc</span>
                        }
                        else
                        {
                            <span class="status-badge inactive"><span class="dot"></span> Đã khóa</span>
                        }
                    </td>
                    <td style="text-align:center">
                        @if (item.CanEdit)
                        {
                            <a href="@Url.Action("Edit", "AdminStaff", new { area = "Admin", id = item.StaffId })" class="action-btn" title="Chỉnh sửa">
                                <i class="fas fa-pen"></i>
                            </a>
                            <button type="button" class="action-btn @(item.Active ? "danger" : "")"
                                    onclick="toggleStaffStatus(@item.StaffId, '@item.FullName', @item.Active.ToString().ToLower())"
                                    title="@(item.Active ? "Khóa tài khoản" : "Mở khóa")">
                                <i class="fas @(item.Active ? "fa-lock" : "fa-unlock")"></i>
                            </button>
                        }
                        else
                        {
                            <span class="text-muted" style="font-size: 13px;"><i class="fas fa-ban"></i> Thuộc thẩm quyền cấp trên</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination -->
    <div class="staff-pagination">
        <span class="info">Hiển thị @Model.StaffList.Items.Count / @Model.StaffList.TotalCount nhân viên</span>
        <div class="page-btns">
            <a asp-action="Index" asp-route-page="@(Model.StaffList.PageIndex - 1)"
               asp-route-search="@Model.SearchTerm" asp-route-roleFilter="@Model.RoleFilter"
               class="page-btn @(!Model.StaffList.HasPreviousPage ? "disabled" : "")">
                <i class="fas fa-chevron-left"></i>
            </a>
            @for (int i = 1; i <= Model.StaffList.TotalPages; i++)
            {
                <a asp-action="Index" asp-route-page="@i"
                   asp-route-search="@Model.SearchTerm" asp-route-roleFilter="@Model.RoleFilter"
                   class="page-btn @(i == Model.StaffList.PageIndex ? "active" : "")">@i</a>
            }
            <a asp-action="Index" asp-route-page="@(Model.StaffList.PageIndex + 1)"
               asp-route-search="@Model.SearchTerm" asp-route-roleFilter="@Model.RoleFilter"
               class="page-btn @(!Model.StaffList.HasNextPage ? "disabled" : "")">
                <i class="fas fa-chevron-right"></i>
            </a>
        </div>
    </div>
</div>

<!-- ==================== MODAL: THÊM NHÂN VIÊN ==================== -->
<div class="modal fade staff-modal" id="createStaffModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm nhân viên mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p style="color: #868e96; font-size: 13px; margin-bottom: 20px;">Điền thông tin chi tiết để cấp quyền truy cập hệ thống.</p>

                <form asp-action="Create" method="post" enctype="multipart/form-data" id="createStaffForm">
                    <div class="row">
                        <!-- Avatar -->
                        <div class="col-md-3">
                            <label class="form-label">Ảnh đại diện</label>
                            <div class="avatar-upload-box" id="avatarUploadBox" onclick="document.getElementById('avatarInput').click()">
                                <img id="avatarPreview" src="" style="display:none" />
                                <i class="fas fa-camera-retro placeholder-icon"></i>
                                <span class="placeholder-text">Kéo thả hoặc nhấp để tải ảnh lên</span>
                            </div>
                            <input type="file" name="AvatarFile" id="avatarInput" accept="image/*" style="display:none" />
                        </div>

                        <!-- Form Fields -->
                        <div class="col-md-9">
                            <div class="row">
                                <!-- Vai trò hệ thống -->
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Vai trò hệ thống <span class="text-danger">*</span></label>
                                    <select name="SelectedRoleIds" class="form-select" id="roleSelect" multiple size="1">
                                        @if (roles != null)
                                        {
                                            @foreach (var role in roles)
                                            {
                                                <option value="@role.RoleId">@role.Name</option>
                                            }
                                        }
                                    </select>
                                </div>

                                <!-- Họ tên -->
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Họ và tên <span class="text-danger">*</span></label>
                                    <input type="text" name="FullName" class="form-control" placeholder="Nhập tên đầy đủ" required />
                                </div>

                                <!-- Email -->
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Email đăng nhập <span class="text-danger">*</span></label>
                                    <input type="email" name="Email" class="form-control" placeholder="email@cafechain.vn" required />
                                </div>

                                <!-- Mật khẩu -->
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Mật khẩu <span class="label-optional">(để trống = tự sinh)</span></label>
                                    <input type="password" name="Password" class="form-control" placeholder="••••••••" />
                                </div>

                                <!-- Mã số thuế -->
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Mã số thuế / CCCD <span class="label-optional">Không bắt buộc</span></label>
                                    <input type="text" name="TaxCode" class="form-control" placeholder="Nhập mã số thuế" />
                                </div>

                                <!-- Mức lương -->
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Mức lương (VNĐ)</label>
                                    <input type="number" name="Salary" class="form-control" placeholder="0" step="1000" />
                                </div>

                                <!-- Cửa hàng / Scope -->
                                @if (isStoreManager)
                                {
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Cửa hàng</label>
                                        <input type="text" class="form-control" value="@currentStoreName" disabled />
                                        <input type="hidden" name="StoreId" value="@currentStoreId" />
                                        <input type="hidden" name="ScopeTypeId" value="4" />
                                        <input type="hidden" name="ScopeRefId" value="@currentStoreId" />
                                    </div>
                                }
                                else
                                {
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Cửa hàng <span class="text-danger">*</span></label>
                                        <select name="StoreId" class="form-select" required>
                                            <option value="">-- Chọn cửa hàng --</option>
                                            @if (stores != null)
                                            {
                                                @foreach (var store in stores)
                                                {
                                                    <option value="@store.StoreId">@store.Name</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                }

                                <!-- Ngày sinh -->
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Ngày sinh</label>
                                    <input type="date" name="DateOfBirth" class="form-control" />
                                </div>

                                @if (!isStoreManager)
                                {
                                    <!-- Scope Type -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Phạm vi quản lý</label>
                                        <select name="ScopeTypeId" class="form-select">
                                            @if (scopeTypes != null)
                                            {
                                                @foreach (var st in scopeTypes)
                                                {
                                                    <option value="@st.ScopeTypeId">@st.Name</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Mã tham chiếu (ScopeRefId)</label>
                                        <input type="number" name="ScopeRefId" class="form-control" value="1" />
                                    </div>
                                }
                            </div>

                            <!-- Phones dynamic -->
                            <div class="mb-3">
                                <label class="form-label">Số điện thoại <span class="label-optional">(tối đa 3)</span></label>
                                <div id="phonesContainer">
                                    <div class="dynamic-input-group">
                                        <input type="text" name="Phones" class="form-control" placeholder="Số điện thoại chính" maxlength="15" />
                                    </div>
                                </div>
                                <button type="button" class="btn-add-input" onclick="addDynamicInput('phonesContainer', 'Phones', 3, 'Thêm số điện thoại')">
                                    <i class="fas fa-plus"></i> Thêm số điện thoại
                                </button>
                            </div>

                            <!-- Addresses dynamic -->
                            <div class="mb-3">
                                <label class="form-label">Địa chỉ <span class="label-optional">(tối đa 3)</span></label>
                                <div id="addressesContainer">
                                    <div class="dynamic-input-group">
                                        <input type="text" name="Addresses" class="form-control" placeholder="Địa chỉ chính" maxlength="300" />
                                    </div>
                                </div>
                                <button type="button" class="btn-add-input" onclick="addDynamicInput('addressesContainer', 'Addresses', 3, 'Thêm địa chỉ')">
                                    <i class="fas fa-plus"></i> Thêm địa chỉ
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-3 pt-3" style="border-top: 1px solid #f0f0f0;">
                        <button type="button" class="btn-cancel" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn-submit">Thêm nhân viên</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // ==================== Avatar Preview ====================
        document.getElementById('avatarInput').addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (ev) {
                    const img = document.getElementById('avatarPreview');
                    img.src = ev.target.result;
                    img.style.display = 'block';
                    document.querySelector('#avatarUploadBox .placeholder-icon').style.display = 'none';
                    document.querySelector('#avatarUploadBox .placeholder-text').style.display = 'none';
                }
                reader.readAsDataURL(file);
            }
        });

        // ==================== Dynamic Phone/Address ====================
        function addDynamicInput(containerId, fieldName, maxCount, label) {
            const container = document.getElementById(containerId);
            const currentCount = container.querySelectorAll('.dynamic-input-group').length;
            if (currentCount >= maxCount) {
                Swal.fire('Đã đạt giới hạn!', `Tối đa ${maxCount} mục.`, 'warning');
                return;
            }
            const div = document.createElement('div');
            div.className = 'dynamic-input-group';
            div.innerHTML = `
                <input type="text" name="${fieldName}" class="form-control" placeholder="${label}" maxlength="${fieldName === 'Phones' ? 15 : 300}" />
                <button type="button" class="btn-remove-input" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>
            `;
            container.appendChild(div);
        }

        // ==================== Toggle Status (SweetAlert2 + AJAX) ====================
        function toggleStaffStatus(staffId, staffName, isActive) {
            const action = isActive ? 'khóa' : 'mở khóa';
            const icon = isActive ? 'warning' : 'question';

            Swal.fire({
                title: `Xác nhận ${action} tài khoản?`,
                html: `Bạn có chắc muốn <strong>${action}</strong> tài khoản của <strong>${staffName}</strong>?`,
                icon: icon,
                showCancelButton: true,
                confirmButtonColor: isActive ? '#e03131' : '#0ca678',
                cancelButtonColor: '#868e96',
                confirmButtonText: isActive ? '<i class="fas fa-lock"></i> Khóa' : '<i class="fas fa-unlock"></i> Mở khóa',
                cancelButtonText: 'Hủy bỏ'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/Admin/AdminStaff/ToggleStatus/${staffId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        }
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({
                                title: 'Thành công!',
                                text: data.message,
                                icon: 'success',
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => location.reload());
                        } else {
                            Swal.fire('Lỗi!', data.message, 'error');
                        }
                    })
                    .catch(() => Swal.fire('Lỗi!', 'Không thể kết nối server.', 'error'));
                }
            });
        }

        // ==================== Show SweetAlert for TempData messages ====================
        @if (TempData["Success"] != null)
        {
            <text>
            Swal.fire({ title: 'Thành công!', text: '@Html.Raw(TempData["Success"])', icon: 'success', timer: 2000, showConfirmButton: false });
            </text>
        }
        @if (TempData["Error"] != null)
        {
            <text>
            Swal.fire({ title: 'Lỗi!', text: '@Html.Raw(TempData["Error"])', icon: 'error' });
            </text>
        }
    </script>

    <!-- Anti-forgery token for AJAX -->
    <form id="__AjaxAntiForgeryForm" asp-controller="AdminStaff" asp-action="ToggleStatus" method="post" style="display:none">
    </form>
}
