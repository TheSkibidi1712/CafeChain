@model IEnumerable<CafeChain.Application.DTOs.Admin.Drinks.AdminDrinkDTO>

@{
    ViewData["Title"] = "Quản lý Nước uống";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Quản lý Nước uống</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item active">Danh sách Nước uống</li>
    </ol>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card mb-4 shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <i class="fas fa-table me-1"></i>
                Danh sách Nước uống
            </div>
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fas fa-plus"></i> Thêm mới
            </a>
        </div>
        <div class="card-body">
            <table class="table table-bordered table-hover align-middle" id="datatablesSimple">
                <thead class="table-light">
                    <tr>
                        <th>Hình ảnh</th>
                        <th>Tên nước uống</th>
                        <th>Danh mục</th>
                        <th>Loại sản phẩm</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">
                                <img src="@item.ImageUrl" alt="@item.Name" style="height: 50px; width: 50px; object-fit: cover; border-radius: 5px;" />
                            </td>
                            <td class="fw-bold">@item.Name</td>
                            <td><span class="badge bg-info text-dark">@item.CategoryName</span></td>
                            <td><span class="badge bg-secondary">@item.ProductTypeName</span></td>
                            <td>
                                @if (item.Active)
                                {
                                    <span class="badge bg-success">Đang bán</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Ngừng bán</span>
                                }
                            </td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-info btn-manage-images" data-id="@item.DrinkId" data-name="@item.Name" title="Quản lý Ảnh"><i class="fas fa-images"></i></button>
                                <a asp-action="Edit" asp-route-id="@item.DrinkId" class="btn btn-sm btn-outline-primary" title="Sửa"><i class="fas fa-edit"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Image Management -->
<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-primary">Quản lý Ảnh - <span id="modalDrinkName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="currentDrinkId" value="" />
                

                <!-- Image List -->
                <h6 class="fw-bold mb-3 border-bottom pb-2"><i class="fas fa-layer-group"></i> Danh Sách Ảnh Đã Tải Lên</h6>
                <div class="row g-3" id="imageListContainer">
                    <div class="col-12 text-center text-muted">Đang tải...</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Edit Image -->
<div class="modal fade" id="editImageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-warning"><i class="fas fa-pencil-alt"></i> Chỉnh sửa ảnh</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editImageId" value="" />
                <div class="mb-3 text-center">
                    <p class="text-muted small mb-2">Ảnh hiện tại:</p>
                    <img id="editCurrentPreview" src="" alt="Current Image"
                         style="max-height: 150px; max-width: 100%; object-fit: contain; border-radius: 6px; border: 1px solid #dee2e6;" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Chọn ảnh mới <span class="text-danger">*</span></label>
                    <input type="file" class="form-control" id="newImageFileInput" accept=".jpg,.jpeg,.png" />
                    <div class="form-text">Chỉ chấp nhận JPG, JPEG, PNG.</div>
                </div>
                <div id="newImagePreviewWrapper" class="text-center mb-2" style="display:none;">
                    <p class="text-muted small mb-1">Xem trước ảnh mới:</p>
                    <img id="newImagePreview" src="" alt="New Image Preview"
                         style="max-height: 150px; max-width: 100%; object-fit: contain; border-radius: 6px; border: 1px dashed #0d6efd;" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-warning btn-sm" id="btnConfirmEditImage">
                    <i class="fas fa-save"></i> Lưu ảnh mới
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            
            // 1. Open Modal & Load Images
            $('.btn-manage-images').click(function () {
                var drinkId = $(this).data('id');
                var drinkName = $(this).data('name');
                
                $('#currentDrinkId').val(drinkId);
                $('#modalDrinkName').text(drinkName);
                
                
                loadImages(drinkId);
                
                var myModal = new bootstrap.Modal(document.getElementById('imageModal'));
                myModal.show();
            });

            // Hàm Load Images
            function loadImages(drinkId) {
                $('#imageListContainer').html('<div class="col-12 text-center text-muted"><i class="fas fa-spinner fa-spin"></i> Đang tải ảnh...</div>');
                
                $.get('@Url.Action("GetImages", "AdminDrink")?drinkId=' + drinkId, function (res) {
                    if (res.success) {
                        renderImages(res.data);
                    } else {
                        $('#imageListContainer').html('<div class="col-12 text-danger text-center">Lỗi tải danh sách ảnh.</div>');
                    }
                });
            }

            // Render danh sách ảnh
            function renderImages(images) {
                var container = $('#imageListContainer');
                container.empty();

                if (!images || images.length === 0) {
                    container.html('<div class="col-12 text-center text-muted py-3">Chưa có ảnh nào. Bạn hãy tải ảnh mới lên.</div>');
                    return;
                }

                images.forEach(function (img) {
                    var defaultBadge = img.isDefault 
                        ? '<span class="badge bg-success position-absolute top-0 start-0 m-1">Mặc định</span>'
                        : '';
                        
                    var actionBtns = img.isDefault 
                        ? `<div class="d-flex gap-1">
                               <button class="btn btn-sm btn-outline-warning flex-grow-1 btn-edit-img" data-imgid="${img.drinkImageId}" data-imgurl="${img.imageUrl}" title="Chỉnh sửa ảnh"><i class="fas fa-pencil-alt"></i> Sửa</button>
                               <button class="btn btn-sm btn-outline-danger btn-delete-img" data-imgid="${img.drinkImageId}" title="Xóa"><i class="fas fa-trash"></i></button>
                           </div>`
                        : `<div class="d-flex gap-1">
                               <button class="btn btn-sm btn-outline-success flex-grow-1 btn-set-default" data-imgid="${img.drinkImageId}" title="Đặt làm mặc định"><i class="fas fa-check-circle"></i> Mặc định</button>
                               <button class="btn btn-sm btn-outline-warning btn-edit-img" data-imgid="${img.drinkImageId}" data-imgurl="${img.imageUrl}" title="Chỉnh sửa ảnh"><i class="fas fa-pencil-alt"></i></button>
                               <button class="btn btn-sm btn-outline-danger btn-delete-img" data-imgid="${img.drinkImageId}" title="Xóa"><i class="fas fa-trash"></i></button>
                           </div>`;

                    var html = `
                        <div class="col-md-4 col-sm-6">
                            <div class="card h-100 shadow-sm ${img.isDefault ? 'border-success' : ''}">
                                <div class="position-relative" style="height: 150px; background: #f8f9fa;">
                                    ${defaultBadge}
                                    <img src="${img.imageUrl}" class="card-img-top h-100 w-100" style="object-fit: cover;" alt="Drink Image">
                                </div>
                                <div class="card-body p-2 text-center bg-light">
                                    ${actionBtns}
                                </div>
                            </div>
                        </div>
                    `;
                    container.append(html);
                });
            }

            // 2. Set Default Image
            $(document).on('click', '.btn-set-default', function () {
                var drinkImgId = $(this).data('imgid');
                var drinkId = $('#currentDrinkId').val();
                
                $.post('@Url.Action("SetDefaultImage", "AdminDrink")', { drinkId: drinkId, drinkImageId: drinkImgId }, function (res) {
                    if (res.success) {
                        loadImages(drinkId); // Tự động giật load lại để đổi badge/UI
                    } else {
                        alert(res.message);
                    }
                });
            });

            // 4. Delete Image
            $(document).on('click', '.btn-delete-img', function () {
                if (!confirm("Bạn có chắc muốn xóa ảnh này?")) return;
                
                var drinkImgId = $(this).data('imgid');
                var drinkId = $('#currentDrinkId').val();
                
                $.post('@Url.Action("DeleteImage", "AdminDrink")', { drinkImageId: drinkImgId }, function (res) {
                    if (res.success) {
                        loadImages(drinkId);
                    } else {
                        alert(res.message);
                    }
                });
            });

            // 5. Toggle Status Drink (Món uống chính)
            $(document).on('click', '.btn-toggle-drink', function () {
                var drinkId = $(this).data('id');
                $.post('@Url.Action("ToggleStatus", "AdminDrink")', { id: drinkId }, function (res) {
                    if (res.success) {
                        location.reload(); 
                    } else {
                        alert(res.message);
                    }
                });
            });

            // 6. Mở modal chỉnh sửa ảnh
            $(document).on('click', '.btn-edit-img', function () {
                var imgId  = $(this).data('imgid');
                var imgUrl = $(this).data('imgurl');

                $('#editImageId').val(imgId);
                $('#editCurrentPreview').attr('src', imgUrl);
                $('#newImageFileInput').val('');
                $('#newImagePreview').attr('src', '');
                $('#newImagePreviewWrapper').hide();

                var editModal = new bootstrap.Modal(document.getElementById('editImageModal'));
                editModal.show();
            });

            // 7. Preview ảnh mới khi chọn file
            $('#newImageFileInput').on('change', function () {
                var file = this.files[0];
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $('#newImagePreview').attr('src', e.target.result);
                        $('#newImagePreviewWrapper').show();
                    };
                    reader.readAsDataURL(file);
                } else {
                    $('#newImagePreview').attr('src', '');
                    $('#newImagePreviewWrapper').hide();
                }
            });

            // 8. Xác nhận lưu ảnh mới
            $('#btnConfirmEditImage').on('click', function () {
                var imgId = $('#editImageId').val();
                var fileInput = document.getElementById('newImageFileInput');

                if (!fileInput.files || fileInput.files.length === 0) {
                    alert('Vui lòng chọn ảnh mới trước khi lưu.');
                    return;
                }

                var formData = new FormData();
                formData.append('drinkImageId', imgId);
                formData.append('newImageFile', fileInput.files[0]);

                var btn = $(this);
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang lưu...');

                $.ajax({
                    url: '@Url.Action("UpdateImage", "AdminDrink")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        btn.prop('disabled', false).html('<i class="fas fa-save"></i> Lưu ảnh mới');
                        if (res.success) {
                            bootstrap.Modal.getInstance(document.getElementById('editImageModal')).hide();
                            var drinkId = $('#currentDrinkId').val();
                            loadImages(drinkId);
                        } else {
                            alert(res.message);
                        }
                    },
                    error: function () {
                        btn.prop('disabled', false).html('<i class="fas fa-save"></i> Lưu ảnh mới');
                        alert('Đã có lỗi xảy ra. Vui lòng thử lại.');
                    }
                });
            });

        });
    </script>
}
