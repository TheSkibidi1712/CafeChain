@model CafeChain.ViewModels.Admin.Suppliers.AdminSupplierEditViewModel

@{
    ViewData["Title"] = "Sửa Nhà Cung Cấp";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Sửa Nhà Cung Cấp</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Nhà Cung Cấp</a></li>
        <li class="breadcrumb-item active">Chỉnh sửa</li>
    </ol>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header">
                    <i class="fas fa-edit me-1"></i> Chỉnh sửa Nhà Cung Cấp
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input asp-for="SupplierUpdateDTO.SupplierId" type="hidden" />

                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
                        {
                            <div class="alert alert-danger">
                                <ul class="mb-0">
                                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                </ul>
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="SupplierUpdateDTO.Code" class="form-label fw-semibold">
                                    Mã NCC <span class="text-danger">*</span>
                                </label>
                                <input asp-for="SupplierUpdateDTO.Code" class="form-control"
                                       style="text-transform:uppercase;" />
                                <span asp-validation-for="SupplierUpdateDTO.Code" class="text-danger small"></span>
                            </div>
                            <div class="col-md-8 mb-3">
                                <label asp-for="SupplierUpdateDTO.Name" class="form-label fw-semibold">
                                    Tên Nhà Cung Cấp <span class="text-danger">*</span>
                                </label>
                                <input asp-for="SupplierUpdateDTO.Name" class="form-control" />
                                <span asp-validation-for="SupplierUpdateDTO.Name" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SupplierUpdateDTO.Phone" class="form-label fw-semibold">Số điện thoại</label>
                            <input asp-for="SupplierUpdateDTO.Phone" class="form-control" type="tel"
                                   pattern="[0-9]*" inputmode="numeric"
                                   oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                            <span asp-validation-for="SupplierUpdateDTO.Phone" class="text-danger small"></span>
                            <div class="form-text">Chỉ được nhập số, tối đa 15 số.</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SupplierUpdateDTO.Address" class="form-label fw-semibold">Địa chỉ</label>
                            <textarea asp-for="SupplierUpdateDTO.Address" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="SupplierUpdateDTO.Address" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Trạng thái</label>
                            <div class="form-check form-switch">
                                <input asp-for="SupplierUpdateDTO.Active" class="form-check-input" type="checkbox" role="switch" />
                                <label asp-for="SupplierUpdateDTO.Active" class="form-check-label">Đang hoạt động</label>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Lưu thay đổi
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
