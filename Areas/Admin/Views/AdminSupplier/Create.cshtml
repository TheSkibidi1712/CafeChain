@model CafeChain.ViewModels.Admin.Suppliers.AdminSupplierCreateViewModel

@{
    ViewData["Title"] = "Thêm Nhà Cung Cấp";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Thêm Nhà Cung Cấp</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Nhà Cung Cấp</a></li>
        <li class="breadcrumb-item active">Thêm mới</li>
    </ol>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header">
                    <i class="fas fa-plus me-1"></i> Thông tin Nhà Cung Cấp
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
                        {
                            <div class="alert alert-danger">
                                <ul class="mb-0">
                                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                </ul>
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="SupplierCreateDTO.Code" class="form-label fw-semibold">
                                    Mã NCC <span class="text-danger">*</span>
                                </label>
                                <input asp-for="SupplierCreateDTO.Code" class="form-control"
                                       placeholder="VD: SUP00001" style="text-transform:uppercase;" />
                                <span asp-validation-for="SupplierCreateDTO.Code" class="text-danger small"></span>
                                <div class="form-text">Bắt đầu bằng <strong>SUP</strong> + số. VD: <code>SUP001</code>, <code>SUP00001</code></div>
                            </div>
                            <div class="col-md-8 mb-3">
                                <label asp-for="SupplierCreateDTO.Name" class="form-label fw-semibold">
                                    Tên Nhà Cung Cấp <span class="text-danger">*</span>
                                </label>
                                <input asp-for="SupplierCreateDTO.Name" class="form-control"
                                       placeholder="VD: Công ty Sữa Vinamilk..." />
                                <span asp-validation-for="SupplierCreateDTO.Name" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SupplierCreateDTO.Phone" class="form-label fw-semibold">Số điện thoại</label>
                            <input asp-for="SupplierCreateDTO.Phone" class="form-control" type="tel"
                                   pattern="[0-9]*" inputmode="numeric"
                                   placeholder="VD: 0901234567"
                                   oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                            <span asp-validation-for="SupplierCreateDTO.Phone" class="text-danger small"></span>
                            <div class="form-text">Chỉ được nhập số, đúng 10 hoặc 11 số.</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SupplierCreateDTO.Address" class="form-label fw-semibold">Địa chỉ</label>
                            <textarea asp-for="SupplierCreateDTO.Address" class="form-control" rows="2"
                                      placeholder="VD: 123 Lê Lợi, Quận 1, TP.HCM"></textarea>
                            <span asp-validation-for="SupplierCreateDTO.Address" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Lưu
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
