@model IEnumerable<CafeChain.Application.DTOs.Admin.Suppliers.AdminSupplierDTO>

@{
    ViewData["Title"] = "Quản lý Nhà Cung Cấp";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Quản lý Nhà Cung Cấp</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item active">Danh sách Nhà Cung Cấp</li>
    </ol>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card mb-4 shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <i class="fas fa-truck me-1"></i>
                Danh sách Nhà Cung Cấp
            </div>
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fas fa-plus"></i> Thêm mới
            </a>
        </div>
        <div class="card-body">
            <table class="table table-bordered table-hover align-middle" id="datatablesSimple">
                <thead class="table-light">
                    <tr>
                        <th>Mã NCC</th>
                        <th>Tên Nhà Cung Cấp</th>
                        <th>Số điện thoại</th>
                        <th>Địa chỉ</th>
                        <th class="text-end">Công nợ</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-secondary font-monospace">@item.Code</span></td>
                            <td class="fw-bold">@item.Name</td>
                            <td>@(string.IsNullOrEmpty(item.Phone) ? "—" : item.Phone)</td>
                            <td class="text-truncate" style="max-width: 200px;" title="@item.Address">
                                @(string.IsNullOrEmpty(item.Address) ? "—" : item.Address)
                            </td>
                            <td class="text-end fw-semibold @(item.DebtAmount > 0 ? "text-danger" : "text-success")">
                                @item.DebtAmount.ToString("N0") đ
                            </td>
                            <td>
                                @if (item.Active)
                                {
                                    <span class="badge bg-success">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Ngừng hợp tác</span>
                                }
                            </td>
                            <td class="text-center" style="white-space: nowrap;">
                                <button type="button"
                                        class="btn btn-sm btn-outline-warning btn-adjust-debt"
                                        data-id="@item.SupplierId"
                                        data-name="@item.Name"
                                        data-debt="@item.DebtAmount"
                                        title="Điều chỉnh công nợ">
                                    <i class="fas fa-coins"></i>
                                </button>
                                <a asp-action="Edit" asp-route-id="@item.SupplierId"
                                   class="btn btn-sm btn-outline-primary" title="Sửa">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button"
                                        class="btn btn-sm @(item.Active ? "btn-outline-danger" : "btn-outline-success") btn-toggle-supplier"
                                        data-id="@item.SupplierId"
                                        title="@(item.Active ? "Ngừng hợp tác" : "Kích hoạt")">
                                    <i class="fas @(item.Active ? "fa-ban" : "fa-check-circle")"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Điều chỉnh Công nợ -->
<div class="modal fade" id="debtModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-warning">
                    <i class="fas fa-coins"></i> Điều chỉnh Công nợ
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1 text-muted small">Nhà cung cấp:</p>
                <p class="fw-bold mb-2" id="debtModalSupplierName"></p>
                <p class="mb-1 text-muted small">Công nợ hiện tại:</p>
                <p class="fw-bold text-danger mb-3" id="debtModalCurrentDebt"></p>

                <input type="hidden" id="debtSupplierId" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Loại điều chỉnh <span class="text-danger">*</span></label>
                    <select class="form-select" id="debtType">
                        <option value="add">➕ Tăng công nợ (NCC giao hàng chưa thanh toán)</option>
                        <option value="sub">➖ Giảm công nợ (Đã thanh toán)</option>
                    </select>
                </div>

                <div class="mb-2">
                    <label class="form-label fw-semibold">Số tiền <span class="text-danger">*</span></label>
                    <input type="number" class="form-control" id="debtAmount"
                           min="1" step="1000" placeholder="VD: 500000" />
                    <div class="form-text">Nhập số tiền cần điều chỉnh (VNĐ).</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-warning btn-sm" id="btnConfirmDebt">
                    <i class="fas fa-save"></i> Xác nhận
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Toggle Status
        $(document).on('click', '.btn-toggle-supplier', function () {
            var id = $(this).data('id');
            if (!confirm("Xác nhận thay đổi trạng thái nhà cung cấp này?")) return;

            $.post('@Url.Action("ToggleStatus", "AdminSupplier")', { id: id }, function (res) {
                if (res.success) {
                    location.reload();
                } else {
                    alert(res.message);
                }
            });
        });

        // Mở modal Điều chỉnh Công nợ
        $(document).on('click', '.btn-adjust-debt', function () {
            var id   = $(this).data('id');
            var name = $(this).data('name');
            var debt = parseFloat($(this).data('debt'));

            $('#debtSupplierId').val(id);
            $('#debtModalSupplierName').text(name);
            $('#debtModalCurrentDebt').text(debt.toLocaleString('vi-VN') + ' đ');
            $('#debtAmount').val('');
            $('#debtType').val('add');

            new bootstrap.Modal(document.getElementById('debtModal')).show();
        });

        // Xác nhận điều chỉnh công nợ
        $('#btnConfirmDebt').on('click', function () {
            var id     = $('#debtSupplierId').val();
            var type   = $('#debtType').val();
            var amount = parseFloat($('#debtAmount').val());

            if (!amount || amount <= 0) {
                alert('Vui lòng nhập số tiền hợp lệ (lớn hơn 0).');
                return;
            }

            var finalAmount = type === 'sub' ? -amount : amount;
            var btn = $(this);
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang lưu...');

            $.post('@Url.Action("AdjustDebt", "AdminSupplier")', { id: id, amount: finalAmount }, function (res) {
                btn.prop('disabled', false).html('<i class="fas fa-save"></i> Xác nhận');
                if (res.success) {
                    bootstrap.Modal.getInstance(document.getElementById('debtModal')).hide();
                    location.reload();
                } else {
                    alert(res.message);
                }
            }).fail(function () {
                btn.prop('disabled', false).html('<i class="fas fa-save"></i> Xác nhận');
                alert('Đã có lỗi xảy ra. Vui lòng thử lại.');
            });
        });
    </script>
}
