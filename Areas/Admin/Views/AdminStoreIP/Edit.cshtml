@model CafeChain.Models.Stores.StoreIP
@{
    ViewData["Title"] = "Chỉnh sửa Địa chỉ IP";
    var stores = ViewBag.Stores as List<CafeChain.Models.Stores.Store>;
}

<div class="mb-4">
    <a asp-action="Index" class="text-muted text-decoration-none" style="font-size: 13px;"><i class="fas fa-arrow-left me-2"></i> Quay lại danh sách</a>
</div>

<div class="card border-0 shadow-sm" style="border-radius: 14px; max-width: 600px;">
    <div class="card-body p-4">
        <h4 class="fw-bold mb-1">Chỉnh sửa Địa chỉ IP</h4>
        <p class="text-muted mb-4" style="font-size: 13px;">Cập nhật thông tin IP cửa hàng</p>

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />

            <div class="mb-3">
                <label class="form-label fw-bold" style="font-size: 13px;">Cửa hàng <span class="text-danger">*</span></label>
                <select asp-for="StoreId" class="form-select" style="border-radius: 10px;">
                    @if (stores != null)
                    {
                        @foreach (var s in stores)
                        {
                            <option value="@s.StoreId" selected="@(s.StoreId == Model.StoreId)">@s.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold" style="font-size: 13px;">Địa chỉ IP <span class="text-danger">*</span></label>
                <input asp-for="IPAddress" class="form-control" style="border-radius: 10px;" />
            </div>

            <div class="mb-3">
                <div class="form-check form-switch">
                    <input asp-for="IsPublicNetwork" class="form-check-input" type="checkbox" />
                    <label class="form-check-label fw-bold" style="font-size: 13px;">IP Public</label>
                </div>
            </div>

            <div class="mb-3">
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label class="form-check-label fw-bold" style="font-size: 13px;">Kích hoạt</label>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold" style="font-size: 13px;">Ghi chú</label>
                <textarea asp-for="Notes" class="form-control" rows="2" style="border-radius: 10px;"></textarea>
            </div>

            <button type="submit" class="btn btn-danger w-100 py-2" style="border-radius: 10px; font-weight: 600;">
                <i class="fas fa-save me-2"></i> Lưu thay đổi
            </button>
        </form>
    </div>
</div>
