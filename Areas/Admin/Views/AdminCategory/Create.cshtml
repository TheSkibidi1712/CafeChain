@model CafeChain.Application.DTOs.Admin.Category.AdminCreateCategoryDto

@{
    ViewData["Title"] = "Thêm danh mục mới";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 style="font-weight: 700; color: #343a40;">Thêm danh mục mới</h2>
        <p class="text-muted" style="font-size: 14px;">Tạo danh mục đồ uống mới cho hệ thống CafeChain</p>
    </div>
    <a asp-action="Index" class="btn btn-light border">
        <i class="fas fa-arrow-left"></i> Quay lại danh sách
    </a>
</div>

<div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="Name" class="form-label" style="font-weight: 600;">Tên danh mục <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="Nhập tên danh mục..." />
                <span asp-validation-for="Name" class="text-danger" style="font-size: 13px;"></span>
            </div>

            <div class="mb-4 form-check form-switch">
                <input asp-for="Active" class="form-check-input" type="checkbox" id="flexSwitchCheckChecked" checked>
                <label class="form-check-label" for="flexSwitchCheckChecked" style="font-weight: 500;">Hoạt động</label>
            </div>

            <button type="submit" class="btn text-white px-4 py-2" style="background-color: #d93d20; border-radius: 8px; font-weight: 500;">
                <i class="fas fa-save"></i> Lưu danh mục
            </button>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
