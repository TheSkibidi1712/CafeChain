@model CafeChain.ViewModels.Admin.StoreInventories.InventoryIndexVM

<link rel="stylesheet" href="~/css/storeinventory.css" />

<div class="inventory-container">

    <div class="header">
        <h2>📦 Quản lý tồn kho</h2>

        <form method="get" class="search-form">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   placeholder="Tìm nguyên liệu..." />

            <input type="hidden"
                   name="storeId"
                   value="@Model.StoreId" />

            <button type="submit">Tìm</button>
        </form>

        <button class="btn-view-all"
                type="button"
                onclick="openTransactionModal(@Model.StoreId)">
            📜 Xem toàn bộ lịch sử
        </button>
    </div>

    <!-- STORE TABS -->
    <div class="store-tabs">
        @if (Model.Stores != null && Model.Stores.Any())
        {
            foreach (var store in Model.Stores)
            {
                <a class="store-tab @(store.StoreId == Model.StoreId ? "active" : "")"
                       href="?storeId=@store.StoreId&search=@ViewBag.Search&page=1">
                    @store.StoreName
                </a>
            }
        }
    </div>

    <!-- INVENTORY TABLE -->
    <table class="inventory-table">
        <thead>
            <tr>
                <th>Nguyên liệu</th>
                <th title="Tổng số lượng trong kho">Tồn kho</th>
                <th title="Số lượng đã được giữ cho đơn hàng / phiếu">Đang giữ</th>
                <th title="Số lượng có thể sử dụng ngay">Khả dụng</th>
                <th>Giá gần nhất</th>
                <th>NCC</th>
                <th>Cập nhật</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Items != null && Model.Items.Any())
            {
                foreach (var item in Model.Items)
                {
                    var available = item.AvailableQty - item.ReservedQty;

                    <tr>
                        <td class="ingredient-name">
                            @item.IngredientName
                        </td>

                        <td class="stock">
                            @($"{item.AvailableQty:N0} {item.UnitCode}")
                        </td>

                        <td class="reserved @(item.ReservedQty > 0 ? "highlight" : "")">
                            @($"{item.ReservedQty:N0} {item.UnitCode}")
                        </td>

                        <td class="usable @(available <= 0 ? "danger" : "")">
                            @($"{available:N0} {item.UnitCode}")
                        </td>

                        <td>
                            @if (item.LastUnitPrice != null)
                            {
                                @($"{item.LastUnitPrice:N0} đ")
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>

                        <td>
                            @(!string.IsNullOrWhiteSpace(item.LastSupplierName)
                                ? item.LastSupplierName
                                : "-")
                        </td>

                        <td>
                            @item.LastUpdated.ToString("dd/MM/yyyy HH:mm")
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="empty-data">
                        Không có dữ liệu tồn kho
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- PAGINATION -->
    <div class="pagination">

        @if (ViewBag.Page > 1)
        {
            <a class="page-btn"
                   href="?storeId=@Model.StoreId&search=@ViewBag.Search&page=@(ViewBag.Page - 1)">
                ←
            </a>
        }

        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <a class="page-btn @(i == ViewBag.Page ? "active" : "")"
                   href="?storeId=@Model.StoreId&search=@ViewBag.Search&page=@i">
                @i
            </a>
        }

        @if (ViewBag.Page < ViewBag.TotalPages)
        {
            <a class="page-btn"
                   href="?storeId=@Model.StoreId&search=@ViewBag.Search&page=@(ViewBag.Page + 1)">
                →
            </a>
        }

    </div>

</div>

<!-- MODAL -->
<div id="transactionModal" class="modal">
    <div class="modal-content">

        <div class="modal-close"
             onclick="closeModal()">
            <i class="fa fa-times"></i>
        </div>

        <h3>Lịch sử giao dịch kho</h3>

        <div id="transactionContent">
            <!-- AJAX load -->
        </div>

    </div>
</div>

<script src="~/js/storeinventory.js"></script>