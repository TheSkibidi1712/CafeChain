@model CafeChain.Application.DTOs.Admin.Inventory.AdminCreateStockImportDto

@{
    ViewData["Title"] = "Nhập Kho Nguyên Liệu";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 style="font-weight: 700; color: #343a40;">Nhập kho nguyên liệu</h2>
        <p class="text-muted" style="font-size: 14px;">Tạo phiếu nhập kho mới cho hệ thống chuỗi</p>
    </div>
    <a asp-action="Index" class="btn btn-light border">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>
</div>

<div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
    <div class="card-body p-4">
        <form asp-action="Import" method="post" id="importForm">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="Note" class="form-label" style="font-weight: 600;">Ghi chú nhập kho</label>
                <textarea asp-for="Note" class="form-control" rows="2" placeholder="Nhập lý do hoặc nguồn nhập..."></textarea>
                <span asp-validation-for="Note" class="text-danger"></span>
            </div>

            <h5 style="font-weight: 700; color: #343a40;" class="mb-3">Chi tiết phiếu nhập</h5>
            <table class="table table-bordered mb-4" id="detailsTable">
                <thead class="bg-light text-muted">
                    <tr>
                        <th style="width: 40%">Nguyên liệu</th>
                        <th style="width: 20%">Số lượng</th>
                        <th style="width: 25%">Đơn giá (VND)</th>
                        <th style="width: 15%" class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody id="detailsBody">
                    <!-- Dynamic rows will be added here -->
                    @if (Model.Details != null && Model.Details.Count > 0)
                    {
                        for (int i = 0; i < Model.Details.Count; i++)
                        {
                            <tr class="detail-row">
                                <td>
                                    <select name="Details[@i].IngredientId" class="form-select ingredient-select" asp-items="ViewBag.Ingredients">
                                        <option value="">-- Chọn nguyên liệu --</option>
                                    </select>
                                </td>
                                <td>
                                    <input type="number" name="Details[@i].Quantity" class="form-control" step="0.01" value="@Model.Details[i].Quantity" required />
                                </td>
                                <td>
                                    <input type="number" name="Details[@i].UnitPrice" class="form-control" step="1000" value="@Model.Details[i].UnitPrice" required />
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-danger btn-remove-row"><i class="fas fa-trash"></i></button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <div class="mb-4">
                <button type="button" id="btnAddRow" class="btn btn-sm btn-outline-primary shadow-sm" style="border-radius: 6px;">
                    <i class="fas fa-plus"></i> Thêm dòng
                </button>
            </div>

            <hr />
            <div class="d-flex justify-content-end mt-4">
                <button type="submit" class="btn text-white px-5 py-2" style="background-color: #d9421c; border-radius: 8px; font-weight: 600; font-size: 16px;">
                    <i class="fas fa-check-circle me-1"></i> Lưu phiếu nhập
                </button>
            </div>
        </form>
    </div>
</div>

<div id="ingredientOptions" style="display:none;">
    <select id="templateSelect" class="form-select" asp-items="ViewBag.Ingredients">
         <option value="">-- Chọn nguyên liệu --</option>
    </select>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let rowCount = $('.detail-row').length;

            $('#btnAddRow').click(function () {
                var selectHtml = $('#templateSelect').html();
                var newRow = `
                    <tr class="detail-row">
                        <td>
                            <select name="Details[${rowCount}].IngredientId" class="form-select ingredient-select" required>
                                ${selectHtml}
                            </select>
                        </td>
                        <td>
                            <input type="number" name="Details[${rowCount}].Quantity" class="form-control" step="0.01" value="1" required />
                        </td>
                        <td>
                            <input type="number" name="Details[${rowCount}].UnitPrice" class="form-control" step="1000" value="0" required />
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-outline-danger btn-remove-row"><i class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                `;
                $('#detailsBody').append(newRow);
                rowCount++;
                updateRowIndices();
            });

            $(document).on('click', '.btn-remove-row', function () {
                $(this).closest('tr').remove();
                updateRowIndices();
            });

            // If empty, add a default row
            if (rowCount === 0) {
                $('#btnAddRow').click();
            }

            function updateRowIndices() {
                $('#detailsBody tr.detail-row').each(function (index) {
                    $(this).find('.ingredient-select').attr('name', `Details[${index}].IngredientId`);
                    $(this).find('input[type="number"]').eq(0).attr('name', `Details[${index}].Quantity`);
                    $(this).find('input[type="number"]').eq(1).attr('name', `Details[${index}].UnitPrice`);
                });
                rowCount = $('#detailsBody tr.detail-row').length;
            }
            
            $('#importForm').submit(function(e) {
                if ($('.detail-row').length === 0) {
                    alert('Bạn phải thêm ít nhất 1 nguyên liệu để nhập kho!');
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}
