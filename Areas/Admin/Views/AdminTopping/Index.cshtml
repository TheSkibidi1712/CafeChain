@model IEnumerable<CafeChain.ViewModels.Admin.Toppings.AdminToppingVM>
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<link rel="stylesheet" href="~/css/topping.css" />

<div class="container-fluid p-4">

    <!-- Tabs -->
    <div class="d-flex mb-3 border-bottom">
        <a asp-area="Admin"
               asp-controller="AdminSize"
               asp-action="Index"
               class="me-4 pb-2 text-decoration-none fw-semibold
            @(currentController == "AdminSize" ? "text-danger border-bottom border-danger" : "text-muted")">
            Quản lý Size
        </a>

        <a asp-area="Admin"
               asp-controller="AdminTopping"
               asp-action="Index"
               class="pb-2 text-decoration-none fw-semibold
            @(currentController == "AdminTopping" ? "text-danger border-bottom border-danger" : "text-muted")">
            Quản lý Topping
        </a>
    </div>

    <!-- Card -->
    <div class="main-card shadow-sm p-3">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">Danh sách Topping</h5>

            <button class="btn btn-orange"
                    data-bs-toggle="modal"
                    data-bs-target="#createModal">
                <i class="fas fa-plus me-2"></i> Thêm mới
            </button>
        </div>
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        @if (TempData["success"] != null)
        {
            <div class="alert alert-success">@TempData["success"]</div>
        }

        @if (TempData["error"] != null)
        {
            <div class="alert alert-danger">@TempData["error"]</div>
        }
        <!-- Table -->
        <table class="table table-borderless">
            <thead class="text-muted">
                <tr>
                    <th>TOPPING</th>
                    <th>GIÁ</th>
                    <th>TRẠNG THÁI</th>
                    <th class="text-end">HÀNH ĐỘNG</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="border-top">
                        <!-- Topping -->
                        <td>
                            <div class="d-flex align-items-center">
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/no-image.png" : item.ImageUrl)"
                                     class="topping-img me-3" />

                                <div class="fw-semibold">
                                    @item.Name
                                </div>
                            </div>
                        </td>

                        <!-- Price -->
                        <td class="fw-semibold text-danger">
                            + @item.Price.ToString("N0") đ
                        </td>

                        <!-- Status -->
                        <td>
                            @if (item.Active)
                            {
                                <span class="status-active">Hoạt động</span>
                            }
                            else
                            {
                                <span class="status-inactive">Ngừng</span>
                            }
                        </td>

                        <!-- Actions -->
                        <td class="text-end">

                            <!-- EDIT -->
                            <button class="btn btn-sm btn-light me-2"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editModal"
                                    onclick="openEditModal(@item.ToppingId, '@item.Name', @item.Price, '@item.ImageUrl')">
                                <i class="fas fa-pen text-primary"></i>
                            </button>

                            <!-- TOGGLE -->
                            <form asp-action="ToggleStatus"
                                  asp-route-id="@item.ToppingId"
                                  method="post"
                                  class="d-inline">

                                <button type="submit"
                                        class="btn btn-sm"
                                         onclick="return confirm('Đổi trạng thái topping?')">
                                    <i class="fas @(item.Active ? "fa-lock text-danger" : "fa-unlock text-success")"></i>
                                </button>
                            </form>

                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>

<!-- ================= CREATE MODAL ================= -->
<div class="modal fade" id="createModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-3">

            <div class="modal-header border-0">
                <h6 class="fw-bold">Thêm Topping</h6>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div class="modal-body">

                    <div class="mb-3">
                        <label>Tên topping</label>
                        <input name="Name" class="form-control bg-light" required />
                        <span data-valmsg-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label>Giá</label>
                        <input name="Price" type="number" min="1" class="form-control bg-light" required />
                        <span data-valmsg-for="Price" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label>Ảnh topping</label>
                        <input type="file"
                               id="create-image-input"
                               name="ImageFile"
                               class="form-control"
                               accept="image/*"
                               onchange="previewCreateImage(event)" />

                        <div class="position-relative d-inline-block mt-2">
                            <img id="create-preview"
                                 class="rounded preview-img d-none" />

                            <button type="button"
                                    id="create-remove-btn"
                                    class="btn btn-sm btn-danger position-absolute top-0 end-0 d-none"
                                    onclick="removeCreateImage()">
                                X
                            </button>
                        </div>

                        <span data-valmsg-for="ImageFile" class="text-danger"></span>
                    </div>

                </div>

                <div class="modal-footer border-0">
                    <button class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button class="btn btn-orange"><i class="fas fa-save me-2"></i> Lưu thông tin</button>
                </div>
            </form>

        </div>
    </div>
</div>

<!-- ================= EDIT MODAL ================= -->
<div class="modal fade" id="editModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-3">

            <div class="modal-header border-0">
                <h6 class="fw-bold">Chỉnh sửa Topping</h6>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" id="edit-id" name="ToppingId" />
                <input type="hidden" id="edit-old-image" name="ImageUrl" />

                <div class="modal-body">

                    <div class="mb-3">
                        <label>Tên topping</label>
                        <input id="edit-name" name="Name" class="form-control bg-light" />
                    </div>

                    <div class="mb-3">
                        <label>Giá</label>
                        <input id="edit-price" name="Price" type="number" class="form-control bg-light" />
                    </div>

                    <div class="mb-3">
                        <label>Ảnh topping</label>
                        <input type="file"
                               id="edit-image-input"
                               name="ImageFile"
                               class="form-control"
                               accept="image/*"
                               onchange="previewEditImage(event)" />

                        <div class="position-relative d-inline-block mt-2">
                            <img id="edit-preview"
                                 class="rounded preview-img" />

                            <button type="button"
                                    id="edit-remove-btn"
                                    class="btn btn-sm btn-danger position-absolute top-0 end-0"
                                    onclick="removeEditImage()">
                                X
                            </button>
                        </div>
                    </div>

                </div>

                <div class="modal-footer border-0">
                    <button class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button class="btn btn-orange">Cập nhật</button>
                </div>
            </form>

        </div>
    </div>
</div>

<script>
    // ===== CREATE =====
    function previewCreateImage(event) {
        const file = event.target.files[0];
        if (!file) return;

        const img = document.getElementById('create-preview');
        const btn = document.getElementById('create-remove-btn');

        img.src = URL.createObjectURL(file);
        img.classList.remove('d-none');
        btn.classList.remove('d-none');
    }

    function removeCreateImage() {
        const input = document.getElementById('create-image-input');
        const img = document.getElementById('create-preview');
        const btn = document.getElementById('create-remove-btn');

        input.value = "";
        img.src = "";
        img.classList.add('d-none');
        btn.classList.add('d-none');
    }

    // ===== EDIT =====
    function previewEditImage(event) {
        const file = event.target.files[0];
        if (!file) return;

        const img = document.getElementById('edit-preview');

        img.src = URL.createObjectURL(file);
    }

    function removeEditImage() {
        const input = document.getElementById('edit-image-input');
        const img = document.getElementById('edit-preview');

        input.value = "";
        img.src = "/images/no-image.png"; // fallback
    }

    function openEditModal(id, name, price, image) {
        document.getElementById('edit-id').value = id;
        document.getElementById('edit-name').value = name;
        document.getElementById('edit-price').value = price;
        document.getElementById('edit-old-image').value = image;

        const img = document.getElementById('edit-preview');
        img.src = image ? image : "/images/no-image.png";
    }
</script>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}