@model CafeChain.ViewModels.Admin.UnitConversions.UnitConversionVM

@{
    ViewData["Title"] = "Tạo Quy đổi Đơn vị";
}

<style>
    .conv-card {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.07);
        background: white;
    }
    .conv-header {
        background: linear-gradient(135deg, #1e293b, #0f172a);
        color: white;
        border-radius: 12px 12px 0 0;
        padding: 20px;
    }
    .conv-formula-box {
        background: #f8fafc;
        border: 2px dashed #cbd5e1;
        border-radius: 12px;
        padding: 30px;
        text-align: center;
    }
    .conv-equals {
        font-size: 2rem;
        font-weight: 800;
        color: #f97316;
        line-height: 1;
    }
    .btn-conv-primary {
        background-color: #f97316;
        border-color: #f97316;
        color: white;
        font-weight: 600;
    }
    .btn-conv-primary:hover {
        background-color: #ea580c;
        border-color: #ea580c;
        color: white;
    }
    .conv-preview {
        background: linear-gradient(135deg, #fef3c7, #fde68a);
        border: 1px solid #f59e0b;
        border-radius: 8px;
        padding: 12px 20px;
        font-weight: 600;
        color: #92400e;
        font-size: 1.1rem;
        text-align: center;
        display: none;
    }
</style>

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-0">
                <i class="fas fa-exchange-alt me-2" style="color: #f97316;"></i>Tạo Quy đổi Đơn vị
            </h3>
            <p class="text-muted mb-0">Khai báo cách quy đổi giữa 2 đơn vị tính cho 1 nguyên liệu cụ thể</p>
        </div>
        <a asp-action="Index" class="btn btn-light border shadow-sm"><i class="fas fa-arrow-left me-1"></i> Quay lại</a>
    </div>

    <form asp-action="Create" method="post" id="conversionForm">
        @Html.AntiForgeryToken()

        <!-- SECTION 1: Chọn nguyên liệu -->
        <div class="conv-card mb-4">
            <div class="conv-header">
                <h5 class="mb-0"><i class="fas fa-box-open me-2"></i>Nguyên liệu áp dụng</h5>
            </div>
            <div class="card-body p-4">
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Chọn nguyên liệu <span class="text-danger">*</span></label>
                        <select name="IngredientId" id="ingredientSelect" class="form-select" required>
                            <option value="">-- Chọn nguyên liệu --</option>
                            @if (ViewBag.Ingredients != null)
                            {
                                foreach (dynamic ing in ViewBag.Ingredients)
                                {
                                    <option value="@ing.IngredientId">@ing.Name</option>
                                }
                            }
                        </select>
                        <small class="text-muted">Mỗi nguyên liệu có bảng quy đổi riêng</small>
                        <span asp-validation-for="IngredientId" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- SECTION 2: Công thức quy đổi -->
        <div class="conv-card mb-4">
            <div class="conv-header">
                <h5 class="mb-0"><i class="fas fa-calculator me-2"></i>Công thức Quy đổi</h5>
            </div>
            <div class="card-body p-4">
                <div class="conv-formula-box">
                    <div class="row align-items-center justify-content-center g-3">
                        <!-- FROM: Số lượng + Đơn vị nguồn -->
                        <div class="col-md-2">
                            <label class="form-label fw-bold text-muted small">Số lượng nguồn</label>
                            <input type="number" step="0.0001" min="0.0001"
                                   name="FromQuantity" id="fromQty"
                                   class="form-control form-control-lg text-center fw-bold"
                                   value="1" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold text-muted small">Đơn vị nguồn</label>
                            <select name="FromUnitId" id="fromUnitSelect" class="form-select form-select-lg" required>
                                <option value="">-- ĐVT --</option>
                                @if (ViewBag.Units != null)
                                {
                                    foreach (dynamic unit in ViewBag.Units)
                                    {
                                        <option value="@unit.UnitId" data-code="@unit.UnitCode">@unit.Name (@unit.UnitCode)</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="FromUnitId" class="text-danger small"></span>
                        </div>

                        <!-- DẤU BẰNG -->
                        <div class="col-md-1 d-flex align-items-end justify-content-center pb-2">
                            <span class="conv-equals">=</span>
                        </div>

                        <!-- TO: Số lượng + Đơn vị đích -->
                        <div class="col-md-2">
                            <label class="form-label fw-bold text-muted small">Số lượng đích</label>
                            <input type="number" step="0.0001" min="0.0001"
                                   name="ToQuantity" id="toQty"
                                   class="form-control form-control-lg text-center fw-bold"
                                   value="1000" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold text-muted small">Đơn vị đích</label>
                            <select name="ToUnitId" id="toUnitSelect" class="form-select form-select-lg" required>
                                <option value="">-- ĐVT --</option>
                                @if (ViewBag.Units != null)
                                {
                                    foreach (dynamic unit in ViewBag.Units)
                                    {
                                        <option value="@unit.UnitId" data-code="@unit.UnitCode">@unit.Name (@unit.UnitCode)</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="ToUnitId" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Live Preview -->
                    <div class="mt-4">
                        <div class="conv-preview" id="convPreview">
                            <i class="fas fa-check-circle me-2"></i>
                            <span id="previewText"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ACTION BUTTONS -->
        <div class="d-flex justify-content-end gap-3 mb-5">
            <a asp-action="Index" class="btn btn-light border px-4 shadow-sm">Hủy</a>
            <button type="submit" class="btn btn-conv-primary px-5 shadow-sm">
                <i class="fas fa-save me-2"></i>LƯU QUY ĐỔI
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $(document).ready(function () {
            // Select2 cho chọn nguyên liệu
            $('#ingredientSelect').select2({
                theme: 'bootstrap-5',
                placeholder: '-- Tìm nguyên liệu --',
                width: '100%'
            });

            // Live Preview khi thay đổi bất kỳ trường nào
            function updatePreview() {
                const fromQty = parseFloat($('#fromQty').val()) || 0;
                const toQty = parseFloat($('#toQty').val()) || 0;
                const fromUnit = $('#fromUnitSelect option:selected').text().trim();
                const toUnit = $('#toUnitSelect option:selected').text().trim();
                const ingredient = $('#ingredientSelect option:selected').text().trim();

                if (fromQty > 0 && toQty > 0 && fromUnit !== '-- ĐVT --' && toUnit !== '-- ĐVT --' && ingredient !== '-- Chọn nguyên liệu --') {
                    const text = `${ingredient}: ${fromQty} ${fromUnit} = ${toQty} ${toUnit}`;
                    $('#previewText').text(text);
                    $('#convPreview').slideDown(200);
                } else {
                    $('#convPreview').slideUp(200);
                }
            }

            $('#fromQty, #toQty').on('input', updatePreview);
            $('#fromUnitSelect, #toUnitSelect, #ingredientSelect').on('change', updatePreview);
        });
    </script>
}
