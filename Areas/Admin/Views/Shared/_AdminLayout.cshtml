@using CafeChain.Helpers
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CafeChain Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9fa;
        }

        .sidebar {
            height: 100vh;
            background-color: white;
            border-right: 1px solid #e9ecef;
            position: fixed;
            width: 250px;
            left: 0;
            top: 0;
            padding-top: 20px;
        }

        .sidebar a {
            padding: 12px 20px;
            display: block;
            color: #495057;
            text-decoration: none;
            font-weight: 500;
            font-size: 14px;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background-color: #fdf2f0;
            color: #d93d20;
            border-right: 4px solid #d93d20;
        }

        .sidebar i {
            width: 24px;
            text-align: center;
            margin-right: 10px;
        }

        .main-content {
            margin-left: 250px;
            padding: 30px;
        }

        .logo-wrap {
            display: flex;
            align-items: center;
            padding: 0 20px 30px;
            margin-bottom: 20px;
            border-bottom: 1px solid #e9ecef;
        }

        .logo-icon {
            background: #d93d20;
            color: white;
            border-radius: 8px;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 10px;
            font-weight: 800;
        }

        .logo-text {
            font-size: 18px;
            font-weight: 700;
            color: #212529;
            line-height: 1.2;
        }

        .logo-sub {
            font-size: 11px;
            color: #adb5bd;
            font-weight: 500;
        }

        .topbar {
            display: flex;
            justify-content: flex-end;
            padding-bottom: 20px;
            margin-bottom: 30px;
            border-bottom: 1px solid #e9ecef;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="sidebar">
        <div class="logo-wrap">
            <div class="logo-icon">C</div>
            <div>
                <div class="logo-text">CafeChain</div>
                <div class="logo-sub">Admin Dashboard</div>
            </div>
        </div>

        <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="@Html.IsActive("Admin")"><i class="fas fa-border-all"></i> Dashboard</a>
        
        <!-- Parent Menu DEMO: Quản lý sản phẩm -->
        <a href="#collapseProducts" data-bs-toggle="collapse" 
           aria-expanded="@(Html.IsActive("AdminCategory,AdminDrink,AdminSize,AdminTopping") != "" ? "true" : "false")"
           class="@Html.IsActive("AdminCategory,AdminDrink,AdminSize,AdminTopping")">
            <i class="fas fa-boxes"></i> Sản phẩm <i class="fas fa-chevron-down ms-auto" style="font-size: 10px; width: auto; float: right; margin-top: 5px;"></i>
        </a>
        <div class="collapse @Html.IsActive("AdminCategory,AdminDrink,AdminSize,AdminTopping", cssClass: "show")" id="collapseProducts">
            <div style="background-color: #fafafa; border-left: 2px solid #e9ecef; margin-left: 20px;">
                <a asp-area="Admin" asp-controller="AdminCategory" asp-action="Index" class="@Html.IsActive("AdminCategory")" style="padding-left: 15px;"><i class="fas fa-angle-right" style="font-size: 10px;"></i> Danh mục</a>
                <a asp-area="Admin" asp-controller="AdminDrink" asp-action="Index" class="@Html.IsActive("AdminDrink")" style="padding-left: 15px;"><i class="fas fa-angle-right" style="font-size: 10px;"></i> Đồ uống</a>
                <a asp-area="Admin" asp-controller="AdminSize" asp-action="Index" class="@Html.IsActive("AdminSize")" style="padding-left: 15px;"><i class="fas fa-angle-right" style="font-size: 10px;"></i> Size</a>
                <a asp-area="Admin" asp-controller="AdminTopping" asp-action="Index" class="@Html.IsActive("AdminTopping")" style="padding-left: 15px;"><i class="fas fa-angle-right" style="font-size: 10px;"></i> Topping</a>
            </div>
        </div>
        <!-- End DEMO -->

        <a asp-area="Admin" asp-controller="AdminIngredient" asp-action="Index" class="@Html.IsActive("AdminIngredient")"><i class="fas fa-leaf"></i> Quản lý nguyên liệu</a>
        <a asp-area="Admin" asp-controller="AdminSupplier" asp-action="Index" class="@Html.IsActive("AdminSupplier")"><i class="fas fa-truck"></i> Quản lý nhà CC</a>
        <a asp-area="Admin" asp-controller="AdminStaff" asp-action="Index" class="@Html.IsActive("AdminStaff")"><i class="fas fa-users"></i> Quản lý nhân sự</a>
        <a href="#" class="@Html.IsActive("AdminInventory")"><i class="fas fa-box"></i> Quản lý tồn kho</a>
        <a asp-area="Admin" asp-controller="AdminVoucher" asp-action="Index" class="@Html.IsActive("AdminVoucher")"><i class="fas fa-gift"></i> Quản lý voucher</a>
        <a asp-area="Admin" asp-controller="AdminOrder" asp-action="Index" class="@Html.IsActive("AdminOrder")"><i class="fas fa-receipt"></i> Quản lý đơn hàng</a>
        <a href="#" class="@Html.IsActive("AdminSetting")"><i class="fas fa-cog"></i> Cài đặt</a>
    </div>

    <div class="main-content">
        <div class="topbar">
            <i class="fas fa-bell text-muted"></i>
        </div>
        @RenderBody()
    </div>


    <!-- Bootstrap -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
