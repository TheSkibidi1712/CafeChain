@model CafeChain.ViewModels.MenuViewModel

@{
    ViewData["Title"] = "Thực đơn";
}

<div class="container mt-4 mb-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="/" class="text-muted text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item active text-orange fw-semibold" aria-current="page">Thực đơn</li>
        </ol>
    </nav>

    <div class="row mt-4">
        <div class="col-lg-3">
            <form id="filterForm" asp-controller="Drink" asp-action="Menu" method="get">
                <input type="hidden" name="page" id="pageInput" value="1" />
                <input type="hidden" name="categoryId" id="categoryInput" value="@Model.SelectedCategoryId" />
                <input type="hidden" name="keyword" value="@Model.Keyword" />
                <input type="hidden" name="minPrice" id="minPriceInput" value="@Model.MinPrice" />
                <input type="hidden" name="maxPrice" id="maxPriceInput" value="@Model.MaxPrice" />

                <div class="mb-5">
                    <h6 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-stack text-orange"></i> Danh mục
                    </h6>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <a href="javascript:void(0)" onclick="selectCategory('')"
                                class="text-decoration-none px-3 py-2 d-block rounded-3 @(!Model.SelectedCategoryId.HasValue ? "bg-orange text-white" : "text-muted")">
                                <i class="bi bi-cup me-2"></i> Tất cả
                            </a>
                        </li>
                        @foreach (var cat in Model.Categories)
                        {
                            var catIcon = "bi-cup-hot";
                            if (cat.Name.ToLower().Contains("trà sữa")) catIcon = "bi-cup-straw";
                            else if (cat.Name.ToLower().Contains("nước ngọt")) catIcon = "bi-soda-can";

                            <li class="mb-2">
                                <a href="javascript:void(0)" onclick="selectCategory('@cat.CategoryId')"
                                    class="text-decoration-none px-3 py-2 d-block rounded-3 @(Model.SelectedCategoryId == cat.CategoryId ? "bg-orange text-white" : "text-muted")">
                                    <i class="bi @catIcon me-2"></i> @cat.Name
                                </a>
                            </li>
                        }
                    </ul>
                </div>

                <div class="mb-5">
                    <h6 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-cash-stack text-orange"></i> Khoảng giá
                    </h6>
                    <div class="d-flex flex-wrap gap-2">
                         <button type="button" onclick="setPrice(0, 150000)" 
                                 class="btn btn-sm rounded-pill px-3 @(Model.MinPrice == 0 && Model.MaxPrice == 150000 ? "btn-orange" : "btn-outline-secondary")">Tất cả</button>
                         <button type="button" onclick="setPrice(0, 20000)" 
                                 class="btn btn-sm rounded-pill px-3 @(Model.MinPrice == 0 && Model.MaxPrice == 20000 ? "btn-orange" : "btn-outline-secondary")">Dưới 20k</button>
                         <button type="button" onclick="setPrice(20000, 50000)" 
                                 class="btn btn-sm rounded-pill px-3 @(Model.MinPrice == 20000 && Model.MaxPrice == 50000 ? "btn-orange" : "btn-outline-secondary")">20k - 50k</button>
                         <button type="button" onclick="setPrice(50000, 150000)" 
                                 class="btn btn-sm rounded-pill px-3 @(Model.MinPrice == 50000 && Model.MaxPrice == 150000 ? "btn-orange" : "btn-outline-secondary")">Trên 50k</button>
                    </div>
                </div>

                <div class="card border-0 rounded-4 overflow-hidden text-white" style="height: 250px; background: url('/Images/Upload/banner-home.jpg') center/cover;">
                    <div class="card-body d-flex flex-column justify-content-end" style="background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);">
                        <h5 class="fw-bold mb-1">Cà phê sữa</h5>
                        <a href="/Drink/Detail/1" class="text-white small">Khám phá ngay</a>
                    </div>
                </div>
            </form>
        </div>

        <div class="col-lg-9 mt-4 mt-lg-0">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold mb-0">
                    @(Model.SelectedCategoryId.HasValue ? Model.Categories.FirstOrDefault(c => c.CategoryId ==
                        Model.SelectedCategoryId)?.Name : "Tất cả sản phẩm")
                </h4>

                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small text-nowrap">Sắp xếp:</span>
                    <select name="sortBy" form="filterForm"
                        class="form-select form-select-sm border-0 bg-light fw-semibold"
                        onchange="document.getElementById('filterForm').submit();" style="width: auto;">
                        <option value="popular" selected="@(Model.SortBy == "popular")">Phổ biến nhất</option>
                        <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Giá tăng dần</option>
                        <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Giá giảm dần</option>
                    </select>
                </div>
            </div>

            <div class="row g-4">
                @if (Model.Drinks.Any())
                {
                    @foreach (var drink in Model.Drinks)
                    {
                        <div class="col-6 col-md-4 col-lg-4">
                            <partial name="~/Views/Product/ProductCard.cshtml" model="drink" />
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5 text-muted">
                        <i class="bi bi-emoji-frown fs-1 mb-3"></i>
                        <h5>Không tìm thấy sản phẩm nào phù hợp!</h5>
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="mt-5 d-flex justify-content-center">
                    <ul class="pagination pagination-sm gap-2">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link rounded-3 text-dark border-0 shadow-sm" href="javascript:void(0)"
                                onclick="goToPage(@(Model.CurrentPage - 1))"><i class="bi bi-chevron-left"></i></a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link rounded-3 border-0 shadow-sm @(Model.CurrentPage == i ? "bg-orange text-white" : "text-dark")"
                                    href="javascript:void(0)" onclick="goToPage(@i)">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link rounded-3 text-dark border-0 shadow-sm" href="javascript:void(0)"
                                onclick="goToPage(@(Model.CurrentPage + 1))"><i class="bi bi-chevron-right"></i></a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function setPrice(min, max) {
            document.getElementById("minPriceInput").value = min;
            document.getElementById("maxPriceInput").value = max;
            document.getElementById("pageInput").value = 1;
            document.getElementById("filterForm").submit();
        }

        // JS đổi Category
        function selectCategory(id) {
            document.getElementById("categoryInput").value = id;
            document.getElementById("pageInput").value = 1; // Reset về trang 1
            document.getElementById("filterForm").submit();
        }

        // JS chuyển trang
        function goToPage(pageIndex) {
            document.getElementById("pageInput").value = pageIndex;
            document.getElementById("filterForm").submit();
        }
    </script>
}