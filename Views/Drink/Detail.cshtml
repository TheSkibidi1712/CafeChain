        .filter-grayscale {
            filter: grayscale(1);
        }
    </style>
    
    <!-- TEMPLATE CHỨA FORM TRẢ LỜI SẼ ĐƯỢC JS NHẤC ĐI CHỖ KHÁC -->
    <template id="globalReplyFormTemplate">
        <div class="bg-light rounded-4 px-3 py-3 border border-secondary border-opacity-25" id="activeReplyForm">
            <input type="hidden" id="replyParentRatingId" />
            <div class="d-flex align-items-center mb-2">
                <span id="replyingToBadge" class="badge bg-orange text-white me-2 fw-semibold p-2"><i class="bi bi-reply-all-fill me-1"></i> Đang trả lời <span id="replyingToName">...</span></span>
                <span class="text-muted small cursor-pointer hover-text-danger ms-auto" onclick="closeReplyForm()"><i class="bi bi-x-circle-fill"></i> Hủy trả lời</span>
            </div>
            <div class="d-flex gap-2">
                <!-- Avatar giả lập của người đang đăng nhập (hoặc dùng icon tròn) -->
                <div class="rounded-circle bg-secondary bg-opacity-25 d-flex align-items-center justify-content-center text-muted" style="width: 40px; height: 40px; min-width: 40px;">
                    <i class="bi bi-person-fill fs-4"></i>
                </div>
                <!-- Vùng nhập chứa các icon -->
                <div class="flex-grow-1 position-relative reply-input-area">
                    <textarea class="form-control rounded-4 shadow-none bg-white pe-5 border-secondary border-opacity-25 reply-textarea fs-sm" 
                              id="replyComment" rows="1" placeholder="Bình luận dưới tên bạn..." 
                              oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'"></textarea>
                    
                    <!-- Cột Icon Tool Bar bên phải -->
                    <div class="d-flex position-absolute bottom-0 end-0 mb-2 me-2 gap-1 icon-toolbar">
                        <button type="button" class="btn btn-sm btn-light border-0 text-muted rounded-circle p-1 action-btn" onclick="document.getElementById('replyImageInput').click()">
                            <i class="bi bi-camera-fill fs-5"></i>
                        </button>
                    </div>
                </div>
            </div>
            
            <!-- Khu vực Preview hình ảnh -->
            <div id="replyImagePreviewBox" class="mt-2 ms-5 ps-1 d-none position-relative" style="width: 80px;">
                <img id="replyImagePreview" src="" class="rounded object-fit-cover shadow-sm border" style="width: 80px; height: 80px;" />
                <button type="button" class="btn btn-danger btn-sm rounded-circle position-absolute top-0 start-100 translate-middle" style="width: 24px; height: 24px; padding: 0; line-height: 1;" onclick="clearReplyImage()">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <input type="file" id="replyImageInput" class="d-none" accept=".jpg,.jpeg,.png" onchange="previewReplyImage(this)" />

            <div class="text-end mt-2">
                <button type="button" class="btn btn-orange rounded-pill px-4 py-1 btn-sm fw-bold shadow-sm" onclick="submitReplyAjax()">Gửi phản hồi</button>
            </div>
        </div>
    </template>
    
    <!-- MODAL BẮT ĐĂNG NHẬP -->
    <div class="modal fade" id="authModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
          <div class="modal-body text-center p-4">
            <img src="/Images/lock.png" onerror="this.src='https://cdn-icons-png.flaticon.com/512/295/295128.png'" style="width: 60px" class="mb-3 opacity-75"/>
            <h5 class="fw-bold text-orange">Chưa đăng nhập!</h5>
            <p class="text-muted small mb-4">Bạn cần đăng nhập để thao tác bình luận hoặc thả cảm xúc nhé!</p>
            <div class="d-flex gap-2 justify-content-center">
                <button type="button" class="btn btn-light rounded-pill px-4 border" data-bs-dismiss="modal">Đóng</button>
                <a href="/Account/Login" class="btn btn-orange rounded-pill px-4 fw-bold shadow-sm">Đăng nhập</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <style>
        .fs-sm { font-size: 0.9rem; }
        .text-orange { color: #d35400 !important; }
        .bg-orange { background-color: #d35400 !important; }
        .border-orange { border-color: #d35400 !important; }
        .hover-text-orange:hover { color: #d35400 !important; }
        
        /* Tooltip cảm xúc */
        .reaction-wrapper .reaction-tooltip {
            top: -45px;
            left: 50%;
            transform: translateX(-50%) scale(0.8);
            opacity: 0;
            visibility: hidden;
            transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            transform-origin: bottom center;
            pointer-events: none;
        }
        
        .reaction-wrapper:hover .reaction-tooltip,
        .reaction-wrapper:active .reaction-tooltip {
            opacity: 1;
            transform: translateX(-50%) scale(1);
            visibility: visible;
            pointer-events: auto;
        }
        
        /* Hiệu ứng nảy cho Icon */
        .reaction-icon {
            transition: transform 0.2s;
            display: inline-block;
        }
        .reaction-icon:hover {
            transform: scale(1.4) translateY(-5px);
        }
        
        .reply-textarea {
            resize: none;
            overflow: hidden;
            min-height: 42px;
            line-height: 1.5;
            padding-top: 10px;
        }
        
        .icon-toolbar {
            opacity: 0.7;
        }
        .reply-input-area:focus-within .icon-toolbar {
            opacity: 1;
        }
        .action-btn:hover {
            background-color: #e9ecef !important;
        }
    </style>

    <script>
        // Logic xử lý Rating Stars
        const starsHiddenInput = document.getElementById('selectedStars');
        const starIcons = document.querySelectorAll('#submitReviewStars i');

        if (starIcons && starIcons.length > 0) {
            starIcons.forEach(star => {
                star.addEventListener('mouseover', function() {
                    let val = parseInt(this.getAttribute('data-value'));
                    highlightStars(val);
                });
                star.addEventListener('mouseout', function() {
                    let currentVal = parseInt(starsHiddenInput.value);
                    highlightStars(currentVal);
                });
                star.addEventListener('click', function() {
                    let val = this.getAttribute('data-value');
                    starsHiddenInput.value = val;
                    highlightStars(parseInt(val));
                });
            });
        }

        function highlightStars(val) {
            if(!starIcons) return;
            starIcons.forEach(star => {
                let starVal = parseInt(star.getAttribute('data-value'));
                if (starVal <= val) {
                    star.classList.remove('text-muted');
                    star.classList.add('text-warning');
                } else {
                    star.classList.remove('text-warning');
                    star.classList.add('text-muted');
                }
            });
        }

        // Sử dụng JsonSerializer để Visual Studio không bị lỗi gạch đỏ khi dùng thẻ HTML trong JS
        const imageList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Drink.DrinkImages?.Select(i => i.ImageUrl) ?? new List<string>()));

        function changeMainImage(src) { document.getElementById('mainImage').src = src; }

        function navigateImage(direction) {
            if(imageList.length <= 1) return;
            const mainImg = document.getElementById('mainImage');
            let currentIndex = parseInt(mainImg.getAttribute('data-current-index'));
            currentIndex += direction;
            if (currentIndex >= imageList.length) currentIndex = 0;
            if (currentIndex < 0) currentIndex = imageList.length - 1;
            mainImg.src = imageList[currentIndex];
            mainImg.setAttribute('data-current-index', currentIndex);
        }

        let state = {
            basePrice: @defaultBasePrice.ToString("0"),
            optionalToppings: [],
            removedDefaultToppings: [],
            defaultToppings: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model.DefaultToppings ?? new List<CafeChain.Models.Drinks.DrinkDefaultTopping>()).Where(t => t.Topping != null).Select(t => new { id = t.ToppingId.ToString(), price = (int)t.Topping.Price })))
        };

        function updateDisplayTotal() {
            let optionalToppingsTotal = state.optionalToppings.reduce((sum, t) => sum + t.price, 0);
            
            // Tính tổng tiền các Topping Mặc Định (chỉ tính những cái CHƯA bị xóa)
            let defaultToppingsTotal = state.defaultToppings
                .filter(dt => !state.removedDefaultToppings.includes(dt.id))
                .reduce((sum, dt) => sum + dt.price, 0);

            let grandTotal = state.basePrice + optionalToppingsTotal + defaultToppingsTotal;
            
            document.getElementById('displayTotalPrice').innerText = grandTotal.toLocaleString('vi-VN') + 'đ';
            
            const breakdown = document.getElementById('priceBreakdown');
            const toppingsPriceEl = document.getElementById('toppingsPrice');
            const totalToppingsTotal = optionalToppingsTotal + defaultToppingsTotal;
            
            if (totalToppingsTotal > 0) {
                breakdown.classList.remove('d-none');
                document.getElementById('breakdownBasePrice').innerText = state.basePrice.toLocaleString('vi-VN');
                toppingsPriceEl.innerText = totalToppingsTotal.toLocaleString('vi-VN');
            } else {
                breakdown.classList.add('d-none');
            }
        }

        function selectSize(btn) {
            document.querySelectorAll('.size-btn').forEach(el => el.classList.remove('active'));
            btn.classList.add('active');
            state.basePrice = parseInt(btn.getAttribute('data-price'));
            
            // Cập nhật giá gốc trong dòng breakdown nếu đang hiển thị
            const breakdownBasePriceEl = document.getElementById('breakdownBasePrice');
            if(breakdownBasePriceEl) {
                breakdownBasePriceEl.innerText = state.basePrice.toLocaleString('vi-VN');
            }
            
            updateDisplayTotal();
        }

        function addOptionalTopping(select) {
            let option = select.options[select.selectedIndex];
            let id = option.value;
            if (id === "") return;

            let price = parseInt(option.getAttribute('data-price'));
            let name = option.text.split(' (+')[0];

            if (state.optionalToppings.some(t => t.id === id)) {
                showToast('Bạn đã chọn Topping này rồi!', 'warning');
                select.selectedIndex = 0;
                return;
            }

            state.optionalToppings.push({ id, price });
            let container = document.getElementById('optionalToppingsTagsContainer');
            let tagHtml = `
                <div class="topping-tag optional-tag d-flex align-items-center rounded-pill px-3 py-1 bg-light border small"
                     data-topping-id="${id}" data-price="${price}">
                    ${name} (+${price.toLocaleString('vi-VN')}đ)
                    <button type="button" class="btn btn-link text-orange p-0 ms-2 shadow-none" onclick="removeTag(this, 'optional', '${id}')">
                        <i class="bi bi-x fs-6 fw-bold"></i>
                    </button>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', tagHtml);
            select.selectedIndex = 0;
            updateDisplayTotal();
        }

        function removeTag(button, type, optionalId) {
            let tag = button.closest('.topping-tag');
            let id = tag.getAttribute('data-topping-id');

            if (type === 'default') {
                tag.style.opacity = '0.4';
                if (!state.removedDefaultToppings.includes(id)) {
                    state.removedDefaultToppings.push(id);
                }
                button.setAttribute('onclick', "restoreTag(this, 'default')");
                button.innerHTML = '<i class="bi bi-plus fs-6"></i>';
                updateDisplayTotal();
            } else if (type === 'optional') {
                tag.remove();
                state.optionalToppings = state.optionalToppings.filter(t => t.id !== optionalId);
                updateDisplayTotal();
            }
        }

        function restoreTag(button, type) {
             let tag = button.closest('.topping-tag');
             let id = tag.getAttribute('data-topping-id');
             tag.style.opacity = '1';
             state.removedDefaultToppings = state.removedDefaultToppings.filter(removedId => removedId !== id);
             button.setAttribute('onclick', "removeTag(this, 'default')");
             button.innerHTML = '<i class="bi bi-x fs-6"></i>';
             updateDisplayTotal();
        }

        function updateQty(change) {
            let input = document.getElementById('quantity');
            let current = parseInt(input.value);
            if (current + change >= 1) { input.value = current + change; }
        }

        function addToCartDetail() {
             if (!isAuthenticated) {
                 window.location.href = '/Account/Login?ReturnUrl=' + encodeURIComponent(window.location.pathname + window.location.search);
                 return;
             }

             let activeSizeBtn = document.querySelector('.size-btn.active');
             if (!activeSizeBtn) {
                 showToast('Vui lòng chọn Size trước khi thêm vào giỏ hàng nhé!', 'warning');
                 return;
             }

             // Lấy giá trị ghi chú một cách an toàn (tránh lỗi null)
             let noteElement = document.getElementById('drinkNote');
             let noteValue = noteElement ? noteElement.value.trim() : "";

             // Đóng gói dữ liệu gửi đi (Đảm bảo không thiếu dấu phẩy)
             let payload = {
                 drinkId: parseInt(document.getElementById('drinkId').value),
                 sizeId: parseInt(activeSizeBtn.getAttribute('data-size-id')),
                 quantity: parseInt(document.getElementById('quantity').value),
                 optionalToppingIds: state.optionalToppings.map(t => parseInt(t.id)),
                 removedDefaultToppingIds: state.removedDefaultToppings.map(id => parseInt(id)),
                 note: noteValue
             };

             let btn = document.querySelector('button[onclick="addToCartDetail()"]');
             let originalText = btn.innerHTML;
             btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Đang thêm...';
             btn.disabled = true;

             fetch('/Cart/AddToCartAdvance', {
                 method: 'POST',
                 headers: { 'Content-Type': 'application/json' },
                 body: JSON.stringify(payload)
             })
             .then(res => res.json())
             .then(data => {
                 if (data.success) {
                     const badge = document.getElementById('cart-badge');
                     if(badge) {
                         badge.innerText = data.totalCount;
                         badge.classList.remove('d-none');
                     }
                     showToast('Đã thêm món vào giỏ hàng!', 'success');
                     // Reset form sau khi thêm
                     let noteElement = document.getElementById('drinkNote');
                     if (noteElement) noteElement.value = '';
                     document.getElementById('quantity').value = 1;
                 } else { showToast('Lỗi: ' + data.message, 'error'); }
             })
             .catch(error => console.error('Error:', error))
             .finally(() => {
                 btn.innerHTML = originalText;
                 btn.disabled = false;
             });
         }

        let pendingReviewImages = [];

        function previewReviewImages(input) {
            const previewContainer = document.getElementById('reviewImagesPreview');
            previewContainer.innerHTML = '';
            pendingReviewImages = [];
            
            if (input.files) {
                if (input.files.length > 5) {
                    showToast('Chỉ được tải lên tối đa 5 ảnh.', 'warning');
                    input.value = '';
                    return;
                }
                
                for (let i = 0; i < input.files.length; i++) {
                    let file = input.files[i];
                    if (file.size > 1024 * 1024) {
                        showToast(`Ảnh thứ ${i+1} vượt quá 1MB. Vui lòng chọn ảnh nhỏ hơn.`, 'warning');
                        input.value = '';
                        previewContainer.innerHTML = '';
                        pendingReviewImages = [];
                        return;
                    }
                    
                    pendingReviewImages.push(file);
                    
                    let reader = new FileReader();
                    reader.onload = function (e) {
                        let imgHtml = `
                            <div class="position-relative" style="width: 80px; height: 80px;">
                                <img src="${e.target.result}" class="rounded object-fit-cover shadow-sm border w-100 h-100" />
                            </div>
                        `;
                        previewContainer.insertAdjacentHTML('beforeend', imgHtml);
                    }
                    reader.readAsDataURL(file);
                }
            }
        }
        
        // Khai báo các hàm điều khiển form review ra global để đảm bảo onclick="" chạy được
        window.expandReviewForm = function() {
            const placeholder = document.getElementById('reviewPlaceholder');
            const form = document.getElementById('fullReviewForm');
            if (placeholder) placeholder.classList.add('d-none');
            if (form) form.classList.remove('d-none');
        };

        window.collapseReviewForm = function() {
            const placeholder = document.getElementById('reviewPlaceholder');
            const form = document.getElementById('fullReviewForm');
            if (form) form.classList.add('d-none');
            if (placeholder) placeholder.classList.remove('d-none');
        };

        document.addEventListener('DOMContentLoaded', function() {
            const starsHiddenInput = document.getElementById('selectedStars');
            const starLabel = document.getElementById('starLabel');

            if (starsHiddenInput && starLabel) {
                // Khởi tạo sự kiện cho các ngôi sao đánh giá
                document.querySelectorAll('#submitReviewStars i').forEach(star => {
                    star.addEventListener('mouseover', function() {
                        const val = parseInt(this.getAttribute('data-value'));
                        highlightStars(val);
                    });

                    star.addEventListener('mouseout', function() {
                        const currentVal = parseInt(starsHiddenInput.value) || 0;
                        highlightStars(currentVal);
                    });

                    star.addEventListener('click', function() {
                        const val = parseInt(this.getAttribute('data-value'));
                        starsHiddenInput.value = val;
                        updateStarLabel(val);
                    });
                });
            }
        });

        function highlightStars(val) {
            document.querySelectorAll('#submitReviewStars i').forEach(s => {
                const sVal = parseInt(s.getAttribute('data-value'));
                if (sVal <= val) {
                    s.classList.add('text-orange');
                    s.classList.remove('text-muted');
                } else {
                    s.classList.remove('text-orange');
                    s.classList.add('text-muted');
                }
            });
        }

        function updateStarLabel(val) {
            const starLabel = document.getElementById('starLabel');
            if (!starLabel) return;
            const labels = ["", "Rất tệ", "Tệ", "Bình thường", "Tốt", "Rất tuyệt vời!"];
            starLabel.innerText = labels[val] || "Chưa chọn sao";
            starLabel.classList.add('text-orange');
        }

        function submitReviewAjax() {
            const starsHiddenInput = document.getElementById('selectedStars');
            let stars = starsHiddenInput ? starsHiddenInput.value : "0";
            let comment = document.getElementById('reviewComment').value.trim();

            if(stars == "0") { showToast('Vui lòng chọn số sao đánh giá!', 'warning'); return; }
            if(comment == "" && pendingReviewImages.length === 0) { showToast('Vui lòng nhập nhận xét hoặc đính kèm ảnh!', 'warning'); return; }

            const drinkId = document.querySelector('input[name="DrinkId"]').value;

            const formData = new FormData();
            formData.append('DrinkId', drinkId);
            formData.append('Stars', stars);
            formData.append('Comment', comment);
            
            pendingReviewImages.forEach(file => {
                formData.append('Images', file);
            });

            let btn = document.querySelector('#submitReviewForm button[type="button"]');
            let originalText = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang gửi...';
            btn.disabled = true;

            fetch('/Drink/SubmitReview', {
                method: 'POST',
                body: formData // Xóa header JSON để Fetch tự sinh boundary cho multipart/form-data
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    showToast(data.message, 'success');
                    setTimeout(() => location.reload(), 1800);
                } else { showToast('Lỗi: ' + data.message, 'error'); }
            })
            .catch(err => console.error("Lỗi:", err))
            .finally(() => {
                btn.innerHTML = originalText;
                btn.disabled = false;
            });
        }
        
        // ==========================================
        // KHỐI LOGIC THẢ CẢM XÚC VÀ TRẢ LỜI CỦA TOM
        // ==========================================
        const isAuthenticated = @(User.Identity.IsAuthenticated.ToString().ToLower());
        
        function requireAuth(e) {
            if(!isAuthenticated) {
                if(e) { e.preventDefault(); e.stopPropagation(); }
                var authModal = new bootstrap.Modal(document.getElementById('authModal'));
                authModal.show();
                return false;
            }
            return true;
        }
        

        function toggleReactionAjax(ratingId, typeValue) {
            if(!requireAuth(event)) return;
            
            // Highlight tạm thời UI trước khi HTTP request để giảm lag
            let wrapper = document.querySelector(`.reaction-btn[data-rating-id="${ratingId}"]`);
            if(wrapper) {
                // Tắt tooltip đi
                let tooltip = wrapper.nextElementSibling;
                if(tooltip) tooltip.style.visibility = 'hidden'; // Ẩn cmn ngay và luôn dể ko cướp cú click
            }

            const formData = new FormData();
            formData.append('ratingId', ratingId);
            formData.append('type', typeValue);

            fetch('/Drink/ToggleReactionAjax', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.status === 401) { requireAuth(); return; }
                if (data.status === 429) { showToast(data.message, 'warning'); return; }
                
                if (data.success) {
                    if (wrapper) {
                        let iconHtml = '<i class="bi bi-hand-thumbs-up me-1"></i> Thích';
                        let cssClass = 'text-muted';

                        if (data.action === 'added' || data.action === 'updated') {
                            cssClass = 'fw-bold text-primary';
                            switch(data.type) {
                                case 1: iconHtml = '<span class="me-1 fs-5">👍</span> Thích'; break;
                                case 2: cssClass = 'fw-bold text-danger'; iconHtml = '<span class="me-1 fs-5">❤️</span> Yêu thích'; break;
                                case 3: cssClass = 'fw-bold text-warning'; iconHtml = '<span class="me-1 fs-5">😆</span> Haha'; break;
                                case 4: cssClass = 'fw-bold text-warning'; iconHtml = '<span class="me-1 fs-5">😲</span> Wow'; break;
                                case 5: cssClass = 'fw-bold text-warning'; iconHtml = '<span class="me-1 fs-5">😢</span> Buồn'; break;
                                case 6: cssClass = 'fw-bold text-danger'; iconHtml = '<span class="me-1 fs-5">😡</span> Phẫn nộ'; break;
                            }
                        }
                        
                        // Cập nhật giao diện lập tức không cần tải lại trang
                        wrapper.className = `cursor-pointer reaction-btn toggle-reaction ${cssClass}`;
                        wrapper.innerHTML = `${iconHtml} <span class="reaction-count ms-1">(${data.totalCount})</span>`;
                        wrapper.setAttribute('onclick', `toggleReactionAjax(${ratingId}, ${data.type || 1})`);
                        
                        // Khôi phục tooltip để có thể tương tác tiếp
                        let tooltip = wrapper.nextElementSibling;
                        if(tooltip) tooltip.style.visibility = ''; 
                    }
                } else {
                    showToast(data.message, 'error');
                }
            })
            .catch(err => console.error(err));
        }

        // Logic Mở Form Reply 
        let activeReplyRatingId = null;

        function openReplyForm(ratingId, customerName) {
            if(!requireAuth(event)) return;

            // Xóa form cũ nếu đang mở
            closeReplyForm();
            
            activeReplyRatingId = ratingId;
            let targetZone = document.getElementById(`reply-container-${ratingId}`);
            if(!targetZone) return;

            // Clone nội dung từ template
            const template = document.getElementById('globalReplyFormTemplate');
            const formClone = template.content.cloneNode(true);
            
            // Xóa class d-none của target
            targetZone.classList.remove('d-none');
            targetZone.appendChild(formClone);
            
            // Cập nhật thông số
            document.getElementById('replyParentRatingId').value = ratingId;
            document.getElementById('replyingToName').innerText = customerName;
            let textArea = document.getElementById('replyComment');
            
            // Tự động gõ sẵn TÊN CỦA NGƯỜI ĐÓ VÀO Ô 
            textArea.value = `@@${customerName} `;
            
            // Focus và cho chỏ chuột xuống cuối
            textArea.focus();
            let val = textArea.value; 
            textArea.value = ''; 
            textArea.value = val;
        }

        function closeReplyForm() {
            if(activeReplyRatingId) {
                let targetZone = document.getElementById(`reply-container-${activeReplyRatingId}`);
                if(targetZone) {
                    targetZone.innerHTML = '';
                    targetZone.classList.add('d-none');
                }
                activeReplyRatingId = null;
                clearReplyImage();
            }
        }
        
        let replyImageFile = null;

        function previewReplyImage(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                
                // Thuật Validate size JS: 2MB
                if(file.size > 2 * 1024 * 1024) {
                    showToast('Kích thước hình ảnh quá lớn! Vui lòng chọn ảnh dưới 2MB.', 'warning');
                    input.value = ""; return;
                }
                
                replyImageFile = file;
                var reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('replyImagePreview').src = e.target.result;
                    document.getElementById('replyImagePreviewBox').classList.remove('d-none');
                }
                reader.readAsDataURL(file);
            }
        }

        function clearReplyImage() {
            document.getElementById('replyImageInput').value = "";
            document.getElementById('replyImagePreviewBox').classList.add('d-none');
            document.getElementById('replyImagePreview').src = "";
            replyImageFile = null;
        }

        function submitReplyAjax() {
            if(!requireAuth(event)) return;
            
            let btn = event.target;
            let parentRatingId = document.getElementById('replyParentRatingId').value;
            let comment = document.getElementById('replyComment').value;
            let drinkId = document.querySelector('input[name="DrinkId"]').value; // Của form cha

            if(comment.trim() === "" && !replyImageFile) {
                showToast('Vui lòng nhập nội dung hoặc đính kèm một hình ảnh!', 'warning');
                return;
            }

            let formData = new FormData();
            formData.append('parentRatingId', parentRatingId);
            formData.append('drinkId', drinkId);
            formData.append('comment', comment);
            if(replyImageFile) {
                 formData.append('imageFile', replyImageFile);
            }

            let originalText = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang đẩy mã...';
            btn.disabled = true;

            fetch('/Drink/SubmitReplyAjax', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.status === 401) { requireAuth(); return; }
                if (data.status === 429) { showToast(data.message, 'warning'); return; }
                
                if(data.success) {
                    window.location.reload();
                } else {
                    showToast('Lỗi: ' + data.message, 'error');
                }
            })
            .catch(err => console.error("Lỗi:", err))
            .finally(() => {
                btn.innerHTML = originalText;
                btn.disabled = false;
            });
        }

        // Khởi tạo tổng tiền ngay khi tải trang
        document.addEventListener('DOMContentLoaded', function() {
            updateDisplayTotal();
        });
    </script>
}