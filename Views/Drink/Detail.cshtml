@model CafeChain.ViewModels.DrinkDetailViewModel

@{
    ViewData["Title"] = Model.Drink.Name;
    var defaultBasePrice = Model.Drink.DrinkSizes != null && Model.Drink.DrinkSizes.Any() ? Model.Drink.DrinkSizes.Min(s => s.Price) : 0;

    // Tách logic ra đây để Visual Studio KHÔNG BỊ LÚ và gạch đỏ
    var hasOptionalToppings = Model.OptionalToppings != null && Model.OptionalToppings.Any();
    var hasDefaultToppings = Model.DefaultToppings != null && Model.DefaultToppings.Any();
    var offsetClass = !hasOptionalToppings ? "offset-6" : "";

    var customerIdStr = User.FindFirst("CustomerId")?.Value;
    int.TryParse(customerIdStr, out int currentCustomerId);

    var reviews = Model.Ratings ?? new List<CafeChain.Models.Customers.Rating>();
    var totalReviews = reviews.Count;
    var starDist = new int[6];
    if (totalReviews > 0)
    {
        foreach (var r in reviews) if (r.Stars >= 1 && r.Stars <= 5) starDist[r.Stars]++;
    }
}
    
<div class="container mt-4 mb-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="/" class="text-muted text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/Drink/Menu" class="text-muted text-decoration-none">Thực đơn</a></li>
            <li class="breadcrumb-item active text-orange fw-semibold" aria-current="page">@Model.Drink.Name</li>
        </ol>
    </nav>

    <div class="row mt-4">
        <div class="col-md-6 mb-4">
            <div class="mb-3 position-relative" id="mainImageContainer">
                <img id="mainImage" src="@(Model.Drink.DrinkImages?.FirstOrDefault()?.ImageUrl ?? "/images/default.jpg")"
                     class="img-fluid rounded-4 w-100 object-fit-cover shadow-sm @(!Model.IsAvailable ? "filter-grayscale" : "")" style="aspect-ratio: 1/1;" alt="@Model.Drink.Name" data-current-index="0">

                @if (ViewBag.IsAvailable == false)
                {
                    <div class="position-absolute top-50 start-50 translate-middle w-100 text-center">
                        <span class="badge rounded-pill bg-dark bg-opacity-75 px-4 py-3 fs-4">HẾT HÀNG</span>
                    </div>
                }

                @if (Model.Drink.DrinkImages != null && Model.Drink.DrinkImages.Count > 1)
                {
                    <button class="btn btn-light rounded-circle shadow position-absolute top-50 start-0 translate-middle-y ms-3" style="width: 40px; height: 40px; opacity: 0.8;" onclick="navigateImage(-1)">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <button class="btn btn-light rounded-circle shadow position-absolute top-50 end-0 translate-middle-y me-3" style="width: 40px; height: 40px; opacity: 0.8;" onclick="navigateImage(1)">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                }
            </div>
            @if (Model.Drink.DrinkImages != null && Model.Drink.DrinkImages.Count > 1)
            {
                <div class="d-flex gap-3">
                    @foreach (var img in Model.Drink.DrinkImages)
                    {
                        <img src="@img.ImageUrl" class="rounded-3 object-fit-cover cursor-pointer border-radius-lg thumbnail-img"
                             style="width: 80px; height: 80px;" onclick="changeMainImage('@img.ImageUrl')" />
                    }
                </div>
            }
        </div>

        <div class="col-md-6 ps-md-5">
            <h1 class="fw-bold mb-1">@Model.Drink.Name</h1>

            <div class="d-flex align-items-center mb-3" style="cursor: pointer;" onclick="document.getElementById('reviews-section').scrollIntoView({behavior: 'smooth'})">
                <div class="text-warning me-2" style="font-size: 0.9rem;">
                    @if (Model.TotalReviews == 0)
                    {
                        <i class="bi bi-star text-muted opacity-25"></i>
                        <i class="bi bi-star text-muted opacity-25"></i>
                        <i class="bi bi-star text-muted opacity-25"></i>
                        <i class="bi bi-star text-muted opacity-25"></i>
                        <i class="bi bi-star text-muted opacity-25"></i>
                    }
                    else
                    {
                        // Tính toán Sao Đầy, Sao Khuyết, Sao Trống
                        var fullStars = (int)Math.Floor(Model.AverageRating);
                        var hasHalfStar = (Model.AverageRating - fullStars) >= 0.5;
                        var emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);

                        for (int i = 0; i < fullStars; i++)
                        {

                            <i class="bi bi-star-fill"></i>
                        }
                        if (hasHalfStar)
                        {

                            <i class="bi bi-star-half"></i>
                        }
                        for (int i = 0; i < emptyStars; i++)
                        {

                            <i class="bi bi-star text-muted opacity-25"></i>
                        }
                    }
                </div>

                <span class="text-orange fw-bold me-2">@(Model.TotalReviews > 0 ? Model.AverageRating.ToString("0.0") : "0.0")</span>
                <span class="text-muted small border-start border-2 ps-2">@Model.TotalReviews Đánh giá</span>
            </div>

            <p class="text-muted mb-4" style="line-height: 1.8;">@Model.Drink.Description</p>
            <div class="d-flex align-items-baseline gap-2 mb-4">
                <h2 class="fw-bold text-orange m-0" id="displayTotalPrice">@defaultBasePrice.ToString("N0")đ</h2>
                <span id="priceBreakdown" class="text-muted small d-none">
                    (<span id="breakdownBasePrice">@defaultBasePrice.ToString("N0")</span>đ + <span id="toppingsPrice">0</span>đ topping)
                </span>
            </div>

            <form id="addToCartForm">
                <input type="hidden" id="drinkId" value="@Model.Drink.DrinkId" />

                @if (Model.Drink.DrinkSizes != null && Model.Drink.DrinkSizes.Any())
                {
                    <div class="mb-4">
                        <label class="fw-bold mb-2">Chọn Size</label>
                        <div class="d-flex gap-2">
                            @foreach (var ds in Model.Drink.DrinkSizes.OrderBy(s => s.Price))
                            {
                                var activeClass = ds.Price == defaultBasePrice ? "active" : "";
                                <button type="button" class="btn btn-outline-custom size-btn flex-fill @activeClass"
                                        data-price="@ds.Price" data-size-id="@ds.SizeId" onclick="selectSize(this)">
                                    @ds.Size.Name
                                </button>
                            }
                        </div>
                    </div>
                }
                else
                {
                    var singleSize = Model.Drink.DrinkSizes?.FirstOrDefault();
                    var sp = singleSize?.Price ?? 0;
                    var sid = singleSize?.SizeId ?? 0;
                    <button type="button" class="size-btn active d-none" data-price="@sp" data-size-id="@sid"></button>
                }

                @if (hasOptionalToppings || hasDefaultToppings)
                {
                    <div class="row mb-4">
                        @if (hasOptionalToppings)
                        {
                            <div class="col-6">
                                <label class="fw-bold mb-2">Chọn Topping</label>
                                <select class="form-select shadow-none border rounded-3 py-2" id="toppingSelector" onchange="addOptionalTopping(this)">
                                    <option value="">Chọn Topping</option>
                                    @foreach (var dt in Model.OptionalToppings)
                                    {
                                        bool isAlsoDefault = Model.DefaultToppings != null && Model.DefaultToppings.Any(d => d.ToppingId == dt.ToppingId);
                                        string prefixName = isAlsoDefault ? "Thêm " : "";
                                        <option value="@dt.ToppingId" data-price="@dt.Topping.Price">
                                            @prefixName@dt.Topping.Name (+@dt.Topping.Price.ToString("N0")đ)
                                        </option>
                                    }
                                </select>
                            </div>
                        }

                        @if (hasDefaultToppings)
                        {
                            <div class="col-6 @offsetClass">
                                <label class="text-muted small mb-2">Topping mặc định</label>
                                <div class="d-flex flex-wrap gap-2" id="defaultToppingsContainer">
                                    @foreach (var ddt in Model.DefaultToppings)
                                    {
                                        <div class="topping-tag default-tag d-flex align-items-center rounded-pill px-3 py-1 bg-light border text-muted small"
                                             data-topping-id="@ddt.ToppingId" data-price="@ddt.Topping.Price">
                                            @ddt.Topping.Name
                                            <button type="button" class="btn btn-link text-muted p-0 ms-2 shadow-none" onclick="removeTag(this, 'default')">
                                                <i class="bi bi-x fs-6"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="d-flex flex-wrap gap-2 mb-4" id="optionalToppingsTagsContainer"></div>

                <div class="d-flex gap-3 mb-4 mt-5">
                    <div class="d-flex align-items-center border rounded-pill px-2 bg-light shadow-sm" style="width: 140px; height: 52px; border-color: #e2e8f0 !important;">
                        <button type="button" class="btn text-muted shadow-none border-0 fw-bold fs-5" onclick="updateQty(-1)">-</button>
                        <input type="text" id="quantity" class="form-control border-0 text-center fw-bold shadow-none p-0 bg-transparent fs-5" value="1" readonly>
                        <button type="button" class="btn text-muted shadow-none border-0 fw-bold fs-5" onclick="updateQty(1)">+</button>
                    </div>

                    <button type="button" 
                            class="btn btn-orange flex-grow-1 fw-bold rounded-pill shadow d-flex align-items-center justify-content-center @(ViewBag.IsAvailable == false ? "disabled opacity-50 pe-none" : "")" 
                            style="height: 52px; transition: all 0.3s ease; transform: translateY(0);" 
                            onmouseover="this.style.transform='translateY(-2px)'" 
                            onmouseout="this.style.transform='translateY(0)'" 
                            onclick="@(ViewBag.IsAvailable != false ? "addToCartDetail()" : "void(0)")">
                        <i class="bi bi-cart-plus me-2 fs-5"></i> @(ViewBag.IsAvailable != false ? "Thêm vào giỏ hàng" : "Tạm hết hàng")
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.RelatedDrinks != null && Model.RelatedDrinks.Any())
    {
        <div class="mt-5 pt-5 border-top">
            <h4 class="fw-bold mb-4">Gợi ý dành cho bạn</h4>
            <div class="mb-5">
                <div class="row g-4">
                    @foreach (var item in Model.RelatedDrinks)
                    {
                        <div class="col-lg-3 col-md-4 col-6">
                            <partial name="~/Views/Product/ProductCard.cshtml" model="item" />
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="mt-5 pt-5 border-top" id="reviews-section">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold m-0 text-dark">Đánh giá sản phẩm (@Model.TotalReviews)</h4>
        </div>

        @if (totalReviews > 0 || User.Identity.IsAuthenticated)
        {
            <!-- SECTION 1: RATING SUMMARY (New Card Style) -->
            <div class="card border-0 shadow-sm rounded-4 mb-5" style="background-color: #fff9f5;">
                <div class="card-body p-4 p-md-5">
                    <div class="row align-items-center">
                        <div class="col-md-4 text-center border-end-md">
                            <h1 class="display-3 fw-bold text-orange mb-0">@(totalReviews > 0 ? Model.AverageRating.ToString("0.0") : "0.0")</h1>
                            <div class="text-warning fs-4 mb-2">
                                @for(int i=1; i<=5; i++) {
                                    <i class="bi bi-star-fill @(i <= Math.Round(Model.AverageRating) ? "" : "text-muted opacity-25")"></i>
                                }
                            </div>
                            <p class="text-muted mb-0">Dựa trên @totalReviews đánh giá</p>
                        </div>
                        <div class="col-md-8 ps-md-5 mt-4 mt-md-0">
                            <div class="d-flex flex-wrap gap-2">
                                <button class="btn btn-sm btn-orange rounded-pill px-3 py-1 fw-semibold">Tất cả</button>
                                <button class="btn btn-sm btn-outline-orange rounded-pill px-3 py-1 text-muted border-secondary-subtle">
                                    5 Sao (@starDist[5])
                                </button>
                                <button class="btn btn-sm btn-outline-orange rounded-pill px-3 py-1 text-muted border-secondary-subtle">
                                    4 Sao (@starDist[4])
                                </button>
                                <button class="btn btn-sm btn-outline-orange rounded-pill px-3 py-1 text-muted border-secondary-subtle">
                                    3 Sao (@starDist[3])
                                </button>
                                <button class="btn btn-sm btn-outline-orange rounded-pill px-3 py-1 text-muted border-secondary-subtle">
                                    Cần cải thiện (@(starDist[1] + starDist[2]))
                                </button>
                                <button class="btn btn-sm btn-outline-orange rounded-pill px-3 py-1 text-muted border-secondary-subtle">
                                    Có hình ảnh (@(reviews.Count(r => r.Images != null && r.Images.Any())))
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (User.Identity.IsAuthenticated)
            {
                <!-- SECTION 2: COLLAPSIBLE REVIEW ENTRY -->
                <div id="reviewPlaceholder" class="card border border-2 border-dashed border-orange-subtle rounded-4 mb-5 cursor-pointer hover-shadow transition-all" 
                     onclick="expandReviewForm()" style="background-color: #fff;">
                    <div class="card-body p-4 d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-orange-light d-flex align-items-center justify-content-center text-orange" style="width: 48px; height: 48px;">
                            <i class="bi bi-pencil-square fs-4"></i>
                        </div>
                        <span class="text-muted fw-medium">Viết đánh giá của bạn về món ăn này nhé...</span>
                        <div class="ms-auto text-orange">
                            <i class="bi bi-camera-fill fs-4 opacity-50"></i>
                        </div>
                    </div>
                </div>

                <div id="fullReviewForm" class="card border-0 shadow-sm rounded-4 mb-5 d-none" style="background-color: #fff;">
                    <div class="card-body p-4 p-md-5">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="fw-bold m-0"><i class="bi bi-pencil-square text-orange me-2"></i> Chia sẻ cảm nhận của bạn</h5>
                            <button type="button" class="btn-close shadow-none" onclick="collapseReviewForm()"></button>
                        </div>

                        <form id="submitReviewForm">
                            <input type="hidden" name="DrinkId" value="@Model.Drink.DrinkId" />

                            <div class="row g-4">
                                <div class="col-md-5 text-center border-end">
                                    <label class="form-label text-muted small fw-bold mb-3 d-block uppercase tracking-wider">1. Số sao bạn muốn đánh giá</label>
                                    <div class="rating-stars text-muted fs-1 mb-2 d-flex justify-content-center gap-2" id="submitReviewStars">
                                        <i class="bi bi-star-fill cursor-pointer hover-text-orange" data-value="1"></i>
                                        <i class="bi bi-star-fill cursor-pointer hover-text-orange" data-value="2"></i>
                                        <i class="bi bi-star-fill cursor-pointer hover-text-orange" data-value="3"></i>
                                        <i class="bi bi-star-fill cursor-pointer hover-text-orange" data-value="4"></i>
                                        <i class="bi bi-star-fill cursor-pointer hover-text-orange" data-value="5"></i>
                                    </div>
                                    <input type="hidden" id="selectedStars" name="Stars" value="0" />
                                    <p id="starLabel" class="text-orange fw-bold mb-0">Chưa chọn sao</p>
                                </div>

                                <div class="col-md-7">
                                    <label class="form-label text-muted small fw-bold mb-3 d-block uppercase tracking-wider">2. Nội dung nhận xét & Hình ảnh</label>
                                    <div class="position-relative">
                                        <textarea class="form-control rounded-4 border-light-subtle bg-light shadow-none pe-5" 
                                                  id="reviewComment" name="Comment" rows="4" 
                                                  placeholder="Hãy cho chúng mình vài lời góp ý chân thành về hương vị món này nhé..."></textarea>
                                        
                                        <div class="position-absolute bottom-0 end-0 mb-2 me-2">
                                            <button type="button" class="btn btn-sm btn-light border-0 shadow-sm text-orange rounded-pill px-3" 
                                                    onclick="document.getElementById('reviewImagesInput').click()">
                                                <i class="bi bi-camera-fill me-1"></i> Ảnh
                                            </button>
                                        </div>
                                        <input type="file" id="reviewImagesInput" name="Images" class="d-none" multiple accept=".jpg,.jpeg,.png" onchange="previewReviewImages(this)">
                                    </div>
                                    <div id="reviewImagesPreview" class="d-flex gap-2 flex-wrap mt-3"></div>
                                </div>
                            </div>

                            <div class="text-end mt-4 pt-3 border-top">
                                <button type="button" class="btn btn-orange fw-bold rounded-pill px-5 py-2 shadow-sm" onclick="submitReviewAjax()">Gửi đánh giá ngay</button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="card border border-secondary border-opacity-25 rounded-4 bg-light mb-5 shadow-sm">
                <div class="card-body p-4 text-center">
                    <h6 class="text-muted"><i class="bi bi-info-circle me-2 text-secondary"></i> Bạn cần <a href="/Account/Login" class="text-orange fw-bold text-decoration-none">đăng nhập</a> để đánh giá sản phẩm nhé!</h6>
                </div>
            </div>
        }

        <div class="reviews-list">
            @if (Model.Ratings != null && Model.Ratings.Any())
            {
                foreach (var review in Model.Ratings)
                {
                    <div class="review-item py-4 border-bottom">
                        <div class="d-flex mb-2">
                            <img src="@(review.Customer?.AvatarUrl ?? "/Images/Uploadt/avtdf.jpg")"
                                 onerror="this.onerror=null; this.src='/Images/Upload/avtdf.jpg';"
                                 class="rounded-circle me-3 object-fit-cover shadow-sm" style="width: 45px; height: 45px;" alt="Avatar">
                            <div class="flex-grow-1">
                                <h6 class="fw-bold mb-1">@(review.Customer?.FullName ?? "Khách hàng ẩn danh")</h6>
                                <div class="text-warning small mb-1">
                                    @for (int i = 0; i < review.Stars; i++)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                    @for (int i = review.Stars; i < 5; i++)
                                    {
                                        <i class="bi bi-star"></i>
                                    }
                                </div>
                                <small class="text-muted">@review.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                        </div>
                        <p class="mt-3 mb-2 text-dark">@review.Comment</p>
                        
                        @if (review.Images != null && review.Images.Any())
                        {
                            <div class="d-flex gap-2 mb-3 mt-2 flex-wrap">
                                @foreach(var img in review.Images)
                                {
                                    <img src="@img.ImageUrl" class="rounded object-fit-cover shadow-sm border" style="width: 100px; height: 100px; cursor: pointer;" onclick="window.open('@img.ImageUrl', '_blank')" />
                                }
                            </div>
                        }

                        <div class="d-flex align-items-center mt-2 position-relative gap-4">
                            @{
                                var userReaction = review.Reactions?.FirstOrDefault(r => r.CustomerId == currentCustomerId);
                                int totalReactions = review.Reactions?.Count ?? 0;
                                string reactionIcon = "<i class=\"bi bi-hand-thumbs-up me-1\"></i> Thích";
                                string reactionClass = "text-muted";
                                
                                if (userReaction != null)
                                {
                                    reactionClass = "fw-bold text-primary";
                                    switch (userReaction.Type)
                                    {
                                        case CafeChain.Models.Enums.Customer.ReactionType.Like: 
                                            reactionIcon = "<span class=\"me-1 fs-5\">👍</span> Thích"; break;
                                        case CafeChain.Models.Enums.Customer.ReactionType.Love: 
                                            reactionClass = "fw-bold text-danger"; reactionIcon = "<span class=\"me-1 fs-5\">❤️</span> Yêu thích"; break;
                                        case CafeChain.Models.Enums.Customer.ReactionType.Haha: 
                                            reactionClass = "fw-bold text-warning"; reactionIcon = "<span class=\"me-1 fs-5\">😆</span> Haha"; break;
                                        case CafeChain.Models.Enums.Customer.ReactionType.Wow: 
                                            reactionClass = "fw-bold text-warning"; reactionIcon = "<span class=\"me-1 fs-5\">😲</span> Wow"; break;
                                        case CafeChain.Models.Enums.Customer.ReactionType.Sad: 
                                            reactionClass = "fw-bold text-warning"; reactionIcon = "<span class=\"me-1 fs-5\">😢</span> Buồn"; break;
                                        case CafeChain.Models.Enums.Customer.ReactionType.Angry: 
                                            reactionClass = "fw-bold text-danger"; reactionIcon = "<span class=\"me-1 fs-5\">😡</span> Phẫn nộ"; break;
                                    }
                                }
                            }
                            
                            <div class="reaction-wrapper d-inline-block position-relative">
                                <div class="cursor-pointer reaction-btn @reactionClass toggle-reaction" data-rating-id="@review.RatingId" onclick="toggleReactionAjax(@review.RatingId, 1)">
                                    @Html.Raw(reactionIcon) <span class="reaction-count ms-1">(@totalReactions)</span>
                                </div>
                                <div class="reaction-tooltip bg-white shadow-lg rounded-pill px-3 py-2 d-flex gap-3 position-absolute z-3">
                                    <span class="fs-3 cursor-pointer reaction-icon" onclick="toggleReactionAjax(@review.RatingId, 1)" title="Thích">👍</span>
                                    <span class="fs-3 cursor-pointer reaction-icon" onclick="toggleReactionAjax(@review.RatingId, 2)" title="Yêu thích">❤️</span>
                                    <span class="fs-3 cursor-pointer reaction-icon" onclick="toggleReactionAjax(@review.RatingId, 3)" title="Haha">😆</span>
                                    <span class="fs-3 cursor-pointer reaction-icon" onclick="toggleReactionAjax(@review.RatingId, 4)" title="Wow">😲</span>
                                    <span class="fs-3 cursor-pointer reaction-icon" onclick="toggleReactionAjax(@review.RatingId, 5)" title="Buồn">😢</span>
                                    <span class="fs-3 cursor-pointer reaction-icon" onclick="toggleReactionAjax(@review.RatingId, 6)" title="Phẫn nộ">😡</span>
                                </div>
                            </div>
                            
                            <div class="text-muted cursor-pointer hover-text-orange" onclick="openReplyForm(@review.RatingId, '@(review.Customer?.FullName ?? "Bạn này")')">
                                <i class="bi bi-chat-left-dots me-1"></i> Trả lời (@(review.Replies?.Count ?? 0))
                            </div>
                        </div>

                        @if (review.Replies != null && review.Replies.Any())
                        {
                            <div class="replies-list ms-5 mt-3 ps-3 border-start border-2 border-orange-subtle">
                                @foreach (var reply in review.Replies.OrderBy(r => r.CreatedAt))
                                {
                                    <div class="reply-item mb-3">
                                        <div class="d-flex">
                                            <img src="@(reply.Customer?.AvatarUrl ?? "/Images/Uploadt/avtdf.jpg")"
                                                 onerror="this.onerror=null; this.src='/Images/Upload/avtdf.jpg';"
                                                 class="rounded-circle me-3 object-fit-cover shadow-sm" style="width: 35px; height: 35px;" alt="Avatar">
                                            <div class="bg-light rounded-4 px-3 py-2 flex-grow-1">
                                                <div class="d-flex justify-content-between">
                                                    <h6 class="fw-bold mb-1 fs-sm">@(reply.Customer?.FullName ?? "Khách hàng ẩn danh")</h6>
                                                    <small class="text-muted">@reply.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                                </div>
                                                <p class="mb-1 text-dark fs-sm">
                                                    @reply.Comment
                                                </p>
                                                
                                                @if (reply.Images != null && reply.Images.Any())
                                                {
                                                    <div class="d-flex gap-2 mt-2">
                                                        @foreach(var img in reply.Images)
                                                        {
                                                            <img src="@img.ImageUrl" class="rounded object-fit-cover shadow-sm border" style="width: 80px; height: 80px; cursor: pointer;" onclick="window.open('@img.ImageUrl', '_blank')" />
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <div class="ms-5 ps-2 mt-1 small d-flex align-items-center gap-3 fw-semibold">
                                            @{
                                                var replyReaction = reply.Reactions?.FirstOrDefault(r => r.CustomerId == currentCustomerId);
                                                int replyTotalReactions = reply.Reactions?.Count ?? 0;
                                                string repReactionIcon = "<i class=\"bi bi-hand-thumbs-up me-1\"></i> Thích";
                                                string repReactionClass = "text-muted";
                                                
                                                if (replyReaction != null)
                                                {
                                                    repReactionClass = "fw-bold text-primary";
                                                    switch (replyReaction.Type)
                                                    {
                                                        case CafeChain.Models.Enums.Customer.ReactionType.Like: 
                                                            repReactionIcon = "<span class=\"me-1 fs-6\">👍</span> Thích"; break;
                                                        case CafeChain.Models.Enums.Customer.ReactionType.Love: 
                                                            repReactionClass = "fw-bold text-danger"; repReactionIcon = "<span class=\"me-1 fs-6\">❤️</span> Yêu thích"; break;
                                                        case CafeChain.Models.Enums.Customer.ReactionType.Haha: 
                                                            repReactionClass = "fw-bold text-warning"; repReactionIcon = "<span class=\"me-1 fs-6\">😆</span> Haha"; break;
                                                        case CafeChain.Models.Enums.Customer.ReactionType.Wow: 
                                                            repReactionClass = "fw-bold text-warning"; repReactionIcon = "<span class=\"me-1 fs-6\">😲</span> Wow"; break;
                                                        case CafeChain.Models.Enums.Customer.ReactionType.Sad: 
                                                            repReactionClass = "fw-bold text-warning"; repReactionIcon = "<span class=\"me-1 fs-6\">😢</span> Buồn"; break;
                                                        case CafeChain.Models.Enums.Customer.ReactionType.Angry: 
                                                            repReactionClass = "fw-bold text-danger"; repReactionIcon = "<span class=\"me-1 fs-6\">😡</span> Phẫn nộ"; break;
                                                    }
                                                }
                                            }
                                            <div class="reaction-wrapper d-inline-block position-relative">
                                                <div class="cursor-pointer reaction-btn @repReactionClass toggle-reaction hover-text-orange" data-rating-id="@reply.RatingId" onclick="toggleReactionAjax(@reply.RatingId, 1)">
                                                    @Html.Raw(repReactionIcon) <span class="reaction-count">@(replyTotalReactions > 0 ? $"({replyTotalReactions})" : "")</span>
                                                </div>
                                                <div class="reaction-tooltip bg-white shadow-lg rounded-pill px-3 py-1 d-flex gap-2 position-absolute z-3" style="top: -40px; transform: translateX(-20%) scale(0.85);">
                                                    <span class="fs-3 cursor-pointer reaction-icon" onclick="toggleReactionAjax(@reply.RatingId, 1)" title="Thích">👍</span>
                                                    <span class="fs-3 cursor-pointer reaction-icon" onclick="toggleReactionAjax(@reply.RatingId, 2)" title="Yêu thích">❤️</span>
                                                    <span class="fs-3 cursor-pointer reaction-icon" onclick="toggleReactionAjax(@reply.RatingId, 3)" title="Haha">😆</span>
                                                    <span class="fs-3 cursor-pointer reaction-icon" onclick="toggleReactionAjax(@reply.RatingId, 4)" title="Wow">😲</span>
                                                    <span class="fs-3 cursor-pointer reaction-icon" onclick="toggleReactionAjax(@reply.RatingId, 5)" title="Buồn">😢</span>
                                                    <span class="fs-3 cursor-pointer reaction-icon" onclick="toggleReactionAjax(@reply.RatingId, 6)" title="Phẫn nộ">😡</span>
                                                </div>
                                            </div>

                                            <div class="text-muted cursor-pointer hover-text-orange" onclick="openReplyForm(@review.RatingId, '@(reply.Customer?.FullName ?? "Bạn này")')">
                                                Phản hồi
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <div id="reply-container-@review.RatingId" class="mt-3 ms-4 reply-dropzone d-none"></div>
                        
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-chat-square-text opacity-25" style="font-size: 3rem;"></i>
                    <p class="mt-3">Chưa có đánh giá nào. Hãy là người đầu tiên nhận xét món này nhé!</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <style>
