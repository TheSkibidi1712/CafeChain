@model CafeChain.ViewModels.CartViewModel

@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="container mt-4 mb-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="/" class="text-muted text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item active text-orange fw-semibold" aria-current="page">Giỏ hàng của bạn</li>
        </ol>
    </nav>

    <h2 class="fw-bold mb-1">Giỏ hàng</h2>
    <p class="text-muted mb-4">Bạn đang có @Model.Items.Sum(i => i.Quantity) món trong giỏ hàng</p>

    <div class="row">
        <div class="col-lg-8 mb-4">
            @if (Model.Items.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var item in Model.Items)
                    {
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-body p-3 d-flex align-items-center position-relative">
                                <button onclick="removeItem(@item.DrinkId)" class="btn btn-link text-muted position-absolute top-0 end-0 p-3 shadow-none">
                                    <i class="bi bi-trash3"></i>
                                </button>

                                <img src="@item.ImageUrl" alt="@item.Name" class="rounded-3 object-fit-cover" style="width: 80px; height: 80px; aspect-ratio: 1/1;">

                                <div class="ms-3 flex-grow-1">
                                    <h6 class="fw-bold mb-1">@item.Name</h6>
                                    <small class="text-muted d-block mb-2">Size: @(string.IsNullOrEmpty(item.SizeName) ? "M" : item.SizeName) | Topping: Mặc định</small>
                                    <span class="fw-bold text-orange">@item.Price.ToString("N0")đ</span>
                                </div>

                                <div class="d-flex align-items-center border rounded-pill px-2 py-1 me-4">
                                    <button onclick="updateQuantity(@item.DrinkId, @(item.Quantity - 1))" class="btn btn-sm btn-link text-dark text-decoration-none px-2 shadow-none">-</button>
                                    <span class="mx-2 fw-semibold" style="width: 20px; text-align: center;">@item.Quantity</span>
                                    <button onclick="updateQuantity(@item.DrinkId, @(item.Quantity + 1))" class="btn btn-sm btn-link text-dark text-decoration-none px-2 shadow-none">+</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 bg-light rounded-4 shadow-sm">
                    <i class="bi bi-cart-x text-muted" style="font-size: 3rem;"></i>
                    <h5 class="mt-3 text-muted">Giỏ hàng của bạn đang trống</h5>
                    <a href="/Drink/Menu" class="btn btn-orange rounded-pill px-4 mt-3">Tiếp tục mua sắm</a>
                </div>
            }

            <div class="mt-4">
                <a href="/Drink/Menu" class="text-orange text-decoration-none fw-semibold">
                    <i class="bi bi-plus-circle me-1"></i> Thêm món khác
                </a>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 bg-light">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">Tóm tắt đơn hàng</h5>

                    <div class="mb-4">
                        <label class="small fw-semibold mb-2">Mã giảm giá</label>
                        <div class="input-group">
                            <input type="text" class="form-control rounded-start-3 border-end-0 shadow-none" placeholder="Chọn voucher" style="background-color: white;">
                            <span class="input-group-text bg-white border-start-0 text-orange"><i class="bi bi-arrow-down-short"></i></span>
                            <button class="btn btn-secondary text-white fw-semibold rounded-end-3" type="button" style="background-color: #d1d5db; border-color: #d1d5db;">Áp dụng</button>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Tạm tính</span>
                        <span class="fw-semibold">@Model.SubTotal.ToString("N0")đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Phí vận chuyển</span>
                        <span class="fw-semibold">@Model.ShippingFee.ToString("N0")đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 small">
                        <span class="text-muted">Giảm giá</span>
                        <span class="fw-semibold text-success">-@Model.Discount.ToString("N0")đ</span>
                    </div>

                    <hr class="text-muted">

                    <div class="d-flex justify-content-between mb-4 align-items-center">
                        <span class="fw-bold fs-6">Tổng cộng</span>
                        <span class="fw-bold fs-5 text-orange">@Model.GrandTotal.ToString("N0")đ</span>
                    </div>

                    <button class="btn btn-orange w-100 rounded-3 py-3 fw-bold mb-3 shadow-sm" @(!Model.Items.Any() ? "disabled" : "")>
                        THANH TOÁN NGAY
                    </button>

                    <div class="text-center text-muted small">
                        <i class="bi bi-shield-check me-1"></i> THANH TOÁN AN TOÀN & BẢO MẬT
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Gọi AJAX cập nhật số lượng
        function updateQuantity(id, newQty) {
            if(newQty < 1) {
                removeItem(id);
                return;
            }
            $.post('/Cart/UpdateQuantity', { id: id, quantity: newQty }, function (res) {
                if (res.success) {
                    location.reload(); // Reload trang để cập nhật lại tổng tiền
                }
            });
        }

        // Gọi AJAX xóa món
        function removeItem(id) {
            if(confirm('Bạn có chắc chắn muốn xóa món này khỏi giỏ hàng?')) {
                $.post('/Cart/RemoveItem', { id: id }, function (res) {
                    if (res.success) {
                        location.reload();
                    }
                });
            }
        }
    </script>
}