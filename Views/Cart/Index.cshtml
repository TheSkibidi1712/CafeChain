@model CafeChain.ViewModels.CartViewModel

@{
    ViewData["Title"] = "Giỏ hàng";
    // Logic phí ship thực tế: Không có món thì không có ship
    var currentShippingFee = Model.Items.Any() ? 15000 : 0;
    var finalTotal = Model.SubTotal + currentShippingFee - Model.Discount;
}

<div class="container mt-4 mb-5" style="min-height: 60vh;">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="/" class="text-muted text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item active text-orange fw-semibold" aria-current="page">Giỏ hàng của bạn</li>
        </ol>
    </nav>

    <h2 class="fw-bold mb-1">Giỏ hàng</h2>
    <p class="text-muted mb-4">Bạn đang có @Model.Items.Sum(i => i.Quantity) món trong giỏ hàng</p>

    <div class="row">
        <div class="col-lg-8 mb-4">
            @if (Model.Items.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var item in Model.Items)
                    {
                        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                            <div class="card-body p-3 d-flex align-items-center position-relative">
                                <button onclick="removeItem('@item.CartItemId')" class="btn btn-link text-muted position-absolute top-0 end-0 p-3 shadow-none">
                                    <i class="bi bi-trash3"></i>
                                </button>

                                <img src="@item.ImageUrl" alt="@item.Name" class="rounded-3 object-fit-cover" style="width: 90px; height: 90px; aspect-ratio: 1/1;">

                                <div class="ms-3 flex-grow-1">
                                    <h6 class="fw-bold mb-1">@item.Name</h6>
                                    <div class="mb-2">
                                        <span class="badge bg-light text-dark border fw-normal me-1">Size: @item.SizeName</span>
                                        @foreach (var add in item.AddedToppings)
                                        {
                                            <span class="badge bg-orange-light text-orange border-orange-subtle me-1 mb-1 fw-normal">@add</span>
                                        }
                                        @foreach (var rem in item.RemovedToppings)
                                        {
                                            <span class="badge bg-light text-muted border me-1 mb-1 fw-normal text-decoration-line-through">Bỏ: @rem</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.Note))
                                    {
                                        <div class="mt-2 text-muted small" style="font-style: italic;">
                                            <i class="bi bi-pencil-square me-1"></i> Ghi chú: <span class="text-dark fw-medium">@item.Note</span>
                                        </div>
                                    }
                                    <span class="fw-bold text-orange">@item.Price.ToString("N0")đ</span>
                                </div>

                                <div class="d-flex align-items-center border rounded-pill px-2 py-1 me-4 bg-white shadow-sm">
                                    <button onclick="updateQuantity('@item.CartItemId', @(item.Quantity - 1))" class="btn btn-sm btn-link text-dark text-decoration-none px-2 shadow-none">-</button>
                                    <span class="mx-2 fw-semibold" style="min-width: 20px; text-align: center;">@item.Quantity</span>
                                    <button onclick="updateQuantity('@item.CartItemId', @(item.Quantity + 1))" class="btn btn-sm btn-link text-dark text-decoration-none px-2 shadow-none">+</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 bg-light rounded-4 shadow-sm border border-dashed">
                    <i class="bi bi-cart-x text-muted opacity-50" style="font-size: 4rem;"></i>
                    <h5 class="mt-3 fw-bold text-muted">Giỏ hàng đang trống</h5>
                    <a href="/Drink/Menu" class="btn btn-orange rounded-pill px-5 py-2 fw-bold shadow-sm mt-3">XEM THỰC ĐƠN</a>
                </div>
            }

            <div class="mt-4">
                <a href="/Drink/Menu" class="text-orange text-decoration-none fw-bold small">
                    <i class="bi bi-plus-circle-fill me-1"></i> THÊM MÓN KHÁC
                </a>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white sticky-top" style="top: 20px;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">Tóm tắt đơn hàng</h5>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted small">Tạm tính</span>
                        <span class="fw-bold">@Model.SubTotal.ToString("N0")đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted small">Phí vận chuyển (dự kiến)</span>
                        <span class="fw-bold">@currentShippingFee.ToString("N0")đ</span>
                    </div>

                    @if (Model.Discount > 0)
                    {
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted small">Giảm giá</span>
                            <span class="fw-bold text-success">-@Model.Discount.ToString("N0")đ</span>
                        </div>
                    }

                    <hr class="opacity-10 my-4">

                    <div class="d-flex justify-content-between mb-4 align-items-center">
                        <span class="fw-bold fs-6">Tổng cộng</span>
                        <span class="fw-bold fs-4 text-orange">@finalTotal.ToString("N0")đ</span>
                    </div>

                    <button class="btn btn-orange w-100 rounded-3 py-3 fw-bold mb-3 shadow-sm border-0" @(!Model.Items.Any() ? "disabled" : "")>
                        THANH TOÁN NGAY
                    </button>

                    <div class="text-center text-muted" style="font-size: 0.7rem;">
                        <i class="bi bi-shield-check text-success me-1"></i> THANH TOÁN AN TOÀN & BẢO MẬT
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .bg-orange-light {
            background-color: #fff3ed;
        }

        .border-orange-subtle {
            border: 1px solid #ffccb3 !important;
        }

        .text-orange {
            color: #d35400;
        }

        .btn-orange {
            background-color: #d35400;
            color: white;
            transition: 0.3s;
        }

            .btn-orange:hover {
                background-color: #a04000;
                color: white;
                transform: translateY(-2px);
            }

            .btn-orange:disabled {
                background-color: #ccc;
                transform: none;
            }
    </style>

    <script>
        function updateQuantity(cartItemId, newQty) {
            if(newQty < 1) { removeItem(cartItemId); return; }
            $.post('/Cart/UpdateQuantity', { id: cartItemId, quantity: newQty }, function (res) {
                if (res.success) { location.reload(); }
            });
        }

        function removeItem(cartItemId) {
            if(confirm('Xóa món này khỏi giỏ hàng?')) {
                $.post('/Cart/RemoveItem', { id: cartItemId }, function (res) {
                    if (res.success) { location.reload(); }
                });
            }
        }
    </script>
}