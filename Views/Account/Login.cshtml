@model CafeChain.ViewModels.Accounts.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CafeChain</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --primary-orange: #d34817;
            --bg-color: #f9f9f9;
            --text-color: #1a1a1a;
            --border-color: #eeeeee;
            --placeholder-color: #9ca3af;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/Images/Login/LogIn.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        .login-card {
            background-color: white;
            width: 100%;
            max-width: 480px;
            border-radius: 24px;
            padding: 3rem;
            box-shadow: 0 20px 60px rgba(0,0,0,0.2);
            text-align: center;
        }

        .logo-container {
            margin-bottom: 1.5rem;
        }

        .logo-icon {
            background-color: #fff1ed;
            color: var(--primary-orange);
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.75rem;
            margin: 0 auto 1rem;
        }

        .brand-name {
            font-size: 2.25rem;
            font-weight: 800;
            color: #0c1221;
            margin-bottom: 0.5rem;
        }

        .subtitle {
            font-size: 1.1rem;
            color: #666;
            margin-bottom: 3rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
            text-align: left;
        }

        .form-label {
            display: block;
            margin-bottom: 0.75rem;
            font-weight: 600;
            font-size: 0.95rem;
            color: #555;
        }

        .input-wrapper {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 1.25rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--placeholder-color);
        }

        .form-input {
            width: 100%;
            padding: 1rem 1.25rem 1rem 3.2rem;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            font-size: 1.05rem;
            background-color: #ffffff;
            transition: all 0.2s;
        }

        .form-input:focus {
            outline: none;
            border-color: var(--primary-orange);
            box-shadow: 0 0 0 4px rgba(211, 72, 23, 0.1);
        }

        .toggle-password {
            position: absolute;
            right: 1.25rem;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: var(--placeholder-color);
            transition: color 0.2s;
        }

        .toggle-password:hover {
            color: var(--primary-orange);
        }

        .action-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            font-size: 0.95rem;
        }

        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: #666;
        }

        .checkbox-group input {
            cursor: pointer;
            width: 18px;
            height: 18px;
            accent-color: var(--primary-orange);
        }

        .forgot-password {
            color: var(--primary-orange);
            text-decoration: none;
            font-weight: 600;
        }

        .submit-btn {
            width: 100%;
            background-color: var(--primary-orange);
            color: white;
            border: none;
            padding: 1.125rem;
            border-radius: 16px;
            font-size: 1.1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
            box-shadow: 0 10px 20px rgba(211, 72, 23, 0.25);
            margin-bottom: 2rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 30px rgba(211, 72, 23, 0.3);
            filter: brightness(1.1);
        }

        .register-link {
            font-size: 0.95rem;
            color: #666;
        }

        .register-link a {
            color: var(--primary-orange);
            text-decoration: none;
            font-weight: 700;
        }

        .card-footer {
            margin-top: 3rem;
            font-size: 0.75rem;
            color: #aaa;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .text-danger {
            color: #dc2626;
            font-size: 0.85rem;
            margin-top: 0.5rem;
            display: block;
        }

        .validation-summary {
            background-color: #fee2e2;
            color: #b91c1c;
            padding: 1rem;
            border-radius: 12px;
            margin-bottom: 1.5rem;
            font-size: 0.9rem;
            text-align: left;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="logo-container">
            <div class="logo-icon">
                <i class="fas fa-coffee"></i>
            </div>
            <h1 class="brand-name">CafeChain</h1>
            <p class="subtitle">Chào mừng bạn quay trở lại</p>
        </div>

        <form asp-action="Login" method="post">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="validation-summary" asp-validation-summary="All"></div>
            }

            <div class="form-group">
                <label class="form-label" asp-for="Email"></label>
                <div class="input-wrapper">
                    <i class="far fa-envelope input-icon"></i>
                    <input asp-for="Email" class="form-input" placeholder="username@email.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="Password"></label>
                <div class="input-wrapper">
                    <i class="fas fa-lock input-icon"></i>
                    <input asp-for="Password" class="form-input" id="passwordInput" placeholder="••••••••" />
                    <i class="far fa-eye toggle-password" id="togglePassword"></i>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="action-row">
                <div class="checkbox-group">
                    <input type="checkbox" asp-for="RememberMe" id="rememberMe" />
                    <label for="rememberMe">Ghi nhớ đăng nhập</label>
                </div>
                <a href="#" class="forgot-password">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="submit-btn">Đăng nhập</button>

            <p class="register-link">
                Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a>
            </p>
        </form>

        <div class="card-footer">
            © 2026 CafeChain Professional Network
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function() {
            $('#togglePassword').click(function() {
                const passwordInput = $('#passwordInput');
                const type = passwordInput.attr('type') === 'password' ? 'text' : 'password';
                passwordInput.attr('type', type);
                
                $(this).toggleClass('fa-eye fa-eye-slash');
            });
        });
    </script>
</body>
</html>
